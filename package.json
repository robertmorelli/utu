{
  "name": "utu-vscode",
  "displayName": "UTU",
  "version": "0.1.0",
  "description": "UTU language support and compiler \u2014 tree-sitter frontend, HTML IR, and WasmGC backend.",
  "publisher": "robertmorelli",
  "author": "Robert Morelli",
  "license": "MIT",
  "icon": "utu.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertmorelli/utu.git"
  },
  "bugs": {
    "url": "https://github.com/robertmorelli/utu/issues"
  },
  "homepage": "https://github.com/robertmorelli/utu#readme",
  "type": "module",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "utu",
    "wasm",
    "wasmgc",
    "tree-sitter"
  ],
  "main": "./dist/node/extension.cjs",
  "browser": "./dist/web/extension.cjs",
  "exports": {
    ".": "./dist/utu.js"
  },
  "activationEvents": [
    "onLanguage:utu",
    "workspaceContains:**/*.utu"
  ],
  "contributes": {
    "languages": [
      {
        "id": "utu",
        "aliases": [
          "UTU",
          "utu"
        ],
        "extensions": [
          ".utu"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "utu",
        "scopeName": "source.utu",
        "path": "./jsondata/utu.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.inline.javascript": "javascript"
        }
      }
    ],
    "commands": [
      {
        "command": "utu.compileCurrentFile",
        "title": "UTU: Compile Current File",
        "category": "UTU"
      },
      {
        "command": "utu.runMain",
        "title": "UTU: Run Main",
        "category": "UTU",
        "enablement": "utu.hasRunnableMain"
      },
      {
        "command": "utu.showGeneratedWat",
        "title": "UTU: Show Generated WAT",
        "category": "UTU"
      },
      {
        "command": "utu.showSyntaxTree",
        "title": "UTU: Show Syntax Tree",
        "category": "UTU"
      },
      {
        "command": "utu.showCompilerIR",
        "title": "UTU: Show Compiler IR",
        "category": "UTU"
      },
      {
        "command": "utu.showSemanticXray",
        "title": "UTU: Open Semantic X-Ray",
        "category": "UTU",
        "icon": "$(inspect)"
      },
      {
        "command": "utu.showCompilerGraphs",
        "title": "UTU: Explore Compiler Graphs",
        "category": "UTU",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "utu.showCssStencil",
        "title": "UTU: Show CSS Stencil",
        "category": "UTU"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "utu.runMain",
          "when": "editorLangId == utu",
          "group": "navigation"
        },
        {
          "command": "utu.showSemanticXray",
          "when": "editorLangId == utu",
          "group": "navigation@10"
        }
      ],
      "editor/context": [
        {
          "command": "utu.showSemanticXray",
          "when": "editorLangId == utu",
          "group": "navigation@10"
        },
        {
          "command": "utu.showCompilerGraphs",
          "when": "editorLangId == utu",
          "group": "navigation@11"
        }
      ]
    },
    "configuration": {
      "title": "UTU",
      "properties": {
        "utu.validation.mode": {
          "type": "string",
          "enum": [
            "onType",
            "onSave",
            "off"
          ],
          "default": "onType",
          "markdownDescription": "Controls when UTU compiler diagnostics run."
        },
        "utu.inlayHints.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show compiler-derived inferred types, coercions, closure captures, and effects."
        }
      }
    }
  },
  "files": [
    "dist/utu.js",
    "dist/node/extension.cjs",
    "dist/web/extension.cjs",
    "dist/web/package.json",
    "jsondata/utu.tmLanguage.json",
    "language-configuration.json",
    "PRINCIPLES.md",
    "README.md",
    "LICENSE",
    "utu.png"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "bindings:browser": "node ./tools/dts/cli.mjs --browser",
    "test:bindings": "node ./scripts/dts-abi-tests.mjs && node ./scripts/dts-deep-tests.mjs && node ./scripts/test-dts-portability.mjs && node ./scripts/test-dts-browser.mjs && node ./scripts/test-browser-pantry.mjs",
    "bench:js-arrays": "node ./scripts/benchmark-js-arrays.mjs",
    "demo:build": "node ./tools/dts/demo.mjs",
    "demo:serve": "node ./tools/dts/demo.mjs --serve",
    "check": "bun ./cli/utu.mjs check",
    "test:bundle": "bun ./scripts/bundle-smoke-test.mjs",
    "test:vscode": "node ./scripts/test-vscode-extension.mjs",
    "test": "node ./scripts/test-all.mjs",
    "test:fast": "bun ./scripts/run-tests.mjs && node ./scripts/wasm-fingerprints.mjs",
    "fingerprints": "node ./scripts/wasm-fingerprints.mjs",
    "behavior": "node ./scripts/behavior-fingerprints.mjs",
    "package:vscode": "bun run build && vsce package --out dist/utu-vscode.vsix",
    "bench:tiny": "bun ./scripts/benchmark-rust-vs-utu.mjs",
    "bench:kernels": "bun ./scripts/benchmark-suite.mjs",
    "bench:deltablue": "bun ./scripts/benchmark-deltablue.mjs",
    "bench:engines": "bun ./scripts/benchmark-wasmgc-engines.mjs",
    "bench:suite": "bun ./scripts/benchmark-all.mjs",
    "bench:loops": "node ./scripts/benchmark-loops.mjs",
    "test:stage-1": "node ./scripts/selfhost-bootstrap.mjs --stage-1",
    "stage0": "node ./scripts/stage0.mjs",
    "test:wutu": "node ./scripts/test-wutu-browser.mjs",
    "demo:wutu-five": "node ./scripts/build-wutu-five.mjs",
    "test:wutu-five": "node ./scripts/build-wutu-five.mjs && node ./scripts/test-wutu-five.mjs && node ./scripts/test-wutu-five.mjs --webkit",
    "test:source-warnings": "node ./scripts/test-source-warnings.mjs",
    "test:queries": "node ./scripts/test-query-features.mjs",
    "wutu": "node ./cli/wutu.mjs",
    "docs:build": "node ./scripts/build-docs.mjs",
    "bench:programs-d8": "node ./scripts/benchmark-programs-d8.mjs",
    "bench:deltablue-table": "node ./scripts/benchmark-programs-d8.mjs deltablue",
    "test:wutu-smooth": "node ./cli/wutu.mjs build examples/wutu-reactive/main.utu --out dist/wutu-reactive && node ./scripts/test-wutu-smooth.mjs && node ./scripts/test-wutu-smooth.mjs --webkit && node ./scripts/test-wutu-static.mjs && node ./scripts/test-wutu-dev.mjs",
    "demo:wutu-more": "node ./scripts/build-wutu-more.mjs",
    "test:wutu-more": "node ./scripts/build-wutu-more.mjs && node ./scripts/test-wutu-more.mjs && node ./scripts/test-wutu-more.mjs --webkit",
    "demo:wutu-rounds": "node scripts/build-wutu-rounds.mjs one && node scripts/build-wutu-rounds.mjs two",
    "test:wutu-rounds": "node scripts/test-wutu-stencils.mjs && node scripts/test-wutu-runtime.mjs && npm run demo:wutu-rounds && node scripts/test-wutu-rounds.mjs one && node scripts/test-wutu-rounds.mjs one --webkit && node scripts/test-wutu-rounds.mjs two && node scripts/test-wutu-rounds.mjs two --webkit"
  },
  "dependencies": {},
  "devDependencies": {
    "@floating-ui/dom": "1.8.0",
    "@types/node": "26.6.2",
    "errors:show": "node ./scripts/show-diagnostics.mjs",
    "@vscode/test-web": "^0.0.80",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.4",
    "linkedom": "^0.18.12",
    "mitt": "3.0.1",
    "nanoid": "6.0.1",
    "playwright": "1.62.0",
    "tree-sitter-cli": "^0.26.7",
    "typescript": "5.9.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "web-tree-sitter": "^0.26.7"
  }
}
