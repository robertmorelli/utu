// The utu documentation site, written in utu and Wutu.
// Build it with `node scripts/build-docs.mjs`; preview with `node cli/wutu.mjs dev docs/src/main.utu`.
using Browser from std:Browser;
using ui from "./ui.utu";
using home from "./home.utu";
using start from "./start.utu";
using tour from "./tour.utu";
using javascript from "./javascript.utu";
using data from "./data.utu";
using web from "./web.utu";
using tooling from "./tooling.utu";
using compiler from "./compiler.utu";
struct Link:
| href: Str
| label: Str
struct Site:
| route: Str
fn links() Array[Link] {
    [
    Link {
        href: "/",
        label: "Overview"
    },
    Link {
        href: "/start",
        label: "Getting started"
    },
    Link {
        href: "/tour",
        label: "Language tour"
    },
    Link {
        href: "/javascript",
        label: "JavaScript and npm"
    },
    Link {
        href: "/data",
        label: "JSON, iterators, indexes"
    },
    Link {
        href: "/wutu",
        label: "Wutu"
    },
    Link {
        href: "/tooling",
        label: "Tooling"
    },
    Link {
        href: "/compiler",
        label: "The compiler"
    }
    ];
}
fn title(route: Str) Str {
    let found = links() first_where(Link) |link| {
        link.href == route;
    };
    promote found {
        |link| => if link.value.href == "/" {
            "utu";
        }
        else {
            link.value.label + " | utu";
        },
        ~> "utu",
    };
}
fn page(route: Str) Browser.HTMLElement {
    if route == "/start" {
        start.page();
    }
    else if route == "/tour" {
        tour.page();
    }
    else if route == "/javascript" {
        javascript.page();
    }
    else if route == "/data" {
        data.page();
    }
    else if route == "/wutu" {
        web.page();
    }
    else if route == "/tooling" {
        tooling.page();
    }
    else if route == "/compiler" {
        compiler.page();
    }
    else {
        home.page();
    };
}
// When the hash changes, the whole view re-renders; scroll back to the top of the new page.
fn arrive(site: Site, route: Str) Str {
    if site.route != route {
        let first = site.route == "";
        site.route = route;
        Browser.document.title = title(route);
        if not first {
            wutu.after_render(cl() void {
                Browser.window.scrollTo(& {
                    top: 0.0,
                    left: 0.0,
                    behavior: "instant"
                });
                // On narrow screens the nav is a horizontal strip: keep the current page in view.
                promote Browser.document.querySelector("nav a.here") {
                    |current| => current.scrollIntoView(& {
                        block: "nearest",
                        inline: "nearest"
                    }),
                    ~> {
                    },
                };
            });
        };
    };
    "";
}
export main() void {
    let site = Site {
        route: ""
    };
    let app = @wutu/\
    @reactive;
    @document {
        @import url("https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300..800&family=IBM+Plex+Mono:ital,wght@0,400;0,500;1,400&display=swap");
        :root {
            --bg: #eef0f4;
            --surface: #ffffff;
            --ink: #141a2b;
            --muted: #5b6579;
            --line: #d5d9e3;
            --accent: #4a3dd6;
            --accent-soft: #e6e3fb;
            --code-bg: #171c30;
            --code-ink: #e4e7f2;
            --code-k: #c8bdff;
            --code-s: #a7dfb1;
            --code-c: #7d86a1;
            --code-T: #ffd48a;
            --code-n: #ffb3b3;
            --code-a: #ff9ed6;
            --code-d: #8fd6ff;
            --code-y: #a6d4ff;
            --code-f: #e4e7f2;
            color-scheme: light dark;
        }
        @media (prefers-color-scheme: dark) {
            :root {
                --bg: #0e1220;
                --surface: #151a2c;
                --ink: #e6e8f1;
                --muted: #99a1b8;
                --line: #272e49;
                --accent: #aaa0ff;
                --accent-soft: #23264a;
                --code-bg: #090c17;
            }
        }
        * {
            box-sizing: border-box;
        }
        html {
            -webkit-text-size-adjust: 100%;
            scroll-behavior: smooth;
        }
        @media (prefers-reduced-motion: reduce) {
            html {
                scroll-behavior: auto;
            }
        }
        body {
            margin: 0;
            background: var(--bg);
            color: var(--ink);
            font: 400 1.0625rem/1.6 "Bricolage Grotesque", system-ui, sans-serif;
            font-optical-sizing: auto;
        }
        a {
            color: var(--accent);
            text-underline-offset: 0.2em;
            text-decoration-thickness: 1px;
        }
        a:hover {
            text-decoration-thickness: 2px;
        }
        :focus-visible {
            outline: 3px solid var(--accent);
            outline-offset: 3px;
            border-radius: 2px;
        }
        h1, h2, h3, p, ul, ol, table {
            margin: 0;
            overflow-wrap: anywhere;
        }
        h1 {
            font-weight: 500;
            font-size: clamp(2.2rem, 1.4rem + 3vw, 3.6rem);
            line-height: 1.05;
            letter-spacing: -0.035em;
        }
        h2 {
            font-weight: 600;
            font-size: 1.55rem;
            line-height: 1.2;
            letter-spacing: -0.02em;
            margin-block: 3rem 0.9rem;
        }
        h2:first-of-type {
            margin-block-start: 2.25rem;
        }
        p + p {
            margin-block-start: 0.9rem;
        }
        .page {
            max-inline-size: 46rem;
            padding: clamp(1.5rem, 5vw, 4rem) clamp(1rem, 4vw, 3rem) 5rem;
        }
        .page-head {
            display: grid;
            gap: 1rem;
            padding-block-end: 1.5rem;
            border-block-end: 1px solid var(--line);
        }
        .lede {
            font-size: 1.2rem;
            line-height: 1.5;
            color: var(--muted);
            max-inline-size: 38rem;
        }
        .further {
            margin-block-start: 1.5rem;
            padding-inline-start: 1rem;
            border-inline-start: 3px solid var(--accent-soft);
            color: var(--muted);
        }
        .further + .further {
            margin-block-start: 0.6rem;
        }
        code {
            font-family: "IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
            font-size: 0.86em;
        }
        p code, li code, td code, th code {
            background: var(--accent-soft);
            padding: 0.08em 0.35em;
            border-radius: 0.3em;
        }
        pre.code {
            margin: 1.25rem 0;
            padding: 1.1rem 1.25rem;
            background: var(--code-bg);
            color: var(--code-ink);
            border-radius: 0.65rem;
            overflow-x: auto;
            font: 400 0.84rem/1.65 "IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
            tab-size: 4;
        }
        pre.code code {
            font-size: inherit;
        }
        @media (width < 40rem) {
            pre.code {
                font-size: 0.78rem;
                padding: 0.9rem 1rem;
            }
        }
        pre.code .k {
            color: var(--code-k);
        }
        pre.code .s {
            color: var(--code-s);
        }
        pre.code .c {
            color: var(--code-c);
            font-style: italic;
        }
        pre.code .T {
            color: var(--code-T);
        }
        pre.code .n {
            color: var(--code-n);
        }
        pre.code .a {
            color: var(--code-a);
            font-weight: 500;
        }
        pre.code .d {
            color: var(--code-d);
            font-weight: 500;
        }
        pre.code .y {
            color: var(--code-y);
        }
        pre.code .f {
            color: var(--code-f);
        }
        pre.shell {
            color: var(--code-ink);
        }
        table {
            border-collapse: collapse;
            inline-size: 100%;
            margin-block: 1.25rem;
            font-size: 0.95rem;
        }
        th, td {
            text-align: start;
            vertical-align: top;
            padding: 0.6rem 0.75rem 0.6rem 0;
            border-block-end: 1px solid var(--line);
        }
        th {
            font-weight: 600;
            white-space: nowrap;
        }
        thead th {
            color: var(--muted);
            font-weight: 500;
            font-size: 0.85rem;
        }
        ul, ol {
            padding-inline-start: 1.25rem;
        }
        li + li {
            margin-block-start: 0.4rem;
        }
        .principles li {
            padding-inline-start: 0.35rem;
        }
        .principles li::marker {
            color: var(--accent);
            font-weight: 600;
        }
        .home {
            padding: clamp(1.5rem, 5vw, 4rem) clamp(1rem, 4vw, 3rem) 4rem;
            max-inline-size: 72rem;
            display: grid;
            gap: clamp(3rem, 7vw, 5.5rem);
        }
        .hero {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
            gap: clamp(2rem, 5vw, 4rem);
            align-items: start;
        }
        @media (width < 60rem) {
            .hero {
                grid-template-columns: minmax(0, 1fr);
            }
        }
        .pitch {
            display: grid;
            gap: 1.5rem;
            align-content: start;
            padding-block-start: 1rem;
        }
        .pitch h1 {
            font-size: clamp(2.6rem, 1.5rem + 4.2vw, 4.8rem);
            font-weight: 450;
            max-inline-size: 11em;
        }
        .pitch .lede {
            font-size: 1.15rem;
            max-inline-size: 34rem;
        }
        .actions {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem 1.75rem;
            align-items: center;
        }
        .button {
            display: inline-block;
            padding: 0.8rem 1.4rem;
            border-radius: 0.6rem;
            background: var(--accent);
            color: var(--bg);
            text-decoration: none;
            font-weight: 600;
        }
        .button:hover {
            filter: brightness(1.08);
        }
        .envelope {
            position: relative;
            display: grid;
            gap: 0.75rem;
            padding-inline: clamp(0rem, 2vw, 1.5rem);
        }
        .envelope pre.code {
            margin: 0;
            font-size: 0.8rem;
        }
        .bracket {
            font: 400 clamp(3rem, 6vw, 5rem)/0.8 "IBM Plex Mono", ui-monospace, monospace;
            color: var(--accent);
            user-select: none;
            line-height: 0.75;
        }
        .bracket.open {
            justify-self: start;
            margin-inline-start: -0.1em;
        }
        .bracket.close {
            justify-self: end;
            margin-inline-end: -0.1em;
        }
        .caption {
            color: var(--muted);
            font-size: 0.95rem;
            max-inline-size: 30rem;
        }
        .points {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
            gap: clamp(2rem, 4vw, 3.5rem);
        }
        .point {
            display: grid;
            gap: 0.9rem;
            align-content: start;
        }
        .point h2 {
            margin: 0;
            font-size: 1.45rem;
            max-inline-size: 22ch;
        }
        .point pre.code {
            margin: 0.25rem 0;
        }
        .measured {
            display: grid;
            gap: 0.75rem;
        }
        .measured h2, .map h2 {
            margin: 0;
        }
        .measured table {
            margin-block: 0.75rem 0;
            max-inline-size: 52rem;
        }
        .measured th {
            font-size: 1.5rem;
            font-weight: 500;
            letter-spacing: -0.02em;
            padding-inline-end: 1.5rem;
            font-variant-numeric: tabular-nums;
        }
        .measured td {
            color: var(--muted);
        }
        .map ul {
            list-style: none;
            padding: 0;
            margin-block-start: 1rem;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
            gap: 1rem 2.5rem;
        }
        .map li {
            display: grid;
            gap: 0.15rem;
            padding-block: 0.75rem;
            border-block-start: 1px solid var(--line);
            margin: 0;
        }
        .map li a {
            font-weight: 600;
            font-size: 1.05rem;
        }
        .map li span {
            color: var(--muted);
            font-size: 0.95rem;
        }
    }
    div.shell {
        display:grid;
        grid-template-columns:17rem minmax(0, 1fr);
        min-block-size:100dvh;
        @media (width < 64rem) {
            grid-template-columns: minmax(0, 1fr);
        }
        aside.side {
            position:sticky;
            top:0;
            block-size:100dvh;
            overflow-y:auto;
            display:flex;
            flex-direction:column;
            gap:1.5rem;
            padding:1.75rem 1.5rem;
            border-inline-end:1px solid var(--line);
            @media (width < 64rem) {
                position: static;
                block-size: auto;
                gap: 0.9rem;
                padding: 1rem 1rem 0.75rem;
                border-inline-end: 0;
                border-block-end: 1px solid var(--line);
                background: var(--bg);
            }
            a.brand {
                <href = "#/";
                display:flex;
                align-items:baseline;
                gap:0.6rem;
                color:var(--ink);
                text-decoration:none;
                font-weight:700;
                font-size:1.5rem;
                letter-spacing:-0.03em;
                span.mark {
                    <aria-hidden = "true";
                    font:500 1.05rem "IBM Plex Mono", ui-monospace, monospace;
                    color:var(--accent);
                    letter-spacing:0;
                    = ui.open_mark();
                }
                "utu";
                span.sub {
                    font-weight:400;
                    font-size:0.9rem;
                    color:var(--muted);
                    letter-spacing:0;
                    "docs";
                }
            }
            nav {
                <aria-label = "Pages";
                display:grid;
                gap:0.1rem;
                @media (width < 64rem) {
                    display: flex;
                    gap: 0.35rem;
                    overflow-x: auto;
                    scrollbar-width: none;
                    margin-inline: -1rem;
                    padding-inline: 1rem;
                }
                for $[links()] |link| key $[link.href] {
                    a {
                        <href = $["#" + link.href];
                        <class = $[if link.href == wutu.route() { "here"; } else { "elsewhere"; }];
                        <aria-current = $[if link.href == wutu.route() { "page"; } else { "false"; }];
                        display:block;
                        padding:0.45rem 0.7rem;
                        border-radius:0.5rem;
                        color:var(--ink);
                        text-decoration:none;
                        font-size:0.98rem;
                        white-space:nowrap;
                        :hover {
                            background: var(--accent-soft);
                        }
                        @ &.here {
                            background: var(--accent);
                            color: var(--surface);
                            font-weight: 600;
                        }
                        @media (prefers-color-scheme: dark) {
                            @ &.here {
                                color: var(--bg);
                            }
                        }
                        = link.label;
                    }
                }
            }
            p.aside-foot {
                margin-block-start:auto;
                font-size:0.85rem;
                color:var(--muted);
                line-height:1.5;
                @media (width < 64rem) {
                    display: none;
                }
                a {
                    <href = $[ui.repo()];
                    "GitHub";
                }
                br {
                }
                a {
                    <href = $[ui.repo() + "/tree/main/docs"];
                    "Markdown deep dives";
                }
            }
        }
        div.content {
            min-inline-size:0;
            = arrive(site, wutu.route());
            = page(wutu.route());
            footer {
                padding:2rem clamp(1rem, 4vw, 3rem) 3rem;
                border-block-start:1px solid var(--line);
                color:var(--muted);
                font-size:0.9rem;
                display:flex;
                flex-wrap:wrap;
                gap:0.5rem 2rem;
                justify-content:space-between;
                p {
                    "This site is written in utu and compiled to WasmGC. ";
                    a {
                        <href = $[ui.repo() + "/tree/main/docs/src"];
                        "Read its source";
                    }
                    ".";
                }
                p {
                    "MIT licensed. ";
                    a {
                        <href = $[ui.repo()];
                        "robertmorelli/utu";
                    }
                }
            }
        }
    }
    \/;
    Browser.document.body.append(app);
}
