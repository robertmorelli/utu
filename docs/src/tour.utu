    // Entry points
    fn lib_sample() Str {
        \\/// The area of a `w` by `h` rectangle.
        \\fn area(w: F64, h: F64) F64 { w * h }
        \\
        \\lib {                     // these become the module's Wasm exports
        \\    fn rect_area(w: F64, h: F64) F64 { area(w, h) }
        \\    fn greet(name: Str) Str { `Hello, ${name}` }
        \\}
    }
    fn lib_js() Str {
        \\// app.mjs, after `utu build shapes.utu`
        \\import { exports } from "./shapes.mjs";
        \\console.log(exports.rect_area(3, 4), exports.greet("JS"));   // 12 Hello, JS
    }
    fn page() Browser.HTMLElement {
        @wutu/\
        article.page {
            = ui.header("Language tour", "Every construct in utu, by example. Each sample is a whole program that type-checks against the current compiler; comments show what it prints or returns.");
            h2 {
                "Literals and numbers";
            }
            p {
                "A literal with no type to take is the first of ";
                code {
                    "I32";
                }
                ", ";
                code {
                    "U32";
                }
                ", ";
                code {
                    "I64";
                }
                ", ";
                code {
                    "U64";
                }
                " it fits; a float is ";
                code {
                    "F32";
                }
                " when it reads the same as F32 and as F64, else ";
                code {
                    "F64";
                }
                ". An annotation or ";
                code {
                    "F64(…)";
                }
                " picks another type. Numeric types are nominal, so every conversion is written out and costs one instruction.";
            }
            = code.block(literals_sample());
            = code.block(conversions_sample());
            = code.block(nominal_sample());
            = code.block(operators_sample());
            h2 {
                "Bindings";
            }
            p {
                code {
                    "let";
                }
                " infers a type or takes an annotation. A local binding can be reassigned. A top-level ";
                code {
                    "let";
                }
                " is a global: it needs a type annotation (";
                code {
                    "let g: I32 = 5;";
                }
                ", not ";
                code {
                    "let g = 5;";
                }
                ") and is set once, so assigning to it is an error. For state that changes, keep a struct in a global and set its fields, or use a ";
                code {
                    "mem";
                }
                " or ";
                code {
                    "vec";
                }
                ". A global may be computed by any expression: the module sets it when it starts, in the order written, but always after the globals its initializer reads (directly or through the functions it calls). Two globals that need each other are an error.";
            }
            = code.block(let_sample());
            = code.block(globals_sample());
            = code.block(global_state_sample());
            h2 {
                "Functions";
            }
            p {
                "The result type follows the parameters, and the last expression is the result. A line break ends a statement, unless the next line goes on (it begins with ., an operator but -, and, or, else, or a stage like map |x|); ; puts two statements on one line.";
            }
            = code.block(functions_sample());
            = code.block(recursion_sample());
            h2 {
                "Blocks are expressions";
            }
            = code.block(blocks_sample());
            h2 {
                "if and else";
            }
            p {
                code {
                    "if";
                }
                " is an expression whose branches must agree on a type; without ";
                code {
                    "else";
                }
                " it is a statement. Branches that make different variants of one enum join to the enum, and ";
                code {
                    "null";
                }
                " beside a reference joins to its nullable type.";
            }
            = code.block(if_sample());
            = code.block(if_statement_sample());
            h2 {
                "Loops";
            }
            p {
                code {
                    "while";
                }
                ", ";
                code {
                    "for";
                }
                " over ranges and arrays (zipped when given several: arrays and ranges only, stopping at the shortest; a generator is looped alone; a body of one statement may go without braces, ";
                code {
                    "for (xs) |x| show(x)";
                }
                "), ";
                code {
                    "break";
                }
                ", and ";
                code {
                    "continue";
                }
                ". Range captures are ";
                code {
                    "I32";
                }
                ". A capture is read-only: to move a count, use ";
                code {
                    "while";
                }
                " and a ";
                code {
                    "let";
                }
                ".";
            }
            = code.block(while_sample());
            = code.block(ranges_sample());
            = code.block(for_each_sample());
            = code.block(break_sample());
            p {
                "A block can have a name: ";
                code {
                    "break name";
                }
                " leaves it from anywhere inside it (loops included, closures not), and ";
                code {
                    "break name value";
                }
                " gives it a value. Its defers run as it is left.";
            }
            = code.block(labeled_sample());
            h2 {
                "match and loop match";
            }
            p {
                code {
                    "match";
                }
                " compares a scalar against literal patterns. ";
                code {
                    "loop match";
                }
                " is a state machine: ";
                code {
                    "continue state";
                }
                " re-dispatches and ";
                code {
                    "break";
                }
                " leaves.";
            }
            = code.block(match_sample());
            = code.block(loop_match_sample());
            h2 {
                "Structs";
            }
            p {
                "Fields are listed behind bars. ";
                code {
                    "&{ ... }";
                }
                " builds a struct whose type the context already knows. Methods name their receiver in bars; an operator is a method named after it (";
                code {
                    "add";
                }
                ", ";
                code {
                    "sub";
                }
                ", ";
                code {
                    "mul";
                }
                ", ";
                code {
                    "eq";
                }
                ", ";
                code {
                    "lt";
                }
                ", ";
                code {
                    "neg";
                }
                ", ...).";
            }
            = code.block(struct_sample());
            = code.block(methods_sample());
            = code.block(struct_ops_sample());
            h2 {
                "Distinct types and aliases";
            }
            p {
                "A distinct type has its base's representation and none of its identity. ";
                code {
                    "using ... |name|";
                }
                " renames a module. A using's name is its file's: no mod, fn, or type there takes it too.";
            }
            = code.block(distinct_sample());
            = code.block(alias_sample());
            h2 {
                "Enums and alt";
            }
            p {
                "Variants may carry fields. ";
                code {
                    "alt";
                }
                " picks the arm for a variant and binds it; ";
                code {
                    "~>";
                }
                " covers the rest. Integer enums are small numbers with names, dispatched by ";
                code {
                    "match";
                }
                ". In a safe build, ";
                code {
                    "Level(v)";
                }
                " traps when no variant has the value v.";
            }
            = code.block(enum_sample());
            p {
                "A variant is named by its enum too: ";
                code {
                    "Shape.Circle { r: 2.0 }";
                }
                ", ";
                code {
                    "Shape.Dot";
                }
                " (a variant without fields is a value), ";
                code {
                    "Shape.Dot => …";
                }
                " in an alt, and ";
                code {
                    "geo.Shape.Circle";
                }
                " from mod geo. Where two enums have a variant of one name, the bare name is an error, unless the alt's value or the type wanted says which. A declaration of that name (a struct, an enum, the enum itself) keeps it: the variant is then Shape.Circle, or bare where a Shape is wanted.";
            }
            = code.block(enum_qualified_sample());
            = code.block(enum_tag_sample());
            = code.block(int_enum_sample());
            h2 {
                "Nullable values";
            }
            p {
                code {
                    "?T";
                }
                " may be ";
                code {
                    "null";
                }
                ". ";
                code {
                    "promote";
                }
                " unwraps it, ";
                code {
                    "orelse";
                }
                " supplies a default, and a statement containing ";
                code {
                    "a?.b";
                }
                " runs only when ";
                code {
                    "a";
                }
                " is present.";
            }
            = code.block(promote_sample());
            = code.block(orelse_sample());
            = code.block(chain_sample());
            h2 {
                "Tuples";
            }
            p {
                "A function returns several values as a tuple (Wasm multi-value: no allocation), and ";
                code {
                    "let .{a, b}";
                }
                " takes them apart. Tuples are only results.";
            }
            = code.block(tuple_sample());
            h2 {
                "Function values and closures";
            }
            p {
                code {
                    "fun";
                }
                " is a Wasm function reference with no environment: name a function to get one. ";
                code {
                    "cl";
                }
                " is a closure, held as a real JavaScript function so any callback API accepts it. A ";
                code {
                    "fun";
                }
                " converts to a ";
                code {
                    "cl";
                }
                ", never the reverse.";
            }
            = code.block(fun_sample());
            = code.block(cl_sample());
            = code.block(capture_sample());
            h2 {
                "Modules and generics";
            }
            p {
                "A ";
                code {
                    "mod";
                }
                " groups functions and types; ";
                code {
                    "&";
                }
                " is the module's own type. A module's type parameters make generic types: ";
                code {
                    "Stack[I32]";
                }
                " instantiates ";
                code {
                    "Stack";
                }
                ". Files import modules with ";
                code {
                    "using";
                }
                ".";
            }
            = code.block(mod_sample());
            = code.block(mod_type_sample());
            p {
                "A module's function or a type's, named without a call (";
                code {
                    "temperature.to_fahrenheit";
                }
                ", ";
                code {
                    "Point.at";
                }
                "), is a ";
                code {
                    "fun";
                }
                " value. A method can be a generator, and a generator can be reached through a module or a type: ";
                code {
                    "for (nums.each()) |v|";
                }
                ".";
            }
            = code.block(member_values_sample());
            = code.block(generic_sample());
            p {
                "A global in a generic module is one per instance: ";
                code {
                    "Stash[I32]";
                }
                " and ";
                code {
                    "Stash[Str]";
                }
                " each have their own ";
                code {
                    "items";
                }
                ", set by its own initializer.";
            }
            = code.block(generic_global_sample());
            p {
                "A module can promote a function instead of a type: ";
                code {
                    "fn &(…)";
                }
                " is called as the module itself, ";
                code {
                    "twice[I64](7)";
                }
                ", and ";
                code {
                    "twice[I64]";
                }
                " alone is that function as a value. A module's ";
                code {
                    "&";
                }
                " is a type or a function, not both; a module promoting a type is capitalized (";
                code {
                    "Stack";
                }
                "), one promoting a function lowercase (";
                code {
                    "twice";
                }
                ").";
            }
            = code.block(promoted_fn_sample());
            = code.block(std_generic_sample());
            = code.block(files_multi());
            h2 {
                "Functions of any type: $T";
            }
            p {
                "A parameter typed ";
                code {
                    "$T";
                }
                " makes T a type parameter of the function, which each call binds to that argument's type (a literal's waits for an argument that is not one). Other parameters and the result write ";
                code {
                    "T";
                }
                ". The body is checked for each binding, so one that does not fit (";
                code {
                    "x.str()";
                }
                " on a type with none) is a mistake at that call. ";
                code {
                    "console.log";
                }
                " is one: it prints any value's ";
                code {
                    "str()";
                }
                ".";
            }
            = code.block(dollar_sample());
            h2 {
                "Protocols";
            }
            p {
                "A protocol lists getters, setters, and methods. A struct names the protocols it implements; ";
                code {
                    "fn Proto[Type].method";
                }
                " implements one, and ";
                code {
                    "Array[Proto]";
                }
                " holds any mix of implementors. A protocol method lists parameter types only, ";
                code {
                    "| hit(Vec3, Vec3) F64";
                }
                ", not ";
                code {
                    "| hit(a: Vec3, b: Vec3) F64";
                }
                "; each implementation names them.";
            }
            = code.block(proto_sample());
            = code.block(proto_members_sample());
            p {
                "A module's type parameter can be bounded: ";
                code {
                    "mod Largest[T[Ord]]";
                }
                " takes only types that implement ";
                code {
                    "Ord";
                }
                ", and its code calls their methods. Each instance calls its own type's, with no dispatch, so scalars implement protocols too. ";
                code {
                    "std:Ord";
                }
                " has ";
                code {
                    "Ord";
                }
                " for the numbers and ";
                code {
                    "Str";
                }
                ", and ";
                code {
                    "Order[T[Ord]]";
                }
                ": max, min, clamp, sort, search.";
            }
            = code.block(bounds_sample());
            = code.block(std_bounds_sample());
            h2 {
                "Strings";
            }
            p {
                "A ";
                code {
                    "Str";
                }
                " is a JavaScript string. Template strings call ";
                code {
                    "str";
                }
                " on each ";
                code {
                    "${...}";
                }
                ". A ";
                code {
                    "\\\\";
                }
                " line is raw text, and the string ends at the first line that is not one.";
            }
            = code.block(strings_sample());
            = code.block(templates_sample());
            = code.block(escapes_sample());
            = code.block(multiline_sample());
            h2 {
                "Arrays, generators, and memories";
            }
            p {
                "Arrays are WasmGC arrays; iterator stages like ";
                code {
                    "filter";
                }
                " and ";
                code {
                    "fold";
                }
                " are syntax that compiles to one loop. ";
                a {
                    href = "#/iterators";
                    "The iterators page";
                }
                " covers every stage. ";
                code {
                    "mem";
                }
                " and ";
                code {
                    "vec";
                }
                " are top-level growable arrays of scalars for hot loops. An element is U8, I8, U16, I16, I32, U32, I64, U64, F32, F64, an integer enum, or a distinct type over one of these; not Bool, Str, or a struct (for flags, use U8 and store 0 or 1). A narrow element (U8, I8, U16, I16) keeps a computed value's low bits; a literal that does not fit is an error. Growing with resize(n) zero-fills the new elements. An index past the length (or negative) traps, as an array's does; smallUnsafe and fastUnsafe check only the capacity.";
            }
            = code.block(arrays_sample());
            = code.block(generator_sample());
            p {
                "A generator cannot be zipped: ";
                code {
                    "for (evens(4), 0 ..< 4) |v, i|";
                }
                " is an error. To number its values, count with a ";
                code {
                    "let";
                }
                ":";
            }
            = code.block(generator_index_sample());
            = code.block(mem_sample());
            h2 {
                "Errors";
            }
            p {
                code {
                    "assert";
                }
                " and ";
                code {
                    "fatal";
                }
                " trap, and a trap is never caught. JavaScript exceptions are caught with ";
                code {
                    "try";
                }
                ", an expression like ";
                code {
                    "if";
                }
                ".";
            }
            = code.block(assert_sample());
            = code.block(try_sample());
            = code.block(try_default_sample());
            p {
                "A failure the caller should expect (bad input, a missing key) is a ";
                code {
                    "Result[T, E]";
                }
                ", made with ";
                code {
                    "ok";
                }
                " or ";
                code {
                    "err";
                }
                " and read with ";
                code {
                    "is_ok";
                }
                ", ";
                code {
                    "value";
                }
                ", ";
                code {
                    "error";
                }
                ", or ";
                code {
                    "value_or";
                }
                ". ";
                code {
                    "try r";
                }
                " is r's value, or returns r's error from a function whose Result has the same error type.";
            }
            = code.block(result_sample());
            h2 {
                "defer";
            }
            = code.block(defer_sample());
            = code.block(defer_return_sample());
            p {
                code {
                    "errdefer";
                }
                " runs only when the function returns an error: a ";
                code {
                    "try";
                }
                " that fails, or a returned Result that is one.";
            }
            = code.block(errdefer_sample());
            h2 {
                "Tests and benchmarks";
            }
            p {
                code {
                    "utu test";
                }
                " runs each test, a mod's too (named ";
                code {
                    "geo: name";
                }
                "); no two show one name. A test whose await waits on nothing (or on anything for 10 s) fails; so does one whose callback throws (one scheduled for now, before the next test starts); what throws after the tests is one more failure; the run ends after its summary, whatever timers are left. ";
                code {
                    "utu bench";
                }
                " runs each bench in timed runs: each run does the setup once (its ";
                code {
                    "defer";
                }
                "s after), then the ";
                code {
                    "measure";
                }
                " block n times. It warms the engine up, doubles n until a run takes 20 ms, then prints the median time per iteration of 11 runs, less the median of runs of the setup alone. A bench fails as a test does (an await that never ends, a callback's error) and the other rows still print. A bench does not ";
                code {
                    "return";
                }
                ". Every command checks tests and benches, an imported file's too (they run only from their own file), not only ";
                code {
                    "utu test";
                }
                ".";
            }
            = code.block(tests_sample());
            = code.shell(tests_shell());
            h2 {
                "Promises and await";
            }
            p {
                code {
                    "Promise[T]";
                }
                " is a real JavaScript promise. Any function may ";
                code {
                    "await";
                }
                " (through JSPI: Chrome 126+, Node 23+, Bun); ";
                code {
                    ".then";
                }
                " runs anywhere. A closure utu calls may await too; one the host calls (a ";
                code {
                    ".then";
                }
                " callback, an event handler) may not: JSPI cannot suspend through the host's frame. ";
                code {
                    "await for";
                }
                " reads a ";
                code {
                    "Stream[T]";
                }
                ".";
            }
            = code.block(await_sample());
            = code.block(then_sample());
            = code.block(stream_sample());
            h2 {
                "Inline JavaScript";
            }
            p {
                code {
                    "@es";
                }
                " binds a JavaScript function to a typed ";
                code {
                    "fun";
                }
                ". For whole libraries, see ";
                a {
                    href = "#/javascript";
                    "JavaScript and npm";
                }
                ".";
            }
            = code.block(es_sample());
            h2 {
                "Embedded languages";
            }
            p {
                "An ";
                code {
                    "@name/\\ ... \\/";
                }
                " envelope hands its text to a language the compiler knows: ";
                code {
                    "@json";
                }
                " (";
                a {
                    href = "#/data";
                    "typed JSON";
                }
                "), ";
                code {
                    "@wat";
                }
                " (WebAssembly text), ";
                code {
                    "@css";
                }
                ", and ";
                code {
                    "@wutu";
                }
                " (";
                a {
                    href = "#/wutu";
                    "markup";
                }
                ").";
            }
            = code.block(json_sample());
            = code.block(wat_sample());
            = code.block(css_sample());
            = code.block(wutu_sample());
            h2 {
                "Entry points and doc comments";
            }
            p {
                code {
                    "main";
                }
                " is a program; ";
                code {
                    "lib";
                }
                " exports functions to JavaScript instead. ";
                code {
                    "///";
                }
                " comments document the next declaration.";
            }
            = code.block(lib_sample());
            = code.block(lib_js());
            = ui.further("new_spec2.md", "the language specification");
        }
        \/
    }
}
