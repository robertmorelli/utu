using Browser from std:Browser;
using ui from "./ui.utu";
mod benchmarks {
    fn page() Browser.HTMLElement {
        @wutu/\
        article.page {
            = ui.header("Benchmarks", "The same programs in utu, Rust, JavaScript, and other languages that compile to Wasm, timed in V8.");
            p {
                "Each program is written once per language, the same way: the same data structures, loops, and order of operations, with only the language's idiom differing. Every port's result is checked against the others before it is timed. Each runs in d8 (15.6.75.16, V8's shell) in a process of its own; a time is the median of 20 samples after 5 warmups. utu compiles warm with the self-hosted compiler; the others build from clean. A size is what must ship to run it: the Wasm module, or JavaScript minified.";
            }
            p {
                "Run them again with ";
                code {
                    "bun run bench:deltablue-table";
                }
                " and ";
                code {
                    "bun run bench:programs-d8";
                }
                ".";
            }
            h2 {
                "DeltaBlue";
            }
            p {
                "V8's incremental constraint solver: a graph of small objects, planned and re-planned. Chain and projection each solve 1,048 variables 20 times. utu is built at ";
                code {
                    "-O3";
                }
                " and ";
                code {
                    "-Oz";
                }
                ", each with and without ";
                code {
                    "--safe";
                }
                " (which puts back the bounds checks Wasm does not make itself). Rc Rust is a graph of Rc<RefCell<_>> with no unsafe code; unsafe Rust uses an arena and unchecked indexing. Dart compiles to WasmGC; Go and Swift have no WasmGC backend, so theirs are linear-memory modules carrying their own runtimes, which is most of their size.";
            }
            table.wide {
                thead {
                    tr {
                        th {
                            "";
                        }
                        th {
                            "chain, ms";
                        }
                        th {
                            "projection, ms";
                        }
                        th {
                            "build, ms";
                        }
                        th {
                            "size, KB";
                        }
                        th {
                            "gzip, KB";
                        }
                    }
                }
                tbody {
                    tr {
                        th {
                            "Rc Rust";
                        }
                        td {
                            "16.7";
                        }
                        td {
                            "16.9";
                        }
                        td {
                            "382";
                        }
                        td {
                            "38.0";
                        }
                        td {
