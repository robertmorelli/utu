using Browser from std:Browser;
using code from "./code.utu";
using ui from "./ui.utu";
mod web {
    fn hello_sample() Str {
        \\using Browser from std:Browser;
        \\
        \\fn greeting(name: Str) Browser.HTMLElement {
        \\    @wutu/\
        \\    section.greeting#hello {  /* tag.class#id makes an element */
        \\        h2 {  /* a child element */
        \\            "Hello, ";  /* a text node */
        \\            = name;  /* text from an expression */
        \\        }
        \\        p.note.quiet {  /* several classes */
        \\            "Welcome back.";
        \\        }
        \\    }
        \\    \/;
        \\}
        \\
        \\export main() void {
        \\    Browser.document.body.append(greeting("friend"));
        \\}
        ;
    }
    fn namespaces_sample() Str {
        \\using Browser from std:Browser;
        \\
        \\fn chart(done: Bool, draft: Str) Browser.HTMLElement {
        \\    @wutu/\
        \\    figure {
        \\        canvas {
        \\            width = "600";  /* attribute: the bitmap's resolution */
        \\            width: 300px;  /* CSS: its size on the page */
        \\            aria-label = "Sales";
        \\        }
        \\        input {
        \\            hidden = $[done];  /* a boolean attribute, present when true */
        \\            .value = $[draft];  /* a typed DOM property */
        \\        }
        \\        a {
        \\            href = "/about";
        \\            data-kind = "nav";
        \\            color: rgb(30 60 120);  /* CSS declarations sit on their element */
        \\            "About";
        \\        }
        \\    }
        \\    \/;
        \\}
        \\
        \\export main() void {
        \\    Browser.document.body.append(chart(false, "draft"));
        \\}
        ;
    }
    fn text_sample() Str {
        \\using Browser from std:Browser;
        \\
        \\fn stats(user: Str, count: I32, ratio: F64) Browser.HTMLElement {
        \\    @wutu/\
        \\    p {
        \\        title = $["Stats for " + user];  /* an attribute built from text */
        \\        "User ";
        \\        b { = user; }
        \\        " has ";
        \\        = count.to_str();
        \\        " items (";
        \\        $[(ratio * 100.0).to_str()];  /* $[...] works as well as = */
        \\        "%). Escapes: \"quoted\" →";
        \\    }
        \\    \/;
        \\}
        \\
        \\export main() void {
        \\    Browser.document.body.append(stats("<b>ada</b>", 3, 0.5));   // text, never HTML
        \\}
        ;
    }
    fn events_closure_sample() Str {
        \\using Browser from std:Browser;
        \\
        \\struct Plant:
        \\    | name: Str
        \\    | watered: Bool
        \\
        \\fn plant_card(plant: Plant) Browser.HTMLElement {
        \\    @wutu/\
        \\    article {
        \\        h2 { = plant.name; }
        \\        button as toggle {  /* name the node: toggle */
        \\            type = "button";
        \\            "Water me";
        \\            @click=$[cl(event) void {       // a typed closure as the listener
        \\                plant.watered = not plant.watered;
        \\                toggle.textContent = if plant.watered { "Watered"; } else { "Water me"; };
        \\            }];
        \\        }
        \\    }
        \\    \/;
        \\}
        \\
        \\export main() void {
        \\    Browser.document.body.append(plant_card(Plant { name: "Fern", watered: false }));
        \\}
        ;
    }
    fn events_on_sample() Str {
        \\using Browser from std:Browser;
        \\
        \\struct Counter:
        \\    | n: I32
        \\    | last: Str
        \\
        \\export main() void {
        \\    let state = Counter { n: 0, last: "" };
        \\    let app = @wutu/\
        \\    @reactive;
        \\    main {
        \\        button {
        \\            "Add one";
        \\            on click {                      // `event` is in scope, typed
        \\                state.n += 1;
        \\                state.last = event.type;
        \\            };
        \\        }
        \\        input {
        \\            placeholder = "Type";
        \\            on keydown { state.last = event.key; };
        \\        }
        \\        p { = `${state.n} clicks, last event: ${state.last}`; }
        \\    }
        \\    \/;
        \\    Browser.document.body.append(app);
        \\}
        ;
    }
    fn components_sample() Str {
        \\using Browser from std:Browser;
        \\
        \\fn badge(label: Str) Browser.HTMLElement {
        \\    @wutu/\
        \\    span.badge {
        \\        padding: 0.1rem 0.5rem;
        \\        border-radius: 1rem;
        \\        background: gold;
        \\        = label;
        \\    }
        \\    \/;
        \\}
        \\
        \\fn card(title: Str, body: Browser.HTMLElement) Browser.HTMLElement {
        \\    @wutu/\
        \\    article.card {
        \\        h3 { = title; = badge("new"); }  /* a component is a function call */
        \\        = body;  /* a slot is just a node parameter */
        \\    }
        \\    \/;
        \\}
        \\
        \\export main() void {
        \\    let content = @wutu/\
        \\    p { "Any element can go in the slot."; }
        \\    \/;
        \\    Browser.document.body.append(card("Slots", content));
        \\}
        ;
    }
    fn conditions_sample() Str {
        \\using Browser from std:Browser;
        \\
        \\fn status(stock: I32) Browser.HTMLElement {
        \\    @wutu/\
        \\    p {
        \\        if $[stock == 0] {
        \\            b { "Sold out"; }
        \\        } else if $[stock < 5] {
        \\            "Only ";
        \\            = stock.to_str();
        \\            " left";
        \\        } else {
        \\            "In stock";
        \\        }
        \\    }
        \\    \/;
        \\}
        \\
        \\export main() void {
        \\    Browser.document.body.append(status(3));
        \\}
        ;
    }
    fn for_sample() Str {
        \\using Browser from std:Browser;
        \\
        \\fn ranking(names: Array[Str]) Browser.HTMLElement {
        \\    @wutu/\
        \\    ol {
        \\        for $[names] |name, i| {  /* the index is a U64 */
        \\            li {
        \\                data-rank = $[(i.to_i32() + 1).to_str()];
        \\                = name;
        \\            }
        \\        }
        \\    }
        \\    \/;
        \\}
        \\
        \\fn long_words(words: Array[Str]) Browser.HTMLElement {
        \\    @wutu/\
        \\    ul {
        \\        for $[words filter |w| { w.len() > 4; }] |w| {  /* a pipeline, no temporary array */
        \\            li { = w; }
        \\        }
        \\    }
        \\    \/;
        \\}
        \\
        \\export main() void {
        \\    Browser.document.body.append(ranking(["ada", "grace"]));
        \\    Browser.document.body.append(long_words(["tiny", "enormous", "huge", "gigantic"]));
        \\}
        ;
    }
    fn keyed_sample() Str {
        \\using Browser from std:Browser;
        \\
        \\struct Todo:
        \\    | id: Str
        \\    | title: Str
        \\    | done: Bool
        \\
        \\struct State:
        \\    | todos: Array[Todo]
        \\
        \\export main() void {
        \\    let state = State { todos: [
        \\        Todo { id: "a", title: "Water the fern", done: false },
        \\        Todo { id: "b", title: "Repot the cactus", done: false }
        \\    ] };
        \\    let app = @wutu/\
        \\    @reactive;
        \\    ul {
        \\        for $[state.todos] |todo| key $[todo.id] {  /* identity follows the key */
        \\            li {
        \\                = todo.title;
        \\                button {
        \\                    "Done";
        \\                    on click {
        \\                        state.todos = state.todos filter |t| { t.id != todo.id; } collect(Todo);
        \\                    };
        \\                }
        \\            }
        \\        }
        \\    }
        \\    \/;
        \\    Browser.document.body.append(app);
        \\}
        ;
    }
    fn bind_sample() Str {
        \\using Browser from std:Browser;
        \\
        \\struct Order:
        \\    | name: Str
        \\    | gift: Bool
        \\    | amount: F64
        \\
        \\export main() void {
        \\    let order = Order { name: "", gift: false, amount: 1.0 };
        \\    let app = @wutu/\
        \\    @reactive;
        \\    form {
        \\        input { placeholder = "Name"; bind:value = order.name; }
        \\        label {
        \\            input { type = "checkbox"; bind:checked = order.gift; }
        \\            "Gift wrap";
        \\        }
        \\        input { type = "number"; bind:number = order.amount; }
        \\        p {
        \\            = `${order.amount} for ${order.name}`;
        \\            if $[order.gift] { " (wrapped)"; }
        \\        }
        \\    }
        \\    \/;
        \\    Browser.document.body.append(app);
        \\}
        ;
    }
    fn stored_sample() Str {
        \\using Browser from std:Browser;
        \\
        \\struct Prefs:
        \\    | name: Str
        \\    | visits: I32
        \\
        \\export main() void {
        \\    let prefs = @stored/\
        \\        Prefs "prefs-v1" Prefs { name: "", visits: 0 }
        \\    \/;                                          // loaded, validated, saved after events
        \\    prefs.visits += 1;
        \\    let app = @wutu/\
        \\    @reactive;
        \\    main {
        \\        input { bind:value = prefs.name; }
        \\        p { = `Visit ${prefs.visits}, ${prefs.name}`; }
        \\    }
        \\    \/;
        \\    Browser.document.body.append(app);
        \\}
        ;
    }
    fn stored_manual_sample() Str {
        \\using Browser from std:Browser;
        \\
        \\struct Draft:
        \\    | text: Str
        \\
        \\export main() void {
        \\    let draft = @stored/\
        \\        Draft "draft-v1" manual Draft { text: "" }
        \\    \/;                                          // saves only when asked
        \\    let app = @wutu/\
        \\    @reactive;
        \\    main {
        \\        textarea { bind:value = draft.text; }
        \\        button {
        \\            "Save";
        \\            on click { wutu.save("draft-v1"); };
        \\        }
        \\    }
        \\    \/;
        \\    Browser.document.body.append(app);
        \\}
        ;
    }
    fn document_sample() Str {
        \\using Browser from std:Browser;
        \\
        \\export main() void {
        \\    let app = @wutu/\
        \\    @document {  /* document-level CSS, before the root */
        \\        :root { --accent: oklch(65% 0.15 60); }
        \\        body { margin: 0; font: 1rem system-ui; }
        \\        @keyframes pop { from { scale: 0.9; } to { scale: 1; } }
        \\    }
        \\    main {
        \\        padding: 2rem;
        \\        h1 {
        \\            color: var(--accent);
        \\            animation: pop 0.3s;
        \\            "Tokens and resets";
        \\        }
        \\    }
        \\    \/;
        \\    Browser.document.body.append(app);
        \\}
        ;
    }
    fn local_css_sample() Str {
        \\using Browser from std:Browser;
        \\
        \\fn toolbar() Browser.HTMLElement {
        \\    @wutu/\
        \\    nav {
        \\        display: flex;
        \\        gap: 1rem;
        \\        # a media query, at the element it changes
        \\        @media (width < 40rem) {
        \\            flex-direction: column;
        \\        }
        \\        # a scoped selector rule, for relations like siblings
        \\        @ & > a + a {
        \\            border-left: 1px solid gray;
        \\        }
        \\        a {
        \\            href = "#/";
        \\            :hover { text-decoration: underline; }
        \\            ::after { content: " >"; }
        \\            "Home";
        \\        }
        \\        a { href = "#/docs"; "Docs"; }
        \\    }
        \\    \/;
        \\}
        \\
        \\export main() void {
        \\    Browser.document.body.append(toolbar());
        \\}
        ;
    }
    fn dynamic_css_sample() Str {
        \\using Browser from std:Browser;
        \\
        \\fn meter(progress: I32, hue: I32) Browser.HTMLElement {
        \\    @wutu/\
        \\    div.bar {
        \\        height: 0.5rem;  /* static: compiled to a shared class */
        \\        background: lightgray;
        \\        i {
        \\            display: block;
        \\            height: 100%;
        \\            width: $[progress.to_str() + "%"];  /* computed at render */
        \\            background: $["hsl(" + hue.to_str() + " 70% 50%)"];
        \\        }
        \\    }
        \\    \/;
        \\}
        \\
        \\export main() void {
        \\    Browser.document.body.append(meter(40, 140));
        \\}
        ;
    }
    fn css_sheet_sample() Str {
        \\using Browser from std:Browser;
        \\
        \\fn sheet() Str {
        \\    @css/\
        \\    @layer theme {
        \\        .card { border: 1px solid oklch(40% 0.12 150); border-radius: 8px; }
        \\    }
        \\    \/;
        \\}
        \\
        \\export main() void {
        \\    let app = @wutu/\
        \\    @style $[sheet()];  /* install any stylesheet, once */
        \\    div {
        \\        class = "card";
        \\        "Styled by a plain CSS class";
        \\    }
        \\    \/;
        \\    Browser.document.body.append(app);
        \\}
        ;
    }
    fn alias_sample() Str {
        \\using Browser from std:Browser;
        \\
        \\fn search() Browser.HTMLElement {
        \\    @wutu/\
        \\    form {
        \\        input as query { type = "search"; }
        \\        output as result { "Nothing yet"; }
        \\        button {
        \\            "Search";
        \\            @click=$[cl(event) void {
        \\                event.preventDefault();
        \\                result.textContent = "Looking for " + query.value;   // query is an HTMLInputElement
        \\                query.focus();
        \\            }];
        \\        }
        \\    }
        \\    \/;
        \\}
        \\
        \\export main() void {
        \\    Browser.document.body.append(search());
        \\}
        ;
    }
    fn route_sample() Str {
        \\using Browser from std:Browser;
        \\
        \\export main() void {
        \\    let app = @wutu/\
        \\    @reactive;
        \\    main {
        \\        nav {
        \\            a { href = "#/"; "Home"; }
        \\            a { href = "#/about"; "About"; }
        \\        }
        \\        if $[wutu.route() == "/about"] {  /* the hash path; changes re-render */
        \\            h1 { "About"; }
        \\        } else {
        \\            h1 { "Home"; }
        \\        }
        \\    }
        \\    \/;
        \\    Browser.document.body.append(app);
        \\}
        ;
    }
    fn island_sample() Str {
        \\using Browser from std:Browser;
        \\
        \\struct Clock:
        \\    | ticks: I32
        \\
        \\fn clock(c: Clock) Browser.HTMLElement {
        \\    wutu.interval("tick", 1000.0, cl() { c.ticks += 1; });
        \\    @wutu/\
        \\    @island "clock";  /* updates on its own */
        \\    p { = `${c.ticks} seconds`; }
        \\    \/;
        \\}
        \\
        \\export main() void {
        \\    let c = Clock { ticks: 0 };
        \\    let app = @wutu/\
        \\    @reactive;
        \\    main {
        \\        = clock(c);
        \\        button {
        \\            "Reset";
        \\            on click {
        \\                c.ticks = 0;
        \\                wutu.invalidate("clock");           // refresh the island from outside
        \\            };
        \\        }
        \\    }
        \\    \/;
        \\    Browser.document.body.append(app);
        \\}
        ;
    }
    fn layers_sample() Str {
        \\using Browser from std:Browser;
        \\
        \\export main() void {
        \\    Browser.document.body.append(@wutu/\
        \\    @document {
        \\        main p.note { color: crimson; padding: 1rem; }
        \\    }
        \\    main {
        \\        p.note {
        \\            color: seagreen;        /* written here, so it wins */
        \\            "green, with the document's padding";
        \\        }
        \\    }
        \\    \/);
        \\}
        ;
    }
    fn unmanaged_sample() Str {
        \\using Browser from std:Browser;
        \\
        \\export main() void {
        \\    Browser.document.body.append(@wutu/\
        \\    @reactive;
        \\    main {
        \\        div as chart {
        \\            @unmanaged;
        \\            data-kind = "chart";
        \\            on mount {
        \\                chart.append(Browser.document.createTextNode("drawn by JavaScript"));
        \\            };
        \\        }
        \\        div as list {
        \\            height: 6rem;
        \\            overflow: auto;
        \\            on scroll {
        \\                chart.title = list.className;   // quiet: only elements change
        \\            };
        \\        }
        \\    }
        \\    \/);
        \\}
        ;
    }
    fn lazy_sample() Str {
        \\using Browser from std:Browser;
        \\
        \\export main() void {
        \\    Browser.document.body.append(@wutu/\
        \\    @reactive;
        \\    main {
        \\        nav {
        \\            a { href = "#/"; "Home"; }
        \\            a { href = "#/guide"; "Guide"; }
        \\        }
        \\        if $[wutu.route() == "/guide"] {
        \\            = wutu.lazy("./guide.utu");    /* its own chunk */
        \\        } else {
        \\            p { "Welcome."; }
        \\        }
        \\    }
        \\    \/);
        \\}
        ;
    }
    fn build_shell() Str {
        \\node cli/wutu.mjs dev main.utu --port 4176
        \\node cli/wutu.mjs format main.utu --check
        \\node cli/wutu.mjs build main.utu --out dist/site --title "My site"
        ;
    }
    fn page() Browser.HTMLElement {
        @wutu/\
        article.page {
            = ui.header("Wutu", "Markup and CSS in one typed expression. A component is an ordinary function that returns a real DOM element.");
            p {
                "Every sample below is a whole program. Paste one into the ";
                a {
                    href = "#/playground";
                    "Playground";
                }
                " to see it run.";
            }
            h2 {
                "Elements, classes, and text";
            }
            p {
                "Every element head starts with a tag, so ";
                code {
                    ".card";
                }
                " alone never silently makes a div. Leaf statements end with a semicolon; blocks do not. ";
                code {
                    "# ";
                }
                " first on a line starts a comment; at the end of a line, use ";
                code {
                    "/* … */";
                }
                ". Any other # is text, so hex colors just work.";
            }
            = code.block(hello_sample());
            h2 {
                "Attributes, properties, and CSS";
            }
            p {
                "Three namespaces, told apart by syntax: ";
                code {
                    "name = ...;";
                }
                " is an attribute, ";
                code {
                    ".name = ...;";
                }
                " a DOM property, and ";
                code {
                    "name: value;";
                }
                " CSS. Attributes are checked per tag.";
            }
            = code.block(namespaces_sample());
            h2 {
                "Text and interpolation";
            }
            = code.block(text_sample());
            h2 {
                "Events";
            }
            p {
                code {
                    "@click=$[cl(event) void { ... }];";
                }
                " attaches a closure; ";
                code {
                    "on click { ... };";
                }
                " is the short form with an implicit typed ";
                code {
                    "event";
                }
                ". String handlers are rejected.";
            }
            = code.block(events_closure_sample());
            = code.block(events_on_sample());
            h2 {
                "Components and slots";
            }
            = code.block(components_sample());
            h2 {
                "Conditions and lists";
            }
            = code.block(conditions_sample());
            = code.block(for_sample());
            = code.block(keyed_sample());
            h2 {
                "Reactive views and bindings";
            }
            p {
                code {
                    "@reactive;";
                }
                " at the start of a root template re-renders it after each event handler changes ordinary structs. No proxies, no virtual DOM. ";
                code {
                    "bind:value";
                }
                ", ";
                code {
                    "bind:checked";
                }
                ", and ";
                code {
                    "bind:number";
                }
                " connect controls to fields both ways.";
            }
            = code.block(bind_sample());
            h2 {
                "Stored state";
            }
            p {
                code {
                    "@stored";
                }
                " keeps a struct in localStorage, validating it on load and falling back to the defaults.";
            }
            = code.block(stored_sample());
            = code.block(stored_manual_sample());
            h2 {
                "CSS";
            }
            p {
                "Static declarations become shared classes; ";
                code {
                    "$[...]";
                }
                " values are set at render. ";
                code {
                    "@ selector";
                }
                " is a scoped rule, ";
                code {
                    "@document";
                }
                " holds page-wide CSS, and ";
                code {
                    "@css";
                }
                " with ";
                code {
                    "@style";
                }
                " installs anything else.";
            }
            = code.block(local_css_sample());
            = code.block(dynamic_css_sample());
            = code.block(document_sample());
            = code.block(css_sheet_sample());
            h2 {
                "Named nodes";
            }
            p {
                code {
                    "tag as name";
                }
                " names a node within its template, typed as that element.";
            }
            = code.block(alias_sample());
            h2 {
                "Routes and islands";
            }
            p {
                code {
                    "wutu.route()";
                }
                " reads the hash path. ";
                code {
                    "@island";
                }
                " makes a view that updates on its own; ";
                code {
                    "wutu.invalidate";
                }
                " refreshes it from outside.";
            }
            = code.block(route_sample());
            = code.block(island_sample());
            h2 {
                "The nearer rule wins";
            }
            p {
                "Document CSS and shared sheets sit in a cascade layer below element styles, so what is written on an element beats a document rule of any specificity.";
            }
            = code.block(layers_sample());
            h2 {
                "Elements JavaScript owns, and quiet handlers";
            }
            p {
                code {
                    "@unmanaged;";
                }
                " gives an element's insides to JavaScript, and ";
                code {
                    "on mount";
                }
                " runs once when it appears. A handler that only changes ";
                code {
                    "as";
                }
                " elements is quiet: no render follows it (or write ";
                code {
                    "on scroll quiet";
                }
                ").";
            }
            = code.block(unmanaged_sample());
            h2 {
                "Lazy pages";
            }
            p {
                code {
                    "wutu.lazy";
                }
                " shows a page built as its own chunk, fetched the first time it is shown. This site loads each page that way.";
            }
            = code.block(lazy_sample());
            h2 {
                "Build, preview, and prerender";
            }
            p {
                "The preview rebuilds on save and reloads, keeping form values and scroll. A production build prerenders the page, and deploys as ";
                code {
                    "index.html";
                }
                ", ";
                code {
                    "app.js";
                }
                ", and ";
                code {
                    "app.wasm";
                }
                ".";
            }
            = code.shell(build_shell());
            = ui.further("docs/wutu.md", "Wutu: markup and CSS in one expression");
            = ui.further("examples/wutu-five/README.md", "five working Wutu websites");
        }
        \/;
    }
}
