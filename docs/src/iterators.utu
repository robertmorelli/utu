            }
            p {
                code {
                    "T";
                }
                " is the element type entering a stage. Terminals that build arrays or groups name their element and key types, so empty inputs and changed types stay unambiguous.";
            }
            section {
                h2 {
                    "Sources";
                }
                p {
                    "Where values come from. Ranges and arrays are read in place; nothing is copied.";
                }
                h3 {
                    id = "it-array";
                    "Arrays";
                }
                p {
                    "Any ";
                    code {
                        "Array[T]";
                    }
                    " value, evaluated once, before the loop starts.";
                }
                = code.block(array_sample());
                h3 {
                    id = "it-range";
                    code {
                        "(a ..< b)";
                    }
                }
                p {
                    "The integers from ";
                    code {
                        "a";
                    }
                    " up to but not including ";
                    code {
                        "b";
                    }
                    ". No array is built; written in parentheses.";
                }
                = code.block(range_sample());
                h3 {
                    id = "it-range_inclusive";
                    code {
                        "(a ... b)";
                    }
                }
                p {
                    "The integers from ";
                    code {
                        "a";
                    }
                    " through ";
                    code {
                        "b";
                    }
                    ", inclusive.";
                }
                = code.block(range_inclusive_sample());
                h3 {
                    id = "it-nested";
                    code {
                        "(pipeline)";
                    }
                }
                p {
                    "A parenthesized pipeline that ends in an array is a source for the next one.";
                }
                = code.block(nested_sample());
                h3 {
                    id = "it-strings";
                    "Strings and buffers";
                }
                p {
                    "A ";
                    code {
                        "Str";
                    }
                    " is not a source: split it, or count over its code units. A ";
                    code {
                        "Buffer";
                    }
                    " becomes one with ";
                    code {
                        "finish()";
                    }
                    ".";
                }
                = code.block(strings_sample());
            }
            section {
                h2 {
                    "Stages";
                }
                p {
                    "Stages change the values on their way to the terminal. Each runs inside the same loop.";
                }
                h3 {
                    id = "it-map";
                    code {
                        "map";
                    }
                }
                p {
                    "Transform each value.";
                }
                = code.block(map_sample());
                h3 {
                    id = "it-filter";
                    code {
                        "filter";
                    }
                }
                p {
                    "Keep the values the predicate is true of.";
                }
                = code.block(filter_sample());
                h3 {
                    id = "it-flat_map";
                    code {
                        "flat_map";
                    }
                }
                p {
                    "Return an array per value; its values flow on in order.";
                }
                = code.block(flat_map_sample());
                h3 {
                    id = "it-take";
                    code {
                        "take(n)";
                    }
                }
                p {
                    "The first ";
                    code {
                        "n";
                    }
                    " values; later stages and the source stop there.";
                }
                = code.block(take_sample());
                h3 {
                    id = "it-skip";
                    code {
                        "skip(n)";
                    }
                }
                p {
                    "All but the first ";
                    code {
                        "n";
                    }
                    " values.";
                }
                = code.block(skip_sample());
                h3 {
                    id = "it-take_while";
                    code {
                        "take_while";
                    }
                }
                p {
                    "Values up to the first one the predicate is false of.";
                }
                = code.block(take_while_sample());
                h3 {
                    id = "it-skip_while";
                    code {
                        "skip_while";
                    }
                }
                p {
                    "Drop the leading values the predicate is true of, then keep everything.";
                }
                = code.block(skip_while_sample());
                h3 {
                    id = "it-zip";
                    code {
                        "zip(other)";
                    }
                }
                p {
                    "Pair each value with the other array's, stopping at the shorter one.";
                }
                = code.block(zip_sample());
                h3 {
                    id = "it-chain";
                    code {
                        "chain(other)";
                    }
                }
                p {
                    "After the stages before it finish, go on with another array.";
                }
                = code.block(chain_sample());
                h3 {
                    id = "it-repeat";
                    code {
                        "repeat(n)";
                    }
                }
                p {
                    "Emit each value ";
                    code {
                        "n";
                    }
                    " times in a row.";
                }
                = code.block(repeat_sample());
                h3 {
                    id = "it-scan";
                    code {
                        "scan(init)";
                    }
                }
                p {
                    "Like ";
                    code {
                        "fold";
                    }
                    ", but passes on every running accumulator (not the seed).";
                }
                = code.block(scan_sample());
                h3 {
                    id = "it-index";
                    "Index captures";
                }
                p {
                    "Any body may name one more capture: the zero-based ";
                    code {
                        "U64";
                    }
                    " position of the value entering that stage.";
                }
                = code.block(index_sample());
            }
            section {
                h2 {
                    "Terminals";
                }
                p {
                    "A pipeline must end in a terminal, which consumes it immediately. Terminals that may find nothing return ";
                    code {
                        "?Found[T]";
                    }
                    ": unwrap ";
                    code {
                        ".value";
                    }
                    " with ";
                    code {
                        "promote";
                    }
                    " or ";
                    code {
                        "orelse";
                    }
                    ".";
                }
                h3 {
                    id = "it-fold";
                    code {
                        "fold(init)";
                    }
                }
                p {
                    "Combine every value into an accumulator; the seed on empty input.";
                }
                = code.block(fold_sample());
                h3 {
                    id = "it-each";
                    code {
                        "each";
                    }
                }
                p {
                    "Run the body for every value, in order.";
                }
                = code.block(each_sample());
                h3 {
                    id = "it-sum";
                    code {
                        "sum";
                    }
                }
                p {
                    "Add the values; zero when empty.";
                }
                = code.block(sum_sample());
                h3 {
                    id = "it-product";
                    code {
                        "product";
                    }
                }
                p {
                    "Multiply the values; one when empty.";
                }
                = code.block(product_sample());
                h3 {
                    id = "it-fast_sum";
                    code {
                        "fast_sum";
                    }
                }
                p {
                    code {
                        "sum";
                    }
                    " with four running totals so additions overlap; exact for integers, floats may round differently.";
                }
                = code.block(fast_sum_sample());
                h3 {
                    id = "it-count";
                    code {
                        "count";
                    }
                }
                p {
                    "How many values arrive.";
                }
                = code.block(count_sample());
                h3 {
                    id = "it-count_where";
                    code {
                        "count_where";
                    }
                }
                p {
                    "How many values the predicate is true of.";
                }
                = code.block(count_where_sample());
                h3 {
                    id = "it-any";
                    code {
                        "any";
                    }
                }
                p {
                    "True when some value matches; stops at the first. False when empty.";
                }
                = code.block(any_sample());
                h3 {
                    id = "it-all";
                    code {
                        "all";
                    }
                }
                p {
                    "True when every value matches; stops at the first miss. True when empty.";
                }
                = code.block(all_sample());
                h3 {
                    id = "it-first_index";
                    code {
                        "first_index";
                    }
                }
                p {
                    "The stage position of the first match, or -1.";
                }
                = code.block(first_index_sample());
                h3 {
                    id = "it-last_index";
                    code {
                        "last_index";
                    }
                }
                p {
                    "The stage position of the last match, or -1.";
                }
                = code.block(last_index_sample());
                h3 {
                    id = "it-collect";
                    code {
                        "collect(T)";
                    }
                }
                p {
                    "A new array of the values. The element type is written out.";
                }
                = code.block(collect_sample());
                h3 {
                    id = "it-sort";
                    code {
                        "sort(T)";
                    }
                }
                p {
                    "A new array, stably sorted by a less-than comparator. The source is untouched.";
                }
                = code.block(sort_sample());
                h3 {
                    id = "it-distinct_by";
                    code {
                        "distinct_by(T, K)";
                    }
                }
                p {
                    "The first value for each key, in input order.";
                }
                = code.block(distinct_by_sample());
                h3 {
                    id = "it-group_by";
                    code {
                        "group_by(T, K)";
                    }
                }
                p {
                    "Values grouped by key; groups and members keep encounter order. Each group has ";
                    code {
                        ".key";
                    }
                    " and ";
                    code {
                        ".values";
                    }
                    ".";
                }
                = code.block(group_by_sample());
                h3 {
                    id = "it-partition";
                    code {
                        "partition(T)";
                    }
                }
                p {
                    "Two arrays: matches at ";
                    code {
                        "[0]";
                    }
                    ", the rest at ";
                    code {
                        "[1]";
                    }
                    ", both in order.";
                }
                = code.block(partition_sample());
                h3 {
                    id = "it-batched";
                    code {
                        "batched(T, n)";
                    }
                }
                p {
                    "Non-overlapping batches of ";
                    code {
                        "n";
                    }
                    "; the last may be short.";
                }
                = code.block(batched_sample());
                h3 {
                    id = "it-windows";
                    code {
                        "windows(T, n)";
                    }
                }
                p {
                    "Every run of ";
                    code {
                        "n";
                    }
                    " consecutive values, overlapping; empty when there are fewer.";
                }
                = code.block(windows_sample());
                h3 {
                    id = "it-min_by";
                    code {
                        "min_by(T)";
                    }
                }
                p {
                    "The smallest value by a less-than comparator, or null when empty. The first of equals wins.";
                }
                = code.block(min_by_sample());
                h3 {
                    id = "it-max_by";
                    code {
                        "max_by(T)";
                    }
                }
                p {
                    "The largest value, with the same less-than comparator. The first of equals wins.";
                }
                = code.block(max_by_sample());
                h3 {
                    id = "it-first_where";
                    code {
                        "first_where(T)";
                    }
                }
                p {
                    "The first match, or null; stops there.";
                }
                = code.block(first_where_sample());
                h3 {
                    id = "it-reduce";
                    code {
                        "reduce(T)";
                    }
                }
                p {
                    "Like ";
                    code {
                        "fold";
                    }
                    " seeded with the first value; null when empty.";
                }
                = code.block(reduce_sample());
                h3 {
                    id = "it-bisect";
                    code {
                        "bisect";
                    }
                }
                p {
                    "Binary search of a sorted array (or range): the first position where a true-then-false predicate turns false.";
                }
                = code.block(bisect_sample());
            }
            section {
                h2 {
                    "for loops";
                }
                p {
                    "A ";
                    code {
                        "for";
                    }
                    " loop takes one capture per source. Range captures are ";
                    code {
                        "I32";
                    }
                    "; there is no implicit index on an array source, so zip one in.";
                }
                h3 {
                    id = "it-for_range";
                    "For ranges";
                }
                p {
                    "A counted loop. ";
                    code {
                        "..<";
                    }
                    " excludes the end, ";
                    code {
                        "...";
                    }
                    " includes it.";
                }
                = code.block(for_range_sample());
                h3 {
                    id = "it-for_array";
                    "For arrays";
                }
                p {
                    "Each element of an array, evaluated once.";
                }
                = code.block(for_array_sample());
                h3 {
                    id = "it-for_zip";
                    "For zipped sources";
                }
                p {
                    "Several sources step together and stop at the shortest. Pair an array with a range for its index.";
                }
                = code.block(for_zip_sample());
                h3 {
                    id = "it-for_break";
                    "Break and continue";
                }
                p {
                    code {
                        "continue";
                    }
                    " goes to the next value; ";
                    code {
                        "break";
                    }
                    " leaves the loop.";
                }
                = code.block(for_break_sample());
                h3 {
                    id = "it-generator";
                    "Generators";
                }
                p {
                    "A function that returns ";
                    code {
                        "yield T";
                    }
                    " is consumed by ";
                    code {
                        "for";
                    }
                    "; its body is expanded inline at the loop.";
                }
                = code.block(generator_sample());
                h3 {
                    id = "it-recursive";
                    "Recursive generators";
                }
                p {
                    "A generator may delegate to itself; it runs as one loop over an explicit stack. ";
                    code {
                        "prune;";
                    }
                    " skips the current value's children.";
                }
                = code.block(recursive_sample());
            }
            section {
                h2 {
                    "One loop, no intermediate arrays";
                }
                p {
                    "Stages are inlined, not called: no iterator objects, no closures, no intermediate arrays. The pipeline below is one Wasm loop over the range with three locals, and ";
                    code {
                        "take(5)";
                    }
                    " ends that loop after the fifth match. Only ";
                    code {
                        "flat_map";
                    }
                    " and ";
                    code {
                        "repeat";
                    }
                    " add an inner loop, and ";
                    code {
                        "chain";
                    }
                    " a second loop after the first; terminals that build arrays allocate their result once when every stage keeps or shrinks the length.";
                }
                h3 {
                    id = "it-fusion";
                    "One loop";
                }
                p {
                    "Every stage is inlined into one Wasm loop with scalar locals.";
                }
                = code.block(fusion_sample());
                h3 {
                    id = "it-fusion_collect";
                    "Fused collect";
                }
                p {
                    "A side-effect-free ";
                    code {
                        "(… collect(T))";
                    }
                    " used as a source is merged into the outer pipeline: the inner array is never built.";
                }
                = code.block(fusion_collect_sample());
            }
            section {
                h2 {
                    "Streams and await for";
                }
                p {
                    "Pipelines are synchronous. Asynchronous sequences are ";
                    code {
                        "Stream[T]";
                    }
                    " values, read with ";
                    code {
                        "await for";
                    }
                    "; their ";
                    code {
                        "filter";
                    }
                    ", ";
                    code {
                        "map";
                    }
                    ", ";
                    code {
                        "take";
                    }
                    ", ";
                    code {
                        "skip";
                    }
                    " and ";
                    code {
                        "chain";
                    }
                    " are methods taking closures, not pipeline stages.";
                }
                h3 {
                    id = "it-stream";
                    "Await for";
                }
                p {
                    code {
                        "Stream[T]";
                    }
                    " is a JavaScript async iterable. ";
                    code {
                        "await for";
                    }
                    " reads it, suspending at each value (JSPI).";
                }
                = code.block(stream_sample());
                h3 {
                    id = "it-stream_more";
                    "Stream methods";
                }
                p {
                    code {
                        "generate";
                    }
                    ", ";
                    code {
                        "take";
                    }
                    ", ";
                    code {
                        "skip";
                    }
                    " and ";
                    code {
                        "chain";
                    }
                    " make new streams that read the old one lazily. ";
                    code {
                        "break";
                    }
                    " closes the stream.";
                }
                = code.block(stream_more_sample());
            }
            section {
                h2 {
                    "Recipes";
                }
                p {
                    "Multi-step pipelines.";
                }
                h3 {
                    id = "it-recipe_words";
                    "Word frequencies";
                }
                p {
                    "Split, normalize, group, and rank.";
                }
                = code.block(recipe_words_sample());
                h3 {
                    id = "it-recipe_stats";
                    "Mean and maximum";
                }
                p {
                    "Several terminals over the same array, with a nullable result for the empty case.";
                }
                = code.block(recipe_stats_sample());
                h3 {
                    id = "it-recipe_diffs";
                    "Differences and runs";
                }
                p {
                    code {
                        "windows";
                    }
                    " for pairwise differences; ";
                    code {
                        "zip";
                    }
                    " against a shifted copy does the same without allocating windows.";
                }
                = code.block(recipe_diffs_sample());
                h3 {
                    id = "it-recipe_primes";
                    "Primes below 50";
                }
                p {
                    "A range, a nested pipeline in the predicate, and a collect.";
                }
                = code.block(recipe_primes_sample());
                h3 {
                    id = "it-recipe_top";
                    "Top scorers";
                }
                p {
                    "Filter, sort, take, and project.";
                }
                = code.block(recipe_top_sample());
                h3 {
                    id = "it-recipe_matrix";
                    "Rows and columns";
                }
                p {
                    "Build a grid with ";
                    code {
                        "flat_map";
                    }
                    ", then cut it back into rows with ";
                    code {
                        "batched";
                    }
                    ".";
                }
                = code.block(recipe_matrix_sample());
            }
            = ui.further("docs/iterators.md", "Syntax-level iterators");
        }
        \/;
    }
}
