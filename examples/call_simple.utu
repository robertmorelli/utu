fn qux() I64 {
    return 0
}

fn quux(a: I64) I64 {
    let sink: I64 = 0
    sink = sink + qux()
    sink = sink + qux()
    sink = sink + qux()
    sink = sink + qux()
    sink = sink + qux()
    sink = sink + qux()
    sink = sink + qux()
    sink = sink + qux()
    sink = sink + qux()
    sink = sink + qux()
    sink = sink + qux()
    sink = sink + qux()
    sink = sink + qux()
    sink = sink + qux()
    sink = sink + qux()
    sink = sink + qux()
    sink = sink + qux()
    sink = sink + qux()
    sink = sink + qux()
    sink = sink + qux()
    return sink + a
}

fn baz(a: I64, b: I64) I64 {
    let sink: I64 = 0
    sink = sink + quux(a)
    sink = sink + quux(a)
    sink = sink + quux(a)
    sink = sink + quux(a)
    sink = sink + quux(a)
    sink = sink + quux(a)
    sink = sink + quux(a)
    sink = sink + quux(a)
    sink = sink + quux(a)
    sink = sink + quux(a)
    sink = sink + quux(a)
    sink = sink + quux(a)
    sink = sink + quux(a)
    sink = sink + quux(a)
    sink = sink + quux(a)
    sink = sink + quux(a)
    sink = sink + quux(a)
    sink = sink + quux(a)
    sink = sink + quux(a)
    sink = sink + quux(a)
    return sink + b
}

fn bar(a: I64, b: I64, c: I64) I64 {
    let sink: I64 = 0
    sink = sink + baz(a, b)
    sink = sink + baz(a, b)
    sink = sink + baz(a, b)
    sink = sink + baz(a, b)
    sink = sink + baz(a, b)
    sink = sink + baz(a, b)
    sink = sink + baz(a, b)
    sink = sink + baz(a, b)
    sink = sink + baz(a, b)
    sink = sink + baz(a, b)
    sink = sink + baz(a, b)
    sink = sink + baz(a, b)
    sink = sink + baz(a, b)
    sink = sink + baz(a, b)
    sink = sink + baz(a, b)
    sink = sink + baz(a, b)
    sink = sink + baz(a, b)
    sink = sink + baz(a, b)
    sink = sink + baz(a, b)
    sink = sink + baz(a, b)
    return sink + c
}

fn foo(a: I64, b: I64, c: I64, d: I64) I64 {
    let sink: I64 = 0
    sink = sink + bar(a, b, c)
    sink = sink + bar(a, b, c)
    sink = sink + bar(a, b, c)
    sink = sink + bar(a, b, c)
    sink = sink + bar(a, b, c)
    sink = sink + bar(a, b, c)
    sink = sink + bar(a, b, c)
    sink = sink + bar(a, b, c)
    sink = sink + bar(a, b, c)
    sink = sink + bar(a, b, c)
    sink = sink + bar(a, b, c)
    sink = sink + bar(a, b, c)
    sink = sink + bar(a, b, c)
    sink = sink + bar(a, b, c)
    sink = sink + bar(a, b, c)
    sink = sink + bar(a, b, c)
    sink = sink + bar(a, b, c)
    sink = sink + bar(a, b, c)
    sink = sink + bar(a, b, c)
    sink = sink + bar(a, b, c)
    return sink + d
}

fn test_calls() I64 {
    let sink: I64 = 0
    let one: I64 = 1
    let two: I64 = 2
    let three: I64 = 3
    let four: I64 = 4
    sink = sink + foo(one, two, three, four)
    sink = sink + foo(one, two, three, four)
    sink = sink + foo(one, two, three, four)
    sink = sink + foo(one, two, three, four)
    sink = sink + foo(one, two, three, four)
    sink = sink + foo(one, two, three, four)
    sink = sink + foo(one, two, three, four)
    sink = sink + foo(one, two, three, four)
    sink = sink + foo(one, two, three, four)
    sink = sink + foo(one, two, three, four)
    sink = sink + foo(one, two, three, four)
    sink = sink + foo(one, two, three, four)
    sink = sink + foo(one, two, three, four)
    sink = sink + foo(one, two, three, four)
    sink = sink + foo(one, two, three, four)
    sink = sink + foo(one, two, three, four)
    sink = sink + foo(one, two, three, four)
    sink = sink + foo(one, two, three, four)
    sink = sink + foo(one, two, three, four)
    sink = sink + foo(one, two, three, four)
    return sink
}

bench "call-simple chain" {
    let one: I64 = 1
    let two: I64 = 2
    let three: I64 = 3
    let four: I64 = 4
    measure {
        foo(one, two, three, four)
    }
}

fn main() I64 {
    return test_calls()
}
