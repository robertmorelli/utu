fn qux() I64 {
    0;
}

fn quux(a: I64) I64 {
    let sink: I64 = 0;
    sink = sink + qux();
    sink = sink + qux();
    sink = sink + qux();
    sink = sink + qux();
    sink = sink + qux();
    sink = sink + qux();
    sink = sink + qux();
    sink = sink + qux();
    sink = sink + qux();
    sink = sink + qux();
    sink = sink + qux();
    sink = sink + qux();
    sink = sink + qux();
    sink = sink + qux();
    sink = sink + qux();
    sink = sink + qux();
    sink = sink + qux();
    sink = sink + qux();
    sink = sink + qux();
    sink = sink + qux();
    sink + a;
}

fn baz(a: I64, b: I64) I64 {
    let sink: I64 = 0;
    sink = sink + quux(a);
    sink = sink + quux(a);
    sink = sink + quux(a);
    sink = sink + quux(a);
    sink = sink + quux(a);
    sink = sink + quux(a);
    sink = sink + quux(a);
    sink = sink + quux(a);
    sink = sink + quux(a);
    sink = sink + quux(a);
    sink = sink + quux(a);
    sink = sink + quux(a);
    sink = sink + quux(a);
    sink = sink + quux(a);
    sink = sink + quux(a);
    sink = sink + quux(a);
    sink = sink + quux(a);
    sink = sink + quux(a);
    sink = sink + quux(a);
    sink = sink + quux(a);
    sink + b;
}

fn bar(a: I64, b: I64, c: I64) I64 {
    let sink: I64 = 0;
    sink = sink + baz(a, b);
    sink = sink + baz(a, b);
    sink = sink + baz(a, b);
    sink = sink + baz(a, b);
    sink = sink + baz(a, b);
    sink = sink + baz(a, b);
    sink = sink + baz(a, b);
    sink = sink + baz(a, b);
    sink = sink + baz(a, b);
    sink = sink + baz(a, b);
    sink = sink + baz(a, b);
    sink = sink + baz(a, b);
    sink = sink + baz(a, b);
    sink = sink + baz(a, b);
    sink = sink + baz(a, b);
    sink = sink + baz(a, b);
    sink = sink + baz(a, b);
    sink = sink + baz(a, b);
    sink = sink + baz(a, b);
    sink = sink + baz(a, b);
    sink + c;
}

fn foo(a: I64, b: I64, c: I64, d: I64) I64 {
    let sink: I64 = 0;
    sink = sink + bar(a, b, c);
    sink = sink + bar(a, b, c);
    sink = sink + bar(a, b, c);
    sink = sink + bar(a, b, c);
    sink = sink + bar(a, b, c);
    sink = sink + bar(a, b, c);
    sink = sink + bar(a, b, c);
    sink = sink + bar(a, b, c);
    sink = sink + bar(a, b, c);
    sink = sink + bar(a, b, c);
    sink = sink + bar(a, b, c);
    sink = sink + bar(a, b, c);
    sink = sink + bar(a, b, c);
    sink = sink + bar(a, b, c);
    sink = sink + bar(a, b, c);
    sink = sink + bar(a, b, c);
    sink = sink + bar(a, b, c);
    sink = sink + bar(a, b, c);
    sink = sink + bar(a, b, c);
    sink = sink + bar(a, b, c);
    sink + d;
}

fn test_calls() I64 {
    let sink: I64 = 0;
    let one: I64 = 1;
    let two: I64 = 2;
    let three: I64 = 3;
    let four: I64 = 4;
    sink = sink + foo(one, two, three, four);
    sink = sink + foo(one, two, three, four);
    sink = sink + foo(one, two, three, four);
    sink = sink + foo(one, two, three, four);
    sink = sink + foo(one, two, three, four);
    sink = sink + foo(one, two, three, four);
    sink = sink + foo(one, two, three, four);
    sink = sink + foo(one, two, three, four);
    sink = sink + foo(one, two, three, four);
    sink = sink + foo(one, two, three, four);
    sink = sink + foo(one, two, three, four);
    sink = sink + foo(one, two, three, four);
    sink = sink + foo(one, two, three, four);
    sink = sink + foo(one, two, three, four);
    sink = sink + foo(one, two, three, four);
    sink = sink + foo(one, two, three, four);
    sink = sink + foo(one, two, three, four);
    sink = sink + foo(one, two, three, four);
    sink = sink + foo(one, two, three, four);
    sink = sink + foo(one, two, three, four);
    sink;
}

bench "call-simple chain" {
    let one: I64 = 1;
    let two: I64 = 2;
    let three: I64 = 3;
    let four: I64 = 4;
    measure {
        foo(one, two, three, four);
    }
}

fn main() I64 {
    test_calls();
}
