using Browser from std:Browser;

fn number(value: I32) Str {
    value.to_f64().toString();
}

fn money(cents: I32) Str {
    "$" + (cents.to_f64() / 100.0).toFixed(2);
}

fn node(id: Str) Browser.HTMLElement {
    Browser.document.getElementById(id) orelse fatal;
}

fn restore_focus(id: Str) void {
    promote Browser.document.getElementById(id) {
        |element| => element.focus(), ~> {
        },
    };
}

struct Book:
    | id: Str
    | title: Str
    | author: Str
    | finished: Bool

struct Library:
    | books: Array[Book]
    | query: Str
    | filter: Str

fn matches(book: Book,
state: Library) Bool {
    (book.title + " " + book.author).toLowerCase().includes(state.query.toLowerCase())
    and (state.filter == "all" or (state.filter == "finished" and book.finished) or (state.filter == "reading" and not book.finished));
}

fn book_card(book: Book,
state: Library) Browser.HTMLElement {
    @wutu/\
    article.book {
        display:grid;
        grid-template-columns:5rem 1fr;
        gap:1.25rem;
        padding-block:1.5rem;
        border-block-end:1px solid var(--line);
        div {
            <aria-hidden = "true";
            aspect-ratio:0.68;
            background:linear-gradient(135deg, var(--accent), var(--ink));
            border-radius:0.15rem 0.45rem 0.45rem 0.15rem;
            border-inline-start:0.35rem solid var(--ink);
            display:grid;
            place-items:center;
            color:var(--bg);
            font:italic 1.5rem Georgia, serif;
            "F.";
        }
        div {
            display:grid;
            gap:0.7rem;
            align-content:start;
            p.eyebrow {
                color:var(--accent);
                = if book.finished {
                    "FINISHED";
                }
                else {
                    "ON YOUR SHELF";
                };
            }
            h3 {
                font:500 1.5rem Georgia, serif;
                = book.title;
            }
            p.muted {
                = book.author;
            }
            div {
                display:flex;
                gap:0.5rem;
                flex-wrap:wrap;
                button {
                    <id = $["book-" + book.id];
                    <aria-pressed = $[if book.finished { "true"; } else { "false"; }];
                    = if book.finished {
                        "Read again";
                    }
                    else {
                        "Mark finished";
                    };
                    on click {
                        book.finished = not book.finished;
                    };
                }
                button {
                    <aria-label = $["Remove " + book.title];
                    "Remove";
                    on click {
                        state.books = state.books filter |b| {
                            b.id != book.id;
                        }
                        collect(Book);
                        restore_focus("search");
                    };
                }
            }
        }
    }
    \/;
}

fn results(state: Library) Browser.HTMLElement {
    let count = state.books count_where |book| {
        matches(book, state);
    };
    let finished = state.books count_where |book| {
        book.finished;
    };
    @wutu/\
    section {
        <id = "results";
        display:grid;
        gap:1rem;
        header {
            display:flex;
            justify-content:space-between;
            gap:1rem;
            flex-wrap:wrap;
            h2 {
                font:500 2rem Georgia, serif;
                "The bookshelf";
            }
            p.muted {
                <role = "status";
                = number(count);
                " shown · ";
                = number(finished);
                " finished";
            }
        }
        for $[state.books filter |book| { matches(book, state); }] |book| key $[book.id] {
            = book_card(book, state);
        }
        if $[count == 0] {
            p.empty {
                "No books here yet. Add a title or try another search.";
            }
        }
    }
    \/;
}

export main() void {
    let state = @stored/\
        Library "folio-v2" Library {
        books: [Book {
            id: "one",
            title: "The Creative Act",
            author: "Rick Rubin",
            finished: false
        },
        Book {
            id: "two",
            title: "A Field Guide to Getting Lost",
            author: "Rebecca Solnit",
            finished: false
        },
        Book {
            id: "three",
            title: "Braiding Sweetgrass",
            author: "Robin Wall Kimmerer",
            finished: true
        }
        ],
        query: "",
        filter: "all"
    }
    \/;
    let app = @wutu/\
    @reactive;
    @document {
        :root {
            --bg: oklch(96% 0.018 80);
            --ink: oklch(27% 0.025 55);
            --accent: oklch(51% 0.16 35);
            --panel: oklch(99% 0.005 80);
            --muted: oklch(49% 0.02 55);
            --line: oklch(85% 0.025 80);
            --on-accent: oklch(96% 0.018 80);
            font-family: system-ui, sans-serif;
            background: var(--bg);
            color: var(--ink);
        }
        * {
            box-sizing: border-box;
        }
        body {
            margin: 0;
        }
        button, input, select, textarea {
            font: inherit;
        }
        button, a, input, select, textarea {
            touch-action: manipulation;
        }
        button {
            cursor: pointer;
        }
        a {
            color: inherit;
            text-underline-offset: 0.25em;
        }
        h1, h2, h3, p {
            margin: 0;
            overflow-wrap: anywhere;
        }
        button, input, select, textarea {
            border: 1px solid var(--line);
            border-radius: 0.6rem;
            padding: 0.75rem 1rem;
            background: var(--panel);
            color: var(--ink);
            min-inline-size: 0;
        }
        button:hover {
            border-color: var(--accent);
        }
        :focus-visible {
            outline: 3px solid var(--accent);
            outline-offset: 3px;
        }
        button:disabled {
            opacity: 0.45;
            cursor: default;
        }
        label {
            display: grid;
            gap: 0.5rem;
            font-size: 0.85rem;
            font-weight: 650;
        }
        .primary {
            background: var(--accent);
            color: var(--on-accent);
            border-color: var(--accent);
            font-weight: 700;
        }
        .muted {
            color: var(--muted);
        }
        .eyebrow {
            font: 700 0.75rem system-ui, sans-serif;
            letter-spacing: 0.15em;
            text-transform: uppercase;
        }
        .toolbar {
            display: flex;
            gap: 0.75rem;
            flex-wrap: wrap;
            align-items: end;
        }
        .toolbar label {
            flex: 1 1 10rem;
        }
        .empty {
            padding: 2rem;
            border: 1px dashed var(--line);
            color: var(--muted);
        }
        .site-nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
            padding-block: 1.25rem;
            border-block-end: 1px solid var(--line);
            font: 650 0.8rem system-ui, sans-serif;
        }
        .site-nav nav {
            display: flex;
            gap: 1.25rem;
        }
        .site-footer {
            border-block-start: 1px solid var(--line);
            padding-block: 1.5rem;
            color: var(--muted);
            font: 0.8rem system-ui, sans-serif;
            display: flex;
            gap: 1rem;
            justify-content: space-between;
            flex-wrap: wrap;
        }
        @media print {
            .site-nav, .site-footer, form, .toolbar, button {
                display: none;
            }
            body {
                background: white;
                color: black;
            }
        }
    }
    main {
        max-inline-size:76rem;
        margin-inline:auto;
        padding-inline:clamp(1.2rem, 5vw, 4rem);
        display:grid;
        gap:3rem;
        header.site-nav {
            a {
                <href = "./";
                "FOLIO / A READING LIFE";
            }
            nav {
                a {
                    <href = "../";
                    "All five sites";
                }
                a {
                    <href = "source.html";
                    "View Utu source ↗";
                }
            }
        }
        section {
            display:grid;
            gap:1.25rem;
            padding-block:1rem;
            p.eyebrow {
                color:var(--accent);
                "LESS SCROLLING. MORE PAGES.";
            }
            h1 {
                font:500 clamp(3.2rem, 7vw, 6.5rem) / 1.02 Georgia, serif;
                letter-spacing:-0.055em;
                "A place for";
                br {
                }
                em {
                    "your next chapter.";
                }
            }
            p.muted {
                max-inline-size:34rem;
                line-height:1.7;
                "Keep the books that move you close. Build your shelf, find your next read, and celebrate the ones you finish.";
            }
        }
        div {
            display:grid;
            grid-template-columns:minmax(0, 1.7fr) minmax(15rem, 1fr);
            gap:4rem;
            align-items:start;
            @media (width < 48rem) {
                grid-template-columns: 1fr;
                gap: 2rem;
            }
            section {
                display:grid;
                gap:2rem;
                div.toolbar {
                    label {
                        "Search the shelf";
                        input as search {
                            <id = "search";
                            <type = "search";
                            <placeholder = "Title or author";
                            bind:value = state.query;
                        }
                    }
                    label {
                        "Show";
                        select as filter {
                            <aria-label = "Show";
                            bind:value = state.filter;
                            option {
                                <value = "all";
                                "All books";
                            }
                            option {
                                <value = "reading";
                                "To read";
                            }
                            option {
                                <value = "finished";
                                "Finished";
                            }
                        }
                    }
                }
                = results(state);
            }
            aside {
                display:grid;
                gap:1.5rem;
                padding:2rem;
                border:1px solid var(--line);
                border-radius:1rem;
                background:var(--panel);
                p.eyebrow {
                    "MAKE ROOM FOR A GOOD BOOK";
                }
                h2 {
                    font:500 2rem Georgia, serif;
                    "Add to your shelf";
                }
                form as form {
                    display:grid;
                    gap:1rem;
                    label {
                        "Book title";
                        input as title {
                            <id = "title";
                            <required = "";
                            <maxlength = "160";
                            <placeholder = "What are you reading?";
                        }
                    }
                    label {
                        "Author";
                        input as author {
                            <required = "";
                            <maxlength = "100";
                            <placeholder = "Who wrote it?";
                        }
                    }
                    button.primary {
                        <type = "submit";
                        "Add book ↗";
                    }
                    on submit {
                        event.preventDefault();
                        if title.value.trim().len()>0 and author.value.trim().len()>0 {
                            let book = Book {
                                id: Browser.crypto.randomUUID(),
                                title: title.value.trim(),
                                author: author.value.trim(),
                                finished: false
                            };
                            state.books = state.books chain([book]) collect(Book);
                            form.reset();
                            title.focus();
                        };
                    };
                }
                p.muted {
                    line-height:1.6;
                    font-size:0.85rem;
                    "Your own quiet corner of the internet. Your shelf stays in this browser.";
                }
            }
        }
        footer.site-footer {
            p {
                "A reading life, one book at a time.";
            }
            p {
                <id = "notice";
                <role = "status";
                "Saved on this device. No account needed.";
            }
        }
    }
    \/;
    Browser.document.body.append(app);
}
