using SegmentTree from std:SegmentTree;
using Spatial from std:Spatial;
using PersistentSegmentTree from std:PersistentSegmentTree;

fn add(a: I32, b: I32) I32 { a + b; }
fn reaches_ten(value: I32) Bool { value >= 10; }

export main() I32 {
    let sums = SegmentTree[I32].new([2, 3, 5, 7], 0, add);
    assert sums.query(1, 3, add) == 8;
    assert sums.first_prefix(reaches_ten, add) == 2;
    sums.set(1, 10, add);
    assert sums.query(0, 4, add) == 24;
    assert sums.query(2, 2, add) == 0;
    assert sums.first_prefix(reaches_ten, add) == 1;

    let original = PersistentSegmentTree[I32].new([2, 3, 5], 0, add);
    let updated = original.set(1, 10, add);
    assert original.query(0, 3, add) == 10;
    assert updated.query(0, 3, add) == 17;

    let points = [
        Spatial.point(0.0, 0.0, 10),
        Spatial.point(1.0, 2.0, 20),
        Spatial.point(3.0, 1.0, 30),
        Spatial.point(1.0, 5.0, 40)
    ];
    let tree = Spatial.new(points);
    let box = tree.within(0.0, 1.0, 0.0, 2.0);
    assert box.len() == 2;
    assert (box sum) == 30;
    assert (tree.below(0.0, 3.0, 2.0) sum) == 60;
    assert (tree.radius(0.0, 0.0, 1.0) sum) == 10;
    assert (tree.nearest(3.1, 1.1) orelse fatal).value == 30;
    points[2].x = 99.0;
    assert (tree.nearest(3.1, 1.1) orelse fatal).value == 30;
    1;
}
