struct Vec:
    | left : I32
    | right : I32

fn Vec.new(left: I32, right: I32) Vec {
    return Vec { left: left, right: right }
}

fn Vec.total |self| () I32 {
    return self.left + self.right
}

mod boxy[T] {
    struct Box:
        | value : T

    fn Box.new(value: T) Box {
        return Box { value: value }
    }

    fn Box.get |self| () T {
        return self.value
    }
}

mod Pair[L, R] {
    struct &:
        | left : L
        | right : R

    fn &.new(left: L, right: R) & {
        return &{ left: left, right: right }
    }

    fn &.left |self| () L {
        return self.left
    }

    fn &.right |self| () R {
        return self.right
    }
}

using boxy[I32] |ints|

fn make_box(value: I32) ints.Box {
    return ints.Box.new(value)
}

fn make_pair() Pair[I32, I32] {
    return Pair[I32, I32].new(5, 6)
}

fn maybe_pair(flag: Bool) ?Pair[I32, I32] {
    return if flag { Pair[I32, I32].new(2, 9) } else { null }
}

test "top level method sugar works on locals and direct call results" {
    let vec: Vec = Vec.new(3, 4)
    assert vec.total() == 7
    assert Vec.new(1, 2).total() == 3
}

test "using aliases expose method sugar" {
    let box: ints.Box = ints.Box.new(7)
    assert box.get() == 7
}

test "free function return values can use methods" {
    assert make_box(8).get() == 8
    assert make_pair().left() == 5
}

test "promoted module types support method sugar" {
    let pair: Pair[I32, I32] = Pair[I32, I32].new(3, 4)
    assert pair.left() + pair.right() == 7
}

test "promoted module call results can chain methods" {
    assert Pair[I32, I32].new(5, 6).right() == 6
}

test "else results can flow into methods" {
    assert (maybe_pair(true) orelse Pair[I32, I32].new(0, 0)).right() == 9
}
