// Template strings: `text ${expr} text`. Each `${expr}` is `expr.str()`,
// and the pieces are joined with `+`.

struct Point:
    | x : I32
    | y : I32

// A type takes part in templates by having a str.
fn Point.str |self| () Str {
    return `(${self.x}, ${self.y})`
}

fn describe(name: Str, age: I32, height: F64) Str {
    return `${name} is ${age} years old and ${height} m tall`
}

lib {
    fn greeting() Str { return describe("Ada", 36, 1.65) }
    fn point() Str { return `p = ${Point { x: 3, y: -4 }}` }
    fn nested() Str { return `[${`inner ${1 + 2}`}]` }
    fn blocks() Str { return `${if 2 > 1 { "yes" } else { "no" }} and ${{ let n = 6; n * 7 }}` }
    fn escapes() Str { return `a \` backtick, a \${ that is text, $5, $${"x"}, tab\tend` }
    fn multiline() Str {
        return `first line
second line ${true}`
    }
    fn plain() Str { return `no substitutions` }
    fn empty() Str { return `` }
}

test "a template is its pieces joined" {
    assert `${1}${2}` == "12"
    assert `x${""}y` == "xy"
}
