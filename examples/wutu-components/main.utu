using Browser from std:Browser

struct State:
    | count: I32

let state: State = State { count: 0 }
let counters: Array[Component] = [Counter { label: "Also: " }]

struct Counter[Component]:
    | label: Str

mod ui {
    wn badge(text: Str) {
        strong { = text }
    }
}

wn Counter.caption |c| () {
    span { = c.label }
}

wn Component[Counter].render |c| () {
    button {
        // A brace in a comment does not end this wn: }
        = c.caption()
        = state.count
        on click {
            let step: fun() I32 = @es/\ () => { return 1 } \/
            state.count += step()
        }
    }
}

wn heading(text: Str) {
    h1 { = text; "}" }
}

fn heading_value(text: Str) Browser.HTMLElement {
    let render = heading
    return render(text)
}

html {
    head {
        title { "Wutu components" }
        meta { name = "description"; content = "A reactive counter" }
    }
    body {
        font-family: system-ui
        = heading_value("Components")
        = ui.badge("ready")
        = Counter { label: "Clicks: " }
        for counters |item| {
            = item
        }
    }
}
