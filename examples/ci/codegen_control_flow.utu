fn max(a: I32, b: I32) I32 {
    if a > b { a; } else { b; };
}

fn sum_to(n: I32) I32 {
    let sum: I32 = 0;
    for (0..<n) |i| {
        sum += i;
    };
    sum;
}

fn sum_to_inclusive(n: I32) I32 {
    let sum: I32 = 0;
    for (0...n) |i| {
        sum += i;
    };
    sum;
}

fn countdown_total(n: I32) I32 {
    let cur: I32 = n;
    let total: I32 = 0;
    while (cur > 0) {
        total += cur;
        cur -= 1;
    };
    total;
}

fn first_over(limit: I32, threshold: I32) I32 {
    let found: I32 = 0 - 1;
    let done: Bool = false;
    for (0..<limit) |i| {
        if done {
            break;
        };
        if i > threshold {
            found = i;
            done = true;
        };
    };
    found;
}

fn spin_until(limit: I32) I32 {
    let i: I32 = 0;
    while () {
        i += 1;
        if i == limit {
            return i;
        };
    };
    0;
}

test "if expressions return values" {
    assert max(9, 4) == 9;
}

test "counted loops sum ranges" {
    assert sum_to(5) == 10;
}

test "inclusive counted loops include the upper bound" {
    assert sum_to_inclusive(5) == 15;
}

test "while loops re-check mutable locals" {
    assert countdown_total(4) == 10;
}

test "labeled blocks can return early from nested loops" {
    assert first_over(8, 4) == 5;
}

test "infinite while loops can emit a value" {
    assert spin_until(6) == 6;
}
