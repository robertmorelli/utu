fn inc(x: I32) I32 {
    return x + 1
}

fn double(x: I32) I32 {
    return x * 2
}

fn clamp(val: I32, lo: I32, hi: I32) I32 {
    return if val < lo { lo } else if val > hi { hi } else { val }
}

fn affine(scale: I32, value: I32, offset: I32) I32 {
    return value * scale + offset
}

fn inc_then_double(x: I32) I32 {
    return double(inc(x))
}

fn clamp_unit(x: I32) I32 {
    return clamp(x, 0, 10)
}

fn scale_then_offset(x: I32) I32 {
    return affine(3, x, 1)
}

test "calls nest" {
    assert inc_then_double(3) == 8
}

test "clamp low values" {
    assert clamp_unit(-2) == 0
}

test "clamp high values" {
    assert clamp_unit(18) == 10
}

test "an argument among others" {
    assert scale_then_offset(4) == 13
}
