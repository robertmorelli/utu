// The JPL lexer from CS4470's Zig compiler, in utu.
//
// The DFA is built during compilation by `build`, a line-for-line port of the
// Zig version's comptime StateMachine, and lives in a const mem. Lexing is one
// table load per byte in a `loop match`, like Zig's labeled switch. Tokens go
// into three mems; `-l` formats them into a fourth that the host writes out.
using JS from std:JS;
using Fs from "node:fs";
using Process from "node:process";
using Web from std:Web;

// Token kinds, in the Zig compiler's order. The first four are DFA states.
enum(U8) Kind:
    | Start
    | Accept
    | Invalid
    | Ignore
    | ASSERT
    | ARRAY
    | BOOL
    | ELSE
    | FALSE
    | FN
    | FLOAT
    | INT
    | IMAGE
    | IF
    | LET
    | PRINT
    | RETURN
    | READ
    | STRUCT
    | SHOW
    | SUM
    | TO
    | TIME
    | TRUE
    | THEN
    | VOID
    | WRITE
    | VARIABLE
    | COLON
    | RPAREN
    | LPAREN
    | RCURLY
    | RSQUARE
    | LSQUARE
    | LCURLY
    | NEWLINE
    | INTVAL
    | FLOATVAL
    | OP
    | COMMA
    | EQUALS
    | STRING
    | DOT
    | END_OF_FILE

// States with fixed meanings.
let error_state: I32 = 0;
let start_state: I32 = 1;
let accept_state: I32 = 2;
let ignore_state: I32 = 3;

// next state = dfa[state * 256 + byte]; kind_of[state] is the token it ends.
const mem dfa: U8 = @comptime/\ build().tabs \/;
const mem kind_of: U8 = @comptime/\ build().kinds \/;
// Token names for -l, and where each starts in `names`.
const mem names: U8 = @comptime/\ name_bytes() \/;
const mem name_at: I32 = @comptime/\ name_offsets() \/;

mem src: U8;
mem starts: I32;
mem ends: I32;
mem kinds: Kind;
mem out: U8;

// ── The state machine, built at compile time ─────────────────────────────────

struct Machine:
    | tabs: Array[I32]
    | kinds: Array[I32]
    | next: I32

// Printable ASCII and newline may appear in source; anything else is an error.
fn illegal(c: I32) Bool {
    c != 10 and (c < 32 or c > 126);
}

fn illegal_in_string(c: I32) Bool {
    c < 32 or c > 126;
}

fn set(m: Machine, from: I32, c: I32, to: I32) void {
    m.tabs[from * 256 + c] = to;
}

fn get(m: Machine, from: I32, c: I32) I32 {
    m.tabs[from * 256 + c];
}

fn set_range(m: Machine, from: I32, lo: I32, hi: I32, to: I32) void {
    for (lo ... hi) |c| { set(m, from, c, to); };
}

fn restricted(m: Machine, kind: Kind) I32 {
    let state = m.next;
    m.next += 1;
    m.kinds[state] = kind.to_i32();
    state;
}

// Ends its token before any legal byte it has no edge for.
fn permissive(m: Machine, kind: Kind) I32 {
    let state = restricted(m, kind);
    for (0 ..< 256) |c| {
        set(m, state, c, if illegal(c) { error_state; } else { accept_state; });
    };
    state;
}

fn variable_state(m: Machine, var_state: I32) I32 {
    let state = permissive(m, Kind.VARIABLE);
    set(m, state, 95, var_state);
    set_range(m, state, 97, 122, var_state);
    set_range(m, state, 65, 90, var_state);
    set_range(m, state, 48, 57, var_state);
    state;
}

fn self_legal(m: Machine, state: I32) void {
    for (0 ..< 256) |c| {
        if not illegal(c) { set(m, state, c, state); };
    };
}

fn invisible(m: Machine) void {
    let newline = permissive(m, Kind.NEWLINE);
    let slash = permissive(m, Kind.OP);
    let block = restricted(m, Kind.Invalid);
    let line = restricted(m, Kind.Invalid);
    let leaving = restricted(m, Kind.Invalid);
    set(m, start_state, 32, ignore_state);
    set(m, start_state, 10, newline);
    set(m, newline, 10, newline);
    set(m, newline, 32, newline);
    set(m, newline, 47, slash);
    set(m, start_state, 47, slash);
    set(m, slash, 47, line);
    self_legal(m, line);
    set(m, line, 10, newline);
    set(m, slash, 42, block);
    self_legal(m, block);
    set(m, block, 42, leaving);
    for (0 ..< 256) |c| {
        if not illegal(c) { set(m, leaving, c, block); };
    };
    set(m, leaving, 47, ignore_state);
}

fn single(m: Machine, c: I32, kind: Kind) void {
    set(m, start_state, c, permissive(m, kind));
}

fn singles(m: Machine) void {
    single(m, 40, Kind.LPAREN);
    single(m, 41, Kind.RPAREN);
    single(m, 123, Kind.LCURLY);
    single(m, 125, Kind.RCURLY);
    single(m, 91, Kind.LSQUARE);
    single(m, 93, Kind.RSQUARE);
    single(m, 58, Kind.COLON);
    single(m, 44, Kind.COMMA);
    single(m, 43, Kind.OP);
    single(m, 45, Kind.OP);
    single(m, 42, Kind.OP);
    single(m, 37, Kind.OP);
    single(m, 33, Kind.OP);
    single(m, 60, Kind.OP);
    single(m, 62, Kind.OP);
    single(m, 61, Kind.EQUALS);
}

fn double(m: Machine, a: I32, b: I32) void {
    let first = get(m, start_state, a);
    if first == start_state or first == error_state or first == accept_state {
        first = restricted(m, Kind.Invalid);
        set(m, start_state, a, first);
    };
    let second = get(m, first, b);
    if second == first or second == error_state or second == accept_state {
        second = permissive(m, Kind.Invalid);
        set(m, first, b, second);
    };
    m.kinds[second] = Kind.OP.to_i32();
}

fn doubles(m: Machine) void {
    double(m, 124, 124);
    double(m, 38, 38);
    double(m, 61, 61);
    double(m, 33, 61);
    double(m, 62, 61);
    double(m, 60, 61);
}

fn variables(m: Machine) I32 {
    let state = permissive(m, Kind.VARIABLE);
    set_range(m, start_state, 97, 122, state);
    set_range(m, start_state, 65, 90, state);
    set(m, start_state, 95, state);
    set_range(m, state, 97, 122, state);
    set_range(m, state, 65, 90, state);
    set_range(m, state, 48, 57, state);
    set(m, state, 95, state);
    state;
}

// Keywords are paths through the identifier states; each ends in its kind.
fn keyword(m: Machine, word: Str, kind: Kind, var_state: I32) void {
    let current = start_state;
    for (0 ..< word.len()) |k| {
        let c = word.get(k);
        let next = get(m, current, c);
        if next == error_state or next == accept_state or next == current or next == var_state {
            set(m, current, c, variable_state(m, var_state));
        };
        current = get(m, current, c);
    };
    m.kinds[current] = kind.to_i32();
}

fn keywords(m: Machine, var_state: I32) void {
    let words = ["assert", "array", "bool", "else", "false", "fn", "float", "int", "image", "if", "let",
        "print", "return", "read", "struct", "show", "sum", "to", "time", "true", "then", "void", "write"];
    for (words, 0 ..< 23) |word, k| {
        keyword(m, word, Kind.from_i32(Kind.ASSERT.to_i32() + k), var_state);
    };
}

fn numbers(m: Machine) void {
    let int = permissive(m, Kind.INTVAL);
    let dot = permissive(m, Kind.DOT);
    let float = permissive(m, Kind.FLOATVAL);
    set_range(m, start_state, 48, 57, int);
    set_range(m, int, 48, 57, int);
    set(m, start_state, 46, dot);
    set(m, int, 46, float);
    set_range(m, dot, 48, 57, float);
    set_range(m, float, 48, 57, float);
}

fn strings(m: Machine) void {
    let open = restricted(m, Kind.Invalid);
    set(m, start_state, 34, open);
    let body = restricted(m, Kind.Invalid);
    for (0 ..< 256) |c| {
        if not illegal_in_string(c) and c != 34 {
            set(m, open, c, body);
            set(m, body, c, body);
        };
    };
    let close = permissive(m, Kind.STRING);
    set(m, open, 34, close);
    set(m, body, 34, close);
}

fn continuations(m: Machine) void {
    let backslash = restricted(m, Kind.Invalid);
    set(m, start_state, 92, backslash);
    set(m, backslash, 10, ignore_state);
}

fn build() Machine {
    let m = Machine { tabs: Array[I32].new(256 * 256, 0), kinds: Array[I32].new(256, Kind.Invalid.to_i32()), next: 4 };
    m.kinds[start_state] = Kind.Start.to_i32();
    m.kinds[accept_state] = Kind.Accept.to_i32();
    m.kinds[ignore_state] = Kind.Ignore.to_i32();
    // Accept and ignore restart the scan from the start state.
    for (0 ..< 256) |c| {
        set(m, accept_state, c, start_state);
        set(m, ignore_state, c, start_state);
    };
    invisible(m);
    singles(m);
    doubles(m);
    keywords(m, variables(m));
    numbers(m);
    strings(m);
    continuations(m);
    m.tabs = m.tabs.slice(0, m.next * 256);
    m.kinds = m.kinds.slice(0, m.next);
    m;
}

fn name_bytes() Array[I32] {
    let out = Array[I32].new(1024, 0);
    let n = 0;
    for (0 ..< Kind.count()) |k| {
        let name = Kind.name(Kind.from_i32(k));
        for (0 ..< name.len()) |c| {
            out[n] = name.get(c);
            n += 1;
        };
    };
    out.slice(0, n);
}

fn name_offsets() Array[I32] {
    let at = Array[I32].new(Kind.count() + 1, 0);
    for (0 ..< Kind.count()) |k| { at[k + 1] = at[k] + Kind.name(Kind.from_i32(k)).len(); };
    at;
}

// ── Lexing ───────────────────────────────────────────────────────────────────

// Lexes `src` (which ends with a 255 sentinel) into starts/ends/kinds.
// Returns the token count, or -1 at an invalid byte.
fn lex() I32 {
    let last = src.len() - 1;
    starts.resize(src.len() + 1);
    ends.resize(src.len() + 1);
    kinds.resize(src.len() + 1);
    let n = 0;
    let i = 0;
    let j = 0;
    let state = start_state;
    let failed = false;
    let next = dfa[start_state * 256 + src[0]];
    loop match next {
        0 => {
            if j != last { failed = true; };
            break;
        },
        2 => {
            starts[n] = i;
            ends[n] = j;
            kinds[n] = Kind.from_i32(kind_of[state]);
            n += 1;
            i = j;
            next = dfa[start_state * 256 + src[j]];
            continue next;
        },
        3 => {
            j += 1;
            i = j;
            next = dfa[start_state * 256 + src[j]];
            continue next;
        },
        ~> {
            state = next;
            j += 1;
            next = dfa[state * 256 + src[j]];
            continue next;
        },
    };
    if failed { return -1; };
    if i != j {
        if kind_of[state] == Kind.Invalid.to_i32() { return -1; };
        starts[n] = i;
        ends[n] = j;
        kinds[n] = Kind.from_i32(kind_of[state]);
        n += 1;
        i = j;
    };
    starts[n] = i;
    ends[n] = j;
    kinds[n] = Kind.END_OF_FILE;
    n + 1;
}

// ── Printing ─────────────────────────────────────────────────────────────────

fn emit_bytes(at: I32, text: Str) I32 {
    for (0 ..< text.len()) |k| { out[at + k] = text.get(k); };
    at + text.len();
}

// The token listing, in the Zig compiler's format, into `out`. Returns its length.
fn listing(n: I32) I32 {
    out.resize(src.len() * 16 + 64);
    let at = 0;
    for (0 ..< n) |t| {
        let kind = kinds[t];
        let k = kind.to_i32();
        for (name_at[k] ..< name_at[k + 1]) |c| {
            out[at] = names[c];
            at += 1;
        };
        if kind != Kind.NEWLINE and kind != Kind.END_OF_FILE {
            out[at] = 32;
            out[at + 1] = 39;
            at += 2;
            if kind == Kind.STRING {
                for (starts[t] ..< ends[t]) |c| {
                    let b = src[c];
                    if b == 10 {
                        out[at] = 92;
                        out[at + 1] = 110;
                        at += 2;
                    } else {
                        out[at] = b;
                        at += 1;
                    };
                };
            } else {
                for (starts[t] ..< ends[t]) |c| {
                    out[at] = src[c];
                    at += 1;
                };
            };
            out[at] = 39;
            at += 1;
        };
        out[at] = 10;
        at += 1;
    };
    at;
}

// A growable GC array, indexed like one.
mod Vec[T] {
    struct &:
        | items: Array[T]
        | len: I32

    fn &.new() & {
        &{ items: Array[T].new_default(16), len: 0 };
    }
    fn &.get_index |self| (i: I32) T {
        self.items[i];
    }
    fn &.set_index |self| (i: I32, v: T) void {
        self.items[i] = v;
    }
    fn &.push |self| (v: T) void {
        if self.len == self.items.len() {
            let grown = Array[T].new_default(self.len * 2);
            grown.copy_from(0, self.items, 0, self.len);
            self.items = grown;
        };
        self.items[self.len] = v;
        self.len += 1;
    }
    fn &.truncate |self| (n: I32) void {
        self.len = n;
    }
    fn &.clear |self| () void {
        self.len = 0;
    }
}

// ── Scanning ─────────────────────────────────────────────────────────────────
//
// The parsers read tokens one at a time from a Scanner, which runs the same
// DFA as `lex` but stops after each token and keeps its payload: operator
// code, number bits, or the span of a string or name.

struct Scanner:
    | cursor: I32
    | kind: Kind
    | op: I32
    | hi: I32
    | lo: I32
    | last_hi: I32
    | last_lo: I32
    | pos: I32
    | end: I32
    | env: Env

// `end` is where the 255 sentinel is.
fn new_scanner(end: I32, env: Env) Scanner {
    let s = Scanner { cursor: 0, kind: Kind.Start, op: 0, hi: 0, lo: 0, last_hi: 0, last_lo: 0, pos: 0, end: end, env: env };
    s.scan();
    s;
}

let syntax_error: fun() void = @es/\ () => { throw new SyntaxError('jpl'); } \/;

// A syntax or type error unwinds to `parse` or `check`.
fn fail() void {
    syntax_error();
}

// Scan the next token.
fn Scanner.scan |s| () void {
    let i = s.cursor;
    let j = i;
    let state = start_state;
    let next = dfa[start_state * 256 + src[j]];
    loop match next {
        0 => {
            if j != s.end { fail(); };
            if i != j {
                s.cursor = j;
                s.token(Kind.from_i32(kind_of[state]), i, j);
            } else {
                s.kind = Kind.END_OF_FILE;
            };
            break;
        },
        2 => {
            s.cursor = j;
            s.token(Kind.from_i32(kind_of[state]), i, j);
            break;
        },
        3 => {
            j += 1;
            i = j;
            s.cursor = i;
            state = start_state;
            next = dfa[start_state * 256 + src[j]];
            continue next;
        },
        ~> {
            state = next;
            j += 1;
            next = dfa[state * 256 + src[j]];
            continue next;
        },
    };
}

// The token's payload: `!=` is the operator `~`.
fn Scanner.token |s| (kind: Kind, i: I32, j: I32) void {
    s.kind = kind;
    if kind == Kind.Invalid { fail(); };
    if kind == Kind.OP {
        s.op = if src[i] == 33 and j - i == 2 { 126; } else { src[i]; };
    } else if kind == Kind.INTVAL {
        s.set_bits(parse_int(i, j));
    } else if kind == Kind.FLOATVAL {
        s.set_bits(parse_float(i, j).bits());
    } else if kind == Kind.STRING or kind == Kind.VARIABLE {
        s.hi = i;
        s.lo = j;
    };
}

fn Scanner.set_bits |s| (bits: I64) void {
    s.hi = (bits >> 32).to_i32();
    s.lo = bits.to_i32();
}

fn Scanner.take |s| () Kind {
    let kind = s.kind;
    s.last_hi = s.hi;
    s.last_lo = s.lo;
    s.scan();
    s.pos += 1;
    kind;
}

fn Scanner.expect |s| (kind: Kind) void {
    if s.kind != kind { fail(); };
    s.take();
}

// The current name, interned.
fn Scanner.name |s| () I32 {
    src.intern(s.hi, s.lo);
}

fn Scanner.expect_name |s| () I32 {
    if s.kind != Kind.VARIABLE { fail(); };
    let name = s.name();
    s.take();
    name;
}

// A decimal I64; a value past 2^63 - 1 is a syntax error, as in Zig.
fn parse_int(i: I32, j: I32) I64 {
    let value: I64 = 0;
    for (i ..< j) |k| {
        let digit = (src[k] - 48).to_i64();
        if value > (9223372036854775807 - digit) / 10 { fail(); };
        value = value * 10 + digit;
    };
    value;
}

// Digits [. digits]; a value too large for an F64 is a syntax error.
fn parse_float(i: I32, j: I32) F64 {
    let value = 0.0;
    let scale = 1.0;
    let fraction = false;
    for (i ..< j) |k| {
        let c = src[k];
        if c == 46 {
            fraction = true;
        } else if fraction {
            scale = scale / 10.0;
            value += (c - 48).to_f64() * scale;
        } else {
            value = value * 10.0 + (c - 48).to_f64();
        };
    };
    if value > 1.7976931348623157e308 { fail(); };
    value;
}

// ── Nodes ────────────────────────────────────────────────────────────────────
//
// A flat array of {tag, a, b, token} nodes, as in Zig. A list is a chain of
// nodes whose `a` is the previous link (0 ends it). The checker also records
// each node's type.

enum(U8) Tag:
    | Leaf
    | Unary
    | Binary
    | Call
    | Field
    | Index
    | ArrayExpr
    | Construct
    | Conditional
    | Loop
    | List
    | Binding
    | Lvalue
    | TypeNode
    | Stmt
    | Command

mem node_tag: Tag;
mem node_a: I32;
mem node_b: I32;
mem node_token: I32;
mem node_type: I32;

fn node(tag: Tag, a: I32, b: I32, at: I32) I32 {
    let id = node_tag.len();
    node_tag.push(tag);
    node_a.push(a);
    node_b.push(b);
    node_token.push(at);
    id;
}

fn typed_node(tag: Tag, a: I32, b: I32, at: I32, type_id: I32) I32 {
    node_type.push(type_id);
    node(tag, a, b, at);
}

fn reset_nodes() void {
    node_tag.clear();
    node_a.clear();
    node_b.clear();
    node_token.clear();
    node_type.clear();
    node_tag.reserve(src.len());
    node_a.reserve(src.len());
    node_b.reserve(src.len());
    node_token.reserve(src.len());
}

// Binding power of a binary operator by its code; 0 is not an operator.
const mem precedence: U8 = @comptime/\ precedence_table() \/;

fn precedence_table() Array[I32] {
    let table = Array[I32].new(256, 0);
    table[38] = 1;
    table[124] = 1;
    table[60] = 2;
    table[62] = 2;
    table[61] = 2;
    table[126] = 2;
    table[43] = 3;
    table[45] = 3;
    table[42] = 4;
    table[47] = 4;
    table[37] = 4;
    table;
}

// ── Parsing ──────────────────────────────────────────────────────────────────
//
// The Zig compiler's precedence-climbing parser (parser_bench_inline_forced).

fn string_leaf(s: Scanner) I32 {
    let at = s.pos;
    s.expect(Kind.STRING);
    node(Tag.Leaf, s.last_hi, s.last_lo, at);
}

fn expr_list(s: Scanner, close: Kind) I32 {
    let list = 0;
    if s.kind != close {
        while (true) {
            list = node(Tag.List, list, expr(s, 0), 0);
            if s.kind != Kind.COMMA { break; };
            s.take();
        };
    };
    s.expect(close);
    list;
}

fn loop_expr(s: Scanner, array: Bool, at: I32) I32 {
    s.expect(Kind.LSQUARE);
    let bindings = 0;
    if s.kind != Kind.RSQUARE {
        while (true) {
            let name = s.pos;
            s.expect(Kind.VARIABLE);
            s.expect(Kind.COLON);
            let bound = expr(s, 0);
            bindings = node(Tag.List, bindings, node(Tag.Binding, bound, 0, name), 0);
            if s.kind != Kind.COMMA { break; };
            s.take();
        };
    };
    s.expect(Kind.RSQUARE);
    let body = expr(s, 0);
    node(if array { Tag.ArrayExpr; } else { Tag.Loop; }, bindings, body, at);
}

fn prefix(s: Scanner) I32 {
    let at = s.pos;
    let code = if s.kind == Kind.OP { s.op; } else { 0; };
    match s.take() {
        Kind.VARIABLE => node(Tag.Leaf, at, 0, 0),
        Kind.TRUE => node(Tag.Leaf, at, 0, 0),
        Kind.FALSE => node(Tag.Leaf, at, 0, 0),
        Kind.VOID => node(Tag.Leaf, at, 0, 0),
        Kind.INTVAL => node(Tag.Leaf, s.last_hi, s.last_lo, at),
        Kind.FLOATVAL => node(Tag.Leaf, s.last_hi, s.last_lo, at),
        Kind.LPAREN => {
            let inner = expr(s, 0);
            s.expect(Kind.RPAREN);
            inner;
        },
        Kind.LSQUARE => node(Tag.ArrayExpr, expr_list(s, Kind.RSQUARE), 0, 0),
        Kind.OP => {
            if code != 45 and code != 33 { fail(); };
            node(Tag.Unary, expr(s, 5), 0, at);
        },
        Kind.IF => {
            let condition = expr(s, 0);
            s.expect(Kind.THEN);
            let yes = expr(s, 0);
            s.expect(Kind.ELSE);
            let no = expr(s, 0);
            node(Tag.Conditional, node(Tag.List, condition, yes, 0), no, at);
        },
        Kind.ARRAY => loop_expr(s, true, at),
        Kind.SUM => loop_expr(s, false, at),
        ~> {
            fail();
            0;
        },
    };
}

fn expr(s: Scanner, min: I32) I32 {
    let left = prefix(s);
    while (true) {
        let kind = s.kind;
        if kind == Kind.DOT {
            if min > 6 { break; };
            s.take();
            let field = s.pos;
            s.expect(Kind.VARIABLE);
            left = node(Tag.Field, left, 0, field);
        } else if kind == Kind.LSQUARE {
            if min > 6 { break; };
            s.take();
            left = node(Tag.Index, left, expr_list(s, Kind.RSQUARE), 0);
        } else if kind == Kind.LPAREN or kind == Kind.LCURLY {
            if min > 6 or node_tag[left] != Tag.Leaf { break; };
            s.take();
            left = if kind == Kind.LPAREN {
                node(Tag.Call, left, expr_list(s, Kind.RPAREN), 0);
            } else {
                node(Tag.Construct, left, expr_list(s, Kind.RCURLY), 0);
            };
        } else {
            if kind != Kind.OP { break; };
            let binding = precedence[s.op];
            if binding == 0 or binding < min { break; };
            let operator = s.pos;
            s.take();
            left = node(Tag.Binary, left, expr(s, binding + 1), operator);
        };
    };
    left;
}

fn type_expr(s: Scanner) I32 {
    let at = s.pos;
    let kind = s.take();
    if kind != Kind.INT and kind != Kind.FLOAT and kind != Kind.BOOL and kind != Kind.VOID and kind != Kind.VARIABLE {
        fail();
    };
    let result = node(Tag.TypeNode, at, 0, 0);
    while (s.kind == Kind.LSQUARE) {
        s.take();
        let rank = 1;
        while (s.kind == Kind.COMMA) {
            s.take();
            rank += 1;
        };
        s.expect(Kind.RSQUARE);
        result = node(Tag.TypeNode, result, rank, 0);
    };
    result;
}

fn annotation(s: Scanner) I32 {
    s.expect(Kind.COLON);
    type_expr(s);
}

fn lvalue(s: Scanner, binding: Bool) I32 {
    let at = s.pos;
    s.expect(Kind.VARIABLE);
    let result = node(Tag.Lvalue, at, 0, 0);
    if s.kind == Kind.LSQUARE {
        s.take();
        if s.kind != Kind.RSQUARE {
            while (true) {
                let dim = s.pos;
                s.expect(Kind.VARIABLE);
                result = node(Tag.Lvalue, result, dim, 0);
                if s.kind != Kind.COMMA { break; };
                s.take();
            };
        };
        s.expect(Kind.RSQUARE);
    } else if s.kind == Kind.LCURLY {
        s.take();
        if s.kind != Kind.RCURLY {
            while (true) {
                result = node(Tag.Lvalue, result, lvalue(s, binding), 0);
                if s.kind != Kind.COMMA { break; };
                s.take();
            };
        };
        s.expect(Kind.RCURLY);
        return result;
    };
    if binding { result = node(Tag.Binding, result, annotation(s), 0); };
    result;
}

fn stmt(s: Scanner) I32 {
    let at = s.pos;
    let result = match s.take() {
        Kind.LET => {
            let target = lvalue(s, false);
            s.expect(Kind.EQUALS);
            node(Tag.Stmt, target, expr(s, 0), at);
        },
        Kind.ASSERT => {
            let value = expr(s, 0);
            s.expect(Kind.COMMA);
            node(Tag.Stmt, value, string_leaf(s), at);
        },
        Kind.RETURN => node(Tag.Stmt, expr(s, 0), 0, at),
        ~> {
            fail();
            0;
        },
    };
    s.expect(Kind.NEWLINE);
    result;
}

// Every command but `time` ends its line.
fn command(s: Scanner) I32 {
    let at = s.pos;
    let kind = s.take();
    if kind == Kind.TIME { return node(Tag.Command, command(s), 0, at); };
    let result = match kind {
        Kind.LET => {
            let target = lvalue(s, false);
            s.expect(Kind.EQUALS);
            node(Tag.Command, target, expr(s, 0), at);
        },
        Kind.ASSERT => {
            let value = expr(s, 0);
            s.expect(Kind.COMMA);
            node(Tag.Command, value, string_leaf(s), at);
        },
        Kind.SHOW => node(Tag.Command, expr(s, 0), 0, at),
        Kind.PRINT => node(Tag.Command, string_leaf(s), 0, at),
        Kind.READ => {
            s.expect(Kind.IMAGE);
            let text = string_leaf(s);
            s.expect(Kind.TO);
            node(Tag.Command, text, lvalue(s, false), at);
        },
        Kind.WRITE => {
            s.expect(Kind.IMAGE);
            let value = expr(s, 0);
            s.expect(Kind.TO);
            node(Tag.Command, value, string_leaf(s), at);
        },
        Kind.STRUCT => {
            let name = s.pos;
            s.expect(Kind.VARIABLE);
            s.expect(Kind.LCURLY);
            s.expect(Kind.NEWLINE);
            let fields = 0;
            while (s.kind == Kind.VARIABLE) {
                let field = s.pos;
                s.take();
                let field_type = annotation(s);
                fields = node(Tag.List, fields, node(Tag.Binding, field_type, 0, field), 0);
                s.expect(Kind.NEWLINE);
            };
            s.expect(Kind.RCURLY);
            node(Tag.Command, node(Tag.List, node(Tag.Leaf, name, 0, 0), fields, 0), 0, at);
        },
        Kind.FN => {
            let name = s.pos;
            s.expect(Kind.VARIABLE);
            s.expect(Kind.LPAREN);
            let bindings = 0;
            if s.kind != Kind.RPAREN {
                while (true) {
                    bindings = node(Tag.List, bindings, lvalue(s, true), 0);
                    if s.kind != Kind.COMMA { break; };
                    s.take();
                };
            };
            s.expect(Kind.RPAREN);
            let result_type = annotation(s);
            s.expect(Kind.LCURLY);
            s.expect(Kind.NEWLINE);
            let body = 0;
            while (s.kind != Kind.RCURLY) {
                if s.kind == Kind.END_OF_FILE { fail(); };
                body = node(Tag.List, body, stmt(s), 0);
            };
            s.expect(Kind.RCURLY);
            let signature = node(Tag.List, node(Tag.List, node(Tag.Leaf, name, 0, 0), bindings, 0), result_type, 0);
            node(Tag.Command, signature, body, at);
        },
        ~> {
            fail();
            0;
        },
    };
    s.expect(Kind.NEWLINE);
    result;
}

fn program(s: Scanner) I32 {
    let root = 0;
    while (s.kind != Kind.END_OF_FILE) {
        if s.kind == Kind.NEWLINE {
            s.take();
        } else {
            root = node(Tag.List, root, command(s), 0);
        };
    };
    root;
}

// Parse `src` into the node mems. Returns the token count, or -1 for a syntax error.
fn parse() I32 {
    reset_nodes();
    try {
        let s = new_scanner(src.len() - 1, new_env());
        program(s);
        s.pos;
    } catch {
        -1;
    };
}

// ── Type checking ────────────────────────────────────────────────────────────
//
// The Zig compiler's fused parser and type checker (parser_typecheck): every
// expression is typed as it is parsed, and its parse returns
// .{node, type, bare name}. Names are interned spans of `src`; `e.bound[name]`
// is the symbol a name refers to, or -1. Types are structural: one id per
// array element and rank, one per record.

enum(U8) TypeTag:
    | Invalid
    | Void
    | Bool
    | Int
    | Float
    | Record
    | ArrayType

enum(U8) SymbolTag:
    | Variable
    | Function
    | Alias

enum(U8) PatternTag:
    | Plain
    | Dims
    | Fields

// The types every program starts with, in init_env's order.
let t_void: I32 = 1;
let t_bool: I32 = 2;
let t_int: I32 = 3;
let t_float: I32 = 4;
let t_rgba: I32 = 5;
let t_rgba_image: I32 = 7;

// No name.
let unnamed: I32 = -1;

// The checker's environment: symbols, types, fields, scopes, and patterns.
struct Env:
    | bound: Vec[I32]
    | sym_tag: Vec[SymbolTag]
    | sym_type: Vec[I32]
    | sym_params_start: Vec[I32]
    | sym_params_len: Vec[I32]
    | type_tag: Vec[TypeTag]
    | type_element: Vec[I32]
    | type_rank: Vec[I32]
    | type_fields_start: Vec[I32]
    | type_fields_len: Vec[I32]
    | field_name: Vec[I32]
    | field_type: Vec[I32]
    | fn_types: Vec[I32]
    | locals: Vec[I32]
    | fn_params: Vec[I32]
    | pat_tag: Vec[PatternTag]
    | pat_name: Vec[I32]
    | pat_node: Vec[I32]
    | pat_declared: Vec[I32]
    | pat_first: Vec[I32]
    | pat_last: Vec[I32]
    | pat_next: Vec[I32]
    | pat_count: Vec[I32]
    | pat_dim_start: Vec[I32]
    | pat_dim_count: Vec[I32]
    | dim_names: Vec[I32]

fn new_env() Env {
    Env { bound: Vec[I32].new(), sym_tag: Vec[SymbolTag].new(), sym_type: Vec[I32].new(), sym_params_start: Vec[I32].new(), sym_params_len: Vec[I32].new(), type_tag: Vec[TypeTag].new(), type_element: Vec[I32].new(), type_rank: Vec[I32].new(), type_fields_start: Vec[I32].new(), type_fields_len: Vec[I32].new(), field_name: Vec[I32].new(), field_type: Vec[I32].new(), fn_types: Vec[I32].new(), locals: Vec[I32].new(), fn_params: Vec[I32].new(), pat_tag: Vec[PatternTag].new(), pat_name: Vec[I32].new(), pat_node: Vec[I32].new(), pat_declared: Vec[I32].new(), pat_first: Vec[I32].new(), pat_last: Vec[I32].new(), pat_next: Vec[I32].new(), pat_count: Vec[I32].new(), pat_dim_start: Vec[I32].new(), pat_dim_count: Vec[I32].new(), dim_names: Vec[I32].new() };
}






// Names e.bound in the current function or loop, to unbind when it ends.


// Builtin names are appended to `src` after the sentinel, so they intern the same way.
fn intern_text(text: Str) I32 {
    let start = src.len();
    for (0 ..< text.len()) |k| { src.push(text.get(k)); };
    src.intern(start, src.len());
}

fn symbol_of(e: Env, name: I32) I32 {
    if name < e.bound.len { e.bound[name]; } else { -1; };
}

fn lookup(e: Env, name: I32) I32 {
    let symbol = symbol_of(e, name);
    if symbol < 0 { fail(); };
    symbol;
}

fn bind(e: Env, name: I32, tag: SymbolTag, type_id: I32, local: Bool) I32 {
    if symbol_of(e, name) >= 0 { fail(); };
    while (e.bound.len <= name) { e.bound.push(-1); };
    let symbol = e.sym_tag.len;
    e.sym_tag.push(tag);
    e.sym_type.push(type_id);
    e.sym_params_start.push(0);
    e.sym_params_len.push(0);
    e.bound[name] = symbol;
    if local { e.locals.push(name); };
    symbol;
}

fn unbind_to(e: Env, mark: I32) void {
    while (e.locals.len > mark) {
        let name = e.locals[e.locals.len - 1];
        e.locals.truncate(e.locals.len - 1);
        e.bound[name] = -1;
    };
}

fn new_type(e: Env, tag: TypeTag, element: I32, rank: I32, start: I32, count: I32) I32 {
    let id = e.type_tag.len;
    e.type_tag.push(tag);
    e.type_element.push(element);
    e.type_rank.push(rank);
    e.type_fields_start.push(start);
    e.type_fields_len.push(count);
    id;
}

fn array_type(e: Env, element: I32, rank: I32) I32 {
    for (0 ..< e.type_tag.len) |t| {
        if e.type_tag[t] == TypeTag.ArrayType and e.type_element[t] == element and e.type_rank[t] == rank { return t; };
    };
    new_type(e, TypeTag.ArrayType, element, rank, 0, 0);
}

fn field_type_of(e: Env, record: I32, name: I32) I32 {
    let start = e.type_fields_start[record];
    for (start ..< start + e.type_fields_len[record]) |f| {
        if e.field_name[f] == name { return e.field_type[f]; };
    };
    0;
}

fn builtin(e: Env, name: Str, result: I32, first: I32, second: I32) void {
    let start = e.fn_types.len;
    e.fn_types.push(first);
    if second != 0 { e.fn_types.push(second); };
    let symbol = bind(e, intern_text(name), SymbolTag.Function, result, false);
    e.sym_params_start[symbol] = start;
    e.sym_params_len[symbol] = e.fn_types.len - start;
}

fn reset_env(e: Env) void {
    src.intern_reset();
    e.bound.clear();
    e.sym_tag.clear();
    e.sym_type.clear();
    e.sym_params_start.clear();
    e.sym_params_len.clear();
    e.type_tag.clear();
    e.type_element.clear();
    e.type_rank.clear();
    e.type_fields_start.clear();
    e.type_fields_len.clear();
    e.field_name.clear();
    e.field_type.clear();
    e.fn_types.clear();
    e.locals.clear();
    e.fn_params.clear();
    e.pat_tag.clear();
    e.pat_name.clear();
    e.pat_node.clear();
    e.pat_declared.clear();
    e.pat_first.clear();
    e.pat_last.clear();
    e.pat_next.clear();
    e.pat_count.clear();
    e.pat_dim_start.clear();
    e.pat_dim_count.clear();
    e.dim_names.clear();
}

// The builtin types, records, variables, and functions.
fn init_env(e: Env) void {
    reset_env(e);
    new_type(e, TypeTag.Invalid, 0, 0, 0, 0);
    new_type(e, TypeTag.Void, 0, 0, 0, 0);
    new_type(e, TypeTag.Bool, 0, 0, 0, 0);
    new_type(e, TypeTag.Int, 0, 0, 0, 0);
    new_type(e, TypeTag.Float, 0, 0, 0, 0);
    new_type(e, TypeTag.Record, 0, 0, 0, 4);
    for (["r", "g", "b", "a"]) |name| {
        e.field_name.push(intern_text(name));
        e.field_type.push(t_float);
    };
    bind(e, intern_text("rgba"), SymbolTag.Alias, t_rgba, false);
    bind(e, intern_text("argnum"), SymbolTag.Variable, t_int, false);
    bind(e, intern_text("args"), SymbolTag.Variable, array_type(e, t_int, 1), false);
    if array_type(e, t_rgba, 2) != t_rgba_image { fatal; };
    for (["sqrt", "exp", "sin", "cos", "tan", "asin", "acos", "atan", "log"]) |name| {
        builtin(e, name, t_float, t_float, 0);
    };
    builtin(e, "pow", t_float, t_float, t_float);
    builtin(e, "atan2", t_float, t_float, t_float);
    builtin(e, "to_float", t_float, t_int, 0);
    builtin(e, "to_int", t_int, t_float, 0);
}

fn typed_string(s: Scanner) I32 {
    let e = s.env;
    let at = s.pos;
    s.expect(Kind.STRING);
    typed_node(Tag.Leaf, s.last_hi, s.last_lo, at, 0);
}

// An array literal's elements, which share one type: .{node, count, type}.
fn typed_elements(s: Scanner) .{I32, I32, I32} {
    let e = s.env;
    let list = 0;
    let count = 0;
    let element = 0;
    if s.kind != Kind.RSQUARE {
        while (true) {
            let .{item, item_type, _bare} = typed_expr(s, 0);
            if count == 0 {
                element = item_type;
            } else if item_type != element {
                fail();
            };
            list = typed_node(Tag.List, list, item, 0, 0);
            count += 1;
            if s.kind != Kind.COMMA { break; };
            s.take();
        };
    };
    s.expect(Kind.RSQUARE);
    .{list, count, element};
}

// Indices, which are Ints: .{node, count}.
fn typed_indices(s: Scanner) .{I32, I32} {
    let e = s.env;
    let list = 0;
    let count = 0;
    if s.kind != Kind.RSQUARE {
        while (true) {
            let .{item, item_type, _bare} = typed_expr(s, 0);
            if item_type != t_int { fail(); };
            list = typed_node(Tag.List, list, item, 0, 0);
            count += 1;
            if s.kind != Kind.COMMA { break; };
            s.take();
        };
    };
    s.expect(Kind.RSQUARE);
    .{list, count};
}

// Arguments or record fields, typed as `expected[start ..< start + count]`
// (`e.fn_types` for arguments, `e.field_type` for fields).
fn typed_arguments(s: Scanner, close: Kind, fields: Bool, start: I32, count: I32) I32 {
    let e = s.env;
    let list = 0;
    let n = 0;
    if s.kind != close {
        while (true) {
            let .{item, item_type, _bare} = typed_expr(s, 0);
            if n >= count { fail(); };
            let wanted = if fields { e.field_type[start + n]; } else { e.fn_types[start + n]; };
            if item_type != wanted { fail(); };
            list = typed_node(Tag.List, list, item, 0, 0);
            n += 1;
            if s.kind != Kind.COMMA { break; };
            s.take();
        };
    };
    s.expect(close);
    if n != count { fail(); };
    list;
}

// `array[i : n, …] body` and `sum[…] body`: .{node, type}.
fn typed_loop(s: Scanner, array: Bool, at: I32) .{I32, I32} {
    let e = s.env;
    s.expect(Kind.LSQUARE);
    let mark = e.locals.len;
    let count = 0;
    let bindings = 0;
    if s.kind != Kind.RSQUARE {
        while (true) {
            let name_at = s.pos;
            let name = s.expect_name();
            s.expect(Kind.COLON);
            let .{limit, limit_type, _bare} = typed_expr(s, 0);
            if limit_type != t_int { fail(); };
            bind(e, name, SymbolTag.Variable, t_int, true);
            bindings = typed_node(Tag.List, bindings, typed_node(Tag.Binding, limit, 0, name_at, t_int), 0, 0);
            count += 1;
            if s.kind != Kind.COMMA { break; };
            s.take();
        };
    };
    s.expect(Kind.RSQUARE);
    if count == 0 { fail(); };
    let .{body, body_type, _bare} = typed_expr(s, 0);
    if not array and body_type != t_int and body_type != t_float { fail(); };
    let result = if array { array_type(e, body_type, count); } else { body_type; };
    unbind_to(e, mark);
    .{typed_node(if array { Tag.ArrayExpr; } else { Tag.Loop; }, bindings, body, at, result), result};
}

// A prefix expression: .{node, type, bare name}. A name of a function or
// type has type 0 (not a value) until it is called or constructed.
fn typed_prefix(s: Scanner) .{I32, I32, I32} {
    let e = s.env;
    let at = s.pos;
    let code = if s.kind == Kind.OP { s.op; } else { 0; };
    let kind = s.kind;
    let name = if kind == Kind.VARIABLE { s.name(); } else { unnamed; };
    s.take();
    match kind {
        Kind.VARIABLE => {
            let symbol = lookup(e, name);
            let value = if e.sym_tag[symbol] == SymbolTag.Variable { e.sym_type[symbol]; } else { 0; };
            .{typed_node(Tag.Leaf, symbol, 0, at, e.sym_type[symbol]), value, name};
        },
        Kind.TRUE => .{typed_node(Tag.Leaf, at, 0, at, t_bool), t_bool, unnamed},
        Kind.FALSE => .{typed_node(Tag.Leaf, at, 0, at, t_bool), t_bool, unnamed},
        Kind.VOID => .{typed_node(Tag.Leaf, at, 0, at, t_void), t_void, unnamed},
        Kind.INTVAL => .{typed_node(Tag.Leaf, s.last_hi, s.last_lo, at, t_int), t_int, unnamed},
        Kind.FLOATVAL => .{typed_node(Tag.Leaf, s.last_hi, s.last_lo, at, t_float), t_float, unnamed},
        Kind.LPAREN => {
            let .{inner, inner_type, _bare} = typed_expr(s, 0);
            s.expect(Kind.RPAREN);
            .{inner, inner_type, unnamed};
        },
        Kind.LSQUARE => {
            let .{list, count, element} = typed_elements(s);
            if count == 0 { fail(); };
            let array = array_type(e, element, 1);
            .{typed_node(Tag.ArrayExpr, list, 0, at, array), array, unnamed};
        },
        Kind.OP => {
            if code != 45 and code != 33 { fail(); };
            let .{right, right_type, _bare} = typed_expr(s, 5);
            if code == 45 and right_type != t_int and right_type != t_float { fail(); };
            if code == 33 and right_type != t_bool { fail(); };
            .{typed_node(Tag.Unary, right, 0, at, right_type), right_type, unnamed};
        },
        Kind.IF => {
            let .{condition, condition_type, _a} = typed_expr(s, 0);
            s.expect(Kind.THEN);
            let .{yes, yes_type, _b} = typed_expr(s, 0);
            s.expect(Kind.ELSE);
            let .{no, no_type, _c} = typed_expr(s, 0);
            if condition_type != t_bool or yes_type != no_type { fail(); };
            let pair = typed_node(Tag.List, condition, yes, 0, 0);
            .{typed_node(Tag.Conditional, pair, no, at, yes_type), yes_type, unnamed};
        },
        Kind.ARRAY => {
            let .{array, array_type_id} = typed_loop(s, true, at);
            .{array, array_type_id, unnamed};
        },
        Kind.SUM => {
            let .{sum, sum_type} = typed_loop(s, false, at);
            .{sum, sum_type, unnamed};
        },
        ~> {
            fail();
            .{0, 0, unnamed};
        },
    };
}

// A binary operator's result type for operands of `left` and `right`.
fn operator_type(code: I32, left: I32, right: I32) I32 {
    if code == 38 or code == 124 {
        if left != t_bool or right != t_bool { fail(); };
        return t_bool;
    };
    if left != right or (left != t_int and left != t_float) { fail(); };
    let compares = code == 60 or code == 62 or code == 61 or code == 126;
    if compares { t_bool; } else { left; };
}

// An expression whose operators bind at least `min`: .{node, type, bare name}.
fn typed_expr(s: Scanner, min: I32) .{I32, I32, I32} {
    let e = s.env;
    let .{left, left_type, bare} = typed_prefix(s);
    while (true) {
        let kind = s.kind;
        if kind == Kind.DOT {
            if min > 6 { break; };
            s.take();
            let name = s.expect_name();
            if e.type_tag[left_type] != TypeTag.Record { fail(); };
            let result = field_type_of(e, left_type, name);
            if result == 0 { fail(); };
            left = typed_node(Tag.Field, left, 0, s.pos - 1, result);
            left_type = result;
        } else if kind == Kind.LSQUARE {
            if min > 6 { break; };
            s.take();
            if e.type_tag[left_type] != TypeTag.ArrayType { fail(); };
            let .{indices, count} = typed_indices(s);
            if count != e.type_rank[left_type] { fail(); };
            let element = e.type_element[left_type];
            left = typed_node(Tag.Index, left, indices, 0, element);
            left_type = element;
        } else if kind == Kind.LPAREN or kind == Kind.LCURLY {
            if min > 6 or bare == unnamed { break; };
            let symbol = lookup(e, bare);
            s.take();
            if kind == Kind.LPAREN {
                if e.sym_tag[symbol] != SymbolTag.Function { fail(); };
                let args = typed_arguments(s, Kind.RPAREN, false, e.sym_params_start[symbol], e.sym_params_len[symbol]);
                left = typed_node(Tag.Call, left, args, 0, e.sym_type[symbol]);
            } else {
                let record = e.sym_type[symbol];
                if e.sym_tag[symbol] != SymbolTag.Alias or e.type_tag[record] != TypeTag.Record { fail(); };
                let args = typed_arguments(s, Kind.RCURLY, true, e.type_fields_start[record], e.type_fields_len[record]);
                left = typed_node(Tag.Construct, left, args, 0, record);
            };
            left_type = e.sym_type[symbol];
        } else {
            if kind != Kind.OP { break; };
            let code = s.op;
            let binding = precedence[code];
            if binding == 0 or binding < min { break; };
            let operator = s.pos;
            s.take();
            let .{right, right_type, _bare} = typed_expr(s, binding + 1);
            let result = operator_type(code, left_type, right_type);
            left = typed_node(Tag.Binary, left, right, operator, result);
            left_type = result;
        };
        bare = unnamed;
    };
    if left_type == 0 { fail(); };
    .{left, left_type, bare};
}

fn typed_type(s: Scanner) I32 {
    let e = s.env;
    let result = match s.kind {
        Kind.INT => t_int,
        Kind.FLOAT => t_float,
        Kind.BOOL => t_bool,
        Kind.VOID => t_void,
        Kind.VARIABLE => {
            let symbol = lookup(e, s.name());
            if e.sym_tag[symbol] != SymbolTag.Alias { fail(); };
            e.sym_type[symbol];
        },
        ~> {
            fail();
            0;
        },
    };
    s.take();
    while (s.kind == Kind.LSQUARE) {
        s.take();
        let rank = 1;
        while (s.kind == Kind.COMMA) {
            s.take();
            rank += 1;
        };
        s.expect(Kind.RSQUARE);
        result = array_type(e, result, rank);
    };
    result;
}

fn typed_annotation(s: Scanner) I32 {
    let e = s.env;
    s.expect(Kind.COLON);
    typed_type(s);
}

// A binding target: `x`, `a[i, j]`, or `point{x, y}` (with `: type` on
// parameters). Returns a pattern id; bind_pattern binds it once the value's
// type is known.
fn pattern(s: Scanner, parameter: Bool) I32 {
    let e = s.env;
    let at = s.pos;
    let name = s.expect_name();
    let id = e.pat_tag.len;
    e.pat_tag.push(PatternTag.Plain);
    e.pat_name.push(name);
    e.pat_node.push(0);
    e.pat_declared.push(0);
    e.pat_first.push(-1);
    e.pat_last.push(-1);
    e.pat_next.push(-1);
    e.pat_count.push(0);
    e.pat_dim_start.push(0);
    e.pat_dim_count.push(0);
    let target = typed_node(Tag.Lvalue, at, 0, at, 0);
    if s.kind == Kind.LSQUARE {
        s.take();
        e.pat_tag[id] = PatternTag.Dims;
        e.pat_dim_start[id] = e.dim_names.len;
        if s.kind != Kind.RSQUARE {
            while (true) {
                let dim_at = s.pos;
                e.dim_names.push(s.expect_name());
                e.pat_dim_count[id] += 1;
                target = typed_node(Tag.Lvalue, target, dim_at, at, 0);
                if s.kind != Kind.COMMA { break; };
                s.take();
            };
        };
        s.expect(Kind.RSQUARE);
    } else if s.kind == Kind.LCURLY {
        s.take();
        e.pat_tag[id] = PatternTag.Fields;
        if s.kind != Kind.RCURLY {
            while (true) {
                let child = pattern(s, parameter);
                if e.pat_first[id] < 0 {
                    e.pat_first[id] = child;
                } else {
                    e.pat_next[e.pat_last[id]] = child;
                };
                e.pat_last[id] = child;
                e.pat_count[id] += 1;
                target = typed_node(Tag.Lvalue, target, e.pat_node[child], at, 0);
                if s.kind != Kind.COMMA { break; };
                s.take();
            };
        };
        s.expect(Kind.RCURLY);
        let symbol = lookup(e, name);
        if e.sym_tag[symbol] != SymbolTag.Alias or e.type_tag[e.sym_type[symbol]] != TypeTag.Record { fail(); };
        e.pat_declared[id] = e.sym_type[symbol];
    };
    if parameter and e.pat_tag[id] != PatternTag.Fields {
        e.pat_declared[id] = typed_annotation(s);
        target = typed_node(Tag.Binding, target, 0, at, e.pat_declared[id]);
    };
    e.pat_node[id] = target;
    id;
}

fn bind_pattern(e: Env, id: I32, expected: I32, local: Bool) void {
    if e.pat_declared[id] != 0 and e.pat_declared[id] != expected { fail(); };
    let tag = e.pat_tag[id];
    if tag == PatternTag.Plain {
        bind(e, e.pat_name[id], SymbolTag.Variable, expected, local);
    } else if tag == PatternTag.Dims {
        if e.type_tag[expected] != TypeTag.ArrayType or e.type_rank[expected] != e.pat_dim_count[id] { fail(); };
        bind(e, e.pat_name[id], SymbolTag.Variable, expected, local);
        let start = e.pat_dim_start[id];
        for (start ..< start + e.pat_dim_count[id]) |d| {
            bind(e, e.dim_names[d], SymbolTag.Variable, t_int, local);
        };
    } else {
        if e.type_tag[expected] != TypeTag.Record or e.type_fields_len[expected] != e.pat_count[id] { fail(); };
        let child = e.pat_first[id];
        let start = e.type_fields_start[expected];
        for (start ..< start + e.type_fields_len[expected]) |f| {
            bind_pattern(e, child, e.field_type[f], local);
            child = e.pat_next[child];
        };
    };
}

// `let`, `assert`, or `return` in a function returning `returns`:
// .{node, whether it returned}.
fn typed_stmt(s: Scanner, returns: I32) .{I32, Bool} {
    let e = s.env;
    let at = s.pos;
    let result = match s.take() {
        Kind.LET => {
            let target = pattern(s, false);
            s.expect(Kind.EQUALS);
            let .{value, value_type, _bare} = typed_expr(s, 0);
            bind_pattern(e, target, value_type, true);
            .{typed_node(Tag.Stmt, e.pat_node[target], value, at, t_void), false};
        },
        Kind.ASSERT => {
            let .{value, value_type, _bare} = typed_expr(s, 0);
            if value_type != t_bool { fail(); };
            s.expect(Kind.COMMA);
            .{typed_node(Tag.Stmt, value, typed_string(s), at, t_void), false};
        },
        Kind.RETURN => {
            let .{value, value_type, _bare} = typed_expr(s, 0);
            if value_type != returns { fail(); };
            .{typed_node(Tag.Stmt, value, 0, at, t_void), true};
        },
        ~> {
            fail();
            .{0, false};
        },
    };
    s.expect(Kind.NEWLINE);
    result;
}

fn typed_struct(s: Scanner, at: I32) I32 {
    let e = s.env;
    let name = s.expect_name();
    if symbol_of(e, name) >= 0 { fail(); };
    s.expect(Kind.LCURLY);
    s.expect(Kind.NEWLINE);
    let start = e.field_name.len;
    let fields = 0;
    while (s.kind == Kind.VARIABLE) {
        let field_at = s.pos;
        let field = s.expect_name();
        for (start ..< e.field_name.len) |f| {
            if e.field_name[f] == field { fail(); };
        };
        let type_id = typed_annotation(s);
        e.field_name.push(field);
        e.field_type.push(type_id);
        fields = typed_node(Tag.List, fields, typed_node(Tag.Binding, type_id, 0, field_at, type_id), 0, 0);
        s.expect(Kind.NEWLINE);
    };
    s.expect(Kind.RCURLY);
    bind(e, name, SymbolTag.Alias, new_type(e, TypeTag.Record, 0, 0, start, e.field_name.len - start), false);
    typed_node(Tag.Command, fields, 0, at, t_void);
}

fn typed_fn(s: Scanner, at: I32) I32 {
    let e = s.env;
    let name = s.expect_name();
    if symbol_of(e, name) >= 0 { fail(); };
    s.expect(Kind.LPAREN);
    let first_param = e.fn_params.len;
    let params_start = e.fn_types.len;
    if s.kind != Kind.RPAREN {
        while (true) {
            let param = pattern(s, true);
            e.fn_params.push(param);
            e.fn_types.push(e.pat_declared[param]);
            if s.kind != Kind.COMMA { break; };
            s.take();
        };
    };
    s.expect(Kind.RPAREN);
    let returns = typed_annotation(s);
    let symbol = bind(e, name, SymbolTag.Function, returns, false);
    e.sym_params_start[symbol] = params_start;
    e.sym_params_len[symbol] = e.fn_params.len - first_param;
    let mark = e.locals.len;
    for (first_param ..< e.fn_params.len) |k| {
        bind_pattern(e, e.fn_params[k], e.pat_declared[e.fn_params[k]], true);
    };
    e.fn_params.truncate(first_param);
    s.expect(Kind.LCURLY);
    s.expect(Kind.NEWLINE);
    let body = 0;
    let returned = false;
    while (s.kind != Kind.RCURLY) {
        if s.kind == Kind.END_OF_FILE { fail(); };
        let .{statement, did_return} = typed_stmt(s, returns);
        body = typed_node(Tag.List, body, statement, 0, 0);
        returned = returned or did_return;
    };
    s.expect(Kind.RCURLY);
    if returns != t_void and not returned { fail(); };
    unbind_to(e, mark);
    typed_node(Tag.Command, body, 0, at, t_void);
}

// Every command but `time` ends its line.
fn typed_command(s: Scanner) I32 {
    let e = s.env;
    let at = s.pos;
    let kind = s.take();
    if kind == Kind.TIME { return typed_node(Tag.Command, typed_command(s), 0, at, t_void); };
    let result = match kind {
        Kind.LET => {
            let target = pattern(s, false);
            s.expect(Kind.EQUALS);
            let .{value, value_type, _bare} = typed_expr(s, 0);
            bind_pattern(e, target, value_type, false);
            typed_node(Tag.Command, e.pat_node[target], value, at, t_void);
        },
        Kind.ASSERT => {
            let .{value, value_type, _bare} = typed_expr(s, 0);
            if value_type != t_bool { fail(); };
            s.expect(Kind.COMMA);
            typed_node(Tag.Command, value, typed_string(s), at, t_void);
        },
        Kind.SHOW => {
            let .{value, _type, _bare} = typed_expr(s, 0);
            typed_node(Tag.Command, value, 0, at, t_void);
        },
        Kind.PRINT => typed_node(Tag.Command, typed_string(s), 0, at, t_void),
        Kind.READ => {
            s.expect(Kind.IMAGE);
            let text = typed_string(s);
            s.expect(Kind.TO);
            let target = pattern(s, false);
            bind_pattern(e, target, t_rgba_image, false);
            typed_node(Tag.Command, text, e.pat_node[target], at, t_void);
        },
        Kind.WRITE => {
            s.expect(Kind.IMAGE);
            let .{value, value_type, _bare} = typed_expr(s, 0);
            if value_type != t_rgba_image { fail(); };
            s.expect(Kind.TO);
            typed_node(Tag.Command, value, typed_string(s), at, t_void);
        },
        Kind.STRUCT => typed_struct(s, at),
        Kind.FN => typed_fn(s, at),
        ~> {
            fail();
            0;
        },
    };
    s.expect(Kind.NEWLINE);
    result;
}

fn typed_program(s: Scanner) I32 {
    let e = s.env;
    let root = 0;
    while (s.kind != Kind.END_OF_FILE) {
        if s.kind == Kind.NEWLINE {
            s.take();
        } else {
            root = typed_node(Tag.List, root, typed_command(s), 0, 0);
        };
    };
    root;
}

// Parse and type check `src`. Returns the token count + 1 (as Zig reports
// it), or -1 for a syntax or type error.
// Also returns the symbol and type counts, for -s.
fn check() .{I32, I32, I32} {
    reset_nodes();
    node_type.reserve(src.len());
    let end = src.len() - 1;
    let e = new_env();
    let tokens = try {
        init_env(e);
        let s = new_scanner(end, e);
        typed_program(s);
        s.pos + 1;
    } catch {
        -1;
    };
    let result = .{tokens, e.sym_tag.len, e.type_tag.len};
    // Drop the builtin names init_env appended after the sentinel.
    src.resize(end + 1);
    result;
}

// ── The command line ───────────────────────────────────────────────────────────

fn load(path: Str) void {
    src.copy_in(Fs.readFileSync(path));
    src.push(255);
}

fn report(n: I32, print: Bool) void {
    let at = if n >= 0 and print { listing(n); } else { 0; };
    at = emit_bytes(at, if n < 0 { "Compilation failed\n"; } else { "Compilation succeeded\n"; });
    // A pipe can take less than everything, or nothing yet (EAGAIN under Node).
    let written = 0;
    while (written < at) {
        written += try { Fs.writeSync(1.0, out.view(written, at)).to_i32(); } catch { 0; };
    };
}

// Median of `runs` timings of lex (and with `print`, of the listing too), in ms.
fn time(runs: I32, print: Bool) F64 {
    let samples = Array[F64].new(runs, 0.0);
    for (0 ..< runs + 3) |r| {
        let begin = Web.performance.now();
        let n = lex();
        if print { listing(n); };
        if r >= 3 { samples[r - 3] = Web.performance.now() - begin; };
    };
    (samples sort(F64) |a, b| { a < b; })[runs / 2];
}

// jpl <file.jpl> -l       token listing, as the Zig compiler prints it
// jpl <file.jpl> -_       lex only
// jpl <file.jpl> -p -q    parse only (Zig's parser benchmark)
// jpl <file.jpl> -s       parse, then print token and node counts
// jpl <file.jpl> -t -q    parse and type check
// jpl <file.jpl> -t -s    type check, then print token, node, symbol, and type counts
// jpl <file.jpl> -bench   in-process medians for lexing, listing, and parsing
export main() void {
    let args = Process.argv;
    let file = "";
    let flags = "";
    for (2 ..< args.length.to_i32()) |k| {
        let arg = args[k];
        if arg.get(0) == 45 { flags = flags + arg; } else { file = arg; };
    };
    load(file);
    if flags == "-bench" {
        let lexing = time(15, false);
        let listing_too = time(15, true);
        let parsing = time_parse(15, false);
        let checking = time_parse(15, true);
        let n = lex();
        Web.console.log("lex " + lexing.to_str() + " ms, lex + listing " + listing_too.to_str() + " ms, parse "
            + parsing.to_str() + " ms, type check " + checking.to_str() + " ms, " + n.to_str() + " tokens");
        return;
    };
    if flags == "-s" {
        let tokens = parse();
        let text = if tokens < 0 { "Compilation failed\n"; } else { "tokens=" + tokens.to_str() + " nodes=" + node_tag.len().to_str() + "\n"; };
        Fs.writeSync(1.0, text);
        return;
    };
    if flags == "-t-s" or flags == "-s-t" {
        let .{tokens, symbols, types} = check();
        let counts = "tokens=" + tokens.to_str() + " nodes=" + node_tag.len().to_str() + " symbols="
            + symbols.to_str() + " types=" + types.to_str() + "\n";
        Fs.writeSync(1.0, if tokens < 0 { "Compilation failed\n"; } else { counts; });
        return;
    };
    if flags == "-t-q" or flags == "-q-t" or flags == "-t" {
        let .{tokens, _symbols, _types} = check();
        Fs.writeSync(1.0, if tokens < 0 { "Compilation failed\n"; } else { "Compilation succeeded\n"; });
        return;
    };
    if flags == "-p-q" or flags == "-q-p" or flags == "-p" {
        Fs.writeSync(1.0, if parse() < 0 { "Compilation failed\n"; } else { "Compilation succeeded\n"; });
        return;
    };
    let n = lex();
    report(n, flags == "-l");
}

fn time_parse(runs: I32, types: Bool) F64 {
    let samples = Array[F64].new(runs, 0.0);
    for (0 ..< runs + 3) |r| {
        let begin = Web.performance.now();
        if types { let .{_t, _s, _y} = check(); } else { parse(); };
        if r >= 3 { samples[r - 3] = Web.performance.now() - begin; };
    };
    (samples sort(F64) |a, b| { a < b; })[runs / 2];
}
