// Bounded module parameters: `mod Ranking[T[Ord, Named]]` takes only types
// that implement both protocols, and calls their methods and getters
// directly. Each instance calls its own type's: no dispatch, no boxing.
using console from std:Console;
using Ord from std:Ord;
using Order from std:Ord;

proto Named:
    | get name : Str

struct Player[Ord, Named]:
    | name: Str
    | score: I32

struct City[Ord, Named]:
    | name: Str
    | people: F64

// Higher scores come first: an order is whatever cmp says.
fn Ord[Player].cmp |a| (b: Player) I32 { b.score - a.score; }
fn Ord[City].cmp |a| (b: City) I32 { b.people.cmp(a.people); }

/// The first `n` of `xs` in T's order, by name.
mod Ranking[T[Ord, Named]] {
    fn top(xs: Array[T], n: I32) Str {
        Order[T].sort(xs);
        let names = Array[Str].new(n, "");
        for (0 ..< n) |i| { names[i] = xs[i].name; };
        ", ".join(names);
    }
}

/// A pair kept in order: `Span[T]` for any T that implements Ord, and,
/// itself ordered by where it starts, an Ord too.
mod Span[T[Ord]] {
    struct &:
        | low: T
        | high: T
    fn &.of(a: T, b: T) & { &{ low: Order[T].min(a, b), high: Order[T].max(a, b) }; }
    fn &.holds |s| (x: T) Bool { s.low.cmp(x) <= 0 and x.cmp(s.high) <= 0; }
    fn Ord[&].cmp |a| (b: &) I32 { a.low.cmp(b.low); }
}

export main() void {
    let players = [Player { name: "ada", score: 31 }, Player { name: "bo", score: 47 }, Player { name: "cy", score: 12 }];
    console.log(Ranking[Player].top(players, 2));                           // bo, ada
    let cities = [City { name: "Oslo", people: 0.7 }, City { name: "Lagos", people: 15.4 }, City { name: "Lima", people: 10.9 }];
    console.log(Ranking[City].top(cities, 3));                              // Lagos, Lima, Oslo
    let words = Span[Str].of("pear", "fig");
    console.log(`${words.low}..${words.high} ${words.holds("kiwi")} ${words.holds("apple")}`);   // fig..pear true false
    let spans = [Span[I32].of(9, 4), Span[I32].of(1, 3), Span[I32].of(6, 2)];
    let first = Order[Span[I32]].min_of(spans);
    console.log(`${first.low}..${first.high} ${Order[I32].clamp(12, 0, 10)}`);   // 1..3 10
}
