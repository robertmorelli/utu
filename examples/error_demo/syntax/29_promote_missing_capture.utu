// What: a promote arm has no `|name|` capture before `=>`.
// Expect: a promote's present arm binds the value: `|n| => ...`; got '=>'.
fn initial(name: ?Str) Str {
    promote name {
        => name.slice(0, 1),
        ~> "?",
    };
}

main { console.log(initial("Ada")); }
using console from std:console
