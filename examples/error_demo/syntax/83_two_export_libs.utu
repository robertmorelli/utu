// What: two `lib` blocks in one entry file.
// Expect: entry surface: multiple lib declarations; merge them into one lib.
fn area(w: F64, h: F64) F64 { return w * h; }

lib {
    fn rect_area(w: F64, h: F64) F64 { return area(w, h); }
}

lib {
    fn square_area(s: F64) F64 { return area(s, s); }
}
