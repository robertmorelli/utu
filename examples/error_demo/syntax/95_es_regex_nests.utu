// What: a JavaScript regex in an @es body holds `/\`, which opens a nested body.
// Expect: the `/\` in the regex is named: the body ends at a later `\/` than meant.
let words: fun(Str) I32 = @es/\ (s) => s.split(/\s\//).length \/;

main {
    console.log(words("a /b"));
}
using console from std:Console
