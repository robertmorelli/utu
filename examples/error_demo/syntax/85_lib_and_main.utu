// What: both `lib` and `main` in one entry file.
// Expect: entry surface: lib and main are mutually exclusive.
fn area(w: F64, h: F64) F64 { return w * h; }

lib {
    fn rect_area(w: F64, h: F64) F64 { return area(w, h); }
}

main {
    console.log(area(2.0, 3.0));
}
using console from std:Console
