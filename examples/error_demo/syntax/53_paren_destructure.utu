// What: a tuple destructured with parentheses `let (q, r) = ...` instead of `let .{q, r}`.
// Expect: take a tuple apart with `let .{q, r} = divmod(17, 5);`; got '('.
fn divmod(a: I32, b: I32) .{I32, I32} {
    .{a / b, a % b};
}

main {
    let (q, r) = divmod(17, 5);
    console.log(q + r);
}
using console from std:Console
