// What: an inline closure written with the type keyword `fun` instead of `cl`.
// Expect: `fun(...)` is a function type; write an inline closure as `cl(x: I32) I32 { ... }`.
fn apply(f: cl(I32) I32, x: I32) I32 { f(x); }

main {
    console.log(apply(fun(x: I32) I32 { x * 2; }, 21));
}
using console from std:Console
