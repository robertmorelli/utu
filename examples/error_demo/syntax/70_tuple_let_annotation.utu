// What: a local binding annotated with a tuple type.
// Expect: A tuple type is only a function result; take it apart with `let .{q, r} = divmod(...)`.
fn divmod(a: I32, b: I32) .{I32, I32} { return .{a / b, a % b}; }

main {
    let qr: .{I32, I32} = divmod(17, 5);
    console.log(0);
}
using console from std:console
