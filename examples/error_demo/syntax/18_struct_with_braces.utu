// What: a struct declared with C/Rust-style braces instead of `|` field lines.
// Expect: struct fields are written `struct Point:` then `| x: F64` lines; got '{'.
struct Point {
    x: F64,
    y: F64,
}

main {
    let p = Point { x: 1.0, y: 2.0 };
    console.log(p.x + p.y);
}
using console from std:Console
