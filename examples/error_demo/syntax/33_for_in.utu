// What: a Python/JS-style `for x in xs` loop.
// Expect: utu's for is `for (xs) |x| { ... }`; got 'x' where '(' was expected.
fn sum(xs: Array[I32]) I32 {
    let total = 0;
    for x in xs {
        total += x;
    };
    total;
}

main { console.log(sum([1, 2, 3])); }
using console from std:Console
