// What: a function on a protocol with the name of one of its methods
// Expect: Sh.area is already a protocol member
proto Sh:
    | area() I32

struct Sq[Sh]:
    | s: I32

fn Sh[Sq].area |q| () I32 { return q.s * q.s; }
fn Sh.area |x| () I32 { return 0; }

main {
    let s: Sh = Sq { s: 3 };
    console.log(s.area());
}
using console from std:Console
