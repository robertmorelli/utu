// What: an alt arm naming another enum's variant by its enum
// Expect: Expected Shape, got Circle
enum Shape:
    | Circle { r: F64 }
    | Dot {}

enum Lens:
    | Circle { focus: F64 }

fn area(s: Shape) F64 {
    return alt s {
        Lens.Circle |c| => c.focus,
        ~> 0.0,
    };
}

main { console.log(area(Shape.Dot)); }
using console from std:Console
