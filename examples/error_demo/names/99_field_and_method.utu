// What: a closure field and a method of the same name; p.f() would call one silently
// Expect: P.f is both a field and a method
struct P:
    | f: cl() I32

fn P.f |p| () I32 { return 2; }

main {
    let p = P { f: cl() I32 { return 1; } };
    console.log(p.f());
}
using console from std:console
