// What: an alt arm names a variant of a different enum
// Expect: Shape has no variant Ok (Ok is a variant of Outcome)
enum Shape:
    | Circle { r: F64 }
    | Square { side: F64 }

enum Outcome:
    | Ok {}
    | Failed {}

fn area(s: Shape) F64 {
    return alt s {
        Circle |c| => c.r,
        Ok => 0.0,
        ~> 1.0,
    };
}

main {
    console.log(area(Circle { r: 1.0 }));
}
using console from std:Console
