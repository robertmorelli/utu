// What: a &{…} argument of a method on a field whose type is unknown
// Expect: Unknown module Nope (once); no "&{…} needs a struct type"
struct State:
    | items: Nope.Array

fn add(state: State) Void {
    state.items.push(&{ id: 1 });
}

main {
    console.log(1);
}
using console from std:console
