// What: a type argument given to a module that takes none
// Expect: Module 'Money' takes no type arguments, got 1
mod Money {
    struct &:
        | cents: I64
    fn &.zero() & { return &{ cents: 0.i64() }; }
}

main {
    let m = Money[I64].zero();
    console.log(0);
}
using console from std:Console
