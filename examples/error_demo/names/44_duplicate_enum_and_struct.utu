// What: a struct named like an enum's variant keeps the name: a bare literal is the struct's unless a Shape is wanted
// Expect: Circle has no field r
enum Shape:
    | Circle { r: F64 }
    | Square { side: F64 }

struct Circle:
    | radius: F64

export main() F64 {
    let c = Circle { r: 1.0 };   // the struct: Shape.Circle { r: 1.0 }, or let c: Shape = …
    0.0;
}
