// What: one file declares mod geometry twice, both with the same function
// Expect: Duplicate declaration geometry, at the second mod
mod geometry {
    fn square(x: F64) F64 { x * x; }
}

mod geometry {
    fn square(x: F64) F64 { x * x * 1.0; }
}

export main() F64 {
    geometry.square(3.0);
}
