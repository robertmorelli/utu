// What: a match on an int enum lists one variant twice
// Expect: Duplicate match pattern 'Level.Mid' (already matched on line 10)
enum(U8) Level:
    | Low
    | Mid
    | High

fn label(l: Level) Str {
    match l {
        Level.Low => "calm",
        Level.Mid => "busy",
        Level.Mid => "very busy",
        Level.High => "on fire",
    };
}

main {
    console.log(label(Level.High).len());
}
using console from std:Console
