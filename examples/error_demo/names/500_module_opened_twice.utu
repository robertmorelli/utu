// What: two instances of one generic module opened without aliases
// Expect: cell[I32] is open already
mod cell[T] {
    struct Cell:
        | value: T
    fn wrap(value: T) Cell { return Cell { value: value }; }
}
using cell[I32];
using cell[Str];

main { console.log(wrap(4).value); }
using console from std:Console
