// What: a type path names a type the module does not declare (geometry.Pt)
// Expect: Module 'geometry' has no type 'Pt'
mod geometry {
    struct Point:
        | x: F64
        | y: F64
}

fn norm(p: geometry.Pt) F64 {
    return p.x + p.y;
}

main {
    console.log(0);
}
using console from std:console
