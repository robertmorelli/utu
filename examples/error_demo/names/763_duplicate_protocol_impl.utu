// What: one type implements a protocol's method twice
// Expect: Duplicate method P[S].m, at the second
proto P:
    | m(&) I32

struct S[P]:
    | v: I32

fn P[S].m |a| (b: S) I32 { return 1; }
fn P[S].m |a| (b: S) I32 { return 2; }

main {
    console.log(S { v: 0 }.m(S { v: 1 }));
}
using console from std:console
