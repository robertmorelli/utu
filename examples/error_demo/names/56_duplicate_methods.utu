// What: the same method is defined twice on a struct
// Expect: Duplicate method 'Rect.area'
struct Rect:
    | w: I32
    | h: I32

fn Rect.area |r| () I32 { return r.w * r.h; }
fn Rect.area |r| () I32 { return r.h * r.w; }

main {
    console.log(Rect { w: 2, h: 3 }.area());
}
using console from std:console
