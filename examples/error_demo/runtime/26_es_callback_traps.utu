// What: a utu closure passed to JS traps when JS calls it (here, inside Array.map)
// Expect: the trap message, ideally with the utu location of the closure
let map_all: fun(cl(I32) I32) I32 = @es/\ (f) => { let s = 0; for (let i = 0; i < 3; i++) s += f(i); return s; } \/;

export main() I32 {
    map_all(cl(i) { 100 / (i - 1); });
}
