// What: a match reached with a value none of its arms takes
// Expect: Level.from_i32: no variant has this value (safe builds stop there; unsafe ones reach the match: No arm for the value)
enum(U8) Level:
    | Low
    | High

fn label(l: Level) I32 {
    match l { Level.Low => 1, Level.High => 2, };
}

export main() I32 {
    label(Level.from_i32(7));
}
