// What: a match reached with a value none of its arms takes
// Expect: Level: no variant has this value (safe builds stop there; unsafe ones reach the match: No arm for the value)
enum(U8) Level:
    | Low
    | High

fn label(l: Level) I32 {
    match l { Level.Low => 1, Level.High => 2, };
}

main {
    console.log(label(Level(7)));
}
using console from std:Console
