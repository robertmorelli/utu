// What: calls value() on a Result that holds an error: a bug, so it traps.
// Expect: a trap at value(); check is_ok() first, or use value_or()
fn half(n: I32) Result[I32, Str] {
    if n % 2 != 0 { return Result[I32, Str].err("odd"); };
    Result[I32, Str].ok(n / 2);
}

export main() I32 { half(3).value(); }
