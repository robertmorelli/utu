// What: integer division where the divisor comes out zero
// Expect: trap: integer division by zero at 09_div_by_zero.utu:4
fn average(total: I32, count: I32) I32 {
    return total / count;
}

main {
    let items: Array[I32] = [];
    console.log(average(0, items.len()));
}
