// What: a .then callback divides by zero after main has returned
// Expect: trap at 28_then_callback_traps.utu:9 (`10 / v`), placed as main's traps are; exit 1
using console from std:Console;

let delay: fun(I32, I32) Promise[I32] =
    @es/\ (v, ms) => new Promise(r => setTimeout(() => r(v), ms)) \/;

export main() void {
    delay(0, 5).then(cl(v) { console.log(`${10 / v}`); });
    console.log("scheduled");
}
