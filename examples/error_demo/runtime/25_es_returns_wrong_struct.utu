// What: an @es binding declared to return an enum gives back a plain JS object
// Expect: load_shape gets Shape from JS, which cannot make one (a compile error)
enum Shape:
    | Circle { r: F64 }
    | Square { side: F64 }

let load_shape: fun() Shape = @es/\ () => ({ r: 2 }) \/;

export main() F64 {
    alt load_shape() {
        Circle |c| => c.r,
        Square |s| => s.side,
    };
}
