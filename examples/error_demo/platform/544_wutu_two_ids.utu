// What: an element head with two ids
// Expect: an element has one id; #b is a second
using Browser from std:Browser;

struct State:
    | n: I32
    | items: Array[Item]
    | tags: Array[Str]

struct Item:
    | id: I32

export main() void {
    let state = State { n: 0, items: [Item { id: 1 }], tags: ["a"] };
    let app = @wutu/\
    @reactive;
    main { div#a#b { } }
    \/;
    Browser.document.body.append(app);
}
