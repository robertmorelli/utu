// What: an unknown escape in written template text, reported at the string
// Expect: Unknown escape \q
using Browser from std:Browser;

struct State:
    | n: I32
    | items: Array[Item]
    | tags: Array[Str]

struct Item:
    | id: I32

export main() void {
    let state = State { n: 0, items: [Item { id: 1 }], tags: ["a"] };
    let app = @wutu/\
    main { p { "a\q"; } }
    \/;
    Browser.document.body.append(app);
}
