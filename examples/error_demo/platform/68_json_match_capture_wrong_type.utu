// What: a captured Str used where I32 is expected in the arm body
// Expect: Type mismatch: expected I32, got Str (pointing at the arm body inside the @json match)

fn age_of(text: Str) I32 {
    @json/\ match text {
        { age: |age| Str } => age,
        ~> 0,
    }\/;
}

export main() I32 {
    age_of("{}");
}
