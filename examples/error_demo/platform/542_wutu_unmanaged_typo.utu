// What: a misspelled @unmanaged inside an element
// Expect: unknown directive @unmanage; did you mean @unmanaged?
using Browser from std:Browser;

struct State:
    | n: I32
    | items: Array[Item]
    | tags: Array[Str]

struct Item:
    | id: I32

export main() void {
    let state = State { n: 0, items: [Item { id: 1 }], tags: ["a"] };
    let app = @wutu/\
    @reactive;
    main { div { @unmanage; } }
    \/;
    Browser.document.body.append(app);
}
