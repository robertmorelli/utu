// What: a misspelled directive before the root
// Expect: unknown directive @reactiv; did you mean @reactive?
using Browser from std:Browser;

struct State:
    | n: I32
    | items: Array[Item]
    | tags: Array[Str]

struct Item:
    | id: I32

export main() void {
    let state = State { n: 0, items: [Item { id: 1 }], tags: ["a"] };
    let app = @wutu/\
    @reactiv;
    main { p { = state.n; } }
    \/;
    Browser.document.body.append(app);
}
