// What: a loop keyed by a struct
// Expect: A key is text or a number, not Item
using Browser from std:Browser;

struct State:
    | n: I32
    | items: Array[Item]
    | tags: Array[Str]

struct Item:
    | id: I32

export main() void {
    let state = State { n: 0, items: [Item { id: 1 }], tags: ["a"] };
    let app = @wutu/\
    @reactive;
    main { ul { for state.items |it| key it { li { = it.id; } } } }
    \/;
    Browser.document.body.append(app);
}
