// What: decoding a type name that is not declared (typo)
// Expect: @json cannot use Usr: ... (Unknown type Usr)
struct User:
    | name: Str
    | age: I32

fn load(text: Str) ?User {
    return @json/\ decode Usr text \/;
}

main {
    console.log(promote load("{}") { |u| => u.age, ~> 0, });
}
using console from std:Console
