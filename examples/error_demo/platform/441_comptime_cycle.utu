// What: two @comptime mems, each reading the other
// Expect: @comptime t reads u, which waits on it
fn f() Array[I32] { return [u.len()]; }
fn g() Array[I32] { return [t.len()]; }
const mem t: I32 = @comptime/\ f() \/;
const mem u: I32 = @comptime/\ g() \/;

main {
    console.log(t[0] + u[0]);
}
using console from std:Console
