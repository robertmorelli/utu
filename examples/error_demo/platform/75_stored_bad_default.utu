// What: a @stored default with a syntax error
// Expect: Invalid @stored default expression
using Browser from std:Browser;

struct Prefs:
    | name: Str
    | enabled: Bool

export main() void {
    let prefs = @stored/\ Prefs "prefs-v1" Prefs { name: "", enabled: } \/;
    Browser.console.log(prefs.name);
}
