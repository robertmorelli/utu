// What: a @comptime expression whose loop never ends
// Expect: @comptime t trapped: it ran too long (a hundred million loop rounds)
fn f() Array[I32] {
    while (true) { };
    return [1];
}
const mem t: I32 = @comptime/\ f() \/;

main {
    console.log(t.len());
}
using console from std:Console
