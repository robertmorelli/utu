// What: an array of structs that do not implement Component
// Expect: Item is not a Component
using Browser from std:Browser;

struct State:
    | n: I32
    | items: Array[Item]
    | tags: Array[Str]

struct Item:
    | id: I32

main {
    let state = State { n: 0, items: [Item { id: 1 }], tags: ["a"] };
    let app = @wutu/\
    @reactive
    main { p { = state.items } }
    \/;
    Browser.document.body.append(app);
}
