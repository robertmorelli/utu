// What: a text hole showing an array
// Expect: A hole shows text, a number, a Bool or a node, not Array[Str]
using Browser from std:Browser;

struct State:
    | n: I32
    | items: Array[Item]
    | tags: Array[Str]

struct Item:
    | id: I32

export main() void {
    let state = State { n: 0, items: [Item { id: 1 }], tags: ["a"] };
    let app = @wutu/\
    @reactive;
    main { p { = state.tags; } }
    \/;
    Browser.document.body.append(app);
}
