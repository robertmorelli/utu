// What: an Emmet-style class-only head (.card) expecting a div
// Expect: expected an HTML tag (class-only heads do not create elements); write div.card
using Browser from std:Browser;

fn view(title: Str, items: Array[Str]) Browser.HTMLElement {
    @wutu/\
    section {
        .card { h2 { = title; } }
    }
    \/;
}

export main() void {
    Browser.document.body.append(view("Plants", ["fern", "ivy"]));
}
