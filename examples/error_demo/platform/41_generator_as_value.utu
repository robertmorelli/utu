// What: binding a generator function to a local as a value
// Expect: count is a generator: consume it with `for (count(…)) |value| { … }` (at line 8, not at the generator)
gn count(n: I32) I32 {
    for (0 ..< n) |i| { yield i; };
}

main {
    let g = count;
    console.log(0);
}
