// What: decode with a type but no text expression
// Expect: @json decode needs a text expression after the type
struct User:
    | name: Str
    | age: I32

fn load(text: Str) ?User {
    return @json/\ decode User \/;
}

main {
    console.log(promote load("{}") { |u| => u.age, ~> 0, });
}
using console from std:Console
