// What: bind:values on an input, not a multiple select
// Expect: bind:values is a multiple select's
using Browser from std:Browser;

struct State:
    | n: I32
    | items: Array[Item]
    | tags: Array[Str]

struct Item:
    | id: I32

export main() void {
    let state = State { n: 0, items: [Item { id: 1 }], tags: ["a"] };
    let app = @wutu/\
    @reactive;
    main { input { bind:values = state.tags; } }
    \/;
    Browser.document.body.append(app);
}
