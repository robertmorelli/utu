// What: two CSS declarations on one line, without ; between them
// Expect: two CSS declarations on one line need ; between them (after padding: 1rem)
using Browser from std:Browser

fn view(title: Str, items: Array[Str]) Browser.HTMLElement {
    @wutu/\
    section {
        padding: 1rem gap: 2rem
        h2 { = title }
    }
    \/
}

main {
    Browser.document.body.append(view("Plants", ["fern", "ivy"]))
}
