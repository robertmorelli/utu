// What: a global's initializer calls a function that awaits.
// Expect: A global's initializer cannot await
let fetch_n: fun(I32) Promise[I32] = @es/\ (v) => Promise.resolve(v) \/;
let later: I32 = helper();

fn helper() I32 {
    return await fetch_n(3);
}

main {
    console.log(later);
}
using console from std:Console
