// What: a text fragment returned with a single-element annotation
// Expect: Expected Browser.HTMLElement, got Browser.DocumentFragment
using Browser from std:Browser;

fn view(title: Str, items: Array[Str]) Browser.HTMLElement {
    return @wutu/\
    "Just text"
    \/;
}

main {
    Browser.document.body.append(view("Plants", ["fern", "ivy"]));
}
