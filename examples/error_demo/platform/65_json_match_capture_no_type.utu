// What: a capture in a @json pattern without its type
// Expect: Expected a type for capture name

fn name_of(text: Str) Str {
    return @json/\ match text {
        { user: { name: |name| } } => name,
        ~> "",
    }\/;
}

main {
    console.log(name_of("{}").len());
}
using console from std:console
