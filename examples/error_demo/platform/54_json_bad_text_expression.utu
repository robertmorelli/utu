// What: a @json text expression with a syntax error
// Expect: Invalid text expression (pointing at it)
struct User:
    | name: Str
    | age: I32

fn load(parts: Array[Str]) ?User {
    @json/\ decode User parts[0] + \/;
}

main {
    console.log(promote load(["{}"]) { |u| => u.age, ~> 0, });
}
using console from std:Console
