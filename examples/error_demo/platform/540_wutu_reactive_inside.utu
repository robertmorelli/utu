// What: @reactive written inside an element, not before the root
// Expect: @reactive goes first in the template, before its root element
using Browser from std:Browser;

struct State:
    | n: I32
    | items: Array[Item]
    | tags: Array[Str]

struct Item:
    | id: I32

export main() void {
    let state = State { n: 0, items: [Item { id: 1 }], tags: ["a"] };
    let app = @wutu/\
    main { @reactive; p { = state.n; } }
    \/;
    Browser.document.body.append(app);
}
