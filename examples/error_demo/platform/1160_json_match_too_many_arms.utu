// What: an @json match with more than 64 pattern arms
// Expect: @json match supports at most 64 pattern arms
export lib {
    fn pick(text: Str) I32 {
        @json/\ match text {
            { a0: 1 } => 0,
            { a1: 1 } => 1,
            { a2: 1 } => 2,
            { a3: 1 } => 3,
            { a4: 1 } => 4,
            { a5: 1 } => 5,
            { a6: 1 } => 6,
            { a7: 1 } => 7,
            { a8: 1 } => 8,
            { a9: 1 } => 9,
            { a10: 1 } => 10,
            { a11: 1 } => 11,
            { a12: 1 } => 12,
            { a13: 1 } => 13,
            { a14: 1 } => 14,
            { a15: 1 } => 15,
            { a16: 1 } => 16,
            { a17: 1 } => 17,
            { a18: 1 } => 18,
            { a19: 1 } => 19,
            { a20: 1 } => 20,
            { a21: 1 } => 21,
            { a22: 1 } => 22,
            { a23: 1 } => 23,
            { a24: 1 } => 24,
            { a25: 1 } => 25,
            { a26: 1 } => 26,
            { a27: 1 } => 27,
            { a28: 1 } => 28,
            { a29: 1 } => 29,
            { a30: 1 } => 30,
            { a31: 1 } => 31,
            { a32: 1 } => 32,
            { a33: 1 } => 33,
            { a34: 1 } => 34,
            { a35: 1 } => 35,
            { a36: 1 } => 36,
            { a37: 1 } => 37,
            { a38: 1 } => 38,
            { a39: 1 } => 39,
            { a40: 1 } => 40,
            { a41: 1 } => 41,
            { a42: 1 } => 42,
            { a43: 1 } => 43,
            { a44: 1 } => 44,
            { a45: 1 } => 45,
            { a46: 1 } => 46,
            { a47: 1 } => 47,
            { a48: 1 } => 48,
            { a49: 1 } => 49,
            { a50: 1 } => 50,
            { a51: 1 } => 51,
            { a52: 1 } => 52,
            { a53: 1 } => 53,
            { a54: 1 } => 54,
            { a55: 1 } => 55,
            { a56: 1 } => 56,
            { a57: 1 } => 57,
            { a58: 1 } => 58,
            { a59: 1 } => 59,
            { a60: 1 } => 60,
            { a61: 1 } => 61,
            { a62: 1 } => 62,
            { a63: 1 } => 63,
            { a64: 1 } => 64,
            ~> 99,
        } \/;
    }
}
