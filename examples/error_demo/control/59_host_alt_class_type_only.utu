// What: narrows a host value to an interface that has no runtime class (ParentNode is a mixin).
// Expect: Browser.ParentNode is only a type; narrowing needs a declared runtime class
using Browser from std:Browser;

export main() void {
    let doc = Browser.document;
    doc.addEventListener("click", cl(e) void {
        alt e.target {
            Browser.ParentNode |p| => Browser.console.log(p.childElementCount),
            ~> {},
        };
    });
}
