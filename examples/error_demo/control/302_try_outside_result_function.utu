// What: uses try in a function that returns I32, so there is no error to return.
// Expect: try in a function returning I32, not a Result
fn half(n: I32) Result[I32, Str] {
    if n % 2 != 0 { return Result[I32, Str].err("odd"); };
    Result[I32, Str].ok(n / 2);
}

fn quarter(n: I32) I32 {
    let h = try half(n);
    h / 2;
}

export main() I32 { quarter(8); }
