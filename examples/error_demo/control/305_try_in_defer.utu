// What: uses try inside deferred code, which must not leave its block.
// Expect: try in defer
fn flush() Result[I32, Str] { return Result[I32, Str].ok(0); }

fn save() Result[I32, Str] {
    defer { try flush(); };
    return Result[I32, Str].ok(1);
}

main { console.log(save().value()); }
using console from std:console
