// What: writes continue with a value in an ordinary for loop.
// Expect: continue with a state only works inside loop match
fn total(xs: Array[I32]) I32 {
    let t = 0;
    for (xs) |x| {
        if x < 0 { continue 0; };
        t += x;
    };
    t;
}

export main() I32 {
    total([1, -2, 3]);
}
