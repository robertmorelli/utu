// What: uses alt on a struct value as if it were an enum.
// Expect: alt needs an enum value, got Point (a struct)
struct Point:
    | x: F64
    | y: F64

fn kind(p: Point) Str {
    return alt p {
        Point |q| => "point",
        ~> "other",
    };
}

main {
    console.log(kind(Point { x: 0.0, y: 0.0 }));
}
using console from std:console
