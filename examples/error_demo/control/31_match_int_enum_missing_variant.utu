// What: matches an integer enum and forgets one level.
// Expect: Missing variant 'High' in match over Level
enum(U8) Level:
    | Low
    | Mid
    | High

fn label(l: Level) Str {
    return match l { Level.Low => "calm", Level.Mid => "busy", };
}

main {
    console.log(label(Level.High));
}
using console from std:console
