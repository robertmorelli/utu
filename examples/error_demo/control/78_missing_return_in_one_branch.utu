// What: an if/else where only the then-branch yields the I32 and the else-branch is a statement.
// Expect: the else branch has no value; sign must give I32 on every path
using console from std:Console;

fn sign(x: I32) I32 {
    if x >= 0 { 1; } else { console.log("negative"); };
}

export main() I32 {
    sign(-1);
}
