// What: promote's present arm and default arm give different types.
// Expect: promote arms disagree: |n| arm is Str, default is I32
fn initial(name: ?Str) Str {
    return promote name {
        |n| => n.slice(0, 1),
        ~> 0,
    };
}

main {
    console.log(initial(null));
}
using console from std:console
