// What: fills a non-nullable struct field with null.
// Expect: Field 'owner' of Pet is User, not ?User; null cannot be stored there
struct User:
    | name: Str

struct Pet:
    | name: Str
    | owner: User

main {
    let p = Pet { name: "Rex", owner: null };
    console.log(0);
}
using console from std:Console
