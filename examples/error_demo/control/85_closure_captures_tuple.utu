// What: a closure captures a name holding a function's tuple result.
// Expect: pair would hold tuple .{I32, I32}: name its values with let .{…}
fn swap(a: I32, b: I32) .{I32, I32} { .{b, a}; }

export main() I32 {
    let pair = swap(3, 4);
    let first = cl() I32 { let .{a, b} = pair; a; };
    first();
}
