// What: assigns to a field through a nullable reference.
// Expect: Cannot write field 'count' of ?Counter: it may be null
struct Counter:
    | count: I32

fn reset(c: ?Counter) Void {
    c.count = 0;
}

main {
    let c = Counter { count: 5 };
    reset(c);
    console.log(c.count);
}
using console from std:Console
