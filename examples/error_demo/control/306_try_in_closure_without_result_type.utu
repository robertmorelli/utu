// What: uses try in a closure that does not say it returns a Result.
// Expect: try needs a function returning a Result (declare the closure's Result type)
fn half(n: I32) Result[I32, Str] {
    if n % 2 != 0 { return Result[I32, Str].err("odd"); };
    Result[I32, Str].ok(n / 2);
}

export main() I32 {
    let quarter = cl(n: I32) { try half(n); };
    0;
}
