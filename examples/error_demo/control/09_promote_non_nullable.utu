// What: uses promote on a value that is never null.
// Expect: promote needs a nullable value; name is Str, which is never null
fn initial(name: Str) Str {
    return promote name {
        |n| => n.slice(0, 1),
        ~> "?",
    };
}

main {
    console.log(initial("Ada"));
}
using console from std:Console
