// What: an alt over an enum forgets one of its variants and has no default.
// Expect: Missing variant 'Dot' in alt over enum Shape
enum Shape:
    | Circle { r: F64 }
    | Rect { w: F64, h: F64 }
    | Dot {}

fn area(shape: Shape) F64 {
    alt shape {
        Circle |c| => 3.0 * c.r * c.r,
        Rect |r| => r.w * r.h,
    };
}

export main() F64 {
    area(Dot {});
}
