// What: yield in a function declared with a normal return type
// Expect: yield can only appear in a generator: declare the function with `yield I32` as its return type
fn evens(n: I32) I32 {
    for (0 ..< n) |i| { if i % 2 == 0 { yield i; }; };
    return 0;
}

main {
    console.log(evens(10));
}
using console from std:console
