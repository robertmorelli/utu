// What: for over a struct instead of its array field
// Expect: for can only iterate an array, got Inbox; did you mean inbox.messages?
struct Inbox:
    | messages: Array[Str]

export main() I32 {
    let inbox = Inbox { messages: ["hi", "yo"] };
    let n = 0;
    for (inbox) |m| { n += m.len(); };
    n;
}
