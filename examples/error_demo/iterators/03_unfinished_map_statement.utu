// What: a map used for its side effects as a statement (each was meant)
// Expect: map pipeline is unfinished; to run a body for its effects use each
let log: fun(I32) Void = @es/\ (n) => console.log(n) \/;

main {
    let xs = [1, 2, 3];
    xs map |n| { log(n); };
    console.log(0);
}
using console from std:Console
