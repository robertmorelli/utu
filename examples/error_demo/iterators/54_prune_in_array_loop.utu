// What: prune used in an ordinary for over an array, as a "skip"
// Expect: prune skips a subtree of a recursive generator; in a plain loop use continue
main {
    let total = 0;
    for ([1, -2, 3]) |x| {
        if x < 0 { prune; };
        total += x;
    };
    console.log(total);
}
using console from std:Console
