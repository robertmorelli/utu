// What: await for over a generator, binding a value and an index
// Expect: a generator loop binds one value: await for (ticks()) |t| { … }
fn ticks(n: I32) yield I32 {
    for (0 ..< n) |i| { yield i; };
}

export main() I32 {
    let total = 0;
    await for (ticks(3)) |t, i| { total += t; };
    total;
}
