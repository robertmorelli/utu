// What: a generator returns a value to stop early
// Expect: a generator ends with `return;`, without a value
gn upto(limit: I32) I32 {
    for (0 ..< 100) |i| {
        if i == limit { return i; };
        yield i;
    };
}

main {
    let total = 0;
    for (upto(3)) |v| { total += v; };
    console.log(total);
}
using console from std:Console
