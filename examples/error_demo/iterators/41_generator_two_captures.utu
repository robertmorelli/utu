// What: a generator loop binding a value and an index
// Expect: a generator loop binds one value: for (gen()) |value| { … }
gn squares(n: I32) I32 {
    for (0 ..< n) |i| { yield i * i; };
}

main {
    let total = 0;
    for (squares(4)) |s, i| { total += s; };
    console.log(total);
}
using console from std:Console
