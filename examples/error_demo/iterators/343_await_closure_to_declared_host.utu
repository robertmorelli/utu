// What: a closure that awaits, given to a declared host function (setTimeout)
// Expect: a closure the host calls cannot await: the timer calls it from the event loop, with no utu stack to suspend
using Browser from std:Browser;

let later: fun(I32) Promise[I32] = @es/\ (v) => Promise.resolve(v) \/;

export main() void {
    Browser.setTimeout(cl() void { let v: I32 = await later(1); }, 0.0);
}
