// What: awaiting a Promise[Str] into an I32 binding
// Expect: Type mismatch: expected I32, got Str (the awaited value of Promise[Str])
let fetch_name: fun() Promise[Str] = @es/\ () => Promise.resolve("ada") \/;

main {
    let n: I32 = await fetch_name();
    console.log(n);
}
using console from std:console
