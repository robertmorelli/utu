// What: a generator called inside a map body, as if it returned an array
// Expect: squares is a generator: consume it with for, not as a value
gn squares(n: I32) I32 {
    for (0 ..< n) |i| { yield i * i; };
}

main {
    console.log([1, 2, 3] flat_map |n| { squares(n); } sum);
}
using console from std:Console
