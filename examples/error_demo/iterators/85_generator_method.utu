// What: a method declared as a generator
// Expect: accepted (a method may be a generator: for (bag.each()) |v| { … })
mod Bag {
    struct &:
        | items: Array[I32]
    fn &.new(xs: Array[I32]) & { &{ items: xs }; }
    gn &.each_item |b| () I32 { for (b.items) |v| { yield v; }; }
}

main {
    let b = Bag.new([1, 2, 3]);
    let total = 0;
    for (b.each_item()) |v| { total += v; };
    console.log(total);
}
using console from std:Console
