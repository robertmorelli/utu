// What: an await for loop inside a closure
// Expect: a closure cannot await: await for suspends, and a closure is called through the host
let record: fun(I32) void = @es/\ (v) => { globalThis.__v = v; } \/;

export main() I32 {
    let run = cl() {
        await for (Stream[I32].of([1, 2])) |v| { record(v); };
    };
    run();
    0;
}
