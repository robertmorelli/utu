// What: a hand-written iterable whose next returns its result directly, not a promise
// Expect: await for needs next to return a Promise, but Counter.next returns I32
mod Counter {
    struct &:
        | n: I32
    fn &.new(n: I32) & { return &{ n: n }; }
    fn &.iterator |self| () I32 { return 0; }
    fn &.next |self| (it: I32) I32 { return it + 1; }
    fn &.done |self| (r: I32) Bool { return r > self.n; }
    fn &.value |self| (r: I32) I32 { return r; }
    fn &.close |self| (it: I32) Void { }
}

main {
    let total = 0;
    await for (Counter.new(3)) |v| { total += v; };
    console.log(total);
}
using console from std:Console
