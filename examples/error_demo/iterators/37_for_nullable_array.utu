// What: for over a nullable array without unwrapping it
// Expect: for over ?Array[I32], which may be null; unwrap it with orelse or promote
fn lookup() ?Array[I32] { return [1, 2]; }

main {
    let total = 0;
    for (lookup()) |x| { total += x; };
    console.log(total);
}
using console from std:console
