// What: a generator method called like a function instead of read by a for
// Expect: each is a generator: for (each(…)) |v| { … }
mod Bag {
    struct &:
        | n: I32
    fn &.new() & { &{ n: 3 }; }
    gn &.each |b| () I32 {
        for (0 ..< b.n) |i| { yield i; };
    }
}

main {
    let bag = Bag.new();
    bag.each();
    console.log(0);
}
using console from std:Console
