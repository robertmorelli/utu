// What: collect followed by another pipeline stage without parentheses
// Expect: collect(I32) ends a pipeline; parenthesize it to start another
main {
    let xs = [3, 1, 2];
    let sorted = xs map |n| { n * 10; } collect(I32) sort(I32) |a, b| { a < b; };
    console.log(sorted[0]);
}
using console from std:console
