// What: a generator called like a function returning an array
// Expect: squares is a generator: consume it with `for (squares(…)) |value| { … }`
gn squares(n: I32) I32 {
    for (0 ..< n) |i| { yield i * i; };
}

main {
    let xs = squares(4);
    console.log(xs.len());
}
using console from std:Console
