// What: a generator whose body yields from a pipeline that is never finished
// Expect: map pipeline is unfinished: end it with each |v| { yield v; }
fn doubled(xs: Array[I32]) yield I32 {
    xs map |x| { yield x * 2; };
}

export main() I32 {
    let total = 0;
    for (doubled([1, 2])) |v| { total += v; };
    total;
}
