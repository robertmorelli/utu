// What: each body treated like a fold with two value bindings plus an index
// Expect: each binds one value and an optional index; got 3 names
let log: fun(I32) Void = @es/\ (n) => console.log(n) \/;

main {
    [1, 2, 3] each |a, b, i| { log(a); };
    console.log(0);
}
using console from std:console
