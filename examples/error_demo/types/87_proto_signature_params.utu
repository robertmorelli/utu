// What: implementing a protocol method with an extra parameter
// Expect: Implementation 'Shape[Square].area' does not match: protocol takes (), implementation takes (F64)
proto Shape:
    | area() F64

struct Square[Shape]:
    | side: F64

fn Shape[Square].area |s| (scale: F64) F64 { return s.side * s.side * scale; }

main { console.log(0); }
using console from std:Console
