// What: a setter written through a protocol value, one implementer lacking its field (it crashed the compiler)
// Expect: NoField lacks Counter.count
proto Counter:
    | get set count : I32

struct Has[Counter]:
    | count: I32

struct NoField[Counter]:
    | n: I32

export main() I32 {
    let c: Counter = NoField { n: 1 };
    c.count = 5;
    c.count += 1;
    0;
}
