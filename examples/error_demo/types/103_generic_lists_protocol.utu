// What: a generic struct lists a protocol (dispatch tests one type per declaration)
// Expect: A generic type cannot list protocol Sh
proto Sh:
    | name() I32

mod Box[T] {
    struct &[Sh]:
        | v: T
}

fn Sh[Box[I32]].name |b| () I32 { return 1; }

main { console.log(0); }
using console from std:console
