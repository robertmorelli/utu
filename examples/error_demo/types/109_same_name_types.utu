// What: a module's struct S where the file's own S is wanted
// Expect: Expected S, got a.S (the two are told apart by their module)
mod a {
    struct S:
        | x: I32
    fn mk() S { S { x: 1 }; }
}

struct S:
    | x: I32

main {
    let s: S = a.mk();
    console.log(s.x);
}
using console from std:Console
