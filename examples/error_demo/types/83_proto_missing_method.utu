// What: a struct declares a protocol but never implements its method
// Expect: Square does not implement protocol method 'Shape.area'
proto Shape:
    | area() F64

struct Square[Shape]:
    | side: F64

fn total(s: Shape) F64 { return s.area(); }

main { console.log(total(Square { side: 2.0 }).i32()); }
using console from std:console
