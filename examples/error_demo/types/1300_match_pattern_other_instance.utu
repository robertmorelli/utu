// What: a match on a cell[I32].K with the variants of cell[Str].K
// Expect: Expected cell[I32].K, got cell[Str].K
mod cell[T] {
    enum(U8) K: | A | B
    fn k(t: T) K { return K.B; }
}
using cell[I32] |a|;
using cell[Str] |b|;
main { let x = a.k(1); let r = match x { b.K.A => 1, b.K.B => 2, } }
