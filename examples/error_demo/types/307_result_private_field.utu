// What: reads a Result's field directly instead of value() or value_or().
// Expect: Result has no field _value (Result's fields are std's own)
fn half(n: I32) Result[I32, Str] {
    if n % 2 != 0 { return Result[I32, Str].err("odd"); };
    return Result[I32, Str].ok(n / 2);
}

main { console.log(half(8)._value); }
using console from std:console
