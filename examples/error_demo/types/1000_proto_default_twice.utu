// What: a protocol's own function declared twice
// Expect: Duplicate method P.dflt
proto P:
    | n() I32

struct A[P]:
    | x: I32

fn P[A].n |a| () I32 { a.x; }
fn P.dflt |p| () I32 { p.n(); }
fn P.dflt |p| () I32 { 99; }

main {
    let p: P = A { x: 1 };
    console.log(p.dflt());
}
using console from std:Console
