// What: passing a struct that does not implement the protocol where the protocol is expected
// Expect: Type mismatch: expected Shape, got Label (Label does not implement Shape)
proto Shape:
    | area() F64

struct Circle[Shape]:
    | r: F64

struct Label:
    | text: Str

fn Shape[Circle].area |c| () F64 { return 3.0 * c.r * c.r; }

fn total(s: Shape) F64 { return s.area(); }

main { console.log(total(Label { text: "x" }).i32()); }
using console from std:console
