// What: a function's last expression is a Str but the result type is Bool
// Expect: Type mismatch: expected Bool, got Str at the tail expression
fn is_empty(s: Str) Bool {
    return if s.len() == 0 { "yes"; } else { "no"; };
}

main { console.log(if is_empty("") { 1; } else { 0; }); }
using console from std:console
