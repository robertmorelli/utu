// What: a struct declares a protocol whose getter field it lacks
// Expect: Square does not implement protocol getter 'Shape.name'
proto Shape:
    | get name : Str
    | area() F64

struct Square[Shape]:
    | side: F64

fn Shape[Square].area |s| () F64 { return s.side * s.side; }

main { console.log(0); }
using console from std:console
