// What: two instances of one generic mod are told apart by their type arguments.
// Expect: f takes cell[I32].Cell, got cell[Str].Cell
mod cell[T] { struct Cell: | value : T  fn wrap(value: T) Cell { return Cell { value: value }; } }
using cell[I32] |a|; using cell[Str] |b|;
fn f(x: a.Cell) I32 { return x.value; }
main { console.log(f(b.wrap("a"))); }
using console from std:console
