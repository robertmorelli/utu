// What: passing a value of one enum where another enum is expected
// Expect: Type mismatch: expected Color, got Size
enum(U8) Color:
    | Red
    | Green

enum(U8) Size:
    | Small
    | Large

fn paint(c: Color) I32 { return c.i32(); }

main { console.log(paint(Size.Small)); }
using console from std:Console
