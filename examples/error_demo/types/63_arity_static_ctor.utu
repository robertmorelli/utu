// What: calling a static constructor function with too few arguments
// Expect: Wrong arity: Point.new expects 2 arguments, got 1
struct Point:
    | x: F64
    | y: F64

fn Point.new(x: F64, y: F64) Point { return Point { x: x, y: y }; }

main {
    let p = Point.new(1.0);
    console.log(p.x.i32());
}
using console from std:Console
