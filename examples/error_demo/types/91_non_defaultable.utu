// What: Array.new_default for a struct element type, which has no zero value
// Expect: Array element type 'Point' has no default value; use Array[Point].new(length, fill)
struct Point:
    | x: F64
    | y: F64

main {
    let ps = Array[Point].new_default(4);
    console.log(ps.len());
}
