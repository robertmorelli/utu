// What: match over a Str with string patterns (like a switch in JS)
// Expect: match needs an integer, float, or Bool value, got Str; use if/else (not a bare syntax error)
fn code(cmd: Str) I32 {
    match cmd {
        "start" => 1,
        ~> 0,
    };
}

main { console.log(code("start")); }
using console from std:Console
