// What: instantiating a one-parameter generic module with two type arguments
// Expect: Module 'Box' expects 1 type argument(s), got 2
mod Box[T] {
    struct &:
        | value: T
    fn &.new(v: T) & { return &{ value: v }; }
}

main {
    let b = Box[I32, Str].new(1);
    console.log(b.value);
}
using console from std:console
