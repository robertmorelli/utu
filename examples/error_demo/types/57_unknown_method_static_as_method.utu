// What: calling a static function (no receiver) as a method
// Expect: Unknown method 'Rect.square': it is a function of Rect; call Rect.square(value)
struct Rect:
    | w: F64

fn Rect.square(side: F64) Rect { return Rect { w: side }; }

main {
    let r = Rect { w: 1.0 };
    let s = r.square(2.0);
    console.log(s.w.i32());
}
using console from std:Console
