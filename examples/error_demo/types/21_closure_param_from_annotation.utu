// What: a closure written with an F64 parameter where cl(I32) I32 is expected
// Expect: Type mismatch: expected cl(I32) I32, got cl(F64) I32
fn apply(f: cl(I32) I32, x: I32) I32 { return f(x); }

main {
    console.log(apply(cl(x: F64) I32 { return x.i32(); }, 3));
}
using console from std:console
