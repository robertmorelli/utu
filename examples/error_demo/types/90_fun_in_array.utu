// What: an array of fun values
// Expect: fun(I32) I32 cannot be stored in an array yet; use cl(I32) I32 instead
fn double(x: I32) I32 { return x * 2; }
fn square(x: I32) I32 { return x * x; }

main {
    let ops: Array[fun(I32) I32] = [double, square];
    console.log(ops.len());
}
using console from std:Console
