// What: calling a two-parameter function with one argument
// Expect: Wrong arity: clamp expects 3 arguments, got 2
fn clamp(x: I32, low: I32, high: I32) I32 {
    if x < low { return low; };
    if x > high { return high; };
    return x;
}

main { console.log(clamp(5, 0)); }
using console from std:Console
