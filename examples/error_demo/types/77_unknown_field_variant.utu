// What: reading a field from an alt-bound variant that it does not have
// Expect: Unknown field 'radius' for Circle
enum Shape:
    | Circle { r: F64 }
    | Dot {}

fn size(s: Shape) F64 {
    return alt s {
        Circle |c| => c.radius,
        Dot => 0.0,
    };
}

main { console.log(size(Dot {}).i32()); }
using console from std:Console
