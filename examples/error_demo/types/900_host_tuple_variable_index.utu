// What: a variable index into a host tuple whose elements differ in type (`corner(): [number, string]`).
// Expect: the tuple takes a constant index, each giving its own element's type.
using Shapes from "./bindings/Shapes.abi.json";

fn at(i: I32) F64 {
    let c = Shapes.corner();
    return c[i];
}

main { at(0) }
