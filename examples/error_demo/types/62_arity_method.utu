// What: calling a method with an extra argument
// Expect: Wrong arity: Rect.area expects 0 arguments, got 1
struct Rect:
    | w: F64
    | h: F64

fn Rect.area |r| () F64 { return r.w * r.h; }

main {
    let r = Rect { w: 2.0, h: 3.0 };
    console.log(r.area(2.0).i32());
}
using console from std:Console
