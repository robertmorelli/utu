//! The host's console: `using console from std:Console;`, then
//! `console.log("hello")`, `console.log(42)`, `console.log(p)`: any value
//! with a `str()` (a Str is itself), written as its str. Nothing out; each
//! function ships only when used.

mod console {
    let host_log: fun(Str) void = @es/\ (s) => console.log(s) \/;
    let host_warn: fun(Str) void = @es/\ (s) => console.warn(s) \/;
    let host_error: fun(Str) void = @es/\ (s) => console.error(s) \/;

    /// A line on standard output (`console.log`): `x.str()`.
    fn log(x: $T) void { host_log(x.str()); }

    /// A line on standard error, as a warning (`console.warn`): `x.str()`.
    fn warn(x: $T) void { host_warn(x.str()); }

    /// A line on standard error (`console.error`): `x.str()`.
    fn error(x: $T) void { host_error(x.str()); }
}
