// Explicit JS-value operations for types/arity UTU cannot express statically.
// Every reference is the actual host value, never a WasmGC stand-in.
mod JS {
    let global: fun(Str) Externref = @es/\ name => globalThis[name] \/;
    let bigint: fun(Str) Externref = @es/\ value => BigInt(value) \/;
    let symbol: fun(Str) Externref = @es/\ value => Symbol(value) \/;
    // One real JS function, created once and reusable for identity-sensitive APIs.
    // The closure receives the exact receiver and a host array of every argument.
    let function_value: fun(cl(Externref, Externref) Externref) Externref = @es/\ invoke => function(...args) { return invoke(this, args); } \/;
    let is_undefined: fun(Externref) Bool = @es/\ value => value === undefined ? 1 : 0 \/;

    let object: fun() Externref = @es/\ () => ({}) \/;
    let array: fun() Externref = @es/\ () => [] \/;
    let undefined_value: fun() Externref = @es/\ () => undefined \/;
    let null_value: fun() Externref = @es/\ () => null \/;
    let string: fun(Str) Externref = @es/\ value => value \/;
    let number: fun(F64) Externref = @es/\ value => value \/;
    let boolean: fun(Bool) Externref = @es/\ value => !!value \/;
    let event_listener: fun(cl(Externref) void) Externref = @es/\ value => value \/;
    let as_string: fun(Externref) Str = @es/\ value => { if (typeof value !== 'string') throw new TypeError('expected string'); return value; } \/;
    let as_number: fun(Externref) F64 = @es/\ value => { if (typeof value !== 'number') throw new TypeError('expected number'); return value; } \/;
    let as_boolean: fun(Externref) Bool = @es/\ value => { if (typeof value !== 'boolean') throw new TypeError('expected boolean'); return value ? 1 : 0; } \/;
    let is_nullish: fun(Externref) Bool = @es/\ value => value == null ? 1 : 0 \/;
    let get: fun(Externref, Str) Externref = @es/\ (object, key) => object[key] \/;
    let set: fun(Externref, Str, Externref) void = @es/\ (object, key, value) => { object[key] = value; } \/;
    let push: fun(Externref, Externref) void = @es/\ (array, value) => { array.push(value); } \/;
    let at: fun(Externref, F64) Externref = @es/\ (array, index) => array[index] \/;
    let length: fun(Externref) F64 = @es/\ value => value.length \/;
    let same: fun(Externref, Externref) Bool = @es/\ (a, b) => Object.is(a, b) ? 1 : 0 \/;
    let call: fun(Externref, Externref, Externref) Externref = @es/\ (fn, receiver, args) => Reflect.apply(fn, receiver, args) \/;
    let construct: fun(Externref, Externref) Externref = @es/\ (ctor, args) => Reflect.construct(ctor, args) \/;
    let symbol_iterator: fun() Externref = @es/\ () => Symbol.iterator \/;
    let get_key: fun(Externref, Externref) Externref = @es/\ (object, key) => object[key] \/;
}
