//! = Mems
//!
//! `mem name: U8;` is a resizable array of scalars, its own linear memory:
//! element i is at byte `i << shift`, so a read is one load with no base
//! pointer. Its capacity is whole 64 KiB pages, grown by doubling (or to what
//! is needed when that is more). A module has at most `max_memories` memories,
//! so a program at most that many mems.
//!
//! `vec name: U8;` is the same array as a WasmGC array in a global: as many
//! as a program likes, but the host cannot see one (no export, `copy_in`, or
//! view). Element i is array[i]; its capacity is the array's length, which
//! starts at its initial contents' count and grows to the larger of what is
//! needed and twice what it was. Wasm checks each access against that.
//!
//! Either way its length is a mutable global, and push, reserve, and resize
//! are small functions of their own, made when first used.

/// By declaration: its memory, or -1 until used.
vec mem_memory: I32;
/// By declaration: its length global.
vec mem_len: I32;
/// By declaration: its reserve function (push and resize follow), or -1.
vec mem_helpers: I32;
/// By declaration: 1 when the host makes its memory (it uses `copy_in` or view), 0 not, -1 unknown.
vec mem_hosted: I32;
/// By declaration: its `copy_in` import (view follows), or -1.
vec mem_host_ops: I32;
/// By declaration: the global holding its array (a mem only the module reaches), or -1.
vec mem_array: I32;
/// By declaration: 1 for a memory, 2 for an array; 0 until planned.
vec mem_planned: I32;
/// Mems with initial contents in arrays: (declaration, data segment, count) triples.
vec mem_array_init: I32;

/// Each declaration's mem rows, sized to the program and unset.
fn reset_mems() void {
    mem_method_word.clear();
    mem_memory.resize(decl_kind.len());
    mem_len.resize(decl_kind.len());
    mem_helpers.resize(decl_kind.len());
    mem_hosted.resize(decl_kind.len());
    mem_host_ops.resize(decl_kind.len());
    mem_array.resize(decl_kind.len());
    mem_planned.resize(decl_kind.len());
    mem_array_init.clear();
    for (0 ..< decl_kind.len()) |d| {
        mem_array[d] = -1;
        mem_planned[d] = 0;
        mem_memory[d] = -1;
        mem_len[d] = -1;
        mem_helpers[d] = -1;
        mem_hosted[d] = -1;
        mem_host_ops[d] = -1;
    };
}

/// What a mem stores: one of the storage kinds, by its shift (log2 of the
/// element size), whether narrow reads sign-extend, and the type values
/// read as.
enum(U8) Storage:
    | U8
    | I8
    | U16
    | I16
    | I32
    | U32
    | I64
    | U64
    | F32
    | F64

/// The storage of mem `decl`, from its element type.
fn mem_storage(decl: I32) Storage {
    let elem = next_sibling(first_child(decl_node[decl]));
    storage_of_word(word_of(elem), node_decl[elem]);
}

/// The storage of an element type written `word`, naming `decl`: the narrow
/// kinds are the words just after the keywords; an int enum is its
/// representation; a distinct type, what it wraps.
fn storage_of_word(word: I32, decl: I32) Storage {
    if word == Kw.count() { return Storage.U8; };
    if word == Kw.count() + 1 { return Storage.I8; };
    if word == Kw.count() + 2 { return Storage.U16; };
    if word == Kw.count() + 3 { return Storage.I16; };
    if decl_is(decl, Decl.IntEnum) {
        let repr_node = after_qualifier(decl_node[decl]);
        return storage_of_word(word_of(repr_node), node_decl[repr_node]);
    };
    let t = decl_type(decl, 0);
    if decl_is(decl, Decl.Distinct) { t = decl_type(node_decl[last_child(decl_node[decl])], 0); };
    if t == prelude(Prelude.U32) { return Storage.U32; };
    if t == prelude(Prelude.I64) { return Storage.I64; };
    if t == prelude(Prelude.U64) { return Storage.U64; };
    if t == prelude(Prelude.F32) { return Storage.F32; };
    if t == prelude(Prelude.F64) { return Storage.F64; };
    Storage.I32;
}

/// Whether a mem's element type is one a mem holds.
fn mem_kind_ok(decl: I32) Bool {
    let elem = next_sibling(first_child(decl_node[decl]));
    let word = word_of(elem);
    if builtin_type(word) { return true; };
    let d = node_decl[elem];
    if decl_is(d, Decl.IntEnum) or decl_is(d, Decl.Distinct) { return true; };
    let t = decl_type(d, 0);
    t == prelude(Prelude.I32) or t == prelude(Prelude.U32) or t == prelude(Prelude.I64) or t == prelude(Prelude.U64)
        or t == prelude(Prelude.F32) or t == prelude(Prelude.F64);
}

fn storage_shift(s: Storage) I32 {
    if s == Storage.U8 or s == Storage.I8 { return 0; };
    if s == Storage.U16 or s == Storage.I16 { return 1; };
    if s == Storage.I64 or s == Storage.U64 or s == Storage.F64 { return 3; };
    2;
}

fn storage_vt(s: Storage) I32 {
    if s == Storage.I64 or s == Storage.U64 { return vt_i64; };
    if s == Storage.F32 { return vt_f32; };
    if s == Storage.F64 { return vt_f64; };
    vt_i32;
}

fn load_opcode(s: Storage) I32 {
    match s.to_i32() {
        0 => 45, 1 => 44, 2 => 47, 3 => 46,
        4 => 40, 5 => 40, 6 => 41, 7 => 41,
        8 => 42, ~> 43,
    };
}

fn store_opcode(s: Storage) I32 {
    match s.to_i32() {
        0 => 58, 1 => 58, 2 => 59, 3 => 59,
        4 => 54, 5 => 54, 6 => 55, 7 => 55,
        8 => 56, ~> 57,
    };
}

/// The type a mem's elements read as: I32 for the narrow kinds, else the
/// element type.
fn mem_value_type(decl: I32) I32 {
    let elem = next_sibling(first_child(decl_node[decl]));
    if builtin_type(word_of(elem)) { return prelude(Prelude.I32); };
    decl_type(node_decl[elem], 0);
}

fn mem_is_const(decl: I32) Bool { tok_word[node_first[decl_node[decl]]] == Kw.Const.to_i32() or tok_word[node_first[decl_node[decl]] + 1] == Kw.Const.to_i32(); }

fn mem_is_exported(decl: I32) Bool { tok_word[node_first[decl_node[decl]]] == Kw.Export.to_i32(); }

/// The memory of a mem (-1 for one in an array), made when first needed,
/// with its initial contents.
fn memory_of(decl: I32) I32 {
    if mem_memory[decl] >= 0 or mem_array[decl] >= 0 { return mem_memory[decl]; };
    if mem_planned[decl] == 0 { plan_mems(); };
    if mem_planned[decl] == 2 {
        mem_array_of(decl);
        return -1;
    };
    let m = memory_kind.len();
    // A mem that copy_in or view reaches from JS is the host's (utu.mem_NAME).
    let hosted = mem_is_hosted(decl);
    memory_kind.push(if hosted { FuncKind.Import.to_i32(); } else { FuncKind.Defined.to_i32(); });
    memory_pages.push(1);
    memory_module_name.push(if hosted { name_add("utu"); } else { -1; });
    if hosted {
        memory_field_name.push(name_add("mem_" + word_text(decl_name[decl])));
        mem_memory[decl] = m;
        let count = mem_initial_data(decl, m);
        mem_len[decl] = add_global(vt_i32, true, w_i32_detached(count));
        return m;
    };
    memory_field_name.push(if mem_is_exported(decl) { name_from_src(tok_start[node_first[first_child(decl_node[decl])]], tok_end[node_first[first_child(decl_node[decl])]]); } else { -1; });
    mem_memory[decl] = m;
    let count = mem_initial_data(decl, m);
    mem_len[decl] = add_global(vt_i32, true, w_i32_detached(count));
    m;
}

//! = Mems in arrays

/// The array a mem of storage `s` is: of bytes, halves, words, or doubles.
fn mem_array_heap(s: Storage) I32 {
    let shift = storage_shift(s);
    let elem = if shift == 0 { vt_i8; } else if shift == 1 { vt_i16; } else { storage_vt(s); };
    array_type(elem, true);
}

fn array_get_op(s: Storage) Op {
    if s == Storage.U8 or s == Storage.U16 { return Op.ArrayGetU; };
    if s == Storage.I8 or s == Storage.I16 { return Op.ArrayGetS; };
    Op.ArrayGet;
}

/// The array of a vec: as long as its initial contents, which are copied in
/// when the module starts.
fn mem_array_of(decl: I32) void {
    let s = mem_storage(decl);
    let h = mem_array_heap(s);
    let segment = data_memory.len();
    let count = mem_initial_data(decl, -1);
    let m = w_mark();
    w_i32(count);
    w_node(Op.ArrayNewDefault, vt_ref(h, false), h, 0, m);
    mem_array[decl] = add_global(vt_ref(h, false), true, w_pop());
    mem_len[decl] = add_global(vt_i32, true, w_i32_detached(count));
    if data_memory.len() > segment {
        mem_array_init.push(decl);
        mem_array_init.push(segment);
        mem_array_init.push(count);
    };
}

/// `op` (an array get or set) on vec `decl`'s array, of the operands built
/// since `m` (the index, and a value to store). The array is read after them,
/// as in stage 0, where the access is a function called with them: a call in
/// one may push to the vec, and so replace its array. With no call it goes in
/// front of them; else they are kept in locals first.
fn array_access(decl: I32, m: I32, op: Op, vt: I32) void {
    let h = mem_array_heap(mem_storage(decl));
    let calls = false;
    for (m ..< w_stack.len()) |k| { if w_calls(w_stack[k]) { calls = true; }; };
    if not calls {
        w_mem_array(decl);
        w_insert(m, w_pop());
        w_node(op, vt, h, 0, m);
        return;
    };
    let n = w_stack.len() - m;
    let operands = Array[I32].new(n, 0);
    for (0 ..< n) |k| { operands[n - 1 - k] = w_pop(); };
    let locals = Array[I32].new(n, 0);
    for (0 ..< n) |k| {
        locals[k] = new_local(w_type[operands[k]]);
        let ms = w_mark();
        w_push(operands[k]);
        w_node(Op.LocalSet, vt_none, locals[k], 0, ms);
    };
    let ma = w_mark();
    w_mem_array(decl);
    for (0 ..< n) |k| { w_get(w_type[operands[k]], locals[k]); };
    w_node(op, vt, h, 0, ma);
    w_node(Op.Seq, vt, 0, 0, m);
}

/// Whether IR node `node` calls a function.
fn w_calls(node: I32) Bool {
    let op = w_op[node];
    if op == Op.Call.to_i32() or op == Op.CallRef.to_i32() or op == Op.ReturnCall.to_i32() { return true; };
    for (0 ..< w_count[node]) |i| { if w_calls(w_kid(node, i)) { return true; }; };
    false;
}

/// The array of mem `decl`, pushed.
fn w_mem_array(decl: I32) void {
    w_leaf(Op.GlobalGet, vt_ref(mem_array_heap(mem_storage(decl)), false), mem_array[decl], 0);
}

/// After the sweep: a start function copies the initial contents of the
/// arrays in use into them; an unused one's segment is left empty.
fn finish_mems() void {
    let k = 0;
    let m = w_mark();
    while (k < mem_array_init.len()) {
        let decl = mem_array_init[k];
        let segment = mem_array_init[k + 1];
        let count = mem_array_init[k + 2];
        if glob_live[mem_array[decl]] == 1 {
            let h = mem_array_heap(mem_storage(decl));
            let mi = w_mark();
            w_mem_array(decl);
            w_i32(0);
            w_i32(0);
            w_i32(count);
            w_node(Op.ArrayInitData, vt_none, h, segment, mi);
        } else {
            data_len[segment] = 0;
        };
        k += 3;
    };
    if w_mark() == m { return; };
    w_node(Op.Seq, vt_none, 0, 0, m);
    let f = helper(vl_empty(), vl_empty(), vl_empty(), "start");
    func_body[f] = w_pop();
    start_func[0] = f;
    mark_late(f);
}

//! = Initial contents
//!
//! `mem prec: U8 = [0, 1, 1, 2];` and `const mem dfa: U8 = @comptime/\ build() \/;`
//! fill the mem from a data segment when the module is instantiated, and set
//! its length. Each value must fit the storage kind.

/// The `@comptime` mems, in order.
vec comptime_mem: I32;
/// Their values, from the host: bytes in `comptime_bytes`, or -1 until given.
vec comptime_start: I32;
vec comptime_count: I32;
export mem comptime_bytes: U8;

/// The values of the mem's initializer as a data segment of memory `m`;
/// returns their number.
fn mem_initial_data(decl: I32, m: I32) I32 {
    let node = decl_node[decl];
    let elem = next_sibling(first_child(node));
    let init = last_child(node);
    if init == elem { return 0; };
    let s = mem_storage(decl);
    let d = data_memory.len();
    // A mem in an array is filled from a passive segment.
    data_memory.push(m);
    data_start.push(data_bytes.len());
    let count = 0;
    if is_kind(init, Node.Array_expr) {
        let c = first_child(init);
        while (c >= 0) {
            let lit = if is_kind(c, Node.Unary_expr) { first_child(last_child(c)); } else { first_child(c); };
            let negate = is_kind(c, Node.Unary_expr);
            if is_kind(lit, Node.Int_lit) {
                let v = int_value(lit);
                store_value(decl, if negate { 0 - v; } else { v; }, false, init, count);
            } else if is_kind(lit, Node.Float_lit) {
                let text = "";
                for (tok_start[node_first[lit]] ..< tok_end[node_first[lit]]) |i| { text = text + Str.from_code_point(src[i]); };
                let f = parse_number(text);
                store_value(decl, (if negate { 0.0 - f; } else { f; }).bits(), true, init, count);
            } else {
                report(Diag.MemInitializer, init, decl_name[decl]);
            };
            count += 1;
            c = next_sibling(c);
        };
    } else if embed_index(decl) >= 0 {
        // The file's bytes, a whole number of elements.
        let k = embed_index(decl);
        if embed_start[k] == -2 { report(Diag.MemEmbed, init, decl_name[decl]); }
        else if embed_start[k] >= 0 {
            let n = embed_count[k];
            let size = 1 << storage_shift(s);
            if n % size != 0 { report(Diag.MemEmbed, init, decl_name[decl]); };
            for (0 ..< n) |i| { data_bytes.push(embed_bytes[embed_start[k] + i]); };
            count = n / size;
        };
    } else {
        let k = comptime_index(decl);
        if k >= 0 and comptime_start[k] >= 0 {
            let value_size = if s == Storage.I64 or s == Storage.U64 or s == Storage.F64 { 8; } else { 4; };
            count = comptime_count[k];
            for (0 ..< count) |i| {
                let at = comptime_start[k] + i * value_size;
                let lo = read_u32(at);
                let v = if value_size == 8 { (read_u32(at + 4).to_i64() << 32) | (lo.to_i64() & 4294967295); } else { lo.to_i64(); };
                store_value(decl, v, s == Storage.F32 or s == Storage.F64, init, i);
            };
        };
    };
    data_len.push(data_bytes.len() - data_start[d]);
    // Enough pages for the data.
    let pages = (data_len[d] + 65535) / 65536;
    if m >= 0 and pages > memory_pages[m] { memory_pages[m] = pages; };
    count;
}

/// A little-endian 32-bit value from @comptime_bytes.
fn read_u32(at: I32) I32 {
    comptime_bytes[at] | (comptime_bytes[at + 1] << 8) | (comptime_bytes[at + 2] << 16) | (comptime_bytes[at + 3] << 24);
}

/// Append element `i` of mem `decl`'s initializer `at`: `v`, an integer or
/// a float's 64 bits.
fn store_value(decl: I32, v: I64, is_float: Bool, at: I32, i: I32) void {
    let s = mem_storage(decl);
    let size = 1 << storage_shift(s);
    if s == Storage.F32 or s == Storage.F64 {
        let f = if is_float { F64.from_bits(v); } else { v.to_f64(); };
        let bits = if s == Storage.F32 { f.to_f32().bits().to_i64(); } else { f.bits(); };
        for (0 ..< size) |k| { data_bytes.push((bits >> (k * 8).to_i64()).to_i32() & 255); };
        return;
    };
    let lo: I64 = 0;
    let hi: I64 = 0;
    if s == Storage.U8 { hi = 255; }
    else if s == Storage.I8 { lo = -128; hi = 127; }
    else if s == Storage.U16 { hi = 65535; }
    else if s == Storage.I16 { lo = -32768; hi = 32767; }
    else if s == Storage.I32 { lo = -2147483648; hi = 2147483647; }
    else if s == Storage.U32 { hi = 4294967295; }
    else { lo = 0 - 9223372036854775807 - 1; hi = 9223372036854775807; };
    if is_float or v < lo or v > hi {
        let text = if is_float { F64.from_bits(v).to_str(); } else { v.to_str(); };
        report3(Diag.MemElementRange, at, decl_name[decl], decl, i, intern_text(text));
    };
    for (0 ..< size) |k| { data_bytes.push((v >> (k * 8).to_i64()).to_i32() & 255); };
}

/// Where `decl` is in @comptime_mem, or -1.
fn comptime_index(decl: I32) I32 {
    for (0 ..< comptime_mem.len()) |k| { if comptime_mem[k] == decl { return k; }; };
    -1;
}

/// `@embed/\ file \/` mems: the host reads each file (relative to the
/// entry file) and gives its bytes, or says it could not.
vec embed_mem: I32;
/// Bytes in `embed_bytes`; -1 until given, -2 when unreadable.
vec embed_start: I32;
vec embed_count: I32;
export mem embed_bytes: U8;

/// Where `decl` is in @embed_mem, or -1.
fn embed_index(decl: I32) I32 {
    for (0 ..< embed_mem.len()) |k| { if embed_mem[k] == decl { return k; }; };
    -1;
}

/// The `@comptime` mems of the program, found once names are resolved.
fn find_comptime_mems() void {
    comptime_mem.clear();
    comptime_start.clear();
    comptime_count.clear();
    comptime_bytes.clear();
    embed_mem.clear();
    embed_start.clear();
    embed_count.clear();
    embed_bytes.clear();
    for (0 ..< file_root.len()) |file| {
        if file_role[file] == FileRole.Entry.to_i32() and file_root[file] >= 0 {
            let item = first_child(file_root[file]);
            while (item >= 0) {
                if is_kind(item, Node.Mem_decl) {
                    let init = last_child(item);
                    if is_kind(init, Node.Dsl_expr) and word_of(first_child(init)) == known_word(Known.Comptime) {
                        comptime_mem.push(node_decl[first_child(item)]);
                        comptime_start.push(-1);
                        comptime_count.push(0);
                    };
                    if is_kind(init, Node.Dsl_expr) and word_of(first_child(init)) == known_word(Known.Embed) {
                        embed_mem.push(node_decl[first_child(item)]);
                        embed_start.push(-1);
                        embed_count.push(0);
                    };
                };
                item = next_sibling(item);
            };
        };
    };
}

/// A constant node that is not on the stack (a global's initializer).
fn w_i32_detached(value: I32) I32 {
    w_i32(value);
    w_pop();
}

/// The address of element i (on the stack since `m`): `i << shift`.
fn mem_address(s: Storage, m: I32) void {
    let shift = storage_shift(s);
    if shift > 0 {
        w_i32(shift);
        w_i32_op(i32_shl, m);
    };
}

/// `name[i]`.
fn check_mem_index(node: I32, cx: Cx) I32 {
    let decl = node_decl[first_child(node)];
    if is_kind(node, Node.Slice_expr) {
        report(Diag.MemIndex, node, decl_name[decl]);
        return error_value();
    };
    let s = mem_storage(decl);
    let mem_id = memory_of(decl);
    let in_array = mem_array[decl] >= 0;
    let m = w_mark();
    let i32_t = prelude(Prelude.I32);
    coerce(check_expr(last_child(node), i32_t, cx), i32_t, last_child(node));
    let t = mem_value_type(decl);
    if in_array {
        array_access(decl, m, array_get_op(s), storage_vt(s));
        return t;
    };
    mem_address(s, m);
    w_node(Op.Load, storage_vt(s), mem_id, load_opcode(s), m);
    t;
}

/// `name[i] = v`, `name[i] op= v`.
fn check_mem_store(target: I32, value: I32, op: I32, at: I32, cx: Cx) I32 {
    let decl = node_decl[first_child(target)];
    if mem_is_const(decl) {
        report(Diag.ConstMem, at, decl_name[decl]);
        return error_value();
    };
    let s = mem_storage(decl);
    let mem_id = memory_of(decl);
    let in_array = mem_array[decl] >= 0;
    let t = mem_value_type(decl);
    let i32_t = prelude(Prelude.I32);
    let m = w_mark();
    if op == Tok.Eq.to_i32() {
        coerce(check_expr(last_child(target), i32_t, cx), i32_t, last_child(target));
        if not in_array { mem_address(s, m); };
        coerce(check_expr(value, t, cx), t, value);
        if in_array { array_access(decl, m, Op.ArraySet, vt_none); } else { w_node(Op.Store, vt_none, mem_id, store_opcode(s), m); };
        return ty_void();
    };
    // The index once: at = i; name[at] = name[at] op v.
    let at_local = new_local(vt_i32);
    let mi = w_mark();
    coerce(check_expr(last_child(target), i32_t, cx), i32_t, last_child(target));
    w_node(Op.LocalSet, vt_none, at_local, 0, mi);
    let ms = w_mark();
    if not in_array {
        w_get(vt_i32, at_local);
        mem_address(s, ms);
    };
    let mg = w_mark();
    w_get(vt_i32, at_local);
    if in_array { array_access(decl, mg, array_get_op(s), storage_vt(s)); } else {
        mem_address(s, mg);
        w_node(Op.Load, storage_vt(s), mem_id, load_opcode(s), mg);
    };
    apply_operator(compound_word(op, node_last[target]), t, value, at, cx, mg);
    if in_array {
        w_get(vt_i32, at_local);
        w_insert(ms, w_pop());
        array_access(decl, ms, Op.ArraySet, vt_none);
    } else { w_node(Op.Store, vt_none, mem_id, store_opcode(s), ms); };
    w_node(Op.Seq, vt_none, 0, 0, m);
    ty_void();
}

/// `name.len()`, `name.push(v)`, … The mem is `decl`; the call's arguments
/// are `args`.
fn check_mem_method(decl: I32, name: I32, args: I32, at: I32, cx: Cx) I32 {
    let word = word_of(name);
    memory_of(decl);  // (any use of a mem makes its memory or array)
    let len_g = mem_len[decl];
    let i32_t = prelude(Prelude.I32);
    let m = w_mark();
    let method = mem_method(word);
    if method < 0 {
        report(Diag.MemNoMethod, first_child(at), word);
        return error_value();
    };
    let writes = method == MemMethod.Push.to_i32() or method == MemMethod.Reserve.to_i32() or method == MemMethod.Resize.to_i32()
        or method == MemMethod.Clear.to_i32();
    if writes and mem_is_const(decl) {
        report2(Diag.ConstMem, first_child(at), decl_name[decl], word, -1);
        return error_value();
    };
    let a = if args >= 0 { first_child(args); } else { -1; };
    if method == MemMethod.Len.to_i32() {
        w_leaf(Op.GlobalGet, vt_i32, len_g, 0);
        return i32_t;
    };
    if method == MemMethod.Cap.to_i32() {
        w_mem_capacity(decl);
        return i32_t;
    };
    if method == MemMethod.Clear.to_i32() {
        w_i32(0);
        w_node(Op.GlobalSet, vt_none, len_g, 0, m);
        return ty_void();
    };
    if method >= MemMethod.Intern.to_i32() { return call_interner(decl, method, args, at, m, cx); };
    if method == MemMethod.Copy_in.to_i32() or method == MemMethod.View.to_i32() {
        if mem_is_vec(decl) {
            report(Diag.VecHost, first_child(at), word);
            return error_value();
        };
        // A view is a JS typed array: it needs std:JS's declarations.
        if method == MemMethod.View.to_i32() and not has_foreign() {
            report2(Diag.MemView, first_child(at), decl_name[decl], mem_storage(decl).to_i32(), -1);
            return error_value();
        };
        return check_mem_host_op(decl, method, args, m, cx);
    };
    let helpers = mem_helper_functions(decl);
    if method == MemMethod.Push.to_i32() {
        let t = mem_value_type(decl);
        coerce(check_expr(a, t, cx), t, a);
        w_node(Op.Call, vt_none, helpers + 1, 0, m);
        return ty_void();
    };
    if method == MemMethod.Reserve.to_i32() or method == MemMethod.Resize.to_i32() {
        coerce(check_expr(a, i32_t, cx), i32_t, a);
        w_node(Op.Call, vt_none, if method == MemMethod.Reserve.to_i32() { helpers; } else { helpers + 2; }, 0, m);
        return ty_void();
    };
    unsupported(at);
}

/// The methods a mem has; each is spoken as its name with a lowercase first letter.
enum(U8) MemMethod:
    | Len
    | Cap
    | Push
    | Reserve
    | Resize
    | Clear
    | Copy_in
    | View
    | Intern
    | Interned
    | Interned_start
    | Interned_size
    | Intern_reset

/// By MemMethod: its word.
vec mem_method_word: I32;

/// The MemMethod a word names, or -1.
fn mem_method(word: I32) I32 {
    if mem_method_word.len() == 0 {
        for (0 ..< MemMethod.count()) |k| {
            let name = MemMethod.name(MemMethod.from_i32(k));
            mem_method_word.push(intern_text(Str.from_code_point(name.get(0) + 32) + name.slice(1, name.len())));
        };
    };
    for (0 ..< MemMethod.count()) |k| { if mem_method_word[k] == word { return k; }; };
    -1;
}

/// `reserve(n)`, `push(v)`, `resize(n)` of a mem: three functions,
/// consecutive. Only `reserve` differs between a mem in a memory and one in
/// an array.
fn mem_helper_functions(decl: I32) I32 {
    if mem_helpers[decl] >= 0 { return mem_helpers[decl]; };
    // (This makes the mem's memory, or its array: which, it says.)
    memory_of(decl);
    let reserve = if mem_array[decl] >= 0 { array_reserve_helper(decl); } else { memory_reserve_helper(decl); };
    mem_push_helper(decl, reserve);
    mem_resize_helper(decl, reserve);
    mem_helpers[decl] = reserve;
    reserve;
}

/// `reserve(n)` of a mem in a memory: `need = (n + per_page - 1) >> (16 - shift)`;
/// when `need > memory.size`, grow by `max(size, need - size)` pages, or else
/// by `need - size`, or else trap.
fn memory_reserve_helper(decl: I32) I32 {
    let mem_id = memory_of(decl);
    let shift = storage_shift(mem_storage(decl));
    let locals = vl_begin();
    vl_add(vt_i32);  // need
    vl_add(vt_i32);  // size
    let reserve = helper(vl_one(vt_i32), vl_empty(), vl_end(locals), "mem.reserve");
    let m = w_mark();
    let mn = w_mark();
    w_get(vt_i32, 0);
    w_i32((1 << (16 - shift)) - 1);
    w_i32_op(i32_add, mn);
    w_i32(16 - shift);
    w_i32_op(i32_shr_u, mn);
    w_node(Op.LocalSet, vt_none, 1, 0, mn);
    let ms = w_mark();
    w_leaf(Op.MemorySize, vt_i32, mem_id, 0);
    w_node(Op.LocalSet, vt_none, 2, 0, ms);
    let mif = w_mark();
    let mc = w_mark();
    w_get(vt_i32, 1);
    w_get(vt_i32, 2);
    w_i32_op(i32_gt_u, mc);
    let then_ = w_mark();
    let mg = w_mark();
    // grow(select(size, need - size, size > need - size)) == -1 ?
    let mgrow = w_mark();
    w_get(vt_i32, 2);
    pages_short();
    let mcmp = w_mark();
    w_get(vt_i32, 2);
    pages_short();
    w_i32_op(i32_gt_u, mcmp);
    w_node(Op.Select, vt_i32, 0, 0, mgrow);
    w_node(Op.MemoryGrow, vt_i32, mem_id, 0, mgrow);
    w_i32(-1);
    w_i32_op(i32_eq, mgrow);
    let inner = w_mark();
    let mgrow2 = w_mark();
    pages_short();
    w_node(Op.MemoryGrow, vt_i32, mem_id, 0, mgrow2);
    w_i32(-1);
    w_i32_op(i32_eq, mgrow2);
    let trap = w_mark();
    w_leaf(Op.Unreachable, vt_unreachable, 0, 0);
    w_node(Op.Seq, vt_none, 0, 0, trap);
    w_node(Op.If, vt_none, 1, 0, inner);
    w_node(Op.Seq, vt_none, 0, 0, inner);
    w_node(Op.If, vt_none, 2, 0, mg);
    w_node(Op.Seq, vt_none, 0, 0, then_);
    w_node(Op.If, vt_none, 3, 0, mif);
    w_node(Op.Seq, vt_none, 0, 0, m);
    func_body[reserve] = w_pop();
    reserve;
}

/// `need - size`, in @memory_reserve_helper.
fn pages_short() void {
    let m = w_mark();
    w_get(vt_i32, 1);
    w_get(vt_i32, 2);
    w_i32_op(i32_sub, m);
}

/// `reserve(n)` of a mem in an array: when `n` is more than the array's
/// length, the array is replaced by one of `max(n, length * 2)` elements,
/// the elements copied to it.
fn array_reserve_helper(decl: I32) I32 {
    let h = mem_array_heap(mem_storage(decl));
    let locals = vl_begin();
    vl_add(vt_i32);  // the length
    vl_add(vt_ref(h, true));  // the new array
    let reserve = helper(vl_one(vt_i32), vl_empty(), vl_end(locals), "mem.reserve");
    let m = w_mark();
    let ms = w_mark();
    w_mem_array(decl);
    w_node(Op.ArrayLen, vt_i32, 0, 0, ms);
    w_node(Op.LocalSet, vt_none, 1, 0, ms);
    let mif = w_mark();
    let mc = w_mark();
    w_get(vt_i32, 0);
    w_get(vt_i32, 1);
    w_i32_op(i32_gt_u, mc);
    let then_ = w_mark();
    // new = array.new_default(select(n, length << 1, n > length << 1))
    let mnew = w_mark();
    w_get(vt_i32, 0);
    twice_length();
    let mcmp = w_mark();
    w_get(vt_i32, 0);
    twice_length();
    w_i32_op(i32_gt_u, mcmp);
    w_node(Op.Select, vt_i32, 0, 0, mnew);
    w_node(Op.ArrayNewDefault, vt_ref(h, false), h, 0, mnew);
    w_node(Op.LocalSet, vt_none, 2, 0, mnew);
    // array.copy(new, 0, old, 0, length)
    let mcopy = w_mark();
    w_get(vt_ref(h, true), 2);
    w_i32(0);
    w_mem_array(decl);
    w_i32(0);
    w_get(vt_i32, 1);
    w_node(Op.ArrayCopy, vt_none, h, h, mcopy);
    let mset = w_mark();
    let mnn = w_mark();
    w_get(vt_ref(h, true), 2);
    w_node(Op.RefAsNonNull, vt_ref(h, false), 0, 0, mnn);
    w_node(Op.GlobalSet, vt_none, mem_array[decl], 0, mset);
    w_node(Op.Seq, vt_none, 0, 0, then_);
    w_node(Op.If, vt_none, 1, 0, mif);
    w_node(Op.Seq, vt_none, 0, 0, m);
    func_body[reserve] = w_pop();
    reserve;
}

/// `length << 1`, in @array_reserve_helper.
fn twice_length() void {
    let m = w_mark();
    w_get(vt_i32, 1);
    w_i32(1);
    w_i32_op(i32_shl, m);
}

/// `push(v)`: `at = len; if at >= cap { reserve(at + 1) }; element at = v; len = at + 1`.
fn mem_push_helper(decl: I32, reserve: I32) void {
    let s = mem_storage(decl);
    let vt = storage_vt(s);
    let len_g = mem_len[decl];
    let locals = vl_begin();
    vl_add(vt_i32);  // at
    let push = helper(vl_one(vt), vl_empty(), vl_end(locals), "mem.push");
    let p = w_mark();
    let pa = w_mark();
    w_leaf(Op.GlobalGet, vt_i32, len_g, 0);
    w_node(Op.LocalSet, vt_none, 1, 0, pa);
    let pif = w_mark();
    let pc = w_mark();
    w_get(vt_i32, 1);
    w_mem_capacity(decl);
    w_i32_op(i32_ge_u, pc);
    let pthen = w_mark();
    let pr = w_mark();
    w_get(vt_i32, 1);
    w_i32(1);
    w_i32_op(i32_add, pr);
    w_node(Op.Call, vt_none, reserve, 0, pr);
    w_node(Op.Seq, vt_none, 0, 0, pthen);
    w_node(Op.If, vt_none, 1, 0, pif);
    let pst = w_mark();
    if mem_array[decl] >= 0 {
        w_mem_array(decl);
        w_get(vt_i32, 1);
        w_get(vt, 0);
        w_node(Op.ArraySet, vt_none, mem_array_heap(s), 0, pst);
    } else {
        w_get(vt_i32, 1);
        mem_address(s, pst);
        w_get(vt, 0);
        w_node(Op.Store, vt_none, memory_of(decl), store_opcode(s), pst);
    };
    let pl = w_mark();
    w_get(vt_i32, 1);
    w_i32(1);
    w_i32_op(i32_add, pl);
    w_node(Op.GlobalSet, vt_none, len_g, 0, pl);
    w_node(Op.Seq, vt_none, 0, 0, p);
    func_body[push] = w_pop();
}

/// `resize(n)`: `reserve(n); len = n`.
fn mem_resize_helper(decl: I32, reserve: I32) void {
    let resize = helper(vl_one(vt_i32), vl_empty(), vl_empty(), "mem.resize");
    let r = w_mark();
    let rr = w_mark();
    w_get(vt_i32, 0);
    w_node(Op.Call, vt_none, reserve, 0, rr);
    let rl = w_mark();
    w_get(vt_i32, 0);
    w_node(Op.GlobalSet, vt_none, mem_len[decl], 0, rl);
    w_node(Op.Seq, vt_none, 0, 0, r);
    func_body[resize] = w_pop();
}

/// The capacity of mem `decl`, in elements, pushed: its array's length, or
/// its memory's size in elements.
fn w_mem_capacity(decl: I32) void {
    let m = w_mark();
    if mem_array[decl] >= 0 {
        w_mem_array(decl);
        w_node(Op.ArrayLen, vt_i32, 0, 0, m);
        return;
    };
    w_leaf(Op.MemorySize, vt_i32, memory_of(decl), 0);
    w_i32(16 - storage_shift(mem_storage(decl)));
    w_i32_op(i32_shl, m);
}

/// `src.intern(a, b)` and the rest: the mem's generated interner.
fn call_interner(decl: I32, method: I32, args: I32, at: I32, m: I32, cx: Cx) I32 {
    let s = mem_storage(decl);
    if s != Storage.U8 and s != Storage.I8 {
        report2(Diag.InternNotBytes, first_child(at), decl_name[decl], mem_method_word[method], -1);
        return error_value();
    };
    let f = generated_mem_fn(decl, method);
    if f < 0 { return unsupported(at); };
    call_with(fn_instance(f, 0), args, 0, m, at, cx);
}

//! = Mems the host makes
//!
//! copy_in and view reach a mem from JS, so its memory is the host's
//! (src/runtime/host-imports.js memoryImports): utu.mem_NAME, with
//! utu.mem_copy_in_NAME(bytes) → new length and utu.mem_view_NAME(a, b) →
//! a typed array over [a, b).

/// Whether the host makes the memory of mem `decl` (planning the mems first if need be).
fn mem_is_hosted(decl: I32) Bool {
    if mem_hosted[decl] < 0 { plan_mems(); };
    mem_hosted[decl] == 1;
}

/// The most memories a module may have (the JS API's limit): each mem is one.
let max_memories: I32 = 100;

/// Whether a declaration is `vec name: …` (rather than `mem name: …`).
fn mem_is_vec(decl: I32) Bool { tok_word[node_first[decl_node[decl]]] == Kw.Vec.to_i32() or tok_word[node_first[decl_node[decl]] + 1] == Kw.Vec.to_i32(); }

/// How a mem or vec is spoken of, for a diagnostic about the one named `w`.
fn mem_word(w: I32) Str {
    for (0 ..< decl_kind.len()) |d| { if decl_is(d, Decl.Mem) and decl_name[d] == w and mem_is_vec(d) { return "vec"; }; };
    "mem";
}

/// A program declares at most `max_memories` mems; the first past that is reported.
fn count_memories() void {
    let n = 0;
    for (0 ..< decl_kind.len()) |d| {
        if decl_is(d, Decl.Mem) and not mem_is_vec(d) {
            n += 1;
            if n == max_memories + 1 { report(Diag.TooManyMems, decl_node[d], decl_name[d]); };
        };
    };
}

/// Which mems are memories (each mem) and which arrays (each vec); and which
/// memories the host makes, in one pass over the program: those used with
/// `copy_in` or view.
fn plan_mems() void {
    mem_method(-1);
    let copy_in = mem_method_word[MemMethod.Copy_in.to_i32()];
    let view = mem_method_word[MemMethod.View.to_i32()];
    // The kept prelude's nodes name only its own declarations: when it
    // declares no mem, they name none.
    let first = kept[2];
    for (0 ..< decl_kind.len()) |d| {
        if decl_is(d, Decl.Mem) {
            mem_hosted[d] = 0;
            mem_planned[d] = if mem_is_vec(d) { 2; } else { 1; };
            if decl_node[d] < kept[2] { first = 0; };
        };
    };
    for (first ..< node_kind.len()) |n| {
        if node_kind[n] == Node.Call_expr.to_i32() {
            let callee = node_child[n];
            if is_kind(callee, Node.Field_expr) and is_kind(first_child(callee), Node.Identifier) {
                let d = node_decl[first_child(callee)];
                let w = word_of(last_child(callee));
                if d >= 0 and decl_is(d, Decl.Mem) and mem_planned[d] == 1 and (w == copy_in or w == view) { mem_hosted[d] = 1; };
            };
        };
    };
}

/// `name.copy_in(bytes)` and `name.view(a, b)`: calls to the host's
/// `utu.mem_copy_in_NAME` and `utu.mem_view_NAME` imports, made when first used.
fn check_mem_host_op(decl: I32, method: I32, args: I32, m: I32, cx: Cx) I32 {
    memory_of(decl);
    if mem_host_ops[decl] < 0 {
        let name = word_text(decl_name[decl]);
        mem_host_ops[decl] = add_import_func(name_add("utu"), name_add("mem_copy_in_" + name), func_type(vl_one(vt_externref), vl_of_result(vt_i32)));
        let mp = vl_begin();
        vl_add(vt_i32);
        vl_add(vt_i32);
        add_import_func(name_add("utu"), name_add("mem_view_" + name), func_type(vl_end(mp), vl_of_result(vt_externref)));
    };
    let a = if args >= 0 { first_child(args); } else { -1; };
    if method == MemMethod.Copy_in.to_i32() {
        let t = check_expr(a, -1, cx);
        if not is_host_value(t) and not ty_is(t, Ty.Error) { mismatch(a, foreign_any(0), t); };
        w_node(Op.Call, vt_i32, mem_host_ops[decl], 0, m);
        w_node(Op.GlobalSet, vt_none, mem_len[decl], 0, m);
        return ty_void();
    };
    let i32_t = prelude(Prelude.I32);
    coerce(check_expr(a, i32_t, cx), i32_t, a);
    let b = next_sibling(a);
    coerce(check_expr(b, i32_t, cx), i32_t, b);
    w_node(Op.Call, vt_externref, mem_host_ops[decl] + 1, 0, m);
    mem_view_type(decl);
}

/// The typed array a view of the mem is: `JS.Uint8Array`, `JS.Float64Array`, ….
fn mem_view_type(decl: I32) I32 {
    let w = intern_text(view_array_name(mem_storage(decl)));
    for (0 ..< view_doc.len()) |v| {
        let t = if view_live(v) { foreign_named_type(v, w); } else { -1; };
        if t >= 0 { return t; };
    };
    foreign_any(0);
}

/// The build's `"mems"` list: each mem whose memory the host makes, with its storage.
fn write_mems_json() void {
    let any = false;
    for (0 ..< decl_kind.len()) |d| {
        if decl_is(d, Decl.Mem) and mem_memory[d] >= 0 and mem_hosted[d] == 1 { any = true; };
    };
    if not any { return; };
    json_text("\"mems\":[");
    let first = true;
    for (0 ..< decl_kind.len()) |d| {
        if decl_is(d, Decl.Mem) and mem_memory[d] >= 0 and mem_hosted[d] == 1 {
            if not first { json_byte(44); };
            first = false;
            json_text("{\"name\":\"" + word_text(decl_name[d]) + "\",\"kind\":\"" + Storage.name(mem_storage(d)) + "\",\"host\":true}");
        };
    };
    json_byte(93);
}
