//! = Tools: Wutu formatting
//!
//! `utu format`'s Wutu part. A template is laid out one statement per line
//! from the compiler's own parse of it (wutu_parse.utu); one with comments
//! is left as written, and nested DSL literals are restored byte for byte.
//! A `@wutu` island takes its layout only when that changes nothing but
//! whitespace beside `{`, `}`, `;` and `=`, and parses to the same tree.
//! Also: a file's `@wutu` islands, a template's tree as JSON, and the
//! editor's completion words.

//! == Text

/// JavaScript's `\s`.
fn is_js_space(c: I32) Bool {
    return c == 32 or (c >= 9 and c <= 13) or c == 160 or c == 5760 or (c >= 8192 and c <= 8202)
        or c == 8232 or c == 8233 or c == 8239 or c == 8287 or c == 12288 or c == 65279
}

/// A line terminator: what `.` in a JavaScript pattern does not match.
fn is_line_end(c: I32) Bool => c == 10 or c == 13 or c == 8232 or c == 8233

/// The code unit at `i`, or -1 outside the text.
fn code_at(s: Str, i: I32) I32 => if i >= 0 and i < s.len() { s.get(i) } else { -1 }

/// Whether `c` is one of the code units of `set`.
fn has_code(set: Str, c: I32) Bool {
    for (0 ..< set.len()) |k| { if set.get(k) == c { return true } }
    return false
}

/// Past the JavaScript white space from `i`.
fn skip_js_spaces(s: Str, i: I32) I32 {
    let j = i
    while (j < s.len() and is_js_space(s.get(j))) { j += 1 }
    return j
}

/// Where the line holding `i` ends (its `\n`, or the text's end).
fn line_end(s: Str, i: I32) I32 {
    let end = text_index(s, "\n", i)
    return if end < 0 { s.len() } else { end }
}

/// `depth` levels of indent, four spaces each.
fn indent(depth: I32) Str => "    ".repeat(depth)

/// `a` with room for `n` + 1 strings.
fn grown_strs(a: Array[Str], n: I32) Array[Str] {
    if n < a.len() { return a }
    let b = Array[Str].new(a.len() * 2 + 16, "")
    for (0 ..< a.len()) |k| { b[k] = a[k] }
    return b
}

/// The first `n` of `parts`, with `sep` between each two.
fn joined(parts: Array[Str], n: I32, sep: Str) Str {
    if n == 0 { return "" }
    let out = parts[0]
    for (1 ..< n) |k| { out = out + sep + parts[k] }
    return out
}

/// Offset of the quote closing the string opened at `start`, past `\` escapes; -1 if none.
fn string_end(s: Str, start: I32) I32 {
    let quote = s.get(start)
    let i = start + 1
    while (i < s.len()) {
        let c = s.get(i)
        if c == 92 { i += 1 } else if c == quote { return i }
        i += 1
    }
    return -1
}

/// Past the string literal (`"`, `` ` `` or `'`, `quote`) at `i` as a
/// JavaScript pattern reads one: a `\` escapes any character but a line's
/// end; `one_line`: no line break in it; `some`: not empty. -1 when there
/// is none at `i`.
fn quoted_end(s: Str, i: I32, quote: I32, one_line: Bool, some: Bool) I32 {
    if code_at(s, i) != quote { return -1 }
    let j = i + 1
    while (j < s.len()) {
        let c = s.get(j)
        if c == quote { return if some and j == i + 1 { -1 } else { j + 1 } }
        if c == 92 {
            if j + 1 < s.len() and not is_line_end(s.get(j + 1)) { j += 2 } else { return -1 }
        } else if c == 10 and one_line {
            return -1
        } else {
            j += 1
        }
    }
    return -1
}

/// Collapse whitespace outside string literals.
fn compact(value: Str) Str {
    let v = value.trim()
    let codes = Array[I32].new(v.len(), 0)
    let k = 0
    let quoted = false
    let escaped = false
    for (0 ..< v.len()) |i| {
        let c = v.get(i)
        if quoted and (escaped or c == 92) { escaped = not escaped } else if c == 34 { quoted = not quoted }
        if not quoted and is_js_space(c) {
            if k == 0 or codes[k - 1] != 32 {
                codes[k] = 32
                k += 1
            }
        } else {
            codes[k] = c
            k += 1
        }
    }
    return Str.from_codes(codes, k)
}

/// Whether `t` ends with the word `w` (nothing of a word before it).
fn ends_with_word(t: Str, w: Str) Bool {
    return t.ends_with(w) and (t.len() == w.len() or not is_word_code(t.get(t.len() - w.len() - 1)))
}

/// Whether a line ending as `t` does goes on to the next: an operator, `,`,
/// `.`, `?`, `:`, or `and or xor not orelse else in`.
fn ends_open(t: Str) Bool {
    if t.len() == 0 { return false }
    if has_code("+-*/%=<>&|^~!,.?:", t.get(t.len() - 1)) { return true }
    return ends_with_word(t, "and") or ends_with_word(t, "or") or ends_with_word(t, "xor") or ends_with_word(t, "not")
        or ends_with_word(t, "orelse") or ends_with_word(t, "else") or ends_with_word(t, "in")
}

/// Whether the word `w` is at `j` (no word character after it).
fn word_at(s: Str, j: I32, w: Str) Bool => text_at(s, j, w) and not is_word_code(code_at(s, j + w.len()))

/// Whether a line whose first token is at `j` goes on with the statement
/// before it: `.f` (not `.name =`, a property), `?.`, a binary operator but
/// `-`, `{`, `==`, `and or xor orelse else catch`, or `collect(`.
fn line_goes_on(s: Str, j: I32) Bool {
    let c = code_at(s, j)
    if c == 46 {
        let d = code_at(s, j + 1)
        if not (is_lower_code(d) or d == 95) { return false }
        let k = j + 2
        while (k < s.len() and (is_word_code(s.get(k)) or s.get(k) == 45)) { k += 1 }
        while (k < s.len() and (s.get(k) == 32 or s.get(k) == 9)) { k += 1 }
        return not (code_at(s, k) == 61 and code_at(s, k + 1) != 61)
    }
    if c == 63 { return code_at(s, j + 1) == 46 }
    if c == 61 { return code_at(s, j + 1) == 61 }
    if has_code("+*/%<>|^~!{", c) { return true }
    return word_at(s, j, "and") or word_at(s, j, "or") or word_at(s, j, "xor") or word_at(s, j, "orelse")
        or word_at(s, j, "else") or word_at(s, j, "catch") or text_at(s, j, "collect(")
}

/// A pipeline stage or terminal that takes a `|…|` capture.
fn is_stage_word(w: Str) Bool {
    return in_words("map filter skip take skip_while take_while scan zip chain flat_map repeat fold each any all count_where first_index last_index sum fast_sum product count sort group_by distinct_by partition batched windows min_by max_by first_where reduce bisect", w)
}

/// Whether a line break after `current` (with `s` from `from` after it)
/// ends the statement: in code, as utu's (the line does not end open, the
/// next does not go on); in CSS, unless the line ends in `,`.
fn ends_line(current: Str, s: Str, from: I32, code: Bool) Bool {
    let tail = current.trim_end()
    if not code { return not tail.ends_with(",") }
    if ends_open(tail) { return false }
    let j = skip_js_spaces(s, from)
    if line_goes_on(s, j) { return false }
    // `name (…)? |`: a stage with its capture.
    let c = code_at(s, j)
    if not (is_lower_code(c) or c == 95) { return true }
    let e = j + 1
    while (e < s.len() and is_word_code(s.get(e))) { e += 1 }
    let k = skip_js_spaces(s, e)
    if code_at(s, k) == 40 {
        let close = text_index(s, ")", k + 1)
        if close >= 0 { k = skip_js_spaces(s, close + 1) }
    }
    return not (code_at(s, k) == 124 and is_stage_word(s.slice(j, e)))
}

/// `expr` parenthesized when a top-level character of `ends` would end it early (`if`, `for`, `key`).
fn grouped(expr: Str, ends: Str) Str {
    let depth = 0
    let i = 0
    while (i < expr.len()) {
        let c = expr.get(i)
        if c == 34 {
            i = string_end(expr, i)
            if i < 0 { return expr }
        } else {
            if depth == 0 and has_code(ends, c) { return "(" + expr + ")" }
            if c == 40 or c == 91 or c == 123 { depth += 1 } else if c == 41 or c == 93 or c == 125 { depth -= 1 }
        }
        i += 1
    }
    return expr
}

/// An odd number of `|` in `line` outside strings: inside a capture list (`|a, b|`).
fn in_captures(line: Str) Bool {
    let bars = 0
    let i = 0
    while (i < line.len()) {
        let end = quoted_end(line, i, 34, false, false)
        if end > 0 {
            i = end
        } else {
            if line.get(i) == 124 { bars += 1 }
            i += 1
        }
    }
    return bars % 2 == 1
}

/// Past an arm's pattern at `i` (`Dot`, `Shape.Dot`, `-1`, `'a'`), or -1.
fn pattern_end(s: Str, i: I32) I32 {
    let j = if code_at(s, i) == 45 { i + 1 } else { i }
    let k = j
    while (k < s.len() and (is_word_code(s.get(k)) or s.get(k) == 46)) { k += 1 }
    if k > j { return k }
    return quoted_end(s, i, 39, false, true)
}

/// Whether `t` is an arm's patterns and nothing else: `A, B`.
fn only_patterns(t: Str) Bool {
    let i = pattern_end(t, 0)
    while (i >= 0) {
        if i == t.len() { return true }
        let j = skip_js_spaces(t, i)
        if code_at(t, j) != 44 { return false }
        i = pattern_end(t, skip_js_spaces(t, j + 1))
    }
    return false
}

/// Whether `s` from `from` is more of an arm's patterns, then its `=>`.
fn more_patterns(s: Str, from: I32) Bool {
    let i = from
    while (true) {
        i = pattern_end(s, skip_js_spaces(s, i))
        if i < 0 { return false }
        i = skip_js_spaces(s, i)
        if code_at(s, i) != 44 { return text_at(s, i, "=>") }
        i += 1
    }
    return false
}

/// A `,` between an arm's patterns (`A, B => e`), `line` so far, `s` from
/// `from` after it: it stays on its line.
fn between_patterns(line: Str, s: Str, from: I32) Bool => only_patterns(line.trim()) and more_patterns(s, from)

/// Past the template literal whose backtick is at `start`; -1 if unterminated.
fn template_end(s: Str, start: I32) I32 {
    let i = start + 1
    while (i < s.len()) {
        let c = s.get(i)
        if c == 92 {
            i += 1
        } else if c == 96 {
            return i + 1
        } else if c == 36 and code_at(s, i + 1) == 123 {
            i = code_end(s, i + 2)
            if i < 0 { return -1 }
        }
        i += 1
    }
    return -1
}

/// Offset of the `}` closing code that starts at `start` (inside `${…}`); -1 if none.
fn code_end(s: Str, start: I32) I32 {
    let depth = 0
    let i = start
    while (i < s.len()) {
        let c = s.get(i)
        if c == 34 {
            i = string_end(s, i)
            if i < 0 { return -1 }
        } else if c == 96 {
            i = template_end(s, i) - 1
            if i < 0 { return -1 }
        } else if c == 123 {
            depth += 1
        } else if c == 125 {
            if depth == 0 { return i }
            depth -= 1
        }
        i += 1
    }
    return -1
}

/// Whether `before` ends in a type name, `Point` or `Map[K, V]` (then
/// blanks), not a member (`a.B`).
fn ends_with_type_name(before: Str) Bool {
    let end = before.trim_end().len()
    let t = before.slice(0, end)
    if end > 0 and t.get(end - 1) == 93 {
        // `Name[…]`: each `[` after the `]` before this one may open it.
        let k = end - 2
        while (k >= 0 and t.get(k) != 93) {
            if t.get(k) == 91 and type_name_ends_at(t, k) { return true }
            k -= 1
        }
        return false
    }
    return type_name_ends_at(t, end)
}

fn type_name_ends_at(t: Str, e: I32) Bool {
    let s = e
    while (s > 0 and is_word_code(t.get(s - 1))) { s -= 1 }
    return e > s and is_upper_code(t.get(s)) and (s == 0 or t.get(s - 1) != 46)
}

/// The struct literal written on one line at `text[i]` (a `{` after a type
/// name, `before`), as `{ a: 1, b: 2 }`, or "": `Point { x: 1, y: 2 }`
/// stays on its line.
fn one_line_struct(before: Str, text: Str, i: I32) Str {
    if not ends_with_type_name(before) { return "" }
    let j = skip_js_spaces(text, i + 1)
    let c = code_at(text, j)
    if not (is_lower_code(c) or c == 95) { return "" }
    j += 1
    while (j < text.len() and is_word_code(text.get(j))) { j += 1 }
    j = skip_js_spaces(text, j)
    if code_at(text, j) != 58 or code_at(text, j + 1) == 58 { return "" }
    j += 1
    while (j < text.len() and not has_code("{}\n`", text.get(j))) { j += 1 }
    if code_at(text, j) != 125 { return "" }
    let literal = text.slice(i, j + 1)
    // (A comment outside its strings: not one line.)
    let k = 0
    while (k < literal.len()) {
        let end = quoted_end(literal, k, 34, false, false)
        if end > 0 { k = end } else {
            if text_at(literal, k, "//") or text_at(literal, k, "/*") { return "" }
            k += 1
        }
    }
    return literal
}

/// The block whose `{` is at `open` when it is written on one line and holds
/// one statement (`filter |p| { p.ok }`, `if c { a } else { b }`): it stays as
/// written. "" otherwise.
fn one_line_body(text: Str, open: I32) Str {
    let end = wutu_brace_end_at(text, open)
    if end < 0 { return "" }
    let body = text.slice(open, end)
    if text_index(body, "\n", 0) >= 0 { return "" }
    let k = 0
    while (k < body.len()) {
        let c = body.get(k)
        let past = if c == 34 { quoted_end(body, k, 34, true, false) } else if c == 96 { quoted_end(body, k, 96, false, false) } else if c == 39 { quoted_end(body, k, 39, true, true) } else { -1 }
        if past > 0 { k = past } else {
            if c == 59 or text_at(body, k, "//") or text_at(body, k, "/*") { return "" }
            k += 1
        }
    }
    return body
}

/// Past the `}` closing the brace at `open` (a `wn f() {` or `html {` body),
/// past strings, comments and DSLs (as lex.utu's wutu_brace_end); -1 if none.
fn wutu_brace_end_at(s: Str, open: I32) I32 {
    let depth = 0
    let j = open
    let n = s.len()
    while (j < n) {
        let c = s.get(j)
        if c == 34 or c == 39 or c == 96 {
            j += 1
            while (j < n and s.get(j) != c) {
                if s.get(j) == 92 { j += 1 }
                j += 1
            }
        } else if text_at(s, j, "//") {
            j = line_end(s, j)
        } else if text_at(s, j, "/*") {
            j = text_index(s, "*/", j + 2)
            if j < 0 { return -1 }
            j += 1
        } else if text_at(s, j, "/\\") {
            let nest = 1
            j += 2
            while (j < n and nest > 0) {
                if s.get(j) == 34 {
                    j += 1
                    while (j < n and s.get(j) != 34 and s.get(j) != 10) {
                        if s.get(j) == 92 { j += 1 }
                        j += 1
                    }
                } else if text_at(s, j, "/\\") {
                    nest += 1
                    j += 1
                } else if text_at(s, j, "\\/") {
                    nest -= 1
                    j += 1
                }
                j += 1
            }
            if nest > 0 { return -1 }
            j -= 1
        } else if c == 123 {
            depth += 1
        } else if c == 125 {
            depth -= 1
            if depth == 0 { return j + 1 }
        }
        j += 1
    }
    return -1
}

//! == DSL literals
//!
//! `@name/\ payload \/`, payloads nesting balanced envelopes; a `"` string
//! in one is text, ending at its quote or its line.

/// Past the opener `@name/\` at `i`, or -1.
fn opener_end(s: Str, i: I32) I32 {
    if code_at(s, i) != 64 { return -1 }
    let j = i + 1
    while (j < s.len() and is_word_code(s.get(j))) { j += 1 }
    if j == i + 1 { return -1 }
    j = skip_js_spaces(s, j)
    return if text_at(s, j, "/\\") { j + 2 } else { -1 }
}

/// Past the string whose `"` is at `i` (its line's end if it has no closing quote).
fn dsl_string_end(s: Str, i: I32) I32 {
    let j = i + 1
    while (j < s.len() and s.get(j) != 34 and s.get(j) != 10) {
        j += if s.get(j) == 92 and code_at(s, j + 1) != 10 { 2 } else { 1 }
    }
    return if code_at(s, j) == 34 { j + 1 } else { j }
}

/// The `\/` closing the envelope whose payload starts at `start`, or -1.
fn dsl_close(s: Str, start: I32) I32 {
    let depth = 1
    let i = start
    while (i < s.len() - 1) {
        if s.get(i) == 34 {
            i = dsl_string_end(s, i) - 1
        } else if s.get(i) == 47 and s.get(i + 1) == 92 {
            if named_opener(s, start, i) { depth += 1 }
            i += 1
        } else if s.get(i) == 92 and s.get(i + 1) == 47 {
            depth -= 1
            if depth == 0 { return i }
            i += 1
        }
        i += 1
    }
    return -1
}

/// Past the DSL literal at `start` (which has its opener); throws when it is unterminated.
fn dsl_skip(s: Str, start: I32) I32 {
    let close = dsl_close(s, opener_end(s, start))
    if close < 0 { dsl_throw() }
    return close + 2
}

/// The `@wutu` literals' payloads of the file being laid out: start, end.
vec fw_islands: I32

/// Each `@wutu` literal of `source`, ignoring comments (`//`, `\\`) and strings.
/// An unterminated one runs to the end; nested ones are their payload's.
fn find_islands(source: Str) Void {
    fw_islands.clear()
    let n = source.len()
    let i = 0
    while (i < n) {
        if text_at(source, i, "//") or text_at(source, i, "\\\\") {
            let end = text_index(source, "\n", i)
            i = if end < 0 { n } else { end + 1 }
        } else if source.get(i) == 34 {
            i += 1
            while (i < n and source.get(i) != 34 and source.get(i) != 10) { i += if source.get(i) == 92 { 2 } else { 1 } }
            i += 1
        } else {
            let start = opener_end(source, i)
            if start < 0 {
                i += 1
            } else {
                let close = dsl_close(source, start)
                let end = if close < 0 { n } else { close }
                let name = i + 1
                while (is_word_code(source.get(name))) { name += 1 }
                if source.slice(i + 1, name) == "wutu" {
                    fw_islands.push(start)
                    fw_islands.push(end)
                }
                i = if close < 0 { end } else { end + 2 }
            }
        }
    }
}

//! == Templates

/// The template being laid out, its lines so far, and whether it is a
/// page's (its `@style` and `@document` go first inside its `html`, once).
let fb_source: Str = ""
let fb_lines: Array[Str] = Array[Str].new(0, "")
let fb_count: I32 = 0
let fb_page_css: Bool = false

/// A line at `depth`. (One ending open, as `x = item.` does, would go on to
/// the next: its `;` stays.)
fn fb_add(depth: I32, text: Str) Void => fb_push(indent(depth) + text + (if ends_open(text) { ";" } else { "" }))

fn fb_push(line: Str) Void {
    fb_lines = grown_strs(fb_lines, fb_count)
    fb_lines[fb_count] = line
    fb_count += 1
}

fn fb_flush(depth: I32, current: Str) Void {
    let t = current.trim()
    if t.len() > 0 { fb_add(depth, t) }
}

/// Whether `code` (strings masked) has a comment: `//`, `/*`, or a `#` or
/// `\\` first on a line.
fn has_comment(code: Str) Bool {
    if text_index(code, "//", 0) >= 0 or text_index(code, "/*", 0) >= 0 { return true }
    let first = true
    for (0 ..< code.len()) |i| {
        let c = code.get(i)
        if is_js_space(c) {
            if is_line_end(c) { first = true }
        } else {
            if first and (c == 35 or (c == 92 and code_at(code, i + 1) == 92)) { return true }
            first = false
        }
    }
    return false
}

/// `s` with each string on one line as `""`.
fn mask_line_strings(s: Str) Str {
    let out = ""
    let from = 0
    let i = 0
    while (i < s.len()) {
        let end = quoted_end(s, i, 34, true, false)
        if end > 0 {
            out = out + s.slice(from, i) + "\"\""
            from = end
            i = end
        } else {
            i += 1
        }
    }
    return out + s.slice(from, s.len())
}

/// A template laid out (`page`: a top-level `html { … }`, whose `@document`
/// blocks stay inside it), from its first line's start. One with comments
/// is left as written. Throws when it does not parse.
fn format_wutu_body(source: Str, page: Bool) Str {
    // Comments carry meaning for authors: a body with one is kept.
    let code = mask_line_strings(source)
    if has_comment(code) { return source }
    // (An opener in a string is text: strings are masked as they are.)
    for (0 ..< code.len()) |i| { if opener_end(code, i) >= 0 { return format_with_payloads(source, page) } }
    let root = parse_template(source)
    return format_template(source, root, page)
}

/// Format around nested DSL literals, which are restored byte for byte.
fn format_with_payloads(source: Str, page: Bool) Str {
    let payloads = Array[Str].new(0, "")
    let count = 0
    let masked = ""
    let from = 0
    let i = 0
    while (i < source.len()) {
        if source.get(i) == 34 {
            let end = string_end(source, i)
            if end < 0 { return source }
            i = end + 1
        } else if opener_end(source, i) >= 0 {
            let end = dsl_skip(source, i)
            masked = masked + source.slice(from, i) + "__wutu_payload_" + count.str()
            payloads = grown_strs(payloads, count)
            payloads[count] = source.slice(i, end)
            count += 1
            i = end
            from = end
        } else {
            i += 1
        }
    }
    let formatted = format_wutu_body(masked + source.slice(from, source.len()), page)
    // Each `__wutu_payload_N` back (one past the last is JavaScript's undefined).
    let out = ""
    from = 0
    let k = text_index(formatted, "__wutu_payload_", 0)
    while (k >= 0) {
        let d = k + 15
        let e = d
        while (e < formatted.len() and formatted.get(e) >= 48 and formatted.get(e) <= 57) { e += 1 }
        if e > d {
            let index = if e - d > 9 { count } else { formatted.slice(d, e).parse_i32(count) }
            out = out + formatted.slice(from, k) + (if index < count { payloads[index] } else { "undefined" })
            from = e
        }
        k = text_index(formatted, "__wutu_payload_", if e > d { e } else { k + 1 })
    }
    return out + formatted.slice(from, formatted.len())
}

/// The parsed template `source` (its root `root`), laid out.
fn format_template(source: Str, root: I32, page: Bool) Str {
    fb_source = source
    fb_count = 0
    fb_page_css = false
    if tw_scope >= 0 { fb_add(0, "@island " + word_text(tw_scope)) }
    else if text_at(source, skip_js_spaces(source, 0), "@reactive") { fb_add(0, "@reactive") }
    // (A page's go first inside its `html`: see fb_element.)
    if page and tn_kind[root] == 4 and word_text(tn_text[root]) == "html" { fb_page_css = true } else { fb_head_css(0) }
    for (0 ..< tw_let_head.len()) |k| { fb_add(0, "let " + word_text(tw_let_head[k]) + " = " + compact(word_text(tw_let_value[k]))) }
    fb_node(root, 0)
    return "\n" + joined(fb_lines, fb_count, "\n") + "\n"
}

/// The template's `@style` uses and `@document` blocks, at `depth`.
fn fb_head_css(depth: I32) Void {
    for (0 ..< tw_style_value.len()) |k| { fb_add(depth, "@style " + compact(word_text(tw_style_value[k]))) }
    for (0 ..< tw_global.len()) |k| { fb_block("@document {" + word_text(tw_global[k]) + "}", depth, false) }
}

/// Lay out raw CSS or Utu code one statement per line, indenting by brace
/// depth, with no `;` at a line's end (a statement ends at a `;` or a line
/// break that ends it). In code (`code`), commas between block-level items
/// also break lines.
fn fb_block(text: Str, at_depth: I32, code: Bool) Void {
    let depth = at_depth
    let current = ""
    let quote = 0
    let parens = 0
    let braces = Array[I32].new(16, 0)
    let nb = 0
    let n = text.len()
    let i = 0
    // In CSS, where the statement starts: a line indented past its line goes on with it.
    let first = 0
    while (i < n) {
        let c = text.get(i)
        // Where the next character is.
        let next = i + 1
        if not code and not is_js_space(c) and current.trim().len() == 0 { first = i }
        if quote != 0 {
            current = current + text.slice(i, i + 1)
            if c == 92 and i + 1 < n {
                current = current + text.slice(i + 1, i + 2)
                next = i + 2
            } else if c == quote {
                quote = 0
            }
        } else if code and text_at(text, i, "//") {
            let end = line_end(text, i)
            fb_flush(depth, current + text.slice(i, end))
            current = ""
            next = end + 1
        } else if code and text_at(text, i, "/*") {
            let end = text_index(text, "*/", i + 2)
            if end < 0 { dsl_throw() }
            current = current + text.slice(i, end + 2)
            next = end + 2
        } else if code and c == 96 {
            let end = template_end(text, i)
            if end < 0 { dsl_throw() }
            current = current + text.slice(i, end)
            next = end
        } else if c == 34 or (not code and c == 39) {
            quote = c
            current = current + text.slice(i, i + 1)
        } else {
            if c == 40 or c == 91 { parens += 1 }
            if c == 41 or c == 93 { parens -= 1 }
            // A CSS rule written on one line stays on one: `body { margin: 0 }`.
            let rule = if not code and c == 123 { css_one_line_rule(text, i) } else { -1 }
            let inner = if rule > 0 { text.slice(i + 1, rule - 1) } else { "" }
            let struct_ = if code and c == 123 { one_line_struct(current, text, i) } else { "" }
            if rule > 0 and inner.trim().len() > 0 and text_index(inner, "//", 0) < 0 and 4 * depth + current.trim().len() + rule - i <= 100 {
                current = current.trim() + " { " + css_rule_body(inner) + " }"
                fb_flush(depth, current)
                current = ""
                next = rule
            } else if struct_.len() > 0 and 4 * depth + current.len() + struct_.len() <= 100 {
                current = current.trim_end() + " " + compact(struct_)
                next = i + struct_.len()
            } else {
                let body = if code and c == 123 { one_line_body(text, i) } else { "" }
                if body.len() > 0 {
                    // A one-line body stays as written.
                    current = current.trim_end() + " " + body
                    next = i + body.len()
                } else if c == 123 {
                    braces = grown_codes(braces, nb)
                    braces[nb] = parens
                    nb += 1
                    fb_flush(depth, current.trim_end() + " {")
                    current = ""
                    depth += 1
                } else if c == 125 {
                    if nb > 0 { nb -= 1 }
                    fb_flush(depth, current)
                    depth -= 1
                    current = "}"
                    // (What is written right after it, `}app`, stays with it: a line break there would end it.)
                    if not closer_goes_on(text, i + 1) {
                        fb_flush(depth, current)
                        current = ""
                    }
                } else if c == 59 and parens == 0 {
                    fb_flush(depth, current)
                    current = ""
                } else if c == 10 and parens == 0 and current.trim().len() > 0 and ends_line(current, text, i + 1, code)
                        and (code or indent_at(text, next_token(text, i + 1)) <= indent_at(text, first)) {
                    fb_flush(depth, current)
                    current = ""
                } else if c == 44 and code and nb > 0 and braces[nb - 1] == parens and not in_captures(current) and not between_patterns(current, text, i + 1) {
                    // (An item's `,` ends its line: no `;` after it.)
                    fb_push(indent(depth) + current.trim() + ",")
                    current = ""
                } else if is_js_space(c) {
                    if current.len() > 0 and not current.ends_with(" ") { current = current + " " }
                } else {
                    current = current + text.slice(i, i + 1)
                }
            }
        }
        i = next
    }
    fb_flush(depth, current)
}

/// `a` with room for `n` + 1 codes.
fn grown_codes(a: Array[I32], n: I32) Array[I32] {
    if n < a.len() { return a }
    let b = Array[I32].new(a.len() * 2 + 16, 0)
    for (0 ..< a.len()) |k| { b[k] = a[k] }
    return b
}

/// Past the `{ … }` at `i` written on one line with no braces or quotes in it, or -1.
fn css_one_line_rule(text: Str, i: I32) I32 {
    let k = i + 1
    while (k < text.len() and not has_code("{}\n\"'`", text.get(k))) { k += 1 }
    return if code_at(text, k) == 125 { k + 1 } else { -1 }
}

/// A one-line rule's declarations: spaces collapsed, no `;` at the end.
fn css_rule_body(inner: Str) Str {
    let t = inner.trim()
    let codes = Array[I32].new(t.len(), 0)
    let k = 0
    for (0 ..< t.len()) |i| {
        let c = t.get(i)
        if is_js_space(c) {
            if not is_js_space(t.get(i - 1)) {
                codes[k] = 32
                k += 1
            }
        } else {
            codes[k] = c
            k += 1
        }
    }
    while (k > 0 and (codes[k - 1] == 32 or codes[k - 1] == 59)) { k -= 1 }
    return Str.from_codes(codes, k)
}

/// Whether what follows a `}` at `i` stays on its line: `,`, `)` or `else`
/// (past blanks), or a word, string, `(`, `[` or `.` right after it.
fn closer_goes_on(text: Str, i: I32) Bool {
    let j = skip_js_spaces(text, i)
    let c = code_at(text, j)
    if c == 44 or c == 41 or word_at(text, j, "else") { return true }
    let d = code_at(text, i)
    return is_word_code(d) or d == 34 or d == 40 or d == 91 or d == 46
}

fn fb_children(n: I32, depth: I32) Void {
    let c = tn_first[n]
    while (c >= 0) {
        fb_node(c, depth)
        c = tn_next[c]
    }
}

fn fb_node(n: I32, depth: I32) Void {
    let kind = tn_kind[n]
    if kind == 5 { fb_children(n, depth) }
    else if kind == 0 { fb_block(word_text(tn_text[n]), depth, true) }
    else if kind == 1 { fb_block(sigil_of(n) + " " + word_text(tn_text[n]), depth, true) }
    else if kind == 2 { fb_if(n, depth, "if") }
    else if kind == 3 { fb_for(n, depth) }
    else if kind == 6 { fb_match(n, depth) }
    else { fb_element(n, depth) }
}

/// An expression node's `|` or `|>`, as written.
fn sigil_of(n: I32) Str => if text_at(fb_source, tn_start[n], "|>") { "|>" } else { "|" }

/// Whether if node `e`, an if's otherwise, is written `else if` (not `else { if … }`).
fn is_else_if(e: I32) Bool {
    if tn_kind[e] != 2 or tn_next[e] >= 0 { return false }
    let k = tn_start[e]
    while (k > 0 and is_js_space(fb_source.get(k - 1))) { k -= 1 }
    return k >= 4 and fb_source.slice(k - 4, k) == "else"
}

fn fb_if(n: I32, depth: I32, keyword: Str) Void {
    fb_add(depth, keyword + " " + grouped(compact(word_text(tn_text[n])), "{") + " {")
    fb_children(n, depth + 1)
    let e = tn_else[n]
    if e >= 0 and is_else_if(e) {
        fb_if(e, depth, "} else if")
        return
    }
    if e >= 0 {
        fb_add(depth, "} else {")
        while (e >= 0) {
            fb_node(e, depth + 1)
            e = tn_next[e]
        }
    }
    fb_add(depth, "}")
}

fn fb_for(n: I32, depth: I32) Void {
    let key = if tn_key[n] >= 0 { " key " + (if tn_global[n] == 1 { "global " } else { "" }) + grouped(compact(word_text(tn_key[n])), "{") } else { "" }
    fb_add(depth, "for " + grouped(compact(word_text(tn_text[n])), "{|") + " |" + word_text(tn_captures[n]) + "|" + key + " {")
    fb_children(n, depth + 1)
    fb_add(depth, "}")
}

fn fb_match(n: I32, depth: I32) Void {
    fb_add(depth, "match " + grouped(compact(word_text(tn_text[n])), "{") + " {")
    let arm = tn_first[n]
    while (arm >= 0) {
        fb_add(depth + 1, if tn_text[arm] < 0 { "~> {" } else { word_text(tn_text[arm]) + " => {" })
        fb_children(arm, depth + 2)
        fb_add(depth + 1, "}")
        arm = tn_next[arm]
    }
    fb_add(depth, "}")
}

/// Whether item `i` is an `#id` written in its element's head.
fn is_shorthand_id(i: I32) Bool {
    if ti_kind[i] != 1 or ti_flags[i] != 0 or word_text(ti_a[i]) != "id" { return false }
    let name = word_text(ti_b[i])
    let at = ti_at[i] - (name.len() - 2) - 1
    return code_at(fb_source, at) == 35 and text_at(fb_source, at + 1, name.slice(1, name.len() - 1))
}

/// Whether CSS item `i` is a declaration (`color: red`), not a rule or an at-rule.
fn is_declaration(i: I32) Bool => not has_code(":@&", word_text(ti_b[i]).get(0))

/// The declaration at `start`, as written (to its `;`, or its line's blanks).
fn declaration_text(start: I32) Str {
    let text = fb_source
    wp_at = start
    let head = wp_css_until(text, wps(Wpt.ColonBraceBraceEndSemi), false, -1)
    wp_at += 1
    wp_trivia(text)
    let _ = wp_css_until(text, if text_at(head, 0, "--") { ";}" } else { wps(Wpt.SemiBraceBraceEnd) }, true, indent_at(text, start))
    wp_end(text)
    return text.slice(start, wp_at)
}

fn fb_element(n: I32, depth: I32) Void {
    let tag = word_text(tn_text[n])
    let classes = ""
    let ids = ""
    let i = tn_items[n]
    while (i >= 0) {
        if ti_kind[i] == 0 { classes = classes + "." + word_text(ti_a[i]) }
        else if is_shorthand_id(i) {
            let value = word_text(ti_b[i])
            ids = ids + "#" + value.slice(1, value.len() - 1)
        }
        i = ti_next[i]
    }
    let head = tag + classes + ids + (if tn_binding[n] >= 0 { " as " + word_text(tn_binding[n]) } else { "" }) + " {"
    fb_add(depth, head)
    let from = fb_count
    if fb_page_css and tag == "html" {
        fb_head_css(depth + 1)
        fb_page_css = false
    }
    // Each item where its author put it.
    i = tn_items[n]
    let c = tn_first[n]
    while (i >= 0 or c >= 0) {
        if i >= 0 and (c < 0 or ti_at[i] <= tn_start[c]) {
            fb_item(i, depth + 1)
            i = ti_next[i]
        } else {
            fb_node(c, depth + 1)
            c = tn_next[c]
        }
    }
    // An element written on one line, of one-line items, stays on one: `meta { name = "x"; content = "y" }`.
    if fb_count > from and element_on_one_line(n) {
        let inner = Array[Str].new(fb_count - from, "")
        let fits = true
        for (from ..< fb_count) |k| {
            let t = fb_lines[k].slice(4 * (depth + 1), fb_lines[k].len())
            inner[k - from] = t
            if t.len() > 0 and (is_js_space(t.get(0)) or has_code("{};", t.get(t.len() - 1))) { fits = false }
        }
        let line = head + " " + joined(inner, fb_count - from, "; ") + " }"
        if fits and 4 * depth + line.len() <= 100 {
            fb_count = from - 1
            fb_add(depth, line)
            return
        }
    }
    fb_add(depth, "}")
}

/// Whether element `n` is written on one line, head to `}`.
fn element_on_one_line(n: I32) Bool {
    let start = tn_start[n]
    let open = text_index(fb_source, "{", start)
    if open < 0 { return false }
    let end = wutu_brace_end_at(fb_source, open)
    return end > 0 and text_index(fb_source.slice(start, end), "\n", 0) < 0
}

fn fb_item(i: I32, depth: I32) Void {
    let kind = ti_kind[i]
    let a = word_text(ti_a[i])
    let b = word_text(ti_b[i])
    if kind == 1 {
        if is_shorthand_id(i) { return }
        let property = (ti_flags[i] & 1) != 0
        let dynamic = (ti_flags[i] & 2) != 0
        if a == "data-wutu-unmanaged" and not text_at(fb_source, ti_at[i], a) {
            fb_add(depth, "@unmanaged")
            return
        }
        // `for = …` would open a loop: an attribute named like a keyword keeps its `=` tight.
        let eq = if not property and (a == "if" or a == "for") { "=" } else { " = " }
        if not property and not dynamic and b == "\"\"" { fb_add(depth, a) }
        else { fb_add(depth, (if property { "." } else { "" }) + a + eq + (if dynamic { compact(b) } else { b })) }
    } else if kind == 4 {
        fb_block(if is_declaration(i) { declaration_text(ti_at[i]) } else { b }, depth, false)
    } else if kind == 5 {
        fb_block(a + ": " + b, depth, true)
    } else if kind == 3 {
        fb_add(depth, "bind:" + a + " = " + compact(b))
    } else if kind == 2 {
        let head = "on " + a + (if (ti_flags[i] & 4) != 0 { " quiet" } else { "" })
        if (ti_flags[i] & 1) != 0 { fb_block(head + (if ti_c[i] >= 0 { " |" + word_text(ti_c[i]) + "|" } else { "" }) + " " + b, depth, true) }
        else { fb_block(head + " = " + b, depth, true) }
    }
}

//! == Keeping a template's meaning

/// The Wutu words a following name or `=` would change: `for =` is a loop, `for=` an attribute.
fn is_wutu_word(w: Str) Bool => in_words("if for else as key global on quiet match", w)

/// Whether `b` is `a` with only whitespace (and `;`, which a line break
/// replaces) changed, and only beside `{`, `}`, `;` or `=` (never after a
/// keyword), never inside a string; and both parse to the same tree.
fn same_wutu(a: Str, b: Str) Bool {
    let i = 0
    let j = 0
    let quoted = 0
    let prev = -1
    while (true) {
        let si = i
        let sj = j
        if quoted == 0 {
            while (i < a.len() and (is_js_space(a.get(i)) or a.get(i) == 59)) { i += 1 }
            while (j < b.len() and (is_js_space(b.get(j)) or b.get(j) == 59)) { j += 1 }
        }
        if i >= a.len() or j >= b.len() { return i == a.len() and j == b.len() and quoted == 0 and same_wutu_tree(a, b) }
        let c = a.get(i)
        if c != b.get(j) { return false }
        if prev >= 0 and (i > si) != (j > sj) {
            if not has_code("{};=", prev) and not has_code("{};=", c) { return false }
            let w = si
            while (w > 0 and is_name_code(a.get(w - 1))) { w -= 1 }
            let word = a.slice(w, si)
            // (`else{` and `else {` are one: only a word that a following name or `=` would change is kept.)
            if is_wutu_word(word) and not ((word == "else" or word == "quiet") and c == 123) { return false }
        }
        if quoted == c { quoted = 0 }
        else if quoted == 0 and (c == 34 or c == 39 or c == 96) { quoted = c }
        else if quoted != 0 and c == 92 {
            if code_at(a, i + 1) != code_at(b, j + 1) { return false }
            i += 1
            j += 1
        }
        prev = code_at(a, i)
        i += 1
        j += 1
    }
    return false
}

/// Both texts parse as Wutu to the same tree, positions and whitespace aside.
fn same_wutu_tree(a: Str, b: Str) Bool {
    let shape = wutu_shape(a)
    return shape.len() > 0 and shape == wutu_shape(b)
}

/// The tree of template `text`, stripped (see template_json), or "" when it does not parse.
fn wutu_shape(text: Str) Str {
    let shape = ""
    try { shape = template_json(text, true) } catch { shape = "" }
    return shape
}

//! == A template's tree

/// `s` as a JSON string.
fn json_quoted(s: Str) Str {
    let codes = Array[I32].new(s.len() * 6 + 2, 0)
    let k = 0
    codes[k] = 34
    k += 1
    for (0 ..< s.len()) |i| {
        let c = s.get(i)
        if c == 34 or c == 92 {
            codes[k] = 92
            codes[k + 1] = c
            k += 2
        } else if c < 32 {
            let hex = "0123456789abcdef"
            for ([92, 117, 48, 48, hex.get(c >> 4), hex.get(c & 15)]) |d| {
                codes[k] = d
                k += 1
            }
        } else {
            codes[k] = c
            k += 1
        }
    }
    codes[k] = 34
    return Str.from_codes(codes, k + 1)
}

/// `s` without whitespace or `;` (`strip`), as JSON.
fn json_word(s: Str, strip: Bool) Str {
    if not strip { return json_quoted(s) }
    let codes = Array[I32].new(s.len(), 0)
    let k = 0
    for (0 ..< s.len()) |i| {
        let c = s.get(i)
        if not is_js_space(c) and c != 59 {
            codes[k] = c
            k += 1
        }
    }
    return json_quoted(Str.from_codes(codes, k))
}

/// Word `w` as JSON (null for none).
fn json_of(w: I32, strip: Bool) Str => if w < 0 { "null" } else { json_word(word_text(w), strip) }

/// `"from":…,"to":…`, unless `strip`.
fn json_range(from: I32, to: I32, strip: Bool) Str => if strip { "" } else { ",\"from\":" + from.str() + ",\"to\":" + to.str() }

/// Template `text`'s tree as JSON (it throws when it does not parse): its
/// head (`reactive`, `scope`, `styles`, `documents`, `lets`) and `root`.
/// Each node has its `kind` (text expression if for match arm element
/// fragment), `text` (the literal, expression, condition, iterable, tag or
/// pattern) and `children`; an element its `items`, each a `kind` (class
/// attribute event bind css style) with `a`, `b`, `c` and `flags`, as
/// wutu_parse.utu's tables have them. `strip`: no positions, and no
/// whitespace or `;` in any text, as when two are compared.
fn template_json(text: Str, strip: Bool) Str {
    let root = parse_template(text)
    fb_source = text
    let styles = ""
    for (0 ..< tw_style_value.len()) |k| { styles = styles + (if k > 0 { "," } else { "" }) + json_of(tw_style_value[k], strip) }
    let documents = ""
    for (0 ..< tw_global.len()) |k| { documents = documents + (if k > 0 { "," } else { "" }) + json_of(tw_global[k], strip) }
    let lets = ""
    for (0 ..< tw_let_head.len()) |k| {
        lets = lets + (if k > 0 { "," } else { "" }) + "{\"head\":" + json_of(tw_let_head[k], strip) + ",\"value\":" + json_of(tw_let_value[k], strip) + json_range(tw_let_from[k], tw_let_to[k], strip) + "}"
    }
    return "{\"reactive\":" + tw_reactive.str() + ",\"scope\":" + json_of(tw_scope, strip) + ",\"styles\":[" + styles + "],\"documents\":[" + documents + "],\"lets\":[" + lets + "],\"root\":" + json_node(root, strip) + "}"
}

/// Nodes from `n` on (siblings), as a JSON array.
fn json_nodes(n: I32, strip: Bool) Str {
    let out = ""
    let c = n
    while (c >= 0) {
        out = out + (if c != n { "," } else { "" }) + json_node(c, strip)
        c = tn_next[c]
    }
    return "[" + out + "]"
}

fn json_node(n: I32, strip: Bool) Str {
    let kind = tn_kind[n]
    let names = ["text", "expression", "if", "for", "element", "fragment", "match", "arm"]
    let out = "{\"kind\":\"" + names[kind] + "\",\"text\":" + json_of(tn_text[n], strip) + json_range(tn_from[n], tn_to[n], strip)
    if kind == 1 { out = out + ",\"sigil\":\"" + sigil_of(n) + "\"" }
    if kind == 2 { out = out + ",\"elseIf\":" + (if tn_parent[n] >= 0 and tn_else[tn_parent[n]] == n and is_else_if(n) { "true" } else { "false" }) + ",\"otherwise\":" + json_nodes(tn_else[n], strip) }
    if kind == 3 { out = out + ",\"captures\":" + json_of(tn_captures[n], strip) + ",\"key\":" + json_of(tn_key[n], strip) + ",\"global\":" + tn_global[n].str() }
    if kind == 4 {
        out = out + ",\"binding\":" + json_of(tn_binding[n], strip) + ",\"items\":["
        let i = tn_items[n]
        while (i >= 0) {
            let kinds = ["class", "attribute", "event", "bind", "css", "style"]
            let flags = ti_flags[i] + (if is_shorthand_id(i) { 8 } else { 0 })
            out = out + (if i != tn_items[n] { "," } else { "" }) + "{\"kind\":\"" + kinds[ti_kind[i]] + "\",\"a\":" + json_of(ti_a[i], strip) + ",\"b\":" + json_of(ti_b[i], strip) + ",\"c\":" + json_of(ti_c[i], strip) + ",\"flags\":" + flags.str() + json_range(ti_from[i], ti_to[i], strip) + "}"
            i = ti_next[i]
        }
        out = out + "]"
    }
    return out + ",\"children\":" + json_nodes(tn_first[n], strip) + "}"
}

/// Template `text`'s tree as JSON (template_json), or `{"error":…,"at":…}`: the
/// syntax error and its offset in the text.
fn wutu_tree(text: Str) Str {
    let out = ""
    try { out = template_json(text, false) } catch { out = "{\"error\":" + json_quoted(word_text(dsl_err_message)) + ",\"at\":" + dsl_err_offset.str() + "}" }
    return out
}

//! == A file's islands

/// `source` with each `@wutu` island laid out. An island keeps its text when
/// its layout would change more than whitespace at `{`, `}`, `;` and `=`, or
/// would parse differently, or does not parse.
fn format_wutu_source(text: Str) Str {
    let source = text
    find_islands(source)
    let spans = Array[I32].new(fw_islands.len(), 0)
    for (0 ..< fw_islands.len()) |k| { spans[k] = fw_islands[k] }
    let k = spans.len() - 2
    while (k >= 0) {
        let start = spans[k]
        let end = spans[k + 1]
        k -= 2
        let body = source.slice(start, end)
        let formatted = ""
        let ok = false
        try {
            formatted = format_wutu_body(body, false)
            ok = true
        } catch { ok = false }
        if ok and formatted != body {
            // The island's line's indent.
            let line = source.slice(0, start).last_index_of("\n") + 1
            let indent_ = source.slice(line, skip_js_spaces_to(source, line, start))
            let lines = formatted.split("\n")
            for (1 ..< lines.len()) |m| { if lines[m].len() > 0 { lines[m] = indent_ + lines[m] } }
            let reindented = "\n".join(lines) + indent_
            if same_wutu(body, reindented) { source = source.slice(0, start) + reindented + source.slice(end, source.len()) }
        }
    }
    return source
}

/// Past the JavaScript white space from `i`, up to `end`.
fn skip_js_spaces_to(s: Str, i: I32, end: I32) I32 {
    let j = i
    while (j < end and is_js_space(s.get(j))) { j += 1 }
    return j
}

/// A Wutu body's lines (`{ … }`, of a top-level `html`, `page`, or of a
/// `wn`), laid out as Wutu, relative to the body's own indent; "" with
/// @wb_kept to keep it as written.
let wb_kept: Bool = false
/// (And no lines: a page's `html {}`.)
let wb_none: Bool = false

fn wutu_body_lines(body: Str, page: Bool) Str {
    wb_kept = true
    wb_none = false
    let text = if page { "html " + body } else { body.slice(1, body.len() - 1) }
    let out = ""
    let ok = false
    try {
        out = format_wutu_body(text, page)
        ok = true
    } catch { ok = false }
    if not ok or out == text or not same_wutu(text, out) { return "" }
    wb_kept = false
    if text_at(out, 0, "\n") { out = out.slice(1, out.len()) }
    if out.ends_with("\n") { out = out.slice(0, out.len() - 1) }
    if not page { return out }
    let lines = out.split("\n")
    wb_none = lines.len() <= 2
    if wb_none { return "" }
    let inner = Array[Str].new(lines.len() - 2, "")
    for (1 ..< lines.len() - 1) |m| { inner[m - 1] = lines[m].slice(4, lines[m].len()) }
    return "\n".join(inner)
}

//! == Completions

/// The completion words at `offset` of `source`, by kind: `event` and the
/// events after `on `, else `tag` and the tags then `attribute` and the
/// attributes, a line each; "" outside a `@wutu` island.
fn wutu_completion_words(source: Str, offset: I32) Str {
    find_islands(source)
    let k = 0
    while (k < fw_islands.len() and not (offset >= fw_islands[k] and offset <= fw_islands[k + 1])) { k += 2 }
    if k >= fw_islands.len() { return "" }
    let prefix = source.slice(fw_islands[k], offset)
    // `on ` then a name so far.
    let e = prefix.len()
    while (e > 0 and is_word_code(prefix.get(e - 1))) { e -= 1 }
    let s = e
    while (s > 0 and is_js_space(prefix.get(s - 1))) { s -= 1 }
    if s < e and s >= 2 and prefix.slice(s - 2, s) == "on" and (s == 2 or not is_word_code(prefix.get(s - 3))) {
        return "event\n" + wps(Wpt.ClickDblclickAuxclickContextmenuMousedow)
    }
    let tags = wps(Wpt.HtmlHeadEmbedParamScriptArea)
    let names = wps(Wpt.IdClassTitleRoleTabindexHidden)
    for (tags.split(" ")) |tag| {
        for (tag_attributes(tag).split(" ")) |name| {
            if name.len() > 0 and not in_words(names, name) { names = names + " " + name }
        }
    }
    let attributes = ""
    for (names.split(" ")) |name| {
        if not in_words(tags, name) { attributes = attributes + (if attributes.len() > 0 { " " } else { "" }) + name }
    }
    return "tag\n" + tags + "\nattribute\n" + attributes
}
