        Wpt.AndOrXorNotOrelseElse => "and or xor not orelse else in",
        Wpt.PlusStarSlashPctLtGtBarCaretTildeBang => "+*/%<>|^~!",
        Wpt.AndOrXorOrelseElseCatch => "and or xor orelse else catch",
        Wpt.Collect => "collect",
        Wpt.MapFilterSkipTakeSkipWhile => "map filter skip take skip_while take_while scan zip chain flat_map repeat fold each any all count_where first_index last_index sum fast_sum product count sort group_by distinct_by partition batched windows min_by max_by first_where reduce bisect",
