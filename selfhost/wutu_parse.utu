    \\unicode-bidi user-select vector-effect vertical-align view-timeline view-timeline-axis view-timeline-inset view-timeline-name view-transition-class
    \\view-transition-name visibility white-space white-space-collapse widows width will-change word-break word-spacing word-wrap writing-mode x y z-index
    \\zoom
}

/// The catalogs, from the string table (see strtab.utu).
fn css_properties() Str => st(st_web)
fn dom_events() Str => st(st_web + 1)

/// The word of `list` one edit (or swap of neighbors) from `w`, unless `w`
/// is in it, or "": a typo. (Two edits from a known word is likely a real
/// word the list lacks: `marker-side`, `column-wrap`, an event `unmount`.)
fn typo_of(list: Str, w: Str) Str {
    if in_words(list, w) { return "" }
    let near = closest_word(list, w)
    if near.len() > 0 and word_distance(intern_text(near), intern_text(w), 3) > 1 { return "" }
    return near
}

/// An invalid property name fails; so does a typo of a standard one (names
/// are ASCII case-insensitive; a prefixed or custom one, `-webkit-…` or
/// `--x`, is not checked).
fn css_property_known(head: Str, at: I32) Void {
    let name = if text_at(head, 0, "--") { head } else { lower_text(head) }
    if not is_css_property(name) { wutu_fail(wps(Wpt.InvalidCSSProperty), at) }
    let near = if name.get(0) == 45 { "" } else { typo_of(css_properties(), name) }
    if near.len() > 0 { wutu_fail(wps2(Wpt.InvalidCSSPropertyDidYouMean, head, near), at) }
}

/// A value (`text[from ..< to]`) with a second declaration on its line
/// (`red margin: 0`: a standard property's value has no `:` outside `()`),
/// which needs a `;` between. A custom property's (`custom`) may hold
/// anything balanced.
fn css_value_runs_on(text: Str, from: I32, to: I32, custom: Bool) Void {
    if custom { return }
    let depth = 0
    let i = from
    while (i < to) {
        let c = text.get(i)
        if c == 34 or c == 39 {
            i += 1
            while (i < to and text.get(i) != c) { i += if text.get(i) == 92 { 2 } else { 1 } }
        } else if text_at(text, i, "/*") {
            let close = text_index(text, "*/", i + 2)
            i = if close < 0 { to } else { close + 1 }
        } else if c == 40 or c == 91 or c == 123 { depth += 1 }
        else if c == 41 or c == 93 or c == 125 { depth -= 1 }
        else if c == 58 and depth == 0 {
            let end = i
            while (end > from and is_name_code(text.get(end - 1))) { end -= 1 }
            while (end > from and is_space_code(text.get(end - 1))) { end -= 1 }
            wutu_fail(wps(Wpt.TwoCSSDeclarationsOnOneLine), end)
        }
        i += 1
    }
}

//! = The parser

fn wp_done(text: Str) Bool => wp_at >= text.len()

fn wp_char(text: Str) I32 => if wp_at < text.len() { text.get(wp_at) } else { -1 }

fn wp_at_text(text: Str, part: Str) Bool => text_at(text, wp_at, part)

/// A word then whitespace at the cursor (`if `, `for `, `as `), not consumed.
fn wp_keyword(text: Str, word: Str) Bool {
    let i = wp_at
    return text_at(text, i, word) and i + word.len() < text.len() and is_space_code(text.get(i + word.len()))
}

/// Whether offset p starts the text or follows a blank (a `//` there is a
/// comment, not `url(http://…)`).
fn wp_after_blank(text: Str, p: I32) Bool => p == 0 or is_space_code(text.get(p - 1))

/// Whitespace, `//` comments (first on a line or after a blank), and CSS comments.
fn wp_trivia(text: Str) Void {
    while (wp_at < text.len()) {
        let p = wp_at
        let c = text.get(p)
        if is_space_code(c) {
            wp_at += 1
        } else if text_at(text, p, "//") and wp_after_blank(text, p) {
            wp_skip_line(text)
        } else if c == 35 and p + 1 < text.len() and (text.get(p + 1) == 32 or text.get(p + 1) == 9) {
            wutu_fail(wps(Wpt.WutuCommentsAreWritten), p)
        } else if text_at(text, p, "/*") {
            let end = text_index(text, "*/", p + 2)
            if end < 0 { wutu_fail(wps(Wpt.UnterminatedComment), p) }
            wp_at = end + 2
        } else {
            return
        }
    }
}

fn wp_skip_line(text: Str) Void {
    let end = text_index(text, "\n", wp_at)
    wp_at = if end < 0 { text.len() } else { end }
}

/// A statement's end, as utu's: a line break, `;` (two on one line), the `}`
/// closing its block, or the template's end. `;` is consumed; the rest stay.
fn wp_end(text: Str) Void {
    let statement_end = wp_at
    let i = line_rest(text, statement_end)
    if i >= text.len() or text.get(i) == 10 or text.get(i) == 125 {
        wp_at = i
        return
    }
    if text.get(i) != 59 { wutu_fail(wps(Wpt.ExpectedALineBreakOrAfter), statement_end) }
    wp_at = i + 1
}

/// Past spaces, tabs, and comments from i, on its line: where its line break,
/// or what is next on the line, is.
fn line_rest(text: Str, i: I32) I32 {
    let j = i
    while (j < text.len()) {
        let c = text.get(j)
        if c == 32 or c == 9 or c == 13 {
            j += 1
        } else if text_at(text, j, "/*") {
            let end = text_index(text, "*/", j + 2)
            if end < 0 { return text.len() }
            j = end + 2
        } else if text_at(text, j, "//") and wp_after_blank(text, j) {
            let end = text_index(text, "\n", j)
            return if end < 0 { text.len() } else { end }
        } else {
            return j
        }
    }
    return j
}

/// How far the line holding offset i is indented (its leading blanks).
fn indent_at(text: Str, i: I32) I32 {
    let a = if i > text.len() { text.len() } else { i }
    while (a > 0 and text.get(a - 1) != 10) { a -= 1 }
    let b = a
    while (b < text.len() and (text.get(b) == 32 or text.get(b) == 9)) { b += 1 }
    return b - a
}

/// Past blanks, line breaks, and comments from i: the next line's first token.
fn next_token(text: Str, i: I32) I32 {
    let j = line_rest(text, i)
    while (j < text.len() and text.get(j) == 10) { j = line_rest(text, j + 1) }
    return j
}

/// Whether the expression goes on past the line break at `nl`, as utu's does:
/// its line ends open (an operator, `,`, `=`, `and`, …; `last` is its last
/// character, -1 for none, `opaque` when that ends a string or DSL), or the
/// next line continues it.
fn wp_continues(text: Str, last: I32, opaque: Bool, nl: I32) Bool {
    if last < 0 { return true }
    if not opaque {
        let c = text.get(last)
        if text_index(wps(Wpt.PlusDashStarSlashPctEqLtGtAmpBarCaretTildeBangCo), Str.from_code_point(c), 0) >= 0 { return true }
        if is_word_code(c) {
            let a = last
            while (a > 0 and is_word_code(text.get(a - 1))) { a -= 1 }
            if in_words(wps(Wpt.AndOrXorNotOrelseElse), text.slice(a, last + 1)) { return true }
        }
    }
    return continues_at(text, next_token(text, nl))
}

/// Whether the line whose first token is at j continues the statement before
/// it, as a utu line does: it begins `.f` (not `.name =`, a property), `?.`,
/// a binary operator but `-` and `&` (a CSS rule) and a lone `=` (text),
/// `{`, `and`, `or`, `xor`, `orelse`, `else`, `catch`, or an iterator stage
/// with its capture (`map |x|`, `fold(0) |a, x|`, `collect(T)`).
fn continues_at(text: Str, j: I32) Bool {
    if j >= text.len() { return false }
    let c = text.get(j)
    let next = if j + 1 < text.len() { text.get(j + 1) } else { 0 }
    if c == 46 { return (is_lower_code(next) or next == 95) and not assignment_head(text, j + 1, false) }
    if c == 63 { return next == 46 }
    if c == 61 { return next == 61 }
    // A new component insertion ends the previous Wutu statement. Utu
    // operators inside a parenthesized expression or block remain Utu.
    if c == 124 { return false }
    if c == 123 { return true }
    if text_index(wps(Wpt.PlusStarSlashPctLtGtBarCaretTildeBang), Str.from_code_point(c), 0) >= 0 { return true }
    if not is_lower_code(c) { return false }
    let k = j
    while (k < text.len() and is_word_code(text.get(k))) { k += 1 }
    let word = text.slice(j, k)
    if in_words(wps(Wpt.AndOrXorOrelseElseCatch), word) { return true }
    if word == wps(Wpt.Collect) { return k < text.len() and text.get(k) == 40 }
    if not in_words(wps(Wpt.MapFilterSkipTakeSkipWhile), word) { return false }
    let r = skip_spaces(text, k)
    if r < text.len() and text.get(r) == 40 {
        // `fold(0) |a, x|`: past its balanced arguments.
        let depth = 0
        while (r < text.len()) {
            let d = text.get(r)
            if d == 40 { depth += 1 } else if d == 41 {
                depth -= 1
                if depth == 0 { break }
            }
            r += 1
        }
        r = skip_spaces(text, r + 1)
    }
    return r < text.len() and text.get(r) == 124
}

/// Whether a statement ends at i (past its line's blanks): `;`, `}`, the
/// end, or a line break the next line does not continue past.
fn ends_at(text: Str, i: I32) Bool {
    let j = line_rest(text, i)
    if j >= text.len() { return true }
    let c = text.get(j)
    return c == 59 or c == 125 or (c == 10 and not continues_at(text, next_token(text, j)))
}

/// A quoted string, CSS or Utu: a backslash escapes the character after it.
fn wp_quoted(text: Str) Str {
    let start = wp_at
    let quote = text.get(start)
    wp_at += 1
    while (wp_at < text.len()) {
        let c = text.get(wp_at)
        if c == 92 {
            wp_at += 2
        } else if quote == 96 and c == 36 and wp_at + 1 < text.len() and text.get(wp_at + 1) == 123 {
            // A template's `${ … }` holds an expression: strings and templates in it nest.
            wp_at += 2
            let depth = 1
            while (wp_at < text.len() and depth > 0) {
                if not wp_opaque(text) {
                    let d = text.get(wp_at)
                    if d == 123 { depth += 1 } else if d == 125 { depth -= 1 }
                    wp_at += 1
                }
            }
        } else {
            wp_at += 1
            if c == quote { return text.slice(start, wp_at) }
        }
    }
    wutu_fail(wps(Wpt.UnterminatedString), start)
    return ""
}

/// Skip a Utu token whose contents are not delimiters: a nested DSL, a
/// string, or a line comment. Whether it skipped one.
fn wp_opaque(text: Str) Bool {
    let p = wp_at
    let c = text.get(p)
    if c == 64 {
        let end = skip_dsl(text, p)
        if end > p {
            wp_at = end
            return true
        }
    } else if c == 34 or c == 96 {
        wp_quoted(text)
        return true
    } else if text_at(text, p, "//") {
        wp_skip_line(text)
        return true
    }
    return false
}

/// `@name/\ … \/` starting at `start`: the offset after it, else `start`.
fn skip_dsl(text: Str, start: I32) I32 {
    let i = start + 1
    if i >= text.len() or not is_word_code(text.get(i)) { return start }
    while (i < text.len() and is_word_code(text.get(i))) { i += 1 }
    i = skip_spaces(text, i)
    if not text_at(text, i, "/\\") { return start }
    let depth = 1
    let j = i + 2
    while (j < text.len() - 1) {
        if text.get(j) == 34 {
            // A string is text (to its closing quote or its line).
            j += 1
            while (j < text.len() and text.get(j) != 34 and text.get(j) != 10) {
                j += if text.get(j) == 92 and j + 1 < text.len() and text.get(j + 1) != 10 { 2 } else { 1 }
            }
            if j >= text.len() or text.get(j) == 10 { j -= 1 }
        } else if text.get(j) == 47 and text.get(j + 1) == 92 {
            depth += 1
            j += 1
        } else if text.get(j) == 92 and text.get(j + 1) == 47 {
            depth -= 1
            if depth == 0 { return j + 2 }
            j += 1
        }
        j += 1
    }
    wutu_fail(wps(Wpt.UnterminatedDSLEnvelope), start)
    return start
}

/// An expression read: its source, and its range, here.
let wx_from: I32 = 0
let wx_to: I32 = 0

/// `= expression`: up to the statement's end (see wp_end), the expression
/// going on past a line break as utu's does (see wp_continues).
fn wp_bare_expression(text: Str) Str {
    wp_trivia(text)
    let start = wp_at
    let depth = 0
    // Its last character (not a comment's), and whether that ends a string or DSL.
    let last = -1
    let opaque = false
    while (not wp_done(text)) {
        let p = wp_at
        let c = text.get(p)
        if depth == 0 and (c == 59 or c == 125 or (c == 10 and not wp_continues(text, last, opaque, p))) { break }
        let comment = text_at(text, p, "//")
        if wp_opaque(text) {
            if not comment {
                last = wp_at - 1
                opaque = true
            }
        } else {
            if c == 40 or c == 91 or c == 123 { depth += 1 }
            else if c == 41 or c == 93 {
                if depth == 0 { wutu_fail(wps(Wpt.ExpectedALineBreakOrAfterSemi), p) }
                depth -= 1
            } else if c == 125 { depth -= 1 }
            if not is_space_code(c) {
                last = p
                opaque = false
            }
            wp_at += 1
        }
    }
    if depth > 0 { wutu_fail(wps(Wpt.UnterminatedExpression), start) }
    wx_from = start
    wx_to = if last < 0 { start } else { last + 1 }
    return text.slice(start, wx_to)
}

/// `$[expression]`.
/// An expression up to the first top-level character in `ends` (not
/// consumed): `if cond {`, `for items |item|`, `key item.id {`. Braces or
/// pipes of its own go in parentheses.
fn wp_expression_until(text: Str, ends: Str, what: Str) Str {
    wp_trivia(text)
    if wp_at_text(text, "$[") { wp_fail_interpolation(text) }
    let start = wp_at
    let depth = 0
    while (not wp_done(text)) {
        if not wp_opaque(text) {
            let c = text.get(wp_at)
            if depth == 0 and text_index(ends, Str.from_code_point(c), 0) >= 0 {
                let source = trim_end(text.slice(start, wp_at))
                if source.len() == 0 { wutu_fail(wps1(Wpt.Expected, what), wp_at) }
                wx_from = start
                wx_to = start + source.len()
                return source
            }
            if c == 40 or c == 91 or c == 123 { depth += 1 }
            else if c == 41 or c == 93 or c == 125 {
                if depth == 0 { wutu_fail(wps1(Wpt.Expected, what), wp_at) }
                depth -= 1
            }
            wp_at += 1
        }
    }
    wutu_fail(wps1(Wpt.Unterminated, what), start)
    return ""
}

/// A `for` iterable (its range in wx_from/wx_to) without parentheses that
/// only hide its pipeline's captures: `(xs filter |x| { … })` is
/// `xs filter |x| { … }`, and the loop's body continues that pipeline.
/// Parentheses around a finished pipeline (one ending in a terminal, like
/// sort) or a range (`(0..<n)`) stay.
fn unparenthesized(source: Str) Str {
    let n = source.len()
    if n < 2 or source.get(0) != 40 or source.get(n - 1) != 41 { return source }
    let depth = 0
    let last = ""
    let i = 0
    while (i < n) {
        let c = source.get(i)
        let before = if i > 0 { source.get(i - 1) } else { 32 }
        if c == 34 {
            i += 1
            while (i < n and source.get(i) != 34) { i += if source.get(i) == 92 { 2 } else { 1 } }
        } else if c == 40 or c == 91 or c == 123 {
            depth += 1
        } else if c == 41 or c == 93 or c == 125 {
            depth -= 1
            if depth == 0 and i < n - 1 { return source }
        } else if depth == 1 and ((c >= 97 and c <= 122) or c == 95) and not is_word_code(before) and before != 46 {
            let w = i
            while (i + 1 < n and is_word_code(source.get(i + 1))) { i += 1 }
            let word = source.slice(w, i + 1)
            if in_words(wps(Wpt.FoldEachAnyAllCountWhere), word) or in_words(wps(Wpt.MapFilterSkipTakeSkipWhileLc), word) { last = word }
        }
        i += 1
    }
    if last.len() == 0 or in_words(wps(Wpt.FoldEachAnyAllCountWhere), last) { return source }
    wx_from += 1
    wx_to -= 1
    return trim_text(source.slice(1, n - 1))
}

fn wp_fail_interpolation(text: Str) Void {
    wutu_fail(wps(Wpt.WutuNoLongerWritesAnExpression), wp_at)
}

/// A brace-delimited Utu block, with its braces.
fn wp_utu_block(text: Str, context: Str) Str {
    let start = wp_at
    let depth = 0
    let first = true
    while (first or (not wp_done(text) and depth > 0)) {
        first = false
        if not wp_opaque(text) {
            let c = text.get(wp_at)
            if c == 123 { depth += 1 } else if c == 125 { depth -= 1 }
            wp_at += 1
        }
    }
    if depth != 0 { wutu_fail(wps1(Wpt.Unterminated, context), start) }
    wx_from = start
    wx_to = wp_at
    return text.slice(start, wp_at)
}

//! = CSS

/// Up to a delimiter outside strings, comments, and (), [] and {} (a
/// function, an attribute selector, a custom property's block); with
/// `lines`, or a line break there, unless the line ends in `,` or the next is
/// indented past this one (`grid-template-areas: "a b"`, then `"c d"` under it).
fn wp_css_until(text: Str, delimiters: Str, lines: Bool) Str {
    let start = wp_at
    let indent = indent_at(text, start)
    let depth = 0
    let last = -1
    // Past its last character (a trailing `//` comment is not the value's).
    let end_at = start
    while (not wp_done(text)) {
        let c = text.get(wp_at)
        if c == 34 or c == 39 {
            wp_quoted(text)
            last = c
            end_at = wp_at
        } else if wp_at_text(text, "/*") {
            let end = text_index(text, "*/", wp_at + 2)
            if end < 0 { wutu_fail(wps(Wpt.UnterminatedComment), wp_at) }
            wp_at = end + 2
        } else if lines and depth == 0 and text_at(text, wp_at, "//") and wp_after_blank(text, wp_at) {
            wp_skip_line(text)
        } else {
            if depth == 0 and text_index(delimiters, Str.from_code_point(c), 0) >= 0 { break }
            if lines and depth == 0 and c == 10 and last >= 0 and last != 44 and indent_at(text, next_token(text, wp_at)) <= indent { break }
            if c == 40 or c == 91 or c == 123 { depth += 1 } else if c == 41 or c == 93 or c == 125 { depth -= 1 }
            wp_at += 1
            if not is_space_code(c) {
                last = c
                end_at = wp_at
            }
        }
    }
    return trim_text(text.slice(start, if lines { end_at } else { wp_at }))
}

/// A `{ … }` CSS block's body (the cursor on its brace), without its `//`
/// comments (CSS has none; `url(http://…)` is not one: a comment starts first
/// on a line or after a blank, outside parentheses), and with the `;` CSS
/// needs where a declaration's line ends (one ending in `,` goes on).
fn wp_css_block(text: Str) Str {
    let open = wp_at
    wp_at += 1
    let start = wp_at
    let body = ""
    let depth = 1
    let parens = 0
    // The last character outside comments, strings counting as their quote.
    let last = 59
    while (not wp_done(text)) {
        let p = wp_at
        if wp_at_text(text, "/*") {
            let end = text_index(text, "*/", p + 2)
            if end < 0 { wutu_fail(wps(Wpt.UnterminatedCSSComment), p) }
            wp_at = end + 2
        } else if text_at(text, p, "//") and parens == 0 and wp_after_blank(text, p) {
            body = body + text.slice(start, p)
            wp_skip_line(text)
            start = wp_at
        } else {
            let c = text.get(p)
            if c == 34 or c == 39 {
                wp_quoted(text)
                last = c
            } else {
                if c == 35 and p + 1 < text.len() and (text.get(p + 1) == 32 or text.get(p + 1) == 9) { wutu_fail(wps(Wpt.WutuCommentsAreWritten), p) }
                if c == 40 { parens += 1 } else if c == 41 { parens -= 1 }
                if c == 123 { depth += 1 }
                if (c == 125 or (c == 10 and parens == 0)) and not (last == 59 or last == 123 or last == 125 or last == 44) {
                    body = wps2(Wpt.ABSemi, body, text.slice(start, p))
                    start = p
                    last = 59
                }
                if c == 125 {
                    depth -= 1
                    if depth == 0 {
                        let block = body + text.slice(start, p)
                        wp_at += 1
                        return block
                    }
                }
                if not is_space_code(c) { last = c }
                wp_at += 1
            }
        }
    }
    wutu_fail(wps(Wpt.UnterminatedCSSBlock), open)
    return ""
}

//! = Template structure

/// The template; returns its single element or a synthetic fragment.
fn parse_template(text: Str) I32 {
    reset_template()
    wp_at = 0
    wp_trivia(text)
    if wp_at_text(text, wps(Wpt.Reactive)) {
        wp_at += 9
        wp_end(text)
        tw_reactive = 1
        wp_trivia(text)
    }
    if wp_at_text(text, wps(Wpt.Island)) {
        wp_at += 7
        wp_trivia(text)
        if wp_char(text) != 34 { wutu_fail(wps(Wpt.ExpectedAQuotedIslandNameIsland), wp_at) }
        tw_scope = intern_text(wp_quoted(text))
        wp_end(text)
        tw_reactive = 1
        wp_trivia(text)
    }
    while (wp_at_text(text, wps(Wpt.StyleAt))) {
        wp_at += 6
        wp_trivia(text)
        if wp_at_text(text, "$[") { wp_fail_interpolation(text) }
        if wp_char(text) == 61 { wutu_fail(wps(Wpt.StyleTakesOneExpressionNotAn), wp_at) }
        let source = wp_bare_expression(text)
        let from = wx_from
        let to = wx_to
        wp_end(text)
        tw_style_value.push(intern_text(source))
        tw_style_from.push(from)
        tw_style_to.push(to)
        wp_trivia(text)
    }
    while (wp_at_text(text, wps(Wpt.Document))) {
        wp_at += 9
        wp_trivia(text)
        if wp_char(text) != 123 { wutu_fail(wps(Wpt.ExpectedDocumentCSSBlock), wp_at) }
        tw_global.push(intern_text(wp_css_block(text)))
        wp_trivia(text)
    }
    if wp_char(text) == 64 { at_directive(text, wp_at, false) }
    let fragment = new_tnode(5, wp_at)
    let last = -1
    while (not wp_done(text)) {
        if wp_char(text) == 59 { wp_at += 1; wp_trivia(text); continue }
        let child = parse_tnode(text)
        tn_parent[child] = fragment
        if last < 0 { tn_first[fragment] = child } else { tn_next[last] = child }
        last = child
        wp_trivia(text)
    }
    let first = tn_first[fragment]
    if first >= 0 and tn_next[first] < 0 and tn_kind[first] == 4 {
        tn_parent[first] = -1
        if word_text(tn_text[first]) == wps(Wpt.Html) { tw_reactive = 1 }
        return first
    }
    return fragment
}

/// Text, an expression, if, for, or an element.
fn parse_tnode(text: Str) I32 {
    wp_trivia(text)
    let start = wp_at
    if wp_char(text) == 34 {
        let expr = wp_quoted(text)
        wp_end(text)
        let n = new_tnode(0, start)
        tn_text[n] = intern_text(expr)
        return n
    }
    if wp_at_text(text, "$[") { wp_fail_interpolation(text) }
    if wp_char(text) == 61 { wutu_fail(wps(Wpt.ChildExpressionsUsePipe), start) }
    if wp_char(text) == 124 {
        let code = wp_at_text(text, wps(Wpt.BarGt))
        wp_at += if code { 2 } else { 1 }
        let source = wp_bare_expression(text)
        let from = wx_from
        let to = wx_to
        wp_end(text)
        let n = new_tnode(1, start)
        tn_text[n] = intern_text(source)
        tn_from[n] = from
        tn_to[n] = to
        return n
    }
    if wp_keyword(text, "if") { return parse_tif(text) }
    if wp_keyword(text, "for") { return parse_tfor(text) }
    if wp_keyword(text, "match") { return parse_tmatch(text) }
    return parse_telement(text)
}

/// `{ nodes }`, into node n's children (or its otherwise).
fn parse_branch(text: Str, n: I32, otherwise: Bool) Void {
    wp_trivia(text)
    let open = wp_at
    if wp_char(text) != 123 { wutu_fail(wps(Wpt.ExpectedBrace), wp_at) }
    wp_at += 1
    while (true) {
        wp_trivia(text)
        if wp_done(text) { wutu_fail(wps(Wpt.UnterminatedBranch), open) }
        if wp_char(text) == 125 {
            wp_at += 1
            return
        }
        if wp_char(text) == 59 {
            wp_at += 1
            continue
        }
        let c = parse_tnode(text)
        tn_parent[c] = n
        append_child(n, c, otherwise)
    }
}

/// `if e { … } else { … }`, the cursor on `if`.
fn parse_tif(text: Str) I32 {
    let start = wp_at
    wp_at += 2
    let condition = wp_expression_until(text, "{", wps(Wpt.AConditionBefore))
    let n = new_tnode(2, start)
    tn_text[n] = intern_text(condition)
    tn_from[n] = wx_from
    tn_to[n] = wx_to
    parse_branch(text, n, false)
    wp_trivia(text)
    let p = wp_at
    if text_at(text, p, "else") {
        let i = p + 4
        let gap = i
        i = skip_spaces(text, i)
        if i > gap and text_at(text, i, "if") and i + 2 < text.len() and is_space_code(text.get(i + 2)) {
            wp_at = p + 4
            wp_trivia(text)
            let inner = parse_tif(text)
            tn_parent[inner] = n
            tn_else[n] = inner
        } else if i < text.len() and text.get(i) == 123 {
            wp_at = p + 4
            parse_branch(text, n, true)
        }
    }
    return n
}

/// `for e |x| { … }`, the cursor on `for`.
fn parse_tfor(text: Str) I32 {
    let start = wp_at
    wp_at += 3
    // (The loop's body joins the iterable's pipeline: parentheses that only
    // hide its own `|…|` go.)
    let iterable = unparenthesized(wp_expression_until(text, "|", wps(Wpt.WhatToIterateThenItem)))
    let n = new_tnode(3, start)
    tn_text[n] = intern_text(iterable)
    tn_from[n] = wx_from
    tn_to[n] = wx_to
    wp_trivia(text)
    // |item| or |item, index|
    let captures = wp_captures(text)
    if captures.len() == 0 { wutu_fail(wps(Wpt.ExpectedItemOrItemIndexAfter), wp_at) }
    tn_captures[n] = intern_text(captures)
    wp_trivia(text)
    if wp_keyword(text, "key") {
        wp_at += 3
        wp_trivia(text)
        if wp_keyword(text, wps(Wpt.Global)) {
            wp_at += 6
            wp_trivia(text)
            tn_global[n] = 1
        }
        tn_key[n] = intern_text(wp_expression_until(text, "{", wps(Wpt.AKeyBefore)))
        tn_key_from[n] = wx_from
        tn_key_to[n] = wx_to
    }
    parse_branch(text, n, false)
    return n
}

/// `match e { pat => { … } ~> { … } }`, the cursor on `match`.
fn parse_tmatch(text: Str) I32 {
    let start = wp_at
    wp_at += 5
    let scrutinee = wp_expression_until(text, "{", wps(Wpt.AScrutineeBefore))
    let n = new_tnode(6, start)
    tn_text[n] = intern_text(scrutinee)
    tn_from[n] = wx_from
    tn_to[n] = wx_to
    wp_trivia(text)
    let open = wp_at
    if wp_char(text) != 123 { wutu_fail(wps(Wpt.ExpectedBrace), wp_at) }
    wp_at += 1
    while (true) {
        wp_trivia(text)
        if wp_done(text) { wutu_fail(wps(Wpt.UnterminatedMatch), open) }
        if wp_char(text) == 125 {
            wp_at += 1
            return n
        }
        if wp_char(text) == 44 or wp_char(text) == 59 {
            wp_at += 1
            continue
        }
        let arm_start = wp_at
        let arm = new_tnode(7, arm_start)
        if wp_at_text(text, "~>") {
            wp_at += 2
        } else {
            let pstart = wp_at
            while (not wp_done(text) and not wp_at_text(text, "=>")) {
                if wp_char(text) == 123 or wp_char(text) == 125 or wp_char(text) == 10 {
                    wutu_fail(wps(Wpt.ExpectedFatArrowInMatch), wp_at)
                }
                wp_at += 1
            }
            if not wp_at_text(text, "=>") { wutu_fail(wps(Wpt.ExpectedFatArrowInMatch), wp_at) }
            let pat = trim_end(text.slice(pstart, wp_at))
            if pat.len() == 0 { wutu_fail(wps(Wpt.ExpectedPatternInMatch), pstart) }
            tn_text[arm] = intern_text(pat)
            tn_from[arm] = pstart
            tn_to[arm] = pstart + pat.len()
            wp_at += 2
        }
        parse_branch(text, arm, false)
        tn_parent[arm] = n
        append_child(n, arm, false)
    }
    return n
}

/// `|a|` or `|a, b|` at the cursor: "a" or "a, b" as written (consumed), or "".
fn wp_captures(text: Str) Str {
    let p = wp_at
    if wp_char(text) != 124 { return "" }
    let i = skip_spaces(text, p + 1)
    let from = i
    if i >= text.len() or not (is_lower_code(text.get(i)) or text.get(i) == 95) { return "" }
    while (i < text.len() and is_word_code(text.get(i))) { i += 1 }
    let j = skip_spaces(text, i)
    if j < text.len() and text.get(j) == 44 {
        j += 1
        j = skip_spaces(text, j)
        if j >= text.len() or not (is_lower_code(text.get(j)) or text.get(j) == 95) { return "" }
        while (j < text.len() and is_word_code(text.get(j))) { j += 1 }
        i = j
    }
    let to = i
    i = skip_spaces(text, i)
    if i >= text.len() or text.get(i) != 124 { return "" }
    wp_at = i + 1
    return text.slice(from, to)
}

/// An element: its tag, classes, and `as` alias, then a `{ … }` body or `;`.
fn parse_telement(text: Str) I32 {
    let start = wp_at
    let p = start
    if p >= text.len() or not is_lower_code(text.get(p)) { wutu_fail(wps(Wpt.ExpectedAnHTMLTagClassOnly), p) }
    let q = p
    while (q < text.len() and is_name_code(text.get(q))) { q += 1 }
    let tag = text.slice(p, q)
    let outer = wp_svg_kids
    let outer_el = wp_svg_el
    if outer == 0 and not is_known_tag(tag) { wutu_fail(wps1(Wpt.ExpectedAnHTMLTagFoundUnknown, tag), p) }
    wp_at = q
    let n = new_tnode(4, start)
    tn_text[n] = intern_text(tag)
    while (wp_char(text) == 46 or wp_char(text) == 35) {
        let shorthand = wp_char(text)
        wp_at += 1
        let a = wp_at
        let b = a
        while (b < text.len() and is_name_code(text.get(b))) { b += 1 }
        if b == a { wutu_fail(wps(Wpt.ExpectedClassOrId), a) }
        let name = text.slice(a, b)
        wp_at = b
        if shorthand == 46 { add_item(n, 0, intern_text(name), -1, 0, -1, -1, a) }
        else {
            if has_attribute_item(n, wps(Wpt.Id)) { wutu_fail(wps1(Wpt.AnElementHasOneIdIs, name), a - 1) }
            add_item(n, 1, intern_text(wps(Wpt.Id)), intern_text(js_string(name)), 0, -1, -1, wp_at)
        }
    }
    wp_trivia(text)
    if wp_keyword(text, wps(Wpt.As)) {
        wp_at += 2
        wp_trivia(text)
        let a = wp_at
        if a >= text.len() or not (is_lower_code(text.get(a)) or text.get(a) == 95) { wutu_fail(wps(Wpt.ExpectedNodeBinding), a) }
        let b = a
        while (b < text.len() and is_word_code(text.get(b))) { b += 1 }
        tn_binding[n] = intern_text(text.slice(a, b))
        wp_at = b
        wp_trivia(text)
    }
    if wp_char(text) != 123 { wutu_fail(wps(Wpt.ExpectedAfterElementHead), wp_at) }
    wp_at += 1
    let svg = outer == 1 or is_svg_tag(tag) and not is_html_tag(tag)
    wp_svg_el = if svg { 1 } else { 0 }
    wp_svg_kids = if svg and tag != wps(Wpt.ForeignObject) { 1 } else { 0 }
    while (true) {
        wp_trivia(text)
        if wp_done(text) { wutu_fail(wps1(Wpt.UnterminatedElement, tag), start) }
        if wp_char(text) == 125 {
            wp_at += 1
            break
        }
        // `html { @document { … } head { … } body { … } }`: the page's
        // document CSS, as before a template's root.
        if tag == wps(Wpt.Html) and wp_at_text(text, wps(Wpt.Document)) {
            wp_at += 9
            wp_trivia(text)
            if wp_char(text) != 123 { wutu_fail(wps(Wpt.ExpectedDocumentCSSBlock), wp_at) }
            tw_global.push(intern_text(wp_css_block(text)))
            continue
        }
        parse_element_statement(text, n)
    }
    wp_svg_kids = outer
    wp_svg_el = outer_el
    if is_void_tag(tag) and tn_first[n] >= 0 { wutu_fail(wps1(Wpt.CannotHaveChildren, tag), start) }
    if tag == "script" or is_raw_text_tag(tag) {
        let c = tn_first[n]
        while (c >= 0) {
            // (An element's text and attributes are escaped.)
            if tn_kind[c] != 0 and tn_kind[c] != 4 and tag != "script" { wutu_fail(raw_text_error(tag), tn_start[c]) }
            if tn_kind[c] != 0 and tag == "script" { wutu_fail(wps(Wpt.AScriptSTextIsCode), tn_start[c]) }
            c = tn_next[c]
        }
    }
    let i = tn_items[n]
    while (i >= 0) {
        if ti_kind[i] == 3 and word_text(ti_a[i]) == "values" and not (tag == "select" and has_attribute_item(n, wps(Wpt.Multiple))) {
            wutu_fail(wps(Wpt.BindValuesIsAMultipleSelect), ti_at[i])
        }
        i = ti_next[i]
    }
    if tn_first[n] >= 0 and has_attribute_item(n, wps(Wpt.DataWutuUnmanaged)) {
        wutu_fail(wps1(Wpt.AnUnmanagedHasNoChildrenIn, tag), start)
    }
    return n
}

/// Elements whose text HTML holds unescaped (raw text; a script's is code):
/// prerendered, a value there could close the element and start markup.
fn is_raw_text_tag(tag: Str) Bool => in_words(wps(Wpt.StyleNoscriptIframeXmpNoembedNoframes), tag)

fn raw_text_error(tag: Str) Str {
    return wps3(Wpt.STextIsUnescapedInHTML, (if tag == wps(Wpt.Iframe) { wps(Wpt.An) } else { "a " }), tag, tag)
}

/// Whether element n has an attribute item named `name`.
fn has_attribute_item(n: I32, name: Str) Bool {
    let i = tn_items[n]
    while (i >= 0) {
        if ti_kind[i] == 1 and word_text(ti_a[i]) == name { return true }
        i = ti_next[i]
    }
    return false
}

fn add_child(n: I32, c: I32) Void {
    tn_parent[c] = n
    append_child(n, c, false)
}

/// One statement of an element's body: an item, a CSS rule, or a child node.
fn parse_element_statement(text: Str, n: I32) Void {
    let p = wp_at
    let c = text.get(p)
    if c == 59 {
        wp_at += 1
        return
    }
    if wp_at_text(text, "$[") { wp_fail_interpolation(text) }
    // (`for = "x";` is label's attribute: a loop's iterable never starts with `=`.)
    if c == 34 or c == 61 or c == 124 or wp_keyword(text, "if") or (wp_keyword(text, "for") and not assignment_head(text, p, false)) or (wp_keyword(text, "match") and not assignment_head(text, p, false)) {
        add_child(n, parse_tnode(text))
        return
    }
    // bind:value|checked|number|group|values|files =
    if text_at(text, p, wps(Wpt.Bind)) {
        let q = p + 5
        let property = ""
        for (["value", wps(Wpt.Checked), "number", wps(Wpt.Group), "values", wps(Wpt.Files)]) |candidate| {
            if property.len() == 0 and text_at(text, q, candidate) and not (q + candidate.len() < text.len() and is_name_code(text.get(q + candidate.len()))) { property = candidate }
        }
        if property.len() > 0 {
            let r = skip_spaces(text, q + property.len())
            if r < text.len() and text.get(r) == 61 {
                wp_at = r + 1
                let source = wp_bare_expression(text)
                let from = wx_from
                let to = wx_to
                wp_end(text)
                add_item(n, 3, intern_text(property), intern_text(source), 0, from, to, p)
                return
            }
        }
    }
    // on name [quiet] [|e|] { … }, or on name [quiet] = handler;
    if text_at(text, p, "on") and p + 2 < text.len() and is_space_code(text.get(p + 2)) {
        let q = skip_spaces(text, p + 2)
        let a = q
        while (q < text.len() and is_name_code(text.get(q))) { q += 1 }
        let r = skip_spaces(text, q)
        let quiet = text_at(text, r, wps(Wpt.Quiet)) and r + 5 < text.len() and not is_name_code(text.get(r + 5))
        if quiet { r = skip_spaces(text, r + 5) }
        let param = -1
        if r < text.len() and text.get(r) == 124 {
            let b = skip_spaces(text, r + 1)
            let e = b
            while (e < text.len() and is_word_code(text.get(e))) { e += 1 }
            let close = skip_spaces(text, e)
            if e > b and close < text.len() and text.get(close) == 124 {
                param = intern_text(text.slice(b, e))
                r = skip_spaces(text, close + 1)
            }
        }
        if q > a and r < text.len() and (text.get(r) == 123 or text.get(r) == 61) {
            let name = text.slice(a, q)
            let near = near_event(name)
            if near.len() > 0 { wutu_fail(wps2(Wpt.UnknownEventDidYouMean, name, near), a) }
            let flags = if quiet { 4 } else { 0 }
            if text.get(r) == 61 {
                if param >= 0 { wutu_fail(wps(Wpt.AHandlerValueNamesItsOwn), r) }
                wp_at = r + 1
                let source = wp_bare_expression(text)
                let from = wx_from
                let to = wx_to
                wp_end(text)
                add_item(n, 2, intern_text(name), intern_text(source), flags, from, to, p)
                return
            }
            wp_at = r
            let source = wp_utu_block(text, wps(Wpt.EventHandler))
            let i = add_item(n, 2, intern_text(name), intern_text(source), 1 + flags, wx_from, wx_to, p)
            ti_c[i] = param
            return
        }
    }
    if c == 60 { wutu_fail(old_attribute_text(text, p), p) }
    // `@unmanaged`: the template makes the element; what JavaScript does to
    // its children and its other attributes, renders leave alone.
    if text_at(text, p, wps(Wpt.Unmanaged)) and not (p + 10 < text.len() and is_name_code(text.get(p + 10))) {
        let r = line_rest(text, p + 10)
        if r >= text.len() or text.get(r) == 10 or text.get(r) == 59 or text.get(r) == 125 {
            wp_at = p + 10
            wp_end(text)
            add_item(n, 1, intern_text(wps(Wpt.DataWutuUnmanaged)), intern_text("\"\""), 0, -1, -1, wp_at)
            return
        }
    }
    if c == 64 and event_head(text, p) {
        let q = p + 1
        while (q < text.len() and is_name_code(text.get(q))) { q += 1 }
        let name = text.slice(p + 1, q)
        if in_words(wps(Wpt.ReactiveIslandStyleDocument), name) { wutu_fail(wps1(Wpt.GoesFirstInTheTemplateBefore, name), p) }
        wutu_fail(wps2(Wpt.EventsAreWrittenOnHandlerOr, name, name), p)
    }
    if c == 46 and assignment_head(text, p + 1, true) {
        wp_at += 1
        parse_attribute(text, n, true)
        return
    }
    if c >= 97 and c <= 122 and (assignment_head(text, p, true) or namespace_prefix(text, p) > 0 and assignment_head(text, namespace_prefix(text, p), true)) {
        parse_attribute(text, n, false)
        return
    }
    if c == 64 { at_directive(text, p, true) }
    if c == 58 or c == 64 or c == 38 {
        parse_css_rule(text, n)
        return
    }
    parse_declaration_or_child(text, n)
}

/// `@name` at p, where an element's body (`inside`) or the template's head
/// has one: a CSS at-rule inside passes; a directive in the wrong place, or
/// an unknown one, fails.
fn at_directive(text: Str, p: I32, inside: Bool) Void {
    let q = p + 1
    while (q < text.len() and is_name_code(text.get(q))) { q += 1 }
    let name = text.slice(p + 1, q)
    if name.len() == 0 { return }
    let head = wps(Wpt.ReactiveIslandStyleDocumentAtAtAtAt)
    if inside and in_words(wps(Wpt.MediaSupportsContainerLayerKeyframesFont), name) { return }
    if inside and text_at(name, 0, "-") { return }
    if inside and name == wps(Wpt.UnmanagedLc) { wutu_fail(wps(Wpt.ExpectedALineBreakOrAfterSemiAt), q) }
    if inside and in_words(head, wps1(Wpt.AtA, name)) { wutu_fail(wps1(Wpt.GoesFirstInTheTemplateBefore, name), p) }
    if not inside and name == wps(Wpt.UnmanagedLc) { wutu_fail(wps(Wpt.UnmanagedGoesInsideTheElementIt), p) }
    if not inside and in_words(head, wps1(Wpt.AtA, name)) { wutu_fail(wps2(Wpt.IsRepeatedOrOutOfOrder, name, head), p) }
    let known = if inside { wps(Wpt.Unmanaged) } else { head }
    let near = closest_word(known, wps1(Wpt.AtA, name))
    wutu_fail(wps2(Wpt.UnknownDirective, name, (if near.len() > 0 { wps1(Wpt.DidYouMean, near) } else { wps1(Wpt.SemiSpaceA, (if inside { wps(Wpt.AnElementTakesUnmanagedOrA) } else { wps1(Wpt.ATemplateBeginsWith, head) })) })), p)
}

/// A DOM event `name` is a typo of (one edit or swap from a common one:
/// `clik`, `chnage`), or "" for a known event or a custom one: two edits
/// from one (`unmount`), or one that adds to one's name (`changed`, `clicks`).
fn near_event(name: Str) Str {
    let known = wps(Wpt.ClickDblclickAuxclickContextmenuMousedow)
    if extends_word(known, name) { return "" }
    return typo_of(known, name)
}

/// Whether `w` is a word of `list` (space-separated) and more.
fn extends_word(list: Str, w: Str) Bool {
    let i = 0
    while (i < list.len()) {
        let j = i
        while (j < list.len() and list.get(j) != 32) { j += 1 }
        if j - i < w.len() and text_at(w, 0, list.slice(i, j)) { return true }
        i = j + 1
    }
    return false
}

/// The word of `list` (as in_words) within two edits of `w`, or "".
fn closest_word(list: Str, w: Str) Str {
    let best = ""
    let best_d = 3
    let i = 0
    while (i < list.len()) {
        let j = i
        while (j < list.len() and list.get(j) != 32 and list.get(j) != 10) { j += 1 }
        let word = list.slice(i, j)
        let d = word_distance(intern_text(word), intern_text(w), 3)
        if d < best_d { best = word; best_d = d }
        i = j + 1
    }
    return best
}

/// `@name =` at p.
fn event_head(text: Str, p: I32) Bool {
    let q = p + 1
    let a = q
    while (q < text.len() and is_name_code(text.get(q))) { q += 1 }
    if q == a { return false }
    q = skip_spaces(text, q)
    return q < text.len() and text.get(q) == 61
}

/// A name at q, then `=` (not `==`), or, when `bare` (a boolean attribute),
/// the statement's end: a line break, `;`, or `}`.
fn assignment_head(text: Str, q: I32, bare: Bool) Bool {
    let a = q
    let i = q
    while (i < text.len() and is_name_code(text.get(i))) { i += 1 }
    if i == a { return false }
    // (On its line: an `=` on the next begins a hole.)
    i = line_rest(text, i)
    if bare and (i >= text.len() or text.get(i) == 10 or text.get(i) == 59 or text.get(i) == 125) { return true }
    return i < text.len() and text.get(i) == 61 and not (i + 1 < text.len() and text.get(i + 1) == 61)
}

/// Past `xlink:`, `xml:` or `xmlns:` at q (a namespaced attribute's prefix,
/// never a CSS property's), or 0.
fn namespace_prefix(text: Str, q: I32) I32 {
    for ([wps(Wpt.Xlink), wps(Wpt.Xmlns), wps(Wpt.Xml)]) |prefix| {
        if text_at(text, q, prefix) { return q + prefix.len() }
    }
    return 0
}

/// `<name = value;`, the spelling before attributes lost their `<`: the new one.
fn old_attribute_text(text: Str, p: I32) Str {
    let q = p + 1
    if q < text.len() and text.get(q) == 46 { q += 1 }
    let a = q
    while (q < text.len() and is_name_code(text.get(q))) { q += 1 }
    let spelled = if q > a { text.slice(p + 1, q) } else { "name" }
    return wps2(Wpt.AttributesAreWrittenWithoutValueOr, spelled, spelled)
}

/// `"text" name…`: a string, then (no operator) another statement on its line: a forgotten `;`.
fn literal_then_name(text: Str, q: I32) Void {
    if q >= text.len() or text.get(q) != 34 { return }
    let i = q + 1
    while (i < text.len() and text.get(i) != 34 and text.get(i) != 10) { i += if text.get(i) == 92 { 2 } else { 1 } }
    if i >= text.len() or text.get(i) != 34 { return }
    let w = skip_spaces(text, i + 1)
    let e = w
    while (e < text.len() and is_name_code(text.get(e))) { e += 1 }
    if e > w and not (text.get(w) >= 48 and text.get(w) <= 57) and not in_words(wps(Wpt.AndOrNotOrelse), text.slice(w, e)) {
        wutu_fail(wps(Wpt.ExpectedALineBreakOrAfter), i + 1)
    }
}

/// Whether a string literal at q is the whole value: `"…"`, then the statement's end.
fn literal_value(text: Str, q: I32) Bool {
    if q >= text.len() or text.get(q) != 34 { return false }
    let i = q + 1
    while (i < text.len() and text.get(i) != 34 and text.get(i) != 10) { i += if text.get(i) == 92 { 2 } else { 1 } }
    if i >= text.len() or text.get(i) != 34 { return false }
    return ends_at(text, i + 1)
}

/// Whether `name` is "on" and an event's name, in any case: an event
/// handler's attribute. (A browser runs no other `on…` one, so `one`, `only`
/// and a custom element's `onfoo` are attributes.)
fn is_on_name(name: Str) Bool {
    if name.len() < 3 or (name.get(0) | 32) != 111 or (name.get(1) | 32) != 110 { return false }
    return is_event_name(lower_text(name.slice(2, name.len())))
}

/// `text` in ASCII lowercase.
fn lower_text(text: Str) Str {
    let out = ""
    for (0 ..< text.len()) |i| { out = out + Str.from_code_point(lower_byte(text.get(i))) }
    return out
}

/// The DOM events with a handler attribute (`on` + the name), in any browser.
fn dom_events_text() Str => "abort activate afterprint afterscriptexecute animationcancel animationend animationiteration animationstart appinstalled auxclick beforeactivate beforecopy beforecut beforedeactivate beforeinput beforeinstallprompt beforematch beforepaste beforeprint beforescriptexecute beforetoggle beforeunload beforexrselect begin blur cancel canplay canplaythrough change click close command contentvisibilityautostatechange contextlost contextmenu contextrestored copy cuechange cut dblclick deactivate devicemotion deviceorientation deviceorientationabsolute drag dragend dragenter dragexit dragleave dragover dragstart drop durationchange emptied encrypted end ended enterpictureinpicture error focus focusin focusout formdata freeze fullscreenchange fullscreenerror gamepadconnected gamepaddisconnected gesturechange gestureend gesturestart gotpointercapture hashchange help input interest invalid keydown keypress keyup languagechange leavepictureinpicture load loadeddata loadedmetadata loadstart loseinterest lostpointercapture message messageerror mousedown mouseenter mouseleave mousemove mouseout mouseover mouseup mousewheel mozfullscreenchange mozfullscreenerror mozpointerlockchange mozpointerlockerror offline online orientationchange overscroll pagehide pagereveal pageshow pageswap paste pause play playing pointercancel pointerdown pointerenter pointerleave pointerlockchange pointerlockerror pointermove pointerout pointerover pointerrawupdate pointerup popstate prerenderingchange progress ratechange readystatechange rejectionhandled repeat reset resize resume scroll scrollend scrollsnapchange scrollsnapchanging search securitypolicyviolation seeked seeking select selectionchange selectstart show slotchange stalled storage submit suspend timeupdate toggle touchcancel touchend touchmove touchstart transitioncancel transitionend transitionrun transitionstart unhandledrejection unload visibilitychange volumechange waiting waitingforkey webkitanimationend webkitanimationiteration webkitanimationstart webkitbeginfullscreen webkitcurrentplaybacktargetiswirelesschanged webkitendfullscreen webkitfullscreenchange webkitfullscreenerror webkitkeyadded webkitkeyerror webkitkeymessage webkitmouseforcechanged webkitmouseforcedown webkitmouseforceup webkitmouseforcewillbegin webkitneedkey webkitplaybacktargetavailabilitychanged webkitpresentationmodechanged webkittransitionend wheel zoom"

fn is_event_name(w: Str) Bool => in_words(dom_events(), w)

/// `name = value;` or `name;` (an attribute), `.name = value;` (a property);
/// the cursor is on the name. A value that is one string literal is written
/// into the element; anything else is an expression.
fn parse_attribute(text: Str, n: I32, is_property: Bool) Void {
    let name_start = wp_at
    let q = if is_property or namespace_prefix(text, name_start) == 0 { name_start } else { namespace_prefix(text, name_start) }
    while (q < text.len() and is_name_code(text.get(q))) { q += 1 }
    let name = text.slice(name_start, q)
    wp_at = line_rest(text, q)
    let value = "\"\""
    let dynamic = false
    let from = -1
    let to = -1
    if wp_char(text) == 61 {
        wp_at += 1
        wp_trivia(text)
        if wp_at_text(text, "$[") { wp_fail_interpolation(text) }
        if literal_value(text, wp_at) {
            value = wp_quoted(text)
        } else {
            literal_then_name(text, wp_at)
            value = wp_bare_expression(text)
            dynamic = true
            from = wx_from
            to = wx_to
        }
    } else if is_property {
        wutu_fail(wps(Wpt.APropertyTakesAValueName), name_start)
    }
    wp_end(text)
    let tag = word_text(tn_text[n])
    if is_on_name(name) { wutu_fail(wps1(Wpt.EventsAreWrittenOnNotAs, name.slice(2, name.len())), name_start) }
    if dynamic and tag == "script" { wutu_fail(wps(Wpt.AScriptSAttributesAreCode), name_start) }
    if dynamic and tag == "base" and name == wps(Wpt.Href) { wutu_fail(wps(Wpt.ABaseSHrefMovesEvery), name_start) }
    if dynamic and is_property and name == wps(Wpt.Protocol) { wutu_fail(wps(Wpt.ProtocolFromAValueCouldMake), name_start) }
    if dynamic and is_property and is_raw_text_tag(tag) and in_words(wps(Wpt.TextContentInnerText), name) { wutu_fail(raw_text_error(tag), name_start) }
    if dynamic and name == wps(Wpt.Srcdoc) { wutu_fail(wps(Wpt.SrcdocIsHTMLSoWutuSets), name_start) }
    if not is_property and not is_allowed_attribute(tag, name, wp_svg_el == 1) { wutu_fail(wps2(Wpt.UnknownAttributeOn, name, tag), name_start) }
    if name != "class" and has_item_named(n, name, is_property) { wutu_fail((if is_property { wps1(Wpt.IsAssignedTwiceOnThisElement, name) } else { wps1(Wpt.AnElementHasOneThisIs, name) }), name_start) }
    add_item(n, 1, intern_text(name), intern_text(value), (if is_property { 1 } else { 0 }) + (if dynamic { 2 } else { 0 }), from, to, name_start)
}

/// Whether element n has a property (or an attribute) item named `name`.
fn has_item_named(n: I32, name: Str, is_property: Bool) Bool {
    let i = tn_items[n]
    while (i >= 0) {
        if ti_kind[i] == 1 and (ti_flags[i] & 1) == (if is_property { 1 } else { 0 }) and word_text(ti_a[i]) == name { return true }
        i = ti_next[i]
    }
    return false
}

/// Pseudo-classes, at-rules, `& selector` and `@ selector` scoped rules.
fn parse_css_rule(text: Str, n: I32) Void {
    let selector = wp_css_until(text, wps(Wpt.BraceSemiBraceEnd), true)
    if wp_char(text) != 123 {
        // A statement (`@import …`): up to its line's end or `;`.
        wp_end(text)
        let i = add_item(n, 4, -1, intern_text(wps1(Wpt.ASemi, selector)), 0, -1, -1, wp_at)
        ti_c[i] = intern_text(wps1(Wpt.ASemi, selector))
        return
    }
    let block = wp_css_block(text)
    let i = add_item(n, 4, -1, intern_text(wps2(Wpt.ABraceBBraceEnd, selector, block)), 0, -1, -1, wp_at)
    ti_c[i] = intern_text(wps2(Wpt.ABraceBBraceEnd, scoped_selector(selector), block))
}

/// A scoped CSS rule's selector, relative to the element (`&`): `@` alone is
/// the element and all inside it, `@ sel` is `sel`, a pseudo-class is on `&`.
fn scoped_selector(selector: Str) Str {
    if selector == "@" { return wps(Wpt.AmpCommaSpaceAmpSpaceStar) }
    if text_at(selector, 0, wps(Wpt.AtSpace)) {
        let rest = selector.slice(2, selector.len())
        return if rest.len() > 0 { rest } else { wps(Wpt.AmpCommaSpaceAmpSpaceStar) }
    }
    if text_at(selector, 0, ":") { return wps1(Wpt.AmpA, selector) }
    return selector
}

/// `property: value;` in an element's body, or else a child element.
fn parse_declaration_or_child(text: Str, n: I32) Void {
    let start = wp_at
    let head = wp_css_until(text, wps(Wpt.ColonBraceBraceEndSemi), false)
    if wp_char(text) != 58 {
        wp_at = start
        add_child(n, parse_telement(text))
        return
    }
    wp_at += 1
    wp_trivia(text)
    if wp_at_text(text, "$[") { wp_fail_interpolation(text) }
    if wp_char(text) == 61 { wutu_fail(wps(Wpt.ComputedCssValuesUseBraces), wp_at) }
    if wp_char(text) == 123 {
        // A leading block is Utu, including for custom properties.
        let source = wp_utu_block(text, wps(Wpt.ComputedCSSValue))
        let from = wx_from
        let to = wx_to
        wp_end(text)
        css_property_known(head, start)
        add_item(n, 5, intern_text(head), intern_text(source), 0, from, to, start)
        return
    }
    let value_from = wp_at
    let custom = text_at(head, 0, "--")
    let value = wp_css_until(text, if custom { ";}" } else { wps(Wpt.SemiBraceBraceEnd) }, true)
    css_value_runs_on(text, value_from, wp_at, custom)
    if wp_char(text) == 123 { wutu_fail(wps(Wpt.ExpectedALineBreakOrAfterLc), wp_at) }
    wp_end(text)
    css_property_known(head, start)
    let declaration = wps2(Wpt.AColonBSemi, head, value)
    let i = add_item(n, 4, -1, intern_text(declaration), 0, -1, -1, start)
    ti_c[i] = intern_text(declaration)
}

