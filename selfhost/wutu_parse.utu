fn wps_src(t: Wpt) Str {
    return match t {
        Wpt.InvalidCSSPropertyDidYouMean => "invalid CSS property {0}; did you mean {1}?",
        Wpt.Expected => "expected {0}",
        Wpt.Unterminated => "unterminated {0}",
        Wpt.ABSemi => "{0}{1};",
        Wpt.ExpectedAnHTMLTagFoundUnknown => "expected an HTML tag, found unknown element '{0}' (custom element names need a hyphen)",
        Wpt.AnElementHasOneIdIs => "an element has one id; #{0} is a second",
        Wpt.UnterminatedElement => "unterminated element '{0}'",
        Wpt.CannotHaveChildren => "{0} cannot have children",
        Wpt.AnUnmanagedHasNoChildrenIn => "an @unmanaged {0} has no children in its template: what is inside it is JavaScript's",
        Wpt.STextIsUnescapedInHTML => "{0}{1}'s text is unescaped in HTML (a value could close it), so Wutu writes it only as written: {2} { \"…\" }",
        Wpt.UnknownEventDidYouMean => "unknown event {0}; did you mean {1}?",
        Wpt.GoesFirstInTheTemplateBefore => "@{0} goes first in the template, before its root element",
        Wpt.EventsAreWrittenOnHandlerOr => "events are written on {0} = handler (or on {1} { … })",
        Wpt.AtA => "@{0}",
        Wpt.IsRepeatedOrOutOfOrder => "@{0} is repeated or out of order: a template begins with {1}, in that order, @reactive and @island at most once",
        Wpt.UnknownDirective => "unknown directive @{0}{1}",
        Wpt.DidYouMean => "; did you mean {0}?",
        Wpt.SemiSpaceA => "; {0}",
        Wpt.ATemplateBeginsWith => "a template begins with {0}",
        Wpt.AttributesAreWrittenWithoutValueOr => "attributes are written without '<': {0} = value (or {1} alone, for a boolean attribute)",
        Wpt.EventsAreWrittenOnNotAs => "events are written on {0} { … }, not as an attribute",
        Wpt.UnknownAttributeOn => "unknown attribute {0} on {1}",
        Wpt.IsAssignedTwiceOnThisElement => ".{0} is assigned twice on this element",
        Wpt.AnElementHasOneThisIs => "an element has one {0}; this is a second",
        Wpt.ASemi => "{0};",
        Wpt.ABraceBBraceEnd => "{0}{{1}}",
        Wpt.AmpA => "&{0}",
        Wpt.AColonBSemi => "{0}:{1};",
        Wpt.HiddenInertDisabledRequiredReadonlyCheck => "hidden inert disabled required readonly checked multiple autofocus selected open reversed controls autoplay muted loop playsinline novalidate",
