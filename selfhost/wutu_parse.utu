fn wps(t: Wpt) Str => st(st_wutu_parse + t.i32())
fn wps1(t: Wpt, a: Str) Str => stf(st_wutu_parse + t.i32(), a, "", "", "")
fn wps2(t: Wpt, a: Str, b: Str) Str => stf(st_wutu_parse + t.i32(), a, b, "", "")
fn wps3(t: Wpt, a: Str, b: Str, c: Str) Str => stf(st_wutu_parse + t.i32(), a, b, c, "")
