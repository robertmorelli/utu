//! = Wutu: the template parser
//!
//! Stage 0's `wutu-parse.js`, statement by statement, into flat tables: the
//! template's nodes (text, expression, if, for, element) and each element's
//! items (classes, attributes, events, two-way bindings, CSS, style values).
//! Ranges are offsets in the template's text (the body, inside `/\ … \/`).

/// 0 text, 1 expression, 2 if, 3 for, 4 element.
vec tn_kind: I32;
vec tn_start: I32;
vec tn_parent: I32;
/// First child, or -1.
vec tn_first: I32;
/// Next sibling, or -1.
vec tn_next: I32;
/// If: first node of its otherwise branch, or -1.
vec tn_else: I32;
/// Text: the quoted literal; expression: its source; if: its condition; for: its iterable; element: its tag (words)
vec tn_text: I32;
/// Its range, or -1.
vec tn_from: I32;
vec tn_to: I32;
/// For: its captures (a word)
vec tn_captures: I32;
/// For: its key's source (a word), or -1.
vec tn_key: I32;
vec tn_key_from: I32;
vec tn_key_to: I32;
/// For: whether its key is global.
vec tn_global: I32;
/// Element: its `as` alias (a word), or -1.
vec tn_binding: I32;
/// Element: its number, in order.
vec tn_index: I32;
/// Element: its first item, or -1.
vec tn_items: I32;
vec tn_items_last: I32;

/// 0 class, 1 attribute, 2 event, 3 two-way binding, 4 CSS, 5 style value.
vec ti_kind: I32;
vec ti_next: I32;
/// A name or property (a word)
vec ti_a: I32;
/// A value, handler, or CSS source (a word)
vec ti_b: I32;
/// CSS: its scoped form (a word)
vec ti_c: I32;
/// Attribute: 1 property, 2 dynamic; event: 1 shorthand, 4 quiet. (An
/// event's ti_c is its `|e|` parameter's word, or -1.)
vec ti_flags: I32;
/// Its range, or -1.
vec ti_from: I32;
vec ti_to: I32;
/// Where its statement starts.
vec ti_at: I32;

// The template's header.

/// 1 when the template is reactive (`@reactive;`, or an `@island`).
vec tw_reactive: I32 = [0];
/// `@island "name"`: the quoted name (a word), or -1.
vec tw_scope: I32 = [-1];
/// `@style = e;`: the sources (words), and their ranges.
vec tw_style_value: I32;
vec tw_style_from: I32;
vec tw_style_to: I32;
/// `@document { … }` blocks (words)
vec tw_global: I32;

/// The cursor: an offset in the template's text.
vec wp_at: I32 = [0];

/// A syntax error in the template, at `offset` in its text.
fn wutu_fail(message: Str, offset: I32) void { dsl_fail(message, offset, 1); }

fn reset_template() void {
    tn_kind.clear();
    tn_start.clear();
    tn_parent.clear();
    tn_first.clear();
    tn_next.clear();
    tn_else.clear();
    tn_text.clear();
    tn_from.clear();
    tn_to.clear();
    tn_captures.clear();
    tn_key.clear();
    tn_key_from.clear();
    tn_key_to.clear();
    tn_global.clear();
    tn_binding.clear();
    tn_index.clear();
    tn_items.clear();
    tn_items_last.clear();
    ti_kind.clear();
    ti_next.clear();
    ti_a.clear();
    ti_b.clear();
    ti_c.clear();
    ti_flags.clear();
    ti_from.clear();
    ti_to.clear();
    ti_at.clear();
    tw_reactive[0] = 0;
    tw_scope[0] = -1;
    tw_style_value.clear();
    tw_style_from.clear();
    tw_style_to.clear();
    tw_global.clear();
}

fn new_tnode(kind: I32, start: I32) I32 {
    let n = tn_kind.len();
    tn_kind.push(kind);
    tn_start.push(start);
    tn_parent.push(-1);
    tn_first.push(-1);
    tn_next.push(-1);
    tn_else.push(-1);
    tn_text.push(-1);
    tn_from.push(-1);
    tn_to.push(-1);
    tn_captures.push(-1);
    tn_key.push(-1);
    tn_key_from.push(-1);
    tn_key_to.push(-1);
    tn_global.push(0);
    tn_binding.push(-1);
    tn_index.push(-1);
    tn_items.push(-1);
    tn_items_last.push(-1);
    n;
}

fn add_item(node: I32, kind: I32, a: I32, b: I32, flags: I32, from: I32, to: I32, at: I32) I32 {
    let i = ti_kind.len();
    ti_kind.push(kind);
    ti_next.push(-1);
    ti_a.push(a);
    ti_b.push(b);
    ti_c.push(-1);
    ti_flags.push(flags);
    ti_from.push(from);
    ti_to.push(to);
    ti_at.push(at);
    if tn_items[node] < 0 { tn_items[node] = i; } else { ti_next[tn_items_last[node]] = i; };
    tn_items_last[node] = i;
    i;
}

/// Append child c to a list whose first is at `first_of` (a node's children, or its else).
fn append_child(parent: I32, c: I32, otherwise: Bool) void {
    let first = if otherwise { tn_else[parent]; } else { tn_first[parent]; };
    if first < 0 {
        if otherwise { tn_else[parent] = c; } else { tn_first[parent] = c; };
        return;
    };
    let last = first;
    while (tn_next[last] >= 0) { last = tn_next[last]; };
    tn_next[last] = c;
}

//! = Vocabulary

/// Whether `w` is one of the space-separated words of `list`.
fn in_words(list: Str, w: Str) Bool {
    if w.len() == 0 { return false; };
    let i = text_index(list, w, 0);
    while (i >= 0) {
        let end = i + w.len();
        if (i == 0 or list.get(i - 1) == 32) and (end == list.len() or list.get(end) == 32) { return true; };
        i = text_index(list, w, i + 1);
    };
    false;
}

fn is_boolean_attribute(name: Str) Bool {
    in_words("hidden inert disabled required readonly checked multiple autofocus selected open reversed controls autoplay muted loop playsinline novalidate", name);
}

fn is_void_tag(tag: Str) Bool { in_words("area base br col embed hr img input link meta param source track wbr", tag); }

fn is_svg_tag(tag: Str) Bool {
    in_words("svg g path circle ellipse line polyline polygon rect text tspan defs use symbol linearGradient radialGradient stop clipPath mask pattern marker title desc foreignObject", tag);
}

fn is_svg_attribute(name: Str) Bool {
    in_words("viewBox xmlns width height x y x1 y1 x2 y2 cx cy r rx ry d points fill fill-rule fill-opacity stroke stroke-width stroke-linecap stroke-linejoin stroke-dasharray stroke-dashoffset stroke-opacity opacity transform href offset stop-color stop-opacity gradientUnits gradientTransform preserveAspectRatio clip-path mask xlink:href xlink:title xml:space xmlns:xlink", name);
}

fn is_html_tag(tag: Str) Bool {
    in_words("html head embed param script area base link meta a abbr address article aside audio b bdi bdo blockquote body br button canvas caption cite code col colgroup data datalist dd del details dfn dialog div dl dt em fieldset figcaption figure footer form h1 h2 h3 h4 h5 h6 header hgroup hr i iframe img input ins kbd label legend li main map mark menu meter nav noscript object ol optgroup option output p picture pre progress q rp rt ruby s samp search section select slot small source span strong style sub summary sup table tbody td template textarea tfoot th thead time title tr track u ul var video wbr", tag);
}

fn is_global_attribute(name: Str) Bool {
    in_words("id class title role tabindex hidden inert lang dir draggable contenteditable spellcheck translate slot accesskey part exportparts inputmode enterkeyhint autocapitalize autocorrect autofocus nonce is popover writingsuggestions itemprop itemscope itemtype itemid itemref xml:lang", name);
}

/// The attributes an element of `tag` may have beyond the global ones (space-separated).
fn tag_attributes(tag: Str) Str {
    if tag == "script" { return "src type async defer nonce crossorigin integrity referrerpolicy nomodule fetchpriority blocking"; };
    if tag == "style" { return "media nonce type"; };
    if tag == "embed" { return "src type width height"; };
    if tag == "param" { return "name value"; };
    if tag == "area" { return "alt coords shape href target download rel"; };
    if tag == "base" { return "href target"; };
    if tag == "link" { return "href rel type media sizes crossorigin as fetchpriority integrity referrerpolicy imagesrcset imagesizes hreflang blocking disabled"; };
    if tag == "meta" { return "name content charset http-equiv"; };
    if tag == "a" { return "href target rel download hreflang type referrerpolicy ping"; };
    if tag == "button" { return "type disabled name value form popovertarget popovertargetaction formaction formmethod formenctype formtarget formnovalidate command commandfor"; };
    if tag == "input" { return "type name value placeholder required disabled readonly checked min max step minlength maxlength pattern multiple accept autocomplete size form list capture dirname alt src width height formaction formmethod formenctype formtarget formnovalidate popovertarget popovertargetaction"; };
    if tag == "textarea" { return "name placeholder required disabled readonly rows cols minlength maxlength autocomplete form wrap dirname"; };
    if tag == "form" { return "action method enctype target autocomplete novalidate name rel accept-charset"; };
    if tag == "label" { return "for"; };
    if tag == "img" { return "src alt width height loading decoding srcset sizes fetchpriority crossorigin referrerpolicy usemap ismap"; };
    if tag == "source" { return "src srcset sizes type media"; };
    if tag == "select" { return "name required disabled multiple size form autocomplete"; };
    if tag == "option" { return "value selected disabled label"; };
    if tag == "optgroup" { return "label disabled"; };
    if tag == "fieldset" { return "disabled form name"; };
    if tag == "output" { return "for form name"; };
    if tag == "details" { return "open name"; };
    if tag == "dialog" { return "open"; };
    if tag == "progress" { return "value max"; };
    if tag == "meter" { return "value min max low high optimum"; };
    if tag == "ol" { return "start reversed type"; };
    if tag == "li" { return "value"; };
    if tag == "time" { return "datetime"; };
    if tag == "del" or tag == "ins" { return "datetime cite"; };
    if tag == "blockquote" or tag == "q" { return "cite"; };
    if tag == "canvas" { return "width height"; };
    if tag == "td" { return "colspan rowspan headers"; };
    if tag == "th" { return "colspan rowspan headers scope abbr"; };
    if tag == "video" { return "src controls autoplay muted loop playsinline poster width height preload crossorigin disablepictureinpicture disableremoteplayback"; };
    if tag == "audio" { return "src controls autoplay muted loop preload crossorigin"; };
    if tag == "object" { return "data type name width height form usemap"; };
    if tag == "iframe" { return "src srcdoc name title width height loading allow allowfullscreen sandbox referrerpolicy"; };
    "";
}

fn is_custom_element(tag: Str) Bool { text_index(tag, "-", 0) >= 0; }

fn is_known_tag(tag: Str) Bool { is_html_tag(tag) or is_svg_tag(tag) or is_custom_element(tag); }

/// Global, `aria-` and `data-` attributes, the tag's own, SVG's on an SVG
/// tag, and anything on a custom element.
fn is_allowed_attribute(tag: Str, name: Str) Bool {
    is_global_attribute(name) or text_at(name, 0, "aria-") or text_at(name, 0, "data-") or in_words(tag_attributes(tag), name)
        or (is_svg_tag(tag) and is_svg_attribute(name)) or is_custom_element(tag);
}

fn is_name_code(c: I32) Bool { is_word_code(c) or c == 45; }

/// `--x` or `-?[a-z][\w-]*`: a CSS property.
fn is_css_property(head: Str) Bool {
    if text_at(head, 0, "--") {
        if head.len() < 3 { return false; };
        for (2 ..< head.len()) |i| { if not is_name_code(head.get(i)) { return false; }; };
        return true;
    };
    let i = if head.len() > 0 and head.get(0) == 45 { 1; } else { 0; };
    if i >= head.len() or not is_lower_code(head.get(i)) { return false; };
    for (i + 1 ..< head.len()) |k| { if not is_name_code(head.get(k)) { return false; }; };
    true;
}

/// The standard CSS properties (lib.dom's CSSStyleDeclaration, and newer ones).
fn css_properties() Str {
    "accent-color align-content align-items align-self alignment-baseline all anchor-name anchor-scope animation animation-composition animation-delay "
        + "animation-direction animation-duration animation-fill-mode animation-iteration-count animation-name animation-play-state animation-range "
        + "animation-range-end animation-range-start animation-timeline animation-timing-function appearance aspect-ratio backdrop-filter backface-visibility "
        + "background background-attachment background-blend-mode background-clip background-color background-image background-origin background-position "
        + "background-position-x background-position-y background-repeat background-size baseline-shift baseline-source block-size border border-block "
        + "border-block-color border-block-end border-block-end-color border-block-end-style border-block-end-width border-block-start border-block-start-color "
        + "border-block-start-style border-block-start-width border-block-style border-block-width border-bottom border-bottom-color border-bottom-left-radius "
        + "border-bottom-right-radius border-bottom-style border-bottom-width border-collapse border-color border-end-end-radius border-end-start-radius "
        + "border-image border-image-outset border-image-repeat border-image-slice border-image-source border-image-width border-inline border-inline-color "
        + "border-inline-end border-inline-end-color border-inline-end-style border-inline-end-width border-inline-start border-inline-start-color "
        + "border-inline-start-style border-inline-start-width border-inline-style border-inline-width border-left border-left-color border-left-style "
        + "border-left-width border-radius border-right border-right-color border-right-style border-right-width border-spacing border-start-end-radius "
        + "border-start-start-radius border-style border-top border-top-color border-top-left-radius border-top-right-radius border-top-style border-top-width "
        + "border-width bottom box-decoration-break box-shadow box-sizing break-after break-before break-inside caption-side caret-color clear clip clip-path "
        + "clip-rule color color-interpolation color-interpolation-filters color-scheme column-count column-fill column-gap column-rule column-rule-color "
        + "column-rule-style column-rule-width column-span column-width columns contain contain-intrinsic-block-size contain-intrinsic-height "
        + "contain-intrinsic-inline-size contain-intrinsic-size contain-intrinsic-width container container-name container-type content content-visibility "
        + "counter-increment counter-reset counter-set cursor cx cy d direction display dominant-baseline dynamic-range-limit empty-cells field-sizing fill "
        + "fill-opacity fill-rule filter flex flex-basis flex-direction flex-flow flex-grow flex-shrink flex-wrap float flood-color flood-opacity font "
        + "font-family font-feature-settings font-kerning font-optical-sizing font-palette font-size font-size-adjust font-stretch font-style font-synthesis "
        + "font-synthesis-small-caps font-synthesis-style font-synthesis-weight font-variant font-variant-alternates font-variant-caps font-variant-east-asian "
        + "font-variant-ligatures font-variant-numeric font-variant-position font-variation-settings font-weight forced-color-adjust gap grid grid-area "
        + "grid-auto-columns grid-auto-flow grid-auto-rows grid-column grid-column-end grid-column-gap grid-column-start grid-gap grid-row grid-row-end "
        + "grid-row-gap grid-row-start grid-template grid-template-areas grid-template-columns grid-template-rows height hyphenate-character "
        + "hyphenate-limit-chars hyphens image-orientation image-rendering initial-letter inline-size inset inset-block inset-block-end inset-block-start "
        + "inset-inline inset-inline-end inset-inline-start interpolate-size isolation justify-content justify-items justify-self left letter-spacing "
        + "lighting-color line-break line-clamp line-height list-style list-style-image list-style-position list-style-type margin margin-block margin-block-end "
        + "margin-block-start margin-bottom margin-inline margin-inline-end margin-inline-start margin-left margin-right margin-top marker marker-end marker-mid "
        + "marker-start mask mask-clip mask-composite mask-image mask-mode mask-origin mask-position mask-repeat mask-size mask-type math-depth math-style "
        + "max-block-size max-height max-inline-size max-width min-block-size min-height min-inline-size min-width mix-blend-mode object-fit object-position "
        + "offset offset-anchor offset-distance offset-path offset-position offset-rotate opacity order orphans outline outline-color outline-offset "
        + "outline-style outline-width overflow overflow-anchor overflow-block overflow-clip-margin overflow-inline overflow-wrap overflow-x overflow-y overlay "
        + "overscroll-behavior overscroll-behavior-block overscroll-behavior-inline overscroll-behavior-x overscroll-behavior-y padding padding-block "
        + "padding-block-end padding-block-start padding-bottom padding-inline padding-inline-end padding-inline-start padding-left padding-right padding-top "
        + "page page-break-after page-break-before page-break-inside paint-order perspective perspective-origin place-content place-items place-self "
        + "pointer-events position position-anchor position-area position-try position-try-fallbacks position-try-order position-visibility print-color-adjust "
        + "quotes r reading-flow reading-order resize right rotate row-gap ruby-align ruby-position rx ry scale scroll-behavior scroll-margin scroll-margin-block "
        + "scroll-margin-block-end scroll-margin-block-start scroll-margin-bottom scroll-margin-inline scroll-margin-inline-end scroll-margin-inline-start "
        + "scroll-margin-left scroll-margin-right scroll-margin-top scroll-padding scroll-padding-block scroll-padding-block-end scroll-padding-block-start "
        + "scroll-padding-bottom scroll-padding-inline scroll-padding-inline-end scroll-padding-inline-start scroll-padding-left scroll-padding-right "
        + "scroll-padding-top scroll-snap-align scroll-snap-stop scroll-snap-type scroll-timeline scroll-timeline-axis scroll-timeline-name scrollbar-color "
        + "scrollbar-gutter scrollbar-width shape-image-threshold shape-margin shape-outside shape-rendering stop-color stop-opacity stroke stroke-dasharray "
        + "stroke-dashoffset stroke-linecap stroke-linejoin stroke-miterlimit stroke-opacity stroke-width tab-size table-layout text-align text-align-last "
        + "text-anchor text-autospace text-box text-box-edge text-box-trim text-combine-upright text-decoration text-decoration-color text-decoration-line "
        + "text-decoration-skip-ink text-decoration-style text-decoration-thickness text-emphasis text-emphasis-color text-emphasis-position text-emphasis-style "
        + "text-indent text-orientation text-overflow text-rendering text-shadow text-size-adjust text-spacing-trim text-transform text-underline-offset "
        + "text-underline-position text-wrap text-wrap-mode text-wrap-style timeline-scope top touch-action transform transform-box transform-origin "
        + "transform-style transition transition-behavior transition-delay transition-duration transition-property transition-timing-function translate "
        + "unicode-bidi user-select vector-effect vertical-align view-timeline view-timeline-axis view-timeline-inset view-timeline-name view-transition-class "
        + "view-transition-name visibility white-space white-space-collapse widows width will-change word-break word-spacing word-wrap writing-mode x y z-index "
        + "zoom";
}

/// A standard CSS property `name` is likely a typo of (one edit, two for a
/// long name), or "" for a known one, a prefixed or custom one (`-webkit-…`,
/// `--x`), or one near none (a property newer than the list).
fn near_css_property(name: Str) Str {
    if name.len() == 0 or name.get(0) == 45 or in_words(css_properties(), name) { return ""; };
    let near = closest_word(css_properties(), name);
    if near.len() == 0 { return ""; };
    if word_distance(intern_text(near), intern_text(name), 3) > 1 and name.len() <= 6 { return ""; };
    near;
}

/// A typo of a standard property fails, saying which.
fn css_property_known(name: Str, at: I32) void {
    let near = near_css_property(name);
    if near.len() > 0 { wutu_fail("invalid CSS property " + name + "; did you mean " + near + "?", at); };
}

/// A value (`text[from ..< to]`) that runs onto the next line's declaration or
/// rule (`padding: 1rem` then `gap: 2rem;`): its `;` is missing, at its line's end.
fn css_value_runs_on(text: Str, from: I32, to: I32) void {
    let parens = 0;
    let i = from;
    while (i < to) {
        let c = text.get(i);
        if c == 34 or c == 39 {
            i += 1;
            while (i < to and text.get(i) != c) { i += if text.get(i) == 92 { 2; } else { 1; }; };
        } else if c == 40 { parens += 1; }
        else if c == 41 { parens -= 1; }
        else if c == 10 and parens == 0 {
            let j = skip_spaces(text, i + 1);
            let k = j;
            while (k < text.len() and is_name_code(text.get(k))) { k += 1; };
            let after = skip_spaces(text, k);
            if k > j and (is_lower_code(text.get(j)) or text.get(j) == 45) and after < text.len() and (text.get(after) == 58 or text.get(after) == 123) {
                let end = i;
                while (end > from and is_space_code(text.get(end - 1))) { end -= 1; };
                wutu_fail("CSS declarations require a semicolon", end);
            };
        };
        i += 1;
    };
}

//! = The parser

fn wp_done(text: Str) Bool { wp_at[0] >= text.len(); }

fn wp_char(text: Str) I32 { if wp_at[0] < text.len() { text.get(wp_at[0]); } else { -1; }; }

fn wp_at_text(text: Str, part: Str) Bool { text_at(text, wp_at[0], part); }

/// A word then whitespace at the cursor (`if `, `for `, `as `), not consumed.
fn wp_keyword(text: Str, word: Str) Bool {
    let i = wp_at[0];
    text_at(text, i, word) and i + word.len() < text.len() and is_space_code(text.get(i + word.len()));
}

/// Whether offset p starts the text or follows a blank (a `//` there is a
/// comment, not `url(http://…)`).
fn wp_after_blank(text: Str, p: I32) Bool { p == 0 or is_space_code(text.get(p - 1)); }

/// Whitespace, `//` comments (first on a line or after a blank), and CSS comments.
fn wp_trivia(text: Str) void {
    while (wp_at[0] < text.len()) {
        let p = wp_at[0];
        let c = text.get(p);
        if is_space_code(c) {
            wp_at[0] += 1;
        } else if text_at(text, p, "//") and wp_after_blank(text, p) {
            wp_skip_line(text);
        } else if c == 35 and p + 1 < text.len() and (text.get(p + 1) == 32 or text.get(p + 1) == 9) {
            wutu_fail("Wutu comments are written // …", p);
        } else if text_at(text, p, "/*") {
            let end = text_index(text, "*/", p + 2);
            if end < 0 { wutu_fail("unterminated comment", p); };
            wp_at[0] = end + 2;
        } else {
            return;
        };
    };
}

fn wp_skip_line(text: Str) void {
    let end = text_index(text, "\n", wp_at[0]);
    wp_at[0] = if end < 0 { text.len(); } else { end; };
}

fn wp_semicolon(text: Str) void {
    let statement_end = wp_at[0];
    wp_trivia(text);
    if wp_char(text) != 59 { wutu_fail("expected ; after Wutu statement", statement_end); };
    wp_at[0] += 1;
}

/// A quoted string, CSS or Utu: a backslash escapes the character after it.
fn wp_quoted(text: Str) Str {
    let start = wp_at[0];
    let quote = text.get(start);
    wp_at[0] += 1;
    while (wp_at[0] < text.len()) {
        let c = text.get(wp_at[0]);
        if c == 92 {
            wp_at[0] += 2;
        } else {
            wp_at[0] += 1;
            if c == quote { return text.slice(start, wp_at[0]); };
        };
    };
    wutu_fail("unterminated string", start);
    "";
}

/// Skip a Utu token whose contents are not delimiters: a nested DSL, a
/// string, or a line comment. Whether it skipped one.
fn wp_opaque(text: Str) Bool {
    let p = wp_at[0];
    let c = text.get(p);
    if c == 64 {
        let end = skip_dsl(text, p);
        if end > p {
            wp_at[0] = end;
            return true;
        };
    } else if c == 34 {
        wp_quoted(text);
        return true;
    } else if text_at(text, p, "//") {
        wp_skip_line(text);
        return true;
    };
    false;
}

/// `@name/\ … \/` starting at `start`: the offset after it, else `start`.
fn skip_dsl(text: Str, start: I32) I32 {
    let i = start + 1;
    if i >= text.len() or not is_word_code(text.get(i)) { return start; };
    while (i < text.len() and is_word_code(text.get(i))) { i += 1; };
    i = skip_spaces(text, i);
    if not text_at(text, i, "/\\") { return start; };
    let depth = 1;
    let j = i + 2;
    while (j < text.len() - 1) {
        if text.get(j) == 34 {
            // A string is text (to its closing quote or its line).
            j += 1;
            while (j < text.len() and text.get(j) != 34 and text.get(j) != 10) {
                j += if text.get(j) == 92 and j + 1 < text.len() and text.get(j + 1) != 10 { 2; } else { 1; };
            };
            if j >= text.len() or text.get(j) == 10 { j -= 1; };
        } else if text.get(j) == 47 and text.get(j + 1) == 92 {
            depth += 1;
            j += 1;
        } else if text.get(j) == 92 and text.get(j + 1) == 47 {
            depth -= 1;
            if depth == 0 { return j + 2; };
            j += 1;
        };
        j += 1;
    };
    wutu_fail("Unterminated DSL envelope", start);
    start;
}

/// An expression read: its source, and its range, here.
vec wx_from: I32 = [0];
vec wx_to: I32 = [0];

/// `= expression;`: up to the statement's semicolon.
fn wp_bare_expression(text: Str) Str {
    wp_trivia(text);
    let start = wp_at[0];
    let depth = 0;
    while (not wp_done(text)) {
        if not wp_opaque(text) {
            let c = text.get(wp_at[0]);
            if c == 59 and depth == 0 {
                wx_from[0] = start;
                wx_to[0] = wp_at[0];
                return trim_text(text.slice(start, wp_at[0]));
            };
            if c == 40 or c == 91 or c == 123 { depth += 1; }
            else if c == 41 or c == 93 or c == 125 {
                if depth == 0 { wutu_fail("expected ; after expression", wp_at[0]); };
                depth -= 1;
            };
            wp_at[0] += 1;
        };
    };
    wutu_fail("unterminated expression", start);
    "";
}

/// `$[expression]`.
/// An expression up to the first top-level character in `ends` (not
/// consumed): `if cond {`, `for items |item|`, `key item.id {`. Braces or
/// pipes of its own go in parentheses.
fn wp_expression_until(text: Str, ends: Str, what: Str) Str {
    wp_trivia(text);
    if wp_at_text(text, "$[") { wp_fail_interpolation(text); };
    let start = wp_at[0];
    let depth = 0;
    while (not wp_done(text)) {
        if not wp_opaque(text) {
            let c = text.get(wp_at[0]);
            if depth == 0 and text_index(ends, Str.from_code_point(c), 0) >= 0 {
                let source = trim_end(text.slice(start, wp_at[0]));
                if source.len() == 0 { wutu_fail("expected " + what, wp_at[0]); };
                wx_from[0] = start;
                wx_to[0] = start + source.len();
                return source;
            };
            if c == 40 or c == 91 or c == 123 { depth += 1; }
            else if c == 41 or c == 93 or c == 125 {
                if depth == 0 { wutu_fail("expected " + what, wp_at[0]); };
                depth -= 1;
            };
            wp_at[0] += 1;
        };
    };
    wutu_fail("unterminated " + what, start);
    "";
}

/// A `for` iterable (its range in wx_from/wx_to) without parentheses that
/// only hide its pipeline's captures: `(xs filter |x| { … })` is
/// `xs filter |x| { … }`, and the loop's body continues that pipeline.
/// Parentheses around a finished pipeline (one ending in a terminal, like
/// sort) or a range (`(0..<n)`) stay.
fn unparenthesized(source: Str) Str {
    let n = source.len();
    if n < 2 or source.get(0) != 40 or source.get(n - 1) != 41 { return source; };
    let depth = 0;
    let last = "";
    let i = 0;
    while (i < n) {
        let c = source.get(i);
        let before = if i > 0 { source.get(i - 1); } else { 32; };
        if c == 34 {
            i += 1;
            while (i < n and source.get(i) != 34) { i += if source.get(i) == 92 { 2; } else { 1; }; };
        } else if c == 40 or c == 91 or c == 123 {
            depth += 1;
        } else if c == 41 or c == 93 or c == 125 {
            depth -= 1;
            if depth == 0 and i < n - 1 { return source; };
        } else if depth == 1 and ((c >= 97 and c <= 122) or c == 95) and not is_word_code(before) and before != 46 {
            let w = i;
            while (i + 1 < n and is_word_code(source.get(i + 1))) { i += 1; };
            let word = source.slice(w, i + 1);
            if in_words("fold each any all count_where first_index last_index sum fast_sum product count collect sort group_by distinct_by partition batched windows min_by max_by first_where reduce bisect", word) or in_words("map filter skip take skip_while take_while scan zip chain flat_map repeat", word) { last = word; };
        };
        i += 1;
    };
    if last.len() == 0 or in_words("fold each any all count_where first_index last_index sum fast_sum product count collect sort group_by distinct_by partition batched windows min_by max_by first_where reduce bisect", last) { return source; };
    wx_from[0] += 1;
    wx_to[0] -= 1;
    trim_text(source.slice(1, n - 1));
}

fn wp_fail_interpolation(text: Str) void {
    wutu_fail("Wutu no longer writes $[…]: an expression stands on its own (= expr; for text, name = expr; for an attribute, if cond {, prop: = expr;)", wp_at[0]);
}

/// A brace-delimited Utu block, with its braces.
fn wp_utu_block(text: Str) Str {
    let start = wp_at[0];
    let depth = 0;
    let first = true;
    while (first or (not wp_done(text) and depth > 0)) {
        first = false;
        if not wp_opaque(text) {
            let c = text.get(wp_at[0]);
            if c == 123 { depth += 1; } else if c == 125 { depth -= 1; };
            wp_at[0] += 1;
        };
    };
    if depth != 0 { wutu_fail("unterminated event handler", start); };
    wx_from[0] = start;
    wx_to[0] = wp_at[0];
    text.slice(start, wp_at[0]);
}

//! = CSS

/// Up to a delimiter outside strings, functions, and attribute selectors.
fn wp_css_until(text: Str, delimiters: Str) Str {
    let start = wp_at[0];
    let parens = 0;
    let brackets = 0;
    while (not wp_done(text)) {
        let c = text.get(wp_at[0]);
        if c == 34 or c == 39 { wp_quoted(text); }
        else {
            if parens == 0 and brackets == 0 and text_index(delimiters, Str.from_code_point(c), 0) >= 0 { break; };
            if c == 40 { parens += 1; } else if c == 41 { parens -= 1; } else if c == 91 { brackets += 1; } else if c == 93 { brackets -= 1; };
            wp_at[0] += 1;
        };
    };
    trim_text(text.slice(start, wp_at[0]));
}

/// The body of a `{ … }` CSS block (cursor on the brace), without its braces.
/// A `{ … }` CSS block's body (the cursor on its brace), without its `//`
/// comments (CSS has none; `url(http://…)` is not one: a comment starts first
/// on a line or after a blank, outside parentheses).
fn wp_css_block(text: Str) Str {
    let open = wp_at[0];
    wp_at[0] += 1;
    let start = wp_at[0];
    let body = "";
    let depth = 1;
    let parens = 0;
    while (not wp_done(text)) {
        let p = wp_at[0];
        if wp_at_text(text, "/*") {
            let end = text_index(text, "*/", p + 2);
            if end < 0 { wutu_fail("unterminated CSS comment", p); };
            wp_at[0] = end + 2;
        } else if text_at(text, p, "//") and parens == 0 and wp_after_blank(text, p) {
            body = body + text.slice(start, p);
            wp_skip_line(text);
            start = wp_at[0];
        } else {
            let c = text.get(p);
            if c == 34 or c == 39 { wp_quoted(text); }
            else {
                if c == 35 and p + 1 < text.len() and (text.get(p + 1) == 32 or text.get(p + 1) == 9) { wutu_fail("Wutu comments are written // …", p); };
                if c == 40 { parens += 1; } else if c == 41 { parens -= 1; };
                if c == 123 { depth += 1; };
                if c == 125 {
                    let before = trim_end(without_css_comments(body + text.slice(start, p)));
                    let last = if before.len() > 0 { before.get(before.len() - 1); } else { 59; };
                    if not (last == 59 or last == 123 or last == 125) { wutu_fail("CSS declarations require a semicolon", p); };
                    depth -= 1;
                    if depth == 0 {
                        let block = body + text.slice(start, p);
                        wp_at[0] += 1;
                        return block;
                    };
                };
                wp_at[0] += 1;
            };
        };
    };
    wutu_fail("unterminated CSS block", open);
    "";
}

fn without_css_comments(text: Str) Str {
    let out = "";
    let i = 0;
    while (i < text.len()) {
        if text_at(text, i, "/*") {
            let end = text_index(text, "*/", i + 2);
            if end < 0 { return out + text.slice(i, text.len()); };
            i = end + 2;
        } else {
            out = out + Str.from_code_point(text.get(i));
            i += 1;
        };
    };
    out;
}

//! = Template structure

/// The template; returns its root element.
fn parse_template(text: Str) I32 {
    reset_template();
    wp_at[0] = 0;
    wp_trivia(text);
    if wp_at_text(text, "@reactive") {
        wp_at[0] += 9;
        wp_semicolon(text);
        tw_reactive[0] = 1;
        wp_trivia(text);
    };
    if wp_at_text(text, "@island") {
        wp_at[0] += 7;
        wp_trivia(text);
        if wp_char(text) != 34 { wutu_fail("expected a quoted island name: @island \"name\";", wp_at[0]); };
        tw_scope[0] = intern_text(wp_quoted(text));
        wp_semicolon(text);
        tw_reactive[0] = 1;
        wp_trivia(text);
    };
    while (wp_at_text(text, "@style")) {
        wp_at[0] += 6;
        wp_trivia(text);
        if wp_at_text(text, "$[") { wp_fail_interpolation(text); };
        let source = wp_bare_expression(text);
        let from = wx_from[0];
        let to = wx_to[0];
        wp_semicolon(text);
        tw_style_value.push(intern_text(source));
        tw_style_from.push(from);
        tw_style_to.push(to);
        wp_trivia(text);
    };
    while (wp_at_text(text, "@document")) {
        wp_at[0] += 9;
        wp_trivia(text);
        if wp_char(text) != 123 { wutu_fail("expected document CSS block", wp_at[0]); };
        tw_global.push(intern_text(wp_css_block(text)));
        wp_trivia(text);
    };
    if wp_char(text) == 64 { at_directive(text, wp_at[0], false); };
    let root = parse_tnode(text);
    if tn_kind[root] != 4 { wutu_fail("root must be an element", tn_start[root]); };
    wp_trivia(text);
    if not wp_done(text) { wutu_fail("expected exactly one root element; use a component for siblings", wp_at[0]); };
    root;
}

/// Text, an expression, if, for, or an element.
fn parse_tnode(text: Str) I32 {
    wp_trivia(text);
    let start = wp_at[0];
    if wp_char(text) == 34 {
        let expr = wp_quoted(text);
        wp_semicolon(text);
        let n = new_tnode(0, start);
        tn_text[n] = intern_text(expr);
        return n;
    };
    if wp_at_text(text, "$[") { wp_fail_interpolation(text); };
    if wp_char(text) == 61 {
        wp_at[0] += 1;
        let source = wp_bare_expression(text);
        let from = wx_from[0];
        let to = wx_to[0];
        wp_semicolon(text);
        let n = new_tnode(1, start);
        tn_text[n] = intern_text(source);
        tn_from[n] = from;
        tn_to[n] = to;
        return n;
    };
    if wp_keyword(text, "if") { return parse_tif(text); };
    if wp_keyword(text, "for") { return parse_tfor(text); };
    parse_telement(text);
}

/// `{ nodes }`, into node n's children (or its otherwise).
fn parse_branch(text: Str, n: I32, otherwise: Bool) void {
    wp_trivia(text);
    let open = wp_at[0];
    if wp_char(text) != 123 { wutu_fail("expected {", wp_at[0]); };
    wp_at[0] += 1;
    while (true) {
        wp_trivia(text);
        if wp_done(text) { wutu_fail("unterminated branch", open); };
        if wp_char(text) == 125 {
            wp_at[0] += 1;
            return;
        };
        let c = parse_tnode(text);
        tn_parent[c] = n;
        append_child(n, c, otherwise);
    };
}

/// `if e { … } else { … }`, the cursor on `if`.
fn parse_tif(text: Str) I32 {
    let start = wp_at[0];
    wp_at[0] += 2;
    let condition = wp_expression_until(text, "{", "a condition before {");
    let n = new_tnode(2, start);
    tn_text[n] = intern_text(condition);
    tn_from[n] = wx_from[0];
    tn_to[n] = wx_to[0];
    parse_branch(text, n, false);
    wp_trivia(text);
    let p = wp_at[0];
    if text_at(text, p, "else") {
        let i = p + 4;
        let gap = i;
        i = skip_spaces(text, i);
        if i > gap and text_at(text, i, "if") and i + 2 < text.len() and is_space_code(text.get(i + 2)) {
            wp_at[0] = p + 4;
            wp_trivia(text);
            let inner = parse_tif(text);
            tn_parent[inner] = n;
            tn_else[n] = inner;
        } else if i < text.len() and text.get(i) == 123 {
            wp_at[0] = p + 4;
            parse_branch(text, n, true);
        };
    };
    n;
}

/// `for e |x| { … }`, the cursor on `for`.
fn parse_tfor(text: Str) I32 {
    let start = wp_at[0];
    wp_at[0] += 3;
    // (The loop's body joins the iterable's pipeline: parentheses that only
    // hide its own `|…|` go.)
    let iterable = unparenthesized(wp_expression_until(text, "|", "what to iterate, then |item|"));
    let n = new_tnode(3, start);
    tn_text[n] = intern_text(iterable);
    tn_from[n] = wx_from[0];
    tn_to[n] = wx_to[0];
    wp_trivia(text);
    // |item| or |item, index|
    let captures = wp_captures(text);
    if captures.len() == 0 { wutu_fail("expected |item| or |item, index| after iterable", wp_at[0]); };
    tn_captures[n] = intern_text(captures);
    wp_trivia(text);
    if wp_keyword(text, "key") {
        wp_at[0] += 3;
        wp_trivia(text);
        if wp_keyword(text, "global") {
            wp_at[0] += 6;
            wp_trivia(text);
            tn_global[n] = 1;
        };
        tn_key[n] = intern_text(wp_expression_until(text, "{", "a key before {"));
        tn_key_from[n] = wx_from[0];
        tn_key_to[n] = wx_to[0];
    };
    parse_branch(text, n, false);
    n;
}

/// `|a|` or `|a, b|` at the cursor: "a" or "a, b" as written (consumed), or "".
fn wp_captures(text: Str) Str {
    let p = wp_at[0];
    if wp_char(text) != 124 { return ""; };
    let i = skip_spaces(text, p + 1);
    let from = i;
    if i >= text.len() or not (is_lower_code(text.get(i)) or text.get(i) == 95) { return ""; };
    while (i < text.len() and is_word_code(text.get(i))) { i += 1; };
    let j = skip_spaces(text, i);
    if j < text.len() and text.get(j) == 44 {
        j += 1;
        j = skip_spaces(text, j);
        if j >= text.len() or not (is_lower_code(text.get(j)) or text.get(j) == 95) { return ""; };
        while (j < text.len() and is_word_code(text.get(j))) { j += 1; };
        i = j;
    };
    let to = i;
    i = skip_spaces(text, i);
    if i >= text.len() or text.get(i) != 124 { return ""; };
    wp_at[0] = i + 1;
    text.slice(from, to);
}

/// An element: its tag, classes, and `as` alias, then a `{ … }` body or `;`.
fn parse_telement(text: Str) I32 {
    let start = wp_at[0];
    let p = start;
    if p >= text.len() or not is_lower_code(text.get(p)) { wutu_fail("expected an HTML tag (class-only heads do not create elements)", p); };
    let q = p;
    while (q < text.len() and is_name_code(text.get(q))) { q += 1; };
    let tag = text.slice(p, q);
    if not is_known_tag(tag) { wutu_fail("expected an HTML tag, found unknown element '" + tag + "' (custom element names need a hyphen)", p); };
    wp_at[0] = q;
    let n = new_tnode(4, start);
    tn_text[n] = intern_text(tag);
    while (wp_char(text) == 46 or wp_char(text) == 35) {
        let shorthand = wp_char(text);
        wp_at[0] += 1;
        let a = wp_at[0];
        let b = a;
        while (b < text.len() and is_name_code(text.get(b))) { b += 1; };
        if b == a { wutu_fail("expected class or id", a); };
        let name = text.slice(a, b);
        wp_at[0] = b;
        if shorthand == 46 { add_item(n, 0, intern_text(name), -1, 0, -1, -1, a); }
        else {
            if has_attribute_item(n, "id") { wutu_fail("an element has one id; #" + name + " is a second", a - 1); };
            add_item(n, 1, intern_text("id"), intern_text(js_string(name)), 0, -1, -1, wp_at[0]);
        };
    };
    wp_trivia(text);
    if wp_keyword(text, "as") {
        wp_at[0] += 2;
        wp_trivia(text);
        let a = wp_at[0];
        if a >= text.len() or not (is_lower_code(text.get(a)) or text.get(a) == 95) { wutu_fail("expected node binding", a); };
        let b = a;
        while (b < text.len() and is_word_code(text.get(b))) { b += 1; };
        tn_binding[n] = intern_text(text.slice(a, b));
        wp_at[0] = b;
        wp_trivia(text);
    };
    if wp_char(text) != 123 { wutu_fail("expected { after element head", wp_at[0]); };
    wp_at[0] += 1;
    while (true) {
        wp_trivia(text);
        if wp_done(text) { wutu_fail("unterminated element '" + tag + "'", start); };
        if wp_char(text) == 125 {
            wp_at[0] += 1;
            break;
        };
        parse_element_statement(text, n);
    };
    if is_void_tag(tag) and tn_first[n] >= 0 { wutu_fail(tag + " cannot have children", start); };
    if tag == "script" or is_raw_text_tag(tag) {
        let c = tn_first[n];
        while (c >= 0) {
            // (An element's text and attributes are escaped.)
            if tn_kind[c] != 0 and tn_kind[c] != 4 and tag != "script" { wutu_fail(raw_text_error(tag), tn_start[c]); };
            if tn_kind[c] != 0 and tag == "script" { wutu_fail("a script's text is code, so Wutu writes it only as written: script { \"…\"; }", tn_start[c]); };
            c = tn_next[c];
        };
    };
    let i = tn_items[n];
    while (i >= 0) {
        if ti_kind[i] == 3 and word_text(ti_a[i]) == "values" and not (tag == "select" and has_attribute_item(n, "multiple")) {
            wutu_fail("bind:values is a multiple select's: select { multiple; bind:values = …; }", ti_at[i]);
        };
        i = ti_next[i];
    };
    if tn_first[n] >= 0 and has_attribute_item(n, "data-wutu-unmanaged") {
        wutu_fail("an @unmanaged " + tag + " has no children in its template: what is inside it is JavaScript's", start);
    };
    n;
}

/// Elements whose text HTML holds unescaped (raw text; a script's is code):
/// prerendered, a value there could close the element and start markup.
fn is_raw_text_tag(tag: Str) Bool { in_words("style noscript iframe xmp noembed noframes plaintext", tag); }

fn raw_text_error(tag: Str) Str {
    (if tag == "iframe" { "an "; } else { "a "; }) + tag + "'s text is unescaped in HTML (a value could close it), so Wutu writes it only as written: " + tag + " { \"…\"; }";
}

/// Whether element n has an attribute item named `name`.
fn has_attribute_item(n: I32, name: Str) Bool {
    let i = tn_items[n];
    while (i >= 0) {
        if ti_kind[i] == 1 and word_text(ti_a[i]) == name { return true; };
        i = ti_next[i];
    };
    false;
}

fn add_child(n: I32, c: I32) void {
    tn_parent[c] = n;
    append_child(n, c, false);
}

/// One statement of an element's body: an item, a CSS rule, or a child node.
fn parse_element_statement(text: Str, n: I32) void {
    let p = wp_at[0];
    let c = text.get(p);
    if c == 59 {
        wp_at[0] += 1;
        return;
    };
    if wp_at_text(text, "$[") { wp_fail_interpolation(text); };
    // (`for = "x";` is label's attribute: a loop's iterable never starts with `=`.)
    if c == 34 or c == 61 or wp_keyword(text, "if") or (wp_keyword(text, "for") and not assignment_head(text, p, false)) {
        add_child(n, parse_tnode(text));
        return;
    };
    // bind:value|checked|number|group|values|files =
    if text_at(text, p, "bind:") {
        let q = p + 5;
        let property = "";
        for (["value", "checked", "number", "group", "values", "files"]) |candidate| {
            if property.len() == 0 and text_at(text, q, candidate) and not (q + candidate.len() < text.len() and is_name_code(text.get(q + candidate.len()))) { property = candidate; };
        };
        if property.len() > 0 {
            let r = skip_spaces(text, q + property.len());
            if r < text.len() and text.get(r) == 61 {
                wp_at[0] = r + 1;
                let source = wp_bare_expression(text);
                let from = wx_from[0];
                let to = wx_to[0];
                wp_semicolon(text);
                add_item(n, 3, intern_text(property), intern_text(source), 0, from, to, p);
                return;
            };
        };
    };
    // on name [quiet] [|e|] { … }, or on name [quiet] = handler;
    if text_at(text, p, "on") and p + 2 < text.len() and is_space_code(text.get(p + 2)) {
        let q = skip_spaces(text, p + 2);
        let a = q;
        while (q < text.len() and is_name_code(text.get(q))) { q += 1; };
        let r = skip_spaces(text, q);
        let quiet = text_at(text, r, "quiet") and r + 5 < text.len() and not is_name_code(text.get(r + 5));
        if quiet { r = skip_spaces(text, r + 5); };
        let param = -1;
        if r < text.len() and text.get(r) == 124 {
            let b = skip_spaces(text, r + 1);
            let e = b;
            while (e < text.len() and is_word_code(text.get(e))) { e += 1; };
            let close = skip_spaces(text, e);
            if e > b and close < text.len() and text.get(close) == 124 {
                param = intern_text(text.slice(b, e));
                r = skip_spaces(text, close + 1);
            };
        };
        if q > a and r < text.len() and (text.get(r) == 123 or text.get(r) == 61) {
            let name = text.slice(a, q);
            let near = near_event(name);
            if near.len() > 0 { wutu_fail("unknown event " + name + "; did you mean " + near + "?", a); };
            let flags = if quiet { 4; } else { 0; };
            if text.get(r) == 61 {
                if param >= 0 { wutu_fail("a handler value names its own parameter: on click = cl(e) void { … };", r); };
                wp_at[0] = r + 1;
                let source = wp_bare_expression(text);
                let from = wx_from[0];
                let to = wx_to[0];
                wp_semicolon(text);
                add_item(n, 2, intern_text(name), intern_text(source), flags, from, to, p);
                return;
            };
            wp_at[0] = r;
            let source = wp_utu_block(text);
            let i = add_item(n, 2, intern_text(name), intern_text(source), 1 + flags, wx_from[0], wx_to[0], p);
            ti_c[i] = param;
            return;
        };
    };
    if c == 60 { wutu_fail(old_attribute_text(text, p), p); };
    // `@unmanaged;`: the template makes the element; what JavaScript does to
    // its children and its other attributes, renders leave alone.
    if text_at(text, p, "@unmanaged") {
        let r = skip_spaces(text, p + 10);
        if r < text.len() and text.get(r) == 59 {
            wp_at[0] = r + 1;
            add_item(n, 1, intern_text("data-wutu-unmanaged"), intern_text("\"\""), 0, -1, -1, wp_at[0]);
            return;
        };
    };
    if c == 64 and event_head(text, p) {
        let q = p + 1;
        while (q < text.len() and is_name_code(text.get(q))) { q += 1; };
        let name = text.slice(p + 1, q);
        wutu_fail("events are written on " + name + " = handler; (or on " + name + " { … })", p);
    };
    if c == 46 and assignment_head(text, p + 1, false) {
        wp_at[0] += 1;
        parse_attribute(text, n, true);
        return;
    };
    if c >= 97 and c <= 122 and (assignment_head(text, p, true) or namespace_prefix(text, p) > 0 and assignment_head(text, namespace_prefix(text, p), true)) {
        parse_attribute(text, n, false);
        return;
    };
    if c == 64 { at_directive(text, p, true); };
    if c == 58 or c == 64 or c == 38 {
        parse_css_rule(text, n);
        return;
    };
    parse_declaration_or_child(text, n);
}

/// `@name` at p, where an element's body (`inside`) or the template's head
/// has one: a CSS at-rule inside passes; a directive in the wrong place, or
/// an unknown one, fails.
fn at_directive(text: Str, p: I32, inside: Bool) void {
    let q = p + 1;
    while (q < text.len() and is_name_code(text.get(q))) { q += 1; };
    let name = text.slice(p + 1, q);
    if name.len() == 0 { return; };
    let head = "@reactive @island @style @document";
    if inside and in_words("media supports container layer keyframes font-face starting-style scope page property counter-style font-feature-values font-palette-values position-try view-transition", name) { return; };
    if inside and text_at(name, 0, "-") { return; };
    if inside and name == "unmanaged" { wutu_fail("expected ; after @unmanaged", q); };
    if inside and in_words(head, "@" + name) { wutu_fail("@" + name + " goes first in the template, before its root element", p); };
    if not inside and name == "unmanaged" { wutu_fail("@unmanaged goes inside the element it is for: div { @unmanaged; }", p); };
    let known = if inside { "@unmanaged"; } else { head; };
    let near = closest_word(known, "@" + name);
    wutu_fail("unknown directive @" + name + (if near.len() > 0 { "; did you mean " + near + "?"; } else { "; " + (if inside { "an element takes @unmanaged, or a CSS at-rule"; } else { "a template begins with " + head; }); }), p);
}

/// A DOM event `name` is likely a typo of (one edit, two for a long name),
/// or "" for a known event or a custom one. One that adds to an event's
/// name (`changed`, `resized`, `clicks`) is custom.
fn near_event(name: Str) Str {
    let known = "click dblclick auxclick contextmenu mousedown mouseup mousemove mouseenter mouseleave mouseover mouseout wheel keydown keyup keypress "
        + "pointerdown pointerup pointermove pointerenter pointerleave pointerover pointerout pointercancel gotpointercapture lostpointercapture "
        + "focus blur focusin focusout input beforeinput change submit reset invalid select search toggle beforetoggle close cancel load error abort "
        + "scroll scrollend resize drag dragstart dragend dragenter dragleave dragover drop touchstart touchend touchmove touchcancel "
        + "animationstart animationend animationiteration animationcancel transitionstart transitionend transitionrun transitioncancel "
        + "copy cut paste play pause ended playing waiting seeking seeked timeupdate volumechange ratechange durationchange progress "
        + "loadstart loadeddata loadedmetadata canplay canplaythrough emptied stalled suspend formdata slotchange fullscreenchange "
        + "compositionstart compositionupdate compositionend selectionchange selectstart mount";
    if in_words(known, name) { return ""; };
    let near = closest_word(known, name);
    if near.len() == 0 or extends_word(known, name) { return ""; };
    let d = word_distance(intern_text(near), intern_text(name), 3);
    if d > 1 and name.len() <= 6 { return ""; };
    near;
}

/// Whether `w` is a word of `list` (space-separated) and more.
fn extends_word(list: Str, w: Str) Bool {
    let i = 0;
    while (i < list.len()) {
        let j = i;
        while (j < list.len() and list.get(j) != 32) { j += 1; };
        if j - i < w.len() and text_at(w, 0, list.slice(i, j)) { return true; };
        i = j + 1;
    };
    false;
}

/// The word of `list` (space-separated) within two edits of `w`, or "".
fn closest_word(list: Str, w: Str) Str {
    let best = "";
    let best_d = 3;
    let i = 0;
    while (i < list.len()) {
        let j = i;
        while (j < list.len() and list.get(j) != 32) { j += 1; };
        let word = list.slice(i, j);
        let d = word_distance(intern_text(word), intern_text(w), 3);
        if d < best_d { best = word; best_d = d; };
        i = j + 1;
    };
    best;
}

/// `@name =` at p.
fn event_head(text: Str, p: I32) Bool {
    let q = p + 1;
    let a = q;
    while (q < text.len() and is_name_code(text.get(q))) { q += 1; };
    if q == a { return false; };
    q = skip_spaces(text, q);
    q < text.len() and text.get(q) == 61;
}

/// A name at q, then `=` (not `==`), or `;` when `bare` (a boolean attribute).
fn assignment_head(text: Str, q: I32, bare: Bool) Bool {
    let a = q;
    let i = q;
    while (i < text.len() and is_name_code(text.get(i))) { i += 1; };
    if i == a { return false; };
    i = skip_spaces(text, i);
    if i >= text.len() { return false; };
    let c = text.get(i);
    // (`name }` is an attribute without its semicolon, and says so.)
    (c == 61 and not (i + 1 < text.len() and text.get(i + 1) == 61)) or (bare and (c == 59 or c == 125));
}

/// Past `xlink:`, `xml:` or `xmlns:` at q (a namespaced attribute's prefix,
/// never a CSS property's), or 0.
fn namespace_prefix(text: Str, q: I32) I32 {
    for (["xlink:", "xmlns:", "xml:"]) |prefix| {
        if text_at(text, q, prefix) { return q + prefix.len(); };
    };
    0;
}

/// `<name = value;`, the spelling before attributes lost their `<`: the new one.
fn old_attribute_text(text: Str, p: I32) Str {
    let q = p + 1;
    if q < text.len() and text.get(q) == 46 { q += 1; };
    let a = q;
    while (q < text.len() and is_name_code(text.get(q))) { q += 1; };
    let spelled = if q > a { text.slice(p + 1, q); } else { "name"; };
    "attributes are written without '<': " + spelled + " = value; (or " + spelled + "; for a boolean attribute)";
}

/// `"text" name…`: a string, then (no operator) another statement: a forgotten `;`.
fn literal_then_name(text: Str, q: I32) void {
    if q >= text.len() or text.get(q) != 34 { return; };
    let i = q + 1;
    while (i < text.len() and text.get(i) != 34 and text.get(i) != 10) { i += if text.get(i) == 92 { 2; } else { 1; }; };
    if i >= text.len() or text.get(i) != 34 { return; };
    let w = skip_spaces(text, i + 1);
    let e = w;
    while (e < text.len() and is_name_code(text.get(e))) { e += 1; };
    if e > w and not (text.get(w) >= 48 and text.get(w) <= 57) and not in_words("and or not orelse", text.slice(w, e)) {
        wutu_fail("expected ; after Wutu statement", i + 1);
    };
}

/// Whether a string literal at q is the whole value: `"…"` then `;`.
fn literal_value(text: Str, q: I32) Bool {
    if q >= text.len() or text.get(q) != 34 { return false; };
    let i = q + 1;
    while (i < text.len() and text.get(i) != 34 and text.get(i) != 10) { i += if text.get(i) == 92 { 2; } else { 1; }; };
    if i >= text.len() or text.get(i) != 34 { return false; };
    let after = skip_spaces(text, i + 1);
    after < text.len() and text.get(after) == 59;
}

/// Whether `name` is "on" and an event's name, in any case: an event
/// handler's attribute. (A browser runs no other `on…` one, so `one`, `only`
/// and a custom element's `onfoo` are attributes.)
fn is_on_name(name: Str) Bool {
    if name.len() < 3 or (name.get(0) | 32) != 111 or (name.get(1) | 32) != 110 { return false; };
    let rest = "";
    for (2 ..< name.len()) |i| { let c = name.get(i); rest = rest + Str.from_code_point(if c >= 65 and c <= 90 { c + 32; } else { c; }); };
    is_event_name(rest);
}

/// The DOM events with a handler attribute (`on` + the name), in any browser.
fn is_event_name(w: Str) Bool {
    in_words("abort activate afterprint afterscriptexecute animationcancel animationend animationiteration animationstart appinstalled auxclick beforeactivate beforecopy beforecut beforedeactivate beforeinput beforeinstallprompt beforematch beforepaste beforeprint beforescriptexecute beforetoggle beforeunload beforexrselect begin blur cancel canplay canplaythrough change click close command contentvisibilityautostatechange contextlost contextmenu contextrestored copy cuechange cut dblclick deactivate devicemotion deviceorientation deviceorientationabsolute drag dragend dragenter dragexit dragleave dragover dragstart drop durationchange emptied encrypted end ended enterpictureinpicture error focus focusin focusout formdata freeze fullscreenchange fullscreenerror gamepadconnected gamepaddisconnected gesturechange gestureend gesturestart gotpointercapture hashchange help input interest invalid keydown keypress keyup languagechange leavepictureinpicture load loadeddata loadedmetadata loadstart loseinterest lostpointercapture message messageerror mousedown mouseenter mouseleave mousemove mouseout mouseover mouseup mousewheel mozfullscreenchange mozfullscreenerror mozpointerlockchange mozpointerlockerror offline online orientationchange overscroll pagehide pagereveal pageshow pageswap paste pause play playing pointercancel pointerdown pointerenter pointerleave pointerlockchange pointerlockerror pointermove pointerout pointerover pointerrawupdate pointerup popstate prerenderingchange progress ratechange readystatechange rejectionhandled repeat reset resize resume scroll scrollend scrollsnapchange scrollsnapchanging search securitypolicyviolation seeked seeking select selectionchange selectstart show slotchange stalled storage submit suspend timeupdate toggle touchcancel touchend touchmove touchstart transitioncancel transitionend transitionrun transitionstart unhandledrejection unload visibilitychange volumechange waiting waitingforkey webkitanimationend webkitanimationiteration webkitanimationstart webkitbeginfullscreen webkitcurrentplaybacktargetiswirelesschanged webkitendfullscreen webkitfullscreenchange webkitfullscreenerror webkitkeyadded webkitkeyerror webkitkeymessage webkitmouseforcechanged webkitmouseforcedown webkitmouseforceup webkitmouseforcewillbegin webkitneedkey webkitplaybacktargetavailabilitychanged webkitpresentationmodechanged webkittransitionend wheel zoom", w);
}

/// `name = value;` or `name;` (an attribute), `.name = value;` (a property);
/// the cursor is on the name. A value that is one string literal is written
/// into the element; anything else is an expression.
fn parse_attribute(text: Str, n: I32, is_property: Bool) void {
    let name_start = wp_at[0];
    let q = if is_property or namespace_prefix(text, name_start) == 0 { name_start; } else { namespace_prefix(text, name_start); };
    while (q < text.len() and is_name_code(text.get(q))) { q += 1; };
    let name = text.slice(name_start, q);
    wp_at[0] = q;
    wp_trivia(text);
    let value = "\"\"";
    let dynamic = false;
    let from = -1;
    let to = -1;
    if wp_char(text) == 61 {
        wp_at[0] += 1;
        wp_trivia(text);
        if wp_at_text(text, "$[") { wp_fail_interpolation(text); };
        if literal_value(text, wp_at[0]) {
            value = wp_quoted(text);
        } else {
            literal_then_name(text, wp_at[0]);
            value = wp_bare_expression(text);
            dynamic = true;
            from = wx_from[0];
            to = wx_to[0];
        };
    } else if is_property {
        wutu_fail("a property takes a value: .name = value;", wp_at[0]);
    };
    wp_semicolon(text);
    let tag = word_text(tn_text[n]);
    if is_on_name(name) { wutu_fail("events are written on " + name.slice(2, name.len()) + " { … }, not as an attribute", name_start); };
    if dynamic and tag == "script" { wutu_fail("a script's attributes are code or load it, so Wutu sets them only as written: src = \"…\";", name_start); };
    if dynamic and tag == "base" and name == "href" { wutu_fail("a base's href moves every relative URL (scripts' too), so Wutu sets it only as written: href = \"/\";", name_start); };
    if dynamic and is_property and name == "protocol" { wutu_fail(".protocol from a value could make a URL javascript:, past the URL check; set the whole URL: .href = url;", name_start); };
    if dynamic and is_property and is_raw_text_tag(tag) and in_words("textContent innerText", name) { wutu_fail(raw_text_error(tag), name_start); };
    if dynamic and name == "srcdoc" { wutu_fail("srcdoc is HTML, so Wutu sets it only as written: srcdoc = \"…\"; (trusted HTML from a value: an `as` element's .srcdoc, in code)", name_start); };
    if not is_property and not is_allowed_attribute(tag, name) { wutu_fail("unknown attribute " + name + " on " + tag, name_start); };
    add_item(n, 1, intern_text(name), intern_text(value), (if is_property { 1; } else { 0; }) + (if dynamic { 2; } else { 0; }), from, to, name_start);
}

/// Pseudo-classes, at-rules, `& selector` and `@ selector` scoped rules.
fn parse_css_rule(text: Str, n: I32) void {
    let selector = wp_css_until(text, "{;");
    if wp_char(text) == 59 {
        wp_at[0] += 1;
        let i = add_item(n, 4, -1, intern_text(selector + ";"), 0, -1, -1, wp_at[0]);
        ti_c[i] = intern_text(selector + ";");
        return;
    };
    let block = wp_css_block(text);
    let i = add_item(n, 4, -1, intern_text(selector + "{" + block + "}"), 0, -1, -1, wp_at[0]);
    ti_c[i] = intern_text(scoped_selector(selector) + "{" + block + "}");
}

/// A scoped CSS rule's selector, relative to the element (`&`): `@` alone is
/// the element and all inside it, `@ sel` is `sel`, a pseudo-class is on `&`.
fn scoped_selector(selector: Str) Str {
    if selector == "@" { return "&, & *"; };
    if text_at(selector, 0, "@ ") {
        let rest = selector.slice(2, selector.len());
        return if rest.len() > 0 { rest; } else { "&, & *"; };
    };
    if text_at(selector, 0, ":") { return "&" + selector; };
    selector;
}

/// `property: value;` in an element's body, or else a child element.
fn parse_declaration_or_child(text: Str, n: I32) void {
    let start = wp_at[0];
    let head = wp_css_until(text, ":{};");
    if wp_char(text) != 58 {
        wp_at[0] = start;
        add_child(n, parse_telement(text));
        return;
    };
    wp_at[0] += 1;
    wp_trivia(text);
    if wp_at_text(text, "$[") { wp_fail_interpolation(text); };
    if wp_char(text) == 61 {
        // `width: = expression;`: applied with style.setProperty at render.
        wp_at[0] += 1;
        let source = wp_bare_expression(text);
        let from = wx_from[0];
        let to = wx_to[0];
        wp_semicolon(text);
        if not is_css_property(head) { wutu_fail("invalid CSS property", start); };
        css_property_known(trim_text(head), start);
        add_item(n, 5, intern_text(trim_text(head)), intern_text(source), 0, from, to, start);
        return;
    };
    let value_from = wp_at[0];
    let value = wp_css_until(text, ";{}");
    css_value_runs_on(text, value_from, wp_at[0]);
    if wp_char(text) != 59 { wutu_fail("CSS declarations require a semicolon", wp_at[0]); };
    wp_at[0] += 1;
    if not is_css_property(head) { wutu_fail("invalid CSS property", start); };
    css_property_known(trim_text(head), start);
    let declaration = head + ":" + value + ";";
    let i = add_item(n, 4, -1, intern_text(declaration), 0, -1, -1, start);
    ti_c[i] = intern_text(declaration);
}
