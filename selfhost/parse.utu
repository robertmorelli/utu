//! = The parser
//!
//! Recursive descent over the tokens (comments skipped), building a tree of
//! named nodes in mems: each node's kind, its first token and the token after
//! its last, its first child, and its next sibling. Punctuation and keywords
//! are not nodes; a node's span covers them. While parsing, spans are
//! positions in @ptok (the tokens without comments); once the tree is
//! built, they become the lexer's tokens (and, when @comment_nodes asks,
//! each comment becomes a node).
//!
//! A node is made from the nodes made since it began: those wait on the
//! @pending stack, and finishing a node links them as its children and puts
//! it in their place. Trying a parse and giving it up (@save, @restore)
//! truncates the node mems and the stack.
//!
//! The grammar is stage 0's (`src/compiler/syntax/parser.js`), function by
//! function, which in turn is tree-sitter-utu's: the nodes are the named nodes
//! of its syntax tree, with the same spans, for every program it accepts
//! (`scripts/selfhost-parser-differential.mjs`). A program it does not accept
//! fails: a failed rule throws (@fail), and @parse reports the furthest token
//! any attempt reached, with what the attempts there wanted. (Stage 0 hands
//! those programs to tree-sitter, whose error recovery reports them.)

/// The kinds of node: tree-sitter-utu's named nodes, capitalized.
enum(U8) Node:
    | Source_file
    | Comment
    | Identifier
    | Type_ident
    | Int_lit
    | Float_lit
    | String_lit
    | Multiline_string_line
    | Multiline_string_lit
    | Dsl_body
    | Platform_path
    | Void_type
    | Bool_lit
    | Module_decl
    | Module_name
    | Module_type_param_list
    | Module_type_param
    | Module_type_arg_list
    | Impl_list
    | Promoted_type
    | Nom_qualifier
    | Nom_tag
    | Struct_decl
    | Field
    | Enum_decl
    | Variant
    | Field_list
    | Proto_decl
    | Proto_member
    | Proto_getter
    | Proto_setter
    | Proto_get_setter
    | Proto_method
    | Op_decl
    | Fn_decl
    | Fn_name
    | Self_param
    | Param_list
    | Param
    | Return_type
    | Yield_type
    | Type_list
    | Global_decl
    | Mem_decl
    | Distinct_decl
    | Type_decl
    | Using_decl
    | Captured_module_name
    | Export_lib_decl
    | Export_main_decl
    | Test_decl
    | Bench_decl
    | Measure_decl
    | Nullable_type
    | Paren_type
    | Tuple_type
    | Func_type
    | Closure_type
    | Ref_type
    | Instantiated_module_ref
    | Qualified_type_ref
    | Module_ref
    | Block
    | Capture
    | Call_expr
    | Arg_list
    | Field_expr
    | Optional_field_expr
    | Slice_expr
    | Index_expr
    | Assign_expr
    | Binary_expr
    | Iterator_expr
    | Else_expr
    | Pipe_expr
    | Pipe_target
    | Pipe_args
    | Pipe_args_with_placeholder
    | Pipe_args_no_placeholder
    | Pipe_arg
    | Pipe_arg_placeholder
    | Unary_op
    | Unary_expr
    | Block_expr
    | Implicit_struct_init
    | Literal
    | Await_expr
    | Assert_expr
    | New_expr
    | Return_expr
    | Continue_expr
    | Yield_expr
    | Defer_expr
    | Break_expr
    | Fatal_expr
    | Prune_expr
    | Struct_init
    | Inline_module_type_path
    | Type_member_expr
    | Null_expr
    | Promoted_module_call_expr
    | Field_init
    | Range_expr
    | Paren_expr
    | Array_expr
    | Tuple_expr
    | Dsl_expr
    | Bind_expr
    | Tuple_pattern
    | Closure_expr
    | Closure_param_list
    | Closure_param
    | If_expr
    | Match_expr
    | Loop_match_expr
    | Match_arm
    | Match_default
    | Match_lit
    | Alt_expr
    | Alt_arm
    | Alt_default
    | Promote_expr
    | Try_expr
    | For_expr
    | For_sources
    | For_source
    | While_expr
    | Splice           // utu written in a DSL body, in its expansion (dsl.utu)
    | Template_string
    | Template_full
    | Template_head
    | Template_middle
    | Template_tail

/// Every keyword of the grammar, as interned word ids: each is its variant's
/// name with the first letter lowercased (`Flat_map` is `flat_map`). Where a
/// keyword may stand, the parser compares ids.
enum(U8) Kw:
    | Mod
    | Using
    | Tag
    | Rec
    | Struct
    | Proto
    | Enum
    | Fn
    | Let
    | Mem
    | Vec
    | Export
    | Const
    | Type
    | Distinct
    | Lib
    | Main
    | Test
    | Bench
    | Measure
    | In
    | Out
    | Get
    | Set
    | Yield
    | Void
    | Fun
    | Cl
    | From
    | Map
    | Filter
    | Flat_map
    | Skip_while
    | Take_while
    | Each
    | Any
    | All
    | Count_where
    | First_index
    | Last_index
    | Bisect
    | Fold
    | Scan
    | Zip
    | Skip
    | Take
    | Chain
    | Repeat
    | Sort
    | Min_by
    | Max_by
    | First_where
    | Reduce
    | Partition
    | Collect
    | Group_by
    | Distinct_by
    | Batched
    | Windows
    | Sum
    | Fast_sum
    | Product
    | Count
    | Await
    | New
    | Assert
    | Not
    | And
    | Or
    | Xor
    | Orelse
    | If
    | Else
    | Promote
    | Try
    | Catch
    | Match
    | Loop
    | Alt
    | For
    | While
    | Break
    | Continue
    | Defer
    | Return
    | Fatal
    | Prune
    | True
    | False
    | Null

/// The tokens the parser reads (positions of the lexer's tokens, without
/// comments).
export mem ptok: I32;
/// By lexer token: its interned word id, or -1 when it is not a word.
export mem tok_word: I32;

/// The tree, by node id: its kind (a @Node). The `node_*` mems are its rows:
/// its first token and the token after its last, its first child, and its next
/// sibling (-1 for none).
export mem node_kind: U8;
export mem node_first: I32;
export mem node_last: I32;
export mem node_child: I32;
export mem node_next: I32;
/// Nodes made but not yet any node's children: the next node finished takes
/// those above its mark.
vec pending: I32;

/// Throws, abandoning the rule that failed: an attempt that catches it
/// restores its @Save.
let syntax_error: fun() void = @es/\ () => { throw new SyntaxError('utu syntax'); } \/;

// Give up: the program is not one this parser accepts. The furthest token
// any attempt failed at is where the error is reported, with what the
// attempts that got that far wanted there.
/// The furthest position any attempt failed at.
vec parse_furthest: I32 = [0];
/// At the furthest token: Tok kinds, and keywords as kw_wanted + their word.
vec parse_expected: I32;
/// The token a failed parse reports.
vec parse_error_at: I32 = [0];
/// And the word of what it wanted there ("';' or '}'"), or -1.
vec parse_error_wanted: I32 = [-1];

/// In @parse_expected, a keyword is this plus its word id; a token kind is itself.
let kw_wanted: I32 = 1000;

fn fail(p: Parser) void { fail_wanting(p, -1); }

/// Fails at the cursor, noting what was wanted there (a token kind, or
/// @kw_wanted plus a keyword's word; -1 for nothing in particular).
fn fail_wanting(p: Parser, wanted: I32) void {
    if p.pos > parse_furthest[0] {
        parse_furthest[0] = p.pos;
        parse_expected.clear();
    };
    if p.pos == parse_furthest[0] and wanted >= 0 {
        let seen = false;
        for (0 ..< parse_expected.len()) |i| { if parse_expected[i] == wanted { seen = true; }; };
        if not seen { parse_expected.push(wanted); };
    };
    syntax_error();
}

/// What the furthest attempts wanted, in words: `"';'"`, `"';' or '}'"`, `"'(', ',' or ')'"`.
fn wanted_text() Str {
    let n = parse_expected.len();
    if n == 0 { return ""; };
    let text = "";
    for (0 ..< n) |i| {
        if i > 0 { text = text + (if i == n - 1 { " or "; } else { ", "; }); };
        let w = parse_expected[i];
        text = text + "'" + (if w >= kw_wanted { word_text(w - kw_wanted); } else { tok_spelling(w); }) + "'";
    };
    text;
}

/// How a kind of token is written (or named, for the kinds with no one spelling).
fn tok_spelling(kind: I32) Str {
    match Tok.from_i32(kind) {
        Tok.End => "end of file",
        Tok.Error => "a character",
        Tok.Word => "a name",
        Tok.Int => "an integer",
        Tok.Float => "a number",
        Tok.String => "a string",
        Tok.MultilineLine => "\\\\",
        Tok.DslBody => "/\\",
        Tok.Comment => "//",
        Tok.TemplateFull => "a template string",
        Tok.TemplateHead => "a template string",
        Tok.TemplateMiddle => "a template string",
        Tok.TemplateTail => "a template string",
        Tok.LParen => "(",
        Tok.RParen => ")",
        Tok.LBrace => "{",
        Tok.RBrace => "}",
        Tok.LBracket => "[",
        Tok.RBracket => "]",
        Tok.Comma => ",",
        Tok.Semi => ";",
        Tok.Colon => ":",
        Tok.At => "@",
        Tok.Dot => ".",
        Tok.DotDotDot => "...",
        Tok.DotDotLt => "..<",
        Tok.Pipe => "|",
        Tok.PipeEq => "|=",
        Tok.Amp => "&",
        Tok.AmpEq => "&=",
        Tok.Caret => "^",
        Tok.CaretEq => "^=",
        Tok.Star => "*",
        Tok.StarEq => "*=",
        Tok.Slash => "/",
        Tok.SlashEq => "/=",
        Tok.Percent => "%",
        Tok.PercentEq => "%=",
        Tok.Plus => "+",
        Tok.PlusEq => "+=",
        Tok.Minus => "-",
        Tok.MinusEq => "-=",
        Tok.MinusO => "-o",
        Tok.Lt => "<",
        Tok.LtEq => "<=",
        Tok.Shl => "<<",
        Tok.ShlEq => "<<=",
        Tok.Gt => ">",
        Tok.GtEq => ">=",
        Tok.Shr => ">>",
        Tok.ShrEq => ">>=",
        Tok.Shr3 => ">>>",
        Tok.Shr3Eq => ">>>=",
        Tok.Eq => "=",
        Tok.EqEq => "==",
        Tok.FatArrow => "=>",
        Tok.BangEq => "!=",
        Tok.Question => "?",
        Tok.QuestionDot => "?.",
        Tok.Tilde => "~",
        Tok.TildeArrow => "~>",
    };
}

/// The cursor: a position in @ptok.
struct Parser:
    | pos: I32

/// Where an attempt began: the cursor and the sizes of the node mems and
/// @pending, which @restore cuts back to.
struct Save:
    | pos: I32
    | nodes: I32
    | pending: I32
    | depth: I32

//! = Tokens

fn kind_at(p: Parser, offset: I32) I32 { tok_kind[ptok[p.pos + offset]]; }

fn is(p: Parser, kind: Tok) Bool { tok_kind[ptok[p.pos]] == kind.to_i32(); }

fn is_at(p: Parser, offset: I32, kind: Tok) Bool { tok_kind[ptok[p.pos + offset]] == kind.to_i32(); }

fn word_id(p: Parser) I32 { tok_word[ptok[p.pos]]; }

fn is_kw(p: Parser, kw: Kw) Bool { tok_word[ptok[p.pos]] == kw.to_i32(); }

fn is_word(p: Parser) Bool { is(p, Tok.Word); }

fn is_keyword_id(id: I32) Bool { id >= 0 and id < Kw.count(); }

fn at_end(p: Parser) Bool { is(p, Tok.End); }

/// Whether the tokens at positions `a` and `b` touch, with nothing between them.
fn adjacent(a: I32, b: I32) Bool { tok_end[ptok[a]] == tok_start[ptok[b]]; }

/// Identifier-shaped: a lowercase first letter, or `_` and more.
fn shaped_at(p: Parser, offset: I32) Bool {
    let t = ptok[p.pos + offset];
    if tok_kind[t] != Tok.Word.to_i32() { return false; };
    let c = src[tok_start[t]];
    (c >= 97 and c <= 122) or (c == 95 and tok_end[t] - tok_start[t] > 1);
}

fn shaped(p: Parser) Bool { shaped_at(p, 0); }

fn advance(p: Parser) void { p.pos += 1; }

fn expect(p: Parser, kind: Tok) void {
    if not is(p, kind) { fail_wanting(p, kind.to_i32()); };
    p.pos += 1;
}

fn expect_kw(p: Parser, kw: Kw) void {
    if not is_kw(p, kw) { fail_wanting(p, kw_wanted + kw.to_i32()); };
    p.pos += 1;
}

//! = Nodes

/// Where the node about to begin starts on @pending.
fn mark() I32 { pending.len(); }

/// A node of the nodes made since `at` (on the @pending stack), spanning tokens `first ..< last`.
fn finish(kind: Node, at: I32, first: I32, last: I32) I32 {
    let id = node_kind.len();
    let n = pending.len();
    node_kind.push(kind.to_i32());
    node_first.push(first);
    node_last.push(last);
    if at < n {
        node_child.push(pending[at]);
        for (at ..< n - 1) |k| { node_next[pending[k]] = pending[k + 1]; };
        node_next[pending[n - 1]] = -1;
    } else {
        node_child.push(-1);
    };
    node_next.push(-1);
    pending.resize(at);
    pending.push(id);
    id;
}

/// A node from `at` up to the cursor.
fn node(p: Parser, kind: Node, at: I32, first: I32) I32 { finish(kind, at, first, p.pos); }

/// A node of the token at the cursor.
fn leaf(p: Parser, kind: Node) I32 {
    let at = mark();
    p.pos += 1;
    finish(kind, at, p.pos - 1, p.pos);
}

/// The mark below `left`, the node on top of the stack, so a node can begin with it.
fn mark_below(left: I32) I32 {
    if pending[pending.len() - 1] != left { fatal; };
    pending.len() - 1;
}

/// Before an attempt that may be given up (@restore).
fn save(p: Parser) Save { Save { pos: p.pos, nodes: node_kind.len(), pending: pending.len(), depth: parse_depth[0] }; }

/// Gives up an attempt: the cursor goes back, and the nodes made since are gone.
fn restore(p: Parser, s: Save) void {
    p.pos = s.pos;
    parse_depth[0] = s.depth;
    node_kind.resize(s.nodes);
    node_first.resize(s.nodes);
    node_last.resize(s.nodes);
    node_child.resize(s.nodes);
    node_next.resize(s.nodes);
    pending.resize(s.pending);
}

//! = Words

fn identifier(p: Parser) I32 {
    if not shaped(p) { fail(p); };
    leaf(p, Node.Identifier);
}

fn type_ident(p: Parser) I32 {
    if not is_word(p) { fail(p); };
    leaf(p, Node.Type_ident);
}

/// A type name where no keyword can stand.
fn unreserved_type_ident(p: Parser) I32 {
    if is_keyword_id(word_id(p)) { fail(p); };
    type_ident(p);
}

/// `identifier` where the word is identifier-shaped, else `type_ident` (both fit here).
fn identifier_or_type(p: Parser) I32 {
    if not is_word(p) { fail(p); };
    leaf(p, if shaped(p) { Node.Identifier; } else { Node.Type_ident; });
}

fn string_lit(p: Parser) I32 {
    if not is(p, Tok.String) { fail(p); };
    leaf(p, Node.String_lit);
}

fn number(p: Parser) I32 {
    if is(p, Tok.Int) { return leaf(p, Node.Int_lit); };
    if is(p, Tok.Float) { return leaf(p, Node.Float_lit); };
    fail(p);
    -1;
}

fn int_lit(p: Parser) I32 {
    if not is(p, Tok.Int) { fail(p); };
    leaf(p, Node.Int_lit);
}

//! = Source file and items

fn source_file(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    while (not at_end(p)) { item(p); };
    node(p, Node.Source_file, at, first);
}

/// A top-level declaration, by its first word (`export`'s by its second).
fn item(p: Parser) void {
    let w = word_id(p);
    if w == Kw.Mod.to_i32() { module_decl(p); return; };
    if w == Kw.Using.to_i32() { using_decl(p); expect(p, Tok.Semi); return; };
    if w == Kw.Tag.to_i32() or w == Kw.Rec.to_i32() or w == Kw.Struct.to_i32() or w == Kw.Enum.to_i32() { struct_or_enum(p); return; };
    if w == Kw.Proto.to_i32() { proto_decl(p); return; };
    if w == Kw.Fn.to_i32() { fn_or_op_decl(p); return; };
    if w == Kw.Let.to_i32() { global_decl(p); expect(p, Tok.Semi); return; };
    if w == Kw.Mem.to_i32() or w == Kw.Vec.to_i32() or w == Kw.Const.to_i32() { mem_decl(p); expect(p, Tok.Semi); return; };
    if w == Kw.Type.to_i32() { distinct_decl(p); expect(p, Tok.Semi); return; };
    if w == Kw.Export.to_i32() {
        let after = tok_word[ptok[p.pos + 1]];
        if after == Kw.Lib.to_i32() { export_lib_decl(p); return; };
        if after == Kw.Main.to_i32() { export_main_decl(p); return; };
        if after == Kw.Const.to_i32() or after == Kw.Mem.to_i32() { mem_decl(p); expect(p, Tok.Semi); return; };
        fail(p);
        return;
    };
    if w == Kw.Test.to_i32() { test_decl(p); return; };
    if w == Kw.Bench.to_i32() { bench_decl(p); return; };
    fail(p);
}

/// A declaration inside a `mod`.
fn module_item(p: Parser) void {
    let w = word_id(p);
    if w == Kw.Type.to_i32() { type_decl(p); return; };
    if w == Kw.Tag.to_i32() or w == Kw.Rec.to_i32() or w == Kw.Struct.to_i32() or w == Kw.Enum.to_i32() { struct_or_enum(p); return; };
    if w == Kw.Proto.to_i32() { proto_decl(p); return; };
    if w == Kw.Fn.to_i32() { fn_or_op_decl(p); return; };
    if w == Kw.Let.to_i32() { global_decl(p); expect(p, Tok.Semi); return; };
    if w == Kw.Test.to_i32() { test_decl(p); return; };
    if w == Kw.Bench.to_i32() { bench_decl(p); return; };
    fail(p);
}

fn module_decl(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    expect_kw(p, Kw.Mod);
    module_name(p);
    if is(p, Tok.LBracket) { module_type_param_list(p); };
    expect(p, Tok.LBrace);
    while (not is(p, Tok.RBrace)) { module_item(p); };
    expect(p, Tok.RBrace);
    node(p, Node.Module_decl, at, first);
}

fn module_name(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    identifier_or_type(p);
    node(p, Node.Module_name, at, first);
}

fn module_type_param_list(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    expect(p, Tok.LBracket);
    module_type_param(p);
    while (is(p, Tok.Comma)) {
        advance(p);
        if is(p, Tok.RBracket) { break; };
        module_type_param(p);
    };
    expect(p, Tok.RBracket);
    node(p, Node.Module_type_param_list, at, first);
}

fn module_type_param(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    // `in` and `out` are always variance keywords here, never parameter names.
    if is_kw(p, Kw.In) or is_kw(p, Kw.Out) { advance(p); };
    unreserved_type_ident(p);
    // `T[Ord]`: the protocols T must implement.
    if is(p, Tok.LBracket) { impl_list(p); };
    node(p, Node.Module_type_param, at, first);
}

fn module_type_arg_list(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    expect(p, Tok.LBracket);
    type_(p);
    while (is(p, Tok.Comma)) {
        advance(p);
        if is(p, Tok.RBracket) { break; };
        type_(p);
    };
    expect(p, Tok.RBracket);
    node(p, Node.Module_type_arg_list, at, first);
}

fn impl_list(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    expect(p, Tok.LBracket);
    if not is(p, Tok.RBracket) {
        type_ident_or_promoted(p);
        while (is(p, Tok.Comma)) {
            advance(p);
            if is(p, Tok.RBracket) { break; };
            type_ident_or_promoted(p);
        };
    };
    expect(p, Tok.RBracket);
    node(p, Node.Impl_list, at, first);
}

fn type_ident_or_promoted(p: Parser) I32 {
    if is(p, Tok.Amp) { promoted_type(p); } else { type_ident(p); };
}

fn promoted_type(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    expect(p, Tok.Amp);
    node(p, Node.Promoted_type, at, first);
}

fn struct_or_enum(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    if is_kw(p, Kw.Tag) or is_kw(p, Kw.Rec) {
        let tags = mark();
        while (is_kw(p, Kw.Tag) or is_kw(p, Kw.Rec)) {
            let tag = mark();
            advance(p);
            node(p, Node.Nom_tag, tag, p.pos - 1);
        };
        node(p, Node.Nom_qualifier, tags, first);
    };
    if is_kw(p, Kw.Struct) { return struct_decl(p, at, first); };
    if is_kw(p, Kw.Enum) { return enum_decl(p, at, first); };
    fail(p);
    -1;
}

fn struct_decl(p: Parser, at: I32, first: I32) I32 {
    advance(p);
    type_ident_or_promoted(p);
    if is(p, Tok.LBracket) { impl_list(p); };
    expect(p, Tok.Colon);
    while (is(p, Tok.Pipe)) {
        advance(p);
        field(p);
    };
    node(p, Node.Struct_decl, at, first);
}

fn field(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    identifier(p);
    expect(p, Tok.Colon);
    type_(p);
    node(p, Node.Field, at, first);
}

fn enum_decl(p: Parser, at: I32, first: I32) I32 {
    advance(p);
    if is(p, Tok.LParen) {
        advance(p);
        type_ident(p);
        expect(p, Tok.RParen);
    };
    type_ident_or_promoted(p);
    if is(p, Tok.LBracket) { impl_list(p); };
    expect(p, Tok.Colon);
    while (is(p, Tok.Pipe)) {
        advance(p);
        variant(p);
    };
    node(p, Node.Enum_decl, at, first);
}

fn variant(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    type_ident(p);
    if is(p, Tok.LBrace) {
        advance(p);
        if not is(p, Tok.RBrace) { field_list(p); };
        expect(p, Tok.RBrace);
    } else if is(p, Tok.Eq) {
        advance(p);
        if is(p, Tok.Minus) { advance(p); };
        int_lit(p);
    };
    node(p, Node.Variant, at, first);
}

fn field_list(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    field(p);
    while (is(p, Tok.Comma)) {
        advance(p);
        if is(p, Tok.RBrace) { break; };
        field(p);
    };
    node(p, Node.Field_list, at, first);
}

fn proto_decl(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    advance(p);
    type_ident_or_promoted(p);
    expect(p, Tok.Colon);
    while (is(p, Tok.Pipe)) {
        advance(p);
        proto_member(p);
    };
    node(p, Node.Proto_decl, at, first);
}

fn proto_member(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    let member = mark();
    if is_kw(p, Kw.Get) {
        advance(p);
        let both_ = is_kw(p, Kw.Set);
        if both_ { advance(p); };
        identifier(p);
        expect(p, Tok.Colon);
        type_(p);
        node(p, if both_ { Node.Proto_get_setter; } else { Node.Proto_getter; }, member, first);
    } else if is_kw(p, Kw.Set) {
        advance(p);
        identifier(p);
        expect(p, Tok.Colon);
        type_(p);
        node(p, Node.Proto_setter, member, first);
    } else {
        identifier(p);
        expect(p, Tok.LParen);
        if not is(p, Tok.RParen) { type_list(p); };
        expect(p, Tok.RParen);
        return_type(p);
        node(p, Node.Proto_method, member, first);
    };
    node(p, Node.Proto_member, at, first);
}

fn fn_or_op_decl(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    advance(p);
    // `fn T:op |a, b| R { … }` is an operator; `fn T.name(…)` and `fn name(…)` are functions.
    if not shaped(p) or is(p, Tok.Amp) {
        let s = save(p);
        type_ident_or_promoted(p);
        if is(p, Tok.Colon) {
            advance(p);
            identifier(p);
            capture(p);
            return_type(p);
            block(p);
            return node(p, Node.Op_decl, at, first);
        };
        restore(p, s);
    };
    fn_name(p);
    if is(p, Tok.Pipe) { self_param(p); };
    expect(p, Tok.LParen);
    if not is(p, Tok.RParen) { param_list(p); };
    expect(p, Tok.RParen);
    return_type(p);
    block(p);
    node(p, Node.Fn_decl, at, first);
}

fn fn_name(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    if shaped(p) {
        identifier(p);
    } else {
        type_ident_or_promoted(p);
        if is(p, Tok.LBracket) { module_type_arg_list(p); };
        expect(p, Tok.Dot);
        identifier(p);
    };
    node(p, Node.Fn_name, at, first);
}

fn self_param(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    expect(p, Tok.Pipe);
    identifier(p);
    expect(p, Tok.Pipe);
    node(p, Node.Self_param, at, first);
}

fn param_list(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    param(p);
    while (is(p, Tok.Comma)) {
        advance(p);
        if is(p, Tok.RParen) { break; };
        param(p);
    };
    node(p, Node.Param_list, at, first);
}

fn param(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    identifier(p);
    expect(p, Tok.Colon);
    type_(p);
    node(p, Node.Param, at, first);
}

fn return_type(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    if is_kw(p, Kw.Void) {
        leaf(p, Node.Void_type);
    } else if is_kw(p, Kw.Yield) {
        let inner = mark();
        advance(p);
        type_(p);
        node(p, Node.Yield_type, inner, first);
    } else {
        type_(p);
    };
    node(p, Node.Return_type, at, first);
}

fn type_list(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    type_(p);
    while (is(p, Tok.Comma)) {
        advance(p);
        type_(p);
    };
    node(p, Node.Type_list, at, first);
}

fn global_decl(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    advance(p);
    identifier(p);
    expect(p, Tok.Colon);
    type_(p);
    expect(p, Tok.Eq);
    expression(p);
    node(p, Node.Global_decl, at, first);
}

fn mem_decl(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    let exported = is_kw(p, Kw.Export);
    if exported { advance(p); };
    if is_kw(p, Kw.Const) { advance(p); };
    // A vec is never exported: the host cannot see it.
    if not exported and is_kw(p, Kw.Vec) { advance(p); } else { expect_kw(p, Kw.Mem); };
    identifier(p);
    expect(p, Tok.Colon);
    type_ident(p);
    if is(p, Tok.Eq) {
        advance(p);
        expression(p);
    };
    node(p, Node.Mem_decl, at, first);
}

fn distinct_decl(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    advance(p);
    type_ident(p);
    expect(p, Tok.Eq);
    expect_kw(p, Kw.Distinct);
    type_ident(p);
    node(p, Node.Distinct_decl, at, first);
}

fn type_decl(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    advance(p);
    type_ident_or_promoted(p);
    expect(p, Tok.Eq);
    dsl_expr(p);
    node(p, Node.Type_decl, at, first);
}

/// Whether the token at position i spells `text`.
fn token_is(i: I32, text: Str) Bool {
    let t = ptok[i];
    let n = tok_end[t] - tok_start[t];
    if n != text.len() { return false; };
    for (0 ..< n) |k| { if src[tok_start[t] + k] != text.get(k) { return false; }; };
    true;
}

fn using_decl(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    advance(p);
    module_name(p);
    if is(p, Tok.LBracket) { module_type_arg_list(p); };
    if is(p, Tok.Pipe) {
        let captured = mark();
        let start = p.pos;
        advance(p);
        module_name(p);
        expect(p, Tok.Pipe);
        node(p, Node.Captured_module_name, captured, start);
    };
    // `lazy`: the module builds as its own chunk (a word here, not a keyword).
    if is(p, Tok.Word) and token_is(p.pos, "lazy") { advance(p); };
    if is_kw(p, Kw.From) {
        advance(p);
        if is(p, Tok.String) {
            string_lit(p);
        } else {
            // `std:Str`: a lowercase word, `:`, and a word starting with a letter, touching.
            if not (shaped(p) and src[tok_start[ptok[p.pos]]] != 95 and is_at(p, 1, Tok.Colon) and is_at(p, 2, Tok.Word)
                    and src[tok_start[ptok[p.pos + 2]]] != 95 and adjacent(p.pos, p.pos + 1) and adjacent(p.pos + 1, p.pos + 2)) {
                fail(p);
            };
            let path = mark();
            p.pos += 3;
            finish(Node.Platform_path, path, p.pos - 3, p.pos);
        };
    };
    node(p, Node.Using_decl, at, first);
}

fn export_lib_decl(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    advance(p);
    expect_kw(p, Kw.Lib);
    expect(p, Tok.LBrace);
    while (is_kw(p, Kw.Fn)) { fn_or_op_decl(p); };
    expect(p, Tok.RBrace);
    node(p, Node.Export_lib_decl, at, first);
}

fn export_main_decl(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    advance(p);
    expect_kw(p, Kw.Main);
    expect(p, Tok.LParen);
    if not is(p, Tok.RParen) { param_list(p); };
    expect(p, Tok.RParen);
    return_type(p);
    block(p);
    node(p, Node.Export_main_decl, at, first);
}

fn test_decl(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    advance(p);
    string_lit(p);
    block(p);
    node(p, Node.Test_decl, at, first);
}

fn bench_decl(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    advance(p);
    string_lit(p);
    expect(p, Tok.LBrace);
    while (not is_kw(p, Kw.Measure)) {
        expression(p);
        expect(p, Tok.Semi);
    };
    let measure = mark();
    let start = p.pos;
    advance(p);
    block(p);
    node(p, Node.Measure_decl, measure, start);
    expect(p, Tok.RBrace);
    node(p, Node.Bench_decl, at, first);
}

//! = Types

fn type_(p: Parser) I32 {
    deeper(p);
    let made = type_at(p);
    parse_depth[0] -= 1;
    made;
}

fn type_at(p: Parser) I32 {
    if is(p, Tok.Question) {
        let at = mark();
        let first = p.pos;
        advance(p);
        base_type(p);
        return node(p, Node.Nullable_type, at, first);
    };
    base_type(p);
}

fn base_type(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    if is(p, Tok.Amp) { return promoted_type(p); };
    if is(p, Tok.LParen) {
        advance(p);
        type_(p);
        expect(p, Tok.RParen);
        return node(p, Node.Paren_type, at, first);
    };
    if is(p, Tok.Dot) {
        advance(p);
        expect(p, Tok.LBrace);
        type_(p);
        while (is(p, Tok.Comma)) {
            advance(p);
            if is(p, Tok.RBrace) { break; };
            type_(p);
        };
        expect(p, Tok.RBrace);
        return node(p, Node.Tuple_type, at, first);
    };
    // Where a type begins, `fun` and `cl` are always keywords.
    if is_kw(p, Kw.Fun) or is_kw(p, Kw.Cl) {
        let closure = is_kw(p, Kw.Cl);
        advance(p);
        expect(p, Tok.LParen);
        if not is(p, Tok.RParen) { type_list(p); };
        expect(p, Tok.RParen);
        return_type(p);
        return node(p, if closure { Node.Closure_type; } else { Node.Func_type; }, at, first);
    };
    ref_type(p);
    node(p, Node.Ref_type, at, first);
}

/// The inside of a `ref_type`: a type name, `M.T`, `M[A]`, or `M[A].T`.
fn ref_type(p: Parser) I32 {
    if not is_word(p) { fail(p); };
    let s = save(p);
    let at = mark();
    let first = p.pos;
    module_name(p);
    if is(p, Tok.LBracket) {
        module_type_arg_list(p);
        let instantiated = node(p, Node.Instantiated_module_ref, at, first);
        if is(p, Tok.Dot) {
            advance(p);
            type_ident(p);
            return node(p, Node.Qualified_type_ref, at, first);
        };
        return instantiated;
    };
    if is(p, Tok.Dot) {
        node(p, Node.Module_ref, at, first);
        advance(p);
        type_ident(p);
        return node(p, Node.Qualified_type_ref, at, first);
    };
    restore(p, s);
    type_ident(p);
}

//! = Blocks

fn block(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    expect(p, Tok.LBrace);
    while (not is(p, Tok.RBrace)) {
        expression(p);
        expect(p, Tok.Semi);
    };
    advance(p);
    node(p, Node.Block, at, first);
}

fn capture(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    expect(p, Tok.Pipe);
    identifier(p);
    while (is(p, Tok.Comma)) {
        advance(p);
        identifier(p);
    };
    expect(p, Tok.Pipe);
    node(p, Node.Capture, at, first);
}

//! = Expressions

/// An expression of any precedence.
fn expression(p: Parser) I32 { expr(p, -1000, true); }

/// An expression whose operators have precedence above `min`, or equal to it
/// when `or_equal` (the rule this operand belongs to is right-associative).
fn expr(p: Parser, min: I32, or_equal: Bool) I32 {
    deeper(p);
    let left = prefix(p);
    while (true) {
        let next = infix(p, left, min, or_equal);
        if next < 0 {
            parse_depth[0] -= 1;
            return left;
        };
        left = next;
    };
    left;
}

fn binds(precedence: I32, min: I32, or_equal: Bool) Bool {
    precedence > min or (precedence == min and or_equal);
}

/// The precedence of the binary operator at the cursor (a token or a
/// keyword), or -1 if none. `^` (12) is the one right-associative.
fn binary_precedence(p: Parser) I32 {
    match Tok.from_i32(kind_at(p, 0)) {
        Tok.Caret => 12,
        Tok.Star => 11,
        Tok.Slash => 11,
        Tok.Percent => 11,
        Tok.Plus => 10,
        Tok.Minus => 10,
        Tok.Shl => 9,
        Tok.Shr => 9,
        Tok.Shr3 => 9,
        Tok.Amp => 8,
        Tok.Pipe => 6,
        Tok.EqEq => 5,
        Tok.BangEq => 5,
        Tok.Lt => 5,
        Tok.Gt => 5,
        Tok.LtEq => 5,
        Tok.GtEq => 5,
        ~> {
            let w = word_id(p);
            if w == Kw.And.to_i32() { 4; } else if w == Kw.Xor.to_i32() { 3; } else if w == Kw.Or.to_i32() { 2; } else { -1; };
        },
    };
}

fn is_assignment(k: I32) Bool {
    k == Tok.Eq.to_i32() or k == Tok.PlusEq.to_i32() or k == Tok.MinusEq.to_i32() or k == Tok.StarEq.to_i32()
        or k == Tok.SlashEq.to_i32() or k == Tok.PercentEq.to_i32() or k == Tok.ShlEq.to_i32() or k == Tok.ShrEq.to_i32()
        or k == Tok.Shr3Eq.to_i32() or k == Tok.AmpEq.to_i32() or k == Tok.PipeEq.to_i32() or k == Tok.CaretEq.to_i32();
}

/// The form of an iterator keyword: 0 capture, 1 param-capture, 2 param,
/// 3 element-capture, 4 element, 5 element-key-capture, 6 element-param,
/// 7 none; -1 when the word is not one.
fn iterator_form(w: I32) I32 {
    if w >= Kw.Map.to_i32() and w <= Kw.Bisect.to_i32() { return 0; };
    if w >= Kw.Fold.to_i32() and w <= Kw.Zip.to_i32() { return 1; };
    if w >= Kw.Skip.to_i32() and w <= Kw.Repeat.to_i32() { return 2; };
    if w >= Kw.Sort.to_i32() and w <= Kw.Partition.to_i32() { return 3; };
    if w == Kw.Collect.to_i32() { return 4; };
    if w == Kw.Group_by.to_i32() or w == Kw.Distinct_by.to_i32() { return 5; };
    if w == Kw.Batched.to_i32() or w == Kw.Windows.to_i32() { return 6; };
    if w >= Kw.Sum.to_i32() and w <= Kw.Count.to_i32() { return 7; };
    -1;
}

/// Extend `left` by one postfix or infix operation, or return -1.
fn infix(p: Parser, left: I32, min: I32, or_equal: Bool) I32 {
    let k = kind_at(p, 0);
    // What most often follows an expression ends it.
    if k == Tok.Semi.to_i32() or k == Tok.RParen.to_i32() or k == Tok.Comma.to_i32() or k == Tok.RBrace.to_i32()
        or k == Tok.LBrace.to_i32() or k == Tok.RBracket.to_i32() or k == Tok.Colon.to_i32() or k == Tok.FatArrow.to_i32()
        or k == Tok.End.to_i32() {
        return -1;
    };
    let w = word_id(p);
    // Postfix: calls, fields, indexes (precedence 14).
    if binds(14, min, or_equal) {
        if k == Tok.LParen.to_i32() {
            let at = mark_below(left);
            advance(p);
            arg_list_or_none(p);
            expect(p, Tok.RParen);
            return node(p, Node.Call_expr, at, node_first[left]);
        };
        if k == Tok.Dot.to_i32() or k == Tok.QuestionDot.to_i32() {
            let at = mark_below(left);
            advance(p);
            identifier_or_type(p);
            return node(p, if k == Tok.Dot.to_i32() { Node.Field_expr; } else { Node.Optional_field_expr; }, at, node_first[left]);
        };
        if k == Tok.LBracket.to_i32() {
            let at = mark_below(left);
            advance(p);
            expression(p);
            if is(p, Tok.Comma) {
                advance(p);
                expression(p);
                expect(p, Tok.RBracket);
                return node(p, Node.Slice_expr, at, node_first[left]);
            };
            expect(p, Tok.RBracket);
            return node(p, Node.Index_expr, at, node_first[left]);
        };
    };
    // Compound assignment keywords are one token: `x and= y`.
    if (w == Kw.And.to_i32() or w == Kw.Or.to_i32() or w == Kw.Xor.to_i32()) and is_at(p, 1, Tok.Eq) and adjacent(p.pos, p.pos + 1) {
        return assignment(p, left, 2);
    };
    if is_assignment(k) { return assignment(p, left, 1); };
    let precedence = binary_precedence(p);
    if precedence >= 0 {
        if not binds(precedence, min, or_equal) { return -1; };
        let at = mark_below(left);
        advance(p);
        expr(p, precedence, precedence == 12);
        return node(p, Node.Binary_expr, at, node_first[left]);
    };
    let form = iterator_form(w);
    if form >= 0 {
        if not binds(1, min, or_equal) { return -1; };
        return iterator(p, left, form);
    };
    if w == Kw.Orelse.to_i32() {
        if not binds(1, min, or_equal) { return -1; };
        let at = mark_below(left);
        advance(p);
        expr(p, 1, false);
        return node(p, Node.Else_expr, at, node_first[left]);
    };
    if k == Tok.MinusO.to_i32() {
        if not binds(0, min, or_equal) { return -1; };
        let at = mark_below(left);
        advance(p);
        pipe_target(p);
        return node(p, Node.Pipe_expr, at, node_first[left]);
    };
    -1;
}

/// An assignment to `left`, whatever the surrounding precedence: tree-sitter
/// shifts the operator onto an assignable target before reducing it into an
/// enclosing expression, so `a + b = c` is `a + (b = c)`.
fn assignment(p: Parser, left: I32, operator_tokens: I32) I32 {
    let target = node_kind[left];
    let assignable = target == Node.Identifier.to_i32() or target == Node.Field_expr.to_i32()
        or target == Node.Optional_field_expr.to_i32() or target == Node.Index_expr.to_i32()
        or (target == Node.Type_member_expr.to_i32() and node_kind[node_child[left]] == Node.Type_ident.to_i32());
    if not assignable { return -1; };
    let at = mark_below(left);
    p.pos += operator_tokens;
    expr(p, 0, true);
    node(p, Node.Assign_expr, at, node_first[left]);
}

fn arg_list_or_none(p: Parser) void {
    if is(p, Tok.RParen) { return; };
    let at = mark();
    let first = p.pos;
    expression(p);
    while (is(p, Tok.Comma)) {
        advance(p);
        if is(p, Tok.RParen) { break; };
        expression(p);
    };
    node(p, Node.Arg_list, at, first);
}

fn iterator(p: Parser, left: I32, form: I32) I32 {
    let at = mark_below(left);
    advance(p);
    if form == 1 or form == 2 {
        expect(p, Tok.LParen);
        expression(p);
        expect(p, Tok.RParen);
    } else if form == 3 or form == 4 {
        expect(p, Tok.LParen);
        type_(p);
        expect(p, Tok.RParen);
    } else if form == 5 {
        expect(p, Tok.LParen);
        type_(p);
        expect(p, Tok.Comma);
        type_(p);
        expect(p, Tok.RParen);
    } else if form == 6 {
        expect(p, Tok.LParen);
        type_(p);
        expect(p, Tok.Comma);
        expression(p);
        expect(p, Tok.RParen);
    };
    if form == 0 or form == 1 or form == 3 or form == 5 {
        capture(p);
        block(p);
    };
    node(p, Node.Iterator_expr, at, node_first[left]);
}

fn pipe_target(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    if not is_word(p) { fail(p); };
    if is_at(p, 1, Tok.LBracket) {
        let module = mark();
        module_name(p);
        module_type_arg_list(p);
        node(p, Node.Instantiated_module_ref, module, first);
    } else {
        // Not a module: the path starts with a plain name.
        identifier_or_type(p);
    };
    while (is(p, Tok.Dot)) {
        advance(p);
        identifier_or_type(p);
    };
    // Stage 0 reads the first dot of `...` or `..<` as a path's next `.`, which then has no name.
    if is(p, Tok.DotDotDot) or is(p, Tok.DotDotLt) { fail(p); };
    if is(p, Tok.LParen) {
        advance(p);
        pipe_args(p);
        expect(p, Tok.RParen);
    };
    node(p, Node.Pipe_target, at, first);
}

fn pipe_args(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    let args = mark();
    let placeholder = false;
    while (true) {
        let arg = mark();
        let start = p.pos;
        if is(p, Tok.Amp) {
            if placeholder { fail(p); };
            placeholder = true;
            promoted_type(p);
            node(p, Node.Pipe_arg_placeholder, arg, start);
        } else {
            expression(p);
            node(p, Node.Pipe_arg, arg, start);
        };
        if not is(p, Tok.Comma) { break; };
        advance(p);
        if is(p, Tok.RParen) { break; };
    };
    node(p, if placeholder { Node.Pipe_args_with_placeholder; } else { Node.Pipe_args_no_placeholder; }, args, first);
    node(p, Node.Pipe_args, at, first);
}

/// How deeply the parse is nested (expressions, types, `else if`s), and the
/// most it has been and the token where: a program nested deeper than the
/// compiler's stack bears is reported there (see src/selfhost/compiler.js).
vec parse_depth: I32 = [0];
vec parse_deepest: I32 = [0, -1];

fn deeper(p: Parser) void {
    parse_depth[0] += 1;
    if parse_depth[0] > parse_deepest[0] {
        parse_deepest[0] = parse_depth[0];
        parse_deepest[1] = ptok[p.pos];
    };
}

fn prefix(p: Parser) I32 {
    if at_end(p) { fail(p); };
    let at = mark();
    let first = p.pos;
    if is_word(p) {
        if is_expression_keyword(word_id(p)) { return keyword_expression(p); };
        return word_expression(p);
    };
    if is(p, Tok.Int) or is(p, Tok.Float) {
        number(p);
        return node(p, Node.Literal, at, first);
    };
    if is(p, Tok.String) {
        string_lit(p);
        return node(p, Node.Literal, at, first);
    };
    if is(p, Tok.TemplateFull) or is(p, Tok.TemplateHead) { return template_string(p); };
    if is(p, Tok.MultilineLine) {
        let lines = mark();
        while (is(p, Tok.MultilineLine)) { leaf(p, Node.Multiline_string_line); };
        node(p, Node.Multiline_string_lit, lines, first);
        return node(p, Node.Literal, at, first);
    };
    if is(p, Tok.Minus) or is(p, Tok.Tilde) {
        advance(p);
        node(p, Node.Unary_op, at, first);
        expr(p, 13, true);
        return node(p, Node.Unary_expr, at, first);
    };
    if is(p, Tok.LParen) { return paren_or_range(p); };
    if is(p, Tok.LBracket) { return array_expr(p); };
    if is(p, Tok.Dot) { return tuple_expr(p); };
    if is(p, Tok.LBrace) {
        block(p);
        return node(p, Node.Block_expr, at, first);
    };
    if is(p, Tok.Amp) {
        promoted_type(p);
        field_inits(p);
        return node(p, Node.Implicit_struct_init, at, first);
    };
    if is(p, Tok.At) { return dsl_expr(p); };
    fail(p);
    -1;
}

/// Keywords that begin an expression; elsewhere these words are identifiers.
/// (Keywords are the first words interned: any other is past them.)
fn is_expression_keyword(w: I32) Bool {
    w < Kw.count() and (w == Kw.If.to_i32() or w == Kw.Match.to_i32() or w == Kw.Loop.to_i32() or w == Kw.Alt.to_i32()
        or w == Kw.Promote.to_i32() or w == Kw.Try.to_i32() or w == Kw.For.to_i32() or w == Kw.While.to_i32()
        or w == Kw.Break.to_i32() or w == Kw.Continue.to_i32() or w == Kw.Defer.to_i32() or w == Kw.Yield.to_i32()
        or w == Kw.Return.to_i32() or w == Kw.Let.to_i32() or w == Kw.Cl.to_i32() or w == Kw.Fatal.to_i32()
        or w == Kw.Prune.to_i32() or w == Kw.New.to_i32() or w == Kw.Await.to_i32() or w == Kw.Assert.to_i32()
        or w == Kw.Not.to_i32() or w == Kw.True.to_i32() or w == Kw.False.to_i32() or w == Kw.Null.to_i32());
}

fn keyword_expression(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    let w = word_id(p);
    if w == Kw.True.to_i32() or w == Kw.False.to_i32() or w == Kw.Null.to_i32() {
        advance(p);
        return node(p, Node.Literal, at, first);
    };
    if w == Kw.Not.to_i32() {
        advance(p);
        node(p, Node.Unary_op, at, first);
        expr(p, 13, true);
        return node(p, Node.Unary_expr, at, first);
    };
    if w == Kw.Await.to_i32() {
        advance(p);
        expr(p, 13, true);
        return node(p, Node.Await_expr, at, first);
    };
    if w == Kw.Assert.to_i32() {
        advance(p);
        expr(p, -2, true);
        return node(p, Node.Assert_expr, at, first);
    };
    if w == Kw.New.to_i32() {
        advance(p);
        let callee = prefix(p);
        while (is(p, Tok.Dot) or is(p, Tok.QuestionDot) or is(p, Tok.LBracket)) {
            callee = infix(p, callee, 13, false);
            if callee < 0 { fail(p); };
        };
        expect(p, Tok.LParen);
        arg_list_or_none(p);
        expect(p, Tok.RParen);
        return node(p, Node.New_expr, at, first);
    };
    if w == Kw.Return.to_i32() or w == Kw.Continue.to_i32() {
        advance(p);
        if starts_expression(p) { expr(p, 0, true); };
        return node(p, if w == Kw.Return.to_i32() { Node.Return_expr; } else { Node.Continue_expr; }, at, first);
    };
    if w == Kw.Yield.to_i32() or w == Kw.Defer.to_i32() {
        advance(p);
        expr(p, 0, true);
        return node(p, if w == Kw.Yield.to_i32() { Node.Yield_expr; } else { Node.Defer_expr; }, at, first);
    };
    if w == Kw.Break.to_i32() {
        // `break label value`: a label is a name, but not a word that may follow an expression.
        advance(p);
        if shaped(p) and starts_expression(p) {
            identifier(p);
            if starts_expression(p) { expr(p, 0, true); };
        };
        return node(p, Node.Break_expr, at, first);
    };
    if w == Kw.Fatal.to_i32() { return leaf(p, Node.Fatal_expr); };
    if w == Kw.Prune.to_i32() { return leaf(p, Node.Prune_expr); };
    if w == Kw.Let.to_i32() { return bind_expr(p); };
    if w == Kw.Cl.to_i32() { return closure_expr(p); };
    if w == Kw.If.to_i32() { return if_expr(p); };
    if w == Kw.Match.to_i32() {
        advance(p);
        return match_expr(p, Node.Match_expr, at, first);
    };
    if w == Kw.Loop.to_i32() {
        advance(p);
        expect_kw(p, Kw.Match);
        return match_expr(p, Node.Loop_match_expr, at, first);
    };
    if w == Kw.Alt.to_i32() { return alt_expr(p); };
    if w == Kw.Promote.to_i32() { return promote_expr(p); };
    if w == Kw.Try.to_i32() { return try_expr(p); };
    if w == Kw.For.to_i32() { return for_expr(p); };
    if w == Kw.While.to_i32() { return while_expr(p); };
    fail(p);
    -1;
}

/// `text ${expr} text`: its text pieces are tokens, the expressions between them.
fn template_string(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    if is(p, Tok.TemplateFull) {
        leaf(p, Node.Template_full);
        return node(p, Node.Template_string, at, first);
    };
    leaf(p, Node.Template_head);
    while (true) {
        expression(p);
        if is(p, Tok.TemplateTail) {
            leaf(p, Node.Template_tail);
            break;
        };
        if not is(p, Tok.TemplateMiddle) { fail(p); };
        leaf(p, Node.Template_middle);
    };
    node(p, Node.Template_string, at, first);
}

/// Whether the token at the cursor begins `return`'s or `continue`'s optional
/// value. Words that continue an expression (`and`, `orelse`, `map`, …) and
/// `-o` instead extend the bare `return`.
fn starts_expression(p: Parser) Bool {
    if at_end(p) { return false; };
    if is_word(p) {
        let w = word_id(p);
        return iterator_form(w) < 0 and w != Kw.And.to_i32() and w != Kw.Or.to_i32() and w != Kw.Xor.to_i32()
            and w != Kw.Orelse.to_i32();
    };
    is(p, Tok.Int) or is(p, Tok.Float) or is(p, Tok.String) or is(p, Tok.TemplateFull) or is(p, Tok.TemplateHead) or is(p, Tok.MultilineLine) or is(p, Tok.Minus)
        or is(p, Tok.Tilde) or is(p, Tok.LParen) or is(p, Tok.LBracket) or is(p, Tok.Dot) or is(p, Tok.LBrace)
        or is(p, Tok.Amp) or is(p, Tok.At);
}

fn word_expression(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    if shaped(p) {
        // `label: { … }`
        if is_at(p, 1, Tok.Colon) and is_at(p, 2, Tok.LBrace) {
            identifier(p);
            advance(p);
            block(p);
            return node(p, Node.Block_expr, at, first);
        };
        // `m.T { field: … }` builds a struct from module m.
        let qualified = qualified_struct_init(p);
        if qualified >= 0 { return qualified; };
        // `m[i]` indexes; `m[A]…` names an instantiated module only when the
        // brackets do not hold an index.
        if index_ahead(p) { return identifier(p); };
        if not module_args_ahead(p) { return identifier(p); };
    };
    // A type name begins `T.null`, `T.member`, `T { … }`, `M[A].f(…)`, or `M[A].T.member`.
    if module_call_ahead(p) { return module_call(p); };
    let s = save(p);
    let type_name = not shaped(p);
    leaf(p, if type_name { Node.Type_ident; } else { Node.Identifier; });
    if type_name and is(p, Tok.LBrace) {
        field_inits(p);
        return node(p, Node.Struct_init, at, first);
    };
    if is(p, Tok.LBracket) {
        restore(p, s);
        // After `M[A]`, only `.T.member` is left (`.f(…)` was a module call).
        module_name(p);
        module_type_arg_list(p);
        expect(p, Tok.Dot);
        if shaped(p) { fail(p); };
        type_ident(p);
        node(p, Node.Inline_module_type_path, at, first);
        expect(p, Tok.Dot);
        identifier_or_type(p);
        return node(p, Node.Type_member_expr, at, first);
    };
    if not type_name or not is(p, Tok.Dot) { fail(p); };
    advance(p);
    if is_kw(p, Kw.Null) {
        advance(p);
        return node(p, Node.Null_expr, at, first);
    };
    // `M.T { … }` is the member `M.T` before a block, never a struct: the
    // member rule's precedence wins. (`M.T.member` is a field of `M.T`.)
    identifier_or_type(p);
    node(p, Node.Type_member_expr, at, first);
}

/// `m.T { field: … }` at the cursor (`m` a lowercase module), or -1 without consuming.
fn qualified_struct_init(p: Parser) I32 {
    if not (is_at(p, 1, Tok.Dot) and is_at(p, 2, Tok.Word) and is_at(p, 3, Tok.LBrace)) { return -1; };
    let s = save(p);
    let made = try {
        let at = mark();
        let first = p.pos;
        identifier(p);
        node(p, Node.Module_name, at, first);
        node(p, Node.Module_ref, at, first);
        advance(p);
        type_ident(p);
        node(p, Node.Qualified_type_ref, at, first);
        field_inits(p);
        node(p, Node.Struct_init, at, first);
    } catch {
        -1;
    };
    if made < 0 { restore(p, s); };
    made;
}

/// Whether the cursor starts `name[index]` or `name[start, end]` with expressions inside.
fn index_ahead(p: Parser) Bool {
    if not is_at(p, 1, Tok.LBracket) { return false; };
    let s = save(p);
    let found = try {
        advance(p);
        advance(p);
        expression(p);
        if is(p, Tok.Comma) {
            advance(p);
            expression(p);
        };
        is(p, Tok.RBracket);
    } catch {
        false;
    };
    restore(p, s);
    found;
}

/// Whether the cursor starts `name[types].`, a module instantiation.
fn module_args_ahead(p: Parser) Bool {
    if not is_at(p, 1, Tok.LBracket) { return false; };
    let s = save(p);
    let found = try {
        module_name(p);
        module_type_arg_list(p);
        is(p, Tok.Dot);
    } catch {
        false;
    };
    restore(p, s);
    found;
}

/// Whether the cursor starts `name[types].identifier(`.
fn module_call_ahead(p: Parser) Bool {
    if not is_at(p, 1, Tok.LBracket) { return false; };
    let s = save(p);
    let found = try {
        module_name(p);
        module_type_arg_list(p);
        is(p, Tok.Dot) and shaped_at(p, 1) and is_at(p, 2, Tok.LParen);
    } catch {
        false;
    };
    restore(p, s);
    found;
}

fn module_call(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    module_name(p);
    module_type_arg_list(p);
    expect(p, Tok.Dot);
    identifier(p);
    expect(p, Tok.LParen);
    arg_list_or_none(p);
    expect(p, Tok.RParen);
    node(p, Node.Promoted_module_call_expr, at, first);
}

fn field_inits(p: Parser) void {
    expect(p, Tok.LBrace);
    if not is(p, Tok.RBrace) {
        field_init(p);
        while (is(p, Tok.Comma)) {
            advance(p);
            if is(p, Tok.RBrace) { break; };
            field_init(p);
        };
    };
    expect(p, Tok.RBrace);
}

fn field_init(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    identifier(p);
    expect(p, Tok.Colon);
    expression(p);
    node(p, Node.Field_init, at, first);
}

fn paren_or_range(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    advance(p);
    expression(p);
    if is(p, Tok.DotDotDot) or is(p, Tok.DotDotLt) {
        advance(p);
        expression(p);
        expect(p, Tok.RParen);
        return node(p, Node.Range_expr, at, first);
    };
    expect(p, Tok.RParen);
    node(p, Node.Paren_expr, at, first);
}

fn array_expr(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    advance(p);
    if not is(p, Tok.RBracket) {
        expression(p);
        while (is(p, Tok.Comma)) {
            advance(p);
            if is(p, Tok.RBracket) { break; };
            expression(p);
        };
    };
    expect(p, Tok.RBracket);
    node(p, Node.Array_expr, at, first);
}

fn tuple_expr(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    advance(p);
    expect(p, Tok.LBrace);
    expression(p);
    while (is(p, Tok.Comma)) {
        advance(p);
        if is(p, Tok.RBrace) { break; };
        expression(p);
    };
    expect(p, Tok.RBrace);
    node(p, Node.Tuple_expr, at, first);
}

fn dsl_expr(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    expect(p, Tok.At);
    identifier(p);
    if not is(p, Tok.DslBody) { fail(p); };
    leaf(p, Node.Dsl_body);
    node(p, Node.Dsl_expr, at, first);
}

fn bind_expr(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    advance(p);
    if is(p, Tok.Dot) {
        let pattern = mark();
        let start = p.pos;
        advance(p);
        expect(p, Tok.LBrace);
        identifier(p);
        while (is(p, Tok.Comma)) {
            advance(p);
            if is(p, Tok.RBrace) { break; };
            identifier(p);
        };
        expect(p, Tok.RBrace);
        node(p, Node.Tuple_pattern, pattern, start);
    } else {
        identifier(p);
        if is(p, Tok.Colon) {
            advance(p);
            type_(p);
        };
    };
    expect(p, Tok.Eq);
    expr(p, 0, true);
    node(p, Node.Bind_expr, at, first);
}

fn closure_expr(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    advance(p);
    expect(p, Tok.LParen);
    if not is(p, Tok.RParen) {
        let params = mark();
        let start = p.pos;
        closure_param(p);
        while (is(p, Tok.Comma)) {
            advance(p);
            if is(p, Tok.RParen) { break; };
            closure_param(p);
        };
        node(p, Node.Closure_param_list, params, start);
    };
    expect(p, Tok.RParen);
    if not is(p, Tok.LBrace) { return_type(p); };
    block(p);
    node(p, Node.Closure_expr, at, first);
}

fn closure_param(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    identifier(p);
    if is(p, Tok.Colon) {
        advance(p);
        type_(p);
    };
    node(p, Node.Closure_param, at, first);
}

fn if_expr(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    advance(p);
    expression(p);
    block(p);
    if is_kw(p, Kw.Else) {
        advance(p);
        if is_kw(p, Kw.If) {
            deeper(p);
            if_expr(p);
            parse_depth[0] -= 1;
        } else { block(p); };
    };
    node(p, Node.If_expr, at, first);
}

fn match_expr(p: Parser, kind: Node, at: I32, first: I32) I32 {
    expression(p);
    expect(p, Tok.LBrace);
    while (not is(p, Tok.RBrace) and not is(p, Tok.TildeArrow)) { match_arm(p); };
    if is(p, Tok.TildeArrow) {
        let default = mark();
        let start = p.pos;
        advance(p);
        expression(p);
        expect(p, Tok.Comma);
        node(p, Node.Match_default, default, start);
    };
    expect(p, Tok.RBrace);
    node(p, kind, at, first);
}

fn match_arm(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    match_lit(p);
    expect(p, Tok.FatArrow);
    expression(p);
    expect(p, Tok.Comma);
    node(p, Node.Match_arm, at, first);
}

fn match_lit(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    if is_kw(p, Kw.True) or is_kw(p, Kw.False) {
        leaf(p, Node.Bool_lit);
    } else if is_word(p) {
        unreserved_type_ident(p);
        expect(p, Tok.Dot);
        type_ident(p);
    } else {
        if is(p, Tok.Minus) { advance(p); };
        number(p);
    };
    node(p, Node.Match_lit, at, first);
}

fn alt_expr(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    advance(p);
    expression(p);
    expect(p, Tok.LBrace);
    while (not is(p, Tok.RBrace) and not is(p, Tok.TildeArrow)) {
        let arm = mark();
        let start = p.pos;
        alt_pattern(p);
        if is(p, Tok.Pipe) {
            advance(p);
            identifier(p);
            expect(p, Tok.Pipe);
        };
        expect(p, Tok.FatArrow);
        expression(p);
        expect(p, Tok.Comma);
        node(p, Node.Alt_arm, arm, start);
    };
    if is(p, Tok.TildeArrow) {
        let default = mark();
        let start = p.pos;
        advance(p);
        expression(p);
        expect(p, Tok.Comma);
        node(p, Node.Alt_default, default, start);
    };
    expect(p, Tok.RBrace);
    node(p, Node.Alt_expr, at, first);
}

fn alt_pattern(p: Parser) I32 {
    let s = save(p);
    let at = mark();
    let first = p.pos;
    module_name(p);
    if is(p, Tok.LBracket) or is(p, Tok.Dot) {
        if is(p, Tok.LBracket) {
            module_type_arg_list(p);
            node(p, Node.Instantiated_module_ref, at, first);
        } else {
            node(p, Node.Module_ref, at, first);
        };
        expect(p, Tok.Dot);
        type_ident(p);
        return node(p, Node.Qualified_type_ref, at, first);
    };
    restore(p, s);
    // A bare variant name cannot be a keyword; a module before `.` can.
    unreserved_type_ident(p);
}

fn promote_expr(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    advance(p);
    expression(p);
    expect(p, Tok.LBrace);
    expect(p, Tok.Pipe);
    identifier(p);
    expect(p, Tok.Pipe);
    expect(p, Tok.FatArrow);
    expression(p);
    expect(p, Tok.Comma);
    if is(p, Tok.TildeArrow) {
        advance(p);
        expression(p);
        expect(p, Tok.Comma);
    };
    expect(p, Tok.RBrace);
    node(p, Node.Promote_expr, at, first);
}

fn try_expr(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    advance(p);
    block(p);
    expect_kw(p, Kw.Catch);
    if is(p, Tok.Pipe) {
        advance(p);
        identifier(p);
        expect(p, Tok.Pipe);
    };
    block(p);
    node(p, Node.Try_expr, at, first);
}

fn for_expr(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    advance(p);
    expect(p, Tok.LParen);
    let sources = mark();
    let start = p.pos;
    for_source(p);
    while (is(p, Tok.Comma)) {
        advance(p);
        for_source(p);
    };
    node(p, Node.For_sources, sources, start);
    expect(p, Tok.RParen);
    if is(p, Tok.Pipe) { capture(p); };
    block(p);
    node(p, Node.For_expr, at, first);
}

fn for_source(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    expression(p);
    if is(p, Tok.DotDotDot) or is(p, Tok.DotDotLt) {
        advance(p);
        expression(p);
    };
    node(p, Node.For_source, at, first);
}

fn while_expr(p: Parser) I32 {
    let at = mark();
    let first = p.pos;
    advance(p);
    expect(p, Tok.LParen);
    if not is(p, Tok.RParen) { expression(p); };
    expect(p, Tok.RParen);
    block(p);
    node(p, Node.While_expr, at, first);
}

//! = Running the parser

/// Intern every keyword, at the start of `src`, so a word's id is its
/// keyword's when it is one. Files follow.
fn intern_keywords() void {
    src.resize(abi_kept[0]);
    src.intern_reset();
    for (0 ..< Kw.count()) |k| {
        let name = Kw.name(Kw.from_i32(k));
        let start = src.len();
        for (0 ..< name.len()) |c| {
            let b = name.get(c);
            src.push(if c == 0 { b + 32; } else { b; });
        };
        src.intern(start, src.len());
    };
}

/// Intern the word tokens from `first` up to `last`, and list those the
/// parser reads (all but comments) in @ptok.
fn intern_words(first: I32, last: I32) void {
    tok_word.resize(last);
    ptok.resize(last - first + 4);
    let p = 0;
    for (first ..< last) |t| {
        let kind = tok_kind[t];
        tok_word[t] = if kind == Tok.Word.to_i32() { src.intern(tok_start[t], tok_end[t]); } else { -1; };
        if kind != Tok.Comment.to_i32() {
            ptok[p] = t;
            p += 1;
        };
    };
    // Lookahead past the end reads the End token again.
    for (0 ..< 4) |k| { ptok[p + k] = last - 1; };
    ptok.resize(p + 4);
}

/// Parse the tokens from `first` up to `last` (the last of them `End`), adding
/// their nodes. Returns the source file node, or -1 when the tokens do not
/// parse (and adds no nodes).
fn parse(first: I32, last: I32) I32 {
    parse_error_wanted[0] = -1;
    if tok_kind[last - 1] != Tok.End.to_i32() {
        parse_error_at[0] = last - 1;
        return -1;
    };
    intern_words(first, last);
    let before = node_kind.len();
    pending.clear();
    parse_depth[0] = 0;
    parse_deepest[0] = 0;
    parse_deepest[1] = -1;
    parse_furthest[0] = 0;
    parse_expected.clear();
    try {
        let root = source_file(Parser { pos: 0 });
        token_spans(before, root, first, last - 1);
        if comment_nodes[0] == 1 { attach_comments(root); };
        note_dsl_sites(before);
        root;
    } catch {
        parse_error_at[0] = ptok[parse_furthest[0]];
        if parse_expected.len() > 0 { parse_error_wanted[0] = intern_text(wanted_text()); };
        restore(Parser { pos: 0 }, Save { pos: 0, nodes: before, pending: 0, depth: 0 });
        -1;
    };
}

/// Node spans in the lexer's tokens (with comments) rather than the parser's,
/// for the nodes from `before` on. The source file spans every token from
/// `first` up to `end_` (the `End` token).
fn token_spans(before: I32, root: I32, first: I32, end_: I32) void {
    for (before ..< node_kind.len()) |id| {
        let a = node_first[id];
        let b = node_last[id];
        node_first[id] = ptok[a];
        node_last[id] = if b > a { ptok[b - 1] + 1; } else { ptok[a]; };
    };
    node_first[root] = first;
    node_last[root] = end_;
}

/// 1 when the tree should hold comments (see @attach_comments): only the
/// parser's differential asks for them.
vec comment_nodes: I32 = [0];

struct Comments:
    | next: I32

/// Put each comment in the smallest node whose first and last tokens surround
/// it, among its children in order (stage 0's `attachComments`). Comments come
/// in source order, so one walk down the tree places them all. Only the
/// parser's differential asks for them (@comment_nodes): nothing compiling a
/// program reads them, so its tree is without them, and walking it skips none.
fn attach_comments(root: I32) void {
    let comments = Comments { next: node_first[root] };
    skip_to_comment(comments);
    attach_within(root, comments);
}

fn skip_to_comment(comments: Comments) void {
    while (comments.next < tok_kind.len() and tok_kind[comments.next] != Tok.Comment.to_i32()) { comments.next += 1; };
}

/// Place the comments before the end of `parent`'s tokens.
fn attach_within(parent: I32, comments: Comments) void {
    let before = -1;
    let c = node_child[parent];
    while (comments.next < node_last[parent]) {
        let t = comments.next;
        while (c >= 0 and node_last[c] <= t) {
            before = c;
            c = node_next[c];
        };
        if c >= 0 and node_first[c] < t {
            attach_within(c, comments);
            before = c;
            c = node_next[c];
        } else {
            let id = node_kind.len();
            node_kind.push(Node.Comment.to_i32());
            node_first.push(t);
            node_last.push(t + 1);
            node_child.push(-1);
            node_next.push(c);
            if before < 0 { node_child[parent] = id; } else { node_next[before] = id; };
            before = id;
            comments.next += 1;
            skip_to_comment(comments);
        };
    };
}

/// An expression from tokens `[first, last)`, the last an `End` token: its node,
/// or -1. (A DSL's expansion takes the utu written in its body this way, at
/// its place in the source.)
fn parse_expression(first: I32, last: I32) I32 {
    if tok_kind[last - 1] != Tok.End.to_i32() { return -1; };
    intern_words(first, last);
    let before = node_kind.len();
    pending.clear();
    try {
        let p = Parser { pos: 0 };
        let e = expression(p);
        if not at_end(p) { fail(p); };
        for (before ..< node_kind.len()) |id| {
            let a = node_first[id];
            let b = node_last[id];
            node_first[id] = ptok[a];
            node_last[id] = if b > a { ptok[b - 1] + 1; } else { ptok[a]; };
        };
        note_dsl_sites(before);
        e;
    } catch {
        restore(Parser { pos: 0 }, Save { pos: 0, nodes: before, pending: 0, depth: 0 });
        -1;
    };
}
