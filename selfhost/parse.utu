//! = The parser
//!
//! Recursive descent over the tokens (comments skipped), building a tree of
//! named nodes in mems: each node's kind, its first token and the token after
//! its last, its first child, and its next sibling. Punctuation and keywords
//! are not nodes; a node's span covers them. While parsing, spans are
//! positions in @ptok (the tokens without comments); once the tree is
//! built, they become the lexer's tokens (and, when @comment_nodes asks,
//! each comment becomes a node).
//!
//! A node is made from the nodes made since it began: those wait on the
//! @pending stack, and finishing a node links them as its children and puts
//! it in their place. Trying a parse and giving it up (@save, @restore)
//! truncates the node mems and the stack.
//!
//! The grammar is stage 0's (`syntax/parser.js at stage-1-final`), function by
//! function, which in turn is tree-sitter-utu's: the nodes are the named nodes
//! of its syntax tree, with the same spans, for every program it accepts
//! (`scripts/selfhost-parser-differential.mjs`). A program it does not accept
//! fails: a failed rule throws (@fail), and @parse reports the furthest token
//! any attempt reached, with what the attempts there wanted. (Stage 0 hands
//! those programs to tree-sitter, whose error recovery reports them.)

/// The kinds of node: tree-sitter-utu's named nodes, capitalized.
enum(U8) Node:
    | Source_file
    | Comment
    | Identifier
    | Type_ident
    | Int_lit
    | Float_lit
    | String_lit
    | Multiline_string_line
    | Multiline_string_lit
    | Dsl_body
    | Wutu_body
    | Platform_path
    | Void_type
    | Bool_lit
    | Module_decl
    | Module_name
    | Module_type_param_list
    | Module_type_param
    | Module_type_arg_list
    | Impl_list
    | Promoted_type
    | Nom_qualifier
    | Nom_tag
    | Struct_decl
    | Field
    | Enum_decl
    | Variant
    | Field_list
    | Proto_decl
    | Proto_member
    | Proto_getter
    | Proto_setter
    | Proto_get_setter
    | Proto_method
    | Op_decl
    | Fn_decl
    | Fn_name
    | Self_param
    | Param_list
    | Param
    | Return_type
    | Yield_type
    | Type_list
    | Global_decl
    | Mem_decl
    | Distinct_decl
    | Type_decl
    | Using_decl
    | Captured_module_name
    | Export_lib_decl
    | Export_main_decl
    | Export_html_decl
    | Test_decl
    | Bench_decl
    | Measure_decl
    | Nullable_type
    | Paren_type
    | Tuple_type
    | Func_type
    | Closure_type
    | Ref_type
    | Instantiated_module_ref
    | Qualified_type_ref
    | Module_ref
    | Block
    | Capture
    | Call_expr
    | Arg_list
    | Field_expr
    | Optional_field_expr
    | Slice_expr
    | Index_expr
    | Assign_expr
    | Binary_expr
    | Iterator_expr
    | Else_expr
    | Unary_op
    | Unary_expr
    | Block_expr
    | Implicit_struct_init
    | Literal
    | Await_expr
    | Assert_expr
    | New_expr
    | Return_expr
    | Continue_expr
    | Yield_expr
    | Defer_expr
    | Break_expr
    | Fatal_expr
    | Prune_expr
    | Struct_init
    | Inline_module_type_path
    | Type_member_expr
    | Null_expr
    | Promoted_module_call_expr
    | Field_init
    | Range_expr
    | Paren_expr
    | Array_expr
    | Tuple_expr
    | Dsl_expr
    | Bind_expr
    | Tuple_pattern
    | Closure_expr
    | Closure_param_list
    | Closure_param
    | If_expr
    | Match_expr
    | Loop_match_expr
    | Match_arm
    | Match_default
    | Match_lit
    | Alt_expr
    | Alt_arm
    | Alt_default
    | Promote_expr
    | Try_expr
    | For_expr
    | For_sources
    | For_source
    | While_expr
    | Splice           // utu written in a DSL body, in its expansion (dsl.utu)
    | Template_string
    | Template_full
    | Template_head
    | Template_middle
    | Template_tail
    | Try_result_expr
    | Errdefer_expr
    | Type_binder      // `$T` in a parameter's type: T, bound by the argument
    | Directive        // `#inline`, `#cache(64)`: before a `fn`, kept out of the tree (see @dir_node)
    | Gp_decl          // `gp` compute kernel or helper
    | Pipeline_decl    // `pipeline` GPU compute pipeline
    | Over_expr        // `kernel(...) over (w, h)` dispatch grid

/// Every keyword of the grammar, as interned word ids: each is its variant's
/// name with the first letter lowercased (`Flat_map` is `flat_map`). Where a
/// keyword may stand, the parser compares ids.
enum(U8) Kw:
    | Mod
    | Using
    | Tag
    | Rec
    | Struct
    | Proto
    | Enum
    | Fn
    | Wn
    | Let
    | Mem
    | Vec
    | Export
    | Const
    | Type
    | Distinct
    | Lib
    | Main
    | Html
    | Test
    | Bench
    | Measure
    | In
    | Out
    | Get
    | Set
    | Yield
    | Void
    | Fun
    | Cl
    | From
    | Map
    | Filter
    | Flat_map
    | Skip_while
    | Take_while
    | Each
    | Any
    | All
    | Count_where
    | First_index
    | Last_index
    | Bisect
    | Fold
    | Scan
    | Zip
    | Skip
    | Take
    | Chain
    | Repeat
    | Sort
    | Min_by
    | Max_by
    | First_where
    | Reduce
    | Partition
    | Collect
    | Group_by
    | Distinct_by
    | Batched
    | Windows
    | Sum
    | Fast_sum
    | Product
    | Count
    | Await
    | New
    | Assert
    | Not
    | And
    | Or
    | Xor
    | Orelse
    | If
    | Else
    | Promote
    | Try
    | Catch
    | Match
    | Loop
    | Alt
    | For
    | While
    | Break
    | Continue
    | Defer
    | Errdefer
    | Return
    | Fatal
    | Prune
    | True
    | False
    | Null
    | Gn

/// The tokens the parser reads (positions of the lexer's tokens, without
/// comments).
export mem ptok: I32
/// Token kinds in parser order, and the successor of each matched opener.
mem pkind: U8
mem pjump: I32

/// The tree, by node id: its kind (a @Node). The `node_*` mems are its rows:
/// its first token and the token after its last, its first child, and its next
/// sibling (-1 for none).
export mem node_kind: U8
export mem node_first: I32
export mem node_last: I32
export mem node_child: I32
export mem node_next: I32
/// By node: its parent, or -1. Recorded as nodes are linked: @finish for a
/// node's children, a comment's (@attach_within), and a graft's (@set_parent).
mem node_parent: I32
/// Nodes made but not yet any node's children: the next node finished takes
/// those above its mark.
mem pending: I32
/// Parser-local node count, pending stack top, and first node in this parse.
/// The exported node columns are cut to their logical size before returning.
let parse_nodes: I32 = 0
let parse_pending: I32 = 0
let parse_first: I32 = 0

/// Throws, abandoning the rule that failed: an attempt that catches it
/// restores its @Save.
let syntax_error: fun() Void = @es/\ () => { throw new SyntaxError('utu syntax'); } \/

// Give up: the program is not one this parser accepts. The furthest token
// any attempt failed at is where the error is reported, with what the
// attempts that got that far wanted there.
/// The furthest position any attempt failed at.
let parse_furthest: I32 = 0
/// At the furthest token: Tok kinds, and keywords as kw_wanted + their word.
vec parse_expected: I32
/// The token a failed parse reports.
let parse_error_at: I32 = 0
/// And the word of what it wanted there ("';' or '}'"), or -1.
let parse_error_wanted: I32 = -1

/// In @parse_expected, a keyword is this plus its word id; a token kind is itself.
let kw_wanted: I32 = 1000

fn fail(p: Parser) Void => fail_wanting(p, -1)

/// Fails at the cursor, noting what was wanted there (a token kind, or
/// @kw_wanted plus a keyword's word; -1 for nothing in particular).
fn fail_wanting(p: Parser, wanted: I32) Void {
    note_parse_failure(p.pos, wanted)
    syntax_error()
}

/// A predictive rejection reports the same attempted token as a thrown one.
fn note_parse_failure(pos: I32, wanted: I32) Void {
    if pos > parse_furthest {
        parse_furthest = pos
        parse_expected.clear()
    }
    if pos == parse_furthest and wanted >= 0 {
        for (0 ..< parse_expected.len()) |i| { if parse_expected[i] == wanted { return } }
        parse_expected.push(wanted)
    }
}

/// What the furthest attempts wanted, in words: `"';'"`, `"';' or '}'"`, `"'(', ',' or ')'"`.
fn wanted_text() Str {
    let n = parse_expected.len()
    if n == 0 { return "" }
    let text = ""
    for (0 ..< n) |i| {
        if i > 0 { text = text + (if i == n - 1 { sms(Sml.Or) } else { ", " }) }
        let w = parse_expected[i]
        text = sms2(Sml.ATickBTick, text, (if w >= kw_wanted { word_text(w - kw_wanted) } else { tok_spelling(w) }))
    }
    return text
}

/// How a kind of token is written (or named, for the kinds with no one spelling).
fn tok_spelling(kind: I32) Str {
    return match Tok(kind) {
        Tok.End => sms(Sml.EndOfFile),
        Tok.Error => sms(Sml.ACharacter),
        Tok.Word => sms(Sml.AName),
        Tok.Int => sms(Sml.AnInteger),
        Tok.Float => sms(Sml.ANumber),
        Tok.String => sms(Sml.AString),
        Tok.MultilineLine => sms(Sml.BackslashBackslash),
        Tok.DslBody => sms(Sml.SlashBackslash),
        Tok.WutuBody => "{",
        Tok.Comment => "//",
        Tok.TemplateFull => sms(Sml.ATemplateString),
        Tok.TemplateHead => sms(Sml.ATemplateString),
        Tok.TemplateMiddle => sms(Sml.ATemplateString),
        Tok.TemplateTail => sms(Sml.ATemplateString),
        Tok.LParen => sms(Sml.Open),
        Tok.RParen => ")",
        Tok.LBrace => "{",
        Tok.RBrace => "}",
        Tok.LBracket => "[",
        Tok.RBracket => "]",
        Tok.Comma => ",",
        Tok.Semi => sms(Sml.Semi),
        Tok.Colon => ":",
        Tok.At => sms(Sml.At),
        Tok.Dollar => sms(Sml.Dollar),
        Tok.Hash => "#",
        Tok.Dot => ".",
        Tok.DotDotDot => sms(Sml.DotDotDot),
        Tok.DotDotLt => sms(Sml.DotDotLt),
        Tok.Pipe => "|",
        Tok.PipeEq => sms(Sml.BarEq),
        Tok.Amp => sms(Sml.Amp),
        Tok.AmpEq => sms(Sml.AmpEq),
        Tok.Caret => sms(Sml.Caret),
        Tok.CaretEq => sms(Sml.CaretEq),
        Tok.Star => sms(Sml.Star),
        Tok.StarEq => sms(Sml.StarEq),
        Tok.Slash => sms(Sml.Slash),
        Tok.SlashEq => sms(Sml.SlashEq),
        Tok.Percent => sms(Sml.Pct),
        Tok.PercentEq => sms(Sml.PctEq),
        Tok.Plus => sms(Sml.Plus),
        Tok.PlusEq => sms(Sml.PlusEq),
        Tok.Minus => "-",
        Tok.MinusEq => sms(Sml.DashEq),
        Tok.Lt => sms(Sml.Lt),
        Tok.LtEq => sms(Sml.LtEq),
        Tok.Shl => sms(Sml.LtLt),
        Tok.ShlEq => sms(Sml.LtLtEq),
        Tok.Gt => sms(Sml.Gt),
        Tok.GtEq => sms(Sml.GtEq),
        Tok.Shr => sms(Sml.GtGt),
        Tok.ShrEq => sms(Sml.GtGtEq),
        Tok.Shr3 => sms(Sml.GtGtGt),
        Tok.Shr3Eq => sms(Sml.GtGtGtEq),
        Tok.Eq => "=",
        Tok.EqEq => "==",
        Tok.FatArrow => "=>",
        Tok.BangEq => sms(Sml.BangEq),
        Tok.Question => "?",
        Tok.QuestionDot => sms(Sml.QDot),
        Tok.Tilde => "~",
        Tok.TildeArrow => "~>",
    }
}

/// The cursor: a position in @ptok.
struct Parser:
    | pos: I32
    // The current statement ends here, or -1 outside a statement.
    | limit: I32

/// Where an attempt began: the cursor and the sizes of the node mems and
/// @pending, which @restore cuts back to.
struct Save:
    | pos: I32
    | nodes: I32
    | pending: I32
    | depth: I32
    | limit: I32

//! = Tokens

// The parser reads a virtual semicolon at or past the current statement's limit.
fn past_limit(p: Parser, offset: I32) Bool => p.limit >= 0 and p.pos + offset >= p.limit

fn kind_at(p: Parser, offset: I32) I32 => if past_limit(p, offset) { Tok.Semi.i32() } else { pkind[p.pos + offset] }

fn is(p: Parser, kind: Tok) Bool => kind_at(p, 0) == kind.i32()

fn is_at(p: Parser, offset: I32, kind: Tok) Bool => kind_at(p, offset) == kind.i32()

fn word_id(p: Parser) I32 => if past_limit(p, 0) { -1 } else { tok_word[ptok[p.pos]] }

fn is_kw(p: Parser, kw: Kw) Bool => word_id(p) == kw.i32()

fn is_word(p: Parser) Bool => is(p, Tok.Word)

fn is_keyword_id(id: I32) Bool => id >= 0 and id < Kw.count()

fn at_end(p: Parser) Bool => is(p, Tok.End)

/// Whether the tokens at positions `a` and `b` touch, with nothing between them.
fn adjacent(a: I32, b: I32) Bool => tok_end[ptok[a]] == tok_start[ptok[b]]

/// Identifier-shaped: a lowercase first letter, or `_` and more.
fn shaped_at(p: Parser, offset: I32) Bool {
    if past_limit(p, offset) { return false }
    let at = p.pos + offset
    if pkind[at] != Tok.Word.i32() { return false }
    let t = ptok[at]
    let c = src[tok_start[t]]
    return (c >= 97 and c <= 122) or (c == 95 and tok_end[t] - tok_start[t] > 1)
}

fn shaped(p: Parser) Bool => shaped_at(p, 0)

fn advance(p: Parser) Void { p.pos += 1 }

fn expect(p: Parser, kind: Tok) Void {
    if not is(p, kind) { fail_wanting(p, kind.i32()) }
    p.pos += 1
}

fn expect_kw(p: Parser, kw: Kw) Void {
    if not is_kw(p, kw) { fail_wanting(p, kw_wanted + kw.i32()) }
    p.pos += 1
}

//! = Nodes

/// Where the node about to begin starts on @pending.
fn mark() I32 => parse_pending

fn resize_parse_nodes(size: I32) Void {
    node_kind.resize(size)
    node_first.resize(size)
    node_last.resize(size)
    node_child.resize(size)
    node_next.resize(size)
    node_parent.resize(size)
}

fn start_parse_nodes() I32 {
    let before = node_kind.len()
    parse_nodes = before
    parse_pending = 0
    parse_first = before
    return before
}

/// Append to aligned columns, growing them together only when full.
fn append_parse_node(kind: Node, first: I32, last: I32, child: I32, next: I32, parent: I32) I32 {
    let id = parse_nodes
    if id == node_kind.len() { resize_parse_nodes(id + (id - parse_first) / 2 + 64) }
    node_kind[id] = kind.i32()
    node_first[id] = first
    node_last[id] = last
    node_child[id] = child
    node_next[id] = next
    node_parent[id] = parent
    parse_nodes = id + 1
    if validated_kinds[kind.i32()] == 1 { validate_list.push(id) }
    return id
}

/// Collapse the nodes since `at` into a parent spanning lexer tokens.
fn finish_tokens(kind: Node, at: I32, first: I32, last: I32) I32 {
    let top = parse_pending
    let child = if at < top { pending[at] } else { -1 }
    let id = append_parse_node(kind, first, last, child, -1, -1)
    if at < top {
        let k = at
        while (k + 1 < top) {
            let node = pending[k]
            k += 1
            node_next[node] = pending[k]
            node_parent[node] = id
        }
        let tail = pending[k]
        node_next[tail] = -1
        node_parent[tail] = id
    }
    if at == pending.len() { pending.resize(at + at / 2 + 64) }
    pending[at] = id
    parse_pending = at + 1
    return id
}

/// Translate parser positions when creating a node, so clients can read
/// the lexer-token span directly and no second walk is needed.
fn finish(kind: Node, at: I32, first: I32, last: I32) I32 {
    let start = ptok[first]
    let end_ = if last > first { ptok[last - 1] + 1 } else { start }
    return finish_tokens(kind, at, start, end_)
}

/// A node from `at` up to the cursor.
fn node(p: Parser, kind: Node, at: I32, first: I32) I32 => finish(kind, at, first, p.pos)

/// A node from an existing left operand, after consuming an operator.
fn extend_node(p: Parser, kind: Node, at: I32, left: I32) I32 {
    return finish_tokens(kind, at, node_first[left], ptok[p.pos - 1] + 1)
}

/// A node of the token at the cursor.
fn leaf(p: Parser, kind: Node) I32 {
    let token = ptok[p.pos]
    p.pos += 1
    return finish_tokens(kind, mark(), token, token + 1)
}

/// The mark below `left`, the node on top of the stack, so a node can begin with it.
fn mark_below(left: I32) I32 {
    let below = parse_pending - 1
    if pending[below] != left { fatal }
    return below
}

/// Before an attempt that may be given up (@restore).
fn save(p: Parser) Save => Save { pos: p.pos, nodes: parse_nodes, pending: parse_pending, depth: parse_depth, limit: p.limit }

/// Gives up an attempt: the cursor goes back, and the nodes made since are gone.
fn restore(p: Parser, s: Save) Void {
    p.pos = s.pos
    parse_depth = s.depth
    p.limit = s.limit
    parse_nodes = s.nodes
    for (parse_pending ..< s.pending) |k| { pending[k] = 0 }
    parse_pending = s.pending
    let k = dsl_sites.len()
    while (k > 0 and dsl_sites[k - 1] >= s.nodes) { k -= 1 }
    dsl_sites.resize(k)
    k = validate_list.len()
    while (k > 0 and validate_list[k - 1] >= s.nodes) { k -= 1 }
    validate_list.resize(k)
    forget_directives(s.nodes)
}

/// By Node: 1 for the kinds validation has a rule for (@validate_node's arms).
const vec validated_kinds: U8 = @comptime/\ build_validated_kinds() \/

fn build_validated_kinds() Array[I32] {
    let kinds = Array[I32].new(Node.count(), 0)
    for ([Node.Param_list, Node.Struct_decl, Node.Field_list, Node.Enum_decl, Node.Block, Node.Closure_param_list, Node.Tuple_pattern,
        Node.Capture, Node.Alt_expr, Node.Nullable_type, Node.Tuple_type, Node.Field, Node.Distinct_decl, Node.Yield_expr,
        Node.Defer_expr, Node.Errdefer_expr, Node.Await_expr, Node.Global_decl, Node.Bench_decl, Node.Module_type_param_list]) |k| { kinds[k.i32()] = 1 }
    return kinds
}

/// The nodes made of @validated_kinds, as they are made (@restore drops
/// those it gives up), so validation finds them without walking every tree.
vec validate_list: I32

/// Only the nodes below `nodes` stay (a new program keeps the sealed ones).
fn keep_validate_list(nodes: I32) Void {
    let kept_ = 0
    for (0 ..< validate_list.len()) |k| {
        if validate_list[k] < nodes {
            validate_list[kept_] = validate_list[k]
            kept_ += 1
        }
    }
    validate_list.resize(kept_)
}

//! = Words

fn identifier(p: Parser) I32 {
    if not shaped(p) { fail(p) }
    return leaf(p, Node.Identifier)
}

fn type_ident(p: Parser) I32 {
    if not is_word(p) { fail(p) }
    return leaf(p, Node.Type_ident)
}

/// A type name where no keyword can stand.
fn unreserved_type_ident(p: Parser) I32 {
    if is_keyword_id(word_id(p)) { fail(p) }
    return type_ident(p)
}

/// `identifier` where the word is identifier-shaped, else `type_ident` (both fit here).
fn identifier_or_type(p: Parser) I32 {
    if not is_word(p) { fail(p) }
    return leaf(p, if shaped(p) { Node.Identifier } else { Node.Type_ident })
}

fn string_lit(p: Parser) I32 {
    if not is(p, Tok.String) { fail(p) }
    return leaf(p, Node.String_lit)
}

fn number(p: Parser) I32 {
    if is(p, Tok.Int) { return leaf(p, Node.Int_lit) }
    if is(p, Tok.Float) { return leaf(p, Node.Float_lit) }
    fail(p)
    return -1
}

fn int_lit(p: Parser) I32 {
    if not is(p, Tok.Int) { fail(p) }
    return leaf(p, Node.Int_lit)
}

//! = Source file and items

fn source_file(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    while (not at_end(p)) { item(p) }
    return node(p, Node.Source_file, at, first)
}

/// A top-level declaration, by its first word (`export`'s by its second).
fn item(p: Parser) Void {
    if is(p, Tok.Hash) { directed_fn(p); return }
    let w = word_id(p)
    if w == Kw.Mod.i32() { module_decl(p); return }
    if w == Kw.Using.i32() {
        let previous = begin_statement(p)
        using_decl(p)
        end_statement(p, previous)
        return
    }
    if w == Kw.Tag.i32() or w == Kw.Rec.i32() or w == Kw.Struct.i32() or w == Kw.Enum.i32() { struct_or_enum(p); return }
    if w == Kw.Proto.i32() { proto_decl(p); return }
    if w == Kw.Fn.i32() or w == Kw.Gn.i32() { fn_or_op_decl(p); return }
    if w == Kw.Wn.i32() { wn_decl(p); return }
    if is(p, Tok.Word) and token_is(p.pos, "gp") { gp_decl(p); return }
    if is(p, Tok.Word) and token_is(p.pos, "pipeline") { pipeline_decl(p); return }
    if w == Kw.Let.i32() {
        let previous = begin_statement(p)
        global_decl(p)
        end_statement(p, previous)
        return
    }
    if w == Kw.Mem.i32() or w == Kw.Vec.i32() or w == Kw.Const.i32() {
        let previous = begin_statement(p)
        mem_decl(p)
        end_statement(p, previous)
        return
    }
    if w == Kw.Type.i32() {
        let previous = begin_statement(p)
        distinct_decl(p)
        end_statement(p, previous)
        return
    }
    // `main { … }`: the program, which returns nothing; `lib { fn … }`: what JS calls.
    if w == Kw.Main.i32() and is_at(p, 1, Tok.LBrace) { main_decl(p); return }
    if w == Kw.Html.i32() and is_at(p, 1, Tok.WutuBody) { html_decl(p); return }
    if w == Kw.Lib.i32() and is_at(p, 1, Tok.LBrace) { lib_decl(p); return }
    if w == Kw.Export.i32() {
        let after = tok_word[ptok[p.pos + 1]]
        // (`lib` is `lib`, `main() T` is `main`: hints.utu says so.)
        if after == Kw.Lib.i32() or after == Kw.Main.i32() { fail(p) }
        if after == Kw.Const.i32() or after == Kw.Mem.i32() {
            let previous = begin_statement(p)
            mem_decl(p)
            end_statement(p, previous)
            return
        }
        fail(p)
        return
    }
    if w == Kw.Test.i32() { test_decl(p); return }
    if w == Kw.Bench.i32() { bench_decl(p); return }
    fail(p)
}

/// A declaration inside a `mod`.
fn module_item(p: Parser) Void {
    if is(p, Tok.Hash) { directed_fn(p); return }
    let w = word_id(p)
    if w == Kw.Type.i32() { type_decl(p); return }
    if w == Kw.Tag.i32() or w == Kw.Rec.i32() or w == Kw.Struct.i32() or w == Kw.Enum.i32() { struct_or_enum(p); return }
    if w == Kw.Proto.i32() { proto_decl(p); return }
    if w == Kw.Fn.i32() or w == Kw.Gn.i32() { fn_or_op_decl(p); return }
    if w == Kw.Wn.i32() { wn_decl(p); return }
    if is(p, Tok.Word) and token_is(p.pos, "gp") { gp_decl(p); return }
    if is(p, Tok.Word) and token_is(p.pos, "pipeline") { pipeline_decl(p); return }
    if w == Kw.Let.i32() {
        let previous = begin_statement(p)
        global_decl(p)
        end_statement(p, previous)
        return
    }
    if w == Kw.Test.i32() { test_decl(p); return }
    if w == Kw.Bench.i32() { bench_decl(p); return }
    fail(p)
}

fn module_decl(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    expect_kw(p, Kw.Mod)
    module_name(p)
    if is(p, Tok.LBracket) { module_type_param_list(p) }
    expect(p, Tok.LBrace)
    while (not is(p, Tok.RBrace)) { module_item(p) }
    expect(p, Tok.RBrace)
    return node(p, Node.Module_decl, at, first)
}

fn module_name(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    identifier_or_type(p)
    return node(p, Node.Module_name, at, first)
}

fn module_type_param_list(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    expect(p, Tok.LBracket)
    module_type_param(p)
    while (is(p, Tok.Comma)) {
        advance(p)
        if is(p, Tok.RBracket) { break }
        module_type_param(p)
    }
    expect(p, Tok.RBracket)
    return node(p, Node.Module_type_param_list, at, first)
}

fn module_type_param(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    // `in` and `out` are always variance keywords here, never parameter names.
    if is_kw(p, Kw.In) or is_kw(p, Kw.Out) { advance(p) }
    unreserved_type_ident(p)
    // `T[Ord]`: the protocols T must implement.
    if is(p, Tok.LBracket) { impl_list(p) }
    return node(p, Node.Module_type_param, at, first)
}

fn module_type_arg_list(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    expect(p, Tok.LBracket)
    type_(p)
    while (is(p, Tok.Comma)) {
        advance(p)
        if is(p, Tok.RBracket) { break }
        type_(p)
    }
    expect(p, Tok.RBracket)
    return node(p, Node.Module_type_arg_list, at, first)
}

fn impl_list(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    expect(p, Tok.LBracket)
    if not is(p, Tok.RBracket) {
        impl_name(p)
        while (is(p, Tok.Comma)) {
            advance(p)
            if is(p, Tok.RBracket) { break }
            impl_name(p)
        }
    }
    expect(p, Tok.RBracket)
    return node(p, Node.Impl_list, at, first)
}

/// A protocol in an impl or bound list: `P`, `&`, or `m.P` from module m.
fn impl_name(p: Parser) I32 {
    if not (is_word(p) and is_at(p, 1, Tok.Dot)) { return type_ident_or_promoted(p) }
    let at = mark()
    let first = p.pos
    module_name(p)
    node(p, Node.Module_ref, at, first)
    advance(p)
    type_ident(p)
    return node(p, Node.Qualified_type_ref, at, first)
}

/// `.V` after `M.E` in a path: the variant V of M's enum E. Returns its
/// name node, or -1.
fn variant_step(p: Parser) I32 {
    if not (is(p, Tok.Dot) and is_at(p, 1, Tok.Word)) { return -1 }
    advance(p)
    return type_ident(p)
}

fn type_ident_or_promoted(p: Parser) I32 {
    return if is(p, Tok.Amp) { promoted_type(p) } else { type_ident(p) }
}

fn promoted_type(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    expect(p, Tok.Amp)
    return node(p, Node.Promoted_type, at, first)
}

fn struct_or_enum(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    if is_kw(p, Kw.Tag) or is_kw(p, Kw.Rec) {
        let tags = mark()
        while (is_kw(p, Kw.Tag) or is_kw(p, Kw.Rec)) {
            let tag = mark()
            advance(p)
            node(p, Node.Nom_tag, tag, p.pos - 1)
        }
        node(p, Node.Nom_qualifier, tags, first)
    }
    if is_kw(p, Kw.Struct) { return struct_decl(p, at, first) }
    if is_kw(p, Kw.Enum) { return enum_decl(p, at, first) }
    fail(p)
    return -1
}

fn struct_decl(p: Parser, at: I32, first: I32) I32 {
    advance(p)
    type_ident_or_promoted(p)
    if is(p, Tok.LBracket) { impl_list(p) }
    expect(p, Tok.Colon)
    while (is(p, Tok.Pipe)) {
        advance(p)
        field(p)
    }
    return node(p, Node.Struct_decl, at, first)
}

fn field(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    identifier(p)
    expect(p, Tok.Colon)
    type_(p)
    return node(p, Node.Field, at, first)
}

fn enum_decl(p: Parser, at: I32, first: I32) I32 {
    advance(p)
    if is(p, Tok.LParen) {
        advance(p)
        type_ident(p)
        expect(p, Tok.RParen)
    }
    type_ident_or_promoted(p)
    if is(p, Tok.LBracket) { impl_list(p) }
    expect(p, Tok.Colon)
    while (is(p, Tok.Pipe)) {
        advance(p)
        variant(p)
    }
    return node(p, Node.Enum_decl, at, first)
}

fn variant(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    type_ident(p)
    if is(p, Tok.LBrace) {
        advance(p)
        if not is(p, Tok.RBrace) { field_list(p) }
        expect(p, Tok.RBrace)
    } else if is(p, Tok.Eq) {
        advance(p)
        if is(p, Tok.Minus) { advance(p) }
        int_lit(p)
    }
    return node(p, Node.Variant, at, first)
}

fn field_list(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    field(p)
    while (is(p, Tok.Comma)) {
        advance(p)
        if is(p, Tok.RBrace) { break }
        field(p)
    }
    return node(p, Node.Field_list, at, first)
}

fn proto_decl(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    advance(p)
    type_ident_or_promoted(p)
    expect(p, Tok.Colon)
    while (is(p, Tok.Pipe)) {
        advance(p)
        proto_member(p)
    }
    return node(p, Node.Proto_decl, at, first)
}

fn proto_member(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    let member = mark()
    if is_kw(p, Kw.Get) {
        advance(p)
        let both_ = is_kw(p, Kw.Set)
        if both_ { advance(p) }
        identifier(p)
        expect(p, Tok.Colon)
        type_(p)
        node(p, if both_ { Node.Proto_get_setter } else { Node.Proto_getter }, member, first)
    } else if is_kw(p, Kw.Set) {
        advance(p)
        identifier(p)
        expect(p, Tok.Colon)
        type_(p)
        node(p, Node.Proto_setter, member, first)
    } else {
        identifier(p)
        expect(p, Tok.LParen)
        if not is(p, Tok.RParen) { type_list(p) }
        expect(p, Tok.RParen)
        return_type(p)
        node(p, Node.Proto_method, member, first)
    }
    return node(p, Node.Proto_member, at, first)
}

fn fn_or_op_decl(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    // `gn g(…) T { … }`: a generator of Ts, as `fn g(…) yield T` is.
    let generator = is_kw(p, Kw.Gn)
    advance(p)
    // `fn T:op |a, b| R { … }` is an operator; `fn T.name(…)` and `fn name(…)` are functions.
    if not shaped(p) or is(p, Tok.Amp) {
        let s = save(p)
        type_ident_or_promoted(p)
        if is(p, Tok.Colon) {
            advance(p)
            identifier(p)
            capture(p)
            return_type(p)
            function_body(p)
            return node(p, Node.Op_decl, at, first)
        }
        restore(p, s)
    }
    fn_name(p)
    if is(p, Tok.Pipe) { self_param(p) }
    expect(p, Tok.LParen)
    if not is(p, Tok.RParen) { param_list(p) }
    expect(p, Tok.RParen)
    if generator { yields(p) } else { return_type(p) }
    function_body(p)
    return node(p, Node.Fn_decl, at, first)
}

/// Directives, by the order they are made: each one's Directive node (its
/// name, and its argument when written: an Int_lit, after a `-` when
/// negative), and the function it is before (a Fn_decl or Op_decl). They are
/// out of the tree (no walk of it meets one); each one's parent is its
/// function. validate.utu checks them, check.utu reads them.
vec dir_node: I32
vec dir_fn: I32

/// `#inline fn …` or `#workgroup(64) gp …`: directives, then the function they are for.
fn directed_fn(p: Parser) Void {
    let from = dir_node.len()
    while (is(p, Tok.Hash)) { directive(p) }
    let f = -1
    if is(p, Tok.Word) and token_is(p.pos, "gp") {
        f = gp_decl(p)
    } else if is_kw(p, Kw.Fn) or is_kw(p, Kw.Gn) {
        f = fn_or_op_decl(p)
    } else {
        fail_wanting(p, kw_wanted + Kw.Fn.i32())
    }
    for (from ..< dir_node.len()) |k| {
        dir_fn[k] = f
        node_parent[dir_node[k]] = f
    }
}

/// `#luge` above a `while`, `for`, or `loop match`: directives, then the loop.
fn directed_loop(p: Parser) I32 {
    let from = dir_node.len()
    while (is(p, Tok.Hash)) { directive(p) }
    let lp = -1
    if is_kw(p, Kw.While) {
        lp = while_expr(p)
    } else if is_kw(p, Kw.For) {
        lp = for_expr(p)
    } else if is_kw(p, Kw.Loop) {
        let at = mark()
        let first = p.pos
        advance(p)
        expect_kw(p, Kw.Match)
        lp = match_expr(p, Node.Loop_match_expr, at, first)
    } else {
        fail_wanting(p, kw_wanted + Kw.While.i32())
    }
    for (from ..< dir_node.len()) |k| {
        dir_fn[k] = lp
        node_parent[dir_node[k]] = lp
    }
    return lp
}

/// `#name` or `#name(N, ...)`, `#` and the name written together.
fn directive(p: Parser) Void {
    let at = mark()
    let first = p.pos
    advance(p)
    if not (is_word(p) and adjacent(p.pos - 1, p.pos)) { fail(p) }
    leaf(p, Node.Identifier)
    if is(p, Tok.LParen) {
        advance(p)
        if is(p, Tok.Minus) { advance(p) }
        if not is(p, Tok.Int) { fail_wanting(p, Tok.Int.i32()) }
        int_lit(p)
        while (is(p, Tok.Comma)) {
            advance(p)
            if is(p, Tok.Minus) { advance(p) }
            if not is(p, Tok.Int) { fail_wanting(p, Tok.Int.i32()) }
            int_lit(p)
        }
        expect(p, Tok.RParen)
    }
    let d = node(p, Node.Directive, at, first)
    // Taken off the stack: no node takes it as a child.
    parse_pending = at
    dir_node.push(d)
    dir_fn.push(-1)
    if not line_break_before(p.pos) { fail(p) }
}

/// Forget the directives of nodes from `nodes` on (given up, or not kept).
fn forget_directives(nodes: I32) Void {
    let k = dir_node.len()
    while (k > 0 and dir_node[k - 1] >= nodes) { k -= 1 }
    dir_node.resize(k)
    dir_fn.resize(k)
}

/// A `gp` compute kernel (`gp name |i| (rw x: Array[F32]) { ... }`) or helper (`gp f(v: F32) F32 { ... }`).
fn gp_decl(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    advance(p)
    fn_name(p)
    let has_grid = is(p, Tok.Pipe)
    if has_grid { capture(p) }
    expect(p, Tok.LParen)
    if not is(p, Tok.RParen) { gp_param_list(p) }
    expect(p, Tok.RParen)
    if not has_grid or (not is(p, Tok.LBrace) and not is(p, Tok.FatArrow)) { return_type(p) }
    function_body(p)
    return node(p, Node.Gp_decl, at, first)
}

/// A `pipeline` compute pipeline (`pipeline step(rw ps: Array[Particle], ...) Promise[Void] { ... }`).
fn pipeline_decl(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    advance(p)
    fn_name(p)
    expect(p, Tok.LParen)
    if not is(p, Tok.RParen) { gp_param_list(p) }
    expect(p, Tok.RParen)
    return_type(p)
    block(p)
    return node(p, Node.Pipeline_decl, at, first)
}

fn gp_param_list(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    gp_param(p)
    while (is(p, Tok.Comma)) {
        advance(p)
        if is(p, Tok.RParen) { break }
        gp_param(p)
    }
    return node(p, Node.Param_list, at, first)
}

fn gp_param(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    if is(p, Tok.Word) and is_at(p, 1, Tok.Word)
        and (token_is(p.pos, "ro") or token_is(p.pos, "rw") or is_kw(p, Kw.Out) or token_is(p.pos, "uniform")) {
        advance(p)
    }
    identifier(p)
    expect(p, Tok.Colon)
    type_(p)
    return node(p, Node.Param, at, first)
}

/// A Wutu function's body is opaque until the Wutu expansion runs.
fn wn_decl(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    expect_kw(p, Kw.Wn)
    fn_name(p)
    if is(p, Tok.Pipe) { self_param(p) }
    expect(p, Tok.LParen)
    if not is(p, Tok.RParen) { param_list(p) }
    expect(p, Tok.RParen)
    if not is(p, Tok.WutuBody) { fail(p) }
    leaf(p, Node.Wutu_body)
    return node(p, Node.Fn_decl, at, first)
}

/// A `gn`'s result `T`: the type it yields, as `yield T` is.
fn yields(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    let inner = mark()
    type_(p)
    node(p, Node.Yield_type, inner, first)
    return node(p, Node.Return_type, at, first)
}

/// A function's body: a block, or `=> expr`, a block of that one
/// expression, which ends as a statement does.
fn function_body(p: Parser) I32 {
    if not is(p, Tok.FatArrow) { return block(p) }
    let at = mark()
    let first = p.pos
    advance(p)
    let previous = begin_statement(p)
    expression(p)
    end_statement(p, previous)
    return node(p, Node.Block, at, first)
}

fn fn_name(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    if shaped(p) {
        identifier(p)
    } else if is(p, Tok.Amp) and is_at(p, 1, Tok.LParen) {
        // `fn &(…)`: the module's promoted function, called as `M[A](…)`.
        promoted_type(p)
    } else {
        type_ident_or_promoted(p)
        if is(p, Tok.LBracket) { module_type_arg_list(p) }
        expect(p, Tok.Dot)
        identifier(p)
    }
    return node(p, Node.Fn_name, at, first)
}

fn self_param(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    expect(p, Tok.Pipe)
    identifier(p)
    expect(p, Tok.Pipe)
    return node(p, Node.Self_param, at, first)
}

fn param_list(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    param(p)
    while (is(p, Tok.Comma)) {
        advance(p)
        if is(p, Tok.RParen) { break }
        param(p)
    }
    return node(p, Node.Param_list, at, first)
}

fn param(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    identifier(p)
    expect(p, Tok.Colon)
    type_(p)
    return node(p, Node.Param, at, first)
}

fn return_type(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    // (`void` is `Void`, and `fn g() yield T` is `gn g() T`: hints.utu says so.)
    if is_kw(p, Kw.Void) or is_kw(p, Kw.Yield) { fail(p) }
    type_(p)
    return node(p, Node.Return_type, at, first)
}

fn type_list(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    type_(p)
    while (is(p, Tok.Comma)) {
        advance(p)
        type_(p)
    }
    return node(p, Node.Type_list, at, first)
}

fn global_decl(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    advance(p)
    identifier(p)
    expect(p, Tok.Colon)
    type_(p)
    expect(p, Tok.Eq)
    expression(p)
    return node(p, Node.Global_decl, at, first)
}

fn mem_decl(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    let exported = is_kw(p, Kw.Export)
    if exported { advance(p) }
    if is_kw(p, Kw.Const) { advance(p) }
    // A vec is never exported: the host cannot see it.
    if not exported and is_kw(p, Kw.Vec) { advance(p) } else { expect_kw(p, Kw.Mem) }
    identifier(p)
    expect(p, Tok.Colon)
    type_ident(p)
    if is(p, Tok.Eq) {
        advance(p)
        expression(p)
    }
    return node(p, Node.Mem_decl, at, first)
}

fn distinct_decl(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    advance(p)
    type_ident(p)
    expect(p, Tok.Eq)
    expect_kw(p, Kw.Distinct)
    type_ident(p)
    return node(p, Node.Distinct_decl, at, first)
}

fn type_decl(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    advance(p)
    type_ident_or_promoted(p)
    expect(p, Tok.Eq)
    dsl_expr(p)
    return node(p, Node.Type_decl, at, first)
}

/// Whether the token at position i spells `text`.
fn token_is(i: I32, text: Str) Bool {
    let t = ptok[i]
    let n = tok_end[t] - tok_start[t]
    if n != text.len() { return false }
    for (0 ..< n) |k| { if src[tok_start[t] + k] != text.get(k) { return false } }
    return true
}

fn using_decl(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    advance(p)
    module_name(p)
    if is(p, Tok.LBracket) { module_type_arg_list(p) }
    if is(p, Tok.Pipe) {
        let captured = mark()
        let start = p.pos
        advance(p)
        module_name(p)
        expect(p, Tok.Pipe)
        node(p, Node.Captured_module_name, captured, start)
    }
    // `lazy`: the module builds as its own chunk (a word here, not a keyword).
    if is(p, Tok.Word) and token_is(p.pos, sms(Sml.Lazy)) { advance(p) }
    if is_kw(p, Kw.From) {
        advance(p)
        if is(p, Tok.String) {
            string_lit(p)
        } else {
            // `std:Str`: a lowercase word, `:`, and a word starting with a letter, touching.
            if not (shaped(p) and src[tok_start[ptok[p.pos]]] != 95 and is_at(p, 1, Tok.Colon) and is_at(p, 2, Tok.Word)
                    and src[tok_start[ptok[p.pos + 2]]] != 95 and adjacent(p.pos, p.pos + 1) and adjacent(p.pos + 1, p.pos + 2)) {
                fail(p)
            }
            let path = mark()
            p.pos += 3
            finish(Node.Platform_path, path, p.pos - 3, p.pos)
        }
    }
    return node(p, Node.Using_decl, at, first)
}

/// `main { … }`, as `main() Void { … }` was.
fn main_decl(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    advance(p)
    block(p)
    return node(p, Node.Export_main_decl, at, first)
}

fn html_decl(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    expect_kw(p, Kw.Html)
    if not is(p, Tok.WutuBody) { fail(p) }
    leaf(p, Node.Wutu_body)
    return node(p, Node.Export_html_decl, at, first)
}

/// `lib { fn … }`, as `lib { … }` was.
fn lib_decl(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    advance(p)
    expect(p, Tok.LBrace)
    while (is_kw(p, Kw.Fn) or is_kw(p, Kw.Gn) or is_kw(p, Kw.Wn) or is(p, Tok.Hash) or (is(p, Tok.Word) and token_is(p.pos, "pipeline"))) {
        if is(p, Tok.Hash) { directed_fn(p) }
        else if is_kw(p, Kw.Wn) { wn_decl(p) }
        else if is(p, Tok.Word) and token_is(p.pos, "pipeline") { pipeline_decl(p) }
        else { fn_or_op_decl(p) }
    }
    expect(p, Tok.RBrace)
    return node(p, Node.Export_lib_decl, at, first)
}

fn test_decl(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    advance(p)
    string_lit(p)
    block(p)
    return node(p, Node.Test_decl, at, first)
}

fn bench_decl(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    advance(p)
    string_lit(p)
    expect(p, Tok.LBrace)
    while (not is_kw(p, Kw.Measure)) { statement(p) }
    let measure = mark()
    let start = p.pos
    advance(p)
    block(p)
    node(p, Node.Measure_decl, measure, start)
    expect(p, Tok.RBrace)
    return node(p, Node.Bench_decl, at, first)
}

//! = Types

fn type_(p: Parser) I32 {
    deeper(p)
    let made = type_at(p)
    parse_depth -= 1
    return made
}

fn type_at(p: Parser) I32 {
    if is(p, Tok.Question) {
        let at = mark()
        let first = p.pos
        advance(p)
        base_type(p)
        return node(p, Node.Nullable_type, at, first)
    }
    return base_type(p)
}

fn base_type(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    if is(p, Tok.Amp) { return promoted_type(p) }
    if is(p, Tok.Dollar) {
        advance(p)
        type_ident(p)
        return node(p, Node.Type_binder, at, first)
    }
    if is(p, Tok.LParen) {
        advance(p)
        type_(p)
        expect(p, Tok.RParen)
        return node(p, Node.Paren_type, at, first)
    }
    if is(p, Tok.Dot) {
        advance(p)
        expect(p, Tok.LBrace)
        type_(p)
        while (is(p, Tok.Comma)) {
            advance(p)
            if is(p, Tok.RBrace) { break }
            type_(p)
        }
        expect(p, Tok.RBrace)
        return node(p, Node.Tuple_type, at, first)
    }
    // Where a type begins, `fun` and `cl` are always keywords.
    if is_kw(p, Kw.Fun) or is_kw(p, Kw.Cl) {
        let closure = is_kw(p, Kw.Cl)
        advance(p)
        expect(p, Tok.LParen)
        if not is(p, Tok.RParen) { type_list(p) }
        expect(p, Tok.RParen)
        return_type(p)
        return node(p, if closure { Node.Closure_type } else { Node.Func_type }, at, first)
    }
    ref_type(p)
    return node(p, Node.Ref_type, at, first)
}

/// The inside of a `ref_type`: a type name, `M.T`, `M[A]`, `M[A].T`, or
/// a variant of a mod's enum, `M.E.V`.
fn ref_type(p: Parser) I32 {
    if not is_word(p) { fail(p) }
    if not is_at(p, 1, Tok.LBracket) and not is_at(p, 1, Tok.Dot) { return type_ident(p) }
    let at = mark()
    let first = p.pos
    module_name(p)
    if is(p, Tok.LBracket) {
        module_type_arg_list(p)
        let instantiated = node(p, Node.Instantiated_module_ref, at, first)
        if is(p, Tok.Dot) {
            advance(p)
            type_ident(p)
            variant_step(p)
            return node(p, Node.Qualified_type_ref, at, first)
        }
        return instantiated
    }
    node(p, Node.Module_ref, at, first)
    advance(p)
    type_ident(p)
    variant_step(p)
    return node(p, Node.Qualified_type_ref, at, first)
}

//! = Blocks

fn block(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    expect(p, Tok.LBrace)
    while (not is(p, Tok.RBrace)) { statement(p) }
    advance(p)
    return node(p, Node.Block, at, first)
}

/// A block's statement: an expression, ended as @statement_end finds (a
/// `;` after it is read, and does nothing more).
fn statement(p: Parser) Void {
    // (A `;` alone: nothing. A written one: the end of a statement read as one
    // is not passed.)
    if written_semi(p) {
        advance(p)
        return
    }
    let previous = begin_statement(p)
    expression(p)
    end_statement(p, previous)
}

/// Install the virtual semicolon and return the enclosing statement's limit.
fn begin_statement(p: Parser) I32 {
    let previous = p.limit
    p.limit = statement_end(p)
    return previous
}

/// Restore the enclosing boundary before inspecting the statement's end.
fn end_statement(p: Parser, previous: I32) Void {
    let end_ = p.limit
    p.limit = previous
    if p.pos < end_ { fail_wanting(p, Tok.Semi.i32()) }
    if written_semi(p) { advance(p) }
}

/// Whether a `;` is written at the cursor (not the end of a statement, read as one).
fn written_semi(p: Parser) Bool => pkind[p.pos] == Tok.Semi.i32()

/// Where the statement at the cursor ends: at a `;`, at the `}` (or `)`,
/// `]`) closing what it is in, at the end, or at a line break outside its
/// brackets, unless the line goes on: after what cannot end it (`=`, `+`,
/// `,`, `and`), or into a line that only continues (`.f()`, `+ x`, `and`,
/// `else`, `catch`, a using's `from`, a stage `map |x|`). A line beginning `-`, `(`, `[`, or
/// `&` is a new statement.
fn statement_end(p: Parser) I32 {
    let i = p.pos
    // Directive lines (`#luge`) continue onto the loop they decorate.
    while (pkind[i] == Tok.Hash.i32()) {
        i += 1
        while (pkind[i] != Tok.End.i32() and not line_break_before(i)) { i += 1 }
    }
    let start = i
    let depth = 0
    while (true) {
        let k = pkind[i]
        if k == Tok.End.i32() { return i }
        if depth == 0 {
            if k == Tok.Semi.i32() or k == Tok.RBrace.i32() or k == Tok.RParen.i32() or k == Tok.RBracket.i32() { return i }
            if i > start and line_break_before(i) and not continues_line(i) { return i }
        }
        let flags = parse_flags[k]
        if (flags & opens_delimiter) != 0 {
            if depth == 0 {
                // Nothing inside an opener can end this statement.
                i = pjump[i]
                continue
            }
            depth += 1
        } else if (flags & closes_delimiter) != 0 {
            depth -= 1
        }
        i += 1
    }
    return i
}

// Token properties used by the statement scanner and the expression parser.
let opens_delimiter: I32 = 1
let closes_delimiter: I32 = 2
let continues_from_line: I32 = 4
let continues_to_line: I32 = 8
let assignment_token: I32 = 16
let stops_expression: I32 = 32

/// Token rows first, then keyword rows for the properties that need a word.
const vec parse_flags: U8 = @comptime/\ build_parse_flags() \/

fn build_parse_flags() Array[I32] {
    let flags = Array[I32].new(Tok.count() + Kw.count(), 0)
    for ([Tok.LParen, Tok.LBracket, Tok.LBrace, Tok.TemplateHead]) |k| { flags[k.i32()] |= opens_delimiter }
    for ([Tok.RParen, Tok.RBracket, Tok.RBrace, Tok.TemplateTail]) |k| { flags[k.i32()] |= closes_delimiter }
    for ([Tok.QuestionDot, Tok.Plus, Tok.Star, Tok.Slash, Tok.Percent, Tok.Caret, Tok.Pipe, Tok.EqEq,
            Tok.BangEq, Tok.Lt, Tok.Gt, Tok.LtEq, Tok.GtEq, Tok.Shl, Tok.Shr, Tok.Shr3, Tok.LBrace]) |k| {
        flags[k.i32()] |= continues_from_line
    }
    for ([Tok.Eq, Tok.PlusEq, Tok.MinusEq, Tok.StarEq, Tok.SlashEq, Tok.PercentEq, Tok.PipeEq, Tok.AmpEq,
            Tok.CaretEq, Tok.ShlEq, Tok.ShrEq, Tok.Shr3Eq]) |k| {
        flags[k.i32()] |= assignment_token | continues_to_line
    }
    for ([Tok.Plus, Tok.Minus, Tok.Star, Tok.Slash, Tok.Percent, Tok.Caret, Tok.Amp, Tok.EqEq, Tok.BangEq,
            Tok.Lt, Tok.Gt, Tok.LtEq, Tok.GtEq, Tok.Shl, Tok.Shr, Tok.Shr3, Tok.Dot, Tok.QuestionDot,
            Tok.Comma, Tok.Colon, Tok.FatArrow, Tok.TildeArrow, Tok.DotDotLt, Tok.DotDotDot]) |k| {
        flags[k.i32()] |= continues_to_line
    }
    // A pipe can close a capture or an alias, and does not force continuation.
    for ([Tok.Semi, Tok.RParen, Tok.Comma, Tok.RBrace, Tok.LBrace, Tok.RBracket, Tok.Colon, Tok.FatArrow, Tok.End]) |k| {
        flags[k.i32()] |= stops_expression
    }
    for ([Kw.And, Kw.Or, Kw.Xor, Kw.Orelse, Kw.Else, Kw.Catch]) |w| {
        flags[Tok.count() + w.i32()] |= continues_from_line | continues_to_line
    }
    for ([Kw.Not, Kw.Await, Kw.New, Kw.Let, Kw.If, Kw.Match, Kw.Alt, Kw.For, Kw.While, Kw.Try, Kw.Promote,
            Kw.Defer, Kw.Errdefer, Kw.Yield, Kw.Assert, Kw.Loop]) |w| {
        flags[Tok.count() + w.i32()] |= continues_to_line
    }
    return flags
}

fn parse_word_flags(word: I32) I32 {
    if not is_keyword_id(word) { return 0 }
    return parse_flags[Tok.count() + word]
}

/// Whether a line ends between the tokens at positions `i - 1` and `i`.
fn line_break_before(i: I32) Bool {
    let prev = ptok[i - 1]
    // (A `\\` line's token holds its line's end.)
    if tok_kind[prev] == Tok.MultilineLine.i32() { return true }
    for (tok_end[prev] ..< tok_start[ptok[i]]) |b| { if src[b] == 10 { return true } }
    return false
}

/// Whether the statement goes on across the line break before position `i`.
fn continues_line(i: I32) Bool {
    let k = pkind[i]
    let prev = pkind[i - 1]
    if k == Tok.MultilineLine.i32() and prev == Tok.MultilineLine.i32() { return true }
    let previous = if prev == Tok.Word.i32() { parse_word_flags(tok_word[ptok[i - 1]]) } else { parse_flags[prev] }
    if (previous & continues_to_line) != 0 { return true }
    // `.f()` goes on; `.{a, b}` is a tuple.
    if k == Tok.Dot.i32() { return pkind[i + 1] != Tok.LBrace.i32() }
    if (parse_flags[k] & continues_from_line) != 0 { return true }
    if k != Tok.Word.i32() { return false }
    let w = tok_word[ptok[i]]
    if (parse_word_flags(w) & continues_from_line) != 0 { return true }
    // `from` in `using … from`; elsewhere a name.
    if w == Kw.From.i32() { return using_ahead(i) }
    // A stage with its capture, `map |x|`, `fold(0) |a, x|`, or `collect(T)`
    // (`sum`, `fold(x)` alone are a name, a call).
    if w < Kw.Map.i32() or w > Kw.Count.i32() { return false }
    let next = pkind[i + 1]
    if next == Tok.Pipe.i32() { return true }
    if next != Tok.LParen.i32() { return false }
    if w == Kw.Collect.i32() { return true }
    let j = i + 2
    let depth = 1
    while (depth > 0 and pkind[j] != Tok.End.i32()) {
        let k = pkind[j]
        if k == Tok.LParen.i32() { depth += 1 } else if k == Tok.RParen.i32() { depth -= 1 }
        j += 1
    }
    return pkind[j] == Tok.Pipe.i32()
}

/// Whether the statement the token at position `i` is in begins `using`.
fn using_ahead(i: I32) Bool {
    let j = i - 1
    while (j > 0 and not line_break_before(j)) { j -= 1 }
    return tok_word[ptok[j]] == Kw.Using.i32()
}

fn capture_name(p: Parser) I32 {
    if is(p, Tok.Word) and token_is(p.pos, "_") { return leaf(p, Node.Identifier) }
    return identifier(p)
}

fn capture(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    expect(p, Tok.Pipe)
    capture_name(p)
    while (is(p, Tok.Comma)) {
        advance(p)
        capture_name(p)
    }
    expect(p, Tok.Pipe)
    return node(p, Node.Capture, at, first)
}

//! = Expressions

/// An expression of any precedence.
fn expression(p: Parser) I32 => expr(p, -1000, true)

/// An expression whose operators have precedence above `min`, or equal to it
/// when `or_equal` (the rule this operand belongs to is right-associative).
fn expr(p: Parser, min: I32, or_equal: Bool) I32 {
    deeper(p)
    return extend(p, prefix(p), min, or_equal)
}

/// `left` and the operations after it, as `expr` reads them; one `deeper` ends.
fn extend(p: Parser, left: I32, min: I32, or_equal: Bool) I32 {
    while (true) {
        let next = infix(p, left, min, or_equal)
        if next < 0 {
            parse_depth -= 1
            return left
        }
        left = next
    }
    return left
}

fn binds(precedence: I32, min: I32, or_equal: Bool) Bool {
    return precedence > min or (precedence == min and or_equal)
}

/// The precedence of the binary operator at the cursor (a token or a
/// keyword), or -1 if none. `^` (12) is the one right-associative.
fn binary_precedence(kind: I32, word: I32) I32 {
    return match Tok(kind) {
        Tok.Caret => 12,
        Tok.Star => 11,
        Tok.Slash => 11,
        Tok.Percent => 11,
        Tok.Plus => 10,
        Tok.Minus => 10,
        Tok.Shl => 9,
        Tok.Shr => 9,
        Tok.Shr3 => 9,
        Tok.Amp => 8,
        Tok.Pipe => 6,
        Tok.EqEq => 5,
        Tok.BangEq => 5,
        Tok.Lt => 5,
        Tok.Gt => 5,
        Tok.LtEq => 5,
        Tok.GtEq => 5,
        ~> if word == Kw.And.i32() { 4 } else if word == Kw.Xor.i32() { 3 } else if word == Kw.Or.i32() { 2 } else { -1 },
    }
}

/// The form of an iterator keyword: 0 capture, 1 param-capture, 2 param,
/// 3 element-capture, 4 element, 5 element-key-capture, 6 element-param,
/// 7 none; -1 when the word is not one.
fn iterator_form(w: I32) I32 {
    if w >= Kw.Map.i32() and w <= Kw.Bisect.i32() { return 0 }
    if w >= Kw.Fold.i32() and w <= Kw.Zip.i32() { return 1 }
    if w >= Kw.Skip.i32() and w <= Kw.Repeat.i32() { return 2 }
    if w >= Kw.Sort.i32() and w <= Kw.Partition.i32() { return 3 }
    if w == Kw.Collect.i32() { return 4 }
    if w == Kw.Group_by.i32() or w == Kw.Distinct_by.i32() { return 5 }
    if w == Kw.Batched.i32() or w == Kw.Windows.i32() { return 6 }
    if w >= Kw.Sum.i32() and w <= Kw.Count.i32() { return 7 }
    return -1
}

/// Extend `left` by one postfix or infix operation, or return -1.
fn infix(p: Parser, left: I32, min: I32, or_equal: Bool) I32 {
    let k = kind_at(p, 0)
    let flags = parse_flags[k]
    if (flags & stops_expression) != 0 { return -1 }
    let w = word_id(p)
    // Postfix: calls, fields, indexes (precedence 14).
    if binds(14, min, or_equal) {
        if k == Tok.LParen.i32() {
            let at = mark_below(left)
            advance(p)
            arg_list_or_none(p)
            expect(p, Tok.RParen)
            let call = extend_node(p, Node.Call_expr, at, left)
            if is(p, Tok.Word) and is_at(p, 1, Tok.LParen) and token_is(p.pos, "over") {
                let oat = mark_below(call)
                advance(p)
                advance(p)
                arg_list_or_none(p)
                expect(p, Tok.RParen)
                return extend_node(p, Node.Over_expr, oat, call)
            }
            return call
        }
        if k == Tok.Dot.i32() or k == Tok.QuestionDot.i32() {
            let at = mark_below(left)
            advance(p)
            identifier_or_type(p)
            return extend_node(p, if k == Tok.Dot.i32() { Node.Field_expr } else { Node.Optional_field_expr }, at, left)
        }
        if k == Tok.LBracket.i32() {
            let at = mark_below(left)
            advance(p)
            expression(p)
            if is(p, Tok.Comma) {
                advance(p)
                expression(p)
                expect(p, Tok.RBracket)
                return extend_node(p, Node.Slice_expr, at, left)
            }
            expect(p, Tok.RBracket)
            return extend_node(p, Node.Index_expr, at, left)
        }
    }
    // Compound assignment keywords are one token: `x and= y`.
    if (w == Kw.And.i32() or w == Kw.Or.i32() or w == Kw.Xor.i32()) and is_at(p, 1, Tok.Eq) and adjacent(p.pos, p.pos + 1) {
        return assignment(p, left, 2)
    }
    if (flags & assignment_token) != 0 { return assignment(p, left, 1) }
    let precedence = binary_precedence(k, w)
    if precedence >= 0 {
        if not binds(precedence, min, or_equal) { return -1 }
        let at = mark_below(left)
        advance(p)
        expr(p, precedence, precedence == 12)
        return extend_node(p, Node.Binary_expr, at, left)
    }
    let form = iterator_form(w)
    if form >= 0 {
        if not binds(1, min, or_equal) { return -1 }
        return iterator(p, left, form)
    }
    if w == Kw.Orelse.i32() {
        if not binds(1, min, or_equal) { return -1 }
        let at = mark_below(left)
        advance(p)
        expr(p, 1, false)
        return extend_node(p, Node.Else_expr, at, left)
    }
    return -1
}

/// An assignment to `left`, whatever the surrounding precedence: tree-sitter
/// shifts the operator onto an assignable target before reducing it into an
/// enclosing expression, so `a + b = c` is `a + (b = c)`.
fn assignment(p: Parser, left: I32, operator_tokens: I32) I32 {
    let target = node_kind[left]
    let assignable = target == Node.Identifier.i32() or target == Node.Field_expr.i32()
        or target == Node.Optional_field_expr.i32() or target == Node.Index_expr.i32()
        or (target == Node.Type_member_expr.i32() and (node_kind[node_child[left]] == Node.Type_ident.i32() or node_kind[node_child[left]] == Node.Instantiated_module_ref.i32()))
    if not assignable { return -1 }
    let at = mark_below(left)
    p.pos += operator_tokens
    expr(p, 0, true)
    return extend_node(p, Node.Assign_expr, at, left)
}

fn arg_list_or_none(p: Parser) Void {
    if is(p, Tok.RParen) { return }
    let at = mark()
    let first = p.pos
    expression(p)
    while (is(p, Tok.Comma)) {
        advance(p)
        if is(p, Tok.RParen) { break }
        expression(p)
    }
    node(p, Node.Arg_list, at, first)
}

fn iterator(p: Parser, left: I32, form: I32) I32 {
    let at = mark_below(left)
    advance(p)
    if form == 1 or form == 2 {
        expect(p, Tok.LParen)
        expression(p)
        expect(p, Tok.RParen)
    } else if form == 3 or form == 4 {
        expect(p, Tok.LParen)
        type_(p)
        expect(p, Tok.RParen)
    } else if form == 5 {
        expect(p, Tok.LParen)
        type_(p)
        expect(p, Tok.Comma)
        type_(p)
        expect(p, Tok.RParen)
    } else if form == 6 {
        expect(p, Tok.LParen)
        type_(p)
        expect(p, Tok.Comma)
        expression(p)
        expect(p, Tok.RParen)
    }
    if form == 0 or form == 1 or form == 3 or form == 5 {
        capture(p)
        block(p)
    }
    return extend_node(p, Node.Iterator_expr, at, left)
}

/// How deeply the parse is nested (expressions, types, `else if`s), and the
/// most it has been and the token where: a program nested deeper than the
/// compiler's stack bears is reported there (see src/selfhost/compiler.js).
let parse_depth: I32 = 0
let parse_deepest: I32 = 0
let parse_deepest_token: I32 = -1

fn deeper(p: Parser) Void {
    parse_depth += 1
    if parse_depth > parse_deepest {
        parse_deepest = parse_depth
        parse_deepest_token = ptok[p.pos]
    }
}

fn prefix(p: Parser) I32 {
    if at_end(p) { fail(p) }
    let at = mark()
    let first = p.pos
    if is_word(p) {
        if is_expression_keyword(word_id(p)) { return keyword_expression(p) }
        return word_expression(p)
    }
    if is(p, Tok.Int) or is(p, Tok.Float) {
        number(p)
        return node(p, Node.Literal, at, first)
    }
    if is(p, Tok.String) {
        string_lit(p)
        return node(p, Node.Literal, at, first)
    }
    if is(p, Tok.TemplateFull) or is(p, Tok.TemplateHead) { return template_string(p) }
    if is(p, Tok.MultilineLine) {
        let lines = mark()
        while (is(p, Tok.MultilineLine)) { leaf(p, Node.Multiline_string_line) }
        node(p, Node.Multiline_string_lit, lines, first)
        return node(p, Node.Literal, at, first)
    }
    if is(p, Tok.Minus) or is(p, Tok.Tilde) {
        advance(p)
        node(p, Node.Unary_op, at, first)
        expr(p, 13, true)
        return node(p, Node.Unary_expr, at, first)
    }
    if is(p, Tok.LParen) { return paren_or_range(p) }
    if is(p, Tok.LBracket) { return array_expr(p) }
    if is(p, Tok.Dot) { return tuple_expr(p) }
    if is(p, Tok.LBrace) {
        block(p)
        return node(p, Node.Block_expr, at, first)
    }
    if is(p, Tok.Amp) {
        promoted_type(p)
        field_inits(p)
        return node(p, Node.Implicit_struct_init, at, first)
    }
    if is(p, Tok.At) { return dsl_expr(p) }
    if is(p, Tok.Hash) { return directed_loop(p) }
    fail(p)
    return -1
}

/// Keywords that begin an expression; elsewhere these words are identifiers.
/// (Keywords are the first words interned: any other is past them.)
fn is_expression_keyword(w: I32) Bool {
    return w < Kw.count() and (w == Kw.If.i32() or w == Kw.Match.i32() or w == Kw.Loop.i32() or w == Kw.Alt.i32()
        or w == Kw.Promote.i32() or w == Kw.Try.i32() or w == Kw.For.i32() or w == Kw.While.i32()
        or w == Kw.Break.i32() or w == Kw.Continue.i32() or w == Kw.Defer.i32() or w == Kw.Errdefer.i32()
        or w == Kw.Yield.i32() or w == Kw.Return.i32() or w == Kw.Let.i32() or w == Kw.Cl.i32() or w == Kw.Fatal.i32()
        or w == Kw.Prune.i32() or w == Kw.New.i32() or w == Kw.Await.i32() or w == Kw.Assert.i32()
        or w == Kw.Not.i32() or w == Kw.True.i32() or w == Kw.False.i32() or w == Kw.Null.i32())
}

fn keyword_expression(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    let w = word_id(p)
    if w == Kw.True.i32() or w == Kw.False.i32() or w == Kw.Null.i32() {
        advance(p)
        return node(p, Node.Literal, at, first)
    }
    if w == Kw.Not.i32() {
        advance(p)
        node(p, Node.Unary_op, at, first)
        expr(p, 13, true)
        return node(p, Node.Unary_expr, at, first)
    }
    if w == Kw.Await.i32() {
        advance(p)
        expr(p, 13, true)
        return node(p, Node.Await_expr, at, first)
    }
    if w == Kw.Assert.i32() {
        advance(p)
        expr(p, -2, true)
        return node(p, Node.Assert_expr, at, first)
    }
    if w == Kw.New.i32() {
        advance(p)
        let callee = prefix(p)
        while (is(p, Tok.Dot) or is(p, Tok.QuestionDot) or is(p, Tok.LBracket)) {
            callee = infix(p, callee, 13, false)
            if callee < 0 { fail(p) }
        }
        expect(p, Tok.LParen)
        arg_list_or_none(p)
        expect(p, Tok.RParen)
        return node(p, Node.New_expr, at, first)
    }
    if w == Kw.Return.i32() or w == Kw.Continue.i32() {
        advance(p)
        if starts_expression(p) { expr(p, 0, true) }
        return node(p, if w == Kw.Return.i32() { Node.Return_expr } else { Node.Continue_expr }, at, first)
    }
    if w == Kw.Yield.i32() or w == Kw.Defer.i32() or w == Kw.Errdefer.i32() {
        advance(p)
        expr(p, 0, true)
        let kind = if w == Kw.Yield.i32() { Node.Yield_expr } else if w == Kw.Defer.i32() { Node.Defer_expr } else { Node.Errdefer_expr }
        return node(p, kind, at, first)
    }
    if w == Kw.Break.i32() {
        // `break label value`: a label is a name, but not a word that may follow an expression.
        advance(p)
        if shaped(p) and starts_expression(p) {
            identifier(p)
            if starts_expression(p) { expr(p, 0, true) }
        }
        return node(p, Node.Break_expr, at, first)
    }
    if w == Kw.Fatal.i32() { return leaf(p, Node.Fatal_expr) }
    if w == Kw.Prune.i32() { return leaf(p, Node.Prune_expr) }
    if w == Kw.Let.i32() { return bind_expr(p) }
    if w == Kw.Cl.i32() { return closure_expr(p) }
    if w == Kw.If.i32() { return if_expr(p) }
    if w == Kw.Match.i32() {
        advance(p)
        return match_expr(p, Node.Match_expr, at, first)
    }
    if w == Kw.Loop.i32() {
        advance(p)
        expect_kw(p, Kw.Match)
        return match_expr(p, Node.Loop_match_expr, at, first)
    }
    if w == Kw.Alt.i32() { return alt_expr(p) }
    if w == Kw.Promote.i32() { return promote_expr(p) }
    if w == Kw.Try.i32() { return try_expr(p) }
    if w == Kw.For.i32() { return for_expr(p) }
    if w == Kw.While.i32() { return while_expr(p) }
    fail(p)
    return -1
}

/// `text ${expr} text`: its text pieces are tokens, the expressions between them.
fn template_string(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    if is(p, Tok.TemplateFull) {
        leaf(p, Node.Template_full)
        return node(p, Node.Template_string, at, first)
    }
    leaf(p, Node.Template_head)
    while (true) {
        expression(p)
        if is(p, Tok.TemplateTail) {
            leaf(p, Node.Template_tail)
            break
        }
        if not is(p, Tok.TemplateMiddle) { fail(p) }
        leaf(p, Node.Template_middle)
    }
    return node(p, Node.Template_string, at, first)
}

/// Whether the token at the cursor begins `return`'s or `continue`'s optional
/// value. Operator words (`and`, `orelse`, …) instead extend the bare
/// `return`; an iterator word (`count`, `sum`, …) is a name, since a bare
/// `return` has nothing to pipe.
fn starts_expression(p: Parser) Bool {
    if at_end(p) { return false }
    if is_word(p) {
        let w = word_id(p)
        return w != Kw.And.i32() and w != Kw.Or.i32() and w != Kw.Xor.i32() and w != Kw.Orelse.i32()
    }
    return is(p, Tok.Int) or is(p, Tok.Float) or is(p, Tok.String) or is(p, Tok.TemplateFull) or is(p, Tok.TemplateHead) or is(p, Tok.MultilineLine) or is(p, Tok.Minus)
        or is(p, Tok.Tilde) or is(p, Tok.LParen) or is(p, Tok.LBracket) or is(p, Tok.Dot) or is(p, Tok.LBrace)
        or is(p, Tok.Amp) or is(p, Tok.At) or is(p, Tok.Hash)
}

fn word_expression(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    // `m.T { field: … }` and `M.T { field: … }` build a struct from module m or M.
    let qualified = qualified_struct_init(p)
    if qualified >= 0 { return qualified }
    let lower = shaped(p)
    if lower {
        // `label: { … }`
        if is_at(p, 1, Tok.Colon) and is_at(p, 2, Tok.LBrace) {
            identifier(p)
            advance(p)
            block(p)
            return node(p, Node.Block_expr, at, first)
        }
        // A lowercase name already owns its first postfix index when the
        // brackets hold expressions. Indexing binds above every expr caller.
        let indexed = try_named_index(p)
        if indexed >= 0 { return indexed }
    }
    if is_at(p, 1, Tok.LBracket) {
        // A successful module prefix already contains the two AST nodes the
        // real expression needs. Keep it for a call, member, or bare instance.
        if not try_module_prefix(p) {
            if lower { return identifier(p) }
            // Report the same failure at the required prefix of a type name.
            module_prefix(p)
        }
        return module_expression(p, at, first)
    }
    if lower { return identifier(p) }

    let name = type_ident(p)
    // `Tag(i)`, `Meters(x)`: a scalar kind made from its base (infix owns the call).
    if is(p, Tok.LParen) { return name }
    if is(p, Tok.LBrace) {
        field_inits(p)
        return node(p, Node.Struct_init, at, first)
    }
    if not is(p, Tok.Dot) { fail(p) }
    advance(p)
    if is_kw(p, Kw.Null) {
        advance(p)
        return node(p, Node.Null_expr, at, first)
    }
    identifier_or_type(p)
    return node(p, Node.Type_member_expr, at, first)
}

/// Finish a bracketed module expression after its name and type arguments.
fn module_expression(p: Parser, at: I32, first: I32) I32 {
    if is(p, Tok.LParen) or (is(p, Tok.Dot) and shaped_at(p, 1) and is_at(p, 2, Tok.LParen)) {
        return module_call(p, at, first)
    }
    // `M[A].V { f: x }`: a variant of M's type made.
    if is(p, Tok.Dot) and is_at(p, 1, Tok.Word) and not shaped_at(p, 1) and is_at(p, 2, Tok.LBrace) and is_at(p, 3, Tok.Word) and is_at(p, 4, Tok.Colon) {
        advance(p)
        type_ident(p)
        node(p, Node.Qualified_type_ref, at, first)
        field_inits(p)
        return node(p, Node.Struct_init, at, first)
    }
    // `M[A].E.V { f: x }`: a variant of M's enum E made.
    if is(p, Tok.Dot) and is_at(p, 1, Tok.Word) and not shaped_at(p, 1) and is_at(p, 2, Tok.Dot) and is_at(p, 3, Tok.Word) and is_at(p, 4, Tok.LBrace) and is_at(p, 5, Tok.Word) and is_at(p, 6, Tok.Colon) {
        advance(p)
        type_ident(p)
        variant_step(p)
        node(p, Node.Qualified_type_ref, at, first)
        field_inits(p)
        return node(p, Node.Struct_init, at, first)
    }
    // (`M[A].V`, a variant of M's type, ends at the name; `M[A].T.member` goes on.)
    if is(p, Tok.Dot) and (shaped_at(p, 1) or not is_at(p, 2, Tok.Dot)) {
        node(p, Node.Instantiated_module_ref, at, first)
        advance(p)
        identifier_or_type(p)
        return node(p, Node.Type_member_expr, at, first)
    }
    // `M[A]` alone: M's promoted function, as a value.
    if not is(p, Tok.Dot) { return node(p, Node.Instantiated_module_ref, at, first) }
    advance(p)
    type_ident(p)
    node(p, Node.Inline_module_type_path, at, first)
    expect(p, Tok.Dot)
    identifier_or_type(p)
    return node(p, Node.Type_member_expr, at, first)
}

/// `m.T { field: … }` or `m.E.V { field: … }` at the cursor, or -1 without
/// consuming. Braces that fail as fields are a block (`if x == m.T { … }`);
/// so are empty braces after a capitalized `M`, as in `if c == Color.Red {}`.
fn qualified_struct_init(p: Parser) I32 {
    if not (is_word(p) and is_at(p, 1, Tok.Dot) and is_at(p, 2, Tok.Word)) { return -1 }
    // (The brace: after `m.T`, or after `m.E.V`, E and V capitalized.)
    let b = if is_at(p, 3, Tok.Dot) and is_at(p, 4, Tok.Word) and not shaped_at(p, 2) and not shaped_at(p, 4) { 5 } else { 3 }
    if not is_at(p, b, Tok.LBrace) { return -1 }
    let field = b + 1
    if is_at(p, field, Tok.RBrace) {
        if not shaped(p) { return -1 }
    } else {
        // The first field must begin with an identifier and a colon.
        // Record the failed attempt at the same token without building its
        // tentative module and variant nodes or throwing for a normal block.
        if not shaped_at(p, field) {
            note_parse_failure(p.pos + field, -1)
            return -1
        }
        if not is_at(p, field + 1, Tok.Colon) {
            note_parse_failure(p.pos + field + 1, Tok.Colon.i32())
            return -1
        }
    }
    let s = save(p)
    let made = try {
        let at = mark()
        let first = p.pos
        identifier_or_type(p)
        node(p, Node.Module_name, at, first)
        node(p, Node.Module_ref, at, first)
        advance(p)
        type_ident(p)
        variant_step(p)
        node(p, Node.Qualified_type_ref, at, first)
        field_inits(p)
        node(p, Node.Struct_init, at, first)
    } catch {
        -1
    }
    if made < 0 { restore(p, s) }
    return made
}

/// Parse the contents of a possible index, with the cursor after its `[`.
/// A nested bracketed module may be a bare type argument instead.
fn index_items(p: Parser) Bool {
    if module_ref_ahead(p) and not index_ahead(p) {
        let inner = save(p)
        module_prefix(p)
        if is(p, Tok.RBracket) { fail(p) }
        restore(p, inner)
    }
    expression(p)
    if not is(p, Tok.Comma) { return false }
    advance(p)
    expression(p)
    return true
}

/// After the closing bracket, a capitalized member denotes a type.
fn index_ends_here(p: Parser) Bool {
    return not (is(p, Tok.Dot) and is_at(p, 1, Tok.Word) and not shaped_at(p, 1))
}

/// Decide which grammar owns the brackets of a nested name.
fn index_ahead(p: Parser) Bool {
    if not is_at(p, 1, Tok.LBracket) { return false }
    let saved = save(p)
    let found = try {
        p.pos += 2
        index_items(p)
        if is(p, Tok.RBracket) {
            advance(p)
            index_ends_here(p)
        } else {
            false
        }
    } catch {
        false
    }
    restore(p, saved)
    return found
}

/// The first index on a lowercase name. Keep the successful probe's tree
/// so the postfix parser only has to read subsequent operations.
fn try_named_index(p: Parser) I32 {
    if not is_at(p, 1, Tok.LBracket) { return -1 }
    let saved = save(p)
    let at = mark()
    let first = p.pos
    let made = try {
        identifier(p)
        advance(p)
        let slice = index_items(p)
        if is(p, Tok.RBracket) {
            advance(p)
            if index_ends_here(p) {
                node(p, if slice { Node.Slice_expr } else { Node.Index_expr }, at, first)
            } else {
                -1
            }
        } else {
            -1
        }
    } catch {
        -1
    }
    if made < 0 { restore(p, saved) }
    return made
}

fn module_prefix(p: Parser) Void {
    module_name(p)
    module_type_arg_list(p)
}

/// Attempt a module prefix, leaving its nodes in place when it succeeds.
fn try_module_prefix(p: Parser) Bool {
    let saved = save(p)
    let parsed = try {
        module_prefix(p)
        true
    } catch {
        false
    }
    if not parsed { restore(p, saved) }
    return parsed
}

fn module_ref_ahead(p: Parser) Bool {
    if not is_at(p, 1, Tok.LBracket) { return false }
    let saved = save(p)
    let parsed = try {
        module_prefix(p)
        true
    } catch {
        false
    }
    restore(p, saved)
    return parsed
}

/// `M[A].f(…)`'s `f`, or -1 in `M[A](…)` (a call of M's `fn &`).
fn module_call_name(call: I32) I32 {
    let n = next_sibling(next_sibling(first_child(call)))
    return if is_kind(n, Node.Identifier) { n } else { -1 }
}

/// `M[A].f(…)`'s or `M[A](…)`'s arguments, or -1 for none.
fn module_call_args(call: I32) I32 {
    let n = module_call_name(call)
    return if n >= 0 { next_sibling(n) } else { next_sibling(next_sibling(first_child(call))) }
}

/// What `M[A].f(…)` or `M[A](…)` calls (resolved), or -1.
fn module_call_decl(call: I32) I32 {
    let n = module_call_name(call)
    return node_decl[if n >= 0 { n } else { call }]
}

fn module_call(p: Parser, at: I32, first: I32) I32 {
    // `M[A](…)` calls M's promoted function (`fn &(…)`).
    if not is(p, Tok.LParen) {
        expect(p, Tok.Dot)
        identifier(p)
    }
    expect(p, Tok.LParen)
    arg_list_or_none(p)
    expect(p, Tok.RParen)
    return node(p, Node.Promoted_module_call_expr, at, first)
}

fn field_inits(p: Parser) Void {
    expect(p, Tok.LBrace)
    if not is(p, Tok.RBrace) {
        field_init(p)
        while (is(p, Tok.Comma)) {
            advance(p)
            if is(p, Tok.RBrace) { break }
            field_init(p)
        }
    }
    expect(p, Tok.RBrace)
}

fn field_init(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    identifier(p)
    expect(p, Tok.Colon)
    expression(p)
    return node(p, Node.Field_init, at, first)
}

fn paren_or_range(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    advance(p)
    expression(p)
    if is(p, Tok.DotDotDot) or is(p, Tok.DotDotLt) {
        advance(p)
        expression(p)
        expect(p, Tok.RParen)
        return node(p, Node.Range_expr, at, first)
    }
    expect(p, Tok.RParen)
    return node(p, Node.Paren_expr, at, first)
}

fn array_expr(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    advance(p)
    if not is(p, Tok.RBracket) {
        expression(p)
        while (is(p, Tok.Comma)) {
            advance(p)
            if is(p, Tok.RBracket) { break }
            expression(p)
        }
    }
    expect(p, Tok.RBracket)
    return node(p, Node.Array_expr, at, first)
}

fn tuple_expr(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    advance(p)
    expect(p, Tok.LBrace)
    expression(p)
    while (is(p, Tok.Comma)) {
        advance(p)
        if is(p, Tok.RBrace) { break }
        expression(p)
    }
    expect(p, Tok.RBrace)
    return node(p, Node.Tuple_expr, at, first)
}

fn dsl_expr(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    expect(p, Tok.At)
    identifier(p)
    if not is(p, Tok.DslBody) { fail(p) }
    leaf(p, Node.Dsl_body)
    let n = node(p, Node.Dsl_expr, at, first)
    dsl_sites.push(n)
    return n
}

fn bind_expr(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    advance(p)
    if is(p, Tok.Dot) {
        let pattern = mark()
        let start = p.pos
        advance(p)
        expect(p, Tok.LBrace)
        identifier(p)
        while (is(p, Tok.Comma)) {
            advance(p)
            if is(p, Tok.RBrace) { break }
            identifier(p)
        }
        expect(p, Tok.RBrace)
        node(p, Node.Tuple_pattern, pattern, start)
    } else {
        // `let match = …`: a name `match` could not be read back by.
        if is_expression_keyword(word_id(p)) { fail(p) }
        capture_name(p)
        if is(p, Tok.Colon) {
            advance(p)
            type_(p)
        }
    }
    expect(p, Tok.Eq)
    expr(p, 0, true)
    return node(p, Node.Bind_expr, at, first)
}

fn closure_expr(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    advance(p)
    expect(p, Tok.LParen)
    if not is(p, Tok.RParen) {
        let params = mark()
        let start = p.pos
        closure_param(p)
        while (is(p, Tok.Comma)) {
            advance(p)
            if is(p, Tok.RParen) { break }
            closure_param(p)
        }
        node(p, Node.Closure_param_list, params, start)
    }
    expect(p, Tok.RParen)
    if not is(p, Tok.LBrace) { return_type(p) }
    block(p)
    return node(p, Node.Closure_expr, at, first)
}

fn closure_param(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    identifier(p)
    if is(p, Tok.Colon) {
        advance(p)
        type_(p)
    }
    return node(p, Node.Closure_param, at, first)
}

fn if_expr(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    advance(p)
    expression(p)
    block(p)
    if is_kw(p, Kw.Else) {
        advance(p)
        if is_kw(p, Kw.If) {
            deeper(p)
            if_expr(p)
            parse_depth -= 1
        } else { block(p) }
    }
    return node(p, Node.If_expr, at, first)
}

fn match_expr(p: Parser, kind: Node, at: I32, first: I32) I32 {
    expression(p)
    expect(p, Tok.LBrace)
    while (not is(p, Tok.RBrace) and not is(p, Tok.TildeArrow)) { match_arm(p) }
    if is(p, Tok.TildeArrow) {
        let default = mark()
        let start = p.pos
        advance(p)
        expression(p)
        expect(p, Tok.Comma)
        node(p, Node.Match_default, default, start)
    }
    expect(p, Tok.RBrace)
    return node(p, kind, at, first)
}

fn match_arm(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    match_lit(p)
    expect(p, Tok.FatArrow)
    expression(p)
    expect(p, Tok.Comma)
    return node(p, Node.Match_arm, at, first)
}

fn match_lit(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    if is_kw(p, Kw.True) or is_kw(p, Kw.False) {
        leaf(p, Node.Bool_lit)
    } else if is_word(p) {
        // `Tag.Leaf`, or `m.Tag.Leaf` of mod m.
        unreserved_type_ident(p)
        expect(p, Tok.Dot)
        type_ident(p)
        variant_step(p)
    } else {
        if is(p, Tok.Minus) { advance(p) }
        number(p)
    }
    return node(p, Node.Match_lit, at, first)
}

fn alt_expr(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    advance(p)
    expression(p)
    expect(p, Tok.LBrace)
    while (not is(p, Tok.RBrace) and not is(p, Tok.TildeArrow)) {
        let arm = mark()
        let start = p.pos
        alt_pattern(p)
        if is(p, Tok.Pipe) {
            advance(p)
            capture_name(p)
            expect(p, Tok.Pipe)
        }
        expect(p, Tok.FatArrow)
        expression(p)
        expect(p, Tok.Comma)
        node(p, Node.Alt_arm, arm, start)
    }
    if is(p, Tok.TildeArrow) {
        let default = mark()
        let start = p.pos
        advance(p)
        expression(p)
        expect(p, Tok.Comma)
        node(p, Node.Alt_default, default, start)
    }
    expect(p, Tok.RBrace)
    return node(p, Node.Alt_expr, at, first)
}

fn alt_pattern(p: Parser) I32 {
    if is_at(p, 1, Tok.LBracket) or is_at(p, 1, Tok.Dot) {
        let at = mark()
        let first = p.pos
        module_name(p)
        if is(p, Tok.LBracket) {
            module_type_arg_list(p)
            node(p, Node.Instantiated_module_ref, at, first)
        } else {
            node(p, Node.Module_ref, at, first)
        }
        expect(p, Tok.Dot)
        type_ident(p)
        variant_step(p)
        return node(p, Node.Qualified_type_ref, at, first)
    }
    // A bare variant name cannot be a keyword; a module before `.` can.
    return unreserved_type_ident(p)
}

fn promote_expr(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    advance(p)
    expression(p)
    expect(p, Tok.LBrace)
    expect(p, Tok.Pipe)
    capture_name(p)
    expect(p, Tok.Pipe)
    expect(p, Tok.FatArrow)
    expression(p)
    expect(p, Tok.Comma)
    if is(p, Tok.TildeArrow) {
        advance(p)
        expression(p)
        expect(p, Tok.Comma)
    }
    expect(p, Tok.RBrace)
    return node(p, Node.Promote_expr, at, first)
}

/// `try { … } catch …` catches what the host throws; `try e` passes on e's error.
fn try_expr(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    advance(p)
    if not is(p, Tok.LBrace) {
        expr(p, 13, true)
        return node(p, Node.Try_result_expr, at, first)
    }
    let body = mark()
    let body_first = p.pos
    block(p)
    if not is_kw(p, Kw.Catch) {
        // `try {…}` without catch: a block's value, as any other operand.
        let operand = node(p, Node.Block_expr, body, body_first)
        while (true) {
            let next = infix(p, operand, 13, true)
            if next < 0 { break }
            operand = next
        }
        return node(p, Node.Try_result_expr, at, first)
    }
    expect_kw(p, Kw.Catch)
    if is(p, Tok.Pipe) {
        advance(p)
        capture_name(p)
        expect(p, Tok.Pipe)
    }
    block(p)
    return node(p, Node.Try_expr, at, first)
}

fn for_expr(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    advance(p)
    expect(p, Tok.LParen)
    let sources = mark()
    let start = p.pos
    for_source(p)
    while (is(p, Tok.Comma)) {
        advance(p)
        for_source(p)
    }
    node(p, Node.For_sources, sources, start)
    expect(p, Tok.RParen)
    if is(p, Tok.Pipe) { capture(p) }
    // `for (xs) |x| f(x)`: a body of one statement, on the loop's line, is a block of it.
    if is(p, Tok.LBrace) {
        block(p)
    } else {
        let body = mark()
        let start_body = p.pos
        expression(p)
        node(p, Node.Block, body, start_body)
    }
    return node(p, Node.For_expr, at, first)
}

fn for_source(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    expression(p)
    if is(p, Tok.DotDotDot) or is(p, Tok.DotDotLt) {
        advance(p)
        expression(p)
    }
    return node(p, Node.For_source, at, first)
}

fn while_expr(p: Parser) I32 {
    let at = mark()
    let first = p.pos
    advance(p)
    expect(p, Tok.LParen)
    if not is(p, Tok.RParen) { expression(p) }
    expect(p, Tok.RParen)
    block(p)
    return node(p, Node.While_expr, at, first)
}

//! = Running the parser

/// Intern every keyword, at the start of `src`, so a word's id is its
/// keyword's when it is one. Files follow.
fn intern_keywords() Void {
    src.resize(abi_kept)
    src.intern_reset()
    for (0 ..< Kw.count()) |k| {
        let name = kw_name(Kw(k))
        let start = src.len()
        for (0 ..< name.len()) |c| {
            let b = name.get(c)
            src.push(if c == 0 { b + 32 } else { b })
        }
        src.intern(start, src.len())
    }
}

/// Compact away comments and index balanced regions in one pass. Until an
/// opener is paired, its jump entry links to the previous unpaired opener.
fn parser_tokens(first: I32, last: I32) Void {
    // Room only grows: what is past the tokens is never read, and a mem
    // that grows again is cleared again.
    let room = last - first + 4
    if ptok.len() < room { ptok.resize(room) }
    if pkind.len() < room { pkind.resize(room) }
    if pjump.len() < room { pjump.resize(room) }
    let p = 0
    let open = -1
    for (first ..< last) |t| {
        let kind = tok_kind[t]
        if kind == Tok.Comment.i32() { continue }
        ptok[p] = t
        pkind[p] = kind
        let flags = parse_flags[kind]
        if (flags & opens_delimiter) != 0 {
            pjump[p] = open
            open = p
        } else if (flags & closes_delimiter) != 0 and open >= 0 {
            let previous = pjump[open]
            pjump[open] = p + 1
            open = previous
        }
        p += 1
    }
    // An unclosed delimiter can only take the statement to End.
    while (open >= 0) {
        let previous = pjump[open]
        pjump[open] = p - 1
        open = previous
    }
    for (0 ..< 4) |k| {
        ptok[p + k] = last - 1
        pkind[p + k] = Tok.End.i32()
    }
}

/// Parse the tokens from `first` up to `last` (the last of them `End`), adding
/// their nodes. Returns the source file node, or -1 when the tokens do not
/// parse (and adds no nodes).
fn parse(first: I32, last: I32) I32 {
    parse_error_wanted = -1
    if tok_kind[last - 1] != Tok.End.i32() {
        parse_error_at = last - 1
        return -1
    }
    parser_tokens(first, last)
    let before = start_parse_nodes()
    parse_depth = 0
    parse_deepest = 0
    parse_deepest_token = -1
    parse_furthest = 0
    parse_expected.clear()
    let root = try {
        let root = source_file(Parser { pos: 0, limit: -1 })
        node_first[root] = first
        node_last[root] = last - 1
        if comment_nodes == 1 { attach_comments(root) }
        root
    } catch {
        parse_error_at = ptok[parse_furthest]
        if parse_expected.len() > 0 { parse_error_wanted = intern_text(wanted_text()) }
        restore(Parser { pos: 0, limit: -1 }, Save { pos: 0, nodes: before, pending: 0, depth: 0, limit: -1 })
        -1
    }
    resize_parse_nodes(parse_nodes)
    return root
}

/// 1 when the tree should hold comments (see @attach_comments): only the
/// parser's differential asks for them.
let comment_nodes: I32 = 0

struct Comments:
    | next: I32

/// Put each comment in the smallest node whose first and last tokens surround
/// it, among its children in order (stage 0's `attachComments`). Comments come
/// in source order, so one walk down the tree places them all. Only the
/// parser's differential asks for them (@comment_nodes): nothing compiling a
/// program reads them, so its tree is without them, and walking it skips none.
fn attach_comments(root: I32) Void {
    let comments = Comments { next: node_first[root] }
    skip_to_comment(comments)
    attach_within(root, comments)
}

fn skip_to_comment(comments: Comments) Void {
    while (comments.next < tok_kind.len() and tok_kind[comments.next] != Tok.Comment.i32()) { comments.next += 1 }
}

/// Place the comments before the end of `parent`'s tokens.
fn attach_within(parent: I32, comments: Comments) Void {
    let before = -1
    let c = node_child[parent]
    while (comments.next < node_last[parent]) {
        let t = comments.next
        while (c >= 0 and node_last[c] <= t) {
            before = c
            c = node_next[c]
        }
        if c >= 0 and node_first[c] < t {
            attach_within(c, comments)
            before = c
            c = node_next[c]
        } else {
            let id = append_parse_node(Node.Comment, t, t + 1, -1, c, parent)
            if before < 0 { node_child[parent] = id } else { node_next[before] = id }
            before = id
            comments.next += 1
            skip_to_comment(comments)
        }
    }
}

/// An expression from tokens `[first, last)`, the last an `End` token: its node,
/// or -1. (A DSL's expansion takes the utu written in its body this way, at
/// its place in the source.)
fn parse_expression(first: I32, last: I32) I32 {
    if tok_kind[last - 1] != Tok.End.i32() { return -1 }
    parser_tokens(first, last)
    let before = start_parse_nodes()
    let root = try {
        let p = Parser { pos: 0, limit: -1 }
        let e = expression(p)
        if not at_end(p) { fail(p) }
        e
    } catch {
        restore(Parser { pos: 0, limit: -1 }, Save { pos: 0, nodes: before, pending: 0, depth: 0, limit: -1 })
        -1
    }
    resize_parse_nodes(parse_nodes)
    return root
}
