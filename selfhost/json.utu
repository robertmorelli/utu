//! = `@json`
//!
//! Typed JSON, as stage 0 writes it (`json.js at stage-1-final`), function by
//! function: `@json/\ decode T text \/` (→ ?T), `@json/\ error T text \/` (→
//! Str, "" when it matches), `@json/\ encode T value \/` (→ Str), and
//! `@json/\ match text { pattern => value, …, ~> fallback }`.
//!
//! Each type gets a generated reader and writer that run in wasm, over the
//! string's code units; each container (a module, or a file's top level)
//! gets the runtime (`std:JsonRuntime`), the codecs its sites use, and a name
//! table of the field and variant names they read and write.

/// Where the host wrote `std:JsonRuntime` in `src` (@json_runtime_room): start, end.
let json_rt_start: I32 = 0
let json_rt_end: I32 = 0

/// The runtime, as utu source text.
fn json_runtime() Str => jss1(Jst.NlA, bytes_text(json_rt_start, json_rt_end))

/// The container being expanded: its types, names, and generated functions.
let jp_container: I32 = -1
/// The name table, in order.
vec jp_name_words: I32
/// Words of the functions generated (or the container's own)
vec jp_defined: I32
/// By word: 1 + its offset in the name table (0 not in it), and 1 when in
/// @jp_defined; the table's length so far.
vec jp_name_at: I32
vec jp_word_defined: U8
let jp_names_len: I32 = 0
/// By container, the name table (as a word) an earlier round grafted.
vec jp_prev_container: I32
vec jp_prev_names: I32
/// The generated functions' sources, as words, in order.
vec jp_functions: I32
/// A counter for each site's fresh names (`__json0_`).
let jp_serial: I32 = 0
/// Pinned names: a word generated code names a declaration by (`Circle__json0`),
/// and that declaration's name node. Resolution binds each under every scope
/// (@bind_json_pins), so no same-named type or variant hides it.
vec jp_pin_word: I32
vec jp_pin_name: I32
/// By name node: 1 + its pin (when @jp_pin_name says so).
vec jp_pin_of: I32
/// The struct and enum names of the container (slot 0) and its file (slot
/// 1), indexed once each: by `word * 2 + slot`, 1 + the first of that name,
/// when stamped with the slot's stamp (`jd_stamp[1 + slot]`, 0 for none yet;
/// `[0]` counts).
vec jd_item: I32
vec jd_at: I32
vec jd_stamp: I32 = [0, 0, 0]

/// The type span of the site being expanded, for a codec's mistakes.
let jc_type_at: I32 = 0
let jc_type_len: I32 = 0
/// Functions the current site generated, as words.
vec jc_pending: I32
/// The site being expanded.
let jc_site: I32 = -1

/// Each `@json` site in `container` replaced by its expansion, then the
/// runtime (unless the container has it), the generated codecs, and the name
/// table added to the container.
fn json_expand_container(container: I32, json: I32, count: I32) Void {
    jp_container = container
    jd_stamp[1] = 0
    jd_stamp[2] = 0
    for (0 ..< jp_name_words.len()) |k| { jp_name_at[jp_name_words[k]] = 0 }
    for (0 ..< jp_defined.len()) |k| { jp_word_defined[jp_defined[k]] = 0 }
    jp_name_words.clear()
    jp_defined.clear()
    jp_names_len = 0
    jp_functions.clear()
    let has_runtime = false
    let old_slot = -1
    for (0 ..< jp_prev_container.len()) |k| { if jp_prev_container[k] == container { old_slot = k } }
    let names_fn = -1
    let before = -1
    let item = first_child(container)
    while (item >= 0) {
        if is_kind(item, Node.Fn_decl) and word_text(word_of(first_child(first_child(item)))) == jss(Jst.JsonNames) { names_fn = item }
        if names_fn < 0 { before = item }
        if is_kind(item, Node.Fn_decl) and next_sibling(first_child(first_child(item))) < 0 { jp_define_word(word_of(first_child(first_child(item)))) }
        if is_kind(item, Node.Struct_decl) and word_text(word_of(first_child(item))) == jss(Jst.JsonReader) { has_runtime = true }
        item = next_sibling(item)
    }
    // An earlier round's name table: this round's extends it.
    let old_names = ""
    if names_fn >= 0 and old_slot >= 0 { old_names = word_text(jp_prev_names[old_slot]) }
    jp_names_len = old_names.len()
    let first_site = -1
    let s = own_sites()
    while (s < dsl_sites.len() and dsl_sites[s] < count) {
        let n = dsl_sites[s]
        if node_kind[n] == Node.Dsl_expr.i32() and word_of(first_child(n)) == json and dsl_in_program(n) and dsl_container(n) == container {
            if first_site < 0 { first_site = n }
            let prefix = jss1(Jst.Json, int_text(jp_serial))
            jp_serial += 1
            jc_pending.clear()
            jc_site = n
            try {
                graft_expression(n, json_expand_site(n, prefix))
                for (0 ..< jc_pending.len()) |k| { jp_functions.push(jc_pending[k]) }
            } catch {
                report_dsl_error(n)
                dsl_failed.push(n)
            }
        }
        s += 1
    }
    if first_site < 0 { return }
    let source = if has_runtime { "" } else { json_runtime() }
    for (0 ..< jp_functions.len()) |k| { source = jss2(Jst.ABNl, source, word_text(jp_functions[k])) }
    let names = old_names
    for (0 ..< jp_name_words.len()) |k| { names = names + word_text(jp_name_words[k]) }
    if old_slot < 0 {
        jp_prev_container.push(container)
        jp_prev_names.push(intern_text(names))
    } else {
        jp_prev_names[old_slot] = intern_text(names)
    }
    // One table per container: this round's replaces the earlier round's.
    if names_fn >= 0 {
        if before >= 0 { node_next[before] = node_next[names_fn] } else { node_child[container] = node_next[names_fn] }
    }
    source = jss2(Jst.FnJsonNamesStrReturn, source, js_string(names))
    dsl_current_site = first_site
    graft_declarations(container, source)
}

/// `offset, length` of a name in the container's table.
fn name_ref(name: Str) Str {
    let w = intern_text(name)
    jp_word_room(w)
    if jp_name_at[w] == 0 {
        jp_name_words.push(w)
        jp_name_at[w] = jp_names_len + 1
        jp_names_len += word_text(w).len()
    }
    return jss2(Jst.ACommaSpaceB, int_text(jp_name_at[w] - 1), int_text(name.len()))
}

/// @jp_name_at and @jp_word_defined reach word w.
fn jp_word_room(w: I32) Void {
    let old = jp_name_at.len()
    if w < old { return }
    let n = src.interned()
    jp_name_at.resize(n)
    jp_word_defined.resize(n)
    for (old ..< n) |k| {
        jp_name_at[k] = 0
        jp_word_defined[k] = 0
    }
}

/// Word w on @jp_defined; whether it was not yet.
fn jp_define_word(w: I32) Bool {
    jp_word_room(w)
    if jp_word_defined[w] == 1 { return false }
    jp_word_defined[w] = 1
    jp_defined.push(w)
    return true
}

//! = A site

/// The utu expression a `@json` site stands for; its codecs go to @jc_pending.
fn json_expand_site(site: I32, prefix: Str) Str {
    let raw = dsl_body(site)
    let i = skip_spaces(raw, 0)
    if text_at(raw, i, "match") and (i + 5 >= raw.len() or not is_word_code(raw.get(i + 5))) { return json_match(raw, prefix) }
    // `decode|encode|error`, a type (with nested brackets), then the expression.
    let op = if text_at(raw, i, "decode") { "decode" } else if text_at(raw, i, "encode") { "encode" } else if text_at(raw, i, jss(Jst.Error)) { jss(Jst.Error) } else { "" }
    let after = i + op.len()
    if op.len() == 0 or after >= raw.len() or not is_space_code(raw.get(after)) {
        dsl_fail(jss(Jst.JsonExpectsDecodeTypeTextEncode), first_non_space(raw), 1)
    }
    let type_start = skip_spaces(raw, after)
    let j = type_start
    let depth = 0
    while (j < raw.len() and (depth > 0 or not is_space_code(raw.get(j)))) {
        if raw.get(j) == 91 { depth += 1 }
        if raw.get(j) == 93 { depth -= 1 }
        j += 1
    }
    let type = raw.slice(type_start, j)
    if not is_written_type(type) {
        dsl_fail(jss1(Jst.ExpectedATypeAfter, op), type_start, if type.len() > 1 { type.len() } else { 1 })
    }
    let expr_start = skip_spaces(raw, j)
    if expr_start >= trim_end(raw).len() {
        let what = if op == "encode" { "value" } else { jss(Jst.Text) }
        dsl_fail(jss2(Jst.JsonNeedsAExpressionAfterThe, op, what), type_start, type.len())
    }
    let expr = raw.slice(expr_start, raw.len())
    jc_type_at = type_start
    jc_type_len = type.len()
    let kind = shape_kind(type)
    if kind == Shape.Scalar or kind == Shape.Nullable {
        dsl_fail(jss2(Jst.JsonWorksOnAStructEnum, op, type), type_start, type.len())
    }
    // decode gives ?T, and an integer enum cannot be null.
    if op == "decode" and kind == Shape.Enum and is_int_enum(declared_type(without_spaces(type))) {
        dsl_fail(jss2(Jst.JsonDecodeGivesAndAnEnum, type, type), type_start, type.len())
    }
    if not splice_parses(site, expr_start, expr) {
        let what = if op == "encode" { "value" } else { jss(Jst.Text) }
        dsl_fail(jss1(Jst.InvalidExpression, what), expr_start, trim_end(expr).len())
    }
    let input = dsl_splice(site, expr_start, expr)
    let r = jss1(Jst.Reader, prefix)
    let w = jss1(Jst.Writer, prefix)
    let value = jss1(Jst.Value, prefix)
    let out = jss1(Jst.Out, prefix)
    if op == "encode" { return jss4(Jst.LetJsonWriter64StrFrom, w, json_write(type, input, w), w, w) }
    let read = json_read(type, r)
    if op == "decode" {
        return jss4(Jst.LetJsonReaderLetJsonEnd, r, input, value, read) + jss4(Jst.LetNullIfFailed0, r, out, type_ref(type), r) + jss3(Jst.ASpaceEqSpaceBSemiSpaceBraceEndSemiSpaceCSemiSpa, out, value, out)
    }
    return jss4(Jst.LetJsonReaderLetJsonEnd, r, input, value, read) + jss2(Jst.JsonDescribe, r, r)
}

fn first_non_space(text: Str) I32 => skip_spaces(text, 0)

/// `?Name`, `Name`, `Name[…]`: what may follow decode, encode, or error.
fn is_written_type(type: Str) Bool {
    let i = 0
    if i < type.len() and type.get(i) == 63 { i += 1 }
    if i >= type.len() or not is_upper_code(type.get(i)) { return false }
    while (i < type.len() and is_word_code(type.get(i))) { i += 1 }
    if i == type.len() { return true }
    return type.get(i) == 91 and type.get(type.len() - 1) == 93
}

//! = Shapes
//!
//! 0 scalar, 1 optional, 2 array, 3 struct, 4 enum. A codec's mistakes point
//! at the site's type.

fn json_fail(message: Str) Void => dsl_fail(message, jc_type_at, jc_type_len)

fn is_json_scalar(type: Str) Bool {
    return type == "I32" or type == "U32" or type == "I64" or type == "F32" or type == "F64" or type == "Bool" or type == "Str"
}

/// What JSON a type is.
enum(U8) Shape:
    | Scalar
    | Nullable
    | Array
    | Struct
    | Enum

/// The @Shape of a written type; a type JSON cannot have is reported.
fn shape_kind(written: Str) Shape {
    let type = without_spaces(written)
    if is_json_scalar(type) { return Shape.Scalar }
    if type.len() > 0 and type.get(0) == 63 {
        let inner = shape_kind(type.slice(1, type.len()))
        if inner == Shape.Scalar and type.slice(1, type.len()) != "Str" { json_fail(jss1(Jst.IsNotSupportedOnlyReferenceTypes, type)) }
        if inner == Shape.Nullable { json_fail(jss1(Jst.IsNotSupported, type)) }
        if inner == Shape.Enum and is_int_enum(declared_type(type.slice(1, type.len()))) { json_fail(jss2(Jst.IsNotSupportedAnEnumU8, type, type.slice(1, type.len()))) }
        return Shape.Nullable
    }
    if text_at(type, 0, "Array[") and type.get(type.len() - 1) == 93 {
        shape_kind(type.slice(6, type.len() - 1))
        return Shape.Array
    }
    let node = declared_type(type)
    if node < 0 { json_fail(jss1(Jst.JsonCannotUseUseALocal, type)) }
    if is_kind(node, Node.Struct_decl) { return Shape.Struct }
    // Enum variants name their kind with a field `kind`: none may have one.
    let v = first_child(node)
    while (v >= 0) {
        if is_kind(v, Node.Variant) {
            let fields = variant_fields(v)
            let f = if fields >= 0 { first_child(fields) } else { -1 }
            while (f >= 0) {
                if is_kind(f, Node.Field) and word_text(word_of(first_child(f))) == jss(Jst.Kind) {
                    json_fail(jss2(Jst.HasAFieldNamedKindWhich, type, word_text(word_of(first_child(v)))))
                }
                f = next_sibling(f)
            }
        }
        v = next_sibling(v)
    }
    return Shape.Enum
}

/// The struct or enum declaration a type names in the container, or -1:
/// the file's top-level one of that name; in a module, its own, else the
/// file's top-level one.
fn declared_type(type: Str) I32 {
    let w = intern_text(type)
    if is_kind(jp_container, Node.Module_decl) {
        let own = json_declared_in(jp_container, w, 0)
        if own >= 0 { return own }
        let file = parent_of(jp_container)
        return if file >= 0 { json_declared_in(file, w, 1) } else { -1 }
    }
    return json_declared_in(jp_container, w, 0)
}

/// The first struct or enum of that name directly in `node` (indexed in
/// `slot`), or -1.
fn json_declared_in(node: I32, w: I32, slot: I32) I32 {
    if jd_stamp[1 + slot] == 0 {
        jd_stamp[0] += 1
        jd_stamp[1 + slot] = jd_stamp[0]
        let item = first_child(node)
        while (item >= 0) {
            if is_kind(item, Node.Struct_decl) or is_kind(item, Node.Enum_decl) {
                let x = type_word(item) * 2 + slot
                if x >= 0 {
                    jd_room(x)
                    if jd_at[x] != jd_stamp[0] {
                        jd_at[x] = jd_stamp[0]
                        jd_item[x] = item
                    }
                }
            }
            item = next_sibling(item)
        }
    }
    let x = w * 2 + slot
    return if x >= 0 and x < jd_at.len() and jd_at[x] == jd_stamp[1 + slot] { jd_item[x] } else { -1 }
}

/// @jd_item and @jd_at reach `x`.
fn jd_room(x: I32) Void {
    if x >= jd_at.len() {
        jd_at.resize(x * 2 + 2)
        jd_item.resize(x * 2 + 2)
    }
}

/// The last of that name in the file, in order, as stage 0's table keeps it.
fn find_declared(node: I32, w: I32) I32 {
    let found = -1
    let c = first_child(node)
    while (c >= 0) {
        if (is_kind(c, Node.Struct_decl) or is_kind(c, Node.Enum_decl)) and type_word(c) == w { found = c }
        if is_kind(c, Node.Module_decl) {
            let inner = find_declared(c, w)
            if inner >= 0 { found = inner }
        }
        c = next_sibling(c)
    }
    return found
}

/// A struct's or enum's name node (after an integer enum's representation).
fn type_name_at(node: I32) I32 => if is_kind(node, Node.Enum_decl) { enum_name(node) } else { first_child(node) }

fn type_word(node: I32) I32 => word_of(type_name_at(node))

/// The pinned name of the declaration named at `name_at` (`name` as written).
fn json_pin(name_at: I32, name: Str) Str {
    if name_at < jp_pin_of.len() {
        let k = jp_pin_of[name_at] - 1
        if k >= 0 and k < jp_pin_name.len() and jp_pin_name[k] == name_at { return word_text(jp_pin_word[k]) }
    } else {
        jp_pin_of.resize(name_at * 2 + 2)
    }
    let text = jss2(Jst.Json2, name, int_text(jp_pin_name.len()))
    jp_pin_of[name_at] = jp_pin_name.len() + 1
    jp_pin_word.push(intern_text(text))
    jp_pin_name.push(name_at)
    return text
}

/// Each pinned name bound to its declaration, under every file's scope.
fn bind_json_pins() Void {
    for (0 ..< jp_pin_word.len()) |k| {
        let n = name_node(jp_pin_name[k])
        if n >= 0 and node_decl[n] >= 0 { bind(jp_pin_word[k], node_decl[n]) }
    }
}

/// A written type as generated code names it: each struct and enum pinned.
fn type_ref(written: Str) Str {
    let type = without_spaces(written)
    if is_json_scalar(type) { return type }
    if type.get(0) == 63 { return jss1(Jst.QA, type_ref(type.slice(1, type.len()))) }
    if text_at(type, 0, "Array[") { return jss1(Jst.Array, type_ref(inner_type(type))) }
    let node = declared_type(type)
    return if node < 0 { type } else { json_pin(type_name_at(node), type) }
}

/// A variant, pinned, as generated code builds it.
fn variant_ref(variant: I32) Str => json_pin(first_child(variant), word_text(word_of(first_child(variant))))

/// A field-less variant as a value: `Red {}`, or an integer enum's `Level.Low`.
fn json_variant(node: I32, v: I32) Str {
    return if is_int_enum(node) { jss2(Jst.ADotB, json_pin(type_name_at(node), word_text(type_word(node))), word_text(word_of(first_child(v)))) } else { jss1(Jst.ASpaceBraceBraceEnd, variant_ref(v)) }
}

fn variant_fields(variant: I32) I32 {
    let c = next_sibling(first_child(variant))
    while (c >= 0) {
        if is_kind(c, Node.Field_list) { return c }
        c = next_sibling(c)
    }
    return -1
}

/// A struct's fields (or a variant's): the node whose Field children they are.
fn fields_holder_of(node: I32) I32 => if is_kind(node, Node.Variant) { variant_fields(node) } else { node }

fn field_name(field: I32) Str => word_text(word_of(first_child(field)))

fn field_type_text(field: I32) Str => without_spaces(node_text(next_sibling(first_child(field))))

/// The element type of `Array[T]`, or `T` of `?T`.
fn inner_type(type: Str) Str {
    let t = without_spaces(type)
    if t.get(0) == 63 { return t.slice(1, t.len()) }
    return t.slice(6, t.len() - 1)
}

/// A type as a function-name part: `?` is `opt_`, other punctuation `_`.
fn mangle(type: Str) Str {
    let out = ""
    for (0 ..< type.len()) |i| {
        let c = type.get(i)
        if c == 63 { out = jss1(Jst.Opt, out) } else if is_word_code(c) { out = out + Str.from_code_point(c) } else { out = jss1(Jst.AX, out) }
    }
    return out
}

fn scalar_zero(type: Str) Str {
    if type == "F32" or type == "F64" { return jss(Jst.N00) }
    if type == "Bool" { return "false" }
    if type == "Str" { return "\"\"" }
    return "0"
}

fn scalar_read(type: Str) Str {
    if type == "I32" { return "i32" }
    if type == "U32" { return "u32" }
    if type == "I64" { return "i64" }
    if type == "F32" { return "f32" }
    if type == "F64" { return "f64" }
    if type == "Bool" { return jss(Jst.Bool) }
    return jss(Jst.Str)
}

fn scalar_write(type: Str, v: Str, w: Str) Str {
    if type == "I32" or type == "U32" { return jss2(Jst.JsonPutI64I64, w, v) }
    if type == "I64" { return jss2(Jst.JsonPutI64, w, v) }
    if type == "F32" { return jss2(Jst.JsonPutF32, w, v) }
    if type == "F64" { return jss2(Jst.JsonPutF64, w, v) }
    if type == "Bool" { return jss2(Jst.JsonRawIfTrueElseFalse, w, v) }
    return jss2(Jst.JsonPutStr, w, v)
}

/// Generate a function once, by name, unless the container already has it:
/// whether to generate it now.
fn json_define(name: Str) Bool {
    return jp_define_word(intern_text(name))
}

fn json_emit(source: Str) Void => jc_pending.push(intern_text(source))

//! = Defaults

/// A value of the type to start a field with; the struct or enum ones are
/// generated functions. A type that contains itself has none.
fn json_zero(written: Str, visiting: I32) Str {
    let type = without_spaces(written)
    let kind = shape_kind(type)
    if kind == Shape.Scalar { return scalar_zero(type) }
    if kind == Shape.Nullable { return "null" }
    if kind == Shape.Array { return "[]" }
    let w = intern_text(type)
    if visiting >= 0 and list_has(visiting, w) { json_fail(jss2(Jst.ContainsItselfMakeTheRecursiveField, type, type)) }
    let name = jss1(Jst.JsonZero, mangle(type))
    let next = list_with(visiting, w)
    let node = declared_type(type)
    let t = type_ref(type)
    if json_define(name) {
        let body = ""
        if kind == Shape.Struct { body = jss2(Jst.ASpaceBraceSpaceBSpaceBraceEnd, t, construct_fields(node, next)) }
        else {
            let usable = -1
            let v = first_child(node)
            while (v >= 0 and usable < 0) {
                if is_kind(v, Node.Variant) and fields_constructible(fields_holder_of(v), next) { usable = v }
                v = next_sibling(v)
            }
            if usable < 0 { json_fail(jss1(Jst.HasNoVariantWithoutARecursive, type)) }
            body = if is_int_enum(node) { json_variant(node, usable) } else { jss2(Jst.ASpaceBraceSpaceBSpaceBraceEnd, variant_ref(usable), construct_fields(fields_holder_of(usable), next)) }
        }
        json_emit(jss3(Jst.FnReturn, name, t, body))
    }
    return jss1(Jst.AOpenClose, name)
}

fn construct_fields(holder: I32, visiting: I32) Str {
    let out = ""
    let f = if holder >= 0 { first_child(holder) } else { -1 }
    let first = true
    while (f >= 0) {
        if is_kind(f, Node.Field) {
            if not first { out = jss1(Jst.ACommaSpace, out) }
            out = jss3(Jst.ABColonSpaceC, out, field_name(f), json_zero(field_type_text(f), visiting))
            first = false
        }
        f = next_sibling(f)
    }
    return out
}

/// Whether every field has a default without a type it is inside.
fn fields_constructible(holder: I32, visiting: I32) Bool {
    let f = if holder >= 0 { first_child(holder) } else { -1 }
    while (f >= 0) {
        if is_kind(f, Node.Field) and not constructible(field_type_text(f), visiting) { return false }
        f = next_sibling(f)
    }
    return true
}

/// Whether a value of `type` can be made without a type it is inside
/// (`visiting`, a list of words).
fn constructible(type: Str, visiting: I32) Bool {
    let kind = shape_kind(type)
    if kind == Shape.Scalar or kind == Shape.Nullable or kind == Shape.Array { return true }
    let w = intern_text(type)
    if visiting >= 0 and list_has(visiting, w) { return false }
    let next = list_with(visiting, w)
    let node = declared_type(type)
    if kind == Shape.Struct { return fields_constructible(node, next) }
    let v = first_child(node)
    while (v >= 0) {
        if is_kind(v, Node.Variant) and fields_constructible(fields_holder_of(v), next) { return true }
        v = next_sibling(v)
    }
    return false
}

fn list_has(list: I32, w: I32) Bool {
    for (0 ..< vl_len[list]) |i| { if vl_item(list, i) == w { return true } }
    return false
}

fn list_with(list: I32, w: I32) I32 {
    let m = vl_begin()
    if list >= 0 { for (0 ..< vl_len[list]) |i| { vl_add(vl_item(list, i)) } }
    vl_add(w)
    return vl_end(m)
}

//! = Readers

/// An expression reading a value of `type` from reader `r`.
fn json_read(written: Str, r: Str) Str {
    let type = without_spaces(written)
    let kind = shape_kind(type)
    if kind == Shape.Scalar { return jss2(Jst.JsonOpenClose, scalar_read(type), r) }
    let name = jss1(Jst.JsonRead, mangle(type))
    let t = type_ref(type)
    if json_define(name) {
        if kind == Shape.Nullable {
            json_emit(jss4(Jst.FnRJsonReaderLetOutNull, name, t, t, json_read(inner_type(type), "r")))
        } else if kind == Shape.Array {
            json_emit(array_reader(name, type))
        } else if kind == Shape.Struct {
            let node = declared_type(type)
            json_emit(jss3(Jst.FnRJsonReader, name, t, fields_reader(node, jss2(Jst.ASpaceBraceSpaceBSpaceBraceEnd, t, fields_result(node)), true)))
        } else {
            json_emit(enum_reader(name, type))
        }
    }
    return jss2(Jst.AOpenBClose, name, r)
}

fn fields_result(holder: I32) Str {
    let out = ""
    let i = 0
    let f = if holder >= 0 { first_child(holder) } else { -1 }
    while (f >= 0) {
        if is_kind(f, Node.Field) {
            if i > 0 { out = jss1(Jst.ACommaSpace, out) }
            out = jss3(Jst.F, out, field_name(f), int_text(i))
            i += 1
        }
        f = next_sibling(f)
    }
    return out
}

/// The source of a generated reader of `Array[T]`, which grows by doubling.
fn array_reader(name: Str, type: Str) Str {
    let element = type_ref(inner_type(type))
    let read = json_read(inner_type(type), "r")
    let t = type_ref(type)
    return jss4(Jst.FnRJsonReaderLetOutJson, name, t, t, read) + jss3(Jst.New8FirstLetCount1, element, read, element)
}

/// The body of an object reader: one local per field, matched by name, then
/// required-field checks and `result`. With `open`, it reads the `{` and
/// the first field; otherwise the object is already open (after a kind).
fn fields_reader(holder: I32, result: Str, open: Bool) Str {
    let locals = ""
    let matcher = ""
    let required = ""
    let i = 0
    let f = if holder >= 0 { first_child(holder) } else { -1 }
    while (f >= 0) {
        if is_kind(f, Node.Field) {
            let type = field_type_text(f)
            if i > 0 { locals = jss1(Jst.ANl, locals) }
            locals = jss4(Jst.LetFLetS, locals, int_text(i), type_ref(type), json_zero(type, -1)) + jss1(Jst.False, int_text(i))
            matcher = jss4(Jst.IfJsonIsRFS, matcher, name_ref(field_name(f)), int_text(i), json_read(type, "r")) + jss1(Jst.TrueElse, int_text(i))
            if type.get(0) != 63 { required = jss3(Jst.IfNotSJsonMissingR, required, int_text(i), js_string(field_name(f))) }
            i += 1
        }
        f = next_sibling(f)
    }
    matcher = jss1(Jst.JsonSkipR, matcher)
    let start = if open { jss(Jst.JsonOpenR123ExpectedAn) } else { jss(Jst.LetMoreJsonNextR125) }
    return jss4(Jst.WhileMoreJsonSpanRJson, locals, start, matcher, required) + jss1(Jst.ASemi, result)
}

/// Whether some variant of an enum has fields (it is then read and written
/// as an object with a `kind`, else as a string).
fn is_tagged(node: I32) Bool {
    let v = first_child(node)
    while (v >= 0) {
        if is_kind(v, Node.Variant) {
            let holder = variant_fields(v)
            if holder >= 0 and child_count_of(holder, Node.Field) > 0 { return true }
        }
        v = next_sibling(v)
    }
    return false
}

fn child_count_of(node: I32, kind: Node) I32 {
    let n = 0
    let c = first_child(node)
    while (c >= 0) {
        if is_kind(c, kind) { n += 1 }
        c = next_sibling(c)
    }
    return n
}

fn enum_reader(name: Str, type: Str) Str {
    let node = declared_type(type)
    let t = type_ref(type)
    let zero_value = json_zero(type, -1)
    // It names the variant read, when its text is plain (`unknown Expr variant "Mul"`).
    let quote = js_string(Str.from_code_point(34))
    let unknown = jss3(Jst.RTextSliceRKsR, js_string(jss1(Jst.UnknownVariant, type)), quote, quote)
    if not is_tagged(node) {
        let arms = ""
        let v = first_child(node)
        while (v >= 0) {
            if is_kind(v, Node.Variant) {
                let vname = word_text(word_of(first_child(v)))
                arms = jss3(Jst.IfJsonIsROutElse, arms, name_ref(vname), json_variant(node, v))
            }
            v = next_sibling(v)
        }
        return jss4(Jst.FnRJsonReaderLetOutJsonOpenColonCloseBr, name, t, t, zero_value) + jss2(Jst.RAtStartJsonFailR, arms, unknown)
    }
    let arms = ""
    let v = first_child(node)
    while (v >= 0) {
        if is_kind(v, Node.Variant) {
            let vname = word_text(word_of(first_child(v)))
            let reader = jss2(Jst.JsonVariant, mangle(type), vname)
            if json_define(reader) {
                let holder = variant_fields(v)
                json_emit(jss3(Jst.FnRJsonReader, reader, t, fields_reader(holder, jss2(Jst.ASpaceBraceSpaceBSpaceBraceEnd, variant_ref(v), fields_result(holder)), false)))
            }
            arms = jss3(Jst.IfJsonIsROutR, arms, name_ref(vname), reader)
        }
        v = next_sibling(v)
    }
    let kind_ref = name_ref(jss(Jst.Kind))
    return jss4(Jst.FnRJsonReaderLetOutJsonLc, name, t, t, zero_value) + jss3(Jst.JsonFailRExpectedKindAs, kind_ref, arms, unknown)
}

//! = Writers

/// Statements writing `value` (of `type`) to writer `w`.
fn json_write(written: Str, value: Str, w: Str) Str {
    let type = without_spaces(written)
    let kind = shape_kind(type)
    if kind == Shape.Scalar { return scalar_write(type, value, w) }
    let name = jss1(Jst.JsonWrite, mangle(type))
    if json_define(name) {
        let body = ""
        if kind == Shape.Nullable {
            body = jss1(Jst.PromoteVXJsonRawW, json_write(inner_type(type), "x", "w"))
        } else if kind == Shape.Array {
            body = jss1(Jst.JsonPutW91For0, json_write(inner_type(type), jss(Jst.VI), "w"))
        } else if kind == Shape.Struct {
            body = object_writer(declared_type(type), "v", true)
        } else {
            let node = declared_type(type)
            let tagged = is_tagged(node)
            let arms = ""
            let first = true
            let v = first_child(node)
            while (v >= 0) {
                if is_kind(v, Node.Variant) {
                    let vname = word_text(word_of(first_child(v)))
                    let tag = jss1(Jst.JsonTagW, name_ref(vname))
                    if not first { arms = jss1(Jst.ANl, arms) }
                    first = false
                    let holder = variant_fields(v)
                    if is_int_enum(node) { arms = jss3(Jst.IfVElse, arms, json_variant(node, v), tag) }
                    else if not tagged { arms = jss3(Jst.ASpaceBSpaceEqGtSpaceBraceNlSpaceCNlSpaceBraceEn, arms, vname, tag) }
                    else {
                        let kind_ = jss2(Jst.JsonNameW123, name_ref(jss(Jst.Kind)), tag)
                        if holder < 0 or child_count_of(holder, Node.Field) == 0 { arms = jss3(Jst.JsonPutW125, arms, vname, kind_) }
                        else { arms = jss4(Jst.XBarBarEqGtBraceN, arms, vname, kind_, object_writer(holder, "x", false)) }
                    }
                }
                v = next_sibling(v)
            }
            body = if is_int_enum(node) { jss1(Jst.ABraceBraceEndSemi, arms) } else { jss1(Jst.AltV, arms) }
        }
        json_emit(jss3(Jst.FnWJsonWriterVVoid, name, type_ref(type), body))
    }
    return jss3(Jst.AOpenBCommaSpaceCCloseSemi, name, w, value)
}

/// Fields as "name":value pairs; `opens` writes the `{` (else the object
/// already has its kind).
fn object_writer(holder: I32, value: Str, opens: Bool) Str {
    let parts = ""
    let i = 0
    let f = if holder >= 0 { first_child(holder) } else { -1 }
    while (f >= 0) {
        if is_kind(f, Node.Field) {
            if i > 0 { parts = jss1(Jst.ANlSpace, parts) }
            let open = if i == 0 and opens { 123 } else { 44 }
            parts = jss4(Jst.JsonNameW, parts, int_text(open), name_ref(field_name(f)), json_write(field_type_text(f), jss2(Jst.ADotB, value, field_name(f)), "w"))
            i += 1
        }
        f = next_sibling(f)
    }
    if i == 0 { return if opens { jss(Jst.JsonRawW) } else { jss(Jst.JsonPutW125OpenCommaCloseSe) } }
    return jss1(Jst.JsonPutW125NlOpenCommaClose, parts)
}

//! = match: structural patterns over JSON
//!
//! ```
//! @json/\ match text {
//!     { status: "ok", user: { name: |name| Str, age: |age| I32 = 0 } } => greet(name, age),
//!     ~> |error| show(error),
//! }\/
//! ```
//!
//! Patterns list only what the program needs; other fields are skipped.

let sc_at: I32 = 0

/// Past spaces and `//` comments.
fn sc_ws(raw: Str) I32 {
    let i = sc_at
    while (true) {
        i = skip_spaces(raw, i)
        if text_at(raw, i, "//") {
            while (i < raw.len() and raw.get(i) != 10) { i += 1 }
        } else {
            sc_at = i
            return i
        }
    }
    return i
}

fn sc_peek(raw: Str, text: Str) Bool {
    sc_ws(raw)
    return text_at(raw, sc_at, text)
}

fn sc_expect(raw: Str, text: Str) Void {
    sc_ws(raw)
    if not text_at(raw, sc_at, text) { dsl_fail(jss1(Jst.ExpectedInJsonMatch, text), sc_at, 1) }
    sc_at += text.len()
}

/// Source up to the first of `stops` at nesting depth 0 (`sc_until_start` says where it began).
let sc_until_start: I32 = 0

fn sc_until(raw: Str, stops: Str) Str {
    sc_ws(raw)
    let from = sc_at
    let i = from
    let depth = 0
    while (i < raw.len()) {
        let c = raw.get(i)
        if c == 34 or c == 96 {
            i += 1
            while (i < raw.len() and raw.get(i) != c) { i += if raw.get(i) == 92 { 2 } else { 1 } }
            i += 1
        } else if text_at(raw, i, "//") {
            while (i < raw.len() and raw.get(i) != 10) { i += 1 }
        } else {
            if depth == 0 and text_index(stops, Str.from_code_point(c), 0) >= 0 { break }
            if c == 40 or c == 91 or c == 123 { depth += 1 }
            if c == 41 or c == 93 or c == 125 { depth -= 1 }
            if depth < 0 { break }
            i += 1
        }
    }
    sc_at = i
    sc_until_start = from
    return trim_end(raw.slice(from, i))
}

/// An identifier at the cursor (of a lowercase or `_` start, unless
/// `upper` allows uppercase too), or "".
fn sc_word(raw: Str, upper: Bool) Str {
    sc_ws(raw)
    let i = sc_at
    if i >= raw.len() { return "" }
    let c = raw.get(i)
    if not (is_lower_code(c) or c == 95 or upper and is_upper_code(c)) { return "" }
    let j = i
    while (j < raw.len() and is_word_code(raw.get(j))) { j += 1 }
    sc_at = j
    return raw.slice(i, j)
}

/// A JSON string literal at the cursor (with its quotes), or "".
fn sc_string(raw: Str) Str {
    sc_ws(raw)
    let i = sc_at
    if i >= raw.len() or raw.get(i) != 34 { return "" }
    let j = i + 1
    while (j < raw.len() and raw.get(j) != 34) { j += if raw.get(j) == 92 { 2 } else { 1 } }
    if j >= raw.len() { return "" }
    sc_at = j + 1
    return raw.slice(i, j + 1)
}

/// What a JSON string literal (with its quotes) says: its escapes decoded.
fn json_unescape(quoted: Str) Str {
    let out = ""
    let i = 1
    let end = quoted.len() - 1
    while (i < end) {
        let c = quoted.get(i)
        i += 1
        if c == 92 and i < end {
            let e = quoted.get(i)
            i += 1
            if e == 117 and i + 4 <= end {
                let v = 0
                for (0 ..< 4) |k| {
                    let h = quoted.get(i + k)
                    v = v * 16 + (if h >= 97 { h - 87 } else if h >= 65 { h - 55 } else { h - 48 })
                }
                i += 4
                out = out + Str.from_code_point(v)
            } else {
                out = out + Str.from_code_point(if e == 110 { 10 } else if e == 116 { 9 } else if e == 114 { 13 } else if e == 98 { 8 } else if e == 102 { 12 } else { e })
            }
        } else {
            out = out + Str.from_code_point(c)
        }
    }
    return out
}

// Patterns: object (its fields' patterns, linked), capture, or literal.

/// What a pattern is.
enum(U8) Pat:
    | Object
    | Capture
    | Literal

/// Its @Pat.
vec pat_kind: U8
/// Capture: its name; a field: its key (words)
vec pat_name: I32
vec pat_name_start: I32
/// Capture: its type (a word)
vec pat_type: I32
vec pat_type_start: I32
/// Capture: `= default` text (a word), or -1.
vec pat_fallback: I32
vec pat_fallback_start: I32
/// Literal: as written (a word)
vec pat_text: I32
/// Object: its first field's pattern, or -1.
vec pat_first: I32
/// A field's next field, or -1.
vec pat_next: I32
/// A field's key (a word)
vec pat_key: I32

fn pat_is(p: I32, kind: Pat) Bool => pat_kind[p] == kind.i32()

fn new_pattern(kind: Pat) I32 {
    let p = pat_kind.len()
    pat_kind.push(kind.i32())
    pat_name.push(-1)
    pat_name_start.push(0)
    pat_type.push(-1)
    pat_type_start.push(0)
    pat_fallback.push(-1)
    pat_fallback_start.push(0)
    pat_text.push(-1)
    pat_first.push(-1)
    pat_next.push(-1)
    pat_key.push(-1)
    return p
}

/// A `@json match` pattern at the cursor, into the `pat_` rows: its index.
fn parse_pattern(raw: Str) I32 {
    sc_ws(raw)
    if sc_peek(raw, "{") {
        sc_expect(raw, "{")
        let p = new_pattern(Pat.Object)
        let last = -1
        while (not sc_peek(raw, "}")) {
            let key_start = sc_ws(raw)
            let quoted = sc_string(raw)
            let key = if quoted.len() > 0 { json_unescape(quoted) } else { sc_word(raw, true) }
            if key.len() == 0 { dsl_fail(jss(Jst.ExpectedAFieldNameInJson), sc_at, 1) }
            let written = if quoted.len() > 0 { quoted.len() } else { key.len() }
            let f = pat_first[p]
            while (f >= 0) {
                if word_text(pat_key[f]) == key { dsl_fail(jss1(Jst.FieldAppearsTwiceInThisPattern, key), key_start, written) }
                f = pat_next[f]
            }
            sc_expect(raw, ":")
            let child = parse_pattern(raw)
            pat_key[child] = intern_text(key)
            if last < 0 { pat_first[p] = child } else { pat_next[last] = child }
            last = child
            if not sc_peek(raw, "}") { sc_expect(raw, ",") }
        }
        sc_expect(raw, "}")
        return p
    }
    if sc_peek(raw, "|") {
        sc_expect(raw, "|")
        let name_start = sc_ws(raw)
        let name = sc_word(raw, false)
        if name.len() == 0 { dsl_fail(jss(Jst.ExpectedACaptureNameNameType), sc_at, 1) }
        sc_expect(raw, "|")
        let type_start = sc_ws(raw)
        let type = sc_capture_type(raw)
        if type.len() == 0 { dsl_fail(jss1(Jst.ExpectedATypeForCapture, name), sc_at, 1) }
        let p = new_pattern(Pat.Capture)
        pat_name[p] = intern_text(name)
        pat_name_start[p] = name_start
        pat_type[p] = intern_text(type)
        pat_type_start[p] = type_start
        if sc_peek(raw, "=") and not sc_peek(raw, "=>") {
            sc_expect(raw, "=")
            pat_fallback[p] = intern_text(sc_until(raw, ",}"))
            pat_fallback_start[p] = sc_until_start
        }
        return p
    }
    let token = sc_string(raw)
    if token.len() == 0 { token = sc_number(raw) }
    if token.len() == 0 { token = sc_keyword(raw) }
    if token.len() == 0 { dsl_fail(jss(Jst.ExpectedNameTypeOrALiteral), sc_at, 1) }
    let p = new_pattern(Pat.Literal)
    pat_text[p] = intern_text(token)
    return p
}

/// `?Name`, `Name`, `Name[…]` (one level of nested brackets), or "".
fn sc_capture_type(raw: Str) Str {
    let i = sc_at
    let j = i
    if j < raw.len() and raw.get(j) == 63 { j += 1 }
    if j >= raw.len() or not is_upper_code(raw.get(j)) { return "" }
    while (j < raw.len() and is_word_code(raw.get(j))) { j += 1 }
    if j < raw.len() and raw.get(j) == 91 {
        let depth = 0
        while (j < raw.len()) {
            if raw.get(j) == 91 { depth += 1 }
            if raw.get(j) == 93 {
                depth -= 1
                if depth == 0 {
                    j += 1
                    break
                }
            }
            j += 1
        }
    }
    sc_at = j
    return raw.slice(i, j)
}

fn sc_number(raw: Str) Str {
    let i = sc_at
    let j = i
    if j < raw.len() and raw.get(j) == 45 { j += 1 }
    if j >= raw.len() or raw.get(j) < 48 or raw.get(j) > 57 { return "" }
    while (j < raw.len() and raw.get(j) >= 48 and raw.get(j) <= 57) { j += 1 }
    if j + 1 < raw.len() and raw.get(j) == 46 and raw.get(j + 1) >= 48 and raw.get(j + 1) <= 57 {
        j += 1
        while (j < raw.len() and raw.get(j) >= 48 and raw.get(j) <= 57) { j += 1 }
    }
    if j < raw.len() and (raw.get(j) == 101 or raw.get(j) == 69) {
        let k = j + 1
        if k < raw.len() and (raw.get(k) == 43 or raw.get(k) == 45) { k += 1 }
        if k < raw.len() and raw.get(k) >= 48 and raw.get(k) <= 57 {
            j = k
            while (j < raw.len() and raw.get(j) >= 48 and raw.get(j) <= 57) { j += 1 }
        }
    }
    sc_at = j
    return raw.slice(i, j)
}

fn sc_keyword(raw: Str) Str {
    let i = sc_at
    for (["true", "false", "null"]) |k| {
        if text_at(raw, i, k) and (i + k.len() >= raw.len() or not is_word_code(raw.get(i + k.len()))) {
            sc_at = i + k.len()
            return k
        }
    }
    return ""
}

/// Whether a pattern can be satisfied when its field is absent: only a
/// `?T` capture or one with a default; an object pattern needs its object.
fn pattern_optional(p: I32) Bool {
    if pat_is(p, Pat.Capture) { return word_text(pat_type[p]).get(0) == 63 or pat_fallback[p] >= 0 }
    return false
}

// The site's fresh names, and an arm's captures.

let jm_serial: I32 = 0
/// By capture: its name (a word)
vec cap_name: I32
/// Its local (a word)
vec cap_local: I32
/// Its pattern.
vec cap_pat: I32
/// The current arm's declarations, as words.
vec jm_declare: I32

fn fresh_name(prefix: Str, name: Str) Str {
    let text = prefix + name + int_text(jm_serial)
    jm_serial += 1
    return text
}

/// A slice of the body as utu: in parentheses, once it parses.
fn json_splice(text: Str, start: I32, what: Str) Str {
    if not splice_parses(jc_site, start, text) {
        dsl_fail(jss1(Jst.InvalidInJsonMatch, what), start, if text.len() > 1 { text.len() } else { 1 })
    }
    return dsl_splice(jc_site, start, text)
}

/// `@json/\ match text { pattern => value, …, ~> fallback }` as utu: a
/// reader over `text`, then each arm's pattern tried in order.
fn json_match(raw: Str, prefix: Str) Str {
    jm_serial = 0
    pat_kind.clear()
    pat_name.clear()
    pat_name_start.clear()
    pat_type.clear()
    pat_type_start.clear()
    pat_fallback.clear()
    pat_fallback_start.clear()
    pat_text.clear()
    pat_first.clear()
    pat_next.clear()
    pat_key.clear()
    // Parse: the text, then arms, then one ~> arm.
    sc_at = text_index(raw, "match", 0) + 5
    let text = sc_until(raw, "{")
    let text_start = sc_until_start
    if text.len() == 0 { dsl_fail(jss(Jst.JsonMatchNeedsTheTextTo), sc_at, 1) }
    sc_expect(raw, "{")
    let arm_pattern = Array[I32].new(64, -1)
    let arm_body = Array[I32].new(64, -1)
    let arm_body_start = Array[I32].new(64, 0)
    let narms = 0
    let fallback_body = -1
    let fallback_start = 0
    let fallback_binding = -1
    while (not sc_peek(raw, "}")) {
        if sc_peek(raw, "~>") {
            if fallback_body >= 0 { dsl_fail(jss(Jst.JsonMatchHasMoreThanOne), sc_at, 2) }
            sc_expect(raw, "~>")
            if sc_peek(raw, "|") {
                sc_expect(raw, "|")
                let binding = sc_word(raw, false)
                if binding.len() == 0 { dsl_fail(jss(Jst.ExpectedANameForTheError), sc_at, 1) }
                fallback_binding = intern_text(binding)
                sc_expect(raw, "|")
            }
            fallback_body = intern_text(sc_until(raw, ",}"))
            fallback_start = sc_until_start
        } else {
            if fallback_body >= 0 { dsl_fail(jss(Jst.TheArmMustBeLastIn), sc_at, 1) }
            let pattern = parse_pattern(raw)
            sc_expect(raw, "=>")
            if narms == 64 { dsl_fail(jss(Jst.JsonMatchSupportsAtMost64), sc_at, 1) }
            arm_pattern[narms] = pattern
            arm_body[narms] = intern_text(sc_until(raw, ",}"))
            arm_body_start[narms] = sc_until_start
            narms += 1
        }
        if not sc_peek(raw, "}") { sc_expect(raw, ",") }
    }
    sc_expect(raw, "}")
    if sc_ws(raw) < raw.len() { dsl_fail(jss(Jst.UnexpectedTextAfterJsonMatch), sc_at, 1) }
    if narms == 0 { dsl_fail(jss(Jst.JsonMatchNeedsAtLeastOne), sc_at, 1) }
    if fallback_body < 0 { dsl_fail(jss(Jst.JsonMatchNeedsAArmFor), sc_at, 1) }
    // Generate.
    let r = fresh_name(prefix, jss(Jst.ReaderLc))
    let best = fresh_name(prefix, jss(Jst.Error))
    let best_at = fresh_name(prefix, jss(Jst.ErrorAt))
    let best_matched = fresh_name(prefix, jss(Jst.ErrorMatched))
    let fallback = json_splice(word_text(fallback_body), fallback_start, jss(Jst.Fallback))
    let code = jss2(Jst.BraceSpaceASpaceBSemiSpaceBraceEnd, (if fallback_binding >= 0 { jss2(Jst.Let, word_text(fallback_binding), best) } else { "" }), fallback)
    let index = narms - 1
    while (index >= 0) {
        cap_name.clear()
        cap_local.clear()
        cap_pat.clear()
        jm_declare.clear()
        let read = read_pattern(arm_pattern[index], "", r, prefix)
        let declare = ""
        for (0 ..< jm_declare.len()) |k| { declare = jss2(Jst.ABSpace, declare, word_text(jm_declare[k])) }
        // Each capture is marked present where it is read; a default fills
        // one whose field was absent; then each is bound by its name.
        let marked = read
        let has_decls = ""
        let fill = ""
        let bind = ""
        for (0 ..< cap_name.len()) |k| {
            let p = cap_pat[k]
            let local = word_text(cap_local[k])
            let has = fresh_name(prefix, jss(Jst.Has))
            has_decls = jss2(Jst.LetFalse, has_decls, has)
            marked = replace_first(marked, jss1(Jst.ASpaceEqSpace, local), jss2(Jst.True, has, local))
            if pat_fallback[p] >= 0 {
                let value = json_splice(word_text(pat_fallback[p]), pat_fallback_start[p], jss1(Jst.DefaultFor, word_text(pat_name[p])))
                fill = jss4(Jst.IfNot, fill, has, local, value)
            }
            bind = jss4(Jst.LetColonEqSemi, bind, word_text(cap_name[k]), type_ref(word_text(pat_type[p])), local)
        }
        let body = json_splice(word_text(arm_body[index]), arm_body_start[index], jss(Jst.ArmBody))
        code = jss4(Jst.JsonEnd, (if index > 0 { jss1(Jst.JsonRestart, r) } else { "" }), declare, has_decls, marked) + jss4(Jst.IfFailed0, r, r, fill, bind) + jss4(Jst.ElseIfMatchedOrMatched, body, r, best_matched, r) + jss4(Jst.AndFailed, best_matched, r, best_at, best_matched) + jss4(Jst.MatchedFailedJsonDescribe, r, best_at, r, best) + jss2(Jst.ACloseSemiNlSpaceBraceEndSemiNlSpaceBSemiNlSpace, r, code)
        index -= 1
    }
    return jss4(Jst.LetJsonReaderLetLet0, r, json_splice(text, text_start, jss(Jst.TextExpression)), best, best_at) + jss2(Jst.N1, best_matched, code)
}

/// Statements reading pattern p from r, assigning its captures; its
/// declarations go to `jm_declare`.
fn read_pattern(p: I32, path: Str, r: Str, prefix: Str) Str {
    let where = js_string(path)
    if pat_is(p, Pat.Capture) {
        let name = word_text(pat_name[p])
        for (0 ..< cap_name.len()) |k| {
            if cap_name[k] == pat_name[p] { dsl_fail(jss1(Jst.IsCapturedTwiceInThisPattern, name), pat_name_start[p], name.len()) }
        }
        let type = word_text(pat_type[p])
        jc_type_at = pat_type_start[p]
        jc_type_len = type.len()
        shape_kind(type)
        let local = fresh_name(prefix, jss1(Jst.Capture, name))
        cap_name.push(pat_name[p])
        cap_local.push(intern_text(local))
        cap_pat.push(p)
        let ok = fresh_name(prefix, "ok")
        let read = json_read(type, r)
        let zero = json_zero(type, -1)
        jm_declare.push(intern_text(jss3(Jst.LetLc, local, type_ref(type), zero)))
        return jss4(Jst.LetFailed0JsonAt, ok, r, local, read) + jss3(Jst.ACommaSpaceBCommaSpaceCCloseSemi, r, ok, where)
    }
    if pat_is(p, Pat.Literal) {
        let ok = fresh_name(prefix, "ok")
        let text = word_text(pat_text[p])
        let expected = js_string(jss1(Jst.Expected, text))
        let c = text.get(0)
        let check = if c == 34 {
            jss4(Jst.JsonSpanIfFailed0And, r, r, r, name_ref(json_unescape(text))) + jss2(Jst.ACommaSpaceBCloseSemiSpaceBraceEndSemi, r, expected)
        } else if c == 116 or c == 102 {
            jss4(Jst.IfJsonBoolJsonFail, r, text, r, expected)
        } else if c == 110 {
            jss3(Jst.IfNotJsonNullJsonFail, r, r, expected)
        } else {
            // An integer literal matches only an integer token (kl: no fraction or exponent).
            let integer = float_text(text) == jss1(Jst.N0, text)
            // A long one is an F64 beyond its exact range: the token's text is compared too.
            let exact = if integer and text.len() > 15 { jss4(Jst.OrAtOrTextSliceAt, r, int_text(text.len()), r, r) + jss3(Jst.At, int_text(text.len()), r, js_string(text)) } else { "" }
            jss4(Jst.IfJsonF64JsonFail, r, float_text(text), (if integer { jss2(Jst.OrKl0, r, exact) } else { "" }), r) + jss1(Jst.ACloseSemiSpaceBraceEndSemi, expected)
        }
        return jss4(Jst.LetFailed0JsonAtEqDotEqEqSemiOpe, ok, r, check, r) + jss2(Jst.ACommaSpaceBCloseSemi, ok, where)
    }
    // An object: one pass over its fields, matching the ones the pattern names.
    let more = fresh_name(prefix, jss(Jst.More))
    let arms = ""
    let required = ""
    let f = pat_first[p]
    while (f >= 0) {
        let key = word_text(pat_key[f])
        let seen = fresh_name(prefix, jss(Jst.Seen))
        let read = read_pattern(f, if path.len() > 0 { jss2(Jst.ADotB, path, key) } else { key }, r, prefix)
        jm_declare.push(intern_text(jss1(Jst.LetFalseEqSemi, seen)))
        arms = jss4(Jst.IfJsonIs, arms, r, name_ref(key), read) + jss1(Jst.TrueElseEqSemiBraceEnd, seen)
        if not pattern_optional(f) {
            required = jss4(Jst.IfNotIfFailed0Where, required, seen, r, r) + jss3(Jst.JsonMissing, where, r, js_string(key))
        }
        f = pat_next[f]
    }
    let ok = fresh_name(prefix, "ok")
    return jss4(Jst.LetFailed0JsonOpen123, ok, r, r, r) + jss4(Jst.LetJsonFirst125While, ok, where, more, r) + jss4(Jst.JsonSpanJsonColonJsonSkip, more, r, r, arms) + jss4(Jst.JsonNext125, r, more, r, required)
}

/// A JSON number as a utu F64 literal: `3` is `3.0`, `1e5` is `1.0e5`.
fn float_text(text: Str) Str {
    if text_index(text, ".", 0) >= 0 { return text }
    let e = text_index(text, jss(Jst.E), 0)
    if e < 0 { e = text_index(text, jss(Jst.E2), 0) }
    if e < 0 { return jss1(Jst.N0, text) }
    return jss2(Jst.N0Dot, text.slice(0, e), text.slice(e, text.len()))
}

