fn jss(t: Jst) Str => st(st_json + t.i32())
fn jss1(t: Jst, a: Str) Str => stf(st_json + t.i32(), a, "", "", "")
fn jss2(t: Jst, a: Str, b: Str) Str => stf(st_json + t.i32(), a, b, "", "")
fn jss3(t: Jst, a: Str, b: Str, c: Str) Str => stf(st_json + t.i32(), a, b, c, "")
fn jss4(t: Jst, a: Str, b: Str, c: Str, d: Str) Str => stf(st_json + t.i32(), a, b, c, d)
