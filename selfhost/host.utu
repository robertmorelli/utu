//! = The host
//!
//! What a program needs from its JavaScript host. An `@es` binding
//! (`let f: fun(I32) I32 = @es/\ (x) => x + 1 \/;`) is an imported function,
//! `__es_N` of the module `es`; a binding of another type is an imported
//! function of no arguments that returns its value, called at each read.
//! The bodies go into the module's `utu` custom section as JSON, in the form
//! `src/runtime/host-imports.js` reads: `{"es":{"es":{"__es_0":"…"}}}`.

/// By declaration: its `@es` binding's imported function, or -1.
vec decl_es: I32;
/// The @es imports (and host declarations' operations), in order.
vec es_func: I32;
/// The JS of each: a span of src; or, made by the compiler (es_start -1),
/// es_end is a word id of its text.
vec es_start: I32;
vec es_end: I32;
/// Each binding's imports, one a type: (declaration, import) pairs.
vec es_made_decl: I32;
vec es_made_func: I32;
/// And how its values convert (a word of @es_wrap's text); decl_es_wrap is decl_es's.
vec es_made_wrap: I32;
vec decl_es_wrap: I32;

fn reset_host() void {
    decl_es.resize(decl_kind.len());
    decl_es_wrap.resize(decl_kind.len());
    for (0 ..< decl_kind.len()) |d| { decl_es[d] = -1; };
    es_func.clear();
    es_start.clear();
    es_end.clear();
    es_made_decl.clear();
    es_made_func.clear();
    es_made_wrap.clear();
}

//! = @wat
//!
//! A function whose whole body is `@wat/\ … \/` is WebAssembly text. The
//! host assembles it (src/wat/assemble.js) once the program is loaded, from
//! the function's parameters and result as written, and gives back its code
//! (locals, instructions, `end`), which is the function's body in the
//! module; or a mistake, at a place in the text, which ends the build as a
//! DSL's does.

/// By site: the `@wat` expression that is a function's body.
vec wat_site: I32;
/// Its code in wat_bytes, or -1.
vec wat_start: I32;
vec wat_len: I32;
/// A mistake: its message (a span of src, from the host), or -1.
vec wat_message: I32;
vec wat_message_end: I32;
/// And where it is in the text (UTF-16 offsets).
vec wat_from: I32;
vec wat_to: I32;
vec wat_found: I32 = [0];
export mem wat_bytes: U8;

fn reset_wat() void {
    wat_found[0] = 0;
    wat_site.clear();
    wat_start.clear();
    wat_len.clear();
    wat_message.clear();
    wat_message_end.clear();
    wat_from.clear();
    wat_to.clear();
    wat_bytes.clear();
}

fn is_wat(node: I32) Bool { is_kind(node, Node.Dsl_expr) and word_of(first_child(node)) == known_word(Known.Wat); }

/// Finds the program's `@wat` functions' sites (once). Returns how many.
fn find_wat() I32 {
    if wat_found[0] == 1 { return wat_site.len(); };
    wat_found[0] = 1;
    intern_known();
    for (0 ..< dsl_sites.len()) |k| {
        let n = dsl_sites[k];
        if is_wat(n) and wat_function_of(n) >= 0 {
            wat_site.push(n);
            wat_start.push(-1);
            wat_len.push(0);
            wat_message.push(-1);
            wat_message_end.push(-1);
            wat_from.push(0);
            wat_to.push(0);
        };
    };
    wat_site.len();
}

/// The function (or `export main`) whose whole body site `n` is, or -1.
fn wat_function_of(n: I32) I32 {
    let block = parent_of(n);
    if block < 0 or not is_kind(block, Node.Block) or first_child(block) != n or next_sibling(n) >= 0 { return -1; };
    let f = parent_of(block);
    if f >= 0 and (is_kind(f, Node.Fn_decl) or is_kind(f, Node.Export_main_decl)) and last_child(f) == block { f; } else { -1; };
}

/// The site of the `@wat` function whose body is `block`, or -1.
fn wat_of(block: I32) I32 {
    let e = first_child(block);
    if e < 0 or not is_wat(e) { return -1; };
    for (0 ..< wat_site.len()) |k| { if wat_site[k] == e { return k; }; };
    -1;
}

/// Each `@wat` function the host did not assemble is a mistake: the host's,
/// at its place in the text, or (with no host to assemble it) the site's.
fn report_wat() void {
    find_wat();
    for (0 ..< wat_site.len()) |k| {
        if wat_start[k] < 0 {
            let site = wat_site[k];
            if wat_message[k] >= 0 {
                let word = src.intern(wat_message[k], wat_message_end[k]);
                if wat_from[k] < 0 {
                    report3(Diag.DslError, site, word, tok_start[node_first[site]], tok_end[node_last[site] - 1], -1);
                } else {
                    let a = dsl_byte(site, wat_from[k]);
                    report3(Diag.DslError, site, word, a, dsl_byte(site, wat_to[k]), -1);
                };
            } else {
                report(Diag.WatHost, site, -1);
            };
        };
    };
}

/// A `/\` in a DSL body that no `@name` opens (JavaScript's `/\s+/` or
/// `/\//`) still nests, as the lexers balance bodies: the body then ends at
/// a later `\/` than meant, and can take the declarations after it. Each is
/// reported where it is.
fn report_bare_openers() void {
    let done_start = vl_begin();
    for (own_sites() ..< dsl_sites.len()) |k| {
        let n = dsl_sites[k];
        let file = file_of_token(node_first[n]);
        let t = node_first[n];
        while (t < node_last[n] and tok_kind[t] != Tok.DslBody.to_i32()) { t += 1; };
        if is_own_file(file) and t < node_last[n] and not scanned_before(done_start, tok_start[t]) {
            vl_add(tok_start[t]);
            vl_add(tok_end[t]);
            let at = first_bare_opener(tok_start[t] + 2, tok_end[t] - 2);
            while (at >= 0) {
                report3(Diag.DslError, n, intern_text("This /\\ opens a nested body, so the body ends at a later \\/"), at, at + 2, -1);
                at = first_bare_opener(at + 2, tok_end[t] - 2);
            };
        };
    };
    vl_end(done_start);
}

/// The first `/\` in `src[from ..< end_]` that no `@name` opens, outside
/// double-quoted strings (as the lexers skip them), or -1.
fn first_bare_opener(from: I32, end_: I32) I32 {
    let i = from;
    while (i < end_) {
        let c = src[i];
        if c == 34 {
            i += 1;
            while (i < end_ and src[i] != 34 and src[i] != 10) { i += if src[i] == 92 and src[i + 1] != 10 { 2; } else { 1; }; };
        } else if c == 47 and src[i + 1] == 92 {
            if not opened_by_name(from, i) { return i; };
            i += 1;
        };
        i += 1;
    };
    -1;
}

/// The line (from 1) of byte `at` in its file.
fn line_of_byte(at: I32) I32 {
    let file = 0;
    for (0 ..< file_start.len()) |f| { if file_start[f] <= at and at <= file_end[f] { file = f; }; };
    let line = 1;
    for (file_start[file] ..< at) |i| { if src[i] == 10 { line += 1; }; };
    line;
}

/// Whether a body scanned before (its start and end pairs, pending since `m`) holds byte `at`.
fn scanned_before(m: I32, at: I32) Bool {
    let i = m;
    while (i + 1 < vl_pending.len()) {
        if vl_pending[i] <= at and at < vl_pending[i + 1] { return true; };
        i += 2;
    };
    false;
}

/// Whether `@name` (and spaces) comes just before byte `at`, after `from`.
fn opened_by_name(from: I32, at: I32) Bool {
    let i = at;
    while (i > from and is_space(src[i - 1])) { i -= 1; };
    let word_end = i;
    while (i > from and is_word_byte(src[i - 1])) { i -= 1; };
    i < word_end and i > from and src[i - 1] == 64;
}

fn is_word_byte(c: I32) Bool { c == 95 or (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122); }

/// Whether a node is `@es/\ … \/`.
fn is_es(node: I32) Bool { is_kind(node, Node.Dsl_expr) and word_of(first_child(node)) == known_word(Known.Es); }

/// The imported function of an `@es` binding of type `t`, imported once
/// for each type the binding has (a module's instances may give it several).
fn es_import(decl: I32, dsl: I32, t: I32) I32 {
    let ft = es_signature(t);
    let open = es_wrap(t);
    let wrap = intern_text(open);
    if decl_es[decl] >= 0 and func_type_of[decl_es[decl]] == ft and decl_es_wrap[decl] == wrap { return decl_es[decl]; };
    decl_es_wrap[decl] = wrap;
    // In a module's instances a binding has a type each, and an import each:
    // decl_es is the current instance's.
    for (0 ..< es_made_decl.len()) |k| {
        if es_made_decl[k] == decl and func_type_of[es_made_func[k]] == ft and es_made_wrap[k] == wrap {
            decl_es[decl] = es_made_func[k];
            return es_made_func[k];
        };
    };
    // A body uses only its parameters and globals, so one seen before with
    // this signature is that import: generated code (wutu's) repeats a few.
    let at = dsl_text_start(dsl);
    let end = dsl_text_end(dsl);
    // Wrapped, when values cross converted: after the body's imports.
    let made = src.len();
    if open.len() > 0 {
        let split = es_imports_end(at, end);
        gen_text_utf8(bytes_text(at, split) + open + bytes_text(split, end) + ")");
        at = made;
        end = src.len();
    };
    for (0 ..< es_func.len()) |k| {
        if func_type_of[es_func[k]] == ft and bytes_equal(es_start[k], es_end[k], at, end) {
            if open.len() > 0 { src.resize(made); };
            decl_es[decl] = es_func[k];
            es_made_decl.push(decl);
            es_made_func.push(es_func[k]);
            es_made_wrap.push(wrap);
            return es_func[k];
        };
    };
    let f = add_import_func(name_add("es"), name_add("__es_" + es_func.len().to_str()), ft);
    let w = decl_name[decl];
    func_debug_name[f] = name_from_src(src.interned_start(w), src.interned_start(w) + src.interned_size(w));
    decl_es[decl] = f;
    es_made_decl.push(decl);
    es_made_func.push(f);
    es_made_wrap.push(wrap);
    es_func.push(f);
    es_start.push(at);
    es_end.push(end);
    f;
}

/// What an `@es` body is wrapped in, before it and `)`, so values cross as
/// docs/typescript-abi.md says: a Bool argument as a boolean, a U32 or U64
/// one unsigned; a Bool result as 1 or 0, an absent one as null. "" for none.
fn es_wrap(t: I32) Str {
    if not ty_is(t, Ty.Fun) {
        let out = es_out("v", t);
        return if out == "v" { ""; } else { "(v => " + out + ")("; };
    };
    let params = ty_a[t];
    let names = "";
    let args = "";
    let changed = false;
    for (0 ..< vl_len[params]) |i| {
        let name = "p" + i.to_str();
        let arg = es_in(name, vl_item(params, i));
        if arg != name { changed = true; };
        names = names + (if i > 0 { ","; } else { ""; }) + name;
        args = args + (if i > 0 { ","; } else { ""; }) + arg;
    };
    let call = "f(" + args + ")";
    let out = es_out(call, ty_b[t]);
    if not changed and out == call { return ""; };
    "(f => (" + names + ") => " + out + ")(";
}

/// A wasm value to JS: Bool a boolean, U32 and U64 unsigned.
fn es_in(name: Str, t: I32) Str {
    if t == prelude(Prelude.Bool) { return "!!" + name; };
    if t == prelude(Prelude.U32) { return name + " >>> 0"; };
    if t == prelude(Prelude.U64) { return "BigInt.asUintN(64, " + name + ")"; };
    name;
}

/// A JS value to wasm: Bool 1 or 0, undefined null.
fn es_out(expr: Str, t: I32) Str {
    if t == prelude(Prelude.Bool) { return expr + " ? 1 : 0"; };
    if ty_is(t, Ty.Nullable) { return expr + " ?? null"; };
    expr;
}

/// Where the `import …;` declarations an `@es` body opens with end (as
/// src/runtime/host-imports.js splits them).
fn es_imports_end(at: I32, end_: I32) I32 {
    let i = at;
    let done = i;
    while (true) {
        while (i < end_ and is_space(src[i])) { i += 1; };
        if not (i + 7 <= end_ and bytes_text(i, i + 6) == "import" and is_space(src[i + 6])) { return done; };
        while (i < end_ and src[i] != 59) { i += 1; };
        if i >= end_ { return done; };
        i += 1;
        done = i;
    };
    done;
}

/// A fun type's signature; for another type, `()` → its value.
fn es_signature(t: I32) I32 {
    if ty_is(t, Ty.Fun) { return fun_heap(t); };
    func_type(vl_empty(), vl_of_result(repr(t)));
}

/// A read of an `@es` binding of type `t`: the function as a value, or the
/// value its accessor returns.
fn es_read(decl: I32, t: I32) I32 {
    let f = decl_es[decl];
    if ty_is(t, Ty.Fun) { w_leaf(Op.RefFunc, vt_ref(func_type_of[f], false), f, 0); }
    else { w_leaf(Op.Call, repr(t), f, 0); };
    t;
}

//! = The custom section

fn json_byte(b: I32) void { host_json.push(b); }

fn json_text(text: Str) void { for (0 ..< text.len()) |i| { host_json.push(text.get(i)); }; }

/// A JSON string of `src[start ..< end_]`.
fn json_string(start: I32, end_: I32) void {
    json_byte(34);
    for (start ..< end_) |i| {
        let c = src[i];
        if c == 34 or c == 92 {
            json_byte(92);
            json_byte(c);
        } else if c == 10 { json_text("\\n"); }
        else if c == 13 { json_text("\\r"); }
        else if c == 9 { json_text("\\t"); }
        else if c < 32 {
            json_text("\\u00");
            json_byte(hex_digit(c >> 4));
            json_byte(hex_digit(c & 15));
        } else {
            json_byte(c);
        };
    };
    json_byte(34);
}

fn hex_digit(d: I32) I32 { if d < 10 { 48 + d; } else { 87 + d; }; }

/// Where the body of `@name/\ body \/` starts, without its delimiters and
/// outer spaces; @dsl_text_end is where it ends.
fn dsl_text_start(dsl: I32) I32 {
    let t = node_first[last_child(dsl)];
    let i = tok_start[t] + 2;
    let end_ = tok_end[t] - 2;
    while (i < end_ and is_space(src[i])) { i += 1; };
    i;
}

fn dsl_text_end(dsl: I32) I32 {
    let t = node_first[last_child(dsl)];
    let i = tok_end[t] - 2;
    let start = tok_start[t] + 2;
    while (i > start and is_space(src[i - 1])) { i -= 1; };
    i;
}

fn is_space(c: I32) Bool { c == 32 or c == 10 or c == 9 or c == 13; }

/// Writes the host section for what the module imports (after the sweep):
/// `host_json`, empty when there is nothing to say.
fn write_host_json() void {
    host_json.clear();
    json_byte(123);
    json_part(0);
    json_part(1);
    json_part(2);
    json_part(3);
    json_part(4);
    json_part(5);
    json_byte(125);
    // Nothing to say: no section.
    if host_json.len() == 2 { host_json.clear(); };
}

/// One part of the host section (es, closures, promises, mems, lazy, exports), after a comma
/// when another came before it.
fn json_part(k: I32) void {
    let before = host_json.len();
    if before > 1 { json_byte(44); };
    let start = host_json.len();
    if k == 0 { write_es_json(); } else if k == 1 { write_closure_json(); } else if k == 2 { write_promise_json(); } else if k == 3 { write_mems_json(); } else if k == 4 { write_lazy_json(); } else { write_exports_json(); };
    if host_json.len() == start { host_json.resize(before); };
}

fn write_es_json() void {
    let any = false;
    for (0 ..< es_func.len()) |i| { if func_live[es_func[i]] == 1 { any = true; }; };
    if not any { return; };
    json_text("\"es\":{\"es\":{");
    let first = true;
    for (0 ..< es_func.len()) |i| {
        let f = es_func[i];
        if func_live[f] == 1 {
            if not first { json_byte(44); };
            first = false;
            json_byte(34);
            let name = func_field_name[f];
            for (0 ..< name_len[name]) |k| { json_byte(names[name_start[name] + k]); };
            json_byte(34);
            json_byte(58);
            if es_start[i] < 0 { json_text_string(word_text(es_end[i])); } else { json_string(es_start[i], es_end[i]); };
        };
    };
    json_text("}}");
}

/// A JSON string of `text` (ASCII, as the compiler writes its own JS).
fn json_text_string(text: Str) void {
    json_byte(34);
    for (0 ..< text.len()) |i| {
        let c = text.get(i);
        if c == 34 or c == 92 { json_byte(92); };
        json_byte(c);
    };
    json_byte(34);
}

/// The exports whose results JS reads otherwise than wasm gives them, by
/// name: `"exports":{"main":"U32"}`. A Bool is true or false, a U32 or U64
/// unsigned (src/runtime/host-imports.js convertExports).
fn write_exports_json() void {
    let first = true;
    for (0 ..< export_func.len()) |k| {
        let f = export_func[k];
        let t = export_result[k];
        let kind = if t == prelude(Prelude.Bool) { "Bool"; } else if t == prelude(Prelude.U32) { "U32"; } else if t == prelude(Prelude.U64) { "U64"; } else { ""; };
        if kind.len() > 0 and func_live[f] == 1 and func_field_name[f] >= 0 {
            json_text(if first { "\"exports\":{"; } else { ","; });
            first = false;
            json_byte(34);
            let name = func_field_name[f];
            for (0 ..< name_len[name]) |i| { json_byte(names[name_start[name] + i]); };
            json_text("\":\"" + kind + "\"");
        };
    };
    if not first { json_byte(125); };
}

/// The lazy modules' functions the program calls (see lazy_stub), for the
/// build that makes their chunks: path, module, name, signature, file.
fn write_lazy_json() void {
    if lazy_call_fn.len() == 0 { return; };
    json_text("\"lazy\":[");
    for (0 ..< lazy_call_fn.len()) |k| {
        if k > 0 { json_byte(44); };
        let decl = lazy_call_fn[k];
        let module = module_of(decl);
        json_text("{\"path\":");
        json_text_string(word_text(lazy_path[lazy_call_path[k]]));
        json_text(",\"module\":");
        json_text_string(word_text(decl_name[module]));
        json_text(",\"name\":");
        json_text_string(word_text(decl_name[decl]));
        json_text(",\"signature\":");
        json_text_string(word_text(lazy_call_sig[k]));
        json_text(",\"file\":" + file_of_token(node_first[decl_node[module]]).to_str() + "}");
    };
    json_byte(93);
}
