//! = Names
//!
//! Name resolution: every declaration in the program gets an id, and every
//! name in the tree that refers to one records it (`node_decl`). Names that
//! only a type can settle (`x.field`, `x.method()`) are left to type checking.
//!
//! Declarations are rows of the `decl_*` mems. Lexical scopes are a stack of
//! bindings: `word_top` holds, for each word id, its innermost binding, and
//! each binding remembers the one it hides, so a lookup is one load and
//! leaving a scope pops back to a mark.
//!
//! Members (a module's types, functions, and globals; a struct's fields; an
//! enum's variants; methods and operators of a type) are a hash table keyed
//! by owner, word, and space.
//!
//! The program's names:
//!
//! - The program scope: every module of every file (the prelude's first, so
//!   anything else hides them), every `using … |Alias|`, and the entry file's
//!   own declarations.
//! - A module: its type parameters and its members, which also see `&`.
//! - A function: its parameters; a block: its `let`s, from each on; a `for`,
//!   an iterator stage, an `alt` or `promote` arm, a `catch`, a closure: what
//!   it captures or binds.
//!
//! Imported files contribute their modules and aliases, not their other
//! top-level declarations (nor their tests, benches, or exports).
//!
//! Methods are registered before any body is resolved, so `T.method` finds
//! methods declared anywhere.

/// What a declaration is: the kind of each row of the `decl_` tables.
enum(U8) Decl:
    | Module
    | Foreign
    | ModuleParam
    | Struct
    | Enum
    | IntEnum
    | Variant
    | Field
    | Proto
    | ProtoMember
    | TypeDecl
    | Distinct
    | Alias
    | Fn
    | Global
    | Mem
    | Param
    | SelfParam
    | Local
    | Capture
    | ClosureParam
    | ArmBinding
    | Promoted
    | Caught
    | Main

/// By declaration (its id): its Decl.
vec decl_kind: U8;
/// Its name's word id, or -1.
vec decl_name: I32;
/// The node that declares it.
export mem decl_node: I32;
/// The declaration it is part of (module, struct, enum, function), or -1.
export mem decl_owner: I32;
/// Module: its promoted type (`&`), or -1. ModuleParam: its index. Fn: the
/// type it is a method or operator of, or -1. Alias: the module it names.
/// Field: its index.
vec decl_a: I32;

/// The declaration a name node refers to, by node; -1 for none.
export mem node_decl: I32;

/// A new declaration: its id.
fn declare(kind: Decl, name: I32, node: I32, owner: I32) I32 {
    let id = decl_kind.len();
    decl_kind.push(kind.to_i32());
    decl_name.push(name);
    decl_node.push(node);
    decl_owner.push(owner);
    decl_a.push(-1);
    id;
}

fn decl_is(decl: I32, kind: Decl) Bool { decl >= 0 and decl_kind[decl] == kind.to_i32(); }

/// Whether a declaration names a type (a module names its promoted type).
fn is_type_decl(decl: I32) Bool {
    let k = decl_kind[decl];
    k == Decl.Module.to_i32() or k == Decl.Foreign.to_i32() or k == Decl.ModuleParam.to_i32() or k == Decl.Struct.to_i32()
        or k == Decl.Enum.to_i32() or k == Decl.IntEnum.to_i32() or k == Decl.Variant.to_i32()
        or k == Decl.Proto.to_i32() or k == Decl.TypeDecl.to_i32() or k == Decl.Distinct.to_i32()
        or k == Decl.Alias.to_i32();
}

//! = Diagnostics

/// Every mistake the compiler reports; `diag.utu` gives each its message.
enum(U8) Diag:
    | UnknownVariable
    | UnknownType
    | UnknownModule
    | UnknownImport
    | DuplicateDeclaration
    | NotAModule
    | TypeMismatch
    | UnknownMethod
    | UnknownOperator
    | WrongArity
    | AssignmentToImmutable
    | InvalidBreak
    | Unsupported
    | ParseError
    | DuplicateField
    | InvalidNullableType
    | TupleMisplaced
    | FunInField
    | InvalidGlobalInitializer
    | RecursiveType
    | IntegerOutOfRange
    | BareNull
    | InvalidDistinct
    | EnumValueRange
    | EnumValueTwice
    | ImplicitStructInit
    | UnknownField
    | MissingField
    | NullableAccess
    | MemIndex
    | ConstMem
    | MemNotValue
    | MemKind
    | NonDefaultable
    | InvalidModuleArity
    | NotCallable
    | AltNotEnum
    | UnknownVariant
    | NonExhaustive
    | MatchType
    | MatchPattern
    | DuplicatePattern
    | NotNullable
    | InvalidForSource
    | InternNotBytes
    | MemInitializer
    | MemElementRange
    | ClosureParamType
    | GeneratorRecursion
    | YieldOutside
    | GeneratorReturnValue
    | GeneratorCall
    | YieldInClosure
    | IteratorUnfinished
    | IteratorSource
    | IteratorCaptures
    | IteratorTerminalInside
    | OptionalOutsideStatement
    | AwaitNotPromise
    | InvalidDefer
    | AwaitForSource
    | ProtoMissing
    | ProtoSignature
    | MemEmbed
    | MemView
    | InvalidDslUsage
    | MemNoMethod
    | TupleLet
    | GeneratorPassThrough
    | GeneratorArity
    | MemTwice
    | MemClash
    | PruneOutside
    | PruneInClosure
    | UnknownForeignMember
    | ForeignReadonly
    | ForeignOverload
    | ForeignRecordField
    | ForeignRecordMissing
    | ForeignNotArray
    | HostAltArm
    | HostAltClass
    | DslError
    | TooManyMems
    | VecHost
    | AwaitForCapture
    | WatPlace
    | WatHost
    | EntrySurface
    | InvalidEscape
    | AwaitInClosure
    | LazyValue
    | UnknownMember
    | DslPlace
    | StorageType
    | ReturnValueFromVoid
    | ComptimeTrap
    | DslEmpty
    | ComptimeCycle
    | IrOutsideStd
    | DslTooDeep

/// A diagnostic: its kind, the node it is about, a word, and up to three
/// more arguments (types, counts, declarations) its message is made from
/// (see `diag.utu`).
vec diag_kind: U8;
vec diag_node: I32;
vec diag_word: I32;
vec diag_a: I32;
vec diag_b: I32;
vec diag_c: I32;

/// What a diagnostic says beyond its message and span, for the host to draw
/// (see `diagnostic_extra_*` in lib.utu): a label on its own span, other
/// places it is about (each with a role and a label), notes, and a fix, one
/// edit of the source. A diagnostic owns a run of extra rows, `diag_extra_n`
/// of them from `diag_extra`; rows are added right after the report, so the
/// run is unbroken.
vec diag_extra: I32;
vec diag_extra_n: I32;
/// A row: its @Extra kind; for a place, its node (-1: the diagnostic's own
/// span), or bytes `extra_node ..< extra_end` when `extra_end` is not -1 (for
/// a label, the part of its own span to show: its focus); for a fix, the
/// bytes it replaces; and its text (a label, a note, or a fix's new text)
/// and a fix's label, both interned (-1 for none).
vec extra_kind: U8;
vec extra_node: I32;
vec extra_end: I32;
vec extra_text: I32;
vec extra_label: I32;
/// Whether the last report made a diagnostic (a repeat makes none, and its extras go nowhere).
vec diag_fresh: U8 = [0];

/// What an extra row is. A place's kind is the role it plays: where the
/// requirement came from, where the value came from, or other context.
enum(U8) Extra:
    | Here
    | Expected
    | Found
    | Related
    | Note
    | Fix

fn add_extra(kind: Extra, node: I32, end_: I32, text: I32, label: I32) void {
    if diag_fresh[0] == 0 { return; };
    let i = diag_kind.len() - 1;
    if diag_extra_n[i] == 0 { diag_extra[i] = extra_kind.len(); };
    extra_kind.push(kind.to_i32());
    extra_node.push(node);
    extra_end.push(end_);
    extra_text.push(text);
    extra_label.push(label);
    diag_extra_n[i] += 1;
}

/// A label on the last diagnostic's own span.
fn diag_label(label: Str) void {
    if diag_fresh[0] == 1 { add_extra(Extra.Here, -1, -1, intern_text(label), -1); };
}

/// The part of the last diagnostic's span to show (tokens `first` to `last`), with a label.
fn diag_focus(first: I32, last: I32, label: Str) void {
    if diag_fresh[0] == 1 { add_extra(Extra.Here, tok_start[first], tok_end[last], intern_text(label), -1); };
}

/// Another place the last diagnostic is about, by tokens `first` to `last`.
fn diag_place_tokens(role: Extra, first: I32, last: I32, label: Str) void {
    if first >= 0 and diag_fresh[0] == 1 { add_extra(role, tok_start[first], tok_end[last], intern_text(label), -1); };
}

/// Another place the last diagnostic is about: node, its role, and a label.
fn diag_place(role: Extra, node: I32, label: Str) void {
    if node >= 0 and diag_fresh[0] == 1 { add_extra(role, node, -1, intern_text(label), -1); };
}

/// A note on the last diagnostic: one sentence that teaches the rule.
fn diag_note(text: Str) void {
    if diag_fresh[0] == 1 { add_extra(Extra.Note, -1, -1, intern_text(text), -1); };
}

/// A fix for the last diagnostic: source bytes `start ..< end_` become `text`.
fn diag_fix(start: I32, end_: I32, text: Str, label: Str) void {
    if diag_fresh[0] == 1 { add_extra(Extra.Fix, start, end_, intern_text(text), intern_text(label)); };
}

fn report(kind: Diag, node: I32, word: I32) void { report3(kind, node, word, -1, -1, -1); }

fn report2(kind: Diag, node: I32, word: I32, a: I32, b: I32) void { report3(kind, node, word, a, b, -1); }

/// Report a mistake (once per node, kind, and word).
fn report3(kind: Diag, node: I32, word: I32, a: I32, b: I32, c: I32) void {
    // Once for a node: a name resolved, or a type read, twice is still one mistake.
    diag_fresh[0] = 0;
    if node >= 0 {
        for (0 ..< diag_kind.len()) |i| {
            if diag_node[i] == node and diag_kind[i] == kind.to_i32() and diag_word[i] == word { return; };
        };
    };
    diag_fresh[0] = 1;
    diag_extra.push(-1);
    diag_extra_n.push(0);
    diag_kind.push(kind.to_i32());
    diag_node.push(node);
    diag_word.push(word);
    diag_a.push(a);
    diag_b.push(b);
    diag_c.push(c);
}

/// Keep the first n diagnostics.
fn diag_truncate(n: I32) void {
    diag_kind.resize(n);
    diag_node.resize(n);
    diag_word.resize(n);
    diag_a.resize(n);
    diag_b.resize(n);
    diag_c.resize(n);
    diag_extra.resize(n);
    diag_extra_n.resize(n);
    diag_fresh[0] = 0;
}

/// No diagnostics, and no extra rows: a build starting over.
fn diag_reset() void {
    diag_truncate(0);
    extra_kind.clear();
    extra_node.clear();
    extra_end.clear();
    extra_text.clear();
    extra_label.clear();
}

fn diag_move(from: I32, to: I32) void {
    diag_kind[to] = diag_kind[from];
    diag_node[to] = diag_node[from];
    diag_word[to] = diag_word[from];
    diag_a[to] = diag_a[from];
    diag_b[to] = diag_b[from];
    diag_c[to] = diag_c[from];
    diag_extra[to] = diag_extra[from];
    diag_extra_n[to] = diag_extra_n[from];
}

//! = Members

/// The namespaces of a type's or module's members: a method may share a
/// field's name.
enum(U8) Space:
    | Member
    | Method
    | Operator

/// The member table, by slot: owner, key (word × 4 + Space), declaration.
/// Open addressing; a slot is empty when its key is -1. `member_fill[0]`
/// counts the slots in use.
vec member_owner: I32;
vec member_key: I32;
vec member_decl: I32;
vec member_fill: I32;

fn member_slot(owner: I32, key: I32) I32 {
    let mask = member_key.len() - 1;
    let h = (owner * -1640531535 + key * 40503) & mask;
    while (member_key[h] >= 0 and (member_key[h] != key or member_owner[h] != owner)) { h = (h + 1) & mask; };
    h;
}

fn members_reset(capacity: I32) void {
    member_owner.resize(capacity);
    member_key.resize(capacity);
    member_decl.resize(capacity);
    for (0 ..< capacity) |i| { member_key[i] = -1; };
    member_fill.resize(1);
    member_fill[0] = 0;
}

/// Add a member; returns the declaration already there under that name, or -1.
fn add_member(owner: I32, name: I32, space: Space, decl: I32) I32 {
    if name < 0 { return -1; };
    if (member_fill[0] + 1) * 2 > member_key.len() { grow_members(); };
    let key = name * 4 + space.to_i32();
    let h = member_slot(owner, key);
    if member_key[h] >= 0 { return member_decl[h]; };
    member_owner[h] = owner;
    member_key[h] = key;
    member_decl[h] = decl;
    member_fill[0] += 1;
    -1;
}

fn grow_members() void {
    let n = member_key.len();
    let owners = Array[I32].new(n, 0);
    let keys = Array[I32].new(n, 0);
    let decls = Array[I32].new(n, 0);
    for (0 ..< n) |i| {
        owners[i] = member_owner[i];
        keys[i] = member_key[i];
        decls[i] = member_decl[i];
    };
    let fill = member_fill[0];
    members_reset(n * 2);
    member_fill[0] = fill;
    for (0 ..< n) |i| {
        if keys[i] >= 0 {
            let h = member_slot(owners[i], keys[i]);
            member_owner[h] = owners[i];
            member_key[h] = keys[i];
            member_decl[h] = decls[i];
        };
    };
}

/// The member of `owner` named `name` in `space`, or -1.
fn member(owner: I32, name: I32, space: Space) I32 {
    if owner < 0 or name < 0 { return -1; };
    let h = member_slot(owner, name * 4 + space.to_i32());
    if member_key[h] < 0 { -1; } else { member_decl[h]; };
}

//! = Scopes

/// The bindings in scope, innermost last: each one's word and declaration.
vec bind_word: I32;
vec bind_decl: I32;
/// The binding this one hides, or -1.
vec bind_prev: I32;
/// By word id: the innermost binding, or -1.
vec word_top: I32;

/// Bring `decl` into scope as `word`, hiding what that word named.
fn bind(word: I32, decl: I32) void {
    if word < 0 { return; };
    bind_word.push(word);
    bind_decl.push(decl);
    bind_prev.push(word_top[word]);
    word_top[word] = bind_decl.len() - 1;
}

/// Where the scope stands: @scope_pop goes back to it.
fn scope_mark() I32 { bind_decl.len(); }

fn scope_pop(mark: I32) void {
    let i = bind_decl.len();
    while (i > mark) {
        i -= 1;
        word_top[bind_word[i]] = bind_prev[i];
    };
    bind_word.resize(mark);
    bind_decl.resize(mark);
    bind_prev.resize(mark);
}

/// The declaration `word` names in scope, or -1.
fn lookup(word: I32) I32 {
    if word < 0 { return -1; };
    let b = word_top[word];
    if b < 0 { -1; } else { bind_decl[b]; };
}

fn reset_resolve() void {
    decl_kind.clear();
    decl_name.clear();
    decl_node.clear();
    decl_owner.clear();
    decl_a.clear();
    node_decl.clear();
    diag_reset();
    bind_word.clear();
    bind_decl.clear();
    bind_prev.clear();
    word_top.clear();
    members_reset(1024);
}

//! = Declaring

/// The word node naming a declaration: an identifier or type name, itself or
/// inside a module name. -1 for `&`.
fn name_node(node: I32) I32 {
    if is_kind(node, Node.Module_name) or is_kind(node, Node.Module_ref) or is_kind(node, Node.Captured_module_name) {
        return name_node(first_child(node));
    };
    if is_kind(node, Node.Identifier) or is_kind(node, Node.Type_ident) { node; } else { -1; };
}

fn name_word(node: I32) I32 {
    let n = name_node(node);
    if n < 0 { -1; } else { word_of(n); };
}

/// A declaration named by `name_at` (or by its module when that is `&`),
/// recorded on its name node.
fn declare_named(kind: Decl, name_at: I32, node: I32, owner: I32) I32 {
    let word = name_word(name_at);
    if word < 0 and owner >= 0 and decl_is(owner, Decl.Module) { word = decl_name[owner]; };
    let decl = declare(kind, word, node, owner);
    let n = name_node(name_at);
    if n >= 0 { node_decl[n] = decl; };
    decl;
}

/// A declaration (as @declare_named makes it), a member of `owner`.
fn declare_member(kind: Decl, name_at: I32, node: I32, owner: I32) I32 {
    let decl = declare_named(kind, name_at, node, owner);
    add_member(owner, decl_name[decl], Space.Member, decl);
    decl;
}

/// A declaration (as @declare_named makes it), in scope from here.
fn declare_in_scope(kind: Decl, name_at: I32, node: I32, owner: I32) I32 {
    let decl = declare_named(kind, name_at, node, owner);
    bind(decl_name[decl], decl);
    decl;
}

/// The first child that is not a nominal qualifier.
fn after_qualifier(node: I32) I32 {
    let c = first_child(node);
    if is_kind(c, Node.Nom_qualifier) { next_sibling(c); } else { c; };
}

/// An enum's name node: after its qualifier, and after its representation
/// when it is an integer enum (`enum(U8) Tag`).
fn enum_name(node: I32) I32 {
    let c = after_qualifier(node);
    let after = next_sibling(c);
    if is_kind(after, Node.Type_ident) or is_kind(after, Node.Promoted_type) { after; } else { c; };
}

fn is_int_enum(node: I32) Bool { enum_name(node) != after_qualifier(node); }

/// Declare a type-like item (struct, enum, proto, type) and its parts.
/// Returns the declaration, or -1 when `item` is not one.
fn declare_type_item(item: I32, owner: I32) I32 {
    let kind = node_kind[item];
    if kind == Node.Struct_decl.to_i32() {
        let name_at = after_qualifier(item);
        let decl = declare_named(Decl.Struct, name_at, item, owner);
        declare_fields(item, decl);
        return decl;
    };
    if kind == Node.Enum_decl.to_i32() {
        let name_at = enum_name(item);
        let decl = declare_named(if is_int_enum(item) { Decl.IntEnum; } else { Decl.Enum; }, name_at, item, owner);
        let c = first_child(item);
        while (c >= 0) {
            if is_kind(c, Node.Variant) {
                let variant = declare_member(Decl.Variant, first_child(c), c, decl);
                let fields = next_sibling(first_child(c));
                if is_kind(fields, Node.Field_list) { declare_fields(fields, variant); };
            };
            c = next_sibling(c);
        };
        return decl;
    };
    if kind == Node.Proto_decl.to_i32() {
        let decl = declare_named(Decl.Proto, first_child(item), item, owner);
        let c = first_child(item);
        while (c >= 0) {
            if is_kind(c, Node.Proto_member) {
                let m = first_child(c);
                let name_at = first_child(m);
                declare_member(Decl.ProtoMember, name_at, m, decl);
            };
            c = next_sibling(c);
        };
        return decl;
    };
    if kind == Node.Type_decl.to_i32() { return declare_named(Decl.TypeDecl, first_child(item), item, owner); };
    if kind == Node.Distinct_decl.to_i32() { return declare_named(Decl.Distinct, first_child(item), item, owner); };
    -1;
}

fn declare_fields(holder: I32, owner: I32) void {
    let c = first_child(holder);
    let index = 0;
    while (c >= 0) {
        if is_kind(c, Node.Field) {
            let field = declare_member(Decl.Field, first_child(c), c, owner);
            decl_a[field] = index;
            index += 1;
        };
        c = next_sibling(c);
    };
}

/// Whether a type item declares `&`, its module's promoted type.
fn names_promoted(item: I32) Bool {
    let kind = node_kind[item];
    let name_at = if kind == Node.Enum_decl.to_i32() { enum_name(item); }
        else if kind == Node.Struct_decl.to_i32() { after_qualifier(item); }
        else { first_child(item); };
    is_kind(name_at, Node.Promoted_type);
}

/// A free function's name, or -1 for a method or operator.
fn free_fn_word(item: I32) I32 {
    if not is_kind(item, Node.Fn_decl) { return -1; };
    let name = first_child(first_child(item));
    if is_kind(name, Node.Identifier) and next_sibling(name) < 0 { word_of(name); } else { -1; };
}

/// A function: named when free; a method or operator is found as its type's member.
fn declare_fn(item: I32, owner: I32) I32 {
    let decl = declare(Decl.Fn, free_fn_word(item), item, owner);
    if is_kind(item, Node.Fn_decl) {
        // The name node of a free function, or of a method (its last word).
        node_decl[last_child(first_child(item))] = decl;
    } else {
        node_decl[next_sibling(first_child(item))] = decl;
    };
    decl;
}

fn declare_module(item: I32) I32 {
    let decl = declare_named(Decl.Module, first_child(item), item, -1);
    let c = next_sibling(first_child(item));
    if is_kind(c, Node.Module_type_param_list) {
        let index = 0;
        let param = first_child(c);
        while (param >= 0) {
            let p = declare_named(Decl.ModuleParam, last_child(param), param, decl);
            decl_a[p] = index;
            index += 1;
            param = next_sibling(param);
        };
        c = next_sibling(c);
    };
    while (c >= 0) {
        let kind = node_kind[c];
        let t = declare_type_item(c, decl);
        if t >= 0 {
            if names_promoted(c) { decl_a[decl] = t; } else { add_member(decl, decl_name[t], Space.Member, t); };
            if decl_is(t, Decl.Enum) {
                for (t + 1 ..< decl_kind.len()) |v| {
                    if decl_owner[v] == t { add_member(decl, decl_name[v], Space.Member, v); };
                };
            };
        } else if kind == Node.Fn_decl.to_i32() or kind == Node.Op_decl.to_i32() {
            let f = declare_fn(c, decl);
            add_member(decl, decl_name[f], Space.Member, f);
        } else if kind == Node.Global_decl.to_i32() {
            declare_member(Decl.Global, first_child(c), c, decl);
        };
        c = next_sibling(c);
    };
    decl;
}

/// A module's type parameters and members, in scope for its body.
fn bind_module(module: I32) void {
    let item = decl_node[module];
    let c = next_sibling(first_child(item));
    if is_kind(c, Node.Module_type_param_list) {
        let param = first_child(c);
        while (param >= 0) {
            let n = name_node(last_child(param));
            bind(word_of(n), node_decl[n]);
            param = next_sibling(param);
        };
    };
    bind_module_members(module);
}

/// A module's members (and the variants of its enums), by their names.
fn bind_module_members(module: I32) void {
    // In declaration order: each declaration's id follows the module's.
    let d = module + 1;
    while (d < decl_kind.len() and is_part_of(d, module)) {
        if decl_owner[d] == module and decl_kind[d] != Decl.ModuleParam.to_i32() and decl_name[d] >= 0 {
            if decl_kind[d] != Decl.Fn.to_i32() or free_fn_word(decl_node[d]) >= 0 { bind(decl_name[d], d); };
        } else if decl_is(d, Decl.Variant) and decl_is(decl_owner[d], Decl.Enum) {
            bind(decl_name[d], d);
        };
        d += 1;
    };
}

/// Whether `decl` is inside `module` (at any depth).
fn is_part_of(decl: I32, module: I32) Bool {
    let o = decl_owner[decl];
    while (o >= 0 and o != module) { o = decl_owner[o]; };
    o == module;
}

/// A `using … |Alias|` declares the alias. `using M[A];` (no alias, no
/// file) opens an instance: M's members are in scope by their own names.
fn declare_alias(item: I32) void {
    let c = first_child(item);
    let opens = false;
    while (c >= 0) {
        if is_kind(c, Node.Captured_module_name) {
            declare_in_scope(Decl.Alias, c, item, -1);
            return;
        };
        if is_kind(c, Node.Module_type_arg_list) { opens = true; };
        if is_kind(c, Node.String_lit) or is_kind(c, Node.Platform_path) { return; };
        c = next_sibling(c);
    };
    let module = lookup(name_word(first_child(item)));
    if opens and decl_is(module, Decl.Module) { bind_module_members(module); };
}

/// Lazy modules (`using … lazy from`), and each one's path as written (with its quotes).
vec lazy_module: I32;
vec lazy_path: I32;

/// Whether a `using` says `lazy`.
fn using_is_lazy(node: I32) Bool {
    for (node_first[node] ..< node_last[node]) |t| {
        let n = tok_end[t] - tok_start[t];
        if n == 4 and src[tok_start[t]] == 108 and src[tok_start[t] + 1] == 97 and src[tok_start[t] + 2] == 122 and src[tok_start[t] + 3] == 121 { return true; };
    };
    false;
}

/// The lazy module m's index in lazy_module, or -1.
fn lazy_index(m: I32) I32 {
    for (0 ..< lazy_module.len()) |k| { if lazy_module[k] == m { return k; }; };
    -1;
}

/// The program scope, from the prelude up: modules, then aliases, then the
/// entry file's own declarations, each hiding what came before.
fn declare_program() void {
    for ([FileRole.Prelude, FileRole.Import, FileRole.Entry]) |role| {
        for (0 ..< file_root.len()) |file| {
            if file_role[file] == role.to_i32() and file_root[file] >= 0 {
                let item = first_child(file_root[file]);
                while (item >= 0) {
                    if is_kind(item, Node.Module_decl) {
                        let m = declare_module(item);
                        bind(decl_name[m], m);
                    };
                    item = next_sibling(item);
                };
            };
        };
    };
    // `using tour lazy from "./tour.utu"`: the modules that file declares are
    // lazy; their functions the program calls are stubs (see lazy_stub).
    lazy_module.clear();
    lazy_path.clear();
    for (0 ..< import_file.len()) |i| {
        if import_target[i] >= 0 and using_is_lazy(import_node[i]) {
            let written = intern_text(bytes_text(tok_start[node_first[import_path[i]]], tok_end[node_last[import_path[i]] - 1]));
            for (0 ..< decl_kind.len()) |m| {
                if decl_is(m, Decl.Module) and decl_node[m] >= 0 and file_of_token(node_first[decl_node[m]]) == import_target[i] and lazy_index(m) < 0 {
                    lazy_module.push(m);
                    lazy_path.push(written);
                };
            };
        };
    };
    // Modules of host declarations (`using JS from std:JS`): the module the
    // using names, with members the compiler does not know yet.
    for (0 ..< import_file.len()) |i| {
        if import_target[i] == -2 {
            let m = declare_named(Decl.Foreign, first_child(import_node[i]), import_node[i], -1);
            decl_a[m] = view_of_import(i);
            bind(decl_name[m], m);
        };
    };
    for (0 ..< file_root.len()) |file| {
        if file_role[file] != FileRole.Prelude.to_i32() and file_root[file] >= 0 {
            let item = first_child(file_root[file]);
            while (item >= 0) {
                if is_kind(item, Node.Using_decl) { declare_alias(item); };
                item = next_sibling(item);
            };
        };
    };
    // An imported file's own items, and what is generated for its mems, are
    // in a scope of its own: its modules and functions see them, other
    // files do not. Its bindings are kept, and made again where it is walked.
    file_bind_first.clear();
    file_bind_end.clear();
    file_bind_word.clear();
    file_bind_decl.clear();
    for (0 ..< file_root.len()) |file| {
        let mark = scope_mark();
        if file_role[file] == FileRole.Import.to_i32() and file_root[file] >= 0 {
            let first = decl_kind.len();
            for (0 ..< file_root.len()) |part| {
                if (part == file or owner_of(part) == file) and file_root[part] >= 0 {
                    let item = first_child(file_root[part]);
                    while (item >= 0) {
                        if imported_item(item) { declare_entry_item(item, first); };
                        item = next_sibling(item);
                    };
                };
            };
        };
        file_bind_first.push(file_bind_word.len());
        for (mark ..< scope_mark()) |b| {
            file_bind_word.push(bind_word[b]);
            file_bind_decl.push(bind_decl[b]);
        };
        file_bind_end.push(file_bind_word.len());
        scope_pop(mark);
    };
    for (0 ..< file_root.len()) |file| {
        if declares_items(file) and owner_of(file) < 0 and file_root[file] >= 0 {
            let first_entry = decl_kind.len();
            let item = first_child(file_root[file]);
            while (item >= 0) {
                declare_entry_item(item, first_entry);
                item = next_sibling(item);
            };
            if file_role[file] == FileRole.Entry.to_i32() { check_entry_surface(file_root[file]); };
        };
    };
}

/// By file: its own scope's bindings (an imported file's), a run of
/// `file_bind_word` and `file_bind_decl`.
vec file_bind_first: I32;
vec file_bind_end: I32;
vec file_bind_word: I32;
vec file_bind_decl: I32;

/// Bind an imported file's own items again (see @declare_program).
fn bind_file_scope(file: I32) void {
    for (file_bind_first[file] ..< file_bind_end[file]) |b| { bind(file_bind_word[b], file_bind_decl[b]); };
}

/// An imported file's item that is its own (not an entry point or a test).
fn imported_item(item: I32) Bool {
    not (is_kind(item, Node.Export_main_decl) or is_kind(item, Node.Export_lib_decl) or is_kind(item, Node.Test_decl)
        or is_kind(item, Node.Bench_decl));
}

/// A program has one `export lib` or one `export main`, not both.
fn check_entry_surface(root: I32) void {
    let lib = -1;
    let main = -1;
    let item = first_child(root);
    while (item >= 0) {
        if is_kind(item, Node.Export_lib_decl) {
            if lib >= 0 { report2(Diag.EntrySurface, lib, -1, 0, -1); return; };
            lib = item;
        } else if is_kind(item, Node.Export_main_decl) {
            if main >= 0 { report2(Diag.EntrySurface, main, -1, 1, -1); return; };
            main = item;
        };
        item = next_sibling(item);
    };
    if lib >= 0 and main >= 0 { report2(Diag.EntrySurface, lib, -1, 2, -1); };
}

fn declare_entry_item(item: I32, first_entry: I32) void {
    let kind = node_kind[item];
    let decl = declare_type_item(item, -1);
    if decl < 0 {
        if kind == Node.Fn_decl.to_i32() or kind == Node.Op_decl.to_i32() {
            decl = declare_fn(item, -1);
        } else if kind == Node.Global_decl.to_i32() {
            decl = declare_named(Decl.Global, first_child(item), item, -1);
        } else if kind == Node.Mem_decl.to_i32() {
            decl = declare_named(Decl.Mem, first_child(item), item, -1);
        } else if kind == Node.Export_lib_decl.to_i32() {
            let f = first_child(item);
            while (f >= 0) {
                declare_entry_item(f, first_entry);
                f = next_sibling(f);
            };
            return;
        } else if kind == Node.Export_main_decl.to_i32() {
            declare(Decl.Main, -1, item, -1);
            return;
        } else {
            return;
        };
    };
    let name = decl_name[decl];
    if name < 0 { return; };
    let hidden = lookup(name);
    // What is generated for a mem is generated again for its twin: the
    // twin is the mistake.
    if hidden >= first_entry and hidden < decl and file_role[file_of_token(node_first[item])] != FileRole.Generated.to_i32() {
        // A mem's name is its own: reported at the mem.
        if decl_is(decl, Decl.Mem) and decl_is(hidden, Decl.Mem) { report(Diag.MemTwice, decl_node[decl], name); }
        else if decl_is(decl, Decl.Mem) { report(Diag.MemClash, decl_node[decl], name); }
        else if decl_is(hidden, Decl.Mem) { report(Diag.MemClash, decl_node[hidden], name); }
        else { report(Diag.DuplicateDeclaration, decl_node[decl], name); };
    };
    bind(name, decl);
    bind_variants(decl);
}

/// An enum's variants are types too, named where the enum is.
fn bind_variants(decl: I32) void {
    if not decl_is(decl, Decl.Enum) { return; };
    let d = decl + 1;
    while (d < decl_kind.len() and decl_owner[d] >= decl and decl_owner[d] <= d) {
        if decl_owner[d] == decl { bind(decl_name[d], d); };
        d += 1;
    };
}

//! = Resolving

/// Where the walk is.
struct Walk:
    /// The module being walked, or -1.
    | module: I32
    /// Registering methods and aliases, not resolving bodies.
    | headers: Bool

/// Resolution, after parsing: `@`-DSLs expanded, every declaration declared,
/// method headers then bodies walked. Returns the number of diagnostics.
fn resolve_names() I32 {
    diag_reset();
    if missing_import[0] >= 0 {
        report(Diag.UnknownImport, import_node[missing_import[0]], -1);
        save_diagnostics();
        return 1;
    };
    intern_known();
    // DSLs expand first: their expansions add nodes, words, and files.
    expand_dsls();
    generate_sources();
    node_decl.resize(node_kind.len());
    for (0 ..< node_kind.len()) |n| { node_decl[n] = -1; };
    word_top.resize(src.interned());
    for (0 ..< src.interned()) |w| { word_top[w] = -1; };
    declare_program();
    walk_program(true);
    walk_program(false);
    find_comptime_mems();
    save_diagnostics();
    diag_kind.len();
}

/// Resolution's diagnostics, kept so each build (exports, tests, `@comptime`)
/// starts from them and drops what is outside it.
vec saved_kind: U8;
vec saved_node: I32;
vec saved_word: I32;
vec saved_a: I32;
vec saved_b: I32;
vec saved_c: I32;
vec saved_extra: I32;
vec saved_extra_n: I32;

fn save_diagnostics() void {
    let n = diag_kind.len();
    saved_kind.resize(n);
    saved_node.resize(n);
    saved_word.resize(n);
    saved_a.resize(n);
    saved_b.resize(n);
    saved_c.resize(n);
    saved_extra.resize(n);
    saved_extra_n.resize(n);
    for (0 ..< n) |i| {
        saved_kind[i] = diag_kind[i];
        saved_node[i] = diag_node[i];
        saved_word[i] = diag_word[i];
        saved_a[i] = diag_a[i];
        saved_b[i] = diag_b[i];
        saved_c[i] = diag_c[i];
        saved_extra[i] = diag_extra[i];
        saved_extra_n[i] = diag_extra_n[i];
    };
}

fn restore_diagnostics() void {
    let n = saved_kind.len();
    diag_truncate(n);
    for (0 ..< n) |i| {
        diag_kind[i] = saved_kind[i];
        diag_node[i] = saved_node[i];
        diag_word[i] = saved_word[i];
        diag_a[i] = saved_a[i];
        diag_b[i] = saved_b[i];
        diag_c[i] = saved_c[i];
        diag_extra[i] = saved_extra[i];
        diag_extra_n[i] = saved_extra_n[i];
    };
}

/// Each file's items, prelude first: modules with their members in scope.
/// The header pass (`headers`) registers methods and aliases; the next resolves bodies.
fn walk_program(headers: Bool) void {
    for ([FileRole.Prelude, FileRole.Import, FileRole.Entry, FileRole.Generated]) |role| {
        for (0 ..< file_root.len()) |file| {
            if file_role[file] == role.to_i32() and file_root[file] >= 0 {
                let entry = declares_items(file);
                let imported = file_role[file] == FileRole.Import.to_i32();
                let scope = if imported { file; } else { owner_of(file); };
                let file_mark = scope_mark();
                if scope >= 0 { bind_file_scope(scope); };
                let item = first_child(file_root[file]);
                while (item >= 0) {
                    if is_kind(item, Node.Module_decl) {
                        let module = node_decl[name_node(first_child(item))];
                        let mark = scope_mark();
                        bind_module(module);
                        let c = first_child(item);
                        while (c >= 0) {
                            walk_item(c, Walk { module: module, headers: headers });
                            c = next_sibling(c);
                        };
                        scope_pop(mark);
                    } else if entry or is_kind(item, Node.Using_decl) or (imported and imported_item(item)) {
                        walk_item(item, Walk { module: -1, headers: headers });
                    };
                    item = next_sibling(item);
                };
                scope_pop(file_mark);
            };
        };
    };
}

fn walk_item(item: I32, w: Walk) void {
    let kind = node_kind[item];
    if kind == Node.Using_decl.to_i32() {
        if w.headers { walk_using(item, w); };
        return;
    };
    if kind == Node.Fn_decl.to_i32() {
        if w.headers { register_method(item, w); } else { walk_fn(item, w); };
        return;
    };
    if kind == Node.Op_decl.to_i32() {
        if w.headers { register_operator(item, w); } else { walk_op(item, w); };
        return;
    };
    if kind == Node.Export_lib_decl.to_i32() {
        let f = first_child(item);
        while (f >= 0) {
            walk_item(f, w);
            f = next_sibling(f);
        };
        return;
    };
    if w.headers { return; };
    if kind == Node.Struct_decl.to_i32() or kind == Node.Proto_decl.to_i32() or kind == Node.Enum_decl.to_i32() {
        walk_type_item(item, w);
    } else if kind == Node.Global_decl.to_i32() {
        let t = next_sibling(first_child(item));
        walk_type(t, w);
        walk_expr(next_sibling(t), w);
    } else if kind == Node.Mem_decl.to_i32() {
        let t = next_sibling(first_child(item));
        walk_elem_type(t, w);
        // An initializer list holds number literals, and names nothing.
        let init = next_sibling(t);
        if init >= 0 and not is_kind(init, Node.Array_expr) { walk_expr(init, w); };
    } else if kind == Node.Distinct_decl.to_i32() {
        walk_elem_type(next_sibling(first_child(item)), w);
    } else if kind == Node.Export_main_decl.to_i32() {
        let mark = scope_mark();
        let c = first_child(item);
        while (c >= 0) {
            if is_kind(c, Node.Param_list) { walk_params(c, -1, w); } else if is_kind(c, Node.Return_type) { walk_type(c, w); }
            else { walk_expr(c, w); };
            c = next_sibling(c);
        };
        scope_pop(mark);
    } else if kind == Node.Test_decl.to_i32() {
        walk_expr(last_child(item), w);
    } else if kind == Node.Bench_decl.to_i32() {
        // Setup and the measured block share one scope.
        let mark = scope_mark();
        let c = next_sibling(first_child(item));
        while (c >= 0) {
            if is_kind(c, Node.Measure_decl) { walk_expr(first_child(c), w); } else { walk_expr(c, w); };
            c = next_sibling(c);
        };
        scope_pop(mark);
    };
}

/// `using M[…] |A| from …`: the module it names, its type arguments, and for
/// an import, that the module is in the file imported.
fn walk_using(item: I32, w: Walk) void {
    let name_at = first_child(item);
    let n = name_node(name_at);
    let module = lookup(word_of(n));
    if decl_is(module, Decl.Alias) { module = decl_a[module]; };
    if not decl_is(module, Decl.Module) and not decl_is(module, Decl.Foreign) {
        report(Diag.UnknownModule, n, word_of(n));
        return;
    };
    node_decl[n] = module;
    let c = next_sibling(name_at);
    while (c >= 0) {
        if is_kind(c, Node.Module_type_arg_list) { walk_types(c, w); }
        else if is_kind(c, Node.Captured_module_name) { decl_a[node_decl[name_node(c)]] = module; };
        c = next_sibling(c);
    };
}

/// `fn T.name`, `fn &.name`, `fn P[T].name`: a method of T (or of the
/// promoted type), found by `T.name` and by calls on a T.
fn register_method(item: I32, w: Walk) void {
    let name = first_child(item);
    let receiver = first_child(name);
    let method = last_child(name);
    if receiver == method { return; };
    // `fn T.m` with no type T: stage 0 takes it for a function named T.m,
    // and says nothing of T (a call `T.m(…)` reports it).
    if is_kind(receiver, Node.Type_ident) and lookup(word_of(receiver)) < 0 and not builtin_type(word_of(receiver)) { return; };
    let owner = walk_type_name(receiver, w);
    let decl = node_decl[method];
    decl_a[decl] = owner;
    let args = next_sibling(receiver);
    if is_kind(args, Node.Module_type_arg_list) {
        walk_types(args, w);
        // `fn P[T].m`: also a method of T, so calls on a T find it.
        if decl_is(owner, Decl.Proto) {
            let t = first_child(args);
            let n = if is_kind(t, Node.Ref_type) { name_node(first_child(t)); } else { name_node(t); };
            if n >= 0 and node_decl[n] >= 0 { add_member(node_decl[n], word_of(method), Space.Method, decl); };
        };
    };
    if owner >= 0 {
        let prior = add_member(owner, word_of(method), Space.Method, decl);
        // A protocol's `fn P[T].m` is one method per T, all members of P.
        if prior >= 0 and prior != decl and not decl_is(owner, Decl.Proto) { report2(Diag.DuplicateDeclaration, name, word_of(method), 5, -1); };
    };
}

/// `fn T:add |a, b|`: an operator of T.
fn register_operator(item: I32, w: Walk) void {
    let receiver = first_child(item);
    let op = next_sibling(receiver);
    let owner = walk_type_name(receiver, w);
    let decl = node_decl[op];
    decl_a[decl] = owner;
    if owner >= 0 { add_member(owner, word_of(op), Space.Operator, decl); };
}

/// The type a type name names, recorded on it: a module stands for its
/// promoted type, an alias for its module's. Reports unknown names.
fn walk_type_name(node: I32, w: Walk) I32 {
    if is_kind(node, Node.Promoted_type) {
        let t = if w.module >= 0 { decl_a[w.module]; } else { -1; };
        node_decl[node] = t;
        return t;
    };
    let n = name_node(node);
    let word = word_of(n);
    let decl = lookup(word);
    if decl < 0 or not is_type_decl(decl) {
        if not builtin_type(word) { report(Diag.UnknownType, n, word); };
        return -1;
    };
    let t = promoted(decl);
    node_decl[n] = t;
    t;
}

/// A module (or an alias of one) stands for its promoted type, when it has one.
fn promoted(decl: I32) I32 {
    let d = decl;
    if decl_is(d, Decl.Alias) and decl_a[d] >= 0 { d = decl_a[d]; };
    if decl_is(d, Decl.Module) and decl_a[d] >= 0 { decl_a[d]; } else { decl; };
}

/// Names the language provides without a declaration: the narrow element
/// kinds of mems and integer enums, interned after the keywords.
fn builtin_type(word: I32) Bool { word >= narrow_word(Narrow.U8) and word <= narrow_word(Narrow.I16); }

/// Element kinds of mems and bases of distinct types: builtin names or types.
fn walk_elem_type(node: I32, w: Walk) void {
    if not builtin_type(word_of(node)) { walk_type_name(node, w); };
}

fn walk_types(node: I32, w: Walk) void {
    let c = first_child(node);
    while (c >= 0) {
        walk_type(c, w);
        c = next_sibling(c);
    };
}

fn walk_type(node: I32, w: Walk) void {
    let kind = node_kind[node];
    if kind == Node.Ref_type.to_i32() {
        let c = first_child(node);
        if is_kind(c, Node.Type_ident) { walk_type_name(c, w); } else { walk_type_path(c, w); };
        return;
    };
    if kind == Node.Promoted_type.to_i32() or kind == Node.Type_ident.to_i32() {
        walk_type_name(node, w);
        return;
    };
    if kind != Node.Void_type.to_i32() { walk_types(node, w); };
}

/// A path to a type: `M[A]`, `M.T`, `M[A].T`, or a name. Returns the
/// declaration it names (a module's promoted type for `M[A]`).
fn walk_type_path(node: I32, w: Walk) I32 {
    let kind = node_kind[node];
    if kind == Node.Type_ident.to_i32() or kind == Node.Promoted_type.to_i32() { return walk_type_name(node, w); };
    if kind == Node.Instantiated_module_ref.to_i32() {
        // `M[A]` as a type is M's promoted type.
        let module = walk_module_name(first_child(node));
        walk_types(next_sibling(first_child(node)), w);
        let t = promoted(module);
        let n = name_node(first_child(node));
        if t >= 0 { node_decl[n] = t; };
        return t;
    };
    if kind == Node.Qualified_type_ref.to_i32() or kind == Node.Inline_module_type_path.to_i32() {
        let c = first_child(node);
        let module = -1;
        if is_kind(c, Node.Instantiated_module_ref) {
            module = walk_module_name(first_child(c));
            walk_types(next_sibling(first_child(c)), w);
        } else {
            module = walk_module_name(c);
            let args = next_sibling(c);
            if is_kind(args, Node.Module_type_arg_list) { walk_types(args, w); };
        };
        let member_at = last_child(node);
        let n = name_node(member_at);
        let t = member(module, word_of(n), Space.Member);
        if t < 0 and decl_is(module, Decl.Module) { report(Diag.UnknownType, n, word_of(n)); };
        node_decl[n] = t;
        return t;
    };
    -1;
}

/// A module name: the module (through an alias), recorded on it.
fn walk_module_name(node: I32) I32 {
    let n = name_node(node);
    let word = word_of(n);
    let decl = lookup(word);
    if decl_is(decl, Decl.Alias) { decl = decl_a[decl]; };
    if not decl_is(decl, Decl.Module) and not decl_is(decl, Decl.Foreign) {
        report(Diag.UnknownModule, n, word);
        return -1;
    };
    node_decl[n] = decl;
    decl;
}

fn walk_type_item(item: I32, w: Walk) void {
    let c = first_child(item);
    while (c >= 0) {
        let kind = node_kind[c];
        if kind == Node.Field.to_i32() {
            walk_type(next_sibling(first_child(c)), w);
        } else if kind == Node.Impl_list.to_i32() {
            let t = first_child(c);
            while (t >= 0) {
                walk_type_name(t, w);
                t = next_sibling(t);
            };
        } else if kind == Node.Variant.to_i32() {
            let fields = next_sibling(first_child(c));
            if is_kind(fields, Node.Field_list) {
                let f = first_child(fields);
                while (f >= 0) {
                    walk_type(next_sibling(first_child(f)), w);
                    f = next_sibling(f);
                };
            };
        } else if kind == Node.Proto_member.to_i32() {
            let m = first_child(c);
            let t = next_sibling(first_child(m));
            while (t >= 0) {
                walk_type(t, w);
                t = next_sibling(t);
            };
        } else if kind == Node.Type_ident.to_i32() and c != enum_name(item) and is_kind(item, Node.Enum_decl) {
            walk_elem_type(c, w);
        };
        c = next_sibling(c);
    };
}

fn walk_params(list: I32, owner: I32, w: Walk) void {
    let p = first_child(list);
    while (p >= 0) {
        let name_at = first_child(p);
        walk_type(next_sibling(name_at), w);
        declare_in_scope(Decl.Param, name_at, p, owner);
        p = next_sibling(p);
    };
}

fn walk_fn(item: I32, w: Walk) void {
    let name = first_child(item);
    let decl = node_decl[last_child(name)];
    let mark = scope_mark();
    let c = next_sibling(name);
    while (c >= 0) {
        let kind = node_kind[c];
        if kind == Node.Self_param.to_i32() {
            declare_in_scope(Decl.SelfParam, first_child(c), c, decl);
        } else if kind == Node.Param_list.to_i32() {
            walk_params(c, decl, w);
        } else if kind == Node.Return_type.to_i32() {
            walk_type(c, w);
        } else {
            walk_expr(c, w);
        };
        c = next_sibling(c);
    };
    scope_pop(mark);
}

/// `fn T:op |a, b| R { … }`: the captures are its parameters.
fn walk_op(item: I32, w: Walk) void {
    let op = next_sibling(first_child(item));
    let decl = node_decl[op];
    let mark = scope_mark();
    let c = next_sibling(op);
    while (c >= 0) {
        if is_kind(c, Node.Capture) {
            let n = first_child(c);
            while (n >= 0) {
                declare_in_scope(Decl.Param, n, n, decl);
                n = next_sibling(n);
            };
        } else if is_kind(c, Node.Return_type) {
            walk_type(c, w);
        } else {
            walk_expr(c, w);
        };
        c = next_sibling(c);
    };
    scope_pop(mark);
}

fn walk_children(node: I32, w: Walk) void {
    let c = first_child(node);
    while (c >= 0) {
        walk_expr(c, w);
        c = next_sibling(c);
    };
}

/// Bind each name of a capture (`|a, b|`) to the capture.
fn bind_capture(capture: I32, kind: Decl) void {
    let n = first_child(capture);
    while (n >= 0) {
        declare_in_scope(kind, n, capture, -1);
        n = next_sibling(n);
    };
}

fn walk_expr(node: I32, w: Walk) void {
    if node < 0 { return; };
    let kind = node_kind[node];
    if kind == Node.Identifier.to_i32() {
        let word = word_of(node);
        let decl = lookup(word);
        if decl < 0 { report(Diag.UnknownVariable, node, word); } else { node_decl[node] = decl; };
    } else {
        walk_compound(node, kind, w);
    };
}

fn walk_compound(node: I32, kind: I32, w: Walk) void {
    match Node.from_i32(kind) {
        Node.Block => {
            let mark = scope_mark();
            walk_children(node, w);
            scope_pop(mark);
        },
        Node.Bind_expr => { walk_bind(node, w); },
        Node.Field_expr => { walk_field(node, w); },
        Node.Optional_field_expr => { walk_field(node, w); },
        Node.Type_member_expr => {
            let base = first_child(node);
            let owner = if is_kind(base, Node.Type_ident) { walk_owner_name(base); } else { walk_type_path(base, w); };
            let name = next_sibling(base);
            node_decl[name] = static_member(owner, word_of(name));
        },
        Node.Promoted_module_call_expr => {
            let name_at = first_child(node);
            let module = walk_module_name(name_at);
            let args = next_sibling(name_at);
            walk_types(args, w);
            let name = next_sibling(args);
            node_decl[name] = static_member(module, word_of(name));
            walk_expr(next_sibling(name), w);
        },
        Node.Null_expr => { walk_type_name(first_child(node), w); },
        Node.Struct_init => {
            let t = first_child(node);
            let decl = walk_type_path(t, w);
            walk_field_inits(next_sibling(t), decl, w);
        },
        Node.Implicit_struct_init => { walk_field_inits(next_sibling(first_child(node)), -1, w); },
        Node.Closure_expr => { walk_closure(node, w); },
        Node.For_expr => {
            let c = first_child(node);
            walk_for_sources(c, w);
            let mark = scope_mark();
            c = next_sibling(c);
            if is_kind(c, Node.Capture) {
                bind_capture(c, Decl.Capture);
                c = next_sibling(c);
            };
            walk_expr(c, w);
            scope_pop(mark);
        },
        Node.Iterator_expr => { walk_iterator(node, w); },
        Node.Alt_expr => {
            let c = first_child(node);
            walk_expr(c, w);
            c = next_sibling(c);
            while (c >= 0) {
                if is_kind(c, Node.Alt_arm) { walk_alt_arm(c, w); } else { walk_children(c, w); };
                c = next_sibling(c);
            };
        },
        Node.Promote_expr => {
            let c = first_child(node);
            walk_expr(c, w);
            let binding = next_sibling(c);
            let mark = scope_mark();
            declare_in_scope(Decl.Promoted, binding, node, -1);
            let arm = next_sibling(binding);
            walk_expr(arm, w);
            scope_pop(mark);
            walk_expr(next_sibling(arm), w);
        },
        Node.Try_expr => {
            let body = first_child(node);
            walk_expr(body, w);
            let c = next_sibling(body);
            let mark = scope_mark();
            if is_kind(c, Node.Identifier) {
                declare_in_scope(Decl.Caught, c, node, -1);
                c = next_sibling(c);
            };
            walk_expr(c, w);
            scope_pop(mark);
        },
        Node.Match_expr => { walk_match(node, w); },
        Node.Loop_match_expr => { walk_match(node, w); },
        Node.Block_expr => {
            // A label is not a variable.
            walk_expr(last_child(node), w);
        },
        Node.Pipe_expr => {
            walk_expr(first_child(node), w);
            walk_pipe_target(last_child(node), w);
        },
        Node.Unary_expr => { walk_expr(last_child(node), w); },
        Node.Dsl_expr => {},
        Node.Literal => {},
        Node.Multiline_string_lit => {},
        ~> { walk_children(node, w); },
    };
}

/// `a.f`, `a?.f`; with `a` a module (`m.f`), its member.
fn walk_field(node: I32, w: Walk) void {
    let base = first_child(node);
    walk_expr(base, w);
    let module = node_decl[base];
    if is_kind(base, Node.Identifier) and decl_is(module, Decl.Module) {
        let name = next_sibling(base);
        node_decl[name] = member(module, word_of(name), Space.Member);
    };
}

/// `match e { p => a, … }` and `loop match`.
fn walk_match(node: I32, w: Walk) void {
    let c = first_child(node);
    walk_expr(c, w);
    c = next_sibling(c);
    while (c >= 0) {
        if is_kind(c, Node.Match_arm) {
            walk_match_lit(first_child(c), w);
            walk_expr(next_sibling(first_child(c)), w);
        } else {
            walk_children(c, w);
        };
        c = next_sibling(c);
    };
}

/// `let x: T = e;`, `let .{a, b} = e;`. The name is in scope after the
/// initializer, except for a closure, which may call itself.
fn walk_bind(node: I32, w: Walk) void {
    let c = first_child(node);
    let init = last_child(node);
    if is_kind(c, Node.Tuple_pattern) {
        walk_expr(init, w);
        let n = first_child(c);
        while (n >= 0) {
            declare_in_scope(Decl.Local, n, node, -1);
            n = next_sibling(n);
        };
        return;
    };
    let t = next_sibling(c);
    if t != init { walk_type(t, w); };
    let d = declare_named(Decl.Local, c, node, -1);
    if is_kind(init, Node.Closure_expr) {
        bind(decl_name[d], d);
        walk_expr(init, w);
    } else {
        walk_expr(init, w);
        bind(decl_name[d], d);
    };
}

fn walk_closure(node: I32, w: Walk) void {
    let mark = scope_mark();
    let c = first_child(node);
    while (c >= 0) {
        if is_kind(c, Node.Closure_param_list) {
            let p = first_child(c);
            while (p >= 0) {
                let name_at = first_child(p);
                let t = next_sibling(name_at);
                if t >= 0 { walk_type(t, w); };
                declare_in_scope(Decl.ClosureParam, name_at, p, -1);
                p = next_sibling(p);
            };
        } else if is_kind(c, Node.Return_type) {
            walk_type(c, w);
        } else {
            walk_expr(c, w);
        };
        c = next_sibling(c);
    };
    scope_pop(mark);
}

fn walk_for_sources(sources: I32, w: Walk) void {
    let s = first_child(sources);
    while (s >= 0) {
        walk_children(s, w);
        s = next_sibling(s);
    };
}

/// `xs map |x| { … }`, `xs fold(0) |acc, x| { … }`, `xs collect(T)`: the
/// parameters and types, then the block with the capture in scope.
fn walk_iterator(node: I32, w: Walk) void {
    let c = first_child(node);
    walk_expr(c, w);
    c = next_sibling(c);
    let mark = scope_mark();
    while (c >= 0) {
        let kind = node_kind[c];
        if kind == Node.Capture.to_i32() {
            bind_capture(c, Decl.Capture);
        } else if is_type_node(kind) {
            walk_type(c, w);
        } else {
            walk_expr(c, w);
        };
        c = next_sibling(c);
    };
    scope_pop(mark);
}

fn is_type_node(kind: I32) Bool {
    kind == Node.Ref_type.to_i32() or kind == Node.Nullable_type.to_i32() or kind == Node.Paren_type.to_i32()
        or kind == Node.Tuple_type.to_i32() or kind == Node.Func_type.to_i32() or kind == Node.Closure_type.to_i32()
        or kind == Node.Promoted_type.to_i32();
}

/// `Variant |x| => e`: the variant (by its type when it is qualified), then
/// the arm with the binding in scope.
fn walk_alt_arm(arm: I32, w: Walk) void {
    let pattern = first_child(arm);
    if is_kind(pattern, Node.Qualified_type_ref) { walk_type_path(pattern, w); }
    else {
        let decl = lookup(word_of(pattern));
        if decl >= 0 and is_type_decl(decl) { node_decl[pattern] = decl; };
    };
    let c = next_sibling(pattern);
    let mark = scope_mark();
    if is_kind(c, Node.Identifier) {
        declare_in_scope(Decl.ArmBinding, c, arm, -1);
        c = next_sibling(c);
    };
    walk_expr(c, w);
    scope_pop(mark);
}

/// `Tag.Leaf` in a match: the integer enum and its variant.
fn walk_match_lit(lit: I32, w: Walk) void {
    let t = first_child(lit);
    if is_kind(t, Node.Type_ident) {
        let owner = walk_type_name(t, w);
        let v = next_sibling(t);
        node_decl[v] = member(owner, word_of(v), Space.Member);
    };
}

/// `T { a: e, … }`: each field name recorded as `owner`'s field.
fn walk_field_inits(first_init: I32, owner: I32, w: Walk) void {
    let f = first_init;
    while (f >= 0) {
        let name = first_child(f);
        if owner >= 0 { node_decl[name] = member(owner, word_of(name), Space.Member); };
        walk_expr(next_sibling(name), w);
        f = next_sibling(f);
    };
}

/// `x -o f`, `x -o M.f(a, &)`, `x -o T.method`.
fn walk_pipe_target(target: I32, w: Walk) void {
    let c = first_child(target);
    let owner = -1;
    if is_kind(c, Node.Instantiated_module_ref) {
        owner = walk_type_path(c, w);
    } else if is_kind(c, Node.Identifier) {
        let decl = lookup(word_of(c));
        if decl < 0 { report(Diag.UnknownVariable, c, word_of(c)); } else { node_decl[c] = decl; };
        owner = decl;
    } else {
        owner = walk_owner_name(c);
    };
    c = next_sibling(c);
    while (c >= 0 and (is_kind(c, Node.Identifier) or is_kind(c, Node.Type_ident))) {
        let found = if decl_is(owner, Decl.Module) or (owner >= 0 and is_type_decl(owner)) { static_member(owner, word_of(c)); } else { -1; };
        node_decl[c] = found;
        owner = found;
        c = next_sibling(c);
    };
    if c >= 0 { walk_pipe_args(c, w); };
}

fn walk_pipe_args(args: I32, w: Walk) void {
    let list = first_child(args);
    let a = first_child(list);
    while (a >= 0) {
        if is_kind(a, Node.Pipe_arg) { walk_expr(first_child(a), w); };
        a = next_sibling(a);
    };
}

/// The type or module a name before `.` names: `Tag` in `Tag.Leaf`, `M` in `M.f`.
fn walk_owner_name(node: I32) I32 {
    let word = word_of(node);
    let decl = lookup(word);
    if decl < 0 or not is_type_decl(decl) {
        if not builtin_type(word) { report(Diag.UnknownType, node, word); };
        return -1;
    };
    if decl_is(decl, Decl.Alias) { decl = decl_a[decl]; };
    node_decl[node] = decl;
    decl;
}

/// What `T.name` names: a member of a module (or of its promoted type: a
/// method or variant), a variant, or a method.
fn static_member(owner: I32, word: I32) I32 {
    if owner < 0 { return -1; };
    let found = member(owner, word, Space.Member);
    if found >= 0 { return found; };
    found = member(owner, word, Space.Method);
    if found >= 0 { return found; };
    if decl_is(owner, Decl.Module) and decl_a[owner] >= 0 { return static_member(decl_a[owner], word); };
    -1;
}
