// ── DSLs ─────────────────────────────────────────────────────────────────────
//
// `@json/\ decode T text \/` and the other standard DSLs expand into utu
// source, as in stage 0: an expression in place of the site, and
// declarations (a runtime, codecs) beside it, in its module or at the top
// level of its file. The text is parsed as a generated file, and its nodes
// are grafted into the tree before names are resolved: the expression
// becomes the site's only child (the site, a parenthesis now, keeps its
// span), and the declarations become the container's first items.
//
// Utu written inside a DSL body (an interpolation, a match arm) is copied
// into the expansion as text, where it means what it meant at the site.

// Expand every DSL site of the program's own files; then the sites the
// expansions made, until none is left.
mem dsl_reconcile: I32 = [0];

fn expand_dsls() void {
    // Any reactive template makes every one reconciled.
    dsl_reconcile[0] = if wutu_reactive_program() { 1; } else { 0; };
    let rounds = 0;
    while (rounds < 16 and expand_dsl_round()) { rounds += 1; };
}

// One round, in stage 0's order: @utu and @css, then @stored, then each
// container's @json sites. Whether any was expanded.
fn expand_dsl_round() Bool {
    let utu = intern_text("utu");
    let css = intern_text("css");
    let stored = intern_text("stored");
    let expanded = false;
    let before = node_kind.len();
    let k = own_sites();
    while (k < dsl_sites.len() and dsl_sites[k] < before) {
        let n = dsl_sites[k];
        if node_kind[n] == Node.Dsl_expr.to_i32() and dsl_in_program(n) {
            let w = word_of(first_child(n));
            if w == utu or w == css {
                expanded = true;
                try {
                    if w == utu { expand_utu(n); } else { expand_css(n); };
                } catch {
                    report_dsl_error(n);
                    dsl_failed.push(n);
                };
            };
        };
        k += 1;
    };
    k = own_sites();
    while (k < dsl_sites.len() and dsl_sites[k] < before) {
        let n = dsl_sites[k];
        if node_kind[n] == Node.Dsl_expr.to_i32() and dsl_in_program(n) and word_of(first_child(n)) == stored {
            expanded = true;
            try {
                expand_stored(n);
            } catch {
                report_dsl_error(n);
                dsl_failed.push(n);
            };
        };
        k += 1;
    };
    let json = intern_text("json");
    let containers = Array[I32].new(64, -1);
    let ncontainers = 0;
    let found = false;
    let count = node_kind.len();
    k = own_sites();
    while (k < dsl_sites.len() and dsl_sites[k] < count) {
        let n = dsl_sites[k];
        if node_kind[n] == Node.Dsl_expr.to_i32() and word_of(first_child(n)) == json and dsl_in_program(n) {
            found = true;
            let c = dsl_container(n);
            let seen = false;
            for (0 ..< ncontainers) |i| { if containers[i] == c { seen = true; }; };
            if not seen and ncontainers < 64 {
                containers[ncontainers] = c;
                ncontainers += 1;
            };
        };
        k += 1;
    };
    for (0 ..< ncontainers) |i| { json_expand_container(containers[i], json, count); };
    // Then the Wutu templates, until none is left (one may hold another).
    let wutu = intern_text("wutu");
    let more = true;
    let guard = 0;
    while (more and guard < 64) {
        more = false;
        guard += 1;
        let now = node_kind.len();
        k = own_sites();
        while (k < dsl_sites.len() and dsl_sites[k] < now) {
            let n = dsl_sites[k];
            if node_kind[n] == Node.Dsl_expr.to_i32() and dsl_in_program(n) and word_of(first_child(n)) == wutu {
                more = true;
                expanded = true;
                try {
                    expand_wutu(n, dsl_reconcile[0] == 1);
                } catch {
                    report_dsl_error(n);
                    dsl_failed.push(n);
                };
            };
            k += 1;
        };
    };
    found or expanded;
}

// The DSL sites (`@name/\ … \/`), in node order: each parse notes those it
// made (note_dsl_sites). The kept prelude's are the first.
mem dsl_sites: I32;

fn note_dsl_sites(from: I32) void {
    for (from ..< node_kind.len()) |n| { if node_kind[n] == Node.Dsl_expr.to_i32() { dsl_sites.push(n); }; };
}

fn own_sites() I32 { kept[5]; }

// Whether a node is in an own file (not the standard library), and its
// expansion has not failed (an expanded site is a parenthesis).
fn dsl_in_program(node: I32) Bool {
    if not is_own_file(file_of_token(node_first[node])) { return false; };
    for (0 ..< dsl_failed.len()) |i| { if dsl_failed[i] == node { return false; }; };
    true;
}

// Sites whose expansion failed (reported): left as they are, and checked as mistakes.
mem dsl_failed: I32;

fn dsl_has_failed(node: I32) Bool {
    for (0 ..< dsl_failed.len()) |i| { if dsl_failed[i] == node { return true; }; };
    false;
}

// The module a node is in, or its file's root.
fn dsl_container(node: I32) I32 {
    let p = parent_of(node);
    while (p >= 0) {
        if is_kind(p, Node.Module_decl) or is_kind(p, Node.Source_file) { return p; };
        p = parent_of(p);
    };
    file_root[file_of_token(node_first[node])];
}

// The body of a site: after `/\`, before `\/`, as written.
fn dsl_inner_start(site: I32) I32 { tok_start[node_first[last_child(site)]] + 2; }

fn dsl_inner_end(site: I32) I32 { tok_end[node_first[last_child(site)]] - 2; }

fn dsl_body(site: I32) Str { bytes_text(dsl_inner_start(site), dsl_inner_end(site)); }

// ── Mistakes ──
//
// A DSL's mistake names a place in its body (an offset from the body's
// start, and a length); expanding stops there, and it is reported.

mem dsl_err_message: I32 = [-1];   // a word
mem dsl_err_offset: I32 = [0];
mem dsl_err_length: I32 = [0];

let dsl_throw: fun() void = @es/\ () => { throw new SyntaxError('utu dsl'); } \/;

fn dsl_fail(message: Str, offset: I32, length: I32) void {
    dsl_err_message[0] = intern_text(message);
    dsl_err_offset[0] = offset;
    dsl_err_length[0] = length;
    dsl_throw();
}

fn report_dsl_error(site: I32) void {
    let start = dsl_byte(site, dsl_err_offset[0]);
    report3(Diag.DslError, site, dsl_err_message[0], start, start + dsl_err_length[0], -1);
}

// Where offset `offset` (in code units) of a site's body is in src (in bytes).
// The byte of a UTF-16 offset in site's body, and the UTF-16 offset of a
// byte: walked over the body's bytes, from the last answer when it is
// before (expansions ask in order), so a body is read once, not per ask.
mem dsl_cursor: I32 = [-1, 0, 0];   // site, byte, UTF-16 offset

fn dsl_byte(site: I32, offset: I32) I32 {
    let b = dsl_inner_start(site);
    let u = 0;
    if dsl_cursor[0] == site and dsl_cursor[2] <= offset {
        b = dsl_cursor[1];
        u = dsl_cursor[2];
    };
    let end_ = dsl_inner_end(site);
    while (b < end_ and u < offset) {
        let n = utf8_size(src[b]);
        u += if n == 4 { 2; } else { 1; };
        b += n;
    };
    dsl_cursor[0] = site;
    dsl_cursor[1] = b;
    dsl_cursor[2] = u;
    b;
}

fn dsl_units(site: I32, at: I32) I32 {
    let b = dsl_inner_start(site);
    let u = 0;
    if dsl_cursor[0] == site and dsl_cursor[1] <= at {
        b = dsl_cursor[1];
        u = dsl_cursor[2];
    };
    while (b < at) {
        let n = utf8_size(src[b]);
        u += if n == 4 { 2; } else { 1; };
        b += n;
    };
    dsl_cursor[0] = site;
    dsl_cursor[1] = b;
    dsl_cursor[2] = u;
    u;
}

// The length of the UTF-8 sequence a lead byte starts.
fn utf8_size(b: I32) I32 { if b < 128 { 1; } else if b < 224 { 2; } else if b < 240 { 3; } else { 4; }; }

// ── Grafting ──
//
// Generated code points at the site that needed it: a mistake in it is
// reported there.

mem dsl_file_site: I32;           // by file: the DSL site it was generated for, or -1
mem dsl_file_from: I32;           // by file: the part of the site it stands for (bytes), or -1
mem dsl_file_to: I32;
mem dsl_current_site: I32 = [-1];
mem dsl_current_from: I32 = [-1];
mem dsl_current_to: I32 = [-1];

// The site a generated node stands for, or -1.
fn dsl_site_of(node: I32) I32 {
    let file = file_of_token(node_first[node]);
    if file < dsl_file_site.len() { dsl_file_site[file]; } else { -1; };
}

// Parse `code` (an expression) and make it the site's value.
fn graft_expression(site: I32, code: Str) void {
    dsl_current_site[0] = site;
    let root = parse_generated_file("fn __expansion() void { " + code + "; }");
    if root < 0 { return; };
    let fn_ = first_child(root);
    let block = last_child(fn_);
    let expr = first_child(block);
    // The expression leaves the generated file, which is left empty.
    node_child[root] = -1;
    node_child[block] = -1;
    node_kind[site] = Node.Paren_expr.to_i32();
    node_child[site] = expr;
    node_next[expr] = -1;
    set_parent(expr, site);
    fill_splices(expr);
}

// Parse declarations and make them the container's first items.
fn graft_declarations(container: I32, code: Str) void {
    let root = parse_generated_file(code);
    if root < 0 { return; };
    let first = node_child[root];
    if first < 0 { return; };
    node_child[root] = -1;
    let last = first;
    while (node_next[last] >= 0) { last = node_next[last]; };
    // After a module's name (and its type parameters).
    if is_kind(container, Node.Module_decl) {
        let at = first_child(container);
        if is_kind(next_sibling(at), Node.Module_type_param_list) { at = next_sibling(at); };
        node_next[last] = node_next[at];
        node_next[at] = first;
    } else {
        node_next[last] = node_child[container];
        node_child[container] = first;
    };
    let item = first;
    while (item >= 0) {
        set_parent(item, container);
        if item == last { break; };
        item = node_next[item];
    };
}

// A generated file of `code`, parsed: its root, or -1.
fn parse_generated_file(code: Str) I32 {
    let start = src.len();
    gen_text_utf8(code);
    let n = src.len() - start;
    let copy = Array[I32].new(n + 1, 0);
    for (0 ..< n) |i| { copy[i] = src[start + i]; };
    src.resize(start);
    let file = add_file(n, FileRole.Generated);
    let at = file_start[file];
    for (0 ..< n) |i| { src[at + i] = copy[i]; };
    let k = dsl_file_site.len();
    dsl_file_site.resize(file + 1);
    dsl_file_from.resize(file + 1);
    dsl_file_to.resize(file + 1);
    for (k ..< file + 1) |f| {
        dsl_file_site[f] = -1;
        dsl_file_from[f] = -1;
    };
    dsl_file_site[file] = dsl_current_site[0];
    dsl_file_from[file] = dsl_current_from[0];
    dsl_file_to[file] = dsl_current_to[0];
    parse_file(file);
}

// The first item of a generated file of `code`, or -1.
fn parse_generated(code: Str) I32 {
    let root = parse_generated_file(code);
    if root < 0 { -1; } else { first_child(root); };
}

// Whether `code` parses as an expression (the file it took is left empty).
fn parses_as_expression(code: Str) Bool {
    let root = parse_generated_file("fn __check() void { " + code + "; }");
    if root < 0 { return false; };
    node_child[root] = -1;
    true;
}

// ── Splices ──
//
// Utu written in a DSL body (an interpolation, a match arm, a default) goes
// into the expansion as a placeholder name, `__splice_N`; once the
// expansion is grafted, each placeholder becomes the expression parsed from
// the body itself, so it keeps its place in the source.

mem splice_start: I32;   // by splice: its span in src (-1 for generated code)
mem splice_end: I32;
mem splice_code: I32;    // by splice: generated code (a word), whose mistakes point at [from, to) of the body
mem splice_from: I32;
mem splice_to: I32;

// Generated code that stands for one statement of the body (`bind:`): its
// mistakes are reported at that statement, not the whole site.
fn located_splice(site: I32, code: Str, from: I32, to: I32) Str {
    let k = splice_start.len();
    splice_start.push(-1);
    splice_end.push(-1);
    splice_code.resize(k + 1);
    splice_from.resize(k + 1);
    splice_to.resize(k + 1);
    splice_code[k] = intern_text(code);
    splice_from[k] = dsl_byte(site, from);
    splice_to[k] = dsl_byte(site, to);
    "__splice_" + int_text(k);
}

// The utu of `site`'s body at `offset` (`text` long), as a placeholder; -1
// in splice_failed[0] when it does not parse.
fn dsl_splice(site: I32, offset: I32, text: Str) Str {
    let start = dsl_byte(site, offset);
    let k = splice_start.len();
    splice_start.push(start);
    splice_end.push(start + utf8_length(text));
    splice_code.resize(k + 1);
    splice_code[k] = -1;
    "__splice_" + int_text(k);
}

fn utf8_length(text: Str) I32 {
    let n = 0;
    let i = 0;
    while (i < text.len()) {
        let c = text.get(i);
        // A surrogate pair is one character, four bytes.
        if c >= 55296 and c <= 56319 and i + 1 < text.len() and text.get(i + 1) >= 56320 and text.get(i + 1) <= 57343 {
            n += 4;
            i += 2;
        } else {
            n += if c < 128 { 1; } else if c < 2048 { 2; } else { 3; };
            i += 1;
        };
    };
    n;
}

// Whether the utu at src[start ..< end_] parses as an expression.
fn splice_parses(site: I32, offset: I32, text: Str) Bool {
    let start = dsl_byte(site, offset);
    parse_span(start, start + utf8_length(text)) >= 0;
}

// The expression written at src[start ..< end_], parsed in place, or -1.
fn parse_span(start: I32, end_: I32) I32 {
    let saved = src[end_];
    src[end_] = end_byte;
    let first = tok_kind.len();
    let last = lex(start, end_);
    src[end_] = saved;
    parse_expression(first, last);
}

// Replace the placeholders under `node` with their expressions.
fn fill_splices(node: I32) void {
    if node < 0 { return; };
    if is_kind(node, Node.Identifier) {
        let name = word_text(word_of(node));
        if text_at(name, 0, "__splice_") {
            let k = int_of(name.slice(9, name.len()));
            let e = if splice_start[k] >= 0 { parse_span(splice_start[k], splice_end[k]); } else { parse_located(k); };
            if e >= 0 {
                apply_renames(e, k);
                // The placeholder becomes a splice around the expression: it
                // keeps its own token, so what follows it is found after it.
                node_kind[node] = Node.Splice.to_i32();
                node_child[node] = e;
                node_next[e] = -1;
                set_parent(e, node);
            };
        };
        return;
    };
    let c = first_child(node);
    while (c >= 0) {
        let next = next_sibling(c);
        fill_splices(c);
        c = next;
    };
}

// A Wutu island's identifiers that name element aliases, renamed.
fn apply_renames(node: I32, k: I32) void {
    if is_kind(node, Node.Identifier) {
        let at = tok_start[node_first[node]];
        for (0 ..< splice_rename_k.len()) |r| {
            if splice_rename_k[r] == k and splice_rename_at[r] == at { tok_word[node_first[node]] = splice_rename_to[r]; };
        };
        return;
    };
    let c = first_child(node);
    while (c >= 0) {
        apply_renames(c, k);
        c = next_sibling(c);
    };
}

// A located splice's code, parsed (its own placeholders filled).
fn parse_located(k: I32) I32 {
    dsl_current_from[0] = splice_from[k];
    dsl_current_to[0] = splice_to[k];
    let root = parse_generated_file("fn __expansion() void { " + word_text(splice_code[k]) + "; }");
    dsl_current_from[0] = -1;
    if root < 0 { return -1; };
    let block = last_child(first_child(root));
    let e = first_child(block);
    node_child[root] = -1;
    node_child[block] = -1;
    node_next[e] = -1;
    fill_splices(e);
    e;
}

fn int_of(text: Str) I32 {
    let v = 0;
    for (0 ..< text.len()) |i| { v = v * 10 + (text.get(i) - 48); };
    v;
}

// ── Text ──

fn is_space_code(c: I32) Bool { c == 32 or c == 10 or c == 13 or c == 9; }

fn is_word_code(c: I32) Bool { (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95; }

fn is_upper_code(c: I32) Bool { c >= 65 and c <= 90; }

fn is_lower_code(c: I32) Bool { c >= 97 and c <= 122; }

fn text_at(text: Str, at: I32, part: Str) Bool {
    if at < 0 or at + part.len() > text.len() { return false; };
    for (0 ..< part.len()) |i| { if text.get(at + i) != part.get(i) { return false; }; };
    true;
}

// Where `part` first is in `text`, from `from` on, or -1 (JavaScript's
// search, which a scan of code units here is many times slower than).
fn text_index(text: Str, part: Str, from: I32) I32 { if from > text.len() { -1; } else { str_index(text, part, from); }; }

let str_index: fun(Str, Str, I32) I32 = @es/\ (t, p, f) => t.indexOf(p, f) \/;

fn trim_end(text: Str) Str {
    let n = text.len();
    while (n > 0 and is_space_code(text.get(n - 1))) { n -= 1; };
    text.slice(0, n);
}

fn without_spaces(text: Str) Str {
    let out = "";
    for (0 ..< text.len()) |i| { if not is_space_code(text.get(i)) { out = out + Str.from_code_point(text.get(i)); }; };
    out;
}

// `text` with its first `find` replaced by `with`.
fn replace_first(text: Str, find: Str, with: Str) Str {
    let at = text_index(text, find, 0);
    if at < 0 { return text; };
    text.slice(0, at) + with + text.slice(at + find.len(), text.len());
}
