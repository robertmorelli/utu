//! = Wutu: the expander
//!
//! Each `@wutu` template becomes ordinary utu that builds the DOM through
//! the Browser declarations and std:wutu's reconciler: a program (the
//! template's structure, as data) and the code that supplies its values.
//! Every template works this way, so a component behaves alike wherever it is
//! rendered: under an `@reactive` root it re-renders with the root; elsewhere
//! it renders once. (Stage 0 does not compile Wutu.)

let wu_reconcile: I32 = 0
let wu_has_browser: I32 = 0
let wu_site: I32 = -1
let wu_serial: I32 = 0
let wu_node_count: I32 = 0
/// Elements with an `as` alias, in order.
vec wu_aliases: I32
/// The site's stylesheets: keys and CSS (words), in order.
vec wu_style_key: I32
vec wu_style_css: I32
/// 1: the program's CSS is the build's (set_external_css), not installed by its code.
let wu_external_css: I32 = 0
/// That CSS (words), each sheet once, in order.
vec wu_css_out: I32
/// The site's helper bindings (words), in order.
vec wu_decls: I32
/// Which helpers it has (words), and their names.
vec wu_declared_kind: I32
vec wu_declared_name: I32
/// A word.
let wu_prefix: I32 = -1
let wu_view_hash: I32 = -1

// Island renames: by splice, identifiers that name element aliases.
vec splice_rename_k: I32
/// The identifier's byte offset.
vec splice_rename_at: I32
/// The alias's element (a word).
vec splice_rename_to: I32

/// The prefix of the site's generated names, `__wutu_N_`: one its body does not use.
fn wutu_prefix() Str => word_text(wu_prefix)

/// Whether the kept nodes have a reactive site: 1 or 0, or -1 until asked.
let kept_reactive: I32 = -1

/// Whether `src[at ..< hi]` starts with `text` (ASCII).
fn bytes_at(at: I32, hi: I32, text: Str) Bool {
    if at + text.len() > hi { return false }
    for (0 ..< text.len()) |k| { if src[at + k] != text.get(k) { return false } }
    return true
}

/// FNV-1a over the text's code units, base 36: stable class names and view identities.
fn wutu_hash(text: Str) Str {
    let n = -2128831035
    for (0 ..< text.len()) |i| { n = (n ^ text.get(i)) * 16777619 }
    let v = n.i64() & 4294967295
    if v == 0 { return "0" }
    let digits = wus(Wut.N0123456789abcdefghijklmnopqrstuvwxyz)
    let out = ""
    while (v > 0) {
        out = Str.from_code_point(digits.get((v % 36).i32())) + out
        v = v / 36
    }
    return out
}

/// A JS string literal safe inside `@es/\ … \/`: no `/` next to a `\`.
fn es_string(text: Str) Str {
    let json = js_string(text)
    let out = ""
    for (0 ..< json.len()) |i| {
        let c = json.get(i)
        let next_is_backslash = i + 1 < json.len() and json.get(i + 1) == 92
        let after_backslash = i > 0 and json.get(i - 1) == 92
        if c == 47 and (next_is_backslash or after_backslash) { out = wus1(Wut.U002f, out) } else { out = out + Str.from_code_point(c) }
    }
    return out
}

//! = A site

/// The Source_file root containing `node` (walking past desugared wrappers).
fn site_source_file(node: I32) I32 {
    let p = node
    while (p >= 0) {
        if is_kind(p, Node.Source_file) { return p }
        p = parent_of(p)
    }
    return file_root[file_of_token(node_first[node])]
}

/// Expand one `@wutu` site in place: a block that creates its elements,
/// installs its CSS and attaches its listeners, and whose value is the root
/// element. With `reconcile`, each element goes through `std:wutu`'s
/// reconciler, and a reactive template mounts a view.
fn expand_wutu(site: I32) Void {
    let whole = bytes_text(tok_start[node_first[last_child(site)]], tok_end[node_first[last_child(site)]])
    let prefix = ""
    let searching = true
    while (searching) {
        prefix = wus1(Wut.Wutu, int_text(wu_serial))
        wu_serial += 1
        searching = text_index(whole, prefix, 0) >= 0
    }
    wu_prefix = intern_text(prefix)
    wu_view_hash = intern_text(wutu_hash(whole))
    wu_site = site
    wu_reconcile = 1
    wu_has_browser = if imports_browser(site_source_file(site)) { 1 } else { 0 }
    wu_node_count = 0
    wu_aliases.clear()
    wu_style_key.clear()
    wu_style_css.clear()
    wu_decls.clear()
    wu_declared_kind.clear()
    wu_declared_name.clear()
    let template = dsl_body(site)
    let root = parse_template(template)
    wutu_prepare(root)
    // `@document` CSS, each block once, goes in its own layer (below).
    let document = ""
    for (0 ..< tw_global.len()) |k| {
        let seen = false
        for (0 ..< k) |j| { if tw_global[j] == tw_global[k] { seen = true } }
        if not seen { document = document + word_text(tw_global[k]) }
    }
    wx_events.clear()
    wx_event_ops.clear()
    // The template as a program (its structure, as data) and the code that supplies its values.
    let ops = WOps { text: "" }
    let tag = word_text(tn_text[root])
    // (A root `circle` or `g` is SVG; `a`, `title`, `script`, `style` are HTML.)
    let svg = is_svg_tag(tag) and not is_html_tag(tag)
    let fragment = tn_kind[root] == 5
    if fragment { wd_op(ops, wus(Wut.R)) }
    let code = if fragment { wd_fragment(tn_first[root], false, ops) } else { wd_element(root, svg, ops) }
    let events = ""
    for (0 ..< wx_events.len()) |k| { events = events + word_text(wx_events[k]) }
    for (0 ..< wx_event_ops.len()) |k| { wd_op(ops, word_text(wx_event_ops[k])) }
    code = wus3(Wut.AOpenBCloseSemiNlC, wutu_helper(wus(Wut.Begin)), js_string(wus1(Wut.BracketABracketEnd, ops.text)), code)
    events = wus2(Wut.ABOpenClose, events, wutu_typed_fn("done", if fragment { wus(Wut.Fragment) } else { tag }, svg))
    let prelude = ""
    for (0 ..< tw_let_head.len()) |k| {
        prelude = prelude + "let " + word_text(tw_let_head[k]) + " = " + wutu_island(word_text(tw_let_value[k]), tw_let_from[k], tw_let_to[k], root) + "\n"
    }
    // Shared sheets install in source order, so later ones win the cascade.
    for (0 ..< tw_style_value.len()) |k| {
        prelude = wus2(Wut.WutuStyle, prelude, wutu_island(word_text(tw_style_value[k]), tw_style_from[k], tw_style_to[k], root))
    }
    let css = ""
    for (0 ..< wu_style_css.len()) |k| { css = css + word_text(wu_style_css[k]) }
    css = css_minify(layered_document_css(without_hash_lines(document)) + without_hash_lines(css))
    if css.len() > 0 and wu_external_css == 1 {
        let w = intern_text(css)
        let seen = false
        for (0 ..< wu_css_out.len()) |k| { if wu_css_out[k] == w { seen = true } }
        if not seen { wu_css_out.push(w) }
    } else if css.len() > 0 {
        let key = es_string(wus1(Wut.WutuDash, wutu_hash(css)))
        prelude = wus4(Wut.LetInstallCssFunVoidEs, prefix, key, key, es_string(css)) + wus2(Wut.InstallCss, prefix, prelude)
    }
    let declarations = ""
    for (0 ..< wu_decls.len()) |k| {
        if k > 0 { declarations = wus1(Wut.ANl, declarations) }
        declarations = declarations + word_text(wu_decls[k])
    }
    let render = wus4(Wut.BraceSpaceASpaceBCSpaceDSemiSpaceBraceEnd, declarations, prelude, code, events)
    let value = render
    if tw_reactive == 1 {
        let mount = wutu_helper(if wu_has_browser == 0 { wus(Wut.MountExt) } else if fragment { wus(Wut.MountFragment) } else if svg { wus(Wut.MountSvg) } else { wus(Wut.Mount) })
        let last = word_text(wu_decls[wu_decls.len() - 1])
        let ret_t = if wu_has_browser == 0 { wus(Wut.ExternrefSpace) } else if fragment { wus(Wut.BrowserDocumentFragment) } else if svg { wus(Wut.BrowserSVGElement) } else { wus(Wut.BrowserHTMLElementDot) }
        value = wus4(Wut.ClReturn, last, mount, ret_t, render) + wus1(Wut.AClose, (if tw_scope >= 0 { word_text(tw_scope) } else { "\"\"" }))
    }
    graft_expression(site, wus1(Wut.WutuInit, value))
}

/// The `;` ending the CSS statement at `at`, outside strings and parentheses, or -1.
fn css_statement_end(css: Str, at: I32) I32 {
    let quote = 0
    let depth = 0
    let j = at
    while (j < css.len()) {
        let c = css.get(j)
        if quote != 0 {
            if c == 92 { j += 1 } else if c == quote { quote = 0 }
        } else if c == 34 or c == 39 {
            quote = c
        } else if c == 40 {
            depth += 1
        } else if c == 41 {
            depth -= 1
        } else if c == 59 and depth <= 0 {
            return j
        }
        j += 1
    }
    return -1
}

/// `@document` CSS in the `wutu.document` cascade layer, so a style written on
/// an element (unlayered) wins over a document rule whatever their
/// specificity. `@import`s cannot sit in a layer block: they go first, each
/// importing into the layer.
fn layered_document_css(css: Str) Str {
    let imports = ""
    let rest = ""
    let i = 0
    let at = text_index(css, wus(Wut.Import), 0)
    while (at >= 0) {
        let end = css_statement_end(css, at)
        if end < 0 { break }
        let rule = css.slice(at, end)
        rest = rest + css.slice(i, at)
        imports = imports + (if text_index(rule, wus(Wut.Layer), 0) >= 0 { wus1(Wut.ASemi, rule) } else { wus1(Wut.LayerWutuDocument, rule) })
        i = end + 1
        at = text_index(css, wus(Wut.Import), i)
    }
    rest = rest + css.slice(i, css.len())
    return imports + (if trim_end(rest).len() > 0 { wus1(Wut.LayerWutuDocumentAtDotBraceBraceE, rest) } else { "" })
}

fn css_space(c: I32) Bool => c == 32 or c == 9 or c == 10 or c == 13 or c == 12

/// The CSS without its comments, its white space one space where it parts
/// two tokens: none at either end, after `{ } ; , :`, or before `{ } ; ,`.
/// Strings stay as written.
fn css_minify(css: Str) Str {
    let out = ""
    let n = css.len()
    let i = 0
    let gap = false
    while (i < n) {
        let c = css.get(i)
        if c == 47 and i + 1 < n and css.get(i + 1) == 42 {
            i += 2
            while (i < n and not (css.get(i) == 42 and i + 1 < n and css.get(i + 1) == 47)) { i += 1 }
            i = if i < n { i + 2 } else { n }
            gap = true
        } else if css_space(c) {
            gap = true
            i += 1
        } else {
            let j = i
            while (j < n and not css_space(css.get(j)) and not (css.get(j) == 47 and j + 1 < n and css.get(j + 1) == 42)) {
                let q = css.get(j)
                j += 1
                if q == 34 or q == 39 {
                    while (j < n and css.get(j) != q) { j += if css.get(j) == 92 { 2 } else { 1 } }
                    j = if j < n { j + 1 } else { n }
                }
            }
            if gap and out.len() > 0 {
                let a = out.get(out.len() - 1)
                if not (a == 123 or a == 125 or a == 59 or a == 44 or a == 58 or c == 123 or c == 125 or c == 59 or c == 44) { out = out + " " }
            }
            gap = false
            out = out + css.slice(i, j)
            i = j
        }
    }
    return out
}

/// The CSS without its comment lines (those that begin with `# `).
fn without_hash_lines(css: Str) Str {
    let out = ""
    let i = 0
    while (i < css.len()) {
        let j = i
        while (j < css.len() and (css.get(j) == 32 or css.get(j) == 9)) { j += 1 }
        if j + 1 < css.len() and css.get(j) == 35 and (css.get(j + 1) == 32 or css.get(j + 1) == 9) {
            let end = j
            while (end < css.len() and css.get(end) != 10 and css.get(end) != 13) { end += 1 }
            i = end
        } else {
            let end = i
            while (end < css.len() and css.get(end) != 10) { end += 1 }
            if end < css.len() { end += 1 }
            out = out + css.slice(i, end)
            i = end
        }
    }
    return out
}

/// Add stylesheet `key` to the site's; a repeated key replaces the CSS.
fn wutu_style(key: Str, css: Str) Void {
    let w = intern_text(key)
    for (0 ..< wu_style_key.len()) |k| {
        if wu_style_key[k] == w {
            wu_style_css[k] = intern_text(css)
            return
        }
    }
    wu_style_key.push(w)
    wu_style_css.push(intern_text(css))
}

/// Number the elements and collect their aliases, in order.
fn wutu_prepare(n: I32) Void {
    if tn_kind[n] == 4 {
        tn_index[n] = wu_node_count
        wu_node_count += 1
        if tn_binding[n] >= 0 { wu_aliases.push(n) }
    }
    let c = tn_first[n]
    while (c >= 0) {
        wutu_prepare(c)
        c = tn_next[c]
    }
    c = tn_else[n]
    while (c >= 0) {
        wutu_prepare(c)
        c = tn_next[c]
    }
}

/// The local that holds template element n.
fn node_uid(n: I32) Str => wus2(Wut.Node, wutu_prefix(), int_text(tn_index[n]))

/// Whether template node n is node `ancestor` or under it.
fn tn_within(n: I32, ancestor: I32) Bool {
    let x = n
    while (x >= 0) {
        if x == ancestor { return true }
        x = tn_parent[x]
    }
    return false
}

/// The element an identifier names, seen from `owner`: an enclosing
/// element's own alias, or one alias inside an enclosing subtree; else -1.
fn resolve_alias(name: I32, owner: I32, offset: I32) I32 {
    let scope = owner
    while (scope >= 0) {
        if tn_binding[scope] == name { return scope }
        let found = -1
        let count = 0
        for (0 ..< wu_aliases.len()) |k| {
            let a = wu_aliases[k]
            if tn_binding[a] == name and tn_within(a, scope) {
                found = a
                count += 1
            }
        }
        if count == 1 { return found }
        if count > 1 { wutu_fail(wus1(Wut.AmbiguousElementAliasReferenceItInside, word_text(name)), offset) }
        scope = tn_parent[scope]
    }
    return -1
}

/// A Utu island: in place (`__splice_N`), its alias names renamed; a value
/// without a range (a string literal) is written as it is.
fn wutu_island(source: Str, from: I32, to: I32, owner: I32) Str {
    if from < 0 { return source }
    let site = wu_site
    let start = dsl_byte(site, from)
    let stop = dsl_byte(site, to)
    let text = bytes_text(start, stop)
    let e = parse_span(start, stop)
    if e < 0 {
        let absolute = bytes_text(file_start[file_of_token(node_first[site])], start).len()
        let shown = if source.len() > 100 { source.slice(0, 100) } else { source }
        // (A range needs parentheses here: `for (0 ..< n) |i|`.)
        let range = false
        for (0 ..< source.len()) |k| { if text_at(source, k, wus(Wut.DotDot)) { range = true } }
        wutu_fail(wus3(Wut.InvalidUtuInterpolationAtOffset, int_text(absolute), shown, (if range and not (source.get(0) == 40) { wus(Wut.ARangeNeedsParenthesesFor0) } else { "" })), from)
    }
    let placeholder = dsl_splice(site, from, text)
    let k = splice_start.len() - 1
    rename_aliases(e, e, k, owner)
    return placeholder
}

fn rename_aliases(node: I32, root: I32, k: I32, owner: I32) Void {
    if is_kind(node, Node.Identifier) and is_reference(node) {
        let name = word_of(node)
        if not island_shadowed(node, name, root) {
            let at = tok_start[node_first[node]]
            let offset = dsl_units(wu_site, at)
            let alias = resolve_alias(name, owner, offset)
            if alias >= 0 {
                splice_rename_k.push(k)
                splice_rename_at.push(at)
                splice_rename_to.push(intern_text(node_uid(alias)))
            }
        }
        return
    }
    if is_kind(node, Node.Identifier) { return }
    let c = first_child(node)
    while (c >= 0) {
        rename_aliases(c, root, k, owner)
        c = next_sibling(c)
    }
}

/// Whether the island binds `name` around the identifier: a closure's
/// parameter, a let before it in a block, a loop's capture.
fn island_shadowed(ident: I32, name: I32, root: I32) Bool {
    let child = ident
    let p = parent_of(ident)
    while (p >= 0) {
        if is_kind(p, Node.Closure_expr) {
            let list = first_child(p)
            if is_kind(list, Node.Closure_param_list) {
                let param = first_child(list)
                while (param >= 0) {
                    if word_of(first_child(param)) == name { return true }
                    param = next_sibling(param)
                }
            }
            return false
        }
        if is_kind(p, Node.Block) {
            let q = parent_of(p)
            if q >= 0 {
                let cap = first_child(q)
                while (cap >= 0) {
                    if is_kind(cap, Node.Capture) {
                        let c = first_child(cap)
                        while (c >= 0) {
                            if word_of(c) == name { return true }
                            c = next_sibling(c)
                        }
                    }
                    cap = next_sibling(cap)
                }
            }
            let s = first_child(p)
            while (s >= 0 and s != child) {
                if is_kind(s, Node.Bind_expr) and is_kind(first_child(s), Node.Identifier) and word_of(first_child(s)) == name { return true }
                s = next_sibling(s)
            }
        }
        if p == root { return false }
        child = p
        p = parent_of(p)
    }
    return false
}

//! = Helpers: typed bindings to the reconciler, one per site

/// The site's typed binding of reconciler helper `kind` (`attr`, `append`,
/// `style`, …): declared in @wu_decls when first asked for, then by name.
fn wutu_helper(kind: Str) Str {
    let w = intern_text(kind)
    for (0 ..< wu_declared_kind.len()) |k| { if wu_declared_kind[k] == w { return word_text(wu_declared_name[k]) } }
    let name = wutu_prefix() + kind
    let params = ""
    let result = "Void"
    let js = ""
    if kind == wus(Wut.Attr) {
        params = wus(Wut.BrowserElementStrStr)
        js = wus(Wut.NKVGlobalThisUtuWutuAttr)
    } else if kind == wus(Wut.Boolean) {
        params = wus(Wut.BrowserElementStrBool)
        js = wus(Wut.NKVGlobalThisUtuWutuAttrOpenCommaCommaCl)
    } else if kind == wus(Wut.Append) {
        params = wus(Wut.Externref)
        js = wus(Wut.VGlobalThisUtuWutuAppendV)
    } else if kind == "put" {
        params = wus(Wut.Externref)
        js = wus(Wut.VGlobalThisUtuWutuPutV)
    } else if kind == wus(Wut.PutText) {
        params = "Str"
        js = wus(Wut.VGlobalThisUtuWutuPutV)
    } else if kind == wus(Wut.Url) {
        params = wus(Wut.BrowserElementStrStr)
        js = wus(Wut.NKVGlobalThisUtuWutuUrl)
    } else if kind == wus(Wut.Flag) {
        params = "Bool"
        js = wus(Wut.VGlobalThisUtuWutuPutV)
    } else if kind == "on" {
        params = if wu_has_browser == 1 { wus(Wut.ClBrowserEventVoid) } else { wus(Wut.ClExternrefVoid) }
        js = wus(Wut.VGlobalThisUtuWutuPutV)
    } else if kind == wus(Wut.PreventDefault) {
        params = wus(Wut.Externref)
        js = wus(Wut.EPreventDefault)
    } else if kind == wus(Wut.Begin) {
        params = "Str"
        js = wus(Wut.PGlobalThisUtuWutuBeginP)
    } else if kind == wus(Wut.Slot) {
        js = wus(Wut.GlobalThisUtuWutuSlot)
    } else if kind == wus(Wut.Arm) {
        params = "I32"
        js = wus(Wut.NGlobalThisUtuWutuArmN)
    } else if kind == wus(Wut.Item) {
        params = "Str"
        js = wus(Wut.KGlobalThisUtuWutuItemK)
    } else if kind == wus(Wut.ItemIndex) {
        params = "U64"
        js = wus(Wut.IGlobalThisUtuWutuItemI)
    } else if kind == wus(Wut.End) {
        js = wus(Wut.GlobalThisUtuWutuEnd)
    } else if kind == wus(Wut.NodeLc) {
        params = wus(Wut.BrowserNode)
        js = wus(Wut.VGlobalThisUtuWutuAppendV)
    } else if kind == wus(Wut.Event) {
        params = wus(Wut.BrowserElementStrClBrowserEvent)
        js = wus(Wut.NEHGlobalThisUtuWutuListen)
    } else if kind == wus(Wut.Leave) {
        js = wus(Wut.GlobalThisUtuWutuLeave)
    } else if kind == wus(Wut.IndexLc) {
        params = "U64"
        js = wus(Wut.IGlobalThisUtuWutuPushCallStringI)
    } else if kind == wus(Wut.Call) {
        // A slot's or a loop's key: the template's hash and the site's
        // position (one string per template, not one per site).
        params = wus(Wut.StrI32)
        js = wus(Wut.HPGlobalThisUtuWutuPushCallCall)
    } else if kind == "loop" {
        params = wus(Wut.StrI32)
        js = wus(Wut.HPGlobalThisUtuWutuPushCallLoop)
    } else if kind == wus(Wut.GlobalKey) {
        params = "Str"
        js = wus(Wut.KGlobalThisUtuWutuPushGlobalK)
    } else if kind == "key" {
        params = "Str"
        js = wus(Wut.KGlobalThisUtuWutuPushKeyK)
    } else if kind == wus(Wut.Unkey) {
        js = wus(Wut.GlobalThisUtuWutuPopKey)
    } else if kind == wus(Wut.Mount) {
        params = wus(Wut.ClBrowserHTMLElementStr)
        result = "Browser.HTMLElement"
        js = wus(Wut.FKGlobalThisUtuWutuMountF)
    } else if kind == wus(Wut.MountFragment) {
        params = wus(Wut.ClBrowserDocumentFragmentStr)
        result = "Browser.DocumentFragment"
        js = wus(Wut.FKGlobalThisUtuWutuMountF)
    } else if kind == wus(Wut.MountSvg) {
        params = wus(Wut.ClBrowserSVGElementStr)
        result = "Browser.SVGElement"
        js = wus(Wut.FKGlobalThisUtuWutuMountF)
    } else if kind == wus(Wut.MountExt) {
        params = wus(Wut.ClExternrefStr)
        result = "Externref"
        js = wus(Wut.FKGlobalThisUtuWutuMountF)
    } else if kind == wus(Wut.MemoHit) {
        // A reused hole (see memo_reuse): its key's last element, if it is unchanged.
        params = "Str"
        result = "Bool"
        js = wus(Wut.KGlobalThisUtuWutuMemoHitK)
    } else if kind == wus(Wut.MemoLast) {
        result = wus(Wut.Externref)
        js = wus(Wut.GlobalThisUtuWutuMemoLast)
    } else if kind == wus(Wut.MemoKeep) {
        params = wus(Wut.StrExternref)
        js = wus(Wut.KNGlobalThisUtuWutuMemoKeepK)
    } else if kind == wus(Wut.SelectSet) {
        // `bind:values`: a multiple select's chosen values, joined by U+001F, both ways.
        params = wus(Wut.BrowserElementStr)
        // (Applied again after the render: on the first, its options come after it.)
        js = wus(Wut.NVConstWNewSet)
    } else if kind == wus(Wut.SelectValue) {
        params = wus(Wut.BrowserHTMLSelectElementStr)
        js = wus(Wut.NVGlobalThisUtuWutuSelectValueN)
    } else if kind == wus(Wut.SelectGet) {
        params = wus(Wut.BrowserElement)
        result = "Str"
        js = wus(Wut.NConstAArrayFromN)
    } else {
        wutu_fail(wus1(Wut.InternalNoWutuHelper, kind), 0)
    }
    wu_decls.push(intern_text(wus4(Wut.LetFunEs, name, params, result, js)))
    wu_declared_kind.push(w)
    wu_declared_name.push(intern_text(name))
    return name
}

/// The reconciler's `node()` or `done()` (`entry`), typed to give the
/// element's own interface.
fn wutu_typed_fn(entry: Str, tag: Str, svg: Bool) Str {
    let kind = wus3(Wut.AXBC, entry, (if svg { wus(Wut.Svg) } else { "" }), tag)
    let w = intern_text(kind)
    for (0 ..< wu_declared_kind.len()) |k| { if wu_declared_kind[k] == w { return word_text(wu_declared_name[k]) } }
    let type = if entry == "done" and wu_has_browser == 0 { "Externref" } else if tag == wus(Wut.Fragment) { "Browser.DocumentFragment" } else if svg { "Browser.SVGElement" } else { wus1(Wut.BrowserHTMLElement, element_interface(tag)) }
    let name = wutu_prefix() + ident_part(kind)
    wu_decls.push(intern_text(wus3(Wut.LetFunEsGlobalThisUtuWutu, name, type, entry)))
    wu_declared_kind.push(w)
    wu_declared_name.push(intern_text(name))
    return name
}

/// A tag as part of a name: a custom element's `-` is `_x`, `_` is `__`.
fn ident_part(tag: Str) Str {
    let out = ""
    for (0 ..< tag.len()) |i| {
        let c = tag.get(i)
        out = out + (if c == 45 { wus(Wut.X2) } else if c == 95 { "__" } else { Str.from_code_point(c) })
    }
    return out
}

/// What goes between `HTML` and `Element` in the interface of a tag the
/// `Browser` declarations type more closely; empty for the rest.
fn element_interface(tag: Str) Str {
    if tag == wus(Wut.Input) { return wus(Wut.Input2) }
    if tag == "select" { return wus(Wut.Select) }
    if tag == wus(Wut.Textarea) { return wus(Wut.TextArea) }
    if tag == wus(Wut.Form) { return wus(Wut.Form2) }
    if tag == wus(Wut.Button) { return wus(Wut.Button2) }
    if tag == "a" { return wus(Wut.Anchor) }
    if tag == wus(Wut.Img) { return wus(Wut.Image) }
    if tag == wus(Wut.Canvas) { return wus(Wut.Canvas2) }
    if tag == wus(Wut.Video) { return wus(Wut.Video2) }
    if tag == wus(Wut.Audio) { return wus(Wut.Audio2) }
    if tag == wus(Wut.Option) { return wus(Wut.Option2) }
    if tag == wus(Wut.Label) { return wus(Wut.Label2) }
    if tag == wus(Wut.Details) { return wus(Wut.Details2) }
    if tag == wus(Wut.Dialog) { return wus(Wut.Dialog2) }
    if tag == wus(Wut.Progress) { return wus(Wut.Progress2) }
    if tag == wus(Wut.Meter) { return wus(Wut.Meter2) }
    if tag == wus(Wut.Output) { return wus(Wut.Output2) }
    if tag == "data" { return "Data" }
    return ""
}

/// The `Browser` event type a listener of event `name` takes, or empty for
/// a plain `Event`.
fn event_type(name: Str) Str {
    if in_words(wus(Wut.ClickDblclickAuxclickContextmenuMousedow), name) { return wus(Wut.MouseEvent) }
    if name == wus(Wut.Wheel) { return wus(Wut.WheelEvent) }
    if in_words(wus(Wut.KeydownKeyupKeypress), name) { return wus(Wut.KeyboardEvent) }
    if in_words(wus(Wut.PointerdownPointerupPointermovePointeren), name) { return wus(Wut.PointerEvent) }
    if in_words(wus(Wut.FocusBlurFocusinFocusout), name) { return wus(Wut.FocusEvent) }
    if name == wus(Wut.Beforeinput) { return wus(Wut.InputEvent) }
    if name == wus(Wut.Submit) { return wus(Wut.SubmitEvent) }
    if in_words(wus(Wut.DragDragstartDragendDragenterDragleaveDr), name) { return wus(Wut.DragEvent) }
    if in_words(wus(Wut.TouchstartTouchendTouchmoveTouchcancel), name) { return wus(Wut.TouchEvent) }
    if in_words(wus(Wut.AnimationstartAnimationendAnimationitera), name) { return wus(Wut.AnimationEvent) }
    if in_words(wus(Wut.TransitionstartTransitionendTransitionru), name) { return wus(Wut.TransitionEvent) }
    if in_words(wus(Wut.CopyCutPaste), name) { return wus(Wut.ClipboardEvent) }
    return ""
}

//! = Elements
//!
//! wutu_element gives the statements creating the element and its
//! children; listeners (its own and its children's) go to wx_events, to be
//! attached once their siblings exist: after the template's code, or after
//! an if's or a loop's fragment.

/// Listeners pending (words), in order.
vec wx_events: I32
/// Reconciled, their ops (words), in the same order.
vec wx_event_ops: I32

/// Whether a handler's source names `event` (as a word, not a member).

/// The closure an `on name [|e|] { … }` block becomes. `e` (word `param`, or
/// -1 for none) is the event, typed as HTMLElementEventMap types it (`on
/// click |e|` gets a MouseEvent). `on submit` also prevents navigation.
fn event_listener(name: Str, handler: Str, param: I32) Str {
    let prevent = if name == wus(Wut.Submit) { wus1(Wut.PreventCall, wutu_helper(wus(Wut.PreventDefault))) } else { "" }
    let type = event_type(name)
    if param < 0 { return wus2(Wut.ClWutuEventVoid, prevent, handler) }
    let e = word_text(param)
    if type.len() > 0 { return wus4(Wut.ClWutuEventVoidAltWutu, prevent, type, e, handler) }
    return wus3(Wut.ClWutuEventVoidLetWutu, prevent, e, handler)
}

/// Whether an `on` handler can only change its own elements: every statement
/// assigns to a property of an `as` element (`overlay.scrollTop = …`) from
/// those elements, its `|e|` event, and literals, and nothing is called. Such a
/// handler is quiet: nothing a render reads changed, so none follows it.
/// Anything else (a call, a closure, a local, a struct field) renders.
fn quiet_handler(body: Str, param: I32) Bool {
    // The code without its strings, outer braces, and blanks at either end.
    let code = ""
    let i = 0
    while (i < body.len()) {
        let c = body.get(i)
        if c == 34 {
            i += 1
            while (i < body.len() and body.get(i) != 34 and body.get(i) != 10) { i += if body.get(i) == 92 { 2 } else { 1 } }
            code = wus1(Wut.AQuoteQuote, code)
        } else if c == 47 and i + 1 < body.len() and body.get(i + 1) == 47 {
            // A line comment says nothing.
            while (i + 1 < body.len() and body.get(i + 1) != 10) { i += 1 }
        } else {
            code = code + Str.from_code_point(c)
        }
        i += 1
    }
    let a = 0
    let b = code.len()
    while (a < b and is_space_code(code.get(a))) { a += 1 }
    while (b > a and is_space_code(code.get(b - 1))) { b -= 1 }
    if a < b and code.get(a) == 123 and code.get(b - 1) == 125 { a += 1; b -= 1 }
    code = code.slice(a, b)
    for (0 ..< code.len()) |k| {
        let c = code.get(k)
        if c == 40 or c == 41 or c == 123 or c == 125 or c == 91 or c == 93 { return false }
        if c == 47 and k + 1 < code.len() and code.get(k + 1) == 42 { return false }
    }
    let statements = 0
    let start = 0
    while (start <= code.len()) {
        let end = start
        while (end < code.len() and code.get(end) != 59 and code.get(end) != 10) { end += 1 }
        let statement = code.slice(start, end)
        if trim_end(statement).len() > 0 {
            if not quiet_statement(statement, param) { return false }
            statements += 1
        }
        start = end + 1
    }
    return statements > 0
}

/// `alias.property (op)= value` where the value reads only elements, the
/// event parameter (word `param`), and literals.
fn quiet_statement(statement: Str, param: I32) Bool {
    let i = skip_spaces(statement, 0)
    let a = i
    while (i < statement.len() and word_byte(statement.get(i))) { i += 1 }
    if i == a or not is_alias_name(statement.slice(a, i)) { return false }
    let members = 0
    while (i < statement.len() and statement.get(i) == 46) {
        i += 1
        let m = i
        while (i < statement.len() and word_byte(statement.get(i))) { i += 1 }
        if i == m { return false }
        members += 1
    }
    if members == 0 { return false }
    i = skip_spaces(statement, i)
    if i < statement.len() and (statement.get(i) == 43 or statement.get(i) == 45 or statement.get(i) == 42 or statement.get(i) == 47) { i += 1 }
    if i >= statement.len() or statement.get(i) != 61 { return false }
    if i + 1 < statement.len() and statement.get(i + 1) == 61 { return false }
    i += 1
    while (i < statement.len()) {
        let c = statement.get(i)
        let before = if i > 0 { statement.get(i - 1) } else { 32 }
        if (word_byte(c) and not (c >= 48 and c <= 57)) and not word_byte(before) and before != 46 {
            let w = i
            while (i < statement.len() and word_byte(statement.get(i))) { i += 1 }
            let word = statement.slice(w, i)
            if not is_alias_name(word) and not (param >= 0 and word == word_text(param)) and not in_words(wus(Wut.TrueFalseNullNotAndOr), word) { return false }
        } else {
            i += 1
        }
    }
    return true
}

/// Whether `name` is an `as` name in the template.
fn is_alias_name(name: Str) Bool {
    for (0 ..< wu_aliases.len()) |k| { if word_text(tn_binding[wu_aliases[k]]) == name { return true } }
    return false
}

fn word_byte(c: I32) Bool => (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95

/// An element's classes, its scoped CSS's among them (registered here), space-separated.
fn wutu_classes(n: I32) Str {
    let classes = ""
    let css = ""
    let i = tn_items[n]
    while (i >= 0) {
        if ti_kind[i] == 0 { classes = classes + (if classes.len() > 0 { " " } else { "" }) + word_text(ti_a[i]) }
        if ti_kind[i] == 4 { css = css + word_text(ti_c[i]) }
        i = ti_next[i]
    }
    if css.len() > 0 {
        let key = wus1(Wut.W, wutu_hash(css))
        wutu_style(key, wus2(Wut.DotABraceBBraceEnd, key, css))
        classes = classes + (if classes.len() > 0 { " " } else { "" }) + key
    }
    return classes
}

/// Whether a source is a written string without escapes (`"…"`): its text is known.
fn plain_literal(source: Str) Bool {
    let n = source.len()
    if n < 2 or source.get(0) != 34 or source.get(n - 1) != 34 { return false }
    for (1 ..< n - 1) |k| { if source.get(k) == 34 or source.get(k) == 92 { return false } }
    return true
}

/// A text as a JSON string (what the runtime's JSON.parse reads back).
fn wutu_json(text: Str) Str {
    let out = "\""
    for (0 ..< text.len()) |i| {
        let c = text.get(i)
        if c == 34 { out = wus1(Wut.ABackslashQuote, out) }
        else if c == 92 { out = wus1(Wut.ABackslashBackslash, out) }
        else if c < 32 { out = wus3(Wut.U00, out, (if c < 16 { "0" } else { wus(Wut.N1) }), wus(Wut.N0123456789abcdef).slice(c % 16, c % 16 + 1)) }
        else { out = out + Str.from_code_point(c) }
    }
    return wus1(Wut.AQuote, out)
}

/// Whether property `name` is a URL a browser follows or loads (see `safe` in src/runtime/wutu.js).
fn is_url_property(name: Str) Bool => in_words(wus(Wut.HrefSrcActionFormActionPosterCite), name)

/// Whether attribute item i is known when compiling (written, not a property),
/// so it comes in the element's shell. A written class merges, so it does not.
fn wutu_baked(i: I32) Bool {
    return ti_kind[i] == 1 and (ti_flags[i] & 3) == 0 and word_text(ti_a[i]) != "class" and plain_literal(word_text(ti_b[i]))
}

/// An element's attributes known when compiling, as a JSON object.
fn wutu_static_attributes(n: I32, classes: Str) Str {
    let written_class = false
    let i = tn_items[n]
    while (i >= 0) {
        if ti_kind[i] == 1 and word_text(ti_a[i]) == "class" { written_class = true }
        i = ti_next[i]
    }
    let out = "{"
    if classes.len() > 0 and not written_class { out = wus2(Wut.Class, out, wutu_json(classes)) }
    i = tn_items[n]
    while (i >= 0) {
        if wutu_baked(i) {
            let value = word_text(ti_b[i])
            out = wus4(Wut.ABCColonD, out, (if out.len() > 1 { "," } else { "" }), wutu_json(word_text(ti_a[i])), wutu_json(value.slice(1, value.len() - 1)))
        }
        i = ti_next[i]
    }
    return wus1(Wut.ABraceEnd, out)
}

/// Whether nothing in element n's subtree changes between renders: no
/// expressions, events, bindings, styles, or aliases; only written text.
/// (Raw-text elements are left to the general path.)
fn wutu_still(n: I32) Bool {
    if tn_binding[n] >= 0 { return false }
    let tag = word_text(tn_text[n])
    if tag == "script" or tag == wus(Wut.Style) or tag == wus(Wut.Textarea) or tag == wus(Wut.Template) { return false }
    let i = tn_items[n]
    while (i >= 0) {
        let k = ti_kind[i]
        if k == 2 or k == 3 or k == 5 { return false }
        if k == 1 and ((ti_flags[i] & 3) != 0 or not plain_literal(word_text(ti_b[i]))) { return false }
        i = ti_next[i]
    }
    let c = tn_first[n]
    while (c >= 0) {
        if tn_kind[c] == 4 { if not wutu_still(c) { return false } }
        else if tn_kind[c] != 0 or not plain_literal(word_text(tn_text[c])) { return false }
        c = tn_next[c]
    }
    return true
}

/// A still subtree's description: `[tag, {attributes}, ...children]`, as JSON.
fn wutu_description(n: I32) Str {
    let out = wus2(Wut.BracketACommaB, wutu_json(word_text(tn_text[n])), wutu_static_attributes(n, wutu_classes(n)))
    let c = tn_first[n]
    while (c >= 0) {
        if tn_kind[c] == 4 { out = wus2(Wut.ACommaB, out, wutu_description(c)) }
        else {
            let text = word_text(tn_text[c])
            out = wus2(Wut.ACommaB, out, wutu_json(text.slice(1, text.len() - 1)))
        }
        c = tn_next[c]
    }
    return wus1(Wut.ABracketEnd, out)
}

//! = Templates as data
//!
//! Reconciled, a template is a program: its structure as JSON ops (see
//! `src/runtime/wutu.js`), which the runtime runs as the module supplies the
//! template's values, in order. Shells, still subtrees, written text, and
//! static attributes are only data; the code holds the holes: `put()` for an
//! attribute, a value, or a listener, `slot()` before a value that may
//! render, `arm()` for an if, `item()` and `end()` for a loop, and `node()`
//! where code needs an element (an alias, a property, a binding).

/// A program being written: its ops, comma-separated.
struct WOps:
    | text: Str

fn wd_op(o: WOps, item: Str) Void { o.text = o.text + (if o.text.len() > 0 { "," } else { "" }) + item }

/// Whether code needs element n itself: an alias, a property, or a binding.
fn wd_needs_node(n: I32) Bool {
    if tn_binding[n] >= 0 { return true }
    let i = tn_items[n]
    while (i >= 0) {
        if ti_kind[i] == 3 or (ti_kind[i] == 1 and (ti_flags[i] & 1) != 0) { return true }
        i = ti_next[i]
    }
    return false
}

/// Element n's ops, into `o`, and the code that supplies its values (its
/// listeners go to @wx_events and @wx_event_ops).
fn wd_element(n: I32, outer_svg: Bool, o: WOps) Str {
    let tag = word_text(tn_text[n])
    let svg = outer_svg or tag == wus(Wut.SvgLc) or (is_svg_tag(tag) and not is_html_tag(tag))
    let flag = if svg { wus(Wut.N1Comma) } else { "" }
    let index = int_text(tn_index[n])
    if wutu_still(n) {
        wd_op(o, wus3(Wut.S, index, wutu_description(n), flag))
        return ""
    }
    let classes = wutu_classes(n)
    wd_op(o, wus4(Wut.O, index, wutu_json(tag), wutu_static_attributes(n, classes), flag))
    let id = node_uid(n)
    let code = ""
    if wd_needs_node(n) {
        wd_op(o, wus1(Wut.N, index))
        code = wus2(Wut.Let, id, wutu_typed_fn(wus(Wut.NodeLc), tag, svg))
    }
    let properties = ""
    let i = tn_items[n]
    while (i >= 0) {
        if ti_kind[i] == 1 and not wutu_baked(i) {
            let name = word_text(ti_a[i])
            let value = wutu_island(word_text(ti_b[i]), ti_from[i], ti_to[i], n)
            if (ti_flags[i] & 1) != 0 and name == "value" and tag == "select" {
                properties = wus2(Wut.ABSemiNl, properties, select_value(id, value))
            } else if (ti_flags[i] & 1) != 0 {
                // An unchanged value is not assigned: selection and caret
                // survive updates. (The value is assigned to a local of the
                // property's type first, so a wrong one says so.)
                let was = wus2(Wut.Was, id, name)
                let now = wus2(Wut.Now, id, name)
                // (A URL one goes through the runtime's check, as its attribute does.)
                let set = if is_url_property(name) { wus4(Wut.AOpenBCommaSpaceQuoteCQuoteCommaSpaceDClose, wutu_helper(wus(Wut.Url)), id, name, now) } else { wus3(Wut.ADotBSpaceEqSpaceC, id, name, now) }
                properties = wus4(Wut.LetLet, properties, was, id, name) + wus4(Wut.If, now, was, now, value) + wus3(Wut.ASpaceBangEqSpaceBSpaceBraceSpaceCSemiSpaceBrace, was, now, set)
            } else if is_boolean_attribute(name) and (ti_flags[i] & 2) != 0 {
                wd_op(o, wus1(Wut.B, wutu_json(name)))
                code = wus3(Wut.ABOpenOpenCCloseCloseSemiNl, code, wutu_helper(wus(Wut.Flag)), value)
            } else {
                wd_op(o, if name == "class" and classes.len() > 0 { wus1(Wut.M, wutu_json(wus1(Wut.ASpace, classes))) } else { wus1(Wut.A, wutu_json(name)) })
                // (An attribute's value is text.)
                code = wus3(Wut.ABOpenOpenCCloseCloseSemiNl, code, wutu_helper(wus(Wut.PutText)), value)
            }
        }
        i = ti_next[i]
    }
    i = tn_items[n]
    while (i >= 0) {
        if ti_kind[i] == 5 {
            wd_op(o, wus1(Wut.Y, wutu_json(word_text(ti_a[i]))))
            code = wus3(Wut.ABOpenOpenCCloseCloseSemiNl, code, wutu_helper(wus(Wut.PutText)), wutu_island(word_text(ti_b[i]), ti_from[i], ti_to[i], n))
        }
        i = ti_next[i]
    }
    let child_svg = svg and tag != wus(Wut.ForeignObject)
    let c = tn_first[n]
    while (c >= 0) {
        code = code + wd_child(c, child_svg, o)
        c = tn_next[c]
    }
    wd_op(o, wus(Wut.C))
    code = code + properties
    i = tn_items[n]
    while (i >= 0) {
        if ti_kind[i] == 3 { code = code + wd_binding(n, i) }
        if ti_kind[i] == 2 {
            let handler = wutu_island(word_text(ti_b[i]), ti_from[i], ti_to[i], n)
            let name = word_text(ti_a[i])
            let shorthand = (ti_flags[i] & 1) != 0
            let listener = if shorthand { event_listener(name, handler, ti_c[i]) } else { handler }
            let quiet = (ti_flags[i] & 4) != 0 or (shorthand and quiet_handler(word_text(ti_b[i]), ti_c[i]))
            wx_events.push(intern_text(wus2(Wut.AOpenOpenBCloseCloseSemiNl, wutu_helper("on"), listener)))
            wx_event_ops.push(intern_text(wus2(Wut.V, index, wutu_json((if quiet { "~" } else { "" }) + name))))
        }
        i = ti_next[i]
    }
    return code
}

/// A binding's code: the property written on render, read back on input.
fn wd_binding(n: I32, i: I32) Str {
    let id = node_uid(n)
    let target = wutu_island(word_text(ti_b[i]), ti_from[i], ti_to[i], n)
    let kind = word_text(ti_a[i])
    let update = located_splice(wu_site, binding_update(kind, id, target), ti_at[i], ti_to[i])
    wx_events.push(intern_text(wus2(Wut.ClWutuEventVoidOpenOpenCloseBra, wutu_helper("on"), update)))
    wx_event_ops.push(intern_text(wus2(Wut.VBracketQuoteQuot, int_text(tn_index[n]), binding_event(kind))))
    if kind == "value" and word_text(tn_text[n]) == "select" { return wus1(Wut.ASemiNl, located_splice(wu_site, select_value(id, target), ti_at[i], ti_to[i])) }
    return binding_sync_code(kind, id, target, i)
}

/// A select's value: set again once its options are in place (they may come with this render).
fn select_value(id: Str, value: Str) Str => wus3(Wut.AOpenBCommaSpaceOpenCCloseClose, wutu_helper(wus(Wut.SelectValue)), id, value)

/// A binding's sync (state into the element, on render), located at the
/// bind statement; empty for `files`, which is read-only.
fn binding_sync_code(kind: Str, id: Str, target: Str, i: I32) Str {
    let sync = binding_sync(kind, id, target)
    return if sync.len() == 0 { "" } else { wus1(Wut.ASemiNl, located_splice(wu_site, sync, ti_at[i], ti_to[i])) }
}

/// `bind:values` crosses as one string: U+001F before each chosen value ("" for none, so `[""]` differs).
fn values_separator() Str => wus(Wut.U001fQuoteBackslashQu)

/// A binding's sync code:
///   value / checked   a string / a Bool property
///   number            valueAsNumber (an unparsable entry leaves the state)
///   group             a radio group: the checked radio's value
///   values            a multiple select's chosen values, an Array[Str]
///   files             a file input's ?Browser.FileList (read-only: none)
fn binding_sync(kind: Str, id: Str, target: Str) Str {
    // (Only an entry the input cannot parse is kept: a value out of range or step still shows.)
    if kind == "number" {
        let number = wus2(Wut.WutuNumberAs, target, id + wus(Wut.ValueAsNumber))
        return wus4(Wut.IfNotValidityBadInputAndValueAsNumber, id, id, number, id) + wus1(Wut.ACloseSemiSpaceBraceEnd, number)
    }
    if kind == wus(Wut.Group) { return wus4(Wut.IfCheckedValueChecked, id, id, target, id) + wus2(Wut.Value, id, target) }
    if kind == "values" { return wus4(Wut.IfLen0Else, wutu_helper(wus(Wut.SelectSet)), id, target, values_separator()) + wus2(Wut.Join, values_separator(), target) }
    if kind == wus(Wut.FilesLc) { return "" }
    return wus4(Wut.IfDotBangEqOpenClo, id, kind, target, id) + wus2(Wut.ASpaceEqSpaceOpenBCloseSemiSpaceBraceEnd, kind, target)
}

/// What reads a binding back into the state, when its event fires.
fn binding_update(kind: Str, id: Str, target: Str) Str {
    // NaN != NaN: an unparsable number leaves the state as it is.
    if kind == "number" { return wus4(Wut.IfValueAsNumberValueAsNumberValueAsNumbe, id, id, target, wus2(Wut.WutuNumberAs, id + wus(Wut.ValueAsNumber), target)) }
    if kind == wus(Wut.Group) { return wus3(Wut.IfCheckedValue, id, target, id) }
    // (One expression: the update is spliced in as one.)
    if kind == "values" {
        let chosen = wus2(Wut.AOpenBClose, wutu_helper(wus(Wut.SelectGet)), id)
        return wus4(Wut.IfLen0ArrayStrNew, target, chosen, chosen, chosen) + wus1(Wut.ACloseSemiSpaceBraceEnd, values_separator())
    }
    if kind == wus(Wut.FilesLc) { return wus2(Wut.Files, target, id) }
    return wus3(Wut.ASpaceEqSpaceBDotC, target, id, kind)
}

/// The event a binding listens to.
fn binding_event(kind: Str) Str => if kind == "value" or kind == "number" { wus(Wut.Input) } else { wus(Wut.Change) }

/// The children from `first`, as ops into `o`, then their listeners.
fn wd_fragment(first: I32, svg: Bool, o: WOps) Str {
    let mark = wx_events.len()
    let code = ""
    let c = first
    while (c >= 0) {
        code = code + wd_child(c, svg, o)
        c = tn_next[c]
    }
    for (mark ..< wx_events.len()) |k| {
        code = code + word_text(wx_events[k])
        wd_op(o, word_text(wx_event_ops[k]))
    }
    wx_events.resize(mark)
    wx_event_ops.resize(mark)
    return code
}

/// A child's ops, into `o`, and its code.
fn wd_child(child: I32, svg: Bool, o: WOps) Str {
    let kind = tn_kind[child]
    if kind == 4 { return wd_element(child, svg, o) }
    if kind == 2 {
        let then = WOps { text: "" }
        let otherwise = WOps { text: "" }
        let condition = wutu_island(word_text(tn_text[child]), tn_from[child], tn_to[child], child)
        let a = wd_fragment(tn_first[child], svg, then)
        let b = wd_fragment(tn_else[child], svg, otherwise)
        wd_op(o, wus2(Wut.I, then.text, otherwise.text))
        return wus4(Wut.If1Else0, condition, wutu_helper(wus(Wut.Arm)), a, wutu_helper(wus(Wut.Arm))) + wus1(Wut.ASpaceBraceEndSemiNl, b)
    }
    if kind == 3 { return wd_loop(child, svg, o) }
    if kind == 6 {
        let scrutinee = wutu_island(word_text(tn_text[child]), tn_from[child], tn_to[child], child)
        let arm_fn = wutu_helper(wus(Wut.Arm))
        let arms_ops = ""
        let arms_code = ""
        let idx = 0
        let a = tn_first[child]
        while (a >= 0) {
            let aops = WOps { text: "" }
            let acode = wd_fragment(tn_first[a], svg, aops)
            if idx > 0 { arms_ops = wus2(Wut.ACommaB, arms_ops, wus1(Wut.BracketABracketEnd, aops.text)) }
            else { arms_ops = wus1(Wut.BracketABracketEnd, aops.text) }
            if tn_text[a] >= 0 {
                arms_code = arms_code + wus4(Wut.MatchArmCode, word_text(tn_text[a]), arm_fn, int_text(idx), acode)
            } else {
                arms_code = arms_code + wus3(Wut.MatchDefCode, arm_fn, int_text(idx), acode)
            }
            idx += 1
            a = tn_next[a]
        }
        wd_op(o, wus1(Wut.KMatch, arms_ops))
        return wus2(Wut.MatchStmt, scrutinee, arms_code)
    }
    // Written text is data; another value is a hole (with a call key, for
    // the elements a component it calls makes).
    let source = word_text(tn_text[child])
    if tn_from[child] < 0 and plain_literal(source) {
        wd_op(o, wus1(Wut.T, wutu_json(source.slice(1, source.len() - 1))))
        return ""
    }
    if tn_from[child] < 0 {
        // Written text with escapes: utu where it is written (a bad escape is reported there).
        wd_op(o, wus(Wut.WBracketQuoteQuot))
        return wus2(Wut.AOpenOpenBCloseCloseSemiNl, wutu_helper("put"), wutu_island(source, tn_start[child], tn_start[child] + source.len(), child))
    }
    let value = shown(wutu_island(source, tn_from[child], tn_to[child], child), tn_from[child])
    wd_op(o, wus1(Wut.XBracketQuoteQuot, int_text(tn_from[child])))
    let reuse = memo_reuse(child, value)
    if reuse.len() > 0 { return wus2(Wut.AOpenCloseSemiNlB, wutu_helper(wus(Wut.Slot)), reuse) }
    return wus3(Wut.AOpenCloseSemiNlBOpenCCloseSemiNl, wutu_helper(wus(Wut.Slot)), wutu_helper("put"), value)
}

/// A hole that calls a function (`= f(a, b);`), as code that puts back the
/// element f made last time when its key is unchanged (see check.utu's
/// "Reusing a component's DOM"; the compiler makes the key "" when f(…)
/// cannot be reused). Empty for any other hole.
fn memo_reuse(child: I32, value: Str) Str {
    let source = word_text(tn_text[child])
    let from = tn_from[child]
    // The callee: a name or a dotted path, then `(`; the call ends the hole.
    let i = 0
    while (i < source.len() and (is_word_code(source.get(i)) or source.get(i) == 46)) { i += 1 }
    if i == 0 or i >= source.len() or source.get(i) != 40 or source.get(source.len() - 1) != 41 { return "" }
    let name = source.slice(0, i)
    // Its arguments: top-level commas, outside strings and brackets.
    let key = wus1(Wut.BacktickA, name)
    let depth = 0
    let start = i + 1
    let j = i
    while (j < source.len()) {
        let c = source.get(j)
        if c == 34 {
            j += 1
            while (j < source.len() and source.get(j) != 34) { j += if source.get(j) == 92 { 2 } else { 1 } }
        } else if c == 40 or c == 91 or c == 123 {
            depth += 1
        } else if c == 41 or c == 93 or c == 125 {
            depth -= 1
            // The call's `)` closes it before its end: not one call.
            if depth == 0 and j < source.len() - 1 { return "" }
        }
        if (c == 44 and depth == 1) or (depth == 0 and j == source.len() - 1) {
            let a = start
            let b = j
            while (a < b and is_space_code(source.get(a))) { a += 1 }
            while (b > a and is_space_code(source.get(b - 1))) { b -= 1 }
            if b > a { key = wus2(Wut.U001f, key, wutu_island(source.slice(a, b), from + a, from + b, child)) }
            start = j + 1
        }
        j += 1
    }
    key = wus1(Wut.ABacktick, key)
    let call = wutu_island(source, from, tn_to[child], child)
    let k = wus2(Wut.Key, wutu_prefix(), int_text(from))
    let n = wus2(Wut.Made, wutu_prefix(), int_text(from))
    return wus4(Wut.LetWutuMemoKeyIf, k, call, key, wutu_helper(wus(Wut.MemoHit))) + wus4(Wut.ElseLet, k, wutu_helper("put"), wutu_helper(wus(Wut.MemoLast)), n) + wus4(Wut.ASemiSpaceBOpenCCommaSpaceDCloseSemiSpace, value, wutu_helper(wus(Wut.MemoKeep)), k, n) + wus2(Wut.AOpenBCloseSemiSpaceBraceEndSemiNl, wutu_helper("put"), n)
}

/// A `for`: its body as a program of its own, run per `item()`.
fn wd_loop(n: I32, svg: Bool, o: WOps) Str {
    let written = word_text(tn_captures[n])
    let comma = text_index(written, ",", 0)
    let keyed = tn_key[n] >= 0
    let index = ""
    let captures = written
    if comma >= 0 { index = trim_text(written.slice(comma + 1, written.len())) }
    else if not keyed {
        index = wus2(Wut.Index, wutu_prefix(), int_text(wu_node_count))
        wu_node_count += 1
        captures = wus2(Wut.ACommaSpaceB, written, index)
    }
    let iterable = wutu_island(word_text(tn_text[n]), tn_from[n], tn_to[n], n)
    let next = if keyed { wus2(Wut.WutuKeyText, wutu_helper(wus(Wut.Item)), wutu_island(word_text(tn_key[n]), tn_key_from[n], tn_key_to[n], n)) }
        else { wus2(Wut.AOpenBCloseSemi, wutu_helper(wus(Wut.ItemIndex)), index) }
    let body = WOps { text: "" }
    let fragment = wd_fragment(tn_first[n], svg, body)
    let mode = if not keyed { 0 } else if tn_global[n] == 1 { 2 } else { 1 }
    wd_op(o, wus3(Wut.F, int_text(mode), int_text(tn_from[n]), body.text))
    return wus4(Wut.Each, iterable, captures, next, fragment) + wus1(Wut.AOpenCloseSemiNl, wutu_helper(wus(Wut.End)))
}

//! = Children

/// A text hole's value: `= x;` is `wutu.show(x)` (a number or Bool shows as
/// its str, a Str or a node as itself); written text (from < 0) is itself.
fn shown(value: Str, from: I32) Str => if from < 0 { wus1(Wut.OpenAClose, value) } else { wus1(Wut.WutuShow, value) }

/// Whether an identifier refers to a value (not a field, member, or
/// parameter name, nor a binding being declared).
fn is_reference(node: I32) Bool {
    let p = parent_of(node)
    if p < 0 { return true }
    if (is_kind(p, Node.Field_expr) or is_kind(p, Node.Optional_field_expr) or is_kind(p, Node.Type_member_expr)) and first_child(p) != node { return false }
    if (is_kind(p, Node.Field_init) or is_kind(p, Node.Bind_expr)) and first_child(p) == node { return false }
    return not (is_kind(p, Node.Param) or is_kind(p, Node.Capture) or is_kind(p, Node.Closure_param) or is_kind(p, Node.Closure_param_list) or is_kind(p, Node.Self_param))
}

