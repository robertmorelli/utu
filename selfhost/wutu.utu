fn wus(t: Wut) Str => st(st_wutu + t.i32())
fn wus1(t: Wut, a: Str) Str => stf(st_wutu + t.i32(), a, "", "", "")
fn wus2(t: Wut, a: Str, b: Str) Str => stf(st_wutu + t.i32(), a, b, "", "")
fn wus3(t: Wut, a: Str, b: Str, c: Str) Str => stf(st_wutu + t.i32(), a, b, c, "")
fn wus4(t: Wut, a: Str, b: Str, c: Str, d: Str) Str => stf(st_wutu + t.i32(), a, b, c, d)
