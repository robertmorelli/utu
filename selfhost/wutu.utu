fn wus_src(t: Wut) Str {
    return match t {
        Wut.U002f => "{0}\\u002f",
        Wut.Wutu => "__wutu_{0}_",
        Wut.AOpenBCloseSemiNlC => "{0}({1});\n{2}",
        Wut.BracketABracketEnd => "[{0}]",
        Wut.ABOpenClose => "{0}{1}()",
        Wut.WutuStyle => "{0}wutu.style({1});\n",
        Wut.WutuDash => "wutu-{0}",
        Wut.LetInstallCssFunVoidEs => "let {0}install_css: fun() Void = @es/\\ () => { if (!document.getElementById({1})) { const s=document.createElement('style'); s.id={2}; s.setAttribute('data-wutu-style',''); s.textContent={3}; document.head.append(s); } } \\/; ",
        Wut.InstallCss => "{0}install_css();\n{1}",
        Wut.ANl => "{0}\n",
        Wut.BraceSpaceASpaceBCSpaceDSemiSpaceBraceEnd => "{ {0} {1}{2} {3}; }",
        Wut.ClReturn => "{0} {1}(cl() {2}{ return {3}; }, ",
        Wut.AClose => "{0})",
        Wut.WutuInit => "{ wutu.init(); {0}; }",
        Wut.ASemi => "{0};",
        Wut.LayerWutuDocument => "{0} layer(wutu.document);",
        Wut.LayerWutuDocumentAtDotBraceBraceE => "@layer wutu.document{{0}}",
        Wut.Node => "{0}node{1}",
        Wut.AmbiguousElementAliasReferenceItInside => "Ambiguous element alias '{0}'; reference it inside its own subtree",
        Wut.InvalidUtuInterpolationAtOffset => "Invalid Utu interpolation at offset {0}: {1}{2}",
        Wut.InternalNoWutuHelper => "internal: no Wutu helper {0}",
        Wut.LetFunEs => "let {0}: fun({1}) {2} = @es/\\ {3} \\/;",
        Wut.AXBC => "{0}_{1}{2}",
        Wut.BrowserHTMLElement => "Browser.HTML{0}Element",
        Wut.LetFunEsGlobalThisUtuWutu => "let {0}: fun() {1} = @es/\\ ()=>globalThis.__utuWutu.{2}() \\/;",
        Wut.ClWutuEventVoid => "cl(__wutu_event) Void { {0} {1}; }",
        Wut.ClWutuEventVoidAltWutu => "cl(__wutu_event) Void { {0} alt __wutu_event { Browser.{1} |{2}| => { {3}; }, ~> {}, }; }",
        Wut.ClWutuEventVoidLetWutu => "cl(__wutu_event) Void { {0} let {1} = __wutu_event; {2}; }",
        Wut.AQuoteQuote => "{0}\"\"",
        Wut.W => "w{0}",
        Wut.DotABraceBBraceEnd => ".{0}{{1}}",
        Wut.ABackslashQuote => "{0}\\\"",
        Wut.ABackslashBackslash => "{0}\\\\",
        Wut.U00 => "{0}\\u00{1}{2}",
        Wut.AQuote => "{0}\"",
        Wut.Class => "{0}\"class\":{1}",
        Wut.ABCColonD => "{0}{1}{2}:{3}",
        Wut.ABraceEnd => "{0}}",
        Wut.BracketACommaB => "[{0},{1}",
        Wut.ACommaB => "{0},{1}",
        Wut.ABracketEnd => "{0}]",
        Wut.S => "[\"s\",{0},{1}{2}]",
        Wut.O => "[\"o\",{0},[{1},{2}]{3}]",
        Wut.N => "[\"n\",{0}]",
        Wut.Let => "let {0} = {1}();\n",
        Wut.ABSemiNl => "{0}{1};\n",
        Wut.Was => "{0}_{1}_was",
        Wut.Now => "{0}_{1}_now",
        Wut.AOpenBCommaSpaceQuoteCQuoteCommaSpaceDClose => "{0}({1}, \"{2}\", {3})",
        Wut.ADotBSpaceEqSpaceC => "{0}.{1} = {2}",
        Wut.LetLet => "{0}let {1} = {2}.{3}; let ",
        Wut.If => "{0} = {1}; {2} = ({3});\nif ",
        Wut.ASpaceBangEqSpaceBSpaceBraceSpaceCSemiSpaceBrace => "{0} != {1} { {2}; };\n",
        Wut.B => "[\"b\",{0}]",
        Wut.ABOpenOpenCCloseCloseSemiNl => "{0}{1}(({2}));\n",
        Wut.M => "[\"m\",{0}]",
        Wut.ASpace => "{0} ",
        Wut.A => "[\"a\",{0}]",
        Wut.Y => "[\"y\",{0}]",
        Wut.AOpenOpenBCloseCloseSemiNl => "{0}(({1}));\n",
        Wut.V => "[\"v\",{0},{1}]",
        Wut.ClWutuEventVoidOpenOpenCloseBra => "{0}(cl(__wutu_event) Void { {1}; });\n",
        Wut.VBracketQuoteQuot => "[\"v\",{0},\"{1}\"]",
        Wut.ASemiNl => "{0};\n",
        Wut.AOpenBCommaSpaceOpenCCloseClose => "{0}({1}, ({2}))",
        Wut.IfNotValidityBadInputAndValueAsNumber => "if not {0}.validity.badInput and {1}.valueAsNumber != ({2}) { {3}.valueAsNumber = (",
        Wut.ACloseSemiSpaceBraceEnd => "{0}); }",
        Wut.IfCheckedValueChecked => "if {0}.checked != ({1}.value == ({2})) { {3}.checked = ",
        Wut.Value => "{0}.value == ({1}); }",
        Wut.IfLen0Else => "{0}({1}, if ({2}).len() == 0 { \"\"; } else { {3} + ",
        Wut.Join => "{0}.join({1}); })",
        Wut.IfDotBangEqOpenClo => "if {0}.{1} != ({2}) { {3}.",
        Wut.ASpaceEqSpaceOpenBCloseSemiSpaceBraceEnd => "{0} = ({1}); }",
        Wut.IfValueAsNumberValueAsNumberValueAsNumbe => "if {0}.valueAsNumber == {1}.valueAsNumber { {2} = {3}; }",
