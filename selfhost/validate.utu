//! = Validation
//!
//! Rules about declarations that need no expression's type: duplicate
//! names, where tuples and nullable types may appear, what a struct field
//! and a global's initializer may be, struct types that contain themselves.
//! They run over the program's own files (the standard library's are known
//! to keep them) before any function is checked.

/// `type N = distinct B;`: B is one of the numeric scalars.
fn validate_distinct(node: I32) void {
    let base = last_child(node);
    // An unknown base is the mistake (reported).
    let n = name_node(base);
    if n >= 0 and node_decl[n] < 0 and not builtin_type(word_of(n)) { return; };
    let t = decl_type(node_decl[base], 0);
    if not (t == prelude(Prelude.I32) or t == prelude(Prelude.U32) or t == prelude(Prelude.I64)
        or t == prelude(Prelude.U64) or t == prelude(Prelude.F32) or t == prelude(Prelude.F64)) {
        report(Diag.InvalidDistinct, node, word_of(first_child(node)));
    };
}

//! = Integer enums
//!
//! A variant's value counts up from 0, or from the previous `= n`; each fits
//! the representation, and no two are equal.

/// By declaration (a variant of an integer enum): its value.
vec variant_value: I32;

/// Number every integer enum's variants into @variant_value, reporting a
/// value that is repeated or does not fit.
fn int_enum_values() void {
    variant_value.resize(decl_kind.len());
    for (0 ..< decl_kind.len()) |d| {
        if decl_is(d, Decl.IntEnum) { enum_values(d); };
        if decl_is(d, Decl.Enum) and is_own_file(file_of_token(node_first[decl_node[d]])) { tag_enum_values(d); };
    };
}

/// A tag enum's variants take no `= n`.
fn tag_enum_values(decl: I32) void {
    let c = first_child(decl_node[decl]);
    while (c >= 0) {
        if is_kind(c, Node.Variant) and is_kind(last_child(c), Node.Int_lit) {
            report2(Diag.TagEnumValue, last_child(c), decl_name[node_decl[first_child(c)]], decl_name[decl], -1);
        };
        c = next_sibling(c);
    };
}

/// An integer enum's values, counted in 64 bits and each checked against
/// its representation: U8, I8, U16, I16, I32, or U32 (any other is reported,
/// and counted as I32).
fn enum_values(decl: I32) void {
    let node = decl_node[decl];
    let repr_word = word_of(after_qualifier(node));
    let own = is_own_file(file_of_token(node_first[node]));
    let bits = 32;
    let signed = repr_word != known_word(Known.WordU32);
    if repr_word == narrow_word(Narrow.U8) or repr_word == narrow_word(Narrow.I8) { bits = 8; };
    if repr_word == narrow_word(Narrow.U16) or repr_word == narrow_word(Narrow.I16) { bits = 16; };
    if repr_word == narrow_word(Narrow.U8) or repr_word == narrow_word(Narrow.U16) { signed = false; };
    if own and bits == 32 and repr_word != known_word(Known.WordI32) and repr_word != known_word(Known.WordU32) {
        report(Diag.EnumBase, after_qualifier(node), repr_word);
        own = false;
    };
    let one: I64 = 1;
    let half = one << (bits - 1).to_i64();
    let lo: I64 = 0;
    let hi: I64 = half + half - one;
    if signed {
        lo = 0 - half;
        hi = half - one;
    };
    let next: I64 = 0;
    let first = -1;
    let c = first_child(node);
    while (c >= 0) {
        if is_kind(c, Node.Variant) {
            let v = node_decl[first_child(c)];
            let lit = last_child(c);
            if is_kind(lit, Node.Int_lit) {
                let negate = tok_kind[node_last[lit] - 2] == Tok.Minus.to_i32() or tok_kind[node_first[lit] - 1] == Tok.Minus.to_i32();
                if own and not int_fits(lit, negate, bits, signed) {
                    let text = pick(negate, "-", "") + token_text(node_first[lit]);
                    report3(Diag.EnumValueRange, c, decl_name[v], decl_name[decl], intern_text(text), repr_word);
                };
                next = literal_bits(lit, prelude(Prelude.I64), negate);
            };
            variant_value[v] = next.to_i32();
            if own and (next < lo or next > hi) { report3(Diag.EnumValueRange, c, decl_name[v], decl_name[decl], intern_text(next.to_str()), repr_word); };
            if own {
                let other = first;
                while (other >= 0 and other != v) {
                    if variant_value[other] == variant_value[v] {
                        report3(Diag.EnumValueTwice, c, decl_name[v], decl_name[decl], decl_name[other], intern_text(next.to_str()));
                        other = v;
                    } else {
                        other = other + 1;
                        while (other < v and not decl_is(other, Decl.Variant)) { other += 1; };
                    };
                };
            };
            if first < 0 { first = v; };
            next += 1;
        };
        c = next_sibling(c);
    };
}

/// The rules of this file, over the program: integer enums' values,
/// protocols, each own file's tree (a file that did not parse is reported
/// here), recursive structs, and modules of one name.
fn validate_program() void {
    int_enum_values();
    validate_protocols();
    validate_bounds();
    for (0 ..< file_root.len()) |file| {
        if file_root[file] < 0 {
            report2(Diag.ParseError, -1, file, file_error[file], file_wanted[file]);
            parse_hint(file, file_error[file], file_wanted[file]);
        } else if is_own_file(file) {
            validate_tree(file_root[file]);
        };
    };
    validate_recursive_structs();
    validate_module_members();
}

//! = Modules of one name
//!
//! Stage 0 hoists each module's members into one namespace, as `M__f`,
//! `M.m`, `M:op` (and `M` for its promoted type), so two modules of one
//! name (an own module named like one of the standard library's, say) may
//! not declare a member twice. The later declaration is reported.

/// Report a member that another module of the same name also declares.
fn validate_module_members() void {
    for (0 ..< decl_kind.len()) |b| {
        // A generic module is instantiated (`M__I32`), not hoisted as itself.
        // (One named like a prelude module is reported as that.)
        if decl_is(b, Decl.Module) and not is_generic(b) and is_own_file(file_of_token(node_first[decl_node[b]])) and prelude_lookup(decl_name[b]) < 0 {
            for (0 ..< decl_kind.len()) |a| {
                if a != b and decl_is(a, Decl.Module) and not is_generic(a) and decl_name[a] == decl_name[b] and module_before(a, b) {
                    let item = first_child(decl_node[b]);
                    while (item >= 0) {
                        let name = hoisted_name(b, item);
                        if name.len() > 0 and module_declares(a, name) { report2(Diag.DuplicateDeclaration, item, -1, 4, b); };
                        item = next_sibling(item);
                    };
                };
            };
        };
    };
}

/// Whether module a comes before module b in stage 0's program: the
/// standard library's first, then by place.
fn module_before(a: I32, b: I32) Bool {
    let fa = file_of_token(node_first[decl_node[a]]);
    let fb = file_of_token(node_first[decl_node[b]]);
    let pa = file_role[fa] == FileRole.Prelude.to_i32();
    let pb = file_role[fb] == FileRole.Prelude.to_i32();
    if pa != pb { return pa; };
    decl_node[a] < decl_node[b];
}

fn module_declares(module: I32, name: Str) Bool {
    let item = first_child(decl_node[module]);
    while (item >= 0) {
        if hoisted_name(module, item) == name { return true; };
        item = next_sibling(item);
    };
    false;
}

/// The name stage 0 gives item (of module m's declaration) once hoisted, or
/// "" for what it does not name (usings, comments, …).
fn hoisted_name(m: I32, item: I32) Str {
    let module = word_text(decl_name[m]);
    if is_kind(item, Node.Op_decl) {
        return hoisted_receiver(m, first_child(item)) + ":" + node_text(next_sibling(first_child(item)));
    };
    if is_kind(item, Node.Fn_decl) {
        let name = first_child(item);
        if next_sibling(first_child(name)) < 0 { return module + "__" + node_text(name); };
        return hoisted_receiver(m, first_child(name)) + "." + node_text(last_child(name));
    };
    if is_kind(item, Node.Struct_decl) or is_kind(item, Node.Enum_decl) or is_kind(item, Node.Proto_decl)
        or is_kind(item, Node.Type_decl) or is_kind(item, Node.Distinct_decl) or is_kind(item, Node.Global_decl) {
        let text = node_text(first_child(item));
        if text == "&" { return module; };
        return module + "__" + text;
    };
    "";
}

/// A receiver, hoisted: `&` is the module's type, a type of the module is
/// `M__T`, and any other keeps its name.
fn hoisted_receiver(m: I32, receiver: I32) Str {
    let text = node_text(receiver);
    if text == "&" { return word_text(decl_name[m]); };
    let t = member(m, word_of(receiver), Space.Member);
    if t >= 0 and not decl_is(t, Decl.Fn) and not decl_is(t, Decl.Global) { return word_text(decl_name[m]) + "__" + text; };
    text;
}

/// Validate each node of the tree, in order.
fn validate_tree(node: I32) void {
    validate_node(node);
    let c = node_child[node];
    while (c >= 0) {
        // (Most nodes are leaves: no call into the tree for them.)
        if node_child[c] >= 0 { validate_tree(c); } else { validate_node(c); };
        c = node_next[c];
    };
}

/// The rule for a node of its kind (most kinds have none).
fn validate_node(node: I32) void {
    match Node.from_i32(node_kind[node]) {
        Node.Param_list => { duplicate_names(node, Diag.DuplicateDeclaration, 1); },
        Node.Struct_decl => { duplicate_names(node, Diag.DuplicateField, node_decl[first_child(node)]); },
        Node.Field_list => { duplicate_names(node, Diag.DuplicateField, node_decl[first_child(parent_of(node))]); },
        Node.Enum_decl => { duplicate_names(node, Diag.DuplicateDeclaration, 2); },
        Node.Block => { duplicate_lets(node); },
        Node.Closure_param_list => { duplicate_words(node, 1); },
        Node.Tuple_pattern => { duplicate_words(node, 3); },
        Node.Capture => { duplicate_words(node, 6); },
        Node.Alt_expr => { duplicate_alt_arms(node); },
        Node.Nullable_type => { validate_nullable(node); },
        Node.Tuple_type => { validate_tuple_type(node); },
        Node.Field => { validate_field_type(node); },
        Node.Global_decl => { validate_global(node); },
        Node.Distinct_decl => { validate_distinct(node); },
        Node.Yield_expr => { validate_yield(node); },
        Node.Yield_type => { validate_yield_type(node); },
        Node.Defer_expr => { validate_defer(node); },
        Node.Await_expr => { validate_await(node); },
        ~> {},
    };
}

/// Children that declare a name (parameters, fields, variants), each name
/// once. `what` is the diagnostic's argument: which names (1 parameters, 2
/// variants), or the type whose fields they are.
fn duplicate_names(node: I32, kind: Diag, what: I32) void {
    let c = first_child(node);
    while (c >= 0) {
        let k = node_kind[c];
        if k == Node.Param.to_i32() or k == Node.Field.to_i32() or k == Node.Variant.to_i32() {
            let word = word_of(first_child(c));
            let other = first_child(node);
            while (other != c) {
                if node_kind[other] == k and word_of(first_child(other)) == word {
                    report2(kind, c, word, what, -1);
                    diag_place(Extra.Related, first_child(other), "first here");
                    other = c;
                } else {
                    other = next_sibling(other);
                };
            };
        };
        c = next_sibling(c);
    };
}

/// Names a node lists (closure parameters, a tuple's parts, a capture's
/// names), each once; `_` may repeat. `what` is DuplicateDeclaration's
/// argument: 1 parameters, 3 local bindings, 6 captures.
fn duplicate_words(node: I32, what: I32) void {
    let c = first_child(node);
    while (c >= 0) {
        let word = list_word(c);
        if word >= 0 and node_text(name_of_listed(c)) != "_" {
            let other = first_child(node);
            while (other != c) {
                if list_word(other) == word {
                    report2(Diag.DuplicateDeclaration, name_of_listed(c), word, what, -1);
                    diag_place(Extra.Related, name_of_listed(other), "first here");
                    other = c;
                } else {
                    other = next_sibling(other);
                };
            };
        };
        c = next_sibling(c);
    };
}

/// The name a listed child declares: itself, or a closure parameter's first child.
fn name_of_listed(c: I32) I32 { if is_kind(c, Node.Closure_param) { first_child(c); } else { c; }; }

fn list_word(c: I32) I32 {
    let n = name_of_listed(c);
    if is_kind(n, Node.Identifier) { word_of(n); } else { -1; };
}

/// An alt's arms, each variant once: a second arm for one can never run.
fn duplicate_alt_arms(node: I32) void {
    let c = first_child(node);
    while (c >= 0) {
        if is_kind(c, Node.Alt_arm) {
            let text = node_text(first_child(c));
            let other = first_child(node);
            while (other != c) {
                if is_kind(other, Node.Alt_arm) and node_text(first_child(other)) == text {
                    report2(Diag.DuplicatePattern, c, -1, 1, -1);
                    diag_place(Extra.Related, first_child(other), "first here");
                    other = c;
                } else {
                    other = next_sibling(other);
                };
            };
        };
        c = next_sibling(c);
    };
}

/// By word: the stamp of the block whose lets last named it; and the last stamp.
vec let_seen: I32;
vec let_stamp: I32 = [0];

/// A new stamp for @word_seen: no word seen with it yet.
fn word_stamp() I32 {
    let_stamp[0] += 1;
    let_stamp[0];
}

/// Whether `word` was seen with `stamp` before; it is now.
fn word_seen(word: I32, stamp: I32) Bool {
    if word < 0 { return false; };
    if let_seen.len() <= word {
        let k = let_seen.len();
        let_seen.resize(src.interned() + 1);
        for (k ..< let_seen.len()) |w| { let_seen[w] = 0; };
    };
    if let_seen[word] == stamp { return true; };
    let_seen[word] = stamp;
    false;
}

/// The lets of a block, each name once.
fn duplicate_lets(block: I32) void {
    let stamp = word_stamp();
    let c = first_child(block);
    while (c >= 0) {
        if is_kind(c, Node.Bind_expr) and is_kind(first_child(c), Node.Identifier) {
            let word = word_of(first_child(c));
            if word_seen(word, stamp) {
                report2(Diag.DuplicateDeclaration, c, word, 3, -1);
                // The first: looked for only once there is a mistake.
                let other = first_child(block);
                while (other != c) {
                    if is_kind(other, Node.Bind_expr) and is_kind(first_child(other), Node.Identifier) and word_of(first_child(other)) == word {
                        diag_place(Extra.Related, first_child(other), "first here");
                        other = c;
                    } else {
                        other = next_sibling(other);
                    };
                };
            };
        };
        c = next_sibling(c);
    };
}

/// `?I32`: a scalar has no null.
fn validate_nullable(node: I32) void {
    let inner = first_child(node);
    if not is_kind(inner, Node.Ref_type) { return; };
    let name = first_child(inner);
    if not is_kind(name, Node.Type_ident) { return; };
    let decl = node_decl[name];
    if decl_is(decl, Decl.TypeDecl) and is_scalar_decl(decl) { report(Diag.InvalidNullableType, node, word_of(name)); };
}

fn is_scalar_decl(decl: I32) Bool {
    let x = ir_tree(last_child(last_child(decl_node[decl])));
    x >= 0 and x_tag[x] == known_word(Known.IrWasmScalar);
}

/// A tuple type is only a function's result.
fn validate_tuple_type(node: I32) void {
    let parent = parent_of(node);
    if is_kind(parent, Node.Return_type) {
        let owner = parent_of(parent);
        if is_kind(owner, Node.Fn_decl) or is_kind(owner, Node.Func_type) or is_kind(owner, Node.Export_main_decl) { return; };
        if is_kind(owner, Node.Closure_expr) or is_kind(owner, Node.Closure_type) {
            report2(Diag.TupleMisplaced, node, -1, 2, -1);
            return;
        };
    };
    report2(Diag.TupleMisplaced, node, -1, if is_kind(parent, Node.Tuple_type) { 1; } else { 0; }, -1);
}

/// A struct field holds no `fun` (use `cl`).
fn validate_field_type(node: I32) void {
    let t = next_sibling(first_child(node));
    if is_kind(t, Node.Func_type) { report2(Diag.FunInField, t, -1, type_of(t, 0), 0); };
}

/// A global's initializer is a literal (maybe negated).
fn validate_global(node: I32) void {
    if invalid_global_initializer(node) { report(Diag.InvalidGlobalInitializer, last_child(node), word_of(first_child(node))); };
}

/// Whether a global's initializer is other than a literal, a negated
/// literal, or a DSL.
fn invalid_global_initializer(node: I32) Bool {
    let init = last_child(node);
    if is_kind(init, Node.Literal) or is_kind(init, Node.Dsl_expr) { return false; };
    not (is_kind(init, Node.Unary_expr) and tok_kind[node_first[init]] == Tok.Minus.to_i32() and is_kind(last_child(init), Node.Literal));
}

/// A struct that reaches itself through fields of struct types (not
/// nullable, not arrays) can never be built.
fn validate_recursive_structs() void {
    for (0 ..< decl_kind.len()) |d| {
        if decl_is(d, Decl.Struct) and is_own_file(file_of_token(node_first[decl_node[d]])) and not is_generic(module_of(d)) {
            // The field the cycle goes through is marked.
            let field = reaching_field(d, d, 0);
            if field >= 0 { report(Diag.RecursiveType, field, decl_name[d]); };
        };
    };
}

/// The field of `from` whose struct type is `target` or holds it (through
/// at most 64 struct types), or -1.
fn reaching_field(from: I32, target: I32, depth: I32) I32 {
    if depth > 64 { return -1; };
    let c = first_child(decl_node[from]);
    while (c >= 0) {
        if is_kind(c, Node.Field) {
            let t = next_sibling(first_child(c));
            if is_kind(t, Node.Ref_type) and is_kind(first_child(t), Node.Type_ident) {
                let d = node_decl[first_child(t)];
                if decl_is(d, Decl.Struct) and (d == target or reaching_field(d, target, depth + 1) >= 0) { return c; };
            };
        };
        c = next_sibling(c);
    };
    -1;
}

/// A method declared `yield T` (`fn &.each |s| () yield T`): generators
/// are functions, expanded where a `for` names them.
fn is_method_generator(fn_node: I32) Bool {
    let ret = child_of_kind(fn_node, Node.Return_type);
    ret >= 0 and is_kind(first_child(ret), Node.Yield_type) and next_sibling(first_child(first_child(fn_node))) >= 0;
}

fn validate_yield_type(node: I32) void {
    let f = parent_of(parent_of(node));
    if f >= 0 and is_kind(f, Node.Fn_decl) and is_method_generator(f) { report(Diag.GeneratorMethod, node, -1); };
}

/// `yield` belongs in a generator, and not in a closure inside one (the
/// generator expands into its consumer).
fn validate_yield(node: I32) void {
    let p = parent_of(node);
    while (p >= 0) {
        if is_kind(p, Node.Closure_expr) {
            report(Diag.YieldInClosure, node, -1);
            return;
        };
        if is_kind(p, Node.Fn_decl) {
            // (A method's `yield T` is reported.)
            if not is_generator(node_decl[last_child(first_child(p))]) and not is_method_generator(p) { report(Diag.YieldOutside, node, -1); };
            return;
        };
        p = parent_of(p);
    };
    report(Diag.YieldOutside, node, -1);
}

/// A defer is a statement of a block, and its code does not leave it
/// (return, or a break or continue not of a loop inside it).
fn validate_defer(node: I32) void {
    if not is_kind(parent_of(node), Node.Block) {
        report2(Diag.InvalidDefer, node, -1, BreakRule.DeferNotStatement.to_i32(), -1);
        return;
    };
    let exit = deferred_exit(first_child(node), false);
    if exit >= 0 {
        let rule = if is_kind(exit, Node.Return_expr) { BreakRule.ReturnInDefer; }
            else if is_kind(exit, Node.Break_expr) { BreakRule.BreakInDefer; }
            else { BreakRule.ContinueInDefer; };
        report2(Diag.InvalidDefer, exit, -1, rule.to_i32(), -1);
    };
}

/// A `return`, or a `break` or `continue` not inside a loop of its own, in a
/// defer's code: the first, or -1. Closures are not looked into.
fn deferred_exit(node: I32, in_loop: Bool) I32 {
    if node < 0 or is_kind(node, Node.Closure_expr) { return -1; };
    if is_kind(node, Node.Return_expr) { return node; };
    if (is_kind(node, Node.Break_expr) or is_kind(node, Node.Continue_expr)) and not in_loop { return node; };
    let looping = in_loop or is_kind(node, Node.While_expr) or is_kind(node, Node.For_expr) or is_kind(node, Node.Loop_match_expr);
    let c = first_child(node);
    while (c >= 0) {
        let found = deferred_exit(c, looping);
        if found >= 0 { return found; };
        c = next_sibling(c);
    };
    -1;
}

/// `await for (…)` reads a generator call, or one stream (with one value bound).
fn validate_await(node: I32) void {
    let e = first_child(node);
    if not is_kind(e, Node.For_expr) or generator_call(e) >= 0 { return; };
    let source = first_child(first_child(e));
    if next_sibling(source) >= 0 or next_sibling(first_child(source)) >= 0 { report(Diag.AwaitForSource, e, -1); return; };
    let capture = next_sibling(first_child(e));
    if is_kind(capture, Node.Capture) and first_child(capture) >= 0 and next_sibling(first_child(capture)) >= 0 {
        report(Diag.AwaitForCapture, e, -1);
    };
}

//! = Parents
//!
//! The tree records children, not parents; validation and checking ask for
//! a node's parent now and then, so they are computed as nodes are added:
//! a new node's children are new, and where a graft hangs a node somewhere
//! else, it says so (set_parent).

vec node_parent: I32;

/// A node's parent, or -1: computed for the nodes added since it was last asked.
fn parent_of(node: I32) I32 {
    let n = node_kind.len();
    let old = node_parent.len();
    if old > n { node_parent.resize(n); }
    else if old < n {
        node_parent.resize(n);
        for (old ..< n) |k| { node_parent[k] = -1; };
        for (old ..< n) |k| {
            let c = node_child[k];
            while (c >= 0) {
                node_parent[c] = k;
                c = node_next[c];
            };
        };
    };
    node_parent[node];
}

/// Node `child` is now under `parent`.
fn set_parent(child: I32, parent: I32) void {
    parent_of(child);
    node_parent[child] = parent;
}
