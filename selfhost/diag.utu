//! = Diagnostics
//!
//! A diagnostic's kind name, message, and span, made when the host asks, in
//! stage 0's words, from what was reported (see `report` in resolve.utu).

/// The text of a word.
fn word_text(w: I32) Str {
    if w < 0 { return ""; };
    let start = src.interned_start(w);
    bytes_text(start, start + src.interned_size(w));
}

/// The text of `src[start ..< end_]` (UTF-8).
fn bytes_text(start: I32, end_: I32) Str {
    if end_ <= start { return ""; };
    // Code units into an array (no more of them than bytes), made a string once.
    let codes = Array[I32].new(end_ - start, 0);
    let k = 0;
    let i = start;
    while (i < end_) {
        let b = src[i];
        if b < 128 {
            codes[k] = b;
            k += 1;
            i += 1;
        } else {
            let cp = b;
            let n = 1;
            if b >= 240 { cp = b & 7; n = 4; } else if b >= 224 { cp = b & 15; n = 3; } else if b >= 192 { cp = b & 31; n = 2; };
            for (1 ..< n) |m| { cp = (cp << 6) | (src[i + m] & 63); };
            if cp >= 65536 {
                codes[k] = 55296 + ((cp - 65536) >> 10);
                codes[k + 1] = 56320 + ((cp - 65536) & 1023);
                k += 2;
            } else {
                codes[k] = cp;
                k += 1;
            };
            i += n;
        };
    };
    Str.from_codes(codes, k);
}

/// A declaration's name, or empty for none.
fn decl_text(d: I32) Str {
    if d < 0 { return ""; };
    word_text(decl_name[d]);
}

/// A node's source, as written.
fn node_text(node: I32) Str {
    if node < 0 { return ""; };
    bytes_text(tok_start[node_first[node]], tok_end[node_last[node] - 1]);
}

fn int_text(v: I32) Str { v.to_str(); }

fn pick(c: Bool, yes: Str, no: Str) Str {
    if c { return yes; };
    no;
}

/// A type as stage 0 writes it: `I32`, `?Point`, `Array[I32]`, `fun(I32) Bool`, `.{I32, F64}`.
fn type_text(t: I32) Str {
    if t < 0 { return "unknown"; };
    let kind = ty_kind[t];
    if kind == Ty.Error.to_i32() { return "unknown"; };
    if kind == Ty.Void.to_i32() { return "void"; };
    if kind == Ty.Never.to_i32() { return "never"; };
    if kind == Ty.Null.to_i32() { return "null"; };
    if kind == Ty.Nullable.to_i32() { return "?" + type_text(ty_a[t]); };
    if kind == Ty.Tuple.to_i32() { return ".{" + type_list_text(ty_a[t]) + "}"; };
    if kind == Ty.Foreign.to_i32() { return foreign_text(t); };
    if kind == Ty.Fun.to_i32() or kind == Ty.Closure.to_i32() {
        return pick(kind == Ty.Fun.to_i32(), "fun(", "cl(") + type_list_text(ty_a[t]) + ") " + type_text(ty_b[t]);
    };
    let decl = ty_a[t];
    let inst = ty_b[t];
    let module = module_of(decl);
    let name = decl_name[decl];
    if decl_is(decl, Decl.TypeDecl) or (module >= 0 and decl_a[module] == decl) { name = decl_name[module]; };
    let text = word_text(name);
    if inst > 0 and module >= 0 and (decl_a[module] == decl) {
        text = text + "[" + type_list_text(inst_args[inst]) + "]";
    };
    text;
}

fn type_list_text(list: I32) Str {
    let text = "";
    for (0 ..< vl_len[list]) |i| {
        if i > 0 { text = text + ", "; };
        text = text + type_text(vl_item(list, i));
    };
    text;
}

/// The symbol of an operator word (add is `+`).
fn operator_symbol(w: I32) Str {
    if w == known_word(Known.Add) { return "+"; };
    if w == known_word(Known.Sub) { return "-"; };
    if w == known_word(Known.Mul) { return "*"; };
    if w == known_word(Known.Div) { return "/"; };
    if w == known_word(Known.Rem) { return "%"; };
    if w == known_word(Known.Band) { return "&"; };
    if w == known_word(Known.Bor) { return "|"; };
    if w == known_word(Known.Bxor) { return "^"; };
    if w == known_word(Known.Shl) { return "<<"; };
    if w == known_word(Known.Shr) { return ">>"; };
    if w == known_word(Known.Ushr) { return ">>>"; };
    if w == known_word(Known.Eq) { return "=="; };
    if w == known_word(Known.Ne) { return "!="; };
    if w == known_word(Known.Lt) { return "<"; };
    if w == known_word(Known.Le) { return "<="; };
    if w == known_word(Known.Gt) { return ">"; };
    if w == known_word(Known.Ge) { return ">="; };
    if w == known_word(Known.Neg) { return "-"; };
    if w == known_word(Known.Bnot) { return "~"; };
    if w == known_word(Known.GetIndex) { return "[]"; };
    if w == known_word(Known.GetSlice) { return "[,]"; };
    if w == known_word(Known.SetIndex) { return "[]="; };
    word_text(w);
}

/// Where InvalidBreak's argument a says which rule was broken.
enum(U8) BreakRule:
    | BreakOutside
    | ContinueOutside
    | ContinueStateOutside
    | ContinueWithoutState
    | BreakInDefer
    | ContinueInDefer
    | ReturnInDefer
    | DeferNotStatement

/// The JS typed array a mem's view is.
fn view_array_name(s: Storage) Str {
    if s == Storage.U8 { return "Uint8Array"; };
    if s == Storage.I8 { return "Int8Array"; };
    if s == Storage.U16 { return "Uint16Array"; };
    if s == Storage.I16 { return "Int16Array"; };
    if s == Storage.I32 { return "Int32Array"; };
    if s == Storage.U32 { return "Uint32Array"; };
    if s == Storage.I64 { return "BigInt64Array"; };
    if s == Storage.U64 { return "BigUint64Array"; };
    if s == Storage.F32 { return "Float32Array"; };
    "Float64Array";
}

/// The `@comptime` expression a diagnostic is in (its index in
/// `comptime_text_*`), or -1. Its expression was copied into a function of
/// the generated file, whose line 4 it starts on.
fn comptime_site(i: I32) I32 {
    let node = diag_node[i];
    if node < 0 { return -1; };
    let b = tok_start[node_first[node]];
    for (0 ..< comptime_text_start.len()) |k| {
        if b >= comptime_text_start[k] and b < comptime_text_end[k] { return k; };
    };
    -1;
}

/// The kind's name, as stage 0 spells it.
fn diag_kind_name(i: I32) Str {
    if comptime_site(i) >= 0 { return "type-mismatch"; };
    diag_kind_of(i);
}

/// A diagnostic's message for the host: one in a `@comptime` expression
/// says so, and on which line of it.
fn diag_message(i: I32) Str {
    let k = comptime_site(i);
    if k < 0 { return diag_text(i); };
    let line = 4;
    for (comptime_text_start[k] ..< tok_start[node_first[diag_node[i]]]) |b| { if src[b] == 10 { line += 1; }; };
    "@comptime: " + diag_text(i) + " (line " + int_text(line) + ")";
}

/// The kind name a diagnostic is reported under; several share one, as in stage 0.
fn diag_kind_of(i: I32) Str {
    let k = Diag.from_i32(diag_kind[i]);
    if k == Diag.UnknownVariable { return "unknown-variable"; };
    if k == Diag.UnknownType or k == Diag.NotAModule or k == Diag.UnknownModule or k == Diag.UnknownVariant or k == Diag.MemKind or k == Diag.InvalidDistinct or k == Diag.MemView { return "unknown-type"; };
    if k == Diag.UnknownImport { return "unknown-import"; };
    if k == Diag.DuplicateDeclaration or k == Diag.DuplicatePattern or k == Diag.MemTwice or k == Diag.MemClash or k == Diag.EnumValueTwice { return "duplicate-declaration"; };
    if k == Diag.UnknownMethod or k == Diag.ProtoMissing or k == Diag.InternNotBytes or k == Diag.MemNoMethod or k == Diag.VecHost { return "unknown-method"; };
    if k == Diag.UnknownOperator { return "unknown-operator"; };
    if k == Diag.WrongArity { return "wrong-arity"; };
    if k == Diag.AssignmentToImmutable { return "assignment-to-immutable"; };
    if k == Diag.InvalidBreak or k == Diag.InvalidDefer { return "invalid-break"; };
    if k == Diag.Unsupported { return "unsupported"; };
    if k == Diag.ParseError { return "parse-error"; };
    if k == Diag.DuplicateField { return "duplicate-field"; };
    if k == Diag.InvalidNullableType or k == Diag.BareNull { return "invalid-nullable-type"; };
    if k == Diag.InvalidGlobalInitializer { return "invalid-global-initializer"; };
    if k == Diag.RecursiveType { return "recursive-type"; };
    if k == Diag.IntegerOutOfRange { return "integer-literal-out-of-range"; };
    if k == Diag.UnknownField { return "unknown-field"; };
    if k == Diag.MissingField { return "missing-field"; };
    if k == Diag.NullableAccess { return "nullable-access"; };
    if k == Diag.NonDefaultable { return "non-defaultable-type"; };
    if k == Diag.InvalidModuleArity { return "invalid-module-arity"; };
    if k == Diag.NotCallable { return "not-callable"; };
    if k == Diag.NonExhaustive { return "non-exhaustive-match"; };
    if k == Diag.InvalidForSource or k == Diag.GeneratorRecursion or k == Diag.YieldOutside or k == Diag.GeneratorReturnValue
        or k == Diag.GeneratorCall or k == Diag.YieldInClosure or k == Diag.AwaitForSource or k == Diag.AwaitForCapture or k == Diag.GeneratorPassThrough
        or k == Diag.GeneratorArity or k == Diag.PruneOutside or k == Diag.PruneInClosure { return "invalid-for-source"; };
    if k == Diag.IteratorUnfinished or k == Diag.IteratorCaptures or k == Diag.IteratorTerminalInside or k == Diag.IteratorSource { return "invalid-iterator-usage"; };
    if k == Diag.AwaitNotPromise { return "invalid-await"; };
    if k == Diag.EntrySurface { return "entry-surface-conflict"; };
    if k == Diag.InvalidEscape { return "invalid-escape"; };
    if k == Diag.AwaitInClosure { return "invalid-await"; };
    if k == Diag.InvalidDslUsage or k == Diag.DslError or k == Diag.WatPlace or k == Diag.WatHost { return "invalid-dsl-usage"; };
    if k == Diag.ImplicitStructInit { return "implicit-struct-init"; };
    "type-mismatch";
}

/// What InvalidBreak or InvalidDefer says, by the @BreakRule broken.
fn break_rule_text(a: I32) Str {
    let r = BreakRule.from_i32(if a < 0 { 0; } else { a; });
    if r == BreakRule.BreakOutside { return "break must appear inside a loop"; };
    if r == BreakRule.ContinueOutside { return "continue must appear inside a loop"; };
    if r == BreakRule.ContinueStateOutside { return "continue with a state only works inside loop match"; };
    if r == BreakRule.ContinueWithoutState { return "continue in a loop match needs the next state: continue <value>"; };
    if r == BreakRule.BreakInDefer { return "break cannot appear inside deferred code"; };
    if r == BreakRule.ContinueInDefer { return "continue cannot appear inside deferred code"; };
    if r == BreakRule.ReturnInDefer { return "return cannot appear inside deferred code"; };
    "defer must be a statement in a block";
}

/// Whether token t is a `\\` line whose text ends in `;` (meant to end the statement).
fn semicolon_in_multiline(t: I32) Bool {
    if t < 0 or tok_kind[t] != Tok.MultilineLine.to_i32() { return false; };
    let e = tok_end[t] - 1;
    while (e > tok_start[t] and (src[e] == 32 or src[e] == 9 or src[e] == 10 or src[e] == 13)) { e -= 1; };
    src[e] == 59;
}

/// A diagnostic's message, in stage 0's words.
fn diag_text(i: I32) Str {
    let k = Diag.from_i32(diag_kind[i]);
    let word = diag_word[i];
    let w = word_text(word);
    let a = diag_a[i];
    let b = diag_b[i];
    let node = diag_node[i];
    match k {
        Diag.UnknownVariable => "Unknown variable '" + w + "'",
        Diag.UnknownType => "Unknown type '" + w + "'",
        Diag.UnknownImport => {
            let path = import_path[missing_import[0]];
            let spelled = bytes_text(tok_start[node_first[path]] + 1, tok_end[node_last[path] - 1] - 1);
            "Cannot import \"" + spelled + "\": file not found (" + bytes_text(missing_start[0], missing_end[0]) + ")";
        },
        Diag.UnknownModule => "Module '" + w + "' not found",
        Diag.DuplicateDeclaration => {
            if a == 4 { return "Duplicate top-level declaration '" + hoisted_name(b, node) + "'"; };
            let what = pick(a == 1, "parameter", pick(a == 2, "variant", pick(a == 3, "local binding", "top-level declaration")));
            "Duplicate " + what + " '" + w + "'";
        },
        Diag.MemTwice => mem_word(word) + " " + w + " is declared twice",
        Diag.MemClash => mem_word(word) + " " + w + " has the same name as a top-level function or global",
        Diag.DuplicatePattern => "Duplicate match pattern '" + node_text(first_child(node)) + "'",
        Diag.TupleLet => {
            if not ty_is(a, Ty.Tuple) { return "let .{…} takes apart a tuple, but this value is " + type_text(a); };
            "This tuple has " + int_text(vl_len[ty_a[a]]) + " values (" + type_text(a) + "); name each one in let .{…}";
        },
        Diag.NotNullable => "Type mismatch: expected nullable, got " + type_text(a),
        Diag.TypeMismatch => {
            let caused = if diag_c[i] > 0 { " (+" + int_text(diag_c[i]) + " caused by this)"; } else { ""; };
            if a >= 0 and b >= 0 { return "Type mismatch: expected " + type_text(a) + ", got " + type_text(b) + caused; };
            "Type mismatch";
        },
        Diag.UnknownMethod => {
            if a >= 0 and ty_is(a, Ty.Nullable) { return "Unknown method '" + type_text(ty_a[a]) + "." + w + "'"; };
            if a >= 0 and b == 1 {
                let t = type_text(a);
                return "Unknown method '" + t + "." + w + "': " + w + " is a function of " + t + ", not a method; call it as " + t + "." + w + "(value)";
            };
            if a >= 0 { return "Unknown method '" + type_text(a) + "." + w + "'"; };
            if diag_c[i] >= 0 { return "Unknown method '" + word_text(diag_c[i]) + "." + w + "'"; };
            "Unknown method '" + w + "'";
        },
        Diag.UnknownOperator => {
            if a < 0 { return "Cannot resolve operator for unknown"; };
            let t = type_text(a);
            t + " has no '" + operator_symbol(diag_word[i]) + "' operator (" + t + "." + w + ")";
        },
        Diag.WrongArity => "Wrong arity: expected " + int_text(a) + ", got " + int_text(b),
        Diag.AssignmentToImmutable => "Cannot assign to immutable '" + w + "'",
        Diag.InvalidBreak => break_rule_text(a),
        Diag.InvalidDefer => break_rule_text(a),
        Diag.DuplicateField => {
            if a >= 0 { return "Duplicate field '" + w + "' in " + decl_text(a); };
            "Duplicate field '" + w + "'";
        },
        Diag.InvalidNullableType => "Scalar type '" + w + "' cannot be nullable",
        Diag.BareNull => "Bare null requires a nullable type context",
        Diag.TupleMisplaced => {
            if a == 1 { return "A tuple cannot hold another tuple"; };
            if a == 2 { return "A closure is a JS function and cannot return a tuple; use a fn or fun"; };
            if a == 3 { return "Tuples cannot be stored in arrays; take them apart with `let .{a, b} = …` first"; };
            "A tuple type is only a function result: `fn f() .{I32, F64}`; take it apart with `let .{a, b} = f();`";
        },
        Diag.FunInField => {
            let t = type_text(a);
            let as_cl = "cl" + t.slice(3, t.len());
            t + " cannot be stored in " + pick(b == 1, "an array", "a struct field") + " yet; use " + as_cl + " instead (a fun converts to it)";
        },
        Diag.InvalidGlobalInitializer => "Global '" + w + "' requires a literal constant initializer",
        Diag.RecursiveType => "Recursive type '" + w + "' must use a nullable or indirect field",
        Diag.IntegerOutOfRange => "Integer literal " + pick(b == 1, "-", "") + node_text(node) + " is out of range for " + type_text(a),
        Diag.InvalidDistinct => "type " + w + " = distinct " + node_text(last_child(node)) + ": a distinct type wraps one of I32, U32, I64, U64, F32, F64",
        Diag.EnumValueRange => word_text(a) + "." + w + " = " + int_text(b) + " does not fit in " + word_text(diag_c[i]),
        Diag.EnumValueTwice => word_text(a) + "." + w + " and " + word_text(a) + "." + word_text(b) + " are both " + int_text(diag_c[i]),
        Diag.UnknownField => {
            if a >= 0 { return "Unknown field '" + w + "' for " + decl_text(a); };
            "Unknown field '" + w + "'";
        },
        Diag.MissingField => "Missing field '" + w + "' for " + decl_text(a),
        Diag.NullableAccess => "Cannot access field '" + w + "' on nullable " + type_text(a),
        Diag.MemIndex => mem_word(word) + " " + w + " takes one index: " + w + "[i]",
        Diag.ConstMem => {
            if a >= 0 { return mem_word(word) + " " + w + " is const; it has no " + word_text(a); };
            mem_word(word) + " " + w + " is const; it cannot be written";
        },
        Diag.MemNotValue => mem_word(word) + " " + w + " is not a value; use " + w + "[i], " + w + "[i] = v, or " + w + ".len()",
        Diag.MemKind => {
            let kw = mem_word(word);
            kw + " " + w + " stores " + node_text(next_sibling(first_child(node))) + "; a " + kw + " holds an integer enum, a distinct type, or one of U8, I8, U16, I16, I32, U32, I64, U64, F32, F64";
        },
        Diag.NonDefaultable => {
            let t = type_text(a);
            "Array element type '" + t + "' has no default value; use Array[" + t + "].new(length, fill)";
        },
        Diag.InvalidModuleArity => "Module '" + w + "' expects " + int_text(a) + " type argument(s), got " + int_text(b),
        Diag.NotCallable => "Cannot call value of type " + type_text(a),
        Diag.NonExhaustive => {
            // a: 0 integer match, 1 Bool match, 2 integer enum match, 3 alt
            if a == 1 { return "Missing Bool case '" + pick(b == 1, "true", "false") + "' in match"; };
            if a == 2 { return "Missing variant '" + w + "' in match over " + type_text(b); };
            if a == 3 { return "Missing variant '" + w + "' in alt over enum " + type_text(b); };
            "Match over " + type_text(b) + " requires a default arm";
        },
        Diag.MatchType => "match needs an integer, float, or Bool value, got " + type_text(a) + "; use alt for enums or if/else for other values",
        Diag.MatchPattern => {
            let p = node_text(first_child(node));
            if a == 1 { return "Pattern " + p + " is not a Bool; use true or false"; };
            if a == 2 { return "Pattern " + p + " is not an integer, so it cannot match values of type " + type_text(b); };
            if a == 3 { return "Pattern " + p + " cannot match values of type " + type_text(b); };
            "Pattern " + p + " is out of range for " + type_text(b) + " and can never match";
        },
        Diag.UnknownVariant => type_text(a) + " has no variant " + w,
        Diag.InvalidForSource => {
            if a == 1 { return "a generator loop binds one value: for (gen()) |value| { … }"; };
            "for can only iterate an array, got " + type_text(b) + "; count with a range like 0..<n";
        },
        Diag.UnknownForeignMember => "Unknown foreign member '" + word_text(view_prefix[a]) + "." + word_text(diag_c[i]) + w + "'",
        Diag.ForeignReadonly => "Cannot assign to readonly foreign property '" + w + "'",
        Diag.ForeignRecordField => "Unknown foreign property '" + w + "'",
        Diag.ForeignRecordMissing => "Missing foreign property '" + w + "'",
        Diag.DslError => w,
        Diag.WatPlace => "@wat is a function's whole body: fn f(x: I32) I32 { @wat/\\ … \\/; }",
        Diag.AwaitInClosure => "a closure cannot await: a closure is called through the host, where JSPI cannot suspend; await in a function (a `fun` value can be passed instead)",
        Diag.InvalidEscape => "Invalid escape: \\u takes four hexadecimal digits",
        Diag.EntrySurface => {
            if a == 0 { return "entry surface: multiple export lib declarations"; };
            if a == 1 { return "entry surface: multiple export main declarations"; };
            "entry surface: export lib and export main are mutually exclusive";
        },
        Diag.WatHost => "@wat needs a host that assembles it (src/wat/assemble.js)",
        Diag.HostAltArm => "Every arm of an alt over a host value must name a declared class",
        Diag.HostAltClass => word_text(view_prefix[a]) + "." + w + " is only a type; narrowing needs a declared runtime class",
        Diag.ForeignNotArray => type_text(a) + " is not an array type",
        Diag.ForeignOverload => "No declaration overload accepts " + int_text(a) + " arguments",
        Diag.PruneInClosure => "prune cannot appear inside a closure",
        Diag.PruneOutside => "prune skips a subtree of a recursive generator; use it in the body of `for (walk(…)) |node| { … }` where walk delegates to itself",
        Diag.GeneratorPassThrough => "a recursive generator passes its own values straight through: `for (" + w + "(…)) |v| { yield v; }`",
        Diag.GeneratorArity => w + " expects " + int_text(a) + " argument(s), got " + int_text(b),
        Diag.GeneratorRecursion => "generator " + w + " consumes itself; generators expand inline, so they cannot recurse",
        Diag.YieldOutside => "yield can only appear in a generator: declare the function with `yield T` as its return type",
        Diag.YieldInClosure => "yield cannot appear inside a closure; the generator expands into its consumer",
        Diag.GeneratorReturnValue => "a generator ends with `return;`, without a value",
        Diag.GeneratorCall => w + " is a generator: consume it with `for (" + w + "(…)) |value| { … }`",
        Diag.AwaitForSource => "await for reads a generator call or a stream: `await for (ticks()) |t| { … }`",
        Diag.AwaitForCapture => "a stream loop binds one value: await for (s) |value| { … }",
        Diag.IteratorUnfinished => "Iterator pipeline must end with fold, each, collect(Type), or a scalar terminal; found " + w,
        Diag.IteratorCaptures => w + " expects " + int_text(a) + " value binding(s) and an optional index",
        Diag.OptionalOutsideStatement => "'?.' is only allowed in statements; use promote or orelse for a value",
        Diag.AwaitNotPromise => "Cannot await non-promise " + type_text(a),
        Diag.ProtoMissing => decl_text(a) + " does not implement protocol " + pick(b == 1, "getter", "method") + " '" + word_text(diag_c[i]) + "." + w + "'",
        Diag.ProtoSignature => "Implementation '" + word_text(a) + "[" + word_text(b) + "]." + w + "' does not match the protocol signature",
        Diag.MemElementRange => mem_word(word) + " " + w + ": element " + int_text(b) + " (" + word_text(diag_c[i]) + ") does not fit in " + Storage.name(mem_storage(a)),
        Diag.MemInitializer => mem_word(word) + " " + w + ": an initializer list holds number literals; compute other values with @comptime",
        Diag.MemEmbed => mem_word(word) + " " + w + ": @embed cannot read " + bytes_text(dsl_text_start(node), dsl_text_end(node)) + ": ENOENT",
        Diag.MemView => w + ".view() returns a JS." + view_array_name(Storage.from_i32(a)) + "; add `using JS from std:JS;`",
        Diag.MemNoMethod => {
            let name = word_of(first_child(node));
            if mem_word(name) == "vec" { return "vec " + node_text(first_child(node)) + " has no method '" + w + "'; it has len, cap, push, reserve, resize, clear, intern, interned, interned_start, interned_size, intern_reset"; };
            "mem " + node_text(first_child(node)) + " has no method '" + w + "'; it has len, cap, push, reserve, resize, clear, copy_in, view, intern, interned, interned_start, interned_size, intern_reset";
        },
        Diag.InternNotBytes => {
            let kw = mem_word(word);
            kw + " " + w + "." + word_text(a) + ": only byte " + kw + "s (U8, I8) intern spans";
        },
        Diag.TooManyMems => "mem " + w + " is one mem too many: a module has at most " + int_text(max_memories) + " memories; declare the others as vec",
        Diag.VecHost => "vec " + node_text(first_child(node)) + " has no method '" + w + "': the host cannot see a vec; declare it as a mem",
        Diag.InvalidDslUsage => "@es DSL must appear on the right-hand side of a typed let binding (let X: T = @es/\\...\\/)",
        Diag.ParseError => {
            // What the parser wanted, and what it found.
            // The lexer stops at a quote or backtick it finds no end for.
            if tok_kind[a] == Tok.Error.to_i32() and src[tok_start[a]] == 34 { return "Syntax error: a string not closed on its line"; };
            if tok_kind[a] == Tok.Error.to_i32() and src[tok_start[a]] == 96 { return "Syntax error: a template string not closed"; };
            let found = found_text(a);
            if b >= 0 and semicolon_in_multiline(a - 1) and word_text(b) == "';'" {
                return "Syntax error: expected ';', got " + found + " (a \\\\ line runs to the end of the line, so its ';' is text: end the string with ';' on a line of its own)";
            };
            if b >= 0 { return "Syntax error: expected " + word_text(b) + ", got " + found; };
            if tok_kind[a] == Tok.End.to_i32() { return "Syntax error: unexpected end of the file"; };
            "Syntax error: unexpected " + found;
        },
        Diag.Unsupported => "not supported yet",
        ~> Diag.name(k),
    };
}

/// A token as an error names it: a name, number, or symbol as written (a
/// long one cut short), and what the others are.
fn found_text(t: I32) Str {
    let kind = tok_kind[t];
    if kind == Tok.End.to_i32() { return "the end of the file"; };
    if kind == Tok.String.to_i32() or kind == Tok.MultilineLine.to_i32() { return "a string"; };
    if kind == Tok.DslBody.to_i32() { return "a DSL body"; };
    // The lexer stops before a character it does not know: that character.
    if kind == Tok.Error.to_i32() {
        let b = src[tok_start[t]];
        let n = if b >= 240 { 4; } else if b >= 224 { 3; } else if b >= 192 { 2; } else { 1; };
        return "character '" + bytes_text(tok_start[t], tok_start[t] + n) + "'";
    };
    let text = bytes_text(tok_start[t], tok_end[t]);
    if text.len() > 24 { return "'" + text.slice(0, 24) + "…'"; };
    "'" + text + "'";
}

/// The span a diagnostic points at: its node's, as byte offsets.
fn diag_start(i: I32) I32 {
    if diag_kind[i] == Diag.ParseError.to_i32() { return tok_start[diag_a[i]]; };
    if diag_kind[i] == Diag.DslError.to_i32() { return diag_a[i]; };
    let f = located_file(i);
    if f >= 0 { return dsl_file_from[f]; };
    let node = diag_at(i);
    if node < 0 { return -1; };
    tok_start[node_first[node]];
}

/// Where a diagnostic's span ends (see @diag_start).
fn diag_end(i: I32) I32 {
    if diag_kind[i] == Diag.ParseError.to_i32() { return tok_end[diag_a[i]]; };
    if diag_kind[i] == Diag.DslError.to_i32() { return diag_b[i]; };
    let f = located_file(i);
    if f >= 0 { return dsl_file_to[f]; };
    let node = diag_at(i);
    if node < 0 { return -1; };
    tok_end[node_last[node] - 1];
}

/// The generated file of located code a diagnostic is in, or -1.
fn located_file(i: I32) I32 {
    let node = diag_node[i];
    if node < 0 or comptime_site(i) >= 0 { return -1; };
    let file = file_of_token(node_first[node]);
    if file < dsl_file_from.len() and dsl_file_from[file] >= 0 { file; } else { -1; };
}

/// The node a diagnostic points at: its own, or the `@comptime` expression
/// it is in, or the DSL site whose generated code it is in.
fn diag_at(i: I32) I32 {
    let k = comptime_site(i);
    if k >= 0 { return comptime_text_node[k]; };
    let node = diag_node[i];
    // Code a DSL generated: its site.
    if node >= 0 {
        let site = dsl_site_of(node);
        if site >= 0 { return site; };
    };
    node;
}

/// The file a diagnostic is in, or -1.
fn diag_file(i: I32) I32 {
    let node = diag_at(i);
    if node < 0 {
        if diag_kind[i] == Diag.ParseError.to_i32() { return diag_word[i]; };
        return -1;
    };
    file_of_token(node_first[node]);
}
