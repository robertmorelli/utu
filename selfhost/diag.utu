//! = Diagnostics
//!
//! A diagnostic's kind name, message, and span, made when the host asks, in
//! stage 0's words, from what was reported (see `report` in resolve.utu).

/// The text of a word.
fn word_text(w: I32) Str {
    if w < 0 { return ""; };
    let start = src.interned_start(w);
    bytes_text(start, start + src.interned_size(w));
}

/// The text of `src[start ..< end_]` (UTF-8).
fn bytes_text(start: I32, end_: I32) Str {
    if end_ <= start { return ""; };
    // Code units into an array (no more of them than bytes), made a string once.
    let codes = Array[I32].new(end_ - start, 0);
    let k = 0;
    let i = start;
    while (i < end_) {
        let b = src[i];
        if b < 128 {
            codes[k] = b;
            k += 1;
            i += 1;
        } else {
            let cp = b;
            let n = 1;
            if b >= 240 { cp = b & 7; n = 4; } else if b >= 224 { cp = b & 15; n = 3; } else if b >= 192 { cp = b & 31; n = 2; };
            for (1 ..< n) |m| { cp = (cp << 6) | (src[i + m] & 63); };
            if cp >= 65536 {
                codes[k] = 55296 + ((cp - 65536) >> 10);
                codes[k + 1] = 56320 + ((cp - 65536) & 1023);
                k += 2;
            } else {
                codes[k] = cp;
                k += 1;
            };
            i += n;
        };
    };
    Str.from_codes(codes, k);
}

/// A declaration's name, or empty for none.
fn decl_text(d: I32) Str {
    if d < 0 { return ""; };
    word_text(decl_name[d]);
}

/// A node's source, as written.
fn node_text(node: I32) Str {
    if node < 0 { return ""; };
    bytes_text(tok_start[node_first[node]], tok_end[node_last[node] - 1]);
}

fn int_text(v: I32) Str { v.to_str(); }

fn pick(c: Bool, yes: Str, no: Str) Str {
    if c { return yes; };
    no;
}

/// A type as stage 0 writes it: `I32`, `?Point`, `Array[I32]`, `fun(I32) Bool`, `.{I32, F64}`.
fn type_text(t: I32) Str {
    if t < 0 { return "unknown"; };
    let kind = ty_kind[t];
    if kind == Ty.Error.to_i32() { return "unknown"; };
    if kind == Ty.Void.to_i32() { return "void"; };
    if kind == Ty.Never.to_i32() { return "never"; };
    if kind == Ty.Null.to_i32() { return "null"; };
    if kind == Ty.Nullable.to_i32() { return "?" + type_text(ty_a[t]); };
    if kind == Ty.Tuple.to_i32() { return ".{" + type_list_text(ty_a[t]) + "}"; };
    if kind == Ty.Foreign.to_i32() { return foreign_text(t); };
    if kind == Ty.Fun.to_i32() or kind == Ty.Closure.to_i32() {
        return pick(kind == Ty.Fun.to_i32(), "fun(", "cl(") + type_list_text(ty_a[t]) + ") " + type_text(ty_b[t]);
    };
    let decl = ty_a[t];
    let inst = ty_b[t];
    let module = module_of(decl);
    let name = decl_name[decl];
    if decl_is(decl, Decl.TypeDecl) or (module >= 0 and decl_a[module] == decl) { name = decl_name[module]; };
    let text = word_text(name);
    if qualify_types[0] == 1 and module >= 0 and decl_a[module] != decl and not decl_is(decl, Decl.TypeDecl) { text = word_text(decl_name[module]) + "." + text; };
    if inst > 0 and module >= 0 and (decl_a[module] == decl) {
        text = text + "[" + type_list_text(inst_args[inst]) + "]";
    };
    text;
}

/// Whether @type_text names a module's type with its module (`a.S`).
vec qualify_types: U8 = [0];

/// "Expected A, got B": two types of one name told apart by their modules,
/// or said to be two.
fn expected_got(a: I32, b: I32) Str {
    let ta = type_text(a);
    let tb = type_text(b);
    if ta == tb and a != b {
        qualify_types[0] = 1;
        ta = type_text(a);
        tb = type_text(b);
        qualify_types[0] = 0;
        if ta == tb { return "Expected " + ta + ", got " + tb + " (another type of that name)"; };
    };
    "Expected " + ta + ", got " + tb;
}

fn type_list_text(list: I32) Str {
    let text = "";
    for (0 ..< vl_len[list]) |i| {
        if i > 0 { text = text + ", "; };
        text = text + type_text(vl_item(list, i));
    };
    text;
}

/// The symbol of an operator word (add is `+`).
fn operator_symbol(w: I32) Str {
    if w == known_word(Known.Add) { return "+"; };
    if w == known_word(Known.Sub) { return "-"; };
    if w == known_word(Known.Mul) { return "*"; };
    if w == known_word(Known.Div) { return "/"; };
    if w == known_word(Known.Rem) { return "%"; };
    if w == known_word(Known.Band) { return "&"; };
    if w == known_word(Known.Bor) { return "|"; };
    if w == known_word(Known.Bxor) { return "^"; };
    if w == known_word(Known.Shl) { return "<<"; };
    if w == known_word(Known.Shr) { return ">>"; };
    if w == known_word(Known.Ushr) { return ">>>"; };
    if w == known_word(Known.Eq) { return "=="; };
    if w == known_word(Known.Ne) { return "!="; };
    if w == known_word(Known.Lt) { return "<"; };
    if w == known_word(Known.Le) { return "<="; };
    if w == known_word(Known.Gt) { return ">"; };
    if w == known_word(Known.Ge) { return ">="; };
    if w == known_word(Known.Neg) { return "-"; };
    if w == known_word(Known.Bnot) { return "~"; };
    if w == known_word(Known.GetIndex) { return "[]"; };
    if w == known_word(Known.GetSlice) { return "[,]"; };
    if w == known_word(Known.SetIndex) { return "[]="; };
    word_text(w);
}

/// Where InvalidBreak's argument a says which rule was broken.
enum(U8) BreakRule:
    | BreakOutside
    | ContinueOutside
    | ContinueStateOutside
    | ContinueWithoutState
    | BreakInDefer
    | ContinueInDefer
    | ReturnInDefer
    | DeferNotStatement
    | TryInDefer

/// The JS typed array a mem's view is.
fn view_array_name(s: Storage) Str {
    if s == Storage.U8 { return "Uint8Array"; };
    if s == Storage.I8 { return "Int8Array"; };
    if s == Storage.U16 { return "Uint16Array"; };
    if s == Storage.I16 { return "Int16Array"; };
    if s == Storage.I32 { return "Int32Array"; };
    if s == Storage.U32 { return "Uint32Array"; };
    if s == Storage.I64 { return "BigInt64Array"; };
    if s == Storage.U64 { return "BigUint64Array"; };
    if s == Storage.F32 { return "Float32Array"; };
    "Float64Array";
}

/// The `@comptime` expression a diagnostic is in (its index in
/// `comptime_text_*`), or -1. Its expression was copied into a function of
/// the generated file, whose line 4 it starts on.
fn comptime_site(i: I32) I32 {
    let node = diag_node[i];
    if node < 0 { return -1; };
    let b = tok_start[node_first[node]];
    for (0 ..< comptime_text_start.len()) |k| {
        // (From the `(` written before the expression.)
        if b >= comptime_text_start[k] - 1 and b < comptime_text_end[k] { return k; };
    };
    -1;
}

/// The `@comptime` expression a parse error is in, or -1: the generated
/// text from its start to the next one's (its expression did not end).
fn comptime_parse_site(i: I32) I32 {
    if diag_kind[i] != Diag.ParseError.to_i32() or diag_a[i] < 0 { return -1; };
    let b = tok_start[diag_a[i]];
    let k = comptime_text_start.len() - 1;
    while (k >= 0 and comptime_text_start[k] > b) { k -= 1; };
    k;
}

/// Byte `b` of @comptime expression k's generated text, as the place in its
/// mem's body (past its end: the body's end).
fn comptime_byte(k: I32, b: I32) I32 {
    let at = if b < comptime_text_end[k] { b; } else { comptime_text_end[k]; };
    dsl_text_start(comptime_text_node[k]) + at - comptime_text_start[k];
}

/// The kind's name, as stage 0 spells it.
fn diag_kind_name(i: I32) Str {
    if comptime_site(i) >= 0 { return "type-mismatch"; };
    diag_kind_of(i);
}

/// A diagnostic's message for the host: one in a `@comptime` expression
/// says so, and on which line of it.
fn diag_message(i: I32) Str {
    if comptime_parse_site(i) >= 0 { return "@comptime takes one expression: " + diag_text(i); };
    let k = comptime_site(i);
    if k < 0 { return diag_text(i); };
    let line = 4;
    for (comptime_text_start[k] ..< tok_start[node_first[diag_node[i]]]) |b| { if src[b] == 10 { line += 1; }; };
    "@comptime: " + diag_text(i) + " (line " + int_text(line) + ")";
}

/// The kind name a diagnostic is reported under; several share one, as in stage 0.
fn diag_kind_of(i: I32) Str {
    let k = Diag.from_i32(diag_kind[i]);
    if k == Diag.UnknownVariable { return "unknown-variable"; };
    if k == Diag.UnknownType or k == Diag.NotAModule or k == Diag.UnknownModule or k == Diag.UnknownVariant or k == Diag.MemKind or k == Diag.InvalidDistinct or k == Diag.MemView { return "unknown-type"; };
    if k == Diag.UnknownImport { return "unknown-import"; };
    if k == Diag.DuplicateDeclaration or k == Diag.DuplicatePattern or k == Diag.MemTwice or k == Diag.MemClash or k == Diag.EnumValueTwice { return "duplicate-declaration"; };
    if k == Diag.UnknownMember { return "unknown-method"; };
    if k == Diag.DslPlace { return "invalid-dsl-usage"; };
    if k == Diag.UnknownMethod or k == Diag.ProtoMissing or k == Diag.InternNotBytes or k == Diag.MemNoMethod or k == Diag.VecHost { return "unknown-method"; };
    if k == Diag.UnknownOperator { return "unknown-operator"; };
    if k == Diag.WrongArity { return "wrong-arity"; };
    if k == Diag.AssignmentToImmutable { return "assignment-to-immutable"; };
    if k == Diag.InvalidBreak or k == Diag.InvalidDefer { return "invalid-break"; };
    if k == Diag.Unsupported { return "unsupported"; };
    if k == Diag.LazyValue { return "invalid-lazy-call"; };
    if k == Diag.ParseError { return "parse-error"; };
    if k == Diag.DuplicateField { return "duplicate-field"; };
    if k == Diag.InvalidNullableType or k == Diag.BareNull { return "invalid-nullable-type"; };
    if k == Diag.InvalidGlobalInitializer { return "invalid-global-initializer"; };
    if k == Diag.RecursiveType { return "recursive-type"; };
    if k == Diag.IntegerOutOfRange { return "integer-literal-out-of-range"; };
    if k == Diag.UnknownField { return "unknown-field"; };
    if k == Diag.MissingField { return "missing-field"; };
    if k == Diag.NullableAccess { return "nullable-access"; };
    if k == Diag.NonDefaultable { return "non-defaultable-type"; };
    if k == Diag.InvalidModuleArity { return "invalid-module-arity"; };
    if k == Diag.NotCallable { return "not-callable"; };
    if k == Diag.NonExhaustive { return "non-exhaustive-match"; };
    if k == Diag.InvalidForSource or k == Diag.GeneratorRecursion or k == Diag.YieldOutside or k == Diag.GeneratorReturnValue
        or k == Diag.GeneratorCall or k == Diag.YieldInClosure or k == Diag.AwaitForSource or k == Diag.AwaitForCapture or k == Diag.GeneratorPassThrough
        or k == Diag.GeneratorArity or k == Diag.PruneOutside or k == Diag.PruneInClosure
        or k == Diag.GeneratorMethod { return "invalid-for-source"; };
    if k == Diag.IteratorUnfinished or k == Diag.IteratorCaptures or k == Diag.IteratorTerminalInside or k == Diag.IteratorSource { return "invalid-iterator-usage"; };
    if k == Diag.AwaitNotPromise { return "invalid-await"; };
    if k == Diag.EntrySurface { return "entry-surface-conflict"; };
    if k == Diag.InvalidEscape { return "invalid-escape"; };
    if k == Diag.AwaitInClosure or k == Diag.AwaitInGlobal { return "invalid-await"; };
    if k == Diag.InvalidDslUsage or k == Diag.DslError or k == Diag.WatPlace or k == Diag.WatHost { return "invalid-dsl-usage"; };
    if k == Diag.ImplicitStructInit { return "implicit-struct-init"; };
    if k == Diag.StorageType { return "storage-type"; };
    if k == Diag.ReturnValueFromVoid { return "type-mismatch"; };
    if k == Diag.FloatOutOfRange { return "float-literal-out-of-range"; };
    if k == Diag.EnumBase or k == Diag.TagEnumValue { return "invalid-enum"; };
    if k == Diag.ProtoGeneric { return "unsupported"; };
    if k == Diag.MemberClash { return "duplicate-declaration"; };
    if k == Diag.AmbiguousName { return "ambiguous-name"; };
    if k == Diag.StandardName { return "duplicate-declaration"; };
    if k == Diag.InstanceDepth { return "instantiation-depth"; };
    if k == Diag.MainParams { return "entry-surface-conflict"; };
    if k == Diag.TestName { return "duplicate-declaration"; };
    if k == Diag.ReturnInBench { return "invalid-break"; };
    if k == Diag.TestInGeneric { return "unsupported"; };
    if k == Diag.TooManyParams { return "too-many-parameters"; };
    if k == Diag.BoundMissing { return "unsatisfied-bound"; };
    if k == Diag.UnboundedCall { return "unknown-method"; };
    if k == Diag.BoundNotProto or k == Diag.ProtoSelfDynamic { return "invalid-bound"; };
    if k == Diag.UnknownLabel { return "invalid-break"; };
    if k == Diag.GlobalCycle { return "invalid-global-initializer"; };
    if k == Diag.NotValue or k == Diag.NotStruct { return "type-mismatch"; };
    if k == Diag.NotAssignable { return "assignment-to-immutable"; };
    if k == Diag.IrUnknown { return "invalid-dsl-usage"; };
    if k == Diag.YieldPlace or k == Diag.GeneratorExport { return "invalid-for-source"; };
    if k == Diag.NewNotHost { return "not-callable"; };
    if k == Diag.HostMissing { return "unknown-import"; };
    if k == Diag.ComptimeTrap or k == Diag.ComptimeCycle { return "comptime-trap"; };
    if k == Diag.DslEmpty or k == Diag.DslTooDeep or k == Diag.IrInvalid or k == Diag.IrType or k == Diag.EsNative { return "invalid-dsl-usage"; };
    if k == Diag.StdOwnStruct { return "unknown-field"; };
    if k == Diag.TryNotResult or k == Diag.TryPlace or k == Diag.TryErrorMismatch { return "invalid-try"; };
    if k == Diag.ImportNotModule or k == Diag.ModNoType { return "unknown-type"; };
    if k == Diag.UsingTwice { return "duplicate-declaration"; };
    if k == Diag.AmbiguousMethod { return "unknown-method"; };
    if k == Diag.ImplNothing or k == Diag.ProtoNoMember { return "unknown-method"; };
    if k == Diag.WutuHole or k == Diag.WutuKey { return "type-mismatch"; };
    "type-mismatch";
}

/// Whether t is a `fun` type, or a nullable one.
fn es_fun_type(t: I32) Bool { ty_is(t, Ty.Fun) or (ty_is(t, Ty.Nullable) and ty_is(ty_a[t], Ty.Fun)); }

/// A scalar value type's name, as `@ir` tags spell it.
fn vt_text(vt: I32) Str {
    if vt == vt_i32 { return "i32"; };
    if vt == vt_i64 { return "i64"; };
    if vt == vt_f32 { return "f32"; };
    if vt == vt_f64 { return "f64"; };
    if vt == vt_v128 { return "v128"; };
    if vt == vt_none { return "nothing"; };
    "a reference";
}

/// A top-level item, by its node kind, after "is".
fn item_kind_text(kind: I32) Str {
    let k = Node.from_i32(kind);
    if k == Node.Fn_decl { return "a function"; };
    if k == Node.Struct_decl { return "a struct"; };
    if k == Node.Enum_decl { return "an enum"; };
    if k == Node.Proto_decl { return "a protocol"; };
    if k == Node.Global_decl { return "a global"; };
    "not a mod";
}

/// Whether `t` names a number or Bool type: what match takes.
fn is_scalar_name(t: Str) Bool {
    t == "I32" or t == "U32" or t == "I64" or t == "U64" or t == "F32" or t == "F64" or t == "U8" or t == "I8"
        or t == "U16" or t == "I16" or t == "Bool";
}

/// What to do instead of an alt over a value of type `t`.
fn alt_hint(t: I32) Str {
    if t >= 0 and ty_is(t, Ty.Nullable) { return "Unwrap with promote"; };
    let name = type_text(t);
    if is_scalar_name(name) { return "Use match"; };
    if name == "Str" { return "Use if"; };
    "";
}

/// What a pipeline could read instead of a value of type `t`.
fn source_hint(t: I32) Str {
    if t >= 0 and ty_is(t, Ty.Nullable) { return "Unwrap with promote or orelse"; };
    let name = type_text(t);
    if is_scalar_name(name) and name != "Bool" and name != "F32" and name != "F64" { return "Use a range: 0 ..< n"; };
    "";
}

/// A type's name after "a" or "an".
fn article(t: Str) Str {
    if t.len() == 0 { return t; };
    let c = t.slice(0, 1);
    let vowel = c == "A" or c == "E" or c == "I" or c == "O" or c == "U" or c == "a" or c == "e" or c == "i" or c == "o" or c == "u";
    pick(vowel, "an ", "a ") + t;
}

/// Why a `@comptime` evaluation trapped, by the code the host gives (see
/// `comptimeTrapCode` in src/selfhost/compiler.js).
fn comptime_trap_text(code: I32) Str {
    match code {
        1 => "an index out of bounds",
        2 => "it reached fatal, a failed assert, or a missing value",
        3 => "a division by zero",
        4 => "an integer overflow",
        5 => "a null value",
        6 => "the stack overflowed",
        7 => "JavaScript threw",
        8 => "it ran too long (a hundred million loop rounds)",
        ~> "a trap",
    };
}

/// What InvalidBreak or InvalidDefer says, by the @BreakRule broken.
fn break_rule_text(a: I32) Str {
    let r = BreakRule.from_i32(if a < 0 { 0; } else { a; });
    if r == BreakRule.BreakOutside { return "break outside a loop"; };
    if r == BreakRule.ContinueOutside { return "continue outside a loop"; };
    if r == BreakRule.ContinueStateOutside { return "continue with a state outside loop match"; };
    if r == BreakRule.ContinueWithoutState { return "continue needs the next state"; };
    if r == BreakRule.BreakInDefer { return "break in defer"; };
    if r == BreakRule.ContinueInDefer { return "continue in defer"; };
    if r == BreakRule.ReturnInDefer { return "return in defer"; };
    if r == BreakRule.TryInDefer { return "try in defer"; };
    "defer must be a statement";
}

/// Whether token t is a `\\` line whose text ends in `;` (meant to end the statement).
fn semicolon_in_multiline(t: I32) Bool {
    if t < 0 or tok_kind[t] != Tok.MultilineLine.to_i32() { return false; };
    let e = tok_end[t] - 1;
    while (e > tok_start[t] and (src[e] == 32 or src[e] == 9 or src[e] == 10 or src[e] == 13)) { e -= 1; };
    src[e] == 59;
}

/// A diagnostic's message, in stage 0's words.
fn diag_text(i: I32) Str {
    let k = Diag.from_i32(diag_kind[i]);
    let word = diag_word[i];
    let w = word_text(word);
    let a = diag_a[i];
    let b = diag_b[i];
    let node = diag_node[i];
    match k {
        Diag.UnknownVariable => {
            // `export main` is the module's entry, not a function the program (or a @comptime build) can call.
            if w == "main" and is_callee(node) { return "main is the entry point, not a function: move its body into a fn"; };
            pick(is_callee(node), "Unknown function ", "Unknown variable ") + w + did_you_mean(i);
        },
        Diag.UnknownType => "Unknown type " + w + did_you_mean(i),
        Diag.UnknownImport => {
            let path = import_path[missing_import[0]];
            let spelled = bytes_text(tok_start[node_first[path]] + 1, tok_end[node_last[path] - 1] - 1);
            "No file " + spelled + " (" + bytes_text(missing_start[0], missing_end[0]) + ")";
        },
        Diag.UnknownModule => "Unknown module " + w + did_you_mean(i),
        Diag.DuplicateDeclaration => {
            if a == 5 { return "Duplicate method " + node_text(node); };
            if a == 6 { return "Duplicate capture " + w; };
            if a == 7 { return "Duplicate protocol " + w; };
            let what = pick(a == 1, "parameter", pick(a == 2, "variant", pick(a == 3, "local", "declaration")));
            "Duplicate " + what + " " + w;
        },
        Diag.MemTwice => "Duplicate " + mem_word(word) + " " + w,
        Diag.MemClash => mem_word(word) + " " + w + " clashes with a function or global",
        Diag.DuplicatePattern => {
            if a == 1 { return "Duplicate arm " + node_text(first_child(node)) + ": never runs"; };
            "Duplicate pattern " + node_text(first_child(node));
        },
        Diag.TupleLet => {
            if not ty_is(a, Ty.Tuple) { return "let .{…} needs a tuple, got " + type_text(a); };
            // b == 2: a closure captures a tuple
            if b == 2 { return "A closure cannot capture tuple " + w; };
            "Tuple " + type_text(a) + " has " + int_text(vl_len[ty_a[a]]) + " values";
        },
        Diag.NotNullable => "Expected nullable, got " + type_text(a),
        Diag.TypeMismatch => mismatch_text(i),
        Diag.UnknownMethod => {
            if a >= 0 and ty_is(a, Ty.Nullable) { return "No method " + type_text(ty_a[a]) + "." + w; };
            if a >= 0 and b == 1 {
                let t = type_text(a);
                return t + "." + w + " is a function, not a method: " + t + "." + w + "(value)";
            };
            if a >= 0 { return "No method " + type_text(a) + "." + w + did_you_mean(i); };
            if diag_c[i] >= 0 { return "No method " + word_text(diag_c[i]) + "." + w; };
            "No method " + w;
        },
        Diag.UnknownOperator => {
            if a < 0 { return "No operator for an unknown type"; };
            "No " + operator_symbol(diag_word[i]) + " for " + type_text(a);
        },
        Diag.WrongArity => {
            if named_word(word) { return w + " takes " + int_text(a) + ", given " + int_text(b); };
            "Takes " + int_text(a) + ", given " + int_text(b);
        },
        Diag.AssignmentToImmutable => w + " is immutable",
        Diag.InvalidBreak => break_rule_text(a),
        Diag.InvalidDefer => break_rule_text(a),
        Diag.DuplicateField => "Duplicate field " + w,
        Diag.InvalidNullableType => w + " cannot be nullable",
        Diag.BareNull => "null needs a nullable type",
        Diag.TupleMisplaced => {
            if a == 1 { return "Tuple inside a tuple"; };
            if a == 2 { return "A closure cannot return a tuple"; };
            if a == 3 { return "Tuple in an array"; };
            "A tuple is only a function result";
        },
        Diag.FunInField => {
            let t = type_text(a);
            t + " cannot be stored; use cl" + t.slice(3, t.len());
        },
        Diag.InvalidGlobalInitializer => "Global " + w + " needs a literal",
        Diag.RecursiveType => w + " contains itself; make the field nullable",
        Diag.IntegerOutOfRange => (if word >= 0 { w; } else { node_text(node); }) + " does not fit " + type_text(a),
        Diag.InvalidDistinct => "distinct wraps I32, U32, I64, U64, F32, or F64",
        Diag.EnumValueRange => word_text(b) + " does not fit " + word_text(diag_c[i]),
        Diag.EnumValueTwice => word_text(a) + "." + w + " and ." + word_text(b) + " are both " + word_text(diag_c[i]),
        Diag.UnknownField => {
            if a >= 0 { return decl_text(a) + " has no field " + w + did_you_mean(i); };
            "No field " + w + did_you_mean(i);
        },
        Diag.MissingField => if a >= 0 { decl_text(a) + " needs a value for " + w; } else { "Missing field " + w; },
        Diag.NullableAccess => {
            // A name the compiler calls for you (a template's to_str, a loop's iterator, indexing): just the type.
            if w == "to_str" or w == "iterator" or w == "get_index" or w == "set_index" { return type_text(a) + " may be null"; };
            "." + w + " on nullable " + type_text(a);
        },
        Diag.MemIndex => mem_word(word) + " " + w + " takes one index",
        Diag.ConstMem => {
            if a >= 0 { return mem_word(word) + " " + w + " is const: no " + word_text(a); };
            mem_word(word) + " " + w + " is const";
        },
        Diag.MemNotValue => mem_word(word) + " " + w + " is not a value: " + w + "[i]",
        Diag.MemKind => mem_word(word) + " " + w + " cannot store " + node_text(next_sibling(first_child(node))),
        Diag.NonDefaultable => type_text(a) + " has no default: Array[" + type_text(a) + "].new(n, fill)",
        Diag.InvalidModuleArity => w + " takes " + int_text(a) + " type arguments, given " + int_text(b),
        Diag.NotCallable => if named_word(word) { w + " is " + article(type_text(a)) + ", not a function"; } else { type_text(a) + " is not callable"; },
        Diag.NonExhaustive => {
            // a: 0 integer match, 1 Bool match, 2 integer enum match, 3 alt
            if a == 1 { return "match misses " + pick(b == 1, "true", "false"); };
            if a == 2 or a == 3 { return pick(a == 3, "alt", "match") + " misses " + type_text(b) + "." + w; };
            "match over " + type_text(b) + " needs a default arm";
        },
        Diag.MatchType => "match takes a number or Bool, not " + type_text(a),
        Diag.MatchPattern => {
            let p = node_text(first_child(node));
            if a == 1 { return p + " is not a Bool"; };
            if a == 2 or a == 3 { return p + " cannot match " + type_text(b); };
            p + " is out of range for " + type_text(b);
        },
        Diag.UnknownVariant => type_text(a) + " has no variant " + w + did_you_mean(i),
        Diag.InvalidForSource => {
            if a == 1 { return "A generator loop binds one value"; };
            "for needs an array or range, not " + type_text(b);
        },
        Diag.UnknownForeignMember => "No member " + word_text(view_prefix[a]) + "." + word_text(diag_c[i]) + w,
        Diag.ForeignReadonly => w + " is readonly",
        Diag.ForeignRecordField => "No property " + w,
        Diag.ForeignRecordMissing => "Missing property " + w,
        Diag.DslError => w,
        Diag.WatPlace => "@wat must be a function's whole body",
        Diag.AwaitInClosure => pick(is_kind(node, Node.Identifier), "A function", "A closure") + " the host calls cannot await",
        Diag.AwaitInGlobal => "A global's initializer cannot await",
        Diag.GenericGlobal => "A global of generic " + word_text(decl_name[a]) + " cannot use " + w,
        Diag.InvalidEscape => {
            if a == 1 { return "Lone surrogate"; };
            if a == 2 { return "Unknown escape " + w; };
            if a == 3 { return "Not UTF-8"; };
            "\\u needs four hex digits";
        },
        Diag.EntrySurface => {
            if a == 0 { return "Two export lib"; };
            if a == 1 { return "Two export main"; };
            "export lib and export main together";
        },
        Diag.StorageType => w + " is a storage type: use I32",
        Diag.ReturnValueFromVoid => {
            if word < 0 { return "This closure returns void"; };
            w + " returns void";
        },
        Diag.VoidLet => w + " would hold no value",
        Diag.ComptimeTrap => "@comptime " + w + " trapped: " + comptime_trap_text(a),
        Diag.FloatOutOfRange => pick(b == 1, "-", "") + node_text(node) + " does not fit " + type_text(a),
        Diag.EnumBase => "enum(" + w + ") is not an integer enum; use U8, I8, U16, I16, I32, or U32",
        Diag.TagEnumValue => word_text(a) + "." + w + " has a value; only an integer enum's variants do",
        Diag.ProtoGeneric => "A generic type cannot list protocol " + w,
        Diag.SelfUntyped => w + " needs a type annotation to call itself",
        Diag.MemberClash => word_text(decl_name[a]) + "." + w + pick(b == 1, " is already a protocol member", " is both a field and a method"),
        Diag.VariantNotValue => word_text(decl_name[a]) + "." + w + " is a type, not a value",
        Diag.ProtoAccess => word_text(decl_name[b]) + "." + w + pick(a == 1, " is set-only", " is get-only"),
        Diag.ProtoPairType => word_text(decl_name[diag_c[i]]) + "." + w + " gets " + type_text(a) + " but sets " + type_text(b),
        Diag.AmbiguousName => w + " is ambiguous: " + decl_text(module_of(a)) + "." + w + " or " + decl_text(module_of(b)) + "." + w,
        Diag.StandardName => w + " is a standard type",
        Diag.InstanceDepth => w + "'s instances nest more than " + int_text(a) + " deep",
        Diag.MainParams => "main takes no parameters",
        Diag.ReturnInBench => "return in a bench",
        Diag.TestInGeneric => pick(a == 1, "Bench", "Test") + " in generic mod " + w,
        Diag.TestName => pick(a == 1 or a == 3, "Empty ", "Duplicate ") + pick(a >= 2, "bench", "test") + pick(a == 1 or a == 3, " name", " " + pick(word >= 0, "\"" + w + "\"", node_text(node))),
        Diag.TooManyParams => pick(word < 0, "main", w) + " has " + int_text(a) + " parameters (max 1000)",
        Diag.DslEmpty => "@" + w + pick(w == "embed", " needs a file path", " needs an expression"),
        Diag.ComptimeCycle => {
            if a < 0 or decl_name[a] == word { return "@comptime " + w + " reads itself"; };
            "@comptime " + w + " reads " + word_text(decl_name[a]) + ", which waits on it";
        },
        Diag.DslTooDeep => "DSLs nested too deeply (max " + int_text(a) + ")",
        Diag.StdOwnStruct => type_text(a) + " is made by its own functions",
        Diag.TryNotResult => "try needs a Result, not " + type_text(a),
        Diag.TryPlace => {
            // a: 0 try, 1 errdefer, outside a function returning a Result (b: its result);
            // 2 try, 3 errdefer, in a generator
            let what = pick(a == 0 or a == 2, "try", "errdefer");
            if a >= 2 { return what + " in a generator"; };
            if b < 0 { return what + " needs a function returning a Result"; };
            what + " in a function returning " + type_text(b) + ", not a Result";
        },
        Diag.TryErrorMismatch => "try passes on " + type_text(a) + "; the function's errors are " + type_text(b),
        Diag.ImportNotModule => w + " is " + item_kind_text(a) + "; using imports a mod",
        Diag.ModNoType => if word == decl_name[a] { w + " is a mod with no type &"; } else { w + " names mod " + word_text(decl_name[a]) + ", which has no type &"; },
        Diag.UsingTwice => w + node_text(a) + " is open already",
        Diag.AmbiguousMethod => w + " is both " + decl_text(decl_a[a]) + "'s and " + decl_text(decl_a[b]) + "'s",
        Diag.ImplNothing => decl_text(a) + "'s instances implement " + decl_text(b) + " together: fn " + decl_text(b) + "[&]." + w + " in " + decl_text(a),
        Diag.WutuHole => pick(ty_is(a, Ty.Void), "A hole needs a value: this gives none", "A hole shows text, a number, a Bool or a node, not " + type_text(a)),
        Diag.WutuKey => "A key is text or a number, not " + type_text(a),
        Diag.WatHost => "@wat needs an assembler",
        Diag.HostAltArm => "Each arm must name a class",
        Diag.HostAltClass => word_text(view_prefix[a]) + "." + w + " is only a type",
        Diag.ForeignNotArray => type_text(a) + " is not an array",
        Diag.ForeignOverload => "No overload takes " + int_text(a),
        Diag.PruneInClosure => "prune in a closure",
        Diag.GeneratorMethod => "A method cannot be a generator",
        Diag.UnknownLabel => "No block labeled " + w + " around this break",
        Diag.GlobalCycle => if a < 0 { "Global " + w + " is read while it is being set"; }
            else { "Globals " + w + " and " + word_text(decl_name[a]) + " each need the other set first"; },
        Diag.NotValue => if a == 2 { w + " is a field: read it from a value"; } else { w + " is a " + pick(a == 1, "module", "type") + ", not a value"; },
        Diag.NotAssignable => "Only a variable, field, or index can be assigned",
        Diag.IrUnknown => if a == 1 { "@ir names no parameter " + w; } else if a == 2 { "@ir <" + w + "> is written wrong here"; } else { "No @ir element <" + w + ">"; },
        Diag.IrInvalid => "@ir in " + w + " does not make valid Wasm: " + word_text(a),
        Diag.IrType => if diag_c[i] == 1 { "@ir gives " + pick(b == vt_i32 and a == prelude(Prelude.Bool), "an i32, not a comparison's", vt_text(b) + ", not") + " " + type_text(a); } else { "@ir <" + w + "> takes " + vt_text(a) + ", given " + vt_text(b); },
        Diag.EsNative => if b > 0 { w + " passes " + type_text(a) + " to JS, which cannot read it"; } else if es_fun_type(a) { w + " gets a JS function: that is a cl, not " + type_text(a); } else { w + " gets " + type_text(a) + " from JS, which cannot make one"; },
        Diag.YieldPlace => "yield T is only a generator's result type",
        Diag.NotStruct => type_text(a) + " is not a struct: it has no fields to set",
        Diag.NewNotHost => "new makes host objects; " + w + " is not a host class",
        Diag.GeneratorExport => w + " is a generator: it expands into each for that reads it, so it cannot be exported",
        Diag.HostMissing => "No declarations for " + w + "; is it installed?",
        Diag.PruneOutside => "prune outside a recursive generator loop",
        Diag.GeneratorPassThrough => w + " passes its values straight through",
        Diag.GeneratorArity => w + " takes " + int_text(a) + ", given " + int_text(b),
        Diag.GeneratorRecursion => "Generator " + w + " recurses",
        Diag.YieldOutside => "yield outside a generator",
        Diag.YieldInClosure => "yield in a closure",
        Diag.GeneratorReturnValue => "A generator returns no value",
        Diag.GeneratorCall => w + " is a generator: for (" + w + "(…)) |v| { … }",
        Diag.AwaitForSource => "await for needs a generator call or a stream",
        Diag.AwaitForCapture => "A stream loop binds one value",
        Diag.IteratorUnfinished => "Unfinished pipeline: " + w,
        Diag.IteratorCaptures => {
            // b == 1: exactly that many (sort's two values to compare), no index
            if b == 1 { return w + " takes exactly " + int_text(a) + " names"; };
            w + " takes " + int_text(a) + pick(a == 1, " name", " names") + " and an optional index";
        },
        Diag.OptionalOutsideStatement => "?. only in a statement",
        Diag.AwaitNotPromise => "Cannot await " + type_text(a),
        Diag.ProtoMissing => decl_text(a) + " lacks " + word_text(diag_c[i]) + "." + w,
        Diag.ProtoSignature => word_text(a) + "[" + word_text(b) + "]." + w + " does not match the protocol",
        Diag.MemElementRange => {
            if b == -1 and mem_int_enum(a) >= 0 { return word_text(diag_c[i]) + " is no " + word_text(decl_name[mem_int_enum(a)]); };
            word_text(diag_c[i]) + " does not fit " + Storage.name(mem_storage(a));
        },
        Diag.MemInitializer => {
            if a == 1 {
                let head = mem_word(word) + " " + w + " takes a list, @embed, or @comptime";
                // One number: the list of it.
                if not is_kind(node, Node.Literal) and not is_kind(node, Node.Unary_expr) { return head; };
                return head + ": [" + node_text(node) + "]";
            };
            mem_word(word) + " " + w + ": numbers only";
        },
        Diag.MemEmbed => "@embed cannot read " + bytes_text(dsl_text_start(node), dsl_text_end(node)),
        Diag.MemView => "view() needs using JS from std:JS",
        Diag.MemNoMethod => {
            let name = word_of(first_child(node));
            mem_word(name) + " " + node_text(first_child(node)) + " has no method " + w;
        },
        Diag.InternNotBytes => "Only U8 and I8 " + mem_word(word) + "s intern",
        Diag.TooManyMems => "Too many mems (max " + int_text(max_memories) + "): make " + w + " a vec",
        Diag.VecHost => "The host cannot see vec " + node_text(first_child(node)) + ": make it a mem",
        Diag.InvalidDslUsage => "@es needs a typed let",
        Diag.ParseError => {
            // What the parser wanted, and what it found; or what @parse_hint saw.
            if diag_c[i] >= 0 { return word_text(diag_c[i]); };
            // The lexer stops at a quote or backtick it finds no end for.
            if tok_kind[a] == Tok.Error.to_i32() and src[tok_start[a]] == 34 {
                // A 0xFF byte (never UTF-8) is where the lexer sees the file end.
                let j = tok_start[a] + 1;
                while (src[j] != 10 and src[j] != 34 and src[j] != 255) { j += 1; };
                return if src[j] == 255 and j < file_end[file_of_token(a)] { "Not UTF-8"; } else { "Unclosed string"; };
            };
            if tok_kind[a] == Tok.Error.to_i32() and src[tok_start[a]] == 96 { return "Unclosed template string"; };
            if tok_kind[a] == Tok.Error.to_i32() and src[tok_start[a]] == 47 and src[tok_start[a] + 1] == 92 {
                let inner = first_bare_opener(tok_start[a] + 2, file_end[file_of_token(a)]);
                if inner >= 0 { return "No \\/ ends this body: the /\\ at line " + int_text(line_of_byte(inner)) + " opens another"; };
                return "No \\/ ends this body";
            };
            let found = found_text(a);
            if b >= 0 and semicolon_in_multiline(a - 1) and word_text(b) == "';'" { return "Expected ';', got " + found + " (a \\\\ line's ';' is text)"; };
            if b >= 0 { return "Expected " + word_text(b) + ", got " + found; };
            if tok_kind[a] == Tok.End.to_i32() { return "Unexpected end of file"; };
            // A mem is one program's memory: not a module's (made per instance) or a function's.
            if found == "'mem'" or found == "'vec'" { return "Unexpected " + found + ": a " + found.slice(1, 4) + " goes at the top level of a file"; };
            "Unexpected " + found;
        },
        Diag.Unsupported => "Not supported yet",
        Diag.UnknownMember => word_text(diag_c[i]) + " has no member " + w,
        Diag.DslPlace => {
            if w == "embed" or w == "comptime" { return "@" + w + " only fills a mem"; };
            if w == "ir" { return "@ir body is empty or not well-formed IR"; };
            "No DSL @" + w;
        },
        Diag.AltNotEnum => {
            if a >= 0 and ty_is(a, Ty.Nullable) { return "alt on nullable " + type_text(ty_a[a]); };
            if a >= 0 { return "alt on " + type_text(a); };
            "alt needs an enum";
        },
        Diag.IteratorSource => {
            // b: 0 a pipeline's source, 1 a stage's other array, 2 a flat_map body, 3 bisect with other stages,
            // 4 a range of a type that cannot be counted, 5 sum of non-numbers, 6 bisect over a range not of I32,
            // 7 a source an operator took (word: the operator)
            if b == 7 { return "A pipeline binds looser than " + w + ": its source is all of this"; };
            if b == 6 { return "bisect takes a range of I32, not " + type_text(a); };
            if b == 5 { return word_text(word) + " needs numbers, not " + type_text(a); };
            if b == 4 { return "Cannot pipe a range of " + type_text(a); };
            if b == 3 { return "bisect must be the whole pipeline"; };
            if b == 2 { return "flat_map body gives " + type_text(a) + ", not an array"; };
            if b == 1 { return word_text(word) + " takes an array, not " + type_text(a); };
            if a >= 0 { return "Cannot pipe " + type_text(a); };
            "Cannot pipe this";
        },
        Diag.IteratorTerminalInside => "Nothing can follow " + w,
        Diag.ClosureParamType => w + " needs a type",
        Diag.ImplicitStructInit => {
            if a >= 0 { return "&{…} needs a struct type, not " + type_text(a); };
            "&{…} needs a struct type";
        },
        Diag.LazyValue => {
            if b == 1 { return w + " returns " + type_text(a) + ", not an element"; };
            w + " takes " + type_text(a) + ", which cannot cross into a lazy module";
        },
        Diag.BoundMissing => {
            let what = if a >= 0 { type_text(a); } else { w; };
            what + " does not implement " + proto_text(b) + " (" + decl_text(decl_owner[diag_c[i]]) + "'s " + decl_text(diag_c[i]) + " needs it)";
        },
        Diag.UnboundedCall => decl_text(a) + " has no method " + w + "; bound it: " + bounded_text(diag_c[i], a, b),
        Diag.BoundNotProto => type_text(decl_type(a, 0)) + " is not a protocol" + pick(b == 1, "; a struct lists protocols", pick(b == 2, "; an enum lists protocols", pick(b == 3, "", "; a bound names one"))),
        Diag.ProtoNoMember => decl_text(a) + " has no member " + w,
        Diag.ProtoSelfDynamic => type_text(a) + "." + w + " uses &, so only a bounded T calls it: mod M[T[" + type_text(a) + "]]",
        ~> Diag.name(k),
    };
}

/// A token as an error names it: a name, number, or symbol as written (a
/// long one cut short), and what the others are.
fn found_text(t: I32) Str {
    let kind = tok_kind[t];
    if kind == Tok.End.to_i32() { return "the end of the file"; };
    if kind == Tok.String.to_i32() or kind == Tok.MultilineLine.to_i32() { return "a string"; };
    if kind == Tok.DslBody.to_i32() { return "a DSL body"; };
    // The lexer stops before a character it does not know: that character.
    if kind == Tok.Error.to_i32() {
        let b = src[tok_start[t]];
        let n = if b >= 240 { 4; } else if b >= 224 { 3; } else if b >= 192 { 2; } else { 1; };
        return "character '" + bytes_text(tok_start[t], tok_start[t] + n) + "'";
    };
    let text = bytes_text(tok_start[t], tok_end[t]);
    if text.len() > 24 { return "'" + text.slice(0, 24) + "…'"; };
    "'" + text + "'";
}

/// Whether extra row k of diagnostic i is a place (a label on its own span,
/// or another node), not a note or a fix.
fn is_place(i: I32, k: I32) Bool {
    let kind = extra_kind[diag_extra[i] + k];
    kind != Extra.Note.to_i32() and kind != Extra.Fix.to_i32();
}

/// What hangs off a diagnostic's own span when its report gave no label:
/// the shortest true thing about it, from what was reported.
fn diag_default_label(i: I32) Str {
    let k = Diag.from_i32(diag_kind[i]);
    let a = diag_a[i];
    let b = diag_b[i];
    let w = word_text(diag_word[i]);
    match k {
        Diag.TypeMismatch => if b >= 0 { type_text(b); } else { "wrong type"; },
        Diag.NotNullable => "never null",
        Diag.NullableAccess => "may be null",
        Diag.UnknownVariable => "not defined",
        Diag.UnknownType => "no such type",
        Diag.UnknownModule => "no such module",
        Diag.UnknownMethod => "no such method",
        Diag.UnknownMember => "no such member",
        Diag.UnknownField => "no such field",
        Diag.UnknownVariant => "no such variant",
        Diag.UnknownOperator => if a >= 0 { type_text(a); } else { "here"; },
        Diag.WrongArity => if named_word(diag_word[i]) { "given " + int_text(b); } else { "takes " + int_text(a) + ", given " + int_text(b); },
        Diag.MissingField => w + "?",
        Diag.DuplicateDeclaration => pick(a == 7, "already listed", "already declared"),
        Diag.AmbiguousName => "ambiguous",
        Diag.StandardName => "a prelude name",
        Diag.InstanceDepth => "one more level",
        Diag.DuplicateField => "already given",
        Diag.DuplicatePattern => "already matched",
        Diag.AssignmentToImmutable => "cannot be assigned",
        Diag.NonExhaustive => if a == 2 or a == 3 { "no " + w; } else { "no ~>"; },
        Diag.IntegerOutOfRange => if a >= 0 { type_text(a); } else { "out of range"; },
        Diag.FloatOutOfRange => type_text(a),
        Diag.EnumBase => "not U8, I8, U16, I16, I32, or U32",
        Diag.TagEnumValue => "no value here",
        Diag.BareNull => "no type",
        Diag.NotCallable => "not a function",
        Diag.ParseError => if b >= 0 and comptime_parse_site(i) < 0 { word_text(b) + "?"; } else { "unexpected"; },
        Diag.DslEmpty => "empty",
        Diag.ComptimeCycle => if a >= 0 and decl_name[a] != diag_word[i] { "waits on " + word_text(decl_name[a]); } else { "waits on itself"; },
        Diag.DslTooDeep => "too deep",
        Diag.TryNotResult => type_text(a),
        Diag.TryErrorMismatch => type_text(a) + " errors",
        Diag.TryPlace => pick(a >= 2, "in a generator", "no Result to return"),
        Diag.StdOwnStruct => "use its functions",
        Diag.UsingTwice => "needs |alias|",
        Diag.AmbiguousMethod => "as which protocol?",
        Diag.ImplNothing => "an instance",
        Diag.ProtoNoMember => "not in " + decl_text(a),
        Diag.ProtoGeneric => "on a generic type",
        Diag.SelfUntyped => "type not known yet",
        Diag.ProtoAccess => pick(a == 1, "set-only", "get-only"),
        Diag.ProtoPairType => "one type for get and set",
        Diag.MemberClash => pick(b == 1, "also in the protocol", "also a field"),
        Diag.VariantNotValue => "make one: " + w + " {…}",
        Diag.UnknownLabel => "no such label",
        Diag.GlobalCycle => if a < 0 { "reads " + w; } else { "needs " + word_text(decl_name[a]); },
        Diag.NotValue => "not a value",
        Diag.NotAssignable => "not a variable",
        Diag.IrUnknown => if diag_a[i] == 2 { "malformed"; } else { "unknown"; },
        Diag.IrInvalid => "unchecked",
        Diag.IrType => if diag_c[i] == 1 { "not " + type_text(diag_a[i]); } else { vt_text(diag_b[i]); },
        Diag.EsNative => if diag_b[i] > 0 { "opaque to JS"; } else if es_fun_type(diag_a[i]) { "a cl"; } else { "JS cannot make it"; },
        Diag.YieldPlace => "not a type here",
        Diag.NotStruct => "no fields",
        Diag.NewNotHost => "not a host class",
        Diag.GeneratorExport => "a generator",
        Diag.HostMissing => "not found",
        Diag.ImportNotModule => "not a mod",
        Diag.ModNoType => "a mod, not a type",
        Diag.WutuHole => type_text(a),
        Diag.WutuKey => type_text(a),
        Diag.GenericGlobal => "differs per instance",
        Diag.ReturnInBench => "would end the timing",
        Diag.TestInGeneric => "runs in no instance",
        ~> "here",
    };
}

/// The span a diagnostic points at: its node's, as byte offsets.
fn diag_start(i: I32) I32 {
    if comptime_parse_site(i) >= 0 { return comptime_byte(comptime_parse_site(i), tok_start[diag_a[i]]); };
    if diag_kind[i] == Diag.ParseError.to_i32() { return tok_start[diag_a[i]]; };
    if diag_kind[i] == Diag.DslError.to_i32() { return diag_a[i]; };
    let f = located_file(i);
    if f >= 0 { return dsl_file_from[f]; };
    let node = diag_at(i);
    if node < 0 { return -1; };
    tok_start[node_first[node]];
}

/// Where a diagnostic's span ends (see @diag_start).
fn diag_end(i: I32) I32 {
    if comptime_parse_site(i) >= 0 { return comptime_byte(comptime_parse_site(i), tok_end[diag_a[i]]); };
    if diag_kind[i] == Diag.ParseError.to_i32() { return tok_end[diag_a[i]]; };
    if diag_kind[i] == Diag.DslError.to_i32() { return diag_b[i]; };
    let f = located_file(i);
    if f >= 0 { return dsl_file_to[f]; };
    let node = diag_at(i);
    if node < 0 { return -1; };
    tok_end[node_last[node] - 1];
}

/// The generated file of located code a diagnostic is in, or -1.
fn located_file(i: I32) I32 {
    let node = diag_node[i];
    if node < 0 or comptime_site(i) >= 0 { return -1; };
    let file = file_of_token(node_first[node]);
    if file < dsl_file_from.len() and dsl_file_from[file] >= 0 { file; } else { -1; };
}

/// The node a diagnostic points at: its own, or the `@comptime` expression
/// it is in, or the DSL site whose generated code it is in.
fn diag_at(i: I32) I32 {
    let k = comptime_site(i);
    if k >= 0 { return comptime_text_node[k]; };
    let node = diag_node[i];
    // Code a DSL generated: its site.
    if node >= 0 {
        let site = dsl_site_of(node);
        if site >= 0 { return site; };
    };
    node;
}

/// The file a diagnostic is in, or -1.
fn diag_file(i: I32) I32 {
    let node = diag_at(i);
    if node < 0 {
        let k = comptime_parse_site(i);
        if k >= 0 { return file_of_token(node_first[comptime_text_node[k]]); };
        if diag_kind[i] == Diag.ParseError.to_i32() { return diag_word[i]; };
        return -1;
    };
    file_of_token(node_first[node]);
}
