//! = Diagnostics
//!
//! A diagnostic's kind name, message, and span, made when the host asks, in
//! stage 0's words, from what was reported (see `report` in resolve.utu).

/// The text of a word.
fn word_text(w: I32) Str {
    if w < 0 { return "" }
    let start = src.interned_start(w)
    return bytes_text(start, start + src.interned_size(w))
}

/// The text of `src[start ..< end_]` (UTF-8).
fn bytes_text(start: I32, end_: I32) Str {
    if end_ <= start { return "" }
    // Code units into an array (no more of them than bytes), made a string once.
    let codes = Array[I32].new(end_ - start, 0)
    let k = 0
    let i = start
    while (i < end_) {
        let b = src[i]
        if b < 128 {
            codes[k] = b
            k += 1
            i += 1
        } else if utf8_char_size(i, end_) < 0 {
            // A byte that is not UTF-8 (or a character cut by `end_`): U+FFFD.
            codes[k] = 65533
            k += 1
            i += 1
        } else {
            let cp = b
            let n = 1
            if b >= 240 { cp = b & 7; n = 4 } else if b >= 224 { cp = b & 15; n = 3 } else if b >= 192 { cp = b & 31; n = 2 }
            for (1 ..< n) |m| { cp = (cp << 6) | (src[i + m] & 63) }
            if cp >= 65536 {
                codes[k] = 55296 + ((cp - 65536) >> 10)
                codes[k + 1] = 56320 + ((cp - 65536) & 1023)
                k += 2
            } else {
                codes[k] = cp
                k += 1
            }
            i += n
        }
    }
    return Str.from_codes(codes, k)
}

/// A declaration's name, or empty for none.
fn decl_text(d: I32) Str {
    if d < 0 { return "" }
    return word_text(decl_name[d])
}

/// A node's source, as written.
fn node_text(node: I32) Str {
    if node < 0 { return "" }
    return bytes_text(tok_start[node_first[node]], tok_end[node_last[node] - 1])
}

fn int_text(v: I32) Str => v.str()

fn pick(c: Bool, yes: Str, no: Str) Str {
    if c { return yes }
    return no
}

/// A type as stage 0 writes it: `I32`, `?Point`, `Array[I32]`, `fun(I32) Bool`, `.{I32, F64}`.
fn type_text(t: I32) Str {
    if t < 0 { return "unknown" }
    let kind = ty_kind[t]
    if kind == Ty.Error.i32() { return "unknown" }
    if kind == Ty.Void.i32() { return "Void" }
    if kind == Ty.Never.i32() { return "never" }
    if kind == Ty.Null.i32() { return "null" }
    if kind == Ty.Nullable.i32() { return dgs1(Dgt.QA, type_text(ty_a[t])) }
    if kind == Ty.Tuple.i32() { return dgs1(Dgt.DotBraceABraceEnd, type_list_text(ty_a[t])) }
    if kind == Ty.Foreign.i32() { return foreign_text(t) }
    if kind == Ty.Fun.i32() or kind == Ty.Closure.i32() {
        return dgs3(Dgt.ABCloseSpaceC, pick(kind == Ty.Fun.i32(), dgs(Dgt.Fun), "cl("), type_list_text(ty_a[t]), type_text(ty_b[t]))
    }
    let decl = ty_a[t]
    let inst = ty_b[t]
    let module = module_of(decl)
    let name = decl_name[decl]
    if decl_is(decl, Decl.TypeDecl) or (module >= 0 and decl_a[module] == decl) { name = decl_name[module] }
    let text = word_text(name)
    if qualify_types > 0 and module >= 0 and decl_a[module] != decl and not decl_is(decl, Decl.TypeDecl) {
        let args = if qualify_types == 2 and inst > 0 { dgs1(Dgt.BracketABracketEnd, type_list_text(inst_args[inst])) } else { "" }
        text = dgs3(Dgt.ABDotC, word_text(decl_name[module]), args, text)
    }
    if inst > 0 and module >= 0 and (decl_a[module] == decl) {
        text = dgs2(Dgt.ABracketBBracketEnd, text, type_list_text(inst_args[inst]))
    }
    return text
}

/// Whether @type_text names a module's type with its module (`a.S`).
let qualify_types: I32 = 0

/// "Expected A, got B": two types of one name told apart by their modules,
/// or said to be two.
fn expected_got(a: I32, b: I32) Str {
    let ta = type_text(a)
    let tb = type_text(b)
    if ta == tb and a != b {
        qualify_types = 1
        ta = type_text(a)
        tb = type_text(b)
        // (Instances of one module: with their type arguments.)
        if ta == tb {
            qualify_types = 2
            ta = type_text(a)
            tb = type_text(b)
        }
        qualify_types = 0
        if ta == tb { return dgs2(Dgt.ExpectedGotAnotherTypeOfThat, ta, tb) }
    }
    return dgs2(Dgt.ExpectedGot, ta, tb)
}

fn type_list_text(list: I32) Str {
    let text = ""
    for (0 ..< vl_len[list]) |i| {
        if i > 0 { text = dgs1(Dgt.ACommaSpace, text) }
        text = text + type_text(vl_item(list, i))
    }
    return text
}

/// The symbol of an operator word (add is `+`).
fn operator_symbol(w: I32) Str {
    if w == known_word(Known.Add) { return "+" }
    if w == known_word(Known.Sub) { return "-" }
    if w == known_word(Known.Mul) { return "*" }
    if w == known_word(Known.Div) { return "/" }
    if w == known_word(Known.Rem) { return "%" }
    if w == known_word(Known.Band) { return "&" }
    if w == known_word(Known.Bor) { return "|" }
    if w == known_word(Known.Bxor) { return "^" }
    if w == known_word(Known.Shl) { return "<<" }
    if w == known_word(Known.Shr) { return ">>" }
    if w == known_word(Known.Ushr) { return ">>>" }
    if w == known_word(Known.Eq) { return "==" }
    if w == known_word(Known.Ne) { return "!=" }
    if w == known_word(Known.Lt) { return "<" }
    if w == known_word(Known.Le) { return "<=" }
    if w == known_word(Known.Gt) { return ">" }
    if w == known_word(Known.Ge) { return ">=" }
    if w == known_word(Known.Neg) { return "-" }
    if w == known_word(Known.Bnot) { return "~" }
    if w == known_word(Known.GetIndex) { return "[]" }
    if w == known_word(Known.GetSlice) { return dgs(Dgt.BracketCommaBracketEnd) }
    if w == known_word(Known.SetIndex) { return dgs(Dgt.BracketBracketEndEq) }
    return word_text(w)
}

/// Where InvalidBreak's argument a says which rule was broken.
enum(U8) BreakRule:
    | BreakOutside
    | ContinueOutside
    | ContinueStateOutside
    | ContinueWithoutState
    | BreakInDefer
    | ContinueInDefer
    | ReturnInDefer
    | DeferNotStatement
    | TryInDefer

/// Where InvalidDirective's argument a says which rule was broken.
enum(U8) DirectiveRule:
    | Unknown       // no directive of that name
    | NoArgument    // `#inline(1)`: only #cache takes one
    | CacheSize     // `#cache(3)`: 0 (no bound) or a power of 2
    | Conflict      // `#inline` and `#noinline` on one function
    | Twice         // one directive twice on one function

/// The JS typed array a mem's view is.
fn view_array_name(s: Storage) Str {
    if s == Storage.U8 { return dgs(Dgt.Uint8Array) }
    if s == Storage.I8 { return dgs(Dgt.Int8Array) }
    if s == Storage.U16 { return dgs(Dgt.Uint16Array) }
    if s == Storage.I16 { return dgs(Dgt.Int16Array) }
    if s == Storage.I32 { return dgs(Dgt.Int32Array) }
    if s == Storage.U32 { return dgs(Dgt.Uint32Array) }
    if s == Storage.I64 { return dgs(Dgt.BigInt64Array) }
    if s == Storage.U64 { return dgs(Dgt.BigUint64Array) }
    if s == Storage.F32 { return dgs(Dgt.Float32Array) }
    return dgs(Dgt.Float64Array)
}

/// The `@comptime` expression a diagnostic is in (its index in
/// `comptime_text_*`), or -1. Its expression was copied into a function of
/// the generated file, whose line 4 it starts on.
fn comptime_site(i: I32) I32 {
    let node = diag_node[i]
    if node < 0 { return -1 }
    let b = tok_start[node_first[node]]
    for (0 ..< comptime_text_start.len()) |k| {
        // (From the `(` written before the expression.)
        if b >= comptime_text_start[k] - 1 and b < comptime_text_end[k] { return k }
    }
    return -1
}

/// The `@comptime` expression a parse error is in, or -1: the generated
/// text from its start to the next one's (its expression did not end).
fn comptime_parse_site(i: I32) I32 {
    if diag_kind[i] != Diag.ParseError.i32() or diag_a[i] < 0 { return -1 }
    let b = tok_start[diag_a[i]]
    let k = comptime_text_start.len() - 1
    while (k >= 0 and comptime_text_start[k] > b) { k -= 1 }
    return k
}

/// Byte `b` of @comptime expression k's generated text, as the place in its
/// mem's body (past its end: the body's end).
fn comptime_byte(k: I32, b: I32) I32 {
    let at = if b < comptime_text_end[k] { b } else { comptime_text_end[k] }
    return dsl_text_start(comptime_text_node[k]) + at - comptime_text_start[k]
}

/// The kind's name, as stage 0 spells it.
fn diag_kind_name(i: I32) Str {
    if comptime_site(i) >= 0 { return dgs(Dgt.TypeMismatch) }
    return diag_kind_of(i)
}

/// A diagnostic's message for the host: one in a `@comptime` expression
/// says so, and on which line of it.
fn diag_message(i: I32) Str {
    if comptime_parse_site(i) >= 0 { return dgs1(Dgt.ComptimeTakesOneExpression, diag_text(i)) }
    let k = comptime_site(i)
    if k < 0 { return diag_text(i) }
    let line = 4
    for (comptime_text_start[k] ..< tok_start[node_first[diag_node[i]]]) |b| { if src[b] == 10 { line += 1 } }
    return dgs2(Dgt.ComptimeLine, diag_text(i), int_text(line))
}

fn diag_kind_of(i: I32) Str {
    let kind = diag_kind[i]
    if kind == Diag.PromotedFn.i32() and diag_a[i] == 2 { return dgs(Dgt.NotCallable) }
    if kind >= Diag.count() { return dgs(Dgt.TypeMismatch) }
    return st(st_kind + kind)
}

/// The kind name as reported in stage 0.
fn diag_name_for_kind(k: Diag) Str {
    if k == Diag.UnknownVariable { return "unknown-variable" }
    if k == Diag.UnknownType or k == Diag.NotAModule or k == Diag.UnknownModule or k == Diag.UnknownVariant or k == Diag.MemKind or k == Diag.InvalidDistinct or k == Diag.MemView { return "unknown-type" }
    if k == Diag.UnknownImport { return "unknown-import" }
    if k == Diag.ImportCycle { return "import-cycle" }
    if k == Diag.DuplicateDeclaration or k == Diag.DuplicatePattern or k == Diag.MemTwice or k == Diag.MemClash or k == Diag.EnumValueTwice { return "duplicate-declaration" }
    if k == Diag.UnknownMember { return "unknown-method" }
    if k == Diag.DslPlace { return "invalid-dsl-usage" }
    if k == Diag.UnknownMethod or k == Diag.ProtoMissing or k == Diag.InternNotBytes or k == Diag.MemNoMethod or k == Diag.VecHost { return "unknown-method" }
    if k == Diag.UnknownOperator { return "unknown-operator" }
    if k == Diag.WrongArity { return "wrong-arity" }
    if k == Diag.AssignmentToImmutable { return "assignment-to-immutable" }
    if k == Diag.InvalidBreak or k == Diag.InvalidDefer { return "invalid-break" }
    if k == Diag.Unsupported { return "unsupported" }
    if k == Diag.LazyValue { return "invalid-lazy-call" }
    if k == Diag.ParseError { return "parse-error" }
    if k == Diag.DuplicateField { return "duplicate-field" }
    if k == Diag.InvalidNullableType or k == Diag.BareNull { return "invalid-nullable-type" }
    if k == Diag.InvalidGlobalInitializer { return "invalid-global-initializer" }
    if k == Diag.RecursiveType { return "recursive-type" }
    if k == Diag.IntegerOutOfRange { return "integer-literal-out-of-range" }
    if k == Diag.UnknownField { return "unknown-field" }
    if k == Diag.MissingField { return "missing-field" }
    if k == Diag.NullableAccess { return "nullable-access" }
    if k == Diag.NonDefaultable { return "non-defaultable-type" }
    if k == Diag.InvalidModuleArity { return "invalid-module-arity" }
    if k == Diag.NotCallable { return "not-callable" }
    if k == Diag.NonExhaustive { return "non-exhaustive-match" }
    if k == Diag.InvalidForSource or k == Diag.GeneratorRecursion or k == Diag.YieldOutside or k == Diag.GeneratorReturnValue
        or k == Diag.GeneratorCall or k == Diag.YieldInClosure or k == Diag.AwaitForSource or k == Diag.AwaitForCapture or k == Diag.GeneratorPassThrough
        or k == Diag.GeneratorArity or k == Diag.PruneOutside or k == Diag.PruneInClosure
        or k == Diag.GeneratorMethod { return "invalid-for-source" }
    if k == Diag.IteratorUnfinished or k == Diag.IteratorCaptures or k == Diag.IteratorTerminalInside or k == Diag.IteratorSource { return "invalid-iterator-usage" }
    if k == Diag.AwaitNotPromise { return "invalid-await" }
    if k == Diag.EntrySurface { return "entry-surface-conflict" }
    if k == Diag.InvalidEscape { return "invalid-escape" }
    if k == Diag.AwaitInClosure or k == Diag.AwaitInGlobal { return "invalid-await" }
    if k == Diag.InvalidDslUsage or k == Diag.DslError or k == Diag.WatPlace or k == Diag.WatHost { return "invalid-dsl-usage" }
    if k == Diag.ImplicitStructInit { return "implicit-struct-init" }
    if k == Diag.StorageType { return "storage-type" }
    if k == Diag.ReturnValueFromVoid { return "type-mismatch" }
    if k == Diag.FloatOutOfRange { return "float-literal-out-of-range" }
    if k == Diag.EnumBase or k == Diag.TagEnumValue { return "invalid-enum" }
    if k == Diag.ProtoGeneric { return "unsupported" }
    if k == Diag.MemberClash { return "duplicate-declaration" }
    if k == Diag.AmbiguousName or k == Diag.AmbiguousVariant { return "ambiguous-name" }
    if k == Diag.StandardName { return "duplicate-declaration" }
    if k == Diag.InstanceDepth { return "instantiation-depth" }
    if k == Diag.MainParams { return "entry-surface-conflict" }
    if k == Diag.TestName { return "duplicate-declaration" }
    if k == Diag.ReturnInBench { return "invalid-break" }
    if k == Diag.TestInGeneric { return "unsupported" }
    if k == Diag.TooManyParams { return "too-many-parameters" }
    if k == Diag.BoundMissing { return "unsatisfied-bound" }
    if k == Diag.UnboundedCall { return "unknown-method" }
    if k == Diag.BoundNotProto or k == Diag.ProtoSelfDynamic { return "invalid-bound" }
    if k == Diag.UnknownLabel { return "invalid-break" }
    if k == Diag.GlobalCycle { return "invalid-global-initializer" }
    if k == Diag.NotValue or k == Diag.NotStruct { return "type-mismatch" }
    if k == Diag.NotAssignable { return "assignment-to-immutable" }
    if k == Diag.IrUnknown { return "invalid-dsl-usage" }
    if k == Diag.YieldPlace or k == Diag.GeneratorExport { return "invalid-for-source" }
    if k == Diag.NewNotHost or k == Diag.HostAbstract { return "not-callable" }
    if k == Diag.HostMissing { return "unknown-import" }
    if k == Diag.ComptimeTrap or k == Diag.ComptimeCycle { return "comptime-trap" }
    if k == Diag.DslEmpty or k == Diag.DslTooDeep or k == Diag.IrInvalid or k == Diag.IrType or k == Diag.EsNative { return "invalid-dsl-usage" }
    if k == Diag.StdOwnStruct { return "unknown-field" }
    if k == Diag.TryNotResult or k == Diag.TryPlace or k == Diag.TryErrorMismatch { return "invalid-try" }
    if k == Diag.ImportNotModule or k == Diag.ModNoType { return "unknown-type" }
    if k == Diag.UsingTwice { return "duplicate-declaration" }
    if k == Diag.ModNameCase { return "invalid-name" }
    if k == Diag.PromotedFn { return "duplicate-declaration" }
    if k == Diag.AmbiguousMethod { return "unknown-method" }
    if k == Diag.ImplNothing or k == Diag.ProtoNoMember { return "unknown-method" }
    if k == Diag.InvalidDirective { return "invalid-directive" }
    return "type-mismatch"
}

/// `Promise[T]`'s T, `?Promise[T]`'s ?T.
fn awaited_type(t: I32) I32 {
    if ty_is(t, Ty.Nullable) { return nullable(awaited_type(ty_a[t])) }
    return inst_arg(ty_inst(t), 0)
}

/// Whether t is a `fun` type, or a nullable one.
fn es_fun_type(t: I32) Bool => ty_is(t, Ty.Fun) or (ty_is(t, Ty.Nullable) and ty_is(ty_a[t], Ty.Fun))

/// A value type's name, as `@ir` tags spell it.
fn vt_text(vt: I32) Str {
    if vt == vt_i32 { return "i32" }
    if vt == vt_i64 { return "i64" }
    if vt == vt_f32 { return "f32" }
    if vt == vt_f64 { return "f64" }
    if vt == vt_v128 { return "v128" }
    if vt == vt_none { return dgs(Dgt.Nothing) }
    if vt == vt_eqref { return dgs(Dgt.Eqref) }
    if vt == vt_i8 { return dgs(Dgt.I8) }
    if vt == vt_i16 { return dgs(Dgt.I16) }
    if vt == vt_i31ref { return dgs(Dgt.I31ref) }
    if vt == vt_extern or vt == vt_externref { return dgs(Dgt.Externref) }
    if vt >= vt_defined and vt < vt_tuple {
        let k = ht_kind[vt_heap(vt)]
        if k == Heap.Array.i32() { return dgs1(Dgt.AnArrayOf, vt_text(ht_a[vt_heap(vt)])) }
        if k == Heap.Struct.i32() { return dgs(Dgt.AStruct) }
    }
    return dgs(Dgt.AReference)
}

/// A top-level item, by its node kind, after "is".
fn item_kind_text(kind: I32) Str {
    let k = Node(kind)
    if k == Node.Fn_decl { return dgs(Dgt.AFunction) }
    if k == Node.Struct_decl { return dgs(Dgt.AStruct) }
    if k == Node.Enum_decl { return dgs(Dgt.AnEnum) }
    if k == Node.Proto_decl { return dgs(Dgt.AProtocol) }
    if k == Node.Global_decl { return dgs(Dgt.AGlobal) }
    return "not a mod"
}

/// Whether `t` names a number or Bool type: what match takes.
fn is_scalar_name(t: Str) Bool {
    return t == "I32" or t == "U32" or t == "I64" or t == "U64" or t == "F32" or t == "F64" or t == dgs(Dgt.U8) or t == dgs(Dgt.I82)
        or t == dgs(Dgt.U16) or t == dgs(Dgt.I162) or t == "Bool"
}

/// What to do instead of an alt over a value of type `t`.
fn alt_hint(t: I32) Str {
    if t >= 0 and ty_is(t, Ty.Nullable) { return dgs(Dgt.UnwrapWithPromote) }
    let name = type_text(t)
    if is_scalar_name(name) { return dgs(Dgt.UseMatch) }
    if name == "Str" { return dgs(Dgt.UseIf) }
    return ""
}

/// What a pipeline could read instead of a value of type `t`.
fn source_hint(t: I32) Str {
    if t >= 0 and ty_is(t, Ty.Nullable) { return dgs(Dgt.UnwrapWithPromoteOrOrelse) }
    let name = type_text(t)
    if is_scalar_name(name) and name != "Bool" and name != "F32" and name != "F64" { return dgs(Dgt.UseARange0N) }
    return ""
}

/// A type's name after "a" or "an".
fn article(t: Str) Str {
    if t.len() == 0 { return t }
    let c = t.slice(0, 1)
    let vowel = c == dgs(Dgt.A) or c == dgs(Dgt.E) or c == "I" or c == dgs(Dgt.O) or c == "U" or c == "a" or c == dgs(Dgt.ELc) or c == "i" or c == dgs(Dgt.OLc) or c == dgs(Dgt.U)
    return pick(vowel, dgs(Dgt.An), dgs(Dgt.ALc)) + t
}

/// Why a `@comptime` evaluation trapped, by the code the host gives (see
/// `comptimeTrapCode` in src/selfhost/compiler.js).
fn comptime_trap_text(code: I32) Str => st(st_trap + if code >= 1 and code <= 8 { code } else { 0 })

fn comptime_trap_src(code: I32) Str {
    return match code {
        1 => "an index out of bounds",
        2 => "it reached fatal, a failed assert, or a missing value",
        3 => "a division by zero",
        4 => "an integer overflow",
        5 => "a null value",
        6 => "the stack overflowed",
        7 => "JavaScript threw",
        8 => "it ran too long (a hundred million loop rounds)",
        ~> "a trap",
    }
}

/// What InvalidBreak or InvalidDefer says, by the @BreakRule broken.
fn break_rule_text(a: I32) Str {
    let r = BreakRule(if a < 0 { 0 } else { a })
    if r == BreakRule.BreakOutside { return dgs(Dgt.BreakOutsideALoop) }
    if r == BreakRule.ContinueOutside { return dgs(Dgt.ContinueOutsideALoop) }
    if r == BreakRule.ContinueStateOutside { return dgs(Dgt.ContinueWithAStateOnlyWorks) }
    if r == BreakRule.ContinueWithoutState { return dgs(Dgt.ContinueNeedsTheNextState) }
    if r == BreakRule.BreakInDefer { return dgs(Dgt.BreakInDefer) }
    if r == BreakRule.ContinueInDefer { return dgs(Dgt.ContinueInDefer) }
    if r == BreakRule.ReturnInDefer { return dgs(Dgt.ReturnInDefer) }
    if r == BreakRule.TryInDefer { return dgs(Dgt.TryInDefer) }
    return dgs(Dgt.DeferMustBeAStatement)
}

/// Whether token t is a `\\` line whose text ends in `;` (meant to end the statement).
fn semicolon_in_multiline(t: I32) Bool {
    if t < 0 or tok_kind[t] != Tok.MultilineLine.i32() { return false }
    let e = tok_end[t] - 1
    while (e > tok_start[t] and (src[e] == 32 or src[e] == 9 or src[e] == 10 or src[e] == 13)) { e -= 1 }
    return src[e] == 59
}

/// A diagnostic's message, in stage 0's words: one of its kind's templates
/// (@diag_text_src), picked here, its holes filled by @diag_hole; `x` and
/// `y` are what the template's `{x}` and `{y}` say.
fn diag_text(i: I32) Str {
    let k = Diag(diag_kind[i])
    let word = diag_word[i]
    let w = word_text(word)
    let a = diag_a[i]
    let b = diag_b[i]
    let c = diag_c[i]
    let node = diag_node[i]
    let x = ""
    let y = ""
    let sub = match k {
        // `main` is the module's entry, not a function the program (or a @comptime build) can call.
        Diag.UnknownVariable => if w == "main" and is_callee(node) { 2 } else if is_callee(node) { 1 } else { 0 },
        Diag.UnknownImport => {
            x = bytes_text(missing_start, missing_end)
            if a == 2 { 0 } else {
                let path = import_path[missing_import]
                y = x
                x = bytes_text(tok_start[node_first[path]] + 1, tok_end[node_last[path] - 1] - 1)
                1
            }
        },
        Diag.ImportCycle => {
            x = bytes_text(missing_start, missing_end)
            0
        },
        Diag.UnknownModule => {
            if a >= 0 { x = imported_modules_text(a) }
            if a >= 0 { 1 } else { 0 }
        },
        Diag.DuplicateDeclaration => if a >= 5 and a <= 9 { a - 5 } else if a >= 1 and a <= 3 { a + 4 } else { 8 },
        Diag.DuplicatePattern => {
            x = node_text(first_child(node))
            if a == 1 { 0 } else { 1 }
        },
        Diag.TupleLet => {
            if not ty_is(a, Ty.Tuple) { 0 }
            // b == 2: a closure captures a tuple
            else if b == 2 { 1 } else if b == 3 { 2 } else {
                x = int_text(vl_len[ty_a[a]])
                3
            }
        },
        Diag.NotNullable => if b == 1 { if w.len() > 0 { 0 } else { 1 } } else { 2 },
        Diag.TypeMismatch => return mismatch_text(i),
        Diag.UnknownMethod => {
            if a >= 0 and ty_is(a, Ty.Nullable) {
                x = type_text(ty_a[a])
                0
            } else if a >= 0 and b == 1 { 1 } else if a >= 0 { 2 } else if c >= 0 { 3 } else { 4 }
        },
        Diag.UnknownOperator => {
            if a >= 0 { x = operator_symbol(word) }
            if a < 0 { 0 } else { 1 }
        },
        Diag.WrongArity => if named_word(word) { 0 } else { 1 },
        Diag.AssignmentToImmutable => if a == 1 { 0 } else { 1 },
        Diag.InvalidBreak => return break_rule_text(a),
        Diag.InvalidDefer => return break_rule_text(a),
        Diag.TupleMisplaced => if a >= 1 and a <= 3 { a - 1 } else { 3 },
        Diag.FunInField => {
            x = type_text(a)
            y = x.slice(3, x.len())
            0
        },
        Diag.IntegerOutOfRange => (if word >= 0 { 0 } else { 1 }) + (if a >= 0 { 0 } else { 2 }),
        Diag.UnknownField => if a >= 0 { 0 } else { 1 },
        Diag.MissingField => if a >= 0 { 0 } else { 1 },
        // A name the compiler calls for you (a template's str, a loop's iterator, indexing): just the type.
        Diag.NullableAccess => if w == dgs(Dgt.Str) or w == "iterator" or w == dgs(Dgt.GetIndex) or w == dgs(Dgt.SetIndex) { 0 } else { 1 },
        Diag.ConstMem => if a >= 0 { 0 } else { 1 },
        Diag.MemKind => {
            x = node_text(next_sibling(first_child(node)))
            0
        },
        Diag.NotCallable => {
            if named_word(word) { x = article(type_text(a)) }
            if named_word(word) { 0 } else { 1 }
        },
        // a: 0 integer match, 1 Bool match, 2 integer enum match, 3 alt
        Diag.NonExhaustive => if a == 1 { if b == 1 { 0 } else { 1 } } else if a == 2 { 2 } else if a == 3 { 3 } else { 4 },
        Diag.MatchType => if decl_is(ty_decl(a), Decl.Enum) { 1 } else { 0 },
        Diag.MatchPattern => {
            x = node_text(first_child(node))
            if a == 1 { 0 } else if a == 2 or a == 3 { 1 } else { 2 }
        },
        // `for (xs) |x, i|`: one name per source; an index is a range's.
        Diag.InvalidForSource => if a == 1 { 0 } else if a == 2 { 1 + (if b == 1 { 0 } else { 2 }) + (if c > b { 1 } else { 0 }) } else { 5 },
        Diag.UnknownForeignMember => {
            x = word_text(view_prefix[a])
            0
        },
        Diag.AwaitInClosure => if is_kind(node, Node.Identifier) { 0 } else { 1 },
        Diag.InvalidEscape => if a >= 1 and a <= 3 { a - 1 } else { 3 },
        Diag.EntrySurface => if a == 0 { 0 } else if a == 1 { 1 } else { 2 },
        // (No name: a closure's return, main's, or a test's.)
        Diag.ReturnValueFromVoid => if word >= 0 { 3 } else if in_closure(node) { 0 } else if in_main(node) { 1 } else { 2 },
        Diag.ComptimeTrap => {
            x = comptime_trap_text(a)
            0
        },
        Diag.FloatOutOfRange => if b == 1 { 0 } else { 1 },
        Diag.MemberClash => if b == 1 { 0 } else { 1 },
        Diag.ProtoAccess => if a == 1 { 0 } else { 1 },
        Diag.ProtoPairType => {
            x = word_text(decl_name[c])
            0
        },
        Diag.AmbiguousName => {
            x = decl_text(module_of(a))
            y = decl_text(module_of(b))
            0
        },
        Diag.TestInGeneric => if a == 1 { 0 } else { 1 },
        Diag.TestName => if a == 1 or a == 3 { if a >= 2 { 1 } else { 0 } } else { (if word >= 0 { 2 } else { 4 }) + (if a >= 2 { 1 } else { 0 }) },
        Diag.TooManyParams => if word < 0 { 0 } else { 1 },
        Diag.DslEmpty => if w == dgs(Dgt.Embed) { 0 } else { 1 },
        Diag.ComptimeCycle => if a < 0 or decl_name[a] == word { 0 } else { 1 },
        // a: 0 try, 1 errdefer, outside a function returning a Result (b: its result);
        // 2 try, 3 errdefer, in a generator
        Diag.TryPlace => (if a == 0 or a == 2 { 0 } else { 3 }) + (if a >= 2 { 0 } else if b < 0 { 1 } else { 2 }),
        Diag.ImportNotModule => {
            x = item_kind_text(a)
            0
        },
        Diag.ModNoType => if word == decl_name[a] { 0 } else { 1 },
        Diag.UsingTwice => {
            x = node_text(a)
            0
        },
        Diag.ModNameCase => if a == 0 { 0 } else { 1 },
        Diag.PromotedFn => if a == 0 { 0 } else if a == 1 { 1 } else { 2 },
        Diag.AmbiguousMethod => {
            x = decl_text(decl_a[a])
            y = decl_text(decl_a[b])
            0
        },
        Diag.WutuHole => if ty_is(a, Ty.Void) { 0 } else { 1 },
        Diag.HostAltClass => {
            x = word_text(view_prefix[a])
            0
        },
        Diag.UnknownLabel => if a == 1 { 0 } else if a == 2 { 1 } else { 2 },
        Diag.GlobalCycle => if a < 0 { 0 } else { 1 },
        Diag.NotValue => if a == 2 { 0 } else if a == 1 { 1 } else { 2 },
        Diag.IrUnknown => if a >= 1 and a <= 4 { a - 1 } else { 4 },
        Diag.IrType => {
            if c == 1 {
                if b == vt_i32 and a == prelude(Prelude.Bool) { 0 } else {
                    x = vt_text(b)
                    1
                }
            } else {
                x = vt_text(a)
                y = vt_text(b)
                2
            }
        },
        Diag.StreamPromise => {
            x = type_text(awaited_type(a))
            0
        },
        Diag.TupleIndex => {
            if b >= 0 { x = tuple_counts(a) }
            if b >= 0 { 0 } else { 1 }
        },
        Diag.HostLiteral => if c == 1 { 0 } else if c == 2 { 1 } else { 2 },
        Diag.TupleLength => {
            x = tuple_counts(a)
            0
        },
        Diag.HostMissing => if a == 1 { 0 } else if text_index(w, dgs(Dgt.AbiJson), 0) >= 0 { 1 } else { 2 },
        Diag.AwaitForSource => if a == 1 { 0 } else { 1 },
        // b == 1: exactly that many (sort's two values to compare), no index
        Diag.IteratorCaptures => if b == 1 { 0 } else if a == 1 { 1 } else { 2 },
        Diag.InvalidDirective => a,
        Diag.ProtoSignature => {
            if c >= 0 { x = type_text(c) }
            if c >= 0 { 1 } else { 0 }
        },
        Diag.MemElementRange => {
            if b == -1 and mem_int_enum(a) >= 0 {
                x = word_text(decl_name[mem_int_enum(a)])
                0
            } else {
                x = storage_name(mem_storage(a))
                1
            }
        },
        // One number: the list of it.
        Diag.MemInitializer => if a == 1 { if not is_kind(node, Node.Literal) and not is_kind(node, Node.Unary_expr) { 0 } else { 1 } } else { 2 },
        Diag.MemEmbed => {
            x = bytes_text(dsl_text_start(node), dsl_text_end(node))
            if b > 0 { y = storage_name(Storage(c)) }
            if b > 0 { 0 } else { 1 }
        },
        Diag.MemNoMethod => {
            x = mem_word(word_of(first_child(node)))
            y = node_text(first_child(node))
            0
        },
        Diag.TooManyMems => {
            x = int_text(max_memories)
            0
        },
        Diag.VecHost => {
            x = node_text(first_child(node))
            0
        },
        // What the parser wanted, and what it found; or what @parse_hint saw.
        Diag.ParseError => {
            if c >= 0 { 0 }
            // The lexer stops at a quote or backtick it finds no end for.
            else if tok_kind[a] == Tok.Error.i32() and src[tok_start[a]] == 34 { 1 }
            else if tok_kind[a] == Tok.Error.i32() and src[tok_start[a]] == 96 { 2 }
            else if tok_kind[a] == Tok.Error.i32() and utf8_char_size(tok_start[a], file_end[file_of_token(a)]) < 0 { 3 }
            else if tok_kind[a] == Tok.Error.i32() and src[tok_start[a]] == 47 and src[tok_start[a] + 1] == 92 {
                let inner = first_bare_opener(tok_start[a] + 2, file_end[file_of_token(a)])
                if inner >= 0 { x = int_text(line_of_byte(inner)) }
                if inner >= 0 { 4 } else { 5 }
            } else {
                x = found_text(a)
                if b >= 0 and semicolon_in_multiline(a - 1) and word_text(b) == dgs(Dgt.TickSemiTick) { 6 }
                else if b >= 0 { 7 }
                else if tok_kind[a] == Tok.End.i32() { 8 }
                // A mem is one program's memory: not a module's (made per instance) or a function's.
                else if x == dgs(Dgt.Mem) or x == dgs(Dgt.Vec) {
                    y = x.slice(1, 4)
                    9
                } else { 10 }
            }
        },
        Diag.DslPlace => if w == dgs(Dgt.Embed) or w == dgs(Dgt.Comptime) { 0 } else if w == dgs(Dgt.Ir) { 1 } else { 2 },
        Diag.AltNotEnum => {
            if a >= 0 and ty_is(a, Ty.Nullable) {
                x = type_text(ty_a[a])
                0
            } else if a >= 0 { 1 } else { 2 }
        },
        // b: 0 a pipeline's source, 1 a stage's other array, 2 a flat_map body, 3 bisect with other stages,
        // 4 a range of a type that cannot be counted, 5 sum of non-numbers, 6 bisect over a range not of I32,
        // 7 a source an operator took (word: the operator)
        Diag.IteratorSource => if b >= 1 and b <= 7 { 7 - b } else if a >= 0 { 7 } else { 8 },
        Diag.ImplicitStructInit => if a >= 0 { 0 } else { 1 },
        Diag.LazyValue => if b == 1 { 0 } else { 1 },
        Diag.BoundMissing => {
            x = proto_text(b)
            y = decl_text(decl_owner[c])
            if a >= 0 { 0 } else { 1 }
        },
        Diag.UnboundedCall => {
            x = bounded_text(c, a, b)
            0
        },
        Diag.BoundNotProto => {
            x = type_text(decl_type(a, 0))
            if b == 4 { 0 } else if b >= 1 and b <= 3 { b } else { 4 }
        },
        ~> 0,
    }
    return diag_fill(st_diag + k.i32(), sub, i, x, y)
}

/// Diagnostic `i`'s template `sub` of string `id`, its holes filled.
fn diag_fill(id: I32, sub: I32, i: I32, x: Str, y: Str) Str {
    let j = st_ready()[id]
    let text = st_table.text
    for (0 ..< sub) |s| {
        while (text.get(j) != 31) { j += 1 }
        j += 1
    }
    let out = ""
    let run = j
    while (text.get(j) != 0 and text.get(j) != 31) {
        let h = text.get(j)
        if h > 10 and h < 31 {
            out = out + text.slice(run, j) + diag_hole(h, i, x, y)
            run = j + 1
        }
        j += 1
    }
    return out + text.slice(run, j)
}

/// What a diagnostic template's hole says (see @st_hole for the names).
fn diag_hole(h: I32, i: I32, x: Str, y: Str) Str {
    let a = diag_a[i]
    let b = diag_b[i]
    let c = diag_c[i]
    return match h {
        11 => word_text(diag_word[i]),
        12 => did_you_mean(i),
        13 => type_text(a),
        14 => type_text(b),
        15 => int_text(a),
        16 => int_text(b),
        17 => int_text(c),
        18 => word_text(a),
        19 => word_text(b),
        20 => word_text(c),
        21 => word_text(decl_name[a]),
        22 => word_text(decl_name[b]),
        23 => decl_text(a),
        24 => decl_text(b),
        25 => decl_text(c),
        26 => node_text(diag_node[i]),
        27 => mem_word(diag_word[i]),
        28 => x,
        29 => y,
        ~> diag_name(Diag(diag_kind[i])),
    }
}

/// Each kind's messages, by the `sub` @diag_text picks. Holes: `{w}` the
/// word; `{dym}` "; did you mean …?"; `{ta}`, `{tb}` the types a and b;
/// `{ia}`, `{ib}`, `{ic}` the numbers a, b, c; `{wa}`, `{wb}`, `{wc}` the
/// words a, b, c; `{na}`, `{nb}` the names of declarations a and b; `{da}`,
/// `{db}`, `{dc}` declarations a, b, c as written; `{node}` the node's
/// source; `{mem}` mem or vec; `{x}`, `{y}` what @diag_text says; `{kind}`
/// the kind's own name.
fn diag_text_src(k: Diag) Array[Str] {
    return match k {
        Diag.UnknownVariable => ["Unknown variable {w}{dym}", "Unknown function {w}{dym}", "main is the entry point, not a function: move its body into a fn"],
        Diag.UnknownType => ["Unknown type {w}{dym}"],
        Diag.UnknownImport => ["Unknown platform import: {x}", "No file {x} ({y})"],
        Diag.ImportCycle => ["Import cycle detected at: {x}"],
        Diag.UnknownModule => ["Unknown module {w}{dym}", "Unknown module {w}{dym}; the file defines {x}"],
        Diag.DuplicateDeclaration => ["Duplicate method {node}", "Duplicate capture {w}", "Duplicate protocol {w}", "Duplicate local {w}: already a parameter",
            "${w} twice: bind it once, then write {w}", "Duplicate parameter {w}", "Duplicate variant {w}", "Duplicate local {w}", "Duplicate declaration {w}"],
        Diag.MemTwice => ["Duplicate {mem} {w}"],
        Diag.MemClash => ["{mem} {w} clashes with a function or global"],
        Diag.DuplicatePattern => ["Duplicate arm {x}: never runs", "Duplicate pattern {x}"],
        Diag.TupleLet => ["let .{…} needs a tuple, got {ta}", "A closure cannot capture tuple {w}", "{w} would hold tuple {ta}: name its values with let .{…}", "Tuple {ta} has {x} values"],
        Diag.NotNullable => ["{w} is {ta}, which is never null", "It is {ta}, which is never null", "Expected nullable, got {ta}"],
        Diag.UnknownMethod => ["No method {x}.{w}", "{ta}.{w} is a function, not a method: {ta}.{w}(value)", "No method {ta}.{w}{dym}", "No method {wc}.{w}", "No method {w}"],
        Diag.UnknownOperator => ["No operator for an unknown type", "No {x} for {ta}"],
        Diag.WrongArity => ["{w} takes {ia}, given {ib}", "Takes {ia}, given {ib}"],
        Diag.AssignmentToImmutable => ["Cannot assign to capture {w}", "{w} is immutable"],
        Diag.DuplicateField => ["Duplicate field {w}"],
        Diag.InvalidNullableType => ["{w} cannot be nullable"],
        Diag.BareNull => ["null needs a nullable type"],
        Diag.TupleMisplaced => ["Tuple inside a tuple", "A closure cannot return a tuple", "Tuple in an array", "A tuple is only a function result"],
        Diag.FunInField => ["{x} cannot be stored; use cl{y}"],
        Diag.InvalidGlobalInitializer => ["return in the initializer of global {w}"],
        Diag.RecursiveType => ["{w} contains itself; make the field nullable"],
        Diag.IntegerOutOfRange => ["{w} does not fit {ta}", "{node} does not fit {ta}", "{w} does not fit a byte", "{node} does not fit a byte"],
        Diag.InvalidDistinct => ["distinct wraps I32, U32, I64, U64, F32, or F64"],
        Diag.EnumValueRange => ["{wb} does not fit {wc}"],
        Diag.EnumValueTwice => ["{wa}.{w} and .{wb} are both {wc}"],
        Diag.UnknownField => ["{da} has no field {w}{dym}", "No field {w}{dym}"],
        Diag.MissingField => ["{da} needs a value for {w}", "Missing field {w}"],
        Diag.NullableAccess => ["{ta} may be null", ".{w} on nullable {ta}"],
        Diag.MemIndex => ["{mem} {w} takes one index"],
        Diag.ConstMem => ["{mem} {w} is const: no {wa}", "{mem} {w} is const"],
        Diag.MemNotValue => ["{mem} {w} is not a value: {w}[i]"],
        Diag.MemKind => ["{mem} {w} cannot store {x}"],
        Diag.NonDefaultable => ["{ta} has no default: Array[{ta}].new(n, fill)"],
        Diag.InvalidModuleArity => ["{w} takes {ia} type arguments, given {ib}"],
        Diag.NotCallable => ["{w} is {x}, not a function", "{ta} is not callable"],
        Diag.NonExhaustive => ["match misses true", "match misses false", "match misses {tb}.{w}", "alt misses {tb}.{w}", "match over {tb} needs a default arm"],
        Diag.MatchType => ["match takes a number or Bool, not {ta}", "match takes a number or Bool, not {ta}; use alt for enum variants"],
        Diag.MatchPattern => ["{x} is not a Bool", "{x} cannot match {tb}", "{x} is out of range for {tb}"],
        Diag.UnknownVariant => ["{ta} has no variant {w}{dym}"],
        Diag.InvalidForSource => ["A generator loop binds one value",
            "for over {ib} source binds {ib} value, got {ic}", "for over {ib} source binds {ib} value, got {ic}; for an index add a range: (xs, 0 ..< n)",
            "for over {ib} sources bind {ib} values, got {ic}", "for over {ib} sources bind {ib} values, got {ic}; for an index add a range: (xs, 0 ..< n)",
            "for needs an array or range, not {tb}"],
        Diag.UnknownForeignMember => ["No member {x}.{wc}{w}"],
        Diag.ForeignReadonly => ["{w} is readonly"],
        Diag.ForeignRecordField => ["No property {w}"],
        Diag.ForeignRecordMissing => ["Missing property {w}"],
        Diag.DslError => ["{w}"],
        Diag.WatPlace => ["@wat must be a function's whole body"],
        Diag.AwaitInClosure => ["A function the host calls cannot await", "A closure the host calls cannot await"],
        Diag.AwaitInGlobal => ["A global's initializer cannot await"],
        Diag.GenericGlobal => ["A global of generic {na} cannot use {w}"],
        Diag.InvalidEscape => ["Lone surrogate", "Unknown escape {w}", "Not UTF-8", "\\u needs four hex digits"],
        Diag.EntrySurface => ["Two lib blocks", "Two mains", "lib and main together: a program is one or the other"],
        Diag.StorageType => ["{w} is a storage type: use I32"],
        Diag.ReturnValueFromVoid => ["This closure returns Void", "main returns Void", "A test returns nothing", "{w} returns Void"],
        Diag.VoidLet => ["{w} would hold no value"],
        Diag.ComptimeTrap => ["@comptime {w} trapped: {x}"],
        Diag.FloatOutOfRange => ["-{node} does not fit {ta}", "{node} does not fit {ta}"],
        Diag.EnumBase => ["enum({w}) is not an integer enum; use U8, I8, U16, I16, I32, or U32"],
        Diag.TagEnumValue => ["{wa}.{w} has a value; only an integer enum's variants do"],
        Diag.ProtoGeneric => ["A generic type cannot list protocol {w}"],
        Diag.SelfUntyped => ["{w} needs a type annotation to call itself"],
        Diag.MemberClash => ["{na}.{w} is already a protocol member", "{na}.{w} is both a field and a method"],
        Diag.VariantNotValue => ["{na}.{w} is a type, not a value"],
        Diag.ProtoAccess => ["{nb}.{w} is set-only", "{nb}.{w} is get-only"],
        Diag.ProtoPairType => ["{x}.{w} gets {ta} but sets {tb}"],
        Diag.AmbiguousName => ["{w} is ambiguous: {x}.{w} or {y}.{w}"],
        Diag.StandardName => ["{w} is a standard type"],
        Diag.InstanceDepth => ["{w}'s instances nest more than {ia} deep"],
        Diag.MainParams => ["main takes no parameters"],
        Diag.ReturnInBench => ["return in a bench"],
        Diag.TestInGeneric => ["Bench in generic mod {w}", "Test in generic mod {w}"],
        Diag.TestName => ["Empty test name", "Empty bench name", "Duplicate test \"{w}\"", "Duplicate bench \"{w}\"", "Duplicate test {node}", "Duplicate bench {node}"],
        Diag.TooManyParams => ["main has {ia} parameters (max 1000)", "{w} has {ia} parameters (max 1000)"],
        Diag.DslEmpty => ["@{w} needs a file path", "@{w} needs an expression"],
        Diag.ComptimeCycle => ["@comptime {w} reads itself", "@comptime {w} reads {na}, which waits on it"],
        Diag.DslTooDeep => ["DSLs nested too deeply (max {ia})"],
        Diag.StdOwnStruct => ["{ta} is made by its own functions"],
        Diag.TryNotResult => ["try needs a Result, not {ta}"],
        Diag.TryPlace => ["try in a generator", "try needs a function returning a Result", "try in a function returning {tb}, not a Result",
            "errdefer in a generator", "errdefer needs a function returning a Result", "errdefer in a function returning {tb}, not a Result"],
        Diag.TryErrorMismatch => ["try passes on {ta}; the function's errors are {tb}"],
        Diag.ImportNotModule => ["{w} is {x}; using imports a mod"],
        Diag.ModNoType => ["{w} is a mod with no type &", "{w} names mod {na}, which has no type &"],
        Diag.UsingTwice => ["{w}{x} is open already"],
        Diag.ModNameCase => ["{w} promotes a type: a mod promoting a type is capitalized", "{w} promotes a function: a mod promoting a function is lowercase"],
        Diag.PromotedFn => ["fn & outside a mod: & is a mod's", "A mod's & is a type or a function, not both", "{w} has no fn &(…)"],
        Diag.AmbiguousMethod => ["{w} is both {x}'s and {y}'s"],
        Diag.ImplNothing => ["{da}'s instances implement {db} together: fn {db}[&].{w} in {da}"],
        Diag.WutuHole => ["A hole needs a value: this gives none", "{ta} is not a Component (a hole shows text, a number, a Bool, an element, or a Component)"],
        Diag.WutuKey => ["A key is text or a number, not {ta}"],
        Diag.WatHost => ["@wat needs an assembler"],
        Diag.HostAltArm => ["Each arm must name a class"],
        Diag.HostAltClass => ["{x}.{w} is only a type"],
        Diag.ForeignNotArray => ["{ta} is not an array"],
        Diag.ForeignOverload => ["No overload takes {ia}"],
        Diag.PruneInClosure => ["prune in a closure"],
        Diag.GeneratorMethod => ["A method cannot be a generator"],
        Diag.UnknownLabel => ["break takes no value", "break cannot leave a closure", "No block labeled {w} around this break"],
        Diag.GlobalCycle => ["Global {w} is read while it is being set", "Globals {w} and {na} each need the other set first"],
        Diag.NotValue => ["{w} is a field: read it from a value", "{w} is a module, not a value", "{w} is a type, not a value"],
        Diag.NotAssignable => ["Only a variable, field, or index can be assigned"],
        Diag.IrUnknown => ["@ir names no parameter {w}", "@ir <{w}> is written wrong here", "No @ir type-repr {w}",
            "@ir array element {w} is not its mod's parameter or a standard type", "No @ir element <{w}>"],
        Diag.IrInvalid => ["@ir in {w} does not make valid Wasm: {wa}"],
        Diag.IrType => ["@ir gives an i32, not a comparison's {ta}", "@ir gives {x}, not {ta}", "@ir <{w}> takes {x}, given {y}"],
        Diag.CallbackArity => ["Callback takes {ia} parameters; JS passes {ib}"],
        Diag.StreamPromise => ["A stream's values are awaited as they are read: use Stream[{x}], not Stream[{ta}]"],
        Diag.TupleIndex => ["{ta} has no element {ib}: it has {x}", "{ta} takes a constant index: its elements differ in type"],
        Diag.HostLiteral => ["{w} is a string enum: it takes its members, not {wa}", "{w} takes its values, not any Str", "{w} has no value {wa}"],
        Diag.TupleLength => ["{ta} takes {x}, given {ib}"],
        Diag.HostAbstract => ["{ta} is abstract: make one of a class that extends it"],
        Diag.AmbiguousVariant => ["{w} is a variant of {na} and of {nb}: write {na}.{w} or {nb}.{w}"],
        Diag.EsNative => ["{w} gets a JS function: that is a cl, not {ta}"],
        Diag.ExportFun => ["{w}: argument {ib} comes from JS, which gives a cl, not {ta}"],
        Diag.TemplateValue => ["{w} has a $ type: call it, or name its types (let g: fun(I32) Str = {w})"],
        Diag.YieldPlace => ["yield T is only a generator's result type"],
        Diag.NotStruct => ["{ta} is not a struct: it has no fields to set"],
        Diag.NewNotHost => ["new makes host objects; {w} is not a host class"],
        Diag.GeneratorExport => ["{w} is a generator: it expands into each for that reads it, so it cannot be exported"],
        Diag.HostMissing => ["No Node module {w}{dym}", "No ABI in {w}: missing, or not one tools/dts/cli.mjs wrote", "No declarations for {w}; is it installed?"],
        Diag.PruneOutside => ["prune outside a recursive generator loop"],
        Diag.GeneratorPassThrough => ["{w} passes its values straight through"],
        Diag.GeneratorArity => ["{w} takes {ia}, given {ib}"],
        Diag.GeneratorRecursion => ["Generator {w} recurses"],
        Diag.YieldOutside => ["yield outside a generator"],
        Diag.YieldInClosure => ["yield in a closure"],
        Diag.GeneratorReturnValue => ["A generator returns no value"],
        Diag.GeneratorCall => ["{w} is a generator: for ({w}(…)) |v| { … }"],
        Diag.AwaitForSource => ["await for reads a stream, not {tb}: use a plain for", "await for needs a generator call or a stream"],
        Diag.AwaitForCapture => ["A stream loop binds one value"],
        Diag.IteratorUnfinished => ["Unfinished pipeline: {w}"],
        Diag.IteratorCaptures => ["{w} takes exactly {ia} names", "{w} takes {ia} name and an optional index", "{w} takes {ia} names and an optional index"],
        Diag.OptionalOutsideStatement => ["?. only in a statement"],
        Diag.AwaitNotPromise => ["Cannot await {ta}"],
        Diag.ProtoMissing => ["{da} lacks {wc}.{w}"],
        Diag.ProtoSignature => ["{wa}[{wb}].{w} does not match the protocol", "{wa}[{wb}].{w} does not match the protocol: wants {x}"],
        Diag.MemElementRange => ["{wc} is no {x}", "{wc} does not fit {x}"],
        Diag.MemInitializer => ["{mem} {w} takes a list, @embed, or @comptime", "{mem} {w} takes a list, @embed, or @comptime: [{node}]", "{mem} {w}: numbers only"],
        Diag.MemEmbed => ["{x} is {ia} bytes, not a whole number of {ib}-byte {y}s", "@embed cannot read {x}"],
        Diag.MemView => ["view() needs using JS from std:JS"],
        Diag.MemNoMethod => ["{x} {y} has no method {w}"],
        Diag.InternNotBytes => ["Only U8 and I8 {mem}s intern"],
        Diag.TooManyMems => ["Too many mems (max {x}): make {w} a vec"],
        Diag.VecHost => ["The host cannot see vec {x}: make it a mem"],
        Diag.InvalidDslUsage => ["@es needs a typed let"],
        Diag.ParseError => ["{wc}", "Unclosed string", "Unclosed template string", "Not UTF-8",
            "No \\/ ends this body: the /\\ at line {x} opens another", "No \\/ ends this body",
            "Expected ';', got {x} (a \\\\ line's ';' is text)", "Expected {wb}, got {x}", "Unexpected end of file",
            "Unexpected {x}: a {y} goes at the top level of a file", "Unexpected {x}"],
        Diag.Unsupported => ["Not supported yet"],
        Diag.UnknownMember => ["{wc} has no member {w}"],
        Diag.DslPlace => ["@{w} only fills a mem", "@ir body is empty or not well-formed IR", "No DSL @{w}"],
        Diag.AltNotEnum => ["alt on nullable {x}", "alt on {ta}", "alt needs an enum"],
        Diag.IteratorSource => ["A pipeline binds looser than {w}: its source is all of this", "bisect takes a range of I32, not {ta}", "{w} needs numbers, not {ta}",
            "Cannot pipe a range of {ta}", "bisect must be the whole pipeline", "flat_map body gives {ta}, not an array", "{w} takes an array, not {ta}",
            "Cannot pipe {ta}", "Cannot pipe this"],
        Diag.IteratorTerminalInside => ["Nothing can follow {w}"],
        Diag.ClosureParamType => ["{w} needs a type"],
        Diag.ImplicitStructInit => ["&{…} needs a struct type, not {ta}", "&{…} needs a struct type"],
        Diag.LazyValue => ["{w} returns {ta}, not an element", "{w} takes {ta}, which cannot cross into a lazy module"],
        Diag.BoundMissing => ["{ta} does not implement {x} ({y}'s {dc} needs it)", "{w} does not implement {x} ({y}'s {dc} needs it)"],
        Diag.UnboundedCall => ["{da} has no method {w}; bound it: {x}"],
        Diag.BoundNotProto => ["{x} is an integer enum; it lists no protocols", "{x} is not a protocol; a struct lists protocols",
            "{x} is not a protocol; an enum lists protocols", "{x} is not a protocol", "{x} is not a protocol; a bound names one"],
        Diag.ProtoNoMember => ["{da} has no member {w}"],
        Diag.ProtoSelfDynamic => ["{ta}.{w} uses &, so only a bounded T calls it: mod M[T[{ta}]]"],
        Diag.InvalidDirective => ["Unknown directive #{w}", "#{w} takes no argument", "{node}: a cache holds 0 (no bound) or a power of 2 entries", "#inline and #noinline contradict each other", "Duplicate directive #{w}"],
        ~> ["{kind}"],
    }
}

/// A token as an error names it: a name, number, or symbol as written (a
/// long one cut short), and what the others are.
fn found_text(t: I32) Str {
    let kind = tok_kind[t]
    if kind == Tok.End.i32() { return dgs(Dgt.TheEndOfTheFile) }
    if kind == Tok.String.i32() or kind == Tok.MultilineLine.i32() { return "a string" }
    if kind == Tok.DslBody.i32() { return dgs(Dgt.ADSLBody) }
    // The lexer stops before a character it does not know: that character.
    if kind == Tok.Error.i32() {
        let b = src[tok_start[t]]
        let n = if b >= 240 { 4 } else if b >= 224 { 3 } else if b >= 192 { 2 } else { 1 }
        return dgs1(Dgt.Character, bytes_text(tok_start[t], tok_start[t] + n))
    }
    let text = bytes_text(tok_start[t], tok_end[t])
    if text.len() > 24 { return dgs1(Dgt.TickAEllipsisTick, text.slice(0, 24)) }
    return dgs1(Dgt.TickATick, text)
}

/// Whether extra row k of diagnostic i is a place (a label on its own span,
/// or another node), not a note or a fix.
fn is_place(i: I32, k: I32) Bool {
    let kind = extra_kind[diag_extra[i] + k]
    return kind != Extra.Note.i32() and kind != Extra.Fix.i32()
}

/// What hangs off a diagnostic's own span when its report gave no label:
/// the shortest true thing about it, from what was reported. One of its
/// kind's labels (@diag_label_src), as @diag_text picks a message.
fn diag_default_label(i: I32) Str {
    let k = Diag(diag_kind[i])
    let a = diag_a[i]
    let b = diag_b[i]
    let c = diag_c[i]
    let x = ""
    let sub = match k {
        Diag.TypeMismatch => if b >= 0 { 0 } else { 1 },
        Diag.UnknownOperator => if a >= 0 { 0 } else { 1 },
        Diag.WrongArity => if named_word(diag_word[i]) { 0 } else { 1 },
        Diag.DuplicateDeclaration => if a == 7 { 0 } else { 1 },
        Diag.NonExhaustive => if a == 2 or a == 3 { 0 } else { 1 },
        Diag.IntegerOutOfRange => if a >= 0 { 0 } else { 1 },
        Diag.ParseError => if b >= 0 and comptime_parse_site(i) < 0 { 0 } else { 1 },
        Diag.ComptimeCycle => if a >= 0 and decl_name[a] != diag_word[i] { 0 } else { 1 },
        Diag.TryPlace => if a >= 2 { 0 } else { 1 },
        Diag.ProtoAccess => if a == 1 { 0 } else { 1 },
        Diag.MemberClash => if b == 1 { 0 } else { 1 },
        Diag.UnknownLabel => if a == 2 { 0 } else if a == 1 { 1 } else { 2 },
        Diag.GlobalCycle => if a < 0 { 0 } else { 1 },
        Diag.IrUnknown => if a == 2 { 0 } else { 1 },
        Diag.IrType => {
            if c != 1 { x = vt_text(b) }
            if c == 1 { 0 } else { 1 }
        },
        Diag.TupleIndex => if b >= 0 { 0 } else { 1 },
        Diag.HostLiteral => if c == 1 { 0 } else if c == 2 { 1 } else { 2 },
        Diag.PromotedFn => if a == 2 { 0 } else { 1 },
        Diag.ModNameCase => if a == 0 { 0 } else { 1 },
        Diag.InvalidDirective => a,
        ~> 0,
    }
    return diag_fill(st_label + k.i32(), sub, i, x, x)
}

/// Each kind's labels, by the `sub` @diag_default_label picks (holes as in @diag_text_src).
fn diag_label_src(k: Diag) Array[Str] {
    return match k {
        Diag.TypeMismatch => ["{tb}", "wrong type"],
        Diag.NotNullable => ["never null"],
        Diag.NullableAccess => ["may be null"],
        Diag.UnknownVariable => ["not defined"],
        Diag.UnknownType => ["no such type"],
        Diag.UnknownModule => ["no such module"],
        Diag.UnknownMethod => ["no such method"],
        Diag.UnknownMember => ["no such member"],
        Diag.UnknownField => ["no such field"],
        Diag.UnknownVariant => ["no such variant"],
        Diag.UnknownOperator => ["{ta}", "here"],
        Diag.WrongArity => ["given {ib}", "takes {ia}, given {ib}"],
        Diag.MissingField => ["{w}?"],
        Diag.DuplicateDeclaration => ["already listed", "already declared"],
        Diag.AmbiguousName => ["ambiguous"],
        Diag.StandardName => ["a prelude name"],
        Diag.InstanceDepth => ["one more level"],
        Diag.DuplicateField => ["already given"],
        Diag.DuplicatePattern => ["already matched"],
        Diag.AssignmentToImmutable => ["cannot be assigned"],
        Diag.NonExhaustive => ["no {w}", "no ~>"],
        Diag.IntegerOutOfRange => ["{ta}", "out of range"],
        Diag.FloatOutOfRange => ["{ta}"],
        Diag.EnumBase => ["not U8, I8, U16, I16, I32, or U32"],
        Diag.TagEnumValue => ["no value here"],
        Diag.BareNull => ["no type"],
        Diag.NotCallable => ["not a function"],
        Diag.ParseError => ["{wb}?", "unexpected"],
        Diag.DslEmpty => ["empty"],
        Diag.ComptimeCycle => ["waits on {na}", "waits on itself"],
        Diag.DslTooDeep => ["too deep"],
        Diag.TryNotResult => ["{ta}"],
        Diag.TryErrorMismatch => ["{ta} errors"],
        Diag.TryPlace => ["in a generator", "no Result to return"],
        Diag.StdOwnStruct => ["use its functions"],
        Diag.UsingTwice => ["needs |alias|"],
        Diag.AmbiguousMethod => ["as which protocol?"],
        Diag.ImplNothing => ["an instance"],
        Diag.ProtoNoMember => ["not in {da}"],
        Diag.ProtoGeneric => ["on a generic type"],
        Diag.SelfUntyped => ["type not known yet"],
        Diag.ProtoAccess => ["set-only", "get-only"],
        Diag.ProtoPairType => ["one type for get and set"],
        Diag.MemberClash => ["also in the protocol", "also a field"],
        Diag.VariantNotValue => ["make one: {na}.{w} {…}"],
        Diag.UnknownLabel => ["block {w} is outside the closure", "a value, not a label", "no such label"],
        Diag.GlobalCycle => ["reads {w}", "needs {na}"],
        Diag.NotValue => ["not a value"],
        Diag.NotAssignable => ["not a variable"],
        Diag.IrUnknown => ["malformed", "unknown"],
        Diag.IrInvalid => ["unchecked"],
        Diag.IrType => ["not {ta}", "{x}"],
        Diag.CallbackArity => ["JS passes {ib}"],
        Diag.StreamPromise => ["values awaited"],
        Diag.TupleIndex => ["past its end", "not a constant"],
        Diag.HostLiteral => ["a string", "any Str", "not one of its values"],
        Diag.TupleLength => ["{ib} elements"],
        Diag.HostAbstract => ["abstract"],
        Diag.AmbiguousVariant => ["ambiguous"],
        Diag.EsNative => ["a cl"],
        Diag.ExportFun => ["a cl"],
        Diag.TemplateValue => ["which types?"],
        Diag.YieldPlace => ["not a type here"],
        Diag.NotStruct => ["no fields"],
        Diag.NewNotHost => ["not a host class"],
        Diag.GeneratorExport => ["a generator"],
        Diag.HostMissing => ["not found"],
        Diag.ImportNotModule => ["not a mod"],
        Diag.ModNoType => ["a mod, not a type"],
        Diag.PromotedFn => ["no fn &", "&"],
        Diag.ModNameCase => ["capitalize it", "lowercase it"],
        Diag.WutuHole => ["{ta}"],
        Diag.WutuKey => ["{ta}"],
        Diag.GenericGlobal => ["differs per instance"],
        Diag.ReturnInBench => ["would end the timing"],
        Diag.TestInGeneric => ["runs in no instance"],
        Diag.InvalidDirective => ["unknown", "no argument", "not a power of 2", "contradicts", "given already"],
        ~> ["here"],
    }
}

/// The span a diagnostic points at: its node's, as byte offsets.
fn diag_start(i: I32) I32 {
    if comptime_parse_site(i) >= 0 { return comptime_byte(comptime_parse_site(i), tok_start[diag_a[i]]) }
    if diag_kind[i] == Diag.ParseError.i32() { return tok_start[diag_a[i]] }
    if diag_kind[i] == Diag.DslError.i32() { return diag_a[i] }
    let f = located_file(i)
    if f >= 0 { return dsl_file_from[f] }
    let node = diag_at(i)
    if node < 0 { return -1 }
    return tok_start[node_first[node]]
}

/// Where a diagnostic's span ends (see @diag_start).
fn diag_end(i: I32) I32 {
    if comptime_parse_site(i) >= 0 { return comptime_byte(comptime_parse_site(i), tok_end[diag_a[i]]) }
    if diag_kind[i] == Diag.ParseError.i32() { return tok_end[diag_a[i]] }
    if diag_kind[i] == Diag.DslError.i32() { return diag_b[i] }
    let f = located_file(i)
    if f >= 0 { return dsl_file_to[f] }
    let node = diag_at(i)
    if node < 0 { return -1 }
    return tok_end[node_last[node] - 1]
}

/// The generated file of located code a diagnostic is in, or -1.
fn located_file(i: I32) I32 {
    let node = diag_node[i]
    if node < 0 or comptime_site(i) >= 0 { return -1 }
    let file = file_of_token(node_first[node])
    return if file < dsl_file_from.len() and dsl_file_from[file] >= 0 { file } else { -1 }
}

/// The node a diagnostic points at: its own, or the `@comptime` expression
/// it is in, or the DSL site whose generated code it is in.
fn diag_at(i: I32) I32 {
    let k = comptime_site(i)
    if k >= 0 { return comptime_text_node[k] }
    let node = diag_node[i]
    // Code a DSL generated: its site.
    if node >= 0 {
        let site = dsl_site_of(node)
        if site >= 0 { return site }
    }
    return node
}

/// The file a diagnostic is in, or -1.
fn diag_file(i: I32) I32 {
    let node = diag_at(i)
    if node < 0 {
        let k = comptime_parse_site(i)
        if k >= 0 { return file_of_token(node_first[comptime_text_node[k]]) }
        if diag_kind[i] == Diag.ParseError.i32() { return diag_word[i] }
        return -1
    }
    return file_of_token(node_first[node])
}

//! == Text
//!
//! This file's strings and templates, in the string table (strtab.utu).

enum(U8) Dgt:
    | QA
    | DotBraceABraceEnd
    | ABCloseSpaceC
    | BracketABracketEnd
    | ABDotC
    | ABracketBBracketEnd
    | ExpectedGotAnotherTypeOfThat
    | ExpectedGot
    | ACommaSpace
    | ComptimeTakesOneExpression
    | ComptimeLine
    | AnArrayOf
    | Character
    | TickAEllipsisTick
    | TickATick
    | Fun
    | BracketCommaBracketEnd
    | BracketBracketEndEq
    | Uint8Array
    | Int8Array
    | Uint16Array
    | Int16Array
    | Int32Array
    | Uint32Array
    | BigInt64Array
    | BigUint64Array
    | Float32Array
    | Float64Array
    | TypeMismatch
    | NotCallable
    | Nothing
    | Eqref
    | I8
    | I16
    | I31ref
    | Externref
    | AStruct
    | AReference
    | AFunction
    | AnEnum
    | AProtocol
    | AGlobal
    | U8
    | I82
    | U16
    | I162
    | UnwrapWithPromote
    | UseMatch
    | UseIf
    | UnwrapWithPromoteOrOrelse
    | UseARange0N
    | A
    | E
    | O
    | ELc
    | OLc
    | U
    | An
    | ALc
    | BreakOutsideALoop
    | ContinueOutsideALoop
    | ContinueWithAStateOnlyWorks
    | ContinueNeedsTheNextState
    | BreakInDefer
    | ContinueInDefer
    | ReturnInDefer
    | TryInDefer
    | DeferMustBeAStatement
    | Str
    | GetIndex
    | SetIndex
    | Embed
    | AbiJson
    | TickSemiTick
    | Mem
    | Vec
    | Comptime
    | Ir
    | TheEndOfTheFile
    | ADSLBody

fn dgs_src(t: Dgt) Str {
    return match t {
        Dgt.QA => "?{0}",
        Dgt.DotBraceABraceEnd => ".{{0}}",
        Dgt.ABCloseSpaceC => "{0}{1}) {2}",
        Dgt.BracketABracketEnd => "[{0}]",
        Dgt.ABDotC => "{0}{1}.{2}",
        Dgt.ABracketBBracketEnd => "{0}[{1}]",
        Dgt.ExpectedGotAnotherTypeOfThat => "Expected {0}, got {1} (another type of that name)",
        Dgt.ExpectedGot => "Expected {0}, got {1}",
        Dgt.ACommaSpace => "{0}, ",
        Dgt.ComptimeTakesOneExpression => "@comptime takes one expression: {0}",
        Dgt.ComptimeLine => "@comptime: {0} (line {1})",
        Dgt.AnArrayOf => "an array of {0}",
        Dgt.Character => "character '{0}'",
        Dgt.TickAEllipsisTick => "'{0}…'",
        Dgt.TickATick => "'{0}'",
        Dgt.Fun => "fun(",
        Dgt.BracketCommaBracketEnd => "[,]",
        Dgt.BracketBracketEndEq => "[]=",
        Dgt.Uint8Array => "Uint8Array",
        Dgt.Int8Array => "Int8Array",
        Dgt.Uint16Array => "Uint16Array",
        Dgt.Int16Array => "Int16Array",
        Dgt.Int32Array => "Int32Array",
        Dgt.Uint32Array => "Uint32Array",
        Dgt.BigInt64Array => "BigInt64Array",
        Dgt.BigUint64Array => "BigUint64Array",
        Dgt.Float32Array => "Float32Array",
        Dgt.Float64Array => "Float64Array",
        Dgt.TypeMismatch => "type-mismatch",
        Dgt.NotCallable => "not-callable",
        Dgt.Nothing => "nothing",
        Dgt.Eqref => "eqref",
        Dgt.I8 => "i8",
        Dgt.I16 => "i16",
        Dgt.I31ref => "i31ref",
        Dgt.Externref => "externref",
        Dgt.AStruct => "a struct",
        Dgt.AReference => "a reference",
        Dgt.AFunction => "a function",
        Dgt.AnEnum => "an enum",
        Dgt.AProtocol => "a protocol",
        Dgt.AGlobal => "a global",
        Dgt.U8 => "U8",
        Dgt.I82 => "I8",
        Dgt.U16 => "U16",
        Dgt.I162 => "I16",
        Dgt.UnwrapWithPromote => "Unwrap with promote",
        Dgt.UseMatch => "Use match",
        Dgt.UseIf => "Use if",
        Dgt.UnwrapWithPromoteOrOrelse => "Unwrap with promote or orelse",
        Dgt.UseARange0N => "Use a range: 0 ..< n",
        Dgt.A => "A",
        Dgt.E => "E",
        Dgt.O => "O",
        Dgt.ELc => "e",
        Dgt.OLc => "o",
        Dgt.U => "u",
        Dgt.An => "an ",
        Dgt.ALc => "a ",
        Dgt.BreakOutsideALoop => "break outside a loop",
        Dgt.ContinueOutsideALoop => "continue outside a loop",
        Dgt.ContinueWithAStateOnlyWorks => "continue with a state only works inside loop match",
        Dgt.ContinueNeedsTheNextState => "continue needs the next state",
        Dgt.BreakInDefer => "break in defer",
        Dgt.ContinueInDefer => "continue in defer",
        Dgt.ReturnInDefer => "return in defer",
        Dgt.TryInDefer => "try in defer",
        Dgt.DeferMustBeAStatement => "defer must be a statement",
        Dgt.Str => "str",
        Dgt.GetIndex => "get_index",
        Dgt.SetIndex => "set_index",
        Dgt.Embed => "embed",
        Dgt.AbiJson => ".abi.json",
        Dgt.TickSemiTick => "';'",
        Dgt.Mem => "'mem'",
        Dgt.Vec => "'vec'",
        Dgt.Comptime => "comptime",
        Dgt.Ir => "ir",
        Dgt.TheEndOfTheFile => "the end of the file",
        Dgt.ADSLBody => "a DSL body",
    }
}

fn dgs(t: Dgt) Str => st(st_dg + t.i32())
fn dgs1(t: Dgt, a: Str) Str => stf(st_dg + t.i32(), a, "", "", "")
fn dgs2(t: Dgt, a: Str, b: Str) Str => stf(st_dg + t.i32(), a, b, "", "")
fn dgs3(t: Dgt, a: Str, b: Str, c: Str) Str => stf(st_dg + t.i32(), a, b, c, "")
