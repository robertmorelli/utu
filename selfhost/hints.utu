//! = Hints
//!
//! What a diagnostic adds to its message: the name that was likely meant
//! (did you mean), and the other places it is about. A suggestion is a fix
//! (see `diag_fix`): the misspelled name's bytes become the meant one, and
//! the message ends "; did you mean …?".

/// A byte, lowercased.
fn lower_byte(b: I32) I32 => if b >= 65 and b <= 90 { b + 32 } else { b }

/// How far apart two words are: insertions, deletions, changes, and swaps
/// of two neighbors, one each; a change of case alone costs nothing. Past
/// `bound`, some distance past it (a file of many unknown names weighs each
/// against every name in scope, so most must be cut short).
fn word_distance(a: I32, b: I32, bound: I32) I32 {
    let sa = src.interned_start(a)
    let na = src.interned_size(a)
    let sb = src.interned_start(b)
    let nb = src.interned_size(b)
    if na - nb > bound or nb - na > bound { return bound + 1 }
    let w = nb + 1
    // Three rows of the table: two back, one back, this one.
    let d = Array[I32].new(3 * w, 0)
    for (0 ..< w) |j| { d[w + j] = j }
    // The least of the last row and the one before: once both are past
    // `bound`, every later one is (a swap reaches two rows back).
    let low1 = 0
    for (1 ..< na + 1) |i| {
        let row = (i + 1) % 3
        let up = i % 3
        let up2 = (i + 2) % 3
        d[row * w] = i
        let low = i
        for (1 ..< nb + 1) |j| {
            let x = lower_byte(src[sa + i - 1])
            let y = lower_byte(src[sb + j - 1])
            let cost = if x == y { 0 } else { 1 }
            let best = d[up * w + j - 1] + cost
            if d[up * w + j] + 1 < best { best = d[up * w + j] + 1 }
            if d[row * w + j - 1] + 1 < best { best = d[row * w + j - 1] + 1 }
            if i > 1 and j > 1 and x == lower_byte(src[sb + j - 2]) and lower_byte(src[sa + i - 2]) == y and d[up2 * w + j - 2] + 1 < best {
                best = d[up2 * w + j - 2] + 1
            }
            d[row * w + j] = best
            if best < low { low = best }
        }
        if low > bound and low1 > bound { return bound + 1 }
        low1 = low
    }
    return d[((na + 1) % 3) * w + nb]
}

/// The best candidate so far: its word, its distance, its declaration, and
/// whether another word is as close (then none is suggested).
let near_word: I32 = -1
let near_dist: I32 = 0
let near_decl: I32 = -1
let near_tie: I32 = 0
/// A tighter bound on the distance, or -1 (a module's name: one edit).
let near_cap: I32 = -1

/// Start looking for the word nearest `word`.
fn near_start(word: I32) Void {
    near_word = -1
    near_dist = 1 + max_distance(word)
    near_decl = -1
    near_tie = 0
}

/// How far a meant word may be from what was written: one edit in a short
/// word, two in a longer one, three in a long one.
fn max_distance(word: I32) I32 {
    if near_cap >= 0 { return near_cap }
    let n = src.interned_size(word)
    if n < 3 { return 0 }
    if n <= 4 { return 1 }
    if n <= 8 { return 2 }
    return 3
}

/// Weigh candidate `cand` (declared by `decl`, or -1) against `word`.
fn near_consider(word: I32, cand: I32, decl: I32) Void {
    if cand < 0 or cand == word or cand == near_word { return }
    // A name the compiler made (`__…`) is not one to suggest.
    if src.interned_size(cand) > 1 and src[src.interned_start(cand)] == 95 and src[src.interned_start(cand) + 1] == 95 { return }
    // Past the bound or past `max_distance`, no distance changes anything.
    let most = max_distance(word)
    let d = word_distance(word, cand, if near_dist < most { near_dist } else { most })
    if d < near_dist {
        near_word = cand
        near_dist = d
        near_decl = decl
        near_tie = 0
    } else if d == near_dist and d <= max_distance(word) {
        near_tie = 1
    }
}

/// The word of `list` (words between spaces) nearest `word`, or -1.
fn near_in_words(word: I32, list: Str) I32 {
    near_start(word)
    let i = 0
    while (i < list.len()) {
        let end_ = text_index(list, " ", i)
        if end_ < 0 { end_ = list.len() }
        near_consider(word, intern_text(list.slice(i, end_)), -1)
        i = end_ + 1
    }
    return near_found()
}

/// Node's modules (`module.builtinModules`, Node 24, without `_…`).
fn node_modules() Str => hs(Ht.AssertAssertStrictAsyncHooksBuffer)

/// The word found, or -1 when none is close, or two are as close.
fn near_found() I32 {
    if near_tie == 1 { return -1 }
    return near_word
}

/// The names in scope, by what they declare: values (not types), types,
/// or modules.
enum(U8) Seek:
    | Value
    | Type
    | Module

fn seek_fits(decl: I32, seek: Seek) Bool {
    if decl < 0 { return false }
    if seek == Seek.Module { return decl_is(decl, Decl.Module) or decl_is(decl, Decl.Foreign) or decl_is(decl, Decl.Alias) }
    if seek == Seek.Type { return is_type_decl(decl) }
    return not decl_is(decl, Decl.Main) and (not is_type_decl(decl) or decl_is(decl, Decl.Module) or decl_is(decl, Decl.Alias))
}

/// The name in scope nearest `word` that is a `seek`, or -1.
fn near_in_scope(word: I32, seek: Seek) I32 {
    near_cap = if seek == Seek.Module and src.interned_size(word) > 2 { 1 } else { -1 }
    near_start(word)
    let alias = alias_word(word)
    if alias >= 0 and seek_fits(lookup(alias), seek) {
        near_decl = lookup(alias)
        return alias
    }
    for (0 ..< bind_word.len()) |i| {
        let w = bind_word[i]
        if word_top[w] == i and seek_fits(bind_decl[i], seek) { near_consider(word, w, bind_decl[i]) }
    }
    if seek == Seek.Type {
        for ([Narrow.U8, Narrow.I8, Narrow.U16, Narrow.I16]) |n| { near_consider(word, narrow_word(n), -1) }
    }
    near_cap = -1
    return near_found()
}

/// The member of `owner` in `space` nearest `word`, or -1.
fn near_member(owner: I32, word: I32, space: Space) I32 {
    near_start(word)
    if owner < 0 { return -1 }
    let alias = alias_word(word)
    if alias >= 0 and member(owner, alias, space) >= 0 {
        near_decl = member(owner, alias, space)
        return alias
    }
    for (0 ..< member_key.len()) |h| {
        let key = member_key[h]
        if key >= 0 and member_owner[h] == owner and key % 4 == space.i32() { near_consider(word, key / 4, member_decl[h]) }
    }
    return near_found()
}

/// What other languages call a name utu spells another way: its utu word, or -1.
fn alias_word(word: I32) I32 {
    let t = word_text(word)
    let u = match_alias(t)
    return if u.len() == 0 { -1 } else { intern_text(u) }
}

fn match_alias(t: Str) Str {
    if t == "length" or t == hs(Ht.Lenght) or t == hs(Ht.Size) { return "len" }
    if t == "String" or t == "string" { return "Str" }
    if t == "int" { return "I32" }
    if t == hs(Ht.Float) or t == hs(Ht.Double) { return "F64" }
    if t == "bool" or t == "boolean" { return "Bool" }
    if t == hs(Ht.ToUpperCase) or t == hs(Ht.Upper) or t == hs(Ht.ToUpper) { return hs(Ht.ToUpperLc) }
    if t == hs(Ht.ToLowerCase) or t == hs(Ht.Lower) or t == hs(Ht.ToLower) { return hs(Ht.ToLowerLc) }
    if t == hs(Ht.ToString) or t == hs(Ht.ToStringLc) or t == hs(Ht.ToStr) { return "str" }
    // The old conversions: `to_i32` is `i32`.
    if t == hs(Ht.ToI32) or t == hs(Ht.ToU32) or t == hs(Ht.ToI64) or t == hs(Ht.ToU64) or t == hs(Ht.ToF32) or t == hs(Ht.ToF64) { return t.slice(3, t.len()) }
    if t == "append" { return "push" }
    if t == hs(Ht.True) { return "true" }
    if t == hs(Ht.False) { return "false" }
    return ""
}

/// The node naming declaration `decl`: within its declaring node, the name
/// that refers to it; or the declaring node.
fn decl_name_at(decl: I32) I32 {
    if decl < 0 { return -1 }
    let found = named_within(decl_node[decl], decl, 3)
    return if found >= 0 { found } else { decl_node[decl] }
}

fn named_within(node: I32, decl: I32, depth: I32) I32 {
    if node < 0 { return -1 }
    if node < node_decl.len() and node_decl[node] == decl and (is_kind(node, Node.Identifier) or is_kind(node, Node.Type_ident)) { return node }
    if depth == 0 { return -1 }
    let c = first_child(node)
    while (c >= 0) {
        let found = named_within(c, decl, depth - 1)
        if found >= 0 { return found }
        c = next_sibling(c)
    }
    return -1
}

/// Whether two nodes are in one file (a place elsewhere is not drawn).
fn same_file(a: I32, b: I32) Bool => a >= 0 and b >= 0 and file_of_token(node_first[a]) == file_of_token(node_first[b])

/// Suggest `meant` for the name at `at` (its one token) on the last
/// diagnostic: a fix, and where `meant` is declared (`decl`), when that is
/// in the same file.
fn suggest(at: I32, meant: I32, decl: I32) Void {
    if meant < 0 or at < 0 { return }
    let t = node_first[at]
    let text = word_text(meant)
    if decl >= 0 and same_file(at, decl_node[decl]) { diag_place(Extra.Related, decl_name_at(decl), "declared here") }
    diag_fix(tok_start[t], tok_end[t], text, hs1(Ht.Use, text))
}

/// The name a diagnostic suggests (its fix's text), or empty.
fn suggested(i: I32) Str {
    for (0 ..< diag_extra_n[i]) |k| {
        let r = diag_extra[i] + k
        // (A fix that adds lines, an import, is shown as a fix, not quoted here.)
        if extra_kind[r] == Extra.Fix.i32() {
            let t = word_text(extra_text[r])
            return if text_index(t, "\n", 0) >= 0 { "" } else { t }
        }
    }
    return ""
}

/// "; did you mean x?", when a diagnostic suggests x.
fn did_you_mean(i: I32) Str {
    let s = suggested(i)
    return if s.len() == 0 { "" } else { hs1(Ht.DidYouMean, s) }
}

/// Report a name that names nothing (a `seek`), suggesting the nearest one in scope.
fn report_unknown(kind: Diag, node: I32, word: I32, seek: Seek) Void {
    // Generated code (a DSL's, wn's, html's) naming what was already said unknown: said there.
    if dsl_site_of(node) >= 0 {
        for (0 ..< diag_kind.len()) |i| {
            if diag_word[i] == word and (diag_kind[i] == Diag.UnknownModule.i32() or diag_kind[i] == Diag.UnknownType.i32() or diag_kind[i] == Diag.UnknownVariable.i32()) {
                diag_fresh = 0
                return
            }
        }
    }
    // The same name again on one line is the same mistake.
    for (0 ..< diag_kind.len()) |i| {
        if diag_kind[i] == kind.i32() and diag_word[i] == word and diag_node[i] != node and same_line(diag_node[i], node) {
            diag_fresh = 0
            return
        }
    }
    // A name `using` could not import is reported there.
    for (0 ..< diag_kind.len()) |i| {
        if diag_kind[i] == Diag.ImportNotModule.i32() and diag_word[i] == word {
            diag_fresh = 0
            return
        }
    }
    report(kind, node, word)
    if diag_fresh == 0 { return }
    let t = word_text(word)
    let m = std_module(t)
    // (A lowercase module is used as a value: `console.log(…)`.)
    if m.len() > 0 and (seek != Seek.Value or m == t) {
        let line = hs2(Ht.UsingFromStd, m, std_file(m))
        diag_note(if m == t { line } else { hs2(Ht.TheModuleIs, line, m) })
        return
    }
    suggest(node, near_in_scope(word, seek), near_decl)
}

/// The standard module a file must import (`using`) that `t` names, by
/// its name or its file's; empty if none.
fn std_module(t: Str) Str {
    if t == hs(Ht.Console) or t == hs(Ht.ConsoleLc) { return hs(Ht.ConsoleLc) }
    if t == hs(Ht.Time) or t == "time" { return "time" }
    if t == hs(Ht.StrMap) or t == hs(Ht.IntMap) or t == hs(Ht.List) or t == hs(Ht.Buffer) or t == hs(Ht.Interner) or t == "Random"
        or t == hs(Ht.SegmentTree) or t == hs(Ht.PersistentSegmentTree) or t == hs(Ht.Spatial) or t == hs(Ht.NumberField) { return t }
    return ""
}

/// The std file module `m` is in (`console` in std:Console).
fn std_file(m: Str) Str {
    return if m == hs(Ht.ConsoleLc) { hs(Ht.Console) } else if m == "time" { hs(Ht.Time) } else { m }
}

/// Suggest the member of `owner` in `space` nearest the name at `at`.
fn suggest_member(owner: I32, at: I32, space: Space) Void {
    if diag_fresh == 1 and at >= 0 { suggest(at, near_member(owner, word_of(at), space), near_decl) }
}

/// A note for `x.m()` with no method m (and no name suggested): where m is found.
fn method_note(t: I32, word: I32) Void {
    if diag_fresh == 0 or suggested(diag_kind.len() - 1).len() > 0 { return }
    let m = word_text(word)
    if is_array_type(t) and (m == "push" or m == "append" or m == hs(Ht.Pop) or m == hs(Ht.Insert)) {
        diag_note(hs(Ht.AnArraySLengthIsFixed))
        return
    }
    let camel = false
    for (0 ..< m.len()) |i| { if m.get(i) >= 65 and m.get(i) <= 90 { camel = true } }
    if camel and not has_foreign() and (t == prelude(Prelude.Str) or t == prelude(Prelude.F64)) {
        diag_note(hs(Ht.JavaScriptSMethodsComeWithUsing))
    }
}

/// Suggest the field of `owner` nearest the name at `at`, or a method of
/// that name, called (`s.length` → `s.len()`).
fn suggest_field(owner: I32, at: I32) Void {
    if diag_fresh == 0 or at < 0 { return }
    let word = word_of(at)
    let f = near_member(owner, word, Space.Member)
    // (Not a field of std's own: a program cannot name it.)
    if f >= 0 and decl_is(near_decl, Decl.Field) and not std_own(near_decl) {
        suggest(at, f, near_decl)
        return
    }
    let m = near_member(owner, word, Space.Method)
    if m >= 0 {
        let t = node_first[at]
        let text = hs1(Ht.AOpenClose, word_text(m))
        diag_fix(tok_start[t], tok_end[t], text, hs1(Ht.Call, text))
    }
}

/// Whether two nodes start on one line of one file.
fn same_line(a: I32, b: I32) Bool {
    if a < 0 or b < 0 or not same_file(a, b) { return false }
    let x = tok_start[node_first[a]]
    let y = tok_start[node_first[b]]
    if y < x {
        let t = x
        x = y
        y = t
    }
    for (x ..< y) |k| { if src[k] == 10 { return false } }
    return true
}

//! == Where an expected type came from
//!
//! A check that expects a type of a value says why (`want`) while it checks
//! it: a parameter, an annotation, a function's result, a field. The value
//! is its root; a mismatch at the root, or at what the root's value is (a
//! block's last expression, an `if`'s branch, an arm), names that reason
//! and points at it. TypeMismatch keeps the reason in diag_c, above the
//! count of mistakes it caused (see @fold_into): reason × 65536 + count.

/// Why a value must be of a type.
enum(U8) Why:
    | Nothing
    | Param
    | Annotation
    | Returns
    | Field
    | Variable
    | Elements
    | Branches
    | Condition
    | Operand
    | Assert

/// The reasons in force, innermost last: each one's root node, type, @Why,
/// and two arguments (Param: the function and the parameter's index;
/// Annotation: its type node and the name; Returns: the function, or -1
/// and a closure's result type node; Field, Variable: the declaration;
/// Elements, Branches: the first element or branch; Operand: the
/// expression and the operator's word).
vec want_root: I32
vec want_ty: I32
vec want_why: U8
vec want_a: I32
vec want_b: I32

fn want(root: I32, t: I32, why: Why, a: I32, b: I32) Void {
    want_root.push(root)
    want_ty.push(t)
    want_why.push(why.i32())
    want_a.push(a)
    want_b.push(b)
}

fn unwant() Void {
    let n = want_root.len() - 1
    if n < 0 { return }
    want_root.resize(n)
    want_ty.resize(n)
    want_why.resize(n)
    want_a.resize(n)
    want_b.resize(n)
}

fn want_reset() Void {
    want_root.clear()
    want_ty.clear()
    want_why.clear()
    want_a.clear()
    want_b.clear()
}

/// The reason in force for a value at `site` expected to be `t`, or -1.
fn want_for(site: I32, t: I32) I32 {
    let k = want_root.len() - 1
    while (k >= 0) {
        if want_ty[k] == t and tail_of(site, want_root[k]) { return k }
        k -= 1
    }
    return -1
}

/// Whether `site` is `root`'s value: itself, or its value's value.
fn tail_of(site: I32, root: I32) Bool {
    let s = site
    while (s != root) {
        let p = parent_of(s)
        if p < 0 or not tail_child(p, s) { return false }
        s = p
    }
    return true
}

/// Whether child c of p is p's value (or one of them).
fn tail_child(p: I32, c: I32) Bool {
    if is_kind(p, Node.Block) or is_kind(p, Node.Match_arm) or is_kind(p, Node.Alt_arm) { return last_child(p) == c }
    if is_kind(p, Node.Paren_expr) or is_kind(p, Node.Splice) or is_kind(p, Node.Block_expr) or is_kind(p, Node.Match_default) or is_kind(p, Node.Alt_default) { return true }
    if is_kind(p, Node.If_expr) or is_kind(p, Node.Match_expr) or is_kind(p, Node.Alt_expr) { return first_child(p) != c }
    return false
}

/// Report a TypeMismatch at `site` with reason k (see @want_for): the
/// reason's words, and where it is.
fn report_wanted(k: I32, site: I32, expected: I32, actual: I32) Void {
    let why = Why(want_why[k])
    let a = want_a[k]
    let b = want_b[k]
    let place = -1
    let word = -1
    match why {
        Why.Param => {
            if a >= 0 {
                word = fn_word(a)
                let ps = param_decls(a)
                if b >= 0 and b < vl_len[ps] { place = decl_node[vl_item(ps, b)] }
            }
        },
        Why.Annotation => {
            place = a
            word = b
        },
        Why.Returns => {
            if a >= 0 {
                word = fn_word(a)
                place = child_of_kind(decl_node[a], Node.Return_type)
            } else { place = b }
        },
        Why.Field => {
            word = decl_name[a]
            place = decl_node[a]
        },
        Why.Variable => {
            word = decl_name[a]
            place = decl_node[a]
        },
        Why.Elements => { place = a },
        Why.Branches => { place = a },
        Why.Operand => {
            word = b
            place = first_child(a)
        },
        ~> {},
    }
    // `if n = 0`: an assignment where a comparison was meant.
    let op = if is_kind(site, Node.Assign_expr) { node_last[first_child(site)] } else { -1 }
    if why == Why.Condition and op >= 0 and tok_is(op, Tok.Eq) { word = known_word(Known.Eq) }
    // The same reason, types, and root again (both branches of one `if`): one mistake.
    for (0 ..< diag_kind.len()) |i| {
        if diag_kind[i] == Diag.TypeMismatch.i32() and diag_a[i] == expected and diag_b[i] == actual and diag_word[i] == word
            and diag_c[i] >= 0 and diag_c[i] / 65536 == want_why[k] and diag_node[i] >= 0 and tail_of(diag_node[i], want_root[k]) {
            diag_fresh = 0
            return
        }
    }
    report3(Diag.TypeMismatch, site, word, expected, actual, want_why[k] * 65536)
    if word == known_word(Known.Eq) and why == Why.Condition { diag_fix(tok_start[op], tok_end[op], "==", hs(Ht.UseEqEq)) }
    if diag_fresh == 1 and place >= 0 and same_file(place, site) and not within(site, place) and not within(place, site) {
        diag_place(Extra.Expected, place, type_text(expected))
    }
}

/// Whether node a is node b or inside it.
fn within(a: I32, b: I32) Bool => node_first[a] >= node_first[b] and node_last[a] <= node_last[b]

/// A TypeMismatch's message, by its reason.
fn mismatch_text(i: I32) Str {
    let c = diag_c[i]
    let why = if c > 0 { c / 65536 } else { 0 }
    let n = if c > 0 { c % 65536 } else { 0 }
    let caused = if n > 0 { hs1(Ht.CausedByThis, int_text(n)) } else { "" }
    let e = type_text(diag_a[i])
    let g = type_text(diag_b[i])
    // Two types of one name: said with their modules (or, when that is the same too, as two).
    if e == g and diag_a[i] != diag_b[i] {
        qualify_types = 1
        e = type_text(diag_a[i])
        g = type_text(diag_b[i])
        if e == g {
            qualify_types = 2
            e = type_text(diag_a[i])
            g = type_text(diag_b[i])
        }
        qualify_types = 0
        if e == g { g = hs1(Ht.AnotherTypeOfThatName, g) }
    }
    let got = hs2(Ht.Got, g, caused)
    let w = word_text(diag_word[i])
    // A name the compiler made says nothing to the user.
    if w.len() > 1 and w.slice(0, 2) == "__" { w = "" }
    if diag_a[i] < 0 or diag_b[i] < 0 { return hs(Ht.TypeMismatch) }
    let r = Why(why)
    if r == Why.Param and w.len() > 0 { return hs3(Ht.Takes, w, e, got) }
    if (r == Why.Annotation or r == Why.Variable) and w.len() > 0 { return hs3(Ht.Is, w, e, got) }
    if r == Why.Returns { return hs3(Ht.Returns, pick(w.len() > 0, w, hs(Ht.TheClosure)), e, got) }
    if r == Why.Field and w.len() > 0 { return hs3(Ht.FieldIs, w, e, got) }
    if r == Why.Elements { return hs2(Ht.ElementsAre, e, got) }
    if r == Why.Branches { return hs3(Ht.BranchesDifferAnd, e, type_text(diag_b[i]), caused) }
    if r == Why.Condition and diag_word[i] == known_word(Known.Eq) { return hs(Ht.AssignsCompareWith) }
    if r == Why.Condition { return hs2(Ht.ConditionIsNotBool, type_text(diag_b[i]), caused) }
    if r == Why.Assert { return hs1(Ht.AssertTakesBool, got) }
    if r == Why.Operand {
        if w == "and" or w == "or" or w == "not" or w == "xor" { return hs2(Ht.TakesBool, w, got) }
        return hs4(Ht.NoForAnd, operator_symbol(diag_word[i]), e, type_text(diag_b[i]), caused)
    }
    return hs2(Ht.Expected, e, got)
}

//! == Parse errors
//!
//! A program that does not parse often shows a habit from another language
//! (`&&`, `->`, `elif`, `for x in`, `Array<I32>`) or lacks one token after
//! the end of a line. @parse_hint recognizes these on the line of the token
//! the parser stopped at, and says so: its message (in diag_c, which a
//! ParseError does not otherwise use), a fix, and where the mistake is.

/// The token's text.
fn tok_text(t: I32) Str => bytes_text(tok_start[t], tok_end[t])

fn tok_is(t: I32, kind: Tok) Bool => t >= 0 and tok_kind[t] == kind.i32()

/// Whether token t is the word `text`.
fn tok_says(t: I32, text: Str) Bool => t >= 0 and tok_kind[t] == Tok.Word.i32() and tok_text(t) == text

/// Whether tokens a and b touch (`&&`, `->`).
fn touching(a: I32, b: I32) Bool => tok_end[a] == tok_start[b]

/// The token before t in file `file` that is not a comment, or -1.
fn tok_before(file: I32, t: I32) I32 {
    let k = t - 1
    while (k >= file_tok[file] and tok_kind[k] == Tok.Comment.i32()) { k -= 1 }
    return if k < file_tok[file] { -1 } else { k }
}

/// The token after t, not a comment (the End token stays put).
fn tok_after(t: I32) I32 {
    if tok_kind[t] == Tok.End.i32() { return t }
    let k = t + 1
    while (tok_kind[k] == Tok.Comment.i32()) { k += 1 }
    return k
}

/// Whether a newline comes between the starts of tokens a and b.
fn lines_apart(a: I32, b: I32) Bool {
    for (tok_start[a] ..< tok_start[b]) |k| { if src[k] == 10 { return true } }
    return false
}

/// The first token of t's line in `file`.
fn line_first(file: I32, t: I32) I32 {
    let k = t
    while (k > file_tok[file] and not lines_apart(k - 1, k)) { k -= 1 }
    return k
}

/// The hint's message, for the last diagnostic (a ParseError).
fn parse_says(text: Str) Void {
    if diag_fresh == 1 { diag_c[diag_kind.len() - 1] = intern_text(text) }
}

/// What a ParseError at token t (in `file`, the parser wanting `wanted`)
/// recognizes; see the section's comment.
fn parse_hint(file: I32, t: I32, wanted: I32) Void {
    // `'\/'` in a DSL body: its `\/` ended the body (only a "…" string keeps one).
    if diag_fresh == 1 and t > 0 and tok_kind[t] == Tok.Error.i32() and src[tok_start[t]] == 39 and tok_kind[t - 1] == Tok.DslBody.i32() {
        diag_note(hs(Ht.EndsADSLBodyExceptInside))
        return
    }
    if diag_fresh == 0 or t < 0 or tok_kind[t] == Tok.Error.i32() { return }
    if tok_is(t, Tok.End) {
        let prev = tok_before(file, t)
        if prev >= 3 and tok_says(prev, "fn") and tok_says(prev - 3, hs(Ht.Proto)) and tok_is(prev - 1, Tok.Colon) {
            diag_focus(prev, prev, hs(Ht.UnfinishedProtocol))
            parse_says(hs(Ht.ProtocolMembersBeginWithFollowedBy))
            return
        }
    }
    let first = line_first(file, t)
    // The line of the error.
    let last = t
    while (tok_kind[last] != Tok.End.i32() and not lines_apart(last, last + 1)) { last += 1 }
    let k = first
    while (k <= last) {
        if foreign_habit(file, k, t) { return }
        k += 1
    }
    let prev = tok_before(file, t)
    let w = word_text(wanted)
    if tok_says(prev, "let") and tok_is(t, Tok.Word) and is_expression_keyword(intern_text(tok_text(t))) {
        parse_says(hs1(Ht.IsAKeyword, tok_text(t)))
        diag_label(hs(Ht.AKeyword))
        return
    }
    // `if c { … }; else { … }`: the `;` ended the if; `else` was read as a name.
    let semi = tok_before(file, prev)
    if tok_says(prev, "else") and tok_is(semi, Tok.Semi) {
        parse_says(hs(Ht.TheBeforeElseEndsTheIf))
        diag_focus(semi, semi, hs(Ht.No))
        diag_fix(tok_start[semi], tok_end[semi], "", hs(Ht.Drop))
        return
    }
    // `Dot;` or `mk(B)`: a capitalized name where a value goes builds with braces, or is a variant by its enum.
    let before = tok_before(file, prev)
    if prev >= 0 and tok_is(prev, Tok.Word) and src[tok_start[prev]] >= 65 and src[tok_start[prev]] <= 90
        and (tok_is(t, Tok.Semi) or tok_is(t, Tok.RParen) or tok_is(t, Tok.Comma))
        and (tok_is(before, Tok.Eq) or tok_is(before, Tok.LParen) or tok_is(before, Tok.Comma) or tok_is(before, Tok.LBrace) or tok_is(before, Tok.Semi) or tok_says(before, hs(Ht.Return))) {
        parse_says(hs3(Ht.IsATypeWriteOrEnum, tok_text(prev), tok_text(prev), tok_text(prev)))
        diag_focus(prev, prev, hs(Ht.AType))
        return
    }
    // One token missing at the end of a line (or of a block): after the token before.
    // (A `\\` line's `;` is its text: diag_text says so.)
    if prev >= 0 and not tok_is(prev, Tok.MultilineLine) and (w == "';'" or w == hs(Ht.TickCommaTick)) and (lines_apart(prev, t) or tok_is(t, Tok.RBrace) or tok_is(t, Tok.End)) {
        let mark = w.slice(1, 2)
        parse_says(hs2(Ht.MissingAfter, mark, tok_shown(prev)))
        diag_focus(prev, prev, hs1(Ht.AQ, mark))
        diag_fix(tok_end[prev], tok_end[prev], mark, hs1(Ht.Add, mark))
        return
    }
    // `| y` then a new line: a field without its type.
    if prev >= 0 and w == hs(Ht.TickColonTick) and tok_is(prev, Tok.Word) and tok_is(tok_before(file, prev), Tok.Pipe) and lines_apart(prev, t) {
        parse_says(hs1(Ht.FieldNeedsType, tok_text(prev)))
        diag_focus(prev, prev, "no type")
        return
    }
    // The end of the file, or a declaration where a body goes on: a brace left open.
    let open = unclosed_brace(file)
    if open >= 0 and (tok_is(t, Tok.End) or tok_says(t, "export") or tok_says(t, "fn") or tok_says(t, hs(Ht.Using))) {
        if tok_is(t, Tok.End) {
            parse_says(hs(Ht.Unclosed))
            diag_label("end of file")
        }
        diag_place_tokens(Extra.Related, open, open, hs(Ht.NeverClosed))
    }
}

/// A token as a message names it (a long one cut short).
fn tok_shown(t: I32) Str {
    let text = tok_text(t)
    return if text.len() > 16 { hs1(Ht.AEllipsis, text.slice(0, 16)) } else { text }
}

/// The outermost `{` of `file` that no `}` closes, or -1.
fn unclosed_brace(file: I32) I32 {
    let depth = 0
    let open = -1
    for (file_tok[file] ..< file_tok_end[file]) |k| {
        if tok_kind[k] == Tok.LBrace.i32() {
            if depth == 0 { open = k }
            depth += 1
        } else if tok_kind[k] == Tok.RBrace.i32() and depth > 0 {
            depth -= 1
        }
    }
    return if depth > 0 { open } else { -1 }
}

/// Whether token k (on the error's line; the parser stopped at t) starts
/// another language's habit, which is then reported.
fn foreign_habit(file: I32, k: I32, t: I32) Bool {
    let n = tok_after(k)
    // The spellings before Void and gn.
    if tok_says(k, "void") { return habit(k, k, "Void", hs(Ht.WriteVoidNotVoid)) }
    if tok_says(k, "yield") and tok_is(tok_before(file, k), Tok.RParen) {
        let f = k
        while (f > 0 and not tok_says(f, "fn") and not lines_apart(f - 1, f)) { f -= 1 }
        if tok_says(f, "fn") {
            let text = hs1(Ht.Gn, bytes_text(tok_end[f], tok_start[k]))
            diag_focus(k, k, hs(Ht.GnLc))
            diag_fix(tok_start[f], tok_start[n], text, hs(Ht.UseGn))
            parse_says(hs(Ht.AGeneratorIsGnGT))
            return true
        }
    }
    if tok_is(k, Tok.Amp) and tok_is(n, Tok.Amp) and touching(k, n) { return habit(k, n, "and", hs(Ht.WriteAndNot)) }
    if tok_is(k, Tok.Pipe) and tok_is(n, Tok.Pipe) and touching(k, n) { return habit(k, n, "or", hs(Ht.WriteOrNot)) }
    if tok_is(k, Tok.Minus) and tok_is(n, Tok.Gt) and touching(k, n) {
        // `) -> I32`: the arrow and the space after it go.
        diag_focus(k, n, hs(Ht.NoDashGt))
        diag_fix(tok_start[k], tok_start[tok_after(n)], "", hs(Ht.DropDashGt))
        parse_says(hs(Ht.NoBeforeAReturnType))
        return true
    }
    if tok_says(k, hs(Ht.Elif)) { return habit(k, k, hs(Ht.ElseIf), hs(Ht.WriteElseIfNotElif)) }
    if (tok_says(k, hs(Ht.True)) or tok_says(k, hs(Ht.False))) and n == t {
        let lower = if tok_text(k) == hs(Ht.True) { "true" } else { "false" }
        return habit(k, k, lower, hs2(Ht.WriteNot, lower, tok_text(k)))
    }
    if tok_says(k, hs(Ht.Const)) and indented(k) { return habit(k, k, "let", hs(Ht.WriteLetNotConstInA)) }
    if tok_says(k, "for") and tok_is(n, Tok.Word) and tok_says(tok_after(n), hs(Ht.InLc)) {
        // `for x in xs {` is `for (xs) |x| {`.
        let from = tok_after(tok_after(n))
        let brace = from
        while (tok_kind[brace] != Tok.End.i32() and not tok_is(brace, Tok.LBrace)) { brace += 1 }
        if tok_is(brace, Tok.LBrace) and brace > from {
            let until = tok_before(file, brace)
            let text = hs2(Ht.OpenACloseSpaceBarBBar, range_text(from, until), tok_text(n))
            diag_focus(n, until, text)
            diag_fix(tok_start[n], tok_end[until], text, hs1(Ht.UseFor, text))
            parse_says(hs2(Ht.WriteForNotForIn, text, tok_text(n)))
            return true
        }
    }
    if (tok_says(k, "let") or tok_says(k, "fn")) and tok_is(n, Tok.Word) and lower_byte(src[tok_start[n]]) != src[tok_start[n]] and (t == n or t == tok_after(n)) {
        // `let INF = 1;`, `fn F() I32`: a capital starts a type's name.
        let low = lowered(n)
        diag_focus(n, n, hs1(Ht.AQ, low))
        diag_fix(tok_start[n], tok_end[n], low, hs1(Ht.Use, low))
        parse_says(hs(Ht.NamesOfValuesAndFunctionsStart))
        return true
    }
    if (tok_is(k, Tok.Plus) and tok_is(n, Tok.Plus) or tok_is(k, Tok.Minus) and tok_is(n, Tok.Minus)) and touching(k, n) {
        // `i++` is `i += 1`.
        let op = if tok_is(k, Tok.Plus) { "+=" } else { "-=" }
        diag_focus(k, n, hs1(Ht.N1, op))
        diag_fix(tok_start[k], tok_end[n], hs1(Ht.N12, op), hs1(Ht.Use1, op))
        parse_says(hs3(Ht.UtuHasNoWrite1, tok_text(k), tok_text(n), op))
        return true
    }
    if k == t and (tok_is(k, Tok.String) or tok_is(k, Tok.TemplateFull)) and tok_is(n, Tok.FatArrow) {
        // `match s { "+" => … }`
        diag_focus(k, k, "a string")
        diag_note(hs2(Ht.CompareStringsWithIfIfElse, match_subject(file, k), tok_text(k)))
        parse_says(hs(Ht.MatchTakesNumberBoolAndEnum))
        return true
    }
    if two_dots(k) {
        diag_focus(k, k + 1, "..<")
        diag_fix(tok_start[k], tok_end[k + 1], "..<", hs(Ht.UseDotDotLt))
        parse_says(hs(Ht.WriteEndLeftOutOrEnd))
        return true
    }
    if tok_is(k, Tok.Word) and tok_is(n, Tok.Lt) and touching(k, n) {
        // `Array<I32>` is `Array[I32]`.
        let close = tok_after(n)
        while (close < t + 4 and tok_kind[close] != Tok.End.i32() and not tok_is(close, Tok.Gt)) { close = tok_after(close) }
        if tok_is(close, Tok.Gt) and close > tok_after(n) {
            let text = hs2(Ht.ABracketBBracketEnd, tok_text(k), bytes_text(tok_start[tok_after(n)], tok_end[tok_before(file, close)]))
            diag_focus(k, close, text)
            diag_fix(tok_start[k], tok_end[close], text, hs(Ht.UseBracketBracketEn))
            parse_says(hs1(Ht.TypeArgumentsGoIn, text))
            return true
        }
    }
    if tok_is(k, Tok.Slash) and tok_is(n, Tok.Star) and touching(k, n) {
        diag_focus(k, n, hs(Ht.NotAComment))
        parse_says(hs(Ht.CommentsStartWithUtuHasNo))
        return true
    }
    if tok_says(k, "_") and tok_is(n, Tok.FatArrow) {
        diag_focus(k, n, "~>")
        diag_fix(tok_start[k], tok_end[n], "~>", hs(Ht.UseTildeGt))
        parse_says(hs(Ht.TheDefaultArmIsNot))
        return true
    }
    // The spellings before lib { … } and main { … }.
    if tok_says(k, "export") and tok_says(n, "lib") {
        diag_focus(k, n, "lib")
        diag_fix(tok_start[k], tok_start[n], "", hs(Ht.DropExport))
        parse_says(hs(Ht.WriteLibNotExportLib))
        return true
    }
    if tok_says(k, "export") and tok_says(n, "main") {
        // `main() Void {`: main; with a result, main returns none.
        let close = tok_after(tok_after(n))
        let result = tok_after(close)
        if tok_is(tok_after(n), Tok.LParen) and tok_is(close, Tok.RParen) and tok_says(result, "Void") {
            diag_focus(k, result, "main")
            diag_fix(tok_start[k], tok_end[result], "main", hs(Ht.UseMain))
            parse_says(hs(Ht.WriteMainNotExportMainVoid))
            return true
        }
        diag_focus(k, n, "main")
        diag_note(hs(Ht.MainReturnsNothingPrintWithConsole))
        parse_says(hs(Ht.WriteMainNotExportMain))
        return true
    }
    if tok_says(k, "export") and tok_says(n, "fn") {
        if tok_says(tok_after(n), "main") {
            diag_focus(k, tok_after(n), "main")
            parse_says(hs(Ht.WriteMainNotExportFnMain))
            return true
        }
        diag_focus(k, n, hs(Ht.NotADeclaration))
        diag_note(hs(Ht.FunctionsJSCallsGoInLib))
        parse_says(hs(Ht.ExportFnIsNotADeclaration))
        return true
    }
    if tok_says(k, "fn") and indented(k) and k == line_first(file, k) and (k == t or tok_after(k) == t) {
        if k >= 3 and tok_says(k - 3, hs(Ht.Proto)) and tok_is(k - 1, Tok.Colon) {
            diag_focus(k, k, hs(Ht.UnfinishedProtocol))
            parse_says(hs(Ht.ProtocolMembersBeginWithFollowedBy))
            return true
        }
        diag_focus(k, k, hs(Ht.Nested))
        diag_note(hs(Ht.UseAClosureLetFCl))
        parse_says(hs(Ht.AFunctionCannotBeDeclaredInside))
        return true
    }
    let before = tok_before(file, k)
    if tok_is(k, Tok.Pipe) and (tok_is(before, Tok.LParen) or tok_is(before, Tok.Comma)) and tok_is(n, Tok.Word) and tok_is(tok_after(n), Tok.Pipe) {
        diag_focus(k, tok_after(n), hs(Ht.NotAClosure))
        parse_says(hs(Ht.AClosureIsWrittenClX))
        return true
    }
    if tok_is(k, Tok.FatArrow) and tok_is(before, Tok.RParen) and k == t {
        diag_focus(k, k, hs(Ht.NotAClosure))
        parse_says(hs(Ht.AClosureIsWrittenClX))
        return true
    }
    return false
}

/// Token t's word lowercased: all of it when it is all capitals (`INF`), else its first letter (`MaxSize`).
fn lowered(t: I32) Str {
    let caps = true
    for (tok_start[t] ..< tok_end[t]) |i| { if src[i] >= 97 and src[i] <= 122 { caps = false } }
    let text = ""
    for (tok_start[t] ..< tok_end[t]) |i| {
        text = text + Str.from_code_point(if caps or i == tok_start[t] { lower_byte(src[i]) } else { src[i] })
    }
    return text
}

/// The subject of the `match` whose arm token k is in, as written (`x` when not found).
fn match_subject(file: I32, k: I32) Str {
    let m = k
    while (m > file_tok[file] and m > k - 400 and not tok_says(m, "match")) { m -= 1 }
    let brace = m
    while (brace < k and not tok_is(brace, Tok.LBrace)) { brace += 1 }
    if not tok_says(m, "match") or brace == m + 1 or brace >= k { return "x" }
    return bytes_text(tok_start[m + 1], tok_end[brace - 1])
}

/// Whether tokens k and k+1 are `..` (two dots, which utu does not have).
fn two_dots(k: I32) Bool => tok_is(k, Tok.Dot) and tok_is(k + 1, Tok.Dot) and touching(k, k + 1)

/// Tokens a to b as written, each `..` made ` ..< ` (utu's half-open range).
fn range_text(a: I32, b: I32) Str {
    let text = ""
    let at = tok_start[a]
    let k = a
    while (k < b) {
        if two_dots(k) {
            let end_ = tok_start[k]
            while (end_ > at and src[end_ - 1] == 32) { end_ -= 1 }
            text = hs2(Ht.ABSpaceDotDotLtSpace, text, bytes_text(at, end_))
            at = tok_end[k + 1]
            while (src[at] == 32) { at += 1 }
            k += 2
        } else {
            k += 1
        }
    }
    return text + bytes_text(at, tok_end[b])
}

/// Report a habit: tokens a to b written where `text` is utu's.
fn habit(a: I32, b: I32, text: Str, message: Str) Bool {
    diag_focus(a, b, text)
    diag_fix(tok_start[a], tok_end[b], text, hs1(Ht.Use, text))
    parse_says(message)
    return true
}

/// Whether token t's line starts with whitespace (it is inside something).
fn indented(t: I32) Bool {
    let k = tok_start[t]
    while (k > 0 and src[k - 1] != 10) { k -= 1 }
    return src[k] == 32 or src[k] == 9
}

/// Whether word w names something the user wrote (not one the compiler made, `__…`).
fn named_word(w: I32) Bool {
    if w < 0 { return false }
    let t = word_text(w)
    return t.len() > 0 and not (t.len() > 1 and t.slice(0, 2) == "__")
}

//! == Codes
//!
//! A diagnostic's code is its kind's name, made finer where one kind covers
//! distinct mistakes (stage 0's kind, `diag_kind_of`, stays as it was).

fn diag_code(i: I32) Str {
    let k = Diag(diag_kind[i])
    let a = diag_a[i]
    if k == Diag.TypeMismatch and diag_c[i] > 0 and diag_c[i] / 65536 == Why.Operand.i32() and not is_logical(diag_word[i]) { return hs(Ht.OperandMismatch) }
    if k == Diag.ParseError and diag_c[i] >= 0 {
        let t = word_text(diag_c[i])
        if t.len() > 8 and t.slice(0, 9) == hs(Ht.Missing) { return hs(Ht.MissingSemicolon) }
        if t.len() > 8 and t.slice(0, 9) == hs(Ht.MissingComma) { return hs(Ht.MissingComma2) }
        if t.len() > 7 and t.slice(0, 8) == hs(Ht.Unclosed2) { return hs(Ht.UnclosedDelimiter) }
        if t.len() > 5 and t.slice(0, 6) == "Field " { return hs(Ht.ParseError) }
        return hs(Ht.ForeignSyntax)
    }
    if k == Diag.UnknownVariable and is_callee(diag_node[i]) { return hs(Ht.UnknownFunction) }
    if k == Diag.DuplicateDeclaration {
        if a == 1 { return hs(Ht.DuplicateParameter) }
        if a == 2 { return hs(Ht.DuplicateVariant) }
        if a == 3 or a == 6 or a == 8 { return hs(Ht.DuplicateLocal) }
        if a == 5 { return hs(Ht.DuplicateMethod) }
    }
    if k == Diag.UnknownMethod and diag_b[i] == 1 { return hs(Ht.StaticAsMethod) }
    return diag_name(k)
}

fn is_logical(w: I32) Bool => w == Kw.And.i32() or w == Kw.Or.i32() or w == Kw.Not.i32() or w == Kw.Xor.i32()

/// Whether a node is what a call calls (`f` in `f(x)`).
fn is_callee(node: I32) Bool {
    if node < 0 { return false }
    let p = parent_of(node)
    return is_kind(p, Node.Call_expr) and first_child(p) == node
}

/// A function's name as written (a method's after its type: `area` of `fn Rect.area`).
fn fn_word(decl: I32) I32 {
    let at = decl_name_at(decl)
    if at >= 0 and at != decl_node[decl] and is_kind(at, Node.Identifier) { return word_of(at) }
    return decl_name[decl]
}

//! = Instances

/// The instance of a generic module the function being checked is in (0 none).
let cur_inst: I32 = 0

/// The last diagnostic was found checking instance `inst` (of a generic
/// module): name it, at the place it was written when known.
fn in_instance(inst: I32) Void {
    if inst <= 0 { return }
    let text = hs2(Ht.In, word_text(decl_name[inst_module[inst]]), type_list_text(inst_args[inst]))
    let l = inst_site[inst]
    // `G[U32]`: the name before the list, to its `]`.
    if l >= 0 { diag_place_tokens(Extra.Related, node_first[l] - 1, node_last[l] - 1, text) } else { diag_note(text) }
}

//! == Text
//!
//! This file's strings and templates, in the string table (strtab.utu).

enum(U8) Ht:
    | Use
    | DidYouMean
    | UsingFromStd
    | TheModuleIs
    | AOpenClose
    | Call
    | CausedByThis
    | AnotherTypeOfThatName
    | Got
    | Takes
    | Is
    | Returns
    | FieldIs
    | ElementsAre
    | BranchesDifferAnd
    | ConditionIsNotBool
    | AssertTakesBool
    | TakesBool
    | NoForAnd
    | Expected
    | IsAKeyword
    | IsATypeWriteOrEnum
    | MissingAfter
    | AQ
    | Add
    | FieldNeedsType
    | AEllipsis
    | Gn
    | WriteNot
    | OpenACloseSpaceBarBBar
    | UseFor
    | WriteForNotForIn
    | N1
    | N12
    | Use1
    | UtuHasNoWrite1
    | CompareStringsWithIfIfElse
    | ABracketBBracketEnd
    | TypeArgumentsGoIn
    | ABSpaceDotDotLtSpace
    | In
    | AssertAssertStrictAsyncHooksBuffer
    | Lenght
    | Size
    | Float
    | Double
    | ToUpperCase
    | Upper
    | ToUpper
    | ToUpperLc
    | ToLowerCase
    | Lower
    | ToLower
    | ToLowerLc
    | ToString
    | ToStringLc
    | ToStr
    | ToI32
    | ToU32
    | ToI64
    | ToU64
    | ToF32
    | ToF64
    | True
    | False
    | Console
    | ConsoleLc
    | Time
    | StrMap
    | IntMap
    | List
    | Buffer
    | Interner
    | SegmentTree
    | PersistentSegmentTree
    | Spatial
    | NumberField
    | Pop
    | Insert
    | AnArraySLengthIsFixed
    | JavaScriptSMethodsComeWithUsing
    | UseEqEq
    | TypeMismatch
    | TheClosure
    | AssignsCompareWith
    | EndsADSLBodyExceptInside
    | Proto
    | UnfinishedProtocol
    | ProtocolMembersBeginWithFollowedBy
    | AKeyword
    | TheBeforeElseEndsTheIf
    | No
    | Drop
    | Return
    | AType
    | TickCommaTick
    | TickColonTick
    | Using
    | Unclosed
    | NeverClosed
    | WriteVoidNotVoid
    | GnLc
    | UseGn
    | AGeneratorIsGnGT
    | WriteAndNot
    | WriteOrNot
    | NoDashGt
    | DropDashGt
    | NoBeforeAReturnType
    | Elif
    | ElseIf
    | WriteElseIfNotElif
    | Const
    | WriteLetNotConstInA
    | InLc
    | NamesOfValuesAndFunctionsStart
    | MatchTakesNumberBoolAndEnum
    | UseDotDotLt
    | WriteEndLeftOutOrEnd
    | UseBracketBracketEn
    | NotAComment
    | CommentsStartWithUtuHasNo
    | UseTildeGt
    | TheDefaultArmIsNot
    | DropExport
    | WriteLibNotExportLib
    | UseMain
    | WriteMainNotExportMainVoid
    | MainReturnsNothingPrintWithConsole
    | WriteMainNotExportMain
    | WriteMainNotExportFnMain
    | NotADeclaration
    | FunctionsJSCallsGoInLib
    | ExportFnIsNotADeclaration
    | Nested
    | UseAClosureLetFCl
    | AFunctionCannotBeDeclaredInside
    | NotAClosure
    | AClosureIsWrittenClX
    | OperandMismatch
    | Missing
    | MissingSemicolon
    | MissingComma
    | MissingComma2
    | Unclosed2
    | UnclosedDelimiter
    | ParseError
    | ForeignSyntax
    | UnknownFunction
    | DuplicateParameter
    | DuplicateVariant
    | DuplicateLocal
    | DuplicateMethod
    | StaticAsMethod

fn hs_src(t: Ht) Str {
    return match t {
        Ht.Use => "Use {0}",
        Ht.DidYouMean => "; did you mean {0}?",
        Ht.UsingFromStd => "using {0} from std:{1}",
        Ht.TheModuleIs => "{0} (the module is {1})",
        Ht.AOpenClose => "{0}()",
        Ht.Call => "Call {0}",
        Ht.CausedByThis => " (+{0} caused by this)",
        Ht.AnotherTypeOfThatName => "{0} (another type of that name)",
        Ht.Got => ", got {0}{1}",
        Ht.Takes => "{0} takes {1}{2}",
        Ht.Is => "{0} is {1}{2}",
        Ht.Returns => "{0} returns {1}{2}",
        Ht.FieldIs => "Field {0} is {1}{2}",
        Ht.ElementsAre => "Elements are {0}{1}",
        Ht.BranchesDifferAnd => "Branches differ: {0} and {1}{2}",
        Ht.ConditionIsNotBool => "Condition is {0}, not Bool{1}",
        Ht.AssertTakesBool => "assert takes Bool{0}",
        Ht.TakesBool => "{0} takes Bool{1}",
        Ht.NoForAnd => "No {0} for {1} and {2}{3}",
        Ht.Expected => "Expected {0}{1}",
        Ht.IsAKeyword => "'{0}' is a keyword",
        Ht.IsATypeWriteOrEnum => "{0} is a type: write {1} { … }, or Enum.{2} for a variant",
        Ht.MissingAfter => "Missing {0} after {1}",
        Ht.AQ => "{0}?",
        Ht.Add => "Add {0}",
        Ht.FieldNeedsType => "Field {0} needs ': Type'",
        Ht.AEllipsis => "{0}…",
        Ht.Gn => "gn{0}",
        Ht.WriteNot => "Write {0}, not {1}",
        Ht.OpenACloseSpaceBarBBar => "({0}) |{1}|",
        Ht.UseFor => "Use for {0}",
        Ht.WriteForNotForIn => "Write for {0}, not for {1} in",
        Ht.N1 => "{0} 1",
        Ht.N12 => " {0} 1",
        Ht.Use1 => "Use {0} 1",
        Ht.UtuHasNoWrite1 => "utu has no {0}{1}; write {2} 1",
        Ht.CompareStringsWithIfIfElse => "Compare strings with if: if {0} == {1} { … } else if …",
        Ht.ABracketBBracketEnd => "{0}[{1}]",
        Ht.TypeArgumentsGoIn => "Type arguments go in [ ]: {0}",
        Ht.ABSpaceDotDotLtSpace => "{0}{1} ..< ",
        Ht.In => "in {0}[{1}]",
        Ht.AssertAssertStrictAsyncHooksBuffer => "assert assert/strict async_hooks buffer child_process cluster console constants crypto dgram diagnostics_channel dns dns/promises domain events fs fs/promises http http2 https inspector inspector/promises module net os path path/posix path/win32 perf_hooks process punycode querystring readline readline/promises repl stream stream/consumers stream/promises stream/web string_decoder sys timers timers/promises tls trace_events tty url util util/types v8 vm wasi worker_threads zlib sea sqlite test test/reporters",
        Ht.Lenght => "lenght",
        Ht.Size => "size",
        Ht.Float => "float",
        Ht.Double => "double",
        Ht.ToUpperCase => "toUpperCase",
        Ht.Upper => "upper",
        Ht.ToUpper => "toUpper",
        Ht.ToUpperLc => "to_upper",
        Ht.ToLowerCase => "toLowerCase",
        Ht.Lower => "lower",
        Ht.ToLower => "toLower",
        Ht.ToLowerLc => "to_lower",
        Ht.ToString => "to_string",
        Ht.ToStringLc => "toString",
        Ht.ToStr => "to_str",
        Ht.ToI32 => "to_i32",
        Ht.ToU32 => "to_u32",
        Ht.ToI64 => "to_i64",
        Ht.ToU64 => "to_u64",
        Ht.ToF32 => "to_f32",
        Ht.ToF64 => "to_f64",
        Ht.True => "True",
        Ht.False => "False",
        Ht.Console => "Console",
        Ht.ConsoleLc => "console",
        Ht.Time => "Time",
        Ht.StrMap => "StrMap",
        Ht.IntMap => "IntMap",
        Ht.List => "List",
        Ht.Buffer => "Buffer",
        Ht.Interner => "Interner",
        Ht.SegmentTree => "SegmentTree",
        Ht.PersistentSegmentTree => "PersistentSegmentTree",
        Ht.Spatial => "Spatial",
        Ht.NumberField => "NumberField",
        Ht.Pop => "pop",
        Ht.Insert => "insert",
        Ht.AnArraySLengthIsFixed => "An Array's length is fixed; a Buffer[T] grows: using Buffer from std:Buffer;",
        Ht.JavaScriptSMethodsComeWithUsing => "JavaScript's methods come with using JS from std:JS;",
        Ht.UseEqEq => "Use ==",
        Ht.TypeMismatch => "Type mismatch",
        Ht.TheClosure => "The closure",
        Ht.AssignsCompareWith => "= assigns; compare with ==",
        Ht.EndsADSLBodyExceptInside => "\\/ ends a DSL body, except inside \"…\": write \"\\/\" there, not '\\/'",
        Ht.Proto => "proto",
        Ht.UnfinishedProtocol => "unfinished protocol",
        Ht.ProtocolMembersBeginWithFollowedBy => "Protocol members begin with |, followed by a name and signature",
        Ht.AKeyword => "a keyword",
        Ht.TheBeforeElseEndsTheIf => "The ; before else ends the if",
        Ht.No => "no ;",
        Ht.Drop => "Drop ;",
        Ht.Return => "return",
        Ht.AType => "a type",
        Ht.TickCommaTick => "','",
        Ht.TickColonTick => "':'",
        Ht.Using => "using",
        Ht.Unclosed => "Unclosed {",
        Ht.NeverClosed => "never closed",
        Ht.WriteVoidNotVoid => "Write Void, not void",
        Ht.GnLc => "gn",
        Ht.UseGn => "Use gn",
        Ht.AGeneratorIsGnGT => "A generator is gn g(…) T, not fn g(…) yield T",
        Ht.WriteAndNot => "Write and, not &&",
        Ht.WriteOrNot => "Write or, not ||",
        Ht.NoDashGt => "no ->",
        Ht.DropDashGt => "Drop ->",
        Ht.NoBeforeAReturnType => "No -> before a return type",
        Ht.Elif => "elif",
        Ht.ElseIf => "else if",
        Ht.WriteElseIfNotElif => "Write else if, not elif",
        Ht.Const => "const",
        Ht.WriteLetNotConstInA => "Write let, not const, in a function",
        Ht.InLc => "in",
        Ht.NamesOfValuesAndFunctionsStart => "Names of values and functions start lowercase (a capital starts a type)",
        Ht.MatchTakesNumberBoolAndEnum => "match takes number, Bool, and enum patterns, not strings",
        Ht.UseDotDotLt => "Use ..<",
        Ht.WriteEndLeftOutOrEnd => "Write ..< (end left out) or ... (end kept), not ..",
        Ht.UseBracketBracketEn => "Use [ ]",
        Ht.NotAComment => "not a comment",
        Ht.CommentsStartWithUtuHasNo => "Comments start with //; utu has no /* */",
        Ht.UseTildeGt => "Use ~>",
        Ht.TheDefaultArmIsNot => "The default arm is ~>, not _ =>",
        Ht.DropExport => "Drop export",
        Ht.WriteLibNotExportLib => "Write lib { … }, not export lib { … }",
        Ht.UseMain => "Use main",
        Ht.WriteMainNotExportMainVoid => "Write main { … }, not export main() Void { … }",
        Ht.MainReturnsNothingPrintWithConsole => "main returns nothing: print with console.log, or put a function JS calls in lib { … }",
        Ht.WriteMainNotExportMain => "Write main { … }, not export main()",
        Ht.WriteMainNotExportFnMain => "Write main { … }, not export fn main()",
        Ht.NotADeclaration => "not a declaration",
        Ht.FunctionsJSCallsGoInLib => "Functions JS calls go in lib { … }",
        Ht.ExportFnIsNotADeclaration => "export fn is not a declaration",
        Ht.Nested => "nested",
        Ht.UseAClosureLetFCl => "Use a closure: let f = cl(x: I32) I32 { … };",
        Ht.AFunctionCannotBeDeclaredInside => "A function cannot be declared inside another",
        Ht.NotAClosure => "not a closure",
        Ht.AClosureIsWrittenClX => "A closure is written cl(x) { … }",
        Ht.OperandMismatch => "OperandMismatch",
        Ht.Missing => "Missing ;",
        Ht.MissingSemicolon => "MissingSemicolon",
        Ht.MissingComma => "Missing ,",
        Ht.MissingComma2 => "MissingComma",
        Ht.Unclosed2 => "Unclosed",
        Ht.UnclosedDelimiter => "UnclosedDelimiter",
        Ht.ParseError => "ParseError",
        Ht.ForeignSyntax => "ForeignSyntax",
        Ht.UnknownFunction => "UnknownFunction",
        Ht.DuplicateParameter => "DuplicateParameter",
        Ht.DuplicateVariant => "DuplicateVariant",
        Ht.DuplicateLocal => "DuplicateLocal",
        Ht.DuplicateMethod => "DuplicateMethod",
        Ht.StaticAsMethod => "StaticAsMethod",
    }
}

fn hs(t: Ht) Str => st(st_hints + t.i32())
fn hs1(t: Ht, a: Str) Str => stf(st_hints + t.i32(), a, "", "", "")
fn hs2(t: Ht, a: Str, b: Str) Str => stf(st_hints + t.i32(), a, b, "", "")
fn hs3(t: Ht, a: Str, b: Str, c: Str) Str => stf(st_hints + t.i32(), a, b, c, "")
fn hs4(t: Ht, a: Str, b: Str, c: Str, d: Str) Str => stf(st_hints + t.i32(), a, b, c, d)
