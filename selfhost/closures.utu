//! = Closures
//!
//! `cl(x) { … }` is a JavaScript function, held as an externref: the host's
//! `utu.closure_new(fn, env, boolean_result)` closes a JS function over a
//! wasm function and an environment struct of what the closure captures,
//! and records both on it. A call from utu asks the host for them back
//! (`utu.closure_fn`, `utu.closure_env`) and calls the body with `call_ref`,
//! so no JS frame is between, and an `await` in the body can suspend. A JS
//! function that utu did not make has no body: it is called through a
//! `utu.closure_call_N` import per signature (every one is the same host
//! function: wasm imports are monomorphic). A `fun` converts to a `cl` with
//! no environment.
//!
//! The closure's body is a function of its own, (env, params…) → result,
//! checked where the closure is, with the enclosing function's state set
//! aside. It reads its captures from the environment at entry.
//!
//! Captures are copies, except that a variable some closure captures and
//! something assigns is a one-field struct (a box) for its whole life, which
//! the closures share: they see each other's writes and the function's, as
//! stage 0 arranges.

/// By declaration: 1 when its local holds a box.
vec decl_boxed: U8;
/// Pairs: value type, its box struct type.
vec box_types: I32;
/// Pairs: wasm function type of the call, its import.
vec closure_calls: I32;
/// At `[0]`: the closure_new import, or -1.
vec closure_new_func: I32;
/// Pairs: wasm function type of the call, its invoker (see @closure_invoker).
vec closure_invokers: I32;
/// The closure_rec import, the record struct type, and @closure_new's helper, or -1.
vec closure_parts: I32;
/// Fours: a closure's body, its type with the environment exact, the
/// cast of its environment into a local at entry, and that local.
vec closure_bodies: I32;

fn reset_closures() void {
    decl_boxed.resize(decl_kind.len());
    for (0 ..< decl_kind.len()) |d| { decl_boxed[d] = 0; };
    box_types.clear();
    closure_calls.clear();
    env_types.clear();
    closure_new_func.resize(1);
    closure_new_func[0] = -1;
    closure_invokers.clear();
    closure_bodies.clear();
    decl_awaits.clear();
    param_to_host.clear();
    closure_parts.resize(3);
    for (0 ..< 3) |k| { closure_parts[k] = -1; };
}

//! = What closures capture, and which captures are boxes

/// Whether declaration `d` is inside `scope` (in the tree: a DSL's splice has
/// tokens of its own, outside its expansion's).
fn declared_in(d: I32, scope: I32) Bool {
    let n = decl_node[d];
    while (n >= 0) {
        if n == scope { return true; };
        n = parent_of(n);
    };
    false;
}

/// Whether a declaration is a variable of a function body: a local, a
/// parameter, or a name a capture, arm, or `catch` binds.
fn is_local_decl(d: I32) Bool {
    let k = decl_kind[d];
    k == Decl.Local.to_i32() or k == Decl.Param.to_i32() or k == Decl.SelfParam.to_i32() or k == Decl.Capture.to_i32()
        or k == Decl.ClosureParam.to_i32() or k == Decl.ArmBinding.to_i32() or k == Decl.Promoted.to_i32() or k == Decl.Caught.to_i32();
}

/// The variables a closure captures: locals and parameters named inside it
/// and declared outside it, each once, in the order first named.
fn captures_of(closure: I32) I32 {
    let m = vl_begin();
    collect_captures(closure, closure, m);
    vl_end(m);
}

/// Add the captures under `node` to the list being built since `m`.
fn collect_captures(node: I32, closure: I32, m: I32) void {
    if is_kind(node, Node.Identifier) {
        let d = node_decl[node];
        if d >= 0 and is_local_decl(d) and not declared_in(d, closure) and decl_es[d] < 0 {
            let seen = false;
            for (m ..< vl_pending.len()) |i| { if vl_pending[i] == d { seen = true; }; };
            if not seen { vl_add(d); };
        };
        return;
    };
    let c = first_child(node);
    while (c >= 0) {
        collect_captures(c, closure, m);
        c = next_sibling(c);
    };
}

/// Before checking a function body: box each variable of it that a closure
/// in it captures and something assigns where the closure could see it (as
/// stage 0's box-captures): in another closure, after the capture, or in a
/// loop around the closure. A variable assigned only before it is captured
/// is copied into the closure, as any other.
fn mark_boxes(body: I32) void {
    find_closures(body, body);
}

/// By node: 1 when a closure is in it (itself included), counted once for
/// the nodes there are; `find_closures` skips what has none.
vec closure_below: U8;

fn has_closure(node: I32) Bool {
    if closure_below.len() != node_kind.len() {
        closure_below.resize(node_kind.len());
        for (0 ..< node_kind.len()) |n| { closure_below[n] = 0; };
        for (0 ..< file_root.len()) |f| { if file_root[f] >= 0 { mark_closures_below(file_root[f]); }; };
    };
    closure_below[node] == 1;
}

fn mark_closures_below(node: I32) Bool {
    let found = node_kind[node] == Node.Closure_expr.to_i32();
    let c = node_child[node];
    while (c >= 0) {
        if mark_closures_below(c) { found = true; };
        c = node_next[c];
    };
    if found { closure_below[node] = 1; };
    found;
}

/// Mark in @decl_boxed the variables of function body `body` that closures
/// under `node` capture and that must be boxes.
fn find_closures(node: I32, body: I32) void {
    if not has_closure(node) { return; };
    // `let f = cl(…) { … f(…) … };`: the closure captures f before f has a
    // value, so f is a box, filled once the closure exists.
    if is_kind(node, Node.Bind_expr) and is_kind(last_child(node), Node.Closure_expr) and is_kind(first_child(node), Node.Identifier) {
        let d = node_decl[first_child(node)];
        let list = captures_of(last_child(node));
        for (0 ..< vl_len[list]) |i| { if vl_item(list, i) == d { decl_boxed[d] = 1; }; };
        // Its type is the one written, or the closure's own when it spells
        // all of it: a closure naming itself cannot wait for its body's.
        if decl_boxed[d] == 1 and next_sibling(first_child(node)) == last_child(node) and not fully_typed(last_child(node)) {
            let u = self_use(last_child(node), d);
            report(Diag.SelfUntyped, if u >= 0 { u; } else { node; }, decl_name[d]);
        };
    };
    if is_kind(node, Node.Closure_expr) {
        let list = captures_of(node);
        for (0 ..< vl_len[list]) |i| {
            let d = vl_item(list, i);
            // Variables bound by a let, a parameter, a capture, an arm, or a catch.
            let k = decl_kind[d];
            let bindable = k == Decl.Local.to_i32() or k == Decl.Param.to_i32() or k == Decl.SelfParam.to_i32() or k == Decl.ClosureParam.to_i32()
                or k == Decl.Capture.to_i32() or k == Decl.ArmBinding.to_i32() or k == Decl.Promoted.to_i32() or k == Decl.Caught.to_i32();
            if bindable and assigned_after_capture(d, node, body) { decl_boxed[d] = 1; };
        };
    };
    let c = first_child(node);
    while (c >= 0) {
        find_closures(c, body);
        c = next_sibling(c);
    };
}

/// Whether something under `node` assigns `d` where `closure`, which
/// captures it, could see the write.
fn assigned_after_capture(d: I32, closure: I32, node: I32) Bool {
    if is_kind(node, Node.Assign_expr) {
        let target = first_child(node);
        if is_kind(target, Node.Identifier) and node_decl[target] == d and write_seen(d, closure, node) { return true; };
    };
    let c = first_child(node);
    while (c >= 0) {
        if assigned_after_capture(d, closure, c) { return true; };
        c = next_sibling(c);
    };
    false;
}

/// Whether `write`, to variable d, can be seen by `closure`, which captured d.
fn write_seen(d: I32, closure: I32, write: I32) Bool {
    let decl = decl_node[d];
    // In a closure outside d's scope's own code (one not around d's declaration).
    let p = parent_of(write);
    while (p >= 0) {
        if is_kind(p, Node.Closure_expr) and not node_contains(p, decl) { return true; };
        p = parent_of(p);
    };
    // After the capture (or in the closure), or of the closure itself (`f = cl() { … f … }`).
    if tok_start[node_first[write]] > tok_start[node_first[closure]] or node_contains(write, closure) { return true; };
    // In a loop around the closure, within d's scope.
    p = parent_of(closure);
    while (p >= 0 and not node_contains(p, decl)) {
        if (is_kind(p, Node.For_expr) or is_kind(p, Node.While_expr) or is_kind(p, Node.Loop_match_expr)) and node_contains(p, write) { return true; };
        p = parent_of(p);
    };
    false;
}

/// Whether a closure literal spells its whole type: each parameter's and its result's.
fn fully_typed(closure: I32) Bool {
    let list = child_of_kind(closure, Node.Closure_param_list);
    let p = if list >= 0 { first_child(list); } else { -1; };
    while (p >= 0) {
        if next_sibling(first_child(p)) < 0 { return false; };
        p = next_sibling(p);
    };
    child_of_kind(closure, Node.Return_type) >= 0;
}

/// The first name under `node` that refers to `d`, or -1.
fn self_use(node: I32, d: I32) I32 {
    if is_kind(node, Node.Identifier) and node_decl[node] == d { return node; };
    let c = first_child(node);
    while (c >= 0) {
        let u = self_use(c, d);
        if u >= 0 { return u; };
        c = next_sibling(c);
    };
    -1;
}

/// Whether node `outer` spans node `inner`.
fn node_contains(outer: I32, inner: I32) Bool {
    inner >= 0 and node_first[outer] <= node_first[inner] and node_last[inner] <= node_last[outer];
}

/// The box struct of a value type: one mutable field.
fn box_type(vt: I32) I32 {
    let i = 0;
    while (i < box_types.len()) {
        if box_types[i] == vt { return box_types[i + 1]; };
        i += 2;
    };
    let h = struct_type(-1, false);
    ht_a[h] = ht_fields.len();
    struct_field(h, storage(vt), true);
    box_types.push(vt);
    box_types.push(h);
    h;
}

/// Store the value on the stack (since `m`) as declaration `d`'s: in its
/// local, or in a new box its local holds.
fn bind_value(d: I32, t: I32, m: I32) void {
    let vt = repr(t);
    if vt >= vt_tuple {
        // A tuple: a local each, in a row from decl_local.
        let list = vt - vt_tuple;
        let first = new_local(vl_item(list, 0));
        for (1 ..< vl_len[list]) |i| { new_local(vl_item(list, i)); };
        decl_local[d] = first;
        set_tuple(first, list, m);
        return;
    };
    if decl_boxed[d] == 1 {
        let h = box_type(vt);
        w_node(Op.StructNew, vt_ref(h, false), h, 0, m);
        let local = new_local(vt_ref(h, true));
        decl_local[d] = local;
        w_node(Op.LocalSet, vt_none, local, 0, m);
        return;
    };
    let local = new_local(vt);
    decl_local[d] = local;
    w_node(Op.LocalSet, vt_none, local, 0, m);
}

/// Bind `d` (of type `t`) to the value in `local`: d is that local, or,
/// when boxed, a new box filled from it.
fn bind_local(d: I32, t: I32, local: I32) void {
    decl_ty[d] = t;
    if decl_boxed[d] == 0 {
        decl_local[d] = local;
        return;
    };
    let vt = repr(t);
    let m = w_mark();
    w_get(cur_locals[local], local);
    if cur_locals[local] != vt { w_node(Op.RefAsNonNull, vt, 0, 0, m); };
    bind_value(d, t, m);
}

/// The tuple on the stack (since `m`, of value types `list`) into the locals
/// from `first` on (the last on top).
fn set_tuple(first: I32, list: I32, m: I32) void {
    let k = vl_len[list] - 1;
    while (k >= 0) {
        w_leaf(Op.LocalSet, vt_none, first + k, 0);
        k -= 1;
    };
    w_node(Op.Seq, vt_none, 0, 0, m);
}

/// Push the value of declaration `d` (of type `t`).
fn read_value(d: I32, t: I32) void {
    let vt = repr(t);
    // A name bound to a value that never arrives (`let z = fatal;`).
    if vt == vt_unreachable {
        w_leaf(Op.Unreachable, vt_unreachable, 0, 0);
        return;
    };
    if vt >= vt_tuple {
        let list = vt - vt_tuple;
        for (0 ..< vl_len[list]) |i| { w_leaf(Op.LocalGet, vl_item(list, i), decl_local[d] + i, 0); };
        return;
    };
    if decl_boxed[d] == 1 {
        let h = box_type(vt);
        let m = w_mark();
        w_leaf(Op.LocalGet, vt_ref(h, true), decl_local[d], 0);
        w_node(Op.StructGet, vt, h, 0, m);
        return;
    };
    w_leaf(Op.LocalGet, vt, decl_local[d], 0);
}

/// A write to `d` begins: a box is pushed first, its value to follow (see
/// @write_end).
fn write_begin(d: I32, t: I32) void {
    if decl_boxed[d] == 1 and repr(t) < vt_tuple { w_leaf(Op.LocalGet, vt_ref(box_type(repr(t)), true), decl_local[d], 0); };
}

/// A write to `d` ends: the value on the stack since `m` goes into its box
/// (pushed by @write_begin) or its local.
fn write_end(d: I32, t: I32, m: I32) void {
    if repr(t) >= vt_tuple {
        set_tuple(decl_local[d], repr(t) - vt_tuple, m);
    } else if decl_boxed[d] == 1 {
        w_node(Op.StructSet, vt_none, box_type(repr(t)), 0, m);
    } else {
        w_node(Op.LocalSet, vt_none, decl_local[d], 0, m);
    };
}

/// A boxed parameter: its value moves into a box at the function's start.
/// Returns the statements' node, or -1 when no parameter is boxed.
fn box_params(decls: I32, params: I32) I32 {
    let m = w_mark();
    let any = false;
    for (0 ..< vl_len[decls]) |i| {
        let d = vl_item(decls, i);
        if decl_boxed[d] == 1 {
            any = true;
            let t = vl_item(params, i);
            let mb = w_mark();
            w_leaf(Op.LocalGet, repr(t), decl_local[d], 0);
            bind_value(d, t, mb);
        };
    };
    if not any { return -1; };
    w_node(Op.Seq, vt_none, 0, 0, m);
    w_pop();
}

//! = Setting the enclosing function aside

vec saved_locals: I32;
/// Five per saved function: its defers' start, its locals' start in
/// @saved_locals, `cur_params`, `next_label`, and its loops' start in @saved_loops.
vec saved_marks: I32;
/// The loop stacks' entries, six per loop.
vec saved_loops: I32;

/// Set the enclosing function's checking state aside (its locals, labels,
/// loops, and defers), to check a closure's body as a function of its own.
fn save_function() void {
    saved_marks.push(function_defers[0]);
    function_defers[0] = defer_node.len();
    saved_marks.push(saved_locals.len());
    for (0 ..< cur_locals.len()) |i| { saved_locals.push(cur_locals[i]); };
    saved_marks.push(cur_params[0]);
    saved_marks.push(next_label[0]);
    saved_marks.push(hide_loops());
    cur_locals.clear();
    next_label[0] = 0;
}

/// Set the loops aside, so that none is in reach; where they went in
/// @saved_loops, for @show_loops.
fn hide_loops() I32 {
    let at = saved_loops.len();
    for (0 ..< loop_break.len()) |i| {
        saved_loops.push(loop_break[i]);
        saved_loops.push(loop_continue[i]);
        saved_loops.push(loop_state[i]);
        saved_loops.push(loop_state_type[i]);
        saved_loops.push(loop_defers[i]);
        saved_loops.push(loop_break_defers[i]);
    };
    clear_loops();
    at;
}

/// Bring back the loops @hide_loops set aside at `at`.
fn show_loops(at: I32) void {
    clear_loops();
    let i = at;
    while (i < saved_loops.len()) {
        loop_break.push(saved_loops[i]);
        loop_continue.push(saved_loops[i + 1]);
        loop_state.push(saved_loops[i + 2]);
        loop_state_type.push(saved_loops[i + 3]);
        loop_defers.push(saved_loops[i + 4]);
        loop_break_defers.push(saved_loops[i + 5]);
        i += 6;
    };
    saved_loops.resize(at);
}

/// Bring back what @save_function set aside.
fn restore_function() void {
    let n = saved_marks.len();
    let loops_at = saved_marks[n - 1];
    let label = saved_marks[n - 2];
    let params = saved_marks[n - 3];
    let locals_at = saved_marks[n - 4];
    function_defers[0] = saved_marks[n - 5];
    saved_marks.resize(n - 5);
    cur_locals.clear();
    for (locals_at ..< saved_locals.len()) |i| { cur_locals.push(saved_locals[i]); };
    saved_locals.resize(locals_at);
    cur_params[0] = params;
    next_label[0] = label;
    show_loops(loops_at);
}

//! = Closure literals

/// `cl(x: T) R { … }`: its parameter types (annotated, else from the
/// closure type expected), its result type (annotated, else expected, else
/// its body's), and the closure built.
/// Closure environments made so far: closures capturing values of the same
/// types share one (and so one function type for their bodies).
vec env_types: I32;

fn same_fields(t: I32, vts: Array[I32]) Bool {
    for (0 ..< vts.len()) |k| { if field_storage(t, k) != vts[k] { return false; }; };
    true;
}

/// The environment struct of fields `vts`.
fn env_type(vts: Array[I32]) I32 {
    for (0 ..< env_types.len()) |i| {
        let t = env_types[i];
        if ht_b[t] == vts.len() and same_fields(t, vts) { return t; };
    };
    let env = struct_type(-1, false);
    for (vts) |vt| { struct_field(env, vt, false); };
    env_types.push(env);
    env;
}

fn check_closure(node: I32, expect: I32, cx: Cx) I32 {
    let exp = if expect >= 0 and ty_is(expect, Ty.Nullable) { ty_a[expect]; } else { expect; };
    let expected = if exp >= 0 and (ty_is(exp, Ty.Closure) or ty_is(exp, Ty.Fun)) { exp; } else { -1; };
    // Parameters.
    let list = first_child(node);
    if not is_kind(list, Node.Closure_param_list) { list = -1; };
    let n = child_count(list);
    let ptypes = Array[I32].new(n, 0);
    let pd = Array[I32].new(n, 0);
    let i = 0;
    let p = if list >= 0 { first_child(list); } else { -1; };
    while (p >= 0) {
        let t_node = next_sibling(first_child(p));
        let t = if t_node >= 0 { type_of(t_node, cx.inst); }
            else if expected >= 0 and i < vl_len[ty_a[expected]] { vl_item(ty_a[expected], i); }
            else { -1; };
        if t < 0 {
            // In a file with host declarations, a closure where something
            // else is wanted (as `Str`): that mismatch, not "unsupported".
            if has_foreign() and exp >= 0 and not is_foreign(exp) and not ty_is(exp, Ty.Error) {
                let mt = vl_begin();
                let q = first_child(list);
                while (q >= 0) {
                    let q_type = next_sibling(first_child(q));
                    vl_add(if q_type >= 0 { type_of(q_type, cx.inst); } else { ty_error(); });
                    q = next_sibling(q);
                };
                let r_node = child_of_kind(node, Node.Return_type);
                mismatch(node, expect, ty(Ty.Closure, vl_end(mt), if r_node >= 0 { type_of(r_node, cx.inst); } else { ty_error(); }));
                return error_value();
            };
            report(Diag.ClosureParamType, p, word_of(first_child(p)));
            diag_label("cl(" + word_text(word_of(first_child(p))) + ": T)");
            // Where a closure isn't wanted, that mismatch would only repeat this.
            if exp >= 0 and expected < 0 { return error_value(); };
            t = ty_error();
        };
        ptypes[i] = t;
        pd[i] = node_decl[first_child(p)];
        i += 1;
        p = next_sibling(p);
    };
    let ret_node = child_of_kind(node, Node.Return_type);
    let result = if ret_node >= 0 { type_of(ret_node, cx.inst); } else if expected >= 0 { ty_b[expected]; } else { -1; };
    let body_node = last_child(node);
    // What it captures, and their types now.
    let caps = captures_of(node);
    let ncap = vl_len[caps];
    let cap_types = Array[I32].new(ncap, 0);
    let cap_locals = Array[I32].new(ncap, 0);
    for (0 ..< ncap) |k| {
        cap_types[k] = decl_ty[vl_item(caps, k)];
        cap_locals[k] = decl_local[vl_item(caps, k)];
        if ty_is(cap_types[k], Ty.Tuple) {
            report2(Diag.TupleLet, node, decl_name[vl_item(caps, k)], cap_types[k], 2);
            return error_value();
        };
    };
    // The environment: the captured values (boxes for boxed variables).
    let env_vts = Array[I32].new(ncap, 0);
    for (0 ..< ncap) |k| {
        let d = vl_item(caps, k);
        let vt = repr(cap_types[k]);
        env_vts[k] = if decl_boxed[d] == 1 { vt_ref(box_type(vt), true); } else { storage(vt); };
    };
    // One captured GC reference is the environment itself: no struct.
    let single = ncap == 1 and gc_ref(env_vts[0]);
    let env = if single { -1; } else { env_type(env_vts); };
    // The body, as a function of its own: (env, params…). Its environment
    // is an anyref, cast at entry, so that every body of a signature has one
    // function type, which a call from utu tests for (@closure_invoker).
    let env_vt = if single { env_vts[0]; } else { vt_ref(env, false); };
    let mp2 = vl_begin();
    vl_add(vt_anyref);
    for (0 ..< n) |k| { vl_add(repr(ptypes[k])); };
    let wasm_params = vl_end(mp2);
    save_function();
    new_local(vt_anyref);
    for (0 ..< n) |k| {
        decl_local[pd[k]] = new_local(repr(ptypes[k]));
        decl_ty[pd[k]] = ptypes[k];
    };
    cur_params[0] = cur_locals.len();
    mark_boxes(body_node);
    let mbody = w_mark();
    // Prologue: the environment, cast; each capture from it (one alone is it).
    let env_local = new_local(env_vt);
    let mc = w_mark();
    w_leaf(Op.LocalGet, vt_anyref, 0, 0);
    w_node(Op.RefCast, env_vt, env_vt, 0, mc);
    let cast = w_node(Op.LocalSet, vt_none, env_local, 0, mc);
    if single { decl_local[vl_item(caps, 0)] = env_local; };
    for (0 ..< if single { 0; } else { ncap; }) |k| {
        let d = vl_item(caps, k);
        let local = new_local(env_vts[k]);
        let mg = w_mark();
        w_leaf(Op.LocalGet, env_vt, env_local, 0);
        w_node(Op.StructGet, env_vts[k], env, k, mg);
        w_node(Op.LocalSet, vt_none, local, 0, mg);
        decl_local[d] = local;
    };
    let boxed_params = box_params(types_list(pd, n), types_list(ptypes, n));
    if boxed_params >= 0 { w_push(boxed_params); };
    let lcx = Cx { inst: cx.inst, fi: cx.fi, result: if result >= 0 { result; } else { -1; } };
    let outer_body = body_block[0];
    body_block[0] = body_node;
    let actual = check_block(body_node, lcx.result, lcx);
    body_block[0] = outer_body;
    if result < 0 { result = if ty_is(actual, Ty.Never) { ty_void(); } else { actual; }; }
    else if ty_is(result, Ty.Void) {
        // A closure that says nothing of its result, where `cl(…) void` is
        // expected, ends without a value (with `void` written, a value is dropped).
        if ret_node < 0 and not ty_is(actual, Ty.Void) and not ty_is(actual, Ty.Never) and not ty_is(actual, Ty.Error) {
            let before = diag_kind.len();
            mismatch(body_node, result, actual);
            // Of the type expected, the closure is then mistaken in consequence.
            if ret_node < 0 and expected >= 0 { fold_into(mismatch_since(before, body_node)); };
        };
        drop_value(actual);
    }
    else { coerce(actual, result, body_node); };
    w_node(Op.Seq, repr(result), 0, 0, mbody);
    let f = new_func(FuncKind.Defined, func_type(wasm_params, vl_of_result(repr(result))));
    // Its type with the environment exact, for @lean_closures.
    let me2 = vl_begin();
    vl_add(env_vt);
    for (0 ..< n) |k| { vl_add(repr(ptypes[k])); };
    closure_bodies.push(f);
    closure_bodies.push(func_type(vl_end(me2), vl_of_result(repr(result))));
    closure_bodies.push(cast);
    closure_bodies.push(env_local);
    func_debug_name[f] = name_add("closure");
    func_body[f] = w_pop();
    record_locals(f, cur_params[0]);
    restore_function();
    // The enclosing function's view of the captures again.
    for (0 ..< ncap) |k| {
        decl_local[vl_item(caps, k)] = cap_locals[k];
        decl_ty[vl_item(caps, k)] = cap_types[k];
    };
    // closure_new(ref.func f, env, boolean result)
    let m = w_mark();
    w_leaf(Op.RefFunc, vt_ref(func_type_of[f], false), f, 0);
    let me = w_mark();
    for (0 ..< ncap) |k| {
        let d = vl_item(caps, k);
        if decl_boxed[d] == 1 { w_leaf(Op.LocalGet, env_vts[k], decl_local[d], 0); }
        else { read_value(d, cap_types[k]); };
    };
    if not single { w_node(Op.StructNew, vt_ref(env, false), env, 0, me); };
    w_i32((if result == prelude(Prelude.Bool) { 1; } else { 0; }) + (if single { 2; } else { 0; }));
    w_node(Op.Call, vt_externref, closure_new(), 0, m);
    ty(Ty.Closure, types_list(ptypes, n), result);
}

/// Whether a value type is a reference to a struct or an array (an `anyref`,
/// which closure_new's environment is).
fn gc_ref(vt: I32) Bool {
    if vt < vt_defined or vt >= vt_tuple { return false; };
    let kind = ht_kind[(vt - vt_defined) / 2];
    kind == Heap.Struct.to_i32() or kind == Heap.Array.to_i32();
}

/// The first `n` of `ts`, as a list.
fn types_list(ts: Array[I32], n: I32) I32 {
    let m = vl_begin();
    for (0 ..< n) |k| { vl_add(ts[k]); };
    vl_end(m);
}

/// The type a closure literal's annotations give it, when they give all of
/// it (every parameter's type and the result's); else Error.
fn closure_syntax_type(node: I32, inst: I32) I32 {
    let m = vl_begin();
    let result = -1;
    let c = first_child(node);
    while (c >= 0) {
        if is_kind(c, Node.Closure_param_list) {
            let p = first_child(c);
            while (p >= 0) {
                let t_node = next_sibling(first_child(p));
                if t_node < 0 {
                    vl_pending.resize(m);
                    return ty_error();
                };
                vl_add(type_of(t_node, inst));
                p = next_sibling(p);
            };
        } else if is_kind(c, Node.Return_type) {
            result = type_of(c, inst);
        };
        c = next_sibling(c);
    };
    if result < 0 {
        vl_pending.resize(m);
        return ty_error();
    };
    ty(Ty.Closure, vl_end(m), result);
}

/// `(fn: funcref, env: anyref, flags: i32) → externref`: a closure, made by
/// the host's `utu.closure_new(fn, env, flags, record)`, the record a struct
/// of fn and env the host keeps on it for @closure_invoker. Flags: 1, the
/// result is a Bool; 2, the environment is there even when null.
fn closure_new() I32 {
    if closure_parts[2] >= 0 { return closure_parts[2]; };
    let m = vl_begin();
    vl_add(vt_funcref);
    vl_add(vt_anyref);
    vl_add(vt_i32);
    let ps = vl_end(m);
    let m4 = vl_begin();
    vl_add(vt_funcref);
    vl_add(vt_anyref);
    vl_add(vt_i32);
    vl_add(vt_externref);
    closure_new_func[0] = add_import_func(name_add("utu"), name_add("closure_new"), func_type(vl_end(m4), vl_one(vt_externref)));
    let f = helper(ps, vl_one(vt_externref), vl_empty(), "closure.new");
    closure_parts[2] = f;
    let rec = closure_record();
    let mc = w_mark();
    w_get(vt_funcref, 0);
    w_get(vt_anyref, 1);
    w_get(vt_i32, 2);
    let mr = w_mark();
    w_get(vt_funcref, 0);
    w_get(vt_anyref, 1);
    w_node(Op.StructNew, vt_ref(rec, false), rec, 0, mr);
    w_node(Op.ExternConvertAny, vt_extern, 0, 0, mr);
    w_node(Op.Call, vt_externref, closure_new_func[0], 0, mc);
    func_body[f] = w_pop();
    f;
}

/// The struct a closure's record is: its funcref and its environment.
fn closure_record() I32 {
    if closure_parts[1] >= 0 { return closure_parts[1]; };
    let h = struct_type(-1, false);
    struct_field(h, vt_funcref, false);
    struct_field(h, vt_anyref, false);
    closure_parts[1] = h;
    h;
}

/// The import that calls closures of a signature: (closure, params…) → result.
fn closure_call(t: I32) I32 {
    let m = vl_begin();
    vl_add(vt_externref);
    let params = ty_a[t];
    for (0 ..< vl_len[params]) |i| { vl_add(repr(vl_item(params, i))); };
    let ft = func_type(vl_end(m), vl_of_result(repr(ty_b[t])));
    let i = 0;
    while (i < closure_calls.len()) {
        if closure_calls[i] == ft { return closure_calls[i + 1]; };
        i += 2;
    };
    let f = add_import_func(name_add("utu"), name_add("closure_call_" + (closure_calls.len() / 2).to_str()), ft);
    closure_calls.push(ft);
    closure_calls.push(f);
    f;
}

/// A call of a closure value: the closure, the arguments, then its invoker.
fn call_closure(callee: I32, t: I32, args: I32, m: I32, at: I32, cx: Cx) I32 {
    check_expr(callee, t, cx);
    if not check_args(ty_a[t], args, 0, at, cx) {
        return error_since(m);
    };
    w_node(Op.Call, repr(ty_b[t]), closure_invoker(t), 0, m);
    ty_b[t];
}

/// `utu.closure_rec(closure: externref) → externref`: the record
/// @closure_new gave the host, or null for a JS function utu did not make.
fn closure_rec() I32 {
    if closure_parts[0] >= 0 { return closure_parts[0]; };
    let f = add_import_func(name_add("utu"), name_add("closure_rec"), func_type(vl_one(vt_externref), vl_one(vt_externref)));
    closure_parts[0] = f;
    f;
}

/// The function that calls closures of signature `t`, (closure, params…) →
/// result: a closure utu made runs its body by `call_ref` (with its
/// environment, or, a decayed `fun`, without), any other JS function through
/// the closure_call import. The host only hands back the record, so no JS
/// frame is between the call and the body, and the body can suspend.
fn closure_invoker(t: I32) I32 {
    let js = closure_call(t);
    let ft = func_type_of[js];
    let i = 0;
    while (i < closure_invokers.len()) {
        if closure_invokers[i] == ft { return closure_invokers[i + 1]; };
        i += 2;
    };
    let params = ty_a[t];
    let np = vl_len[params];
    let rvt = repr(ty_b[t]);
    let me = vl_begin();
    vl_add(vt_anyref);
    for (0 ..< np) |k| { vl_add(repr(vl_item(params, k))); };
    let env_sig = func_type(vl_end(me), vl_of_result(rvt));
    let rec_vt = vt_ref(closure_record(), true);
    let ml = vl_begin();
    vl_add(rec_vt);
    vl_add(vt_funcref);
    let f = helper(ht_a[ft], ht_b[ft], vl_end(ml), "closure.call");
    closure_invokers.push(ft);
    closure_invokers.push(f);
    let r = np + 1;
    let m = w_mark();
    // r = the record (null: not utu's); its funcref, when there is one.
    let ms = w_mark();
    w_get(vt_externref, 0);
    w_node(Op.Call, vt_externref, closure_rec(), 0, ms);
    w_node(Op.AnyConvertExtern, vt_anyref, 0, 0, ms);
    w_node(Op.RefCast, rec_vt, rec_vt, 0, ms);
    w_node(Op.LocalSet, vt_none, r, 0, ms);
    let mi = w_mark();
    let mc = w_mark();
    w_get(rec_vt, r);
    w_node(Op.RefIsNull, vt_i32, 0, 0, mc);
    w_i32_op(i32_eqz, mc);
    let mt = w_mark();
    let mf = w_mark();
    w_get(rec_vt, r);
    w_node(Op.StructGet, vt_funcref, closure_record(), 0, mf);
    w_node(Op.LocalSet, vt_none, r + 1, 0, mf);
    invoker_arm(env_sig, params, rvt, true);
    invoker_arm(fun_heap(t), params, rvt, false);
    w_node(Op.Seq, vt_none, 0, 0, mt);
    w_node(Op.If, vt_none, 1, 0, mi);
    let mj = w_mark();
    w_get(vt_externref, 0);
    for (0 ..< np) |k| { w_get(repr(vl_item(params, k)), k + 1); };
    w_node(Op.Call, rvt, js, 0, mj);
    w_node(Op.Seq, rvt, 0, 0, m);
    func_body[f] = w_pop();
    f;
}

/// In @closure_invoker: when the body is of function type `sig`, return its
/// call (given the environment when `env`).
fn invoker_arm(sig: I32, params: I32, rvt: I32, env: Bool) void {
    let np = vl_len[params];
    let r = np + 1;
    let fl = np + 2;
    let vt = vt_ref(sig, false);
    let mi = w_mark();
    let mc = w_mark();
    w_get(vt_funcref, fl);
    w_node(Op.RefTest, vt_i32, vt, 0, mc);
    let mt = w_mark();
    let mr = w_mark();
    if env {
        let me = w_mark();
        w_get(vt_ref(closure_record(), true), r);
        w_node(Op.StructGet, vt_anyref, closure_record(), 1, me);
    };
    for (0 ..< np) |k| { w_get(repr(vl_item(params, k)), k + 1); };
    let mf = w_mark();
    w_get(vt_funcref, fl);
    w_node(Op.RefCast, vt, vt, 0, mf);
    w_node(Op.CallRef, rvt, sig, 0, mr);
    w_node(Op.Return, vt_unreachable, 0, 0, mr);
    w_node(Op.Seq, vt_none, 0, 0, mt);
    w_node(Op.If, vt_none, if env { 2; } else { 3; }, 0, mi);
}

/// A `fun` (on the stack since `m`) where a `cl` of the same signature is
/// expected: a closure of it with no environment.
fn decay_fun(fun_t: I32, m: I32) void {
    w_leaf(Op.RefNull, vt_anyref, vt_anyref, 0);
    w_i32(if ty_b[fun_t] == prelude(Prelude.Bool) { 1; } else { 0; });
    w_node(Op.Call, vt_externref, closure_new(), 0, m);
}

/// The closure imports the module has, for the host section.
fn write_closure_json() void {
    let any = closure_new_func[0] >= 0 and func_live[closure_new_func[0]] == 1;
    let calls = false;
    let i = 1;
    while (i < closure_calls.len()) {
        if func_live[closure_calls[i]] == 1 { calls = true; };
        i += 2;
    };
    if not any and not calls { return; };
    json_text("\"closures\":{\"new\":");
    json_text(if any { "true"; } else { "false"; });
    json_text(",\"calls\":[");
    let first = true;
    i = 1;
    while (i < closure_calls.len()) {
        let f = closure_calls[i];
        if func_live[f] == 1 {
            if not first { json_byte(44); };
            first = false;
            json_byte(34);
            let name = func_field_name[f];
            for (0 ..< name_len[name]) |k| { json_byte(names[name_start[name] + k]); };
            json_byte(34);
        };
        i += 2;
    };
    json_text("]}");
}

//! = Closures the host calls
//!
//! The host calls a closure through its JS function, a frame JSPI cannot
//! suspend through: such a closure may not await. Reported where a closure
//! written in the call (or bound by a `let`) is given to the host: an `@es`
//! or declared host function, or a utu function that hands the parameter on
//! to one (`Promise.then`, `Stream.map`). A closure value given to the host
//! that awaits fails when it suspends, at run time.

/// By function declaration: 1 when its body may await (itself, or a function
/// it calls by name), 2 when not, 3 while it is looked at.
vec decl_awaits: U8;
/// By parameter declaration: 1 when its function hands it to the host, 2 when not.
vec param_to_host: U8;

/// Report a closure `arg` that awaits, given to the host.
fn host_callback(arg: I32) void {
    let c = closure_node(arg);
    if c < 0 { return; };
    let at = awaits_in(last_child(c));
    if at < 0 { return; };
    report(Diag.AwaitInClosure, at, -1);
    diag_label(if is_kind(at, Node.Await_expr) { "suspends"; } else { "may suspend"; });
    diag_place_tokens(Extra.Related, node_first[c], node_first[c], "the host calls it");
    diag_note("A stack suspends only through utu's calls, not the host's; await outside the closure");
}

/// The arguments of a call of function `decl` (-1: a host function's), from
/// its parameter `first`: each closure the host is given, reported when it awaits.
fn host_callbacks(decl: I32, args: I32, first: I32) void {
    if args < 0 { return; };
    let decls = if decl >= 0 { param_decls(decl); } else { -1; };
    let i = first;
    let a = first_child(args);
    while (a >= 0) {
        if closure_node(a) >= 0 and (decl < 0 or (i < vl_len[decls] and to_host(decl, vl_item(decls, i)))) { host_callback(a); };
        i += 1;
        a = next_sibling(a);
    };
}

/// Whether function `decl` hands its parameter `p` to the host: its body is
/// `@ir` or `@es`, or it passes p to an `@es` function.
fn to_host(decl: I32, p: I32) Bool {
    if p < 0 { return false; };
    if param_to_host.len() < decl_kind.len() {
        let n = param_to_host.len();
        param_to_host.resize(decl_kind.len());
        for (n ..< decl_kind.len()) |d| { param_to_host[d] = 0; };
    };
    if param_to_host[p] == 0 {
        let body = fn_body(decl);
        let only = first_child(body);
        let dsl = only >= 0 and next_sibling(only) < 0 and is_kind(only, Node.Dsl_expr);
        param_to_host[p] = if dsl or passes_to_es(body, p) { 1; } else { 2; };
    };
    param_to_host[p] == 1;
}

/// Whether, under `node`, an `@es` function is called with `p` as an argument.
fn passes_to_es(node: I32, p: I32) Bool {
    if is_kind(node, Node.Call_expr) {
        let callee = first_child(node);
        let d = if is_kind(callee, Node.Identifier) { node_decl[callee]; } else { -1; };
        if d >= 0 and decl_node[d] >= 0 and is_es(last_child(decl_node[d])) {
            let args = next_sibling(callee);
            let a = if args >= 0 { first_child(args); } else { -1; };
            while (a >= 0) {
                if is_kind(a, Node.Identifier) and node_decl[a] == p { return true; };
                a = next_sibling(a);
            };
        };
    };
    let c = first_child(node);
    while (c >= 0) {
        if passes_to_es(c, p) { return true; };
        c = next_sibling(c);
    };
    false;
}

/// The first `await` under `node`, or call of a function by name that may
/// await; -1 when none. (A closure under it is a body of its own.)
fn awaits_in(node: I32) I32 {
    if is_kind(node, Node.Await_expr) { return node; };
    if is_kind(node, Node.Closure_expr) { return -1; };
    if is_kind(node, Node.Call_expr) and is_kind(first_child(node), Node.Identifier) {
        let d = node_decl[first_child(node)];
        if d >= 0 and decl_is(d, Decl.Fn) and fn_awaits(d) { return node; };
    };
    let c = first_child(node);
    while (c >= 0) {
        let at = awaits_in(c);
        if at >= 0 { return at; };
        c = next_sibling(c);
    };
    -1;
}

/// Whether function `decl` may await (see @decl_awaits).
fn fn_awaits(decl: I32) Bool {
    if decl_awaits.len() < decl_kind.len() {
        let n = decl_awaits.len();
        decl_awaits.resize(decl_kind.len());
        for (n ..< decl_kind.len()) |d| { decl_awaits[d] = 0; };
    };
    if decl_awaits[decl] == 0 {
        decl_awaits[decl] = 3;
        decl_awaits[decl] = if awaits_in(fn_body(decl)) >= 0 { 1; } else { 2; };
    };
    decl_awaits[decl] == 1;
}

//! = Small builds that never await

/// At `-O small`, a module with no `await` calls closures through the host
/// (the closure_call imports) and makes them without records, as before the
/// invokers: nothing can suspend, and that is the smaller module. So does any
/// module that calls no closure. Before the sweep, so the invokers and
/// @closure_new's helper are left out.
fn lean_closures() void {
    // (With no call of a closure in utu, nothing reads the records, at any level.)
    if (optimize_level[0] != 1 or await_types.len() > 0) and closure_invokers.len() > 0 { return; };
    let helper_ = closure_parts[2];
    let plain = -1;
    if helper_ >= 0 {
        let m = vl_begin();
        vl_add(vt_funcref);
        vl_add(vt_anyref);
        vl_add(vt_i32);
        plain = add_import_func(name_add("utu"), name_add("closure_new"), func_type(vl_end(m), vl_one(vt_externref)));
        closure_new_func[0] = plain;
    };
    for (0 ..< func_kind.len()) |f| {
        if func_kind[f] == FuncKind.Defined.to_i32() and func_body[f] >= 0 and f != helper_ and not is_invoker(f) { retarget(func_body[f], helper_, plain); };
    };
    for (0 ..< glob_init.len()) |g| { if glob_init[g] >= 0 { retarget(glob_init[g], helper_, plain); }; };
    // The bodies, called by the host alone, take their environments exact: no cast.
    // Their reads of the cast's local read the parameter.
    let i = 0;
    while (i < closure_bodies.len()) {
        let f = closure_bodies[i];
        func_type_of[f] = closure_bodies[i + 1];
        let set = closure_bodies[i + 2];
        w_op[set] = Op.Nop.to_i32();
        w_count[set] = 0;
        read_param(func_body[f], closure_bodies[i + 3]);
        i += 4;
    };
    closure_bodies.clear();
    // Once: a second encoding finds nothing left to retarget.
    closure_parts[2] = -1;
}

fn is_invoker(f: I32) Bool {
    let i = 1;
    while (i < closure_invokers.len()) {
        if closure_invokers[i] == f { return true; };
        i += 2;
    };
    false;
}

/// Under `node`: calls of an invoker go to its closure_call import, and of
/// @closure_new's helper to `plain`.
fn retarget(node: I32, helper_: I32, plain: I32) void {
    if w_op[node] == Op.Call.to_i32() {
        let f = w_a[node];
        if f == helper_ { w_a[node] = plain; }
        else if is_invoker(f) { w_a[node] = closure_call_of(func_type_of[f]); };
    };
    for (0 ..< w_count[node]) |i| { retarget(w_kid(node, i), helper_, plain); };
}

/// Under `node`: reads of local `l` read local 0.
fn read_param(node: I32, l: I32) void {
    if w_op[node] == Op.LocalGet.to_i32() and w_a[node] == l { w_a[node] = 0; };
    for (0 ..< w_count[node]) |i| { read_param(w_kid(node, i), l); };
}

/// The closure_call import of wasm function type `ft`.
fn closure_call_of(ft: I32) I32 {
    let i = 0;
    while (i < closure_calls.len()) {
        if closure_calls[i] == ft { return closure_calls[i + 1]; };
        i += 2;
    };
    -1;
}
