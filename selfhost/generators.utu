//! = Generators
//!
//! `fn squares(n: I32) yield I32 { for (0 ..< n) |i| { yield i * i; }; }` is
//! not a function: `for (squares(10)) |x| { body }` expands the generator's
//! body in place of the loop, with the consumer's body at each `yield`:
//!
//! ```
//! (the arguments into the generator's parameters)
//! block $whole                      ; break in the body, return in the generator
//!   … the generator's code …
//!   block $resume                   ; continue in the body
//!     x = value; body
//!   end
//!   …
//! end
//! ```
//!
//! There is no frame, no closure, and no call per value. The generator's
//! declarations are the expansion's locals, set aside and restored when a
//! consumer body expands the same generator again inside it.

// The expansions being checked, innermost last: what each yield needs.
/// The label a `return;` in the generator and a `break` in the body leave.
vec gen_whole: I32;
/// The consumer's capture declaration, or -1.
vec gen_capture: I32;
/// The consumer's block.
vec gen_body: I32;
/// The yielded type.
vec gen_type: I32;
/// The consumer's checking context.
vec gen_cx_inst: I32;
vec gen_cx_fi: I32;
vec gen_cx_result: I32;
/// The generator's declaration.
vec gen_decl: I32;
/// The defers pending when the generation began.
vec gen_defers: I32;
/// For a recursive generation, its index in `rec_*`; else -1.
vec gen_rec: I32;

/// An expansion begins: what its yields need, on the stacks above.
fn begin_expansion(whole: I32, cap: I32, body: I32, elem: I32, cx: Cx, gen: I32, rec: I32) void {
    gen_whole.push(whole);
    gen_capture.push(cap);
    gen_body.push(body);
    gen_type.push(elem);
    gen_cx_inst.push(cx.inst);
    gen_cx_fi.push(cx.fi);
    gen_cx_result.push(cx.result);
    gen_decl.push(gen);
    gen_defers.push(defer_node.len());
    gen_rec.push(rec);
}

/// The innermost expansion ends.
fn end_expansion() void {
    let k = gen_whole.len() - 1;
    gen_whole.resize(k);
    gen_capture.resize(k);
    gen_body.resize(k);
    gen_type.resize(k);
    gen_cx_inst.resize(k);
    gen_cx_fi.resize(k);
    gen_cx_result.resize(k);
    gen_decl.resize(k);
    gen_defers.resize(k);
    gen_rec.resize(k);
}

/// Empty the expansion and recursion stacks, before a program is checked.
fn reset_generators() void {
    gen_whole.clear();
    gen_capture.clear();
    gen_body.clear();
    gen_type.clear();
    gen_cx_inst.clear();
    gen_cx_fi.clear();
    gen_cx_result.clear();
    gen_decl.clear();
    gen_defers.clear();
    gen_rec.clear();
    rec_kind.clear();
    rec_val.clear();
    rec_top.clear();
    rec_args.clear();
    rec_elem.clear();
    rec_params.clear();
    prune_flag.clear();
    prune_loop.clear();
}

/// Whether a function declaration is a generator (its result is `yield T`).
fn is_generator(decl: I32) Bool {
    if not decl_is(decl, Decl.Fn) or not is_kind(decl_node[decl], Node.Fn_decl) { return false; };
    let ret = child_of_kind(decl_node[decl], Node.Return_type);
    ret >= 0 and is_kind(first_child(ret), Node.Yield_type);
}

/// The generator a `for` loop consumes: its one source is a call of one,
/// by name (`g(…)`, `m.g(…)`, `T.g(…)`). A method's, `x.g(…)`, needs x's
/// type: see @generator_source.
fn generator_call(for_node: I32) I32 {
    let call = sole_call(for_node);
    if call >= 0 and generator_decl_of(call) >= 0 { call; } else { -1; };
}

/// A `for` loop's one source, when it is a call; else -1.
fn sole_call(for_node: I32) I32 {
    let sources = first_child(for_node);
    let source = first_child(sources);
    if source < 0 or next_sibling(source) >= 0 or next_sibling(first_child(source)) >= 0 { return -1; };
    let call = first_child(source);
    if is_kind(call, Node.Call_expr) or is_kind(call, Node.Promoted_module_call_expr) { call; } else { -1; };
}

/// A call's argument list (-1 for none): `f(…)`'s, or `M[A].f(…)`'s.
fn call_args(call: I32) I32 {
    if is_kind(call, Node.Promoted_module_call_expr) { return next_sibling(next_sibling(next_sibling(first_child(call)))); };
    next_sibling(first_child(call));
}

/// The generator a call names: `g(…)`, `m.g(…)` (a module's or an alias's),
/// `T.g(…)`, or `M[A].g(…)`; else -1.
fn generator_decl_of(call: I32) I32 {
    let callee = first_child(call);
    let d = -1;
    if is_kind(call, Node.Promoted_module_call_expr) { d = node_decl[next_sibling(next_sibling(callee))]; }
    else if is_kind(callee, Node.Identifier) { d = node_decl[callee]; }
    else if is_kind(callee, Node.Field_expr) and is_kind(first_child(callee), Node.Identifier) {
        let base = node_decl[first_child(callee)];
        if decl_is(base, Decl.Module) { d = node_decl[last_child(callee)]; }
        else if decl_is(base, Decl.Alias) and decl_is(decl_a[base], Decl.Module) { d = static_member(decl_a[base], word_of(last_child(callee))); };
    } else if is_kind(callee, Node.Type_member_expr) { d = node_decl[last_child(callee)]; };
    if is_generator(d) { d; } else { -1; };
}

/// The generator call a `for` loop consumes, a method's (`x.each()`, by x's
/// type) too; else -1. A method's is recorded on its name.
fn generator_source(for_node: I32, cx: Cx) I32 {
    let call = sole_call(for_node);
    if call < 0 { return -1; };
    if generator_decl_of(call) >= 0 { return call; };
    let callee = first_child(call);
    if not is_kind(callee, Node.Field_expr) or is_module_path(callee) { return -1; };
    let rt = type_only(first_child(callee), -1, cx);
    if ty_is(rt, Ty.Error) or ty_is(rt, Ty.Nullable) or ty_decl(rt) < 0 { return -1; };
    let d = member(ty_decl(rt), word_of(last_child(callee)), Space.Method);
    if not is_generator(d) { return -1; };
    node_decl[last_child(callee)] = d;
    call;
}

/// The module instance a named generator call (see @generator_decl_of) runs in.
fn generator_inst(call: I32, gen: I32, cx: Cx) I32 {
    let callee = first_child(call);
    let base = first_child(callee);
    if is_kind(call, Node.Promoted_module_call_expr) { return instance(module_of(gen), type_args(next_sibling(callee), cx.inst)); };
    if is_kind(callee, Node.Field_expr) and decl_is(node_decl[base], Decl.Alias) { return alias_instance(node_decl[base]); };
    if is_kind(callee, Node.Type_member_expr) and not (is_kind(base, Node.Type_ident) and decl_is(node_decl[base], Decl.Module)) {
        return ty_inst(type_path(base, cx.inst));
    };
    instance_for(module_of(gen), cx.inst);
}

/// The declarations of a generator (its parameters and locals): those
/// whose node is inside it.
fn generator_decls(gen: I32) I32 {
    let node = decl_node[gen];
    let m = vl_begin();
    for (0 ..< decl_kind.len()) |d| {
        if is_local_decl(d) and decl_node[d] >= 0 {
            let t = node_first[decl_node[d]];
            if t >= node_first[node] and t < node_last[node] { vl_add(d); };
        };
    };
    vl_end(m);
}

/// Set aside the locals and types of declarations `decls` (a list), in case
/// an outer expansion of their generator is running: [local, type] each.
fn set_aside(decls: I32) Array[I32] {
    let saved = Array[I32].new(vl_len[decls] * 2, 0);
    for (0 ..< vl_len[decls]) |i| {
        saved[i * 2] = decl_local[vl_item(decls, i)];
        saved[i * 2 + 1] = decl_ty[vl_item(decls, i)];
    };
    saved;
}

/// Bring back what @set_aside kept.
fn bring_back(decls: I32, saved: Array[I32]) void {
    for (0 ..< vl_len[decls]) |i| {
        decl_local[vl_item(decls, i)] = saved[i * 2];
        decl_ty[vl_item(decls, i)] = saved[i * 2 + 1];
    };
}

/// Whether generator `gen`'s body has a `for (gen(…))` of its own.
fn delegates_to_itself(gen: I32) Bool { calls_generator(last_child(decl_node[gen]), gen); }

/// Whether a `for` under `node` consumes generator `gen`.
fn calls_generator(node: I32, gen: I32) Bool {
    if is_kind(node, Node.For_expr) {
        let call = generator_call(node);
        if call >= 0 and generator_decl_of(call) == gen { return true; };
    };
    let c = first_child(node);
    while (c >= 0) {
        if calls_generator(c, gen) { return true; };
        c = next_sibling(c);
    };
    false;
}

/// `for (g(…)) |v| { yield v; }`: the loop yields each value, and nothing else.
fn is_delegation(loop_: I32) Bool {
    let capture = next_sibling(first_child(loop_));
    if not is_kind(capture, Node.Capture) or next_sibling(first_child(capture)) >= 0 { return false; };
    let body = last_child(loop_);
    let y = first_child(body);
    if y < 0 or next_sibling(y) >= 0 or not is_kind(y, Node.Yield_expr) { return false; };
    let v = first_child(y);
    is_kind(v, Node.Identifier) and first_child(v) < 0 and word_of(v) == word_of(first_child(capture));
}

/// `for (gen(args)) |x| { body }`: the generator's body in place of the
/// loop, the consumer's body at each `yield`. A generator that delegates to
/// itself goes to @check_recursive_loop; one already expanding here is a
/// call item of its recursion, or reported.
fn check_generator_loop(node: I32, call: I32, cx: Cx) I32 {
    let gen = generator_decl_of(call);
    // `x.each()`: a method's, x its receiver (see @generator_source).
    let receiver = -1;
    if gen < 0 {
        gen = node_decl[last_child(first_child(call))];
        receiver = first_child(first_child(call));
    };
    // A generator that consumes itself would expand without end.
    for (0 ..< gen_decl.len()) |i| {
        if gen_decl[i] == gen {
            // One that delegates to itself in its own body is recursive, and
            // passes its values straight through.
            if delegates_to_itself(gen) and receiver < 0 {
                if not is_delegation(node) {
                    report(Diag.GeneratorPassThrough, node, decl_name[gen]);
                    return error_value();
                };
                return rec_push_call(gen_rec[i], node, call, cx);
            };
            report(Diag.GeneratorRecursion, node, decl_name[gen]);
            return error_value();
        };
    };
    let capture = next_sibling(first_child(node));
    let body = last_child(node);
    let cap = -1;
    if is_kind(capture, Node.Capture) {
        let name = first_child(capture);
        if next_sibling(name) >= 0 {
            report2(Diag.InvalidForSource, node, -1, 1, -1);
            return error_value();
        };
        cap = node_decl[name];
    };
    let m = w_mark();
    // A method's receiver is evaluated first, and its type is the instance.
    let rt = if receiver >= 0 { check_expr(receiver, -1, cx); } else { -1; };
    if receiver >= 0 and ty_is(rt, Ty.Error) { return error_since(m); };
    let inst = if receiver >= 0 { ty_inst(rt); } else { generator_inst(call, gen, cx); };
    // Its element type: `yield T`.
    let elem = type_of(first_child(first_child(child_of_kind(decl_node[gen], Node.Return_type))), inst);
    if delegates_to_itself(gen) {
        // (A method's would pass its receiver along: not done.)
        if receiver >= 0 {
            w_stack.resize(m);
            report(Diag.GeneratorRecursion, node, decl_name[gen]);
            return error_value();
        };
        return check_recursive_loop(node, call, gen, cap, elem, inst, cx);
    };
    let decls = generator_decls(gen);
    let saved = set_aside(decls);
    // Before the parameters are bound: a captured one may be a box.
    mark_boxes(fn_body(gen));
    // The receiver into self.
    if receiver >= 0 {
        let st = receiver_type(gen, inst);
        coerce(rt, st, receiver);
        let self_decl = vl_item(param_decls(gen), 0);
        decl_ty[self_decl] = st;
        bind_value(self_decl, st, m);
    };
    // Arguments into the parameters.
    let params = param_list_of(gen);
    let args = call_args(call);
    let a = if args >= 0 { first_child(args); } else { -1; };
    let p = if params >= 0 { first_child(params); } else { -1; };
    while (a >= 0 and p >= 0) {
        let d = node_decl[first_child(p)];
        let pt = type_of(next_sibling(first_child(p)), inst);
        let ma = w_mark();
        coerce(check_expr(a, pt, cx), pt, a);
        decl_ty[d] = pt;
        bind_value(d, pt, ma);
        a = next_sibling(a);
        p = next_sibling(p);
    };
    if a >= 0 or p >= 0 {
        report2(Diag.GeneratorArity, node, decl_name[gen], child_count(params), child_count(args));
        w_stack.resize(m);
        return error_value();
    };
    // The generation.
    let whole = new_label();
    begin_expansion(whole, cap, body, elem, cx, gen, -1);
    let mb = w_mark();
    // The generator's own loops are its; the consumer's loops are not in reach.
    let gcx = Cx { inst: inst, fi: cx.fi, result: ty_void() };
    let loops = hide_loops();
    discard(check_block(fn_body(gen), ty_void(), gcx));
    show_loops(loops);
    w_node(Op.Block, vt_none, whole, 0, mb);
    end_expansion();
    bring_back(decls, saved);
    w_node(Op.Seq, vt_none, 0, 0, m);
    ty_void();
}

/// A function declaration's `Param_list` node, or -1.
fn param_list_of(decl: I32) I32 { child_of_kind(decl_node[decl], Node.Param_list); }

/// The innermost expansion whose generator the node is in, or -1.
fn expansion_of(node: I32) I32 {
    let k = gen_decl.len() - 1;
    let t = node_first[node];
    while (k >= 0) {
        if gen_decl[k] >= 0 {
            let g = decl_node[gen_decl[k]];
            if t >= node_first[g] and t < node_last[g] { return k; };
        };
        k -= 1;
    };
    -1;
}

/// `yield v`: v into the consumer's capture, then its body, which `continue`
/// leaves (to resume the generator) and `break` ends the whole generation.
fn check_yield(node: I32, cx: Cx) I32 {
    let k = expansion_of(node);
    if k < 0 {
        report(Diag.YieldOutside, node, -1);
        return error_value();
    };
    let t = gen_type[k];
    if gen_rec[k] >= 0 { return rec_push_value(gen_rec[k], first_child(node), cx); };
    let m = w_mark();
    let value = first_child(node);
    let mv = w_mark();
    coerce(check_expr(value, t, cx), t, value);
    let resume = new_label();
    let mr = w_mark();
    if gen_capture[k] >= 0 {
        decl_ty[gen_capture[k]] = t;
        bind_value(gen_capture[k], t, mv);
    } else {
        drop_value(t);
    };
    // The consumer's body, as part of the consumer: its loops and its result.
    let ccx = Cx { inst: gen_cx_inst[k], fi: gen_cx_fi[k], result: gen_cx_result[k] };
    // Its break and continue reach this expansion, not the generator's loops.
    enter_loop(gen_whole[k], resume, -1, -1);
    // break leaves the whole generation, so it runs the generator's defers.
    loop_break_defers[loop_break_defers.len() - 1] = gen_defers[k];
    // While the body is checked, it is outside this expansion (a yield in
    // it belongs to an outer one).
    let decl = gen_decl[k];
    gen_decl[k] = -1;
    discard(check_block(gen_body[k], ty_void(), ccx));
    gen_decl[k] = decl;
    leave_loop();
    w_node(Op.Block, vt_none, resume, 0, mr);
    w_node(Op.Seq, vt_none, 0, 0, m);
    ty_void();
}

/// `return;` inside a generator's expansion ends the generation.
/// It runs the generator's pending defers first.
fn generator_return(node: I32, cx: Cx) I32 {
    let k = expansion_of(node);
    if k < 0 { return -1; };
    if first_child(node) >= 0 {
        report(Diag.GeneratorReturnValue, node, -1);
        return error_value();
    };
    let m = w_mark();
    run_defers(gen_defers[k], cx);
    w_leaf(Op.Br, vt_unreachable, gen_whole[k], 0);
    w_node(Op.Seq, vt_unreachable, 0, 0, m);
    ty_never();
}

//! = Recursive generators
//!
//! A generator that delegates to itself (`for (walk(c)) |d| { yield d; }`)
//! would expand without end, so it runs on an explicit stack instead, as in
//! stage 0. Its body and the consumer's each appear once:
//!
//! ```
//! items   one per yield (a value) or delegation (a call's arguments), in
//!           arrays: kind (0 value, 1 call), val, and one per parameter
//! frames  one per running call: [cur, end) over its items; the suspended
//!           ones in fcur and fend
//!
//! loop {
//!   the running frame's next item (or, at its end, the suspended one)
//!   a value → the consumer's body; `prune` skips the calls that follow
//!   a call  → the generator's body once, with its arguments; its yields
//!             and delegations push items, which become a new frame
//! }
//! ```
//!
//! A call's body runs to completion before its values are consumed; values
//! still arrive in depth-first order.

// The recursive generations being checked: their item arrays' locals.
vec rec_kind: I32;
vec rec_val: I32;
vec rec_top: I32;
/// A list of the parameters' array locals.
vec rec_args: I32;
/// The yielded type.
vec rec_elem: I32;
/// A list of the parameters' types.
vec rec_params: I32;
/// The innermost recursive consumer's `pruned` local.
vec prune_flag: I32;
/// And its loop.
vec prune_loop: I32;

fn rec_array_heap(vt: I32) I32 { array_type(storage(vt), true); }

/// A new array of 16 elements of vt's storage, in a new local.
fn rec_new_array(vt: I32) I32 {
    let heap = rec_array_heap(vt);
    let local = new_local(vt_ref(heap, false));
    let m = w_mark();
    w_i32(16);
    w_node(Op.ArrayNewDefault, vt_ref(heap, false), heap, 0, m);
    ls(local, m);
    local;
}

/// `array[index]` = the value just pushed (at `m`); `index` is a local.
fn rec_set(array: I32, index: I32, m: I32) void {
    let v = w_pop();
    lg(array);
    lg(index);
    w_push(v);
    w_node(Op.ArraySet, vt_none, vt_heap(cur_locals[array]), 0, m);
}

/// `array[index]`, read as `vt` (a reference stored nullable is read non-null).
fn rec_get(array: I32, index: I32, vt: I32) void {
    let heap = vt_heap(cur_locals[array]);
    let m = w_mark();
    lg(array);
    lg(index);
    w_node(Op.ArrayGet, storage(vt), heap, 0, m);
    if storage(vt) != vt { w_node(Op.RefAsNonNull, vt, 0, 0, m); };
}

/// When `top` reaches an array's length, each of `arrays` (locals) doubles.
fn rec_grow(top: I32, arrays: Array[I32], n: I32) void {
    let mi = w_mark();
    let mc = w_mark();
    lg(top);
    let ml = w_mark();
    lg(arrays[0]);
    w_node(Op.ArrayLen, vt_i32, 0, 0, ml);
    plain(70, vt_i32, mc);
    let mt = w_mark();
    for (0 ..< n) |k| {
        let heap = vt_heap(cur_locals[arrays[k]]);
        let grown = new_local(cur_locals[arrays[k]]);
        let mg = w_mark();
        lg(top);
        w_i32(2);
        plain(108, vt_i32, mg);
        w_node(Op.ArrayNewDefault, cur_locals[arrays[k]], heap, 0, mg);
        ls(grown, mg);
        let mcp = w_mark();
        lg(grown);
        w_i32(0);
        lg(arrays[k]);
        w_i32(0);
        lg(top);
        w_node(Op.ArrayCopy, vt_none, heap, heap, mcp);
        let ms = w_mark();
        lg(grown);
        ls(arrays[k], ms);
    };
    seq_void(mt);
    w_node(Op.If, vt_none, new_label(), 0, mi);
}

/// The item arrays of recursive generation r.
fn rec_item_arrays(r: I32) Array[I32] {
    let n = vl_len[rec_args[r]];
    let arrays = Array[I32].new(n + 2, 0);
    arrays[0] = rec_kind[r];
    arrays[1] = rec_val[r];
    for (0 ..< n) |i| { arrays[i + 2] = vl_item(rec_args[r], i); };
    arrays;
}

/// `kind[top] = kind_; top += 1` (after the item's own sets).
fn rec_finish_item(r: I32, kind_: I32) void {
    let m = w_mark();
    w_i32(kind_);
    rec_set(rec_kind[r], rec_top[r], m);
    incr(rec_top[r]);
}

/// `yield v` in a recursive generation: a value item.
fn rec_push_value(r: I32, value: I32, cx: Cx) I32 {
    let t = rec_elem[r];
    let m = w_mark();
    let v = new_local(repr(t));
    let mv = w_mark();
    coerce(check_expr(value, t, cx), t, value);
    ls(v, mv);
    rec_grow(rec_top[r], rec_item_arrays(r), vl_len[rec_args[r]] + 2);
    let ms = w_mark();
    lg(v);
    rec_set(rec_val[r], rec_top[r], ms);
    rec_finish_item(r, 0);
    seq_void(m);
    ty_void();
}

/// The arguments of a call checked against `ptypes` (a list), each into a
/// new local; the locals.
fn args_into_locals(args: I32, ptypes: I32, cx: Cx) Array[I32] {
    let n = vl_len[ptypes];
    let locals = Array[I32].new(n + 1, 0);
    let a = if args >= 0 { first_child(args); } else { -1; };
    for (0 ..< n) |i| {
        let pt = vl_item(ptypes, i);
        locals[i] = new_local(repr(pt));
        let ma = w_mark();
        coerce(check_expr(a, pt, cx), pt, a);
        ls(locals[i], ma);
        a = next_sibling(a);
    };
    locals;
}

/// `for (walk(…)) |v| { yield v; }` in a recursive generation: a call item.
fn rec_push_call(r: I32, node: I32, call: I32, cx: Cx) I32 {
    let params = rec_params[r];
    let args = call_args(call);
    if child_count(args) != vl_len[params] {
        report2(Diag.GeneratorArity, node, decl_name[generator_decl_of(call)], vl_len[params], child_count(args));
        return error_value();
    };
    let m = w_mark();
    let values = args_into_locals(args, params, cx);
    rec_grow(rec_top[r], rec_item_arrays(r), vl_len[params] + 2);
    for (0 ..< vl_len[params]) |i| {
        let ms = w_mark();
        lg(values[i]);
        rec_set(vl_item(rec_args[r], i), rec_top[r], ms);
    };
    rec_finish_item(r, 1);
    seq_void(m);
    ty_void();
}

/// The locals of a recursive generation's loop.
struct RecLoop:
    | kind: I32     // the item arrays: each item's kind (0 value, 1 call) …
    | val: I32      // … and value
    | top: I32      // how many items there are
    | cur: I32      // the running frame's next item …
    | end_: I32     // … and its end
    | fsp: I32      // how many frames are suspended …
    | fcur: I32     // … and their cur and end
    | fend: I32

/// The running frame is done: the last suspended one runs again, or, with
/// none, the generation (block `whole`) ends.
fn rec_resume_frame(l: RecLoop, whole: I32) void {
    let m = w_mark();
    let mz = w_mark();
    let mzc = w_mark();
    lg(l.fsp);
    plain(69, vt_i32, mzc);
    let mzt = w_mark();
    w_leaf(Op.Br, vt_unreachable, whole, 0);
    seq_void(mzt);
    w_node(Op.If, vt_none, new_label(), 0, mz);
    let md = w_mark();
    lg(l.fsp);
    w_i32(1);
    plain(107, vt_i32, md);
    ls(l.fsp, md);
    rec_get(l.fcur, l.fsp, vt_i32);
    ls(l.cur, w_mark() - 1);
    rec_get(l.fend, l.fsp, vt_i32);
    ls(l.end_, w_mark() - 1);
    let mtop = w_mark();
    lg(l.end_);
    ls(l.top, mtop);
    seq_void(m);
}

/// After `prune`: skip the call items that follow in the running frame
/// (`while cur < end and kind[cur] == 1: cur += 1`).
fn rec_skip_calls(l: RecLoop) void {
    let m = w_mark();
    let skip_loop = new_label();
    let skip_out = new_label();
    let mso = w_mark();
    let msl = w_mark();
    let mex = w_mark();
    lg(l.cur);
    lg(l.end_);
    plain(72, vt_i32, mex);
    plain(69, vt_i32, mex);
    w_node(Op.BrIf, vt_none, skip_out, 0, mex);
    let mek = w_mark();
    rec_get(l.kind, l.cur, vt_i32);
    w_i32(1);
    plain(71, vt_i32, mek);
    w_node(Op.BrIf, vt_none, skip_out, 0, mek);
    incr(l.cur);
    w_leaf(Op.Br, vt_unreachable, skip_loop, 0);
    w_node(Op.Loop, vt_none, skip_loop, 0, msl);
    w_node(Op.Block, vt_none, skip_out, 0, mso);
    seq_void(m);
}

/// A call pushed the items from `start`: they are the running frame, and
/// the one it ran in is suspended.
fn rec_enter_frame(l: RecLoop, start: I32) void {
    let m = w_mark();
    let frames = Array[I32].new(2, 0);
    frames[0] = l.fcur;
    frames[1] = l.fend;
    rec_grow(l.fsp, frames, 2);
    let ms1 = w_mark();
    lg(l.cur);
    rec_set(l.fcur, l.fsp, ms1);
    let ms2 = w_mark();
    lg(l.end_);
    rec_set(l.fend, l.fsp, ms2);
    incr(l.fsp);
    let ms3 = w_mark();
    lg(start);
    ls(l.cur, ms3);
    let ms4 = w_mark();
    lg(l.top);
    ls(l.end_, ms4);
    seq_void(m);
}

/// `for (walk(root)) |x| { body }`, walk recursive.
fn check_recursive_loop(node: I32, call: I32, gen: I32, cap: I32, elem: I32, inst: I32, cx: Cx) I32 {
    let params = param_list_of(gen);
    let args = call_args(call);
    if child_count(args) != child_count(params) {
        report2(Diag.GeneratorArity, node, decl_name[gen], child_count(params), child_count(args));
        return error_value();
    };
    let np = child_count(params);
    let decls = generator_decls(gen);
    let saved = set_aside(decls);
    let m = w_mark();
    // The parameters' types, and the roots: the call's arguments.
    let mt = vl_begin();
    let p = if params >= 0 { first_child(params); } else { -1; };
    while (p >= 0) {
        vl_add(type_of(next_sibling(first_child(p)), inst));
        p = next_sibling(p);
    };
    let ptypes = vl_end(mt);
    let roots = args_into_locals(args, ptypes, cx);
    // The items, starting with the root call; the frames.
    let kind = rec_new_array(vt_i32);
    let val = rec_new_array(repr(elem));
    let ma = vl_begin();
    for (0 ..< np) |i| { vl_add(rec_new_array(repr(vl_item(ptypes, i)))); };
    let arg_arrays = vl_end(ma);
    let top = new_local(vt_i32);
    let cur = new_local(vt_i32);
    let end_ = new_local(vt_i32);
    let fsp = new_local(vt_i32);
    let l = RecLoop { kind: kind, val: val, top: top, cur: cur, end_: end_, fsp: fsp, fcur: rec_new_array(vt_i32), fend: rec_new_array(vt_i32) };
    // The loop may run again: each run starts from nothing.
    let m0 = w_mark();
    w_i32(0);
    ls(top, m0);
    let m0c = w_mark();
    w_i32(0);
    ls(cur, m0c);
    let m0f = w_mark();
    w_i32(0);
    ls(fsp, m0f);
    let mk = w_mark();
    w_i32(1);
    rec_set(kind, top, mk);
    for (0 ..< np) |i| {
        let mr = w_mark();
        lg(roots[i]);
        rec_set(vl_item(arg_arrays, i), top, mr);
    };
    let m1 = w_mark();
    w_i32(1);
    ls(top, m1);
    let m2 = w_mark();
    w_i32(1);
    ls(end_, m2);
    // The generation.
    let whole = new_label();
    let again = new_label();
    let mw = w_mark();
    let ml = w_mark();
    let mi = w_mark();
    // cur == end: the running frame is done.
    let mc = w_mark();
    lg(cur);
    lg(end_);
    plain(70, vt_i32, mc);
    rec_resume_frame(l, whole);
    // Else: the next item.
    let melse = w_mark();
    let i = new_local(vt_i32);
    let k = new_local(vt_i32);
    let mi1 = w_mark();
    lg(cur);
    ls(i, mi1);
    incr(cur);
    rec_get(kind, i, vt_i32);
    ls(k, w_mark() - 1);
    // A value: the consumer's body.
    let mv = w_mark();
    let mvc = w_mark();
    lg(k);
    plain(69, vt_i32, mvc);
    let mvt = w_mark();
    let pruned = new_local(vt_i32);
    let mp = w_mark();
    w_i32(0);
    ls(pruned, mp);
    let mcap = w_mark();
    rec_get(val, i, repr(elem));
    if cap >= 0 {
        decl_ty[cap] = elem;
        bind_value(cap, elem, mcap);
    } else {
        drop_value(elem);
    };
    let resume = new_label();
    let mr = w_mark();
    enter_loop(whole, resume, -1, -1);
    prune_flag.push(pruned);
    prune_loop.push(node);
    discard(check_block(last_child(node), ty_void(), cx));
    prune_flag.resize(prune_flag.len() - 1);
    prune_loop.resize(prune_loop.len() - 1);
    leave_loop();
    w_node(Op.Block, vt_none, resume, 0, mr);
    let mpr = w_mark();
    lg(pruned);
    rec_skip_calls(l);
    w_node(Op.If, vt_none, new_label(), 0, mpr);
    seq_void(mvt);
    w_node(Op.If, vt_none, new_label(), 0, mv);
    // A call: the generator's body, with its arguments.
    let mcall = w_mark();
    let mcc = w_mark();
    lg(k);
    w_i32(1);
    plain(70, vt_i32, mcc);
    let mct = w_mark();
    mark_boxes(fn_body(gen));
    let pnode = if params >= 0 { first_child(params); } else { -1; };
    for (0 ..< np) |j| {
        let d = node_decl[first_child(pnode)];
        let pt = vl_item(ptypes, j);
        let mg = w_mark();
        rec_get(vl_item(arg_arrays, j), i, repr(pt));
        decl_ty[d] = pt;
        bind_value(d, pt, mg);
        pnode = next_sibling(pnode);
    };
    let start = new_local(vt_i32);
    let mst = w_mark();
    lg(top);
    ls(start, mst);
    let frame = new_label();
    let r = rec_kind.len();
    rec_kind.push(kind);
    rec_val.push(val);
    rec_top.push(top);
    rec_args.push(arg_arrays);
    rec_elem.push(elem);
    rec_params.push(ptypes);
    begin_expansion(frame, -1, -1, elem, cx, gen, r);
    let mb = w_mark();
    let gcx = Cx { inst: inst, fi: cx.fi, result: ty_void() };
    // The generator's own loops are its; the consumer's loops are not in reach.
    let loops = hide_loops();
    discard(check_block(fn_body(gen), ty_void(), gcx));
    show_loops(loops);
    w_node(Op.Block, vt_none, frame, 0, mb);
    end_expansion();
    rec_kind.resize(r);
    rec_val.resize(r);
    rec_top.resize(r);
    rec_args.resize(r);
    rec_elem.resize(r);
    rec_params.resize(r);
    // Its items, if any, are the running frame; the one it ran in waits.
    let mf = w_mark();
    let mfc = w_mark();
    lg(top);
    lg(start);
    plain(74, vt_i32, mfc);
    rec_enter_frame(l, start);
    w_node(Op.If, vt_none, new_label(), 0, mf);
    seq_void(mct);
    w_node(Op.If, vt_none, new_label(), 0, mcall);
    seq_void(melse);
    w_node(Op.If, vt_none, new_label(), 0, mi);
    w_leaf(Op.Br, vt_unreachable, again, 0);
    w_node(Op.Loop, vt_none, again, 0, ml);
    w_node(Op.Block, vt_none, whole, 0, mw);
    bring_back(decls, saved);
    seq_void(m);
    ty_void();
}

/// `prune;` in the body of a recursive generator's consumer.
fn check_prune(node: I32) I32 {
    if prune_flag.len() == 0 {
        report(Diag.PruneOutside, node, -1);
        return error_value();
    };
    // A closure in the consumer is a function of its own.
    let p = parent_of(node);
    while (p >= 0 and p != prune_loop[prune_loop.len() - 1]) {
        if is_kind(p, Node.Closure_expr) {
            report(Diag.PruneInClosure, node, -1);
            return error_value();
        };
        p = parent_of(p);
    };
    let m = w_mark();
    w_i32(1);
    ls(prune_flag[prune_flag.len() - 1], m);
    ty_void();
}
