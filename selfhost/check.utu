//! = Checking
//!
//! Monomorphization on demand: each function is checked once per instance
//! it is reached in, and translated as it is checked into IR. A function
//! instance (`fi_*`) is a function declaration and the instance of its
//! module; checking a call enqueues the callee's. Every function of the
//! program's own files is checked, for its diagnostics; another (the
//! standard library's, a generic's instance) where it is reached. The
//! module keeps what the exports reach (see @sweep).
//!
//! @check_expr checks an expression against the type expected of it (-1 for
//! none), pushes its IR node, and returns its type. Expected types flow
//! down: an integer literal becomes the integer or float type expected of
//! it, `null` the nullable type.

/// By function instance: its function declaration. The other `fi_*` vecs
/// are its other columns; @fn_instance makes one.
vec fi_decl: I32;
vec fi_inst: I32;
/// Its wasm function, or -1 for an intrinsic.
vec fi_func: I32;
/// A list of parameter types (self first).
vec fi_params: I32;
vec fi_result: I32;
/// An intrinsic's @ir tree, else -1.
vec fi_ir: I32;
/// Open addressing over (decl, inst), -1 empty.
vec fi_table: I32;
/// Instances to check, in order.
vec fi_queue: I32;

// The function being checked.
/// By declaration: its local.
vec decl_local: I32;
/// By declaration: its type (locals and parameters).
vec decl_ty: I32;
/// Value types of its locals, parameters first.
vec cur_locals: I32;
/// At `[0]`: how many of them are parameters.
vec cur_params: I32;
/// One value, at `[0]`.
vec next_label: I32;
/// Per enclosing loop, innermost last.
vec loop_break: I32;
vec loop_continue: I32;

/// Where checking is.
struct Cx:
    | inst: I32      // the instance the code is in
    | fi: I32        // the function instance
    | result: I32    // its result type

//! = Function instances

fn fi_hash(decl: I32, inst: I32) I32 { (decl * -1640531535) ^ (inst * 40503); }

/// The function instance of `decl` in module instance `inst`: made when
/// new, with its wasm function, and queued to be checked (an intrinsic, or
/// a `@wat` function, is not).
fn fn_instance(decl: I32, inst: I32) I32 {
    if (fi_decl.len() + 1) * 2 > fi_table.len() { fi_grow(); };
    let mask = fi_table.len() - 1;
    let h = fi_hash(decl, inst) & mask;
    while (fi_table[h] >= 0) {
        let f = fi_table[h];
        if fi_decl[f] == decl and fi_inst[f] == inst {
            note_reach(f);
            return f;
        };
        h = (h + 1) & mask;
    };
    let id = fi_decl.len();
    note_reach(id);
    fi_table[h] = id;
    fi_decl.push(decl);
    fi_inst.push(inst);
    fi_func.push(-1);
    fi_ir.push(-1);
    fi_site.push(-1);
    enter_instance(inst, -1);
    signature(decl, inst);
    leave_instance();
    fi_params.push(sig_params[0]);
    fi_result.push(sig_result[0]);
    let body = fn_body(decl);
    let ir = intrinsic_body(body);
    if ir >= 0 {
        fi_ir[id] = ir;
        // A program's own @ir is unchecked: the host validates the module it is in.
        if file_std[file_of_token(node_first[body])] != 1 { user_ir_decl.push(decl); };
    } else {
        let f = defined_func(fi_params[id], fi_result[id]);
        fi_func[id] = f;
        func_debug_name[f] = fn_debug_name(decl);
        func_src[f] = decl_node[decl];
        // A @wat function's body is its code, which the host assembled.
        let wat = wat_of(body);
        if wat >= 0 { func_code[f] = wat; } else if not is_generator(decl) { fi_queue.push(id); };
    };
    id;
}

/// Per function instance: the first call of it, or -1.
vec fi_site: I32;

/// The generic instances whose code is being checked, innermost last, as
/// pairs (instance, the call that made it, or -1): a mistake there that
/// depends on it says so (@instance_note).
vec checking_inst: I32;

/// Check code in instance `inst` (0: none), from call `site`, until @leave_instance.
fn enter_instance(inst: I32, site: I32) void {
    checking_inst.push(inst);
    checking_inst.push(site);
}

fn leave_instance() void { checking_inst.resize(checking_inst.len() - 2); }

/// On a mistake just reported in a generic instance's code: which instance,
/// and where it was first called.
fn instance_note() void {
    let n = checking_inst.len();
    if n == 0 { return; };
    let inst = checking_inst[n - 2];
    // (Too deep: the instance is what is wrong, and too long to say.)
    if inst <= 0 or inst >= inst_module.len() or diag_kind[diag_kind.len() - 1] == Diag.InstanceDepth.to_i32() { return; };
    let text = word_text(decl_name[inst_module[inst]]) + "[" + type_list_text(inst_args[inst]) + "]";
    diag_note("in " + text);
    if checking_inst[n - 1] >= 0 { diag_place(Extra.Related, checking_inst[n - 1], "as " + text + " here"); };
}

fn fi_grow() void {
    let n = if fi_table.len() == 0 { 256; } else { fi_table.len() * 2; };
    fi_table.resize(n);
    for (0 ..< n) |i| { fi_table[i] = -1; };
    let mask = n - 1;
    for (0 ..< fi_decl.len()) |f| {
        let h = fi_hash(fi_decl[f], fi_inst[f]) & mask;
        while (fi_table[h] >= 0) { h = (h + 1) & mask; };
        fi_table[h] = f;
    };
}

/// A function's block (its last child).
fn fn_body(decl: I32) I32 { last_child(decl_node[decl]); }

/// The first child of `node` of a kind, or -1.
fn child_of_kind(node: I32, kind: Node) I32 {
    let c = first_child(node);
    while (c >= 0 and not is_kind(c, kind)) { c = next_sibling(c); };
    c;
}

/// A new defined wasm function of parameter types `params` (a list) and
/// result type `result`.
fn defined_func(params: I32, result: I32) I32 {
    let m = vl_begin();
    for (0 ..< vl_len[params]) |i| { vl_add(repr(vl_item(params, i))); };
    new_func(FuncKind.Defined, func_type(vl_end(m), vl_of_result(repr(result))));
}

/// The `@ir` tree of a body that is one `@ir/\ … \/` expression, or -1.
fn intrinsic_body(block: I32) I32 {
    let e = first_child(block);
    if e < 0 or next_sibling(e) >= 0 or not is_kind(e, Node.Dsl_expr) { return -1; };
    if word_of(first_child(e)) != known_word(Known.Ir) { return -1; };
    ir_tree(e);
}

fn fn_debug_name(decl: I32) I32 {
    let node = decl_node[decl];
    let name = first_child(node);
    let t0 = node_first[name];
    let t1 = node_last[name];
    if is_kind(node, Node.Op_decl) { t1 = node_last[next_sibling(name)]; };
    name_from_src(tok_start[t0], tok_end[t1 - 1]);
}

// A function's parameter types (self first) and result type, in an instance.
/// One value, at `[0]`.
vec sig_params: I32;
/// One value, at `[0]`.
vec sig_result: I32;

/// Sets @sig_params and @sig_result for `decl` in instance `inst`.
fn signature(decl: I32, inst: I32) void {
    let node = decl_node[decl];
    let m = vl_begin();
    let result = ty_void();
    let self_ty = receiver_type(decl, inst);
    let c = first_child(node);
    while (c >= 0) {
        let kind = node_kind[c];
        if kind == Node.Self_param.to_i32() {
            vl_add(self_ty);
        } else if kind == Node.Capture.to_i32() {
            // An operator's captures are operands of its type.
            let n = first_child(c);
            while (n >= 0) {
                vl_add(self_ty);
                n = next_sibling(n);
            };
        } else if kind == Node.Param_list.to_i32() {
            let p = first_child(c);
            while (p >= 0) {
                vl_add(type_of(next_sibling(first_child(p)), inst));
                p = next_sibling(p);
            };
        } else if kind == Node.Return_type.to_i32() {
            // A generator has no result: it is expanded, never called (see generators.utu).
            result = if is_kind(first_child(c), Node.Yield_type) { ty_error(); } else { type_of(c, inst); };
        };
        c = next_sibling(c);
    };
    sig_params.resize(1);
    sig_result.resize(1);
    sig_params[0] = vl_end(m);
    sig_result[0] = result;
}

/// The type a method or operator belongs to, in an instance (Error for a free function).
fn receiver_type(decl: I32, inst: I32) I32 {
    let owner = decl_a[decl];
    if owner < 0 { return ty_error(); };
    let node = decl_node[decl];
    let r = first_child(if is_kind(node, Node.Fn_decl) { first_child(node); } else { node; });
    let args = next_sibling(r);
    // `fn P[T].m |self|`: a protocol method of T, so self is a T.
    if is_kind(node, Node.Fn_decl) and is_kind(args, Node.Module_type_arg_list) and decl_is(owner, Decl.Proto) {
        return type_of(first_child(args), inst);
    };
    if is_kind(node, Node.Fn_decl) and is_kind(args, Node.Module_type_arg_list) {
        return named(owner, instance(module_of(owner), type_args(args, inst)));
    };
    decl_type(owner, inst);
}

/// The parameter declarations of a function, in order: self, then the rest
/// (an operator's captures).
fn param_decls(decl: I32) I32 {
    let m = vl_begin();
    let c = first_child(decl_node[decl]);
    while (c >= 0) {
        let kind = node_kind[c];
        if kind == Node.Self_param.to_i32() {
            vl_add(node_decl[first_child(c)]);
        } else if kind == Node.Capture.to_i32() {
            let n = first_child(c);
            while (n >= 0) {
                vl_add(node_decl[n]);
                n = next_sibling(n);
            };
        } else if kind == Node.Param_list.to_i32() {
            let p = first_child(c);
            while (p >= 0) {
                vl_add(node_decl[first_child(p)]);
                p = next_sibling(p);
            };
        };
        c = next_sibling(c);
    };
    vl_end(m);
}

//! = Checking functions

/// A new local of the function being checked, of value type `vt`.
fn new_local(vt: I32) I32 {
    // A value that never arrives (an expression that does not complete, or
    // none) still gets a local of some type; nothing reads it.
    cur_locals.push(if vt == vt_none or vt == vt_unreachable or vt >= vt_tuple { vt_i32; } else { vt; });
    cur_locals.len() - 1;
}

fn new_label() I32 {
    next_label[0] += 1;
    next_label[0];
}

/// A function's checking starts: no locals, labels, loops, or defers yet.
fn begin_function() void {
    want_reset();
    cur_locals.clear();
    next_label.resize(1);
    next_label[0] = 0;
    clear_loops();
    defer_node.clear();
    function_defers[0] = 0;
    exit_flags.clear();
    begin_exit_flag();
}

/// Check a function instance's body into its wasm function.
fn check_function(fi: I32) void {
    let decl = fi_decl[fi];
    begin_function();
    cur_fn[0] = fi;
    let params = fi_params[fi];
    let decls = param_decls(decl);
    for (0 ..< vl_len[decls]) |i| {
        let d = vl_item(decls, i);
        let t = vl_item(params, i);
        decl_local[d] = new_local(repr(t));
        decl_ty[d] = t;
    };
    cur_params.resize(1);
    cur_params[0] = cur_locals.len();
    mark_boxes(fn_body(decl));
    let cx = Cx { inst: fi_inst[fi], fi: fi, result: fi_result[fi] };
    let outer = cur_inst[0];
    cur_inst[0] = cx.inst;
    enter_instance(fi_inst[fi], fi_site[fi]);
    want(fn_body(decl), cx.result, Why.Returns, decl, -1);
    finish_function(fi_func[fi], fn_body(decl), cx, box_params(decls, params));
    unwant();
    leave_instance();
    cur_inst[0] = outer;
}

/// A body checked against the result type, as function `f`'s (after
/// `prologue`, when it is a node: moving boxed parameters into their boxes).
fn finish_function(f: I32, body_node: I32, cx: Cx, prologue: I32) void {
    let outer = cur_src[0];
    cur_src[0] = body_node;
    func_src[f] = body_node;
    let m = w_mark();
    if prologue >= 0 { w_push(prologue); };
    body_block[0] = body_node;
    let t = check_block(body_node, cx.result, cx);
    if ty_is(cx.result, Ty.Void) { drop_value(t); } else { coerce(t, cx.result, body_node); };
    w_node(Op.Seq, repr(cx.result), 0, 0, m);
    func_body[f] = w_pop();
    record_locals(f, cur_params[0]);
    cur_src[0] = outer;
}

/// Function `f`'s locals: those of @cur_locals from `first` (past its parameters).
fn record_locals(f: I32, first: I32) void {
    func_locals[f] = local_types.len();
    func_local_count[f] = cur_locals.len() - first;
    for (first ..< cur_locals.len()) |i| { local_types.push(cur_locals[i]); };
}

/// Statements of a block; its value is its last one's. Its defers run at
/// its end, after its value.
fn check_block(block: I32, expect: I32, cx: Cx) I32 {
    let m = w_mark();
    let defers = defer_node.len();
    defer_marks.push(defers);
    let guards = defer_guard.len();
    let reads = flag_reads[0];
    if block == body_block[0] and profiling() { profile_body(block, cx); };
    let c = first_child(block);
    let t = ty_void();
    while (c >= 0) {
        let next = next_sibling(c);
        let noted = defer_node.len();
        if next < 0 {
            t = check_statement(c, expect, cx);
        } else {
            // A statement's value is dropped: it is checked as Void, so
            // branches of different types are fine there.
            coerce(check_statement(c, ty_void(), cx), ty_void(), c);
        };
        note_defer_guards(noted);
        c = next;
    };
    // The defers run inside the guards, so one that throws lets the older run.
    let vt = repr(t);
    if defer_node.len() > defers and vt != vt_unreachable {
        // A function's body ends in a return, which may be an error's.
        if block == body_block[0] { return_defers(t, w_mark() - 1, defers, cx); }
        else { defers_after_value(vt, w_mark() - 1, defers, cx); };
    };
    guard_defers(guards, vt, cx);
    defer_node.resize(defers);
    init_exit_flag(m, guards, reads);
    defer_marks.resize(defer_marks.len() - 1);
    w_node(Op.Seq, repr(t), 0, 0, m);
    t;
}

/// Run the defers pending since `from` after a value (of value type `vt`,
/// on the stack since `m`), which waits in a local meanwhile; with no value
/// (`vt` none or unreachable), just run them.
fn defers_after_value(vt: I32, m: I32, from: I32, cx: Cx) void {
    if vt == vt_none or vt == vt_unreachable {
        run_defers(from, cx);
        return;
    };
    if vt >= vt_tuple {
        // Each value of a tuple waits in its own local (the last on top).
        let list = vt - vt_tuple;
        let first = new_local(vl_item(list, 0));
        for (1 ..< vl_len[list]) |i| { new_local(vl_item(list, i)); };
        set_tuple(first, list, m);
        run_defers(from, cx);
        for (0 ..< vl_len[list]) |i| { w_leaf(Op.LocalGet, vl_item(list, i), first + i, 0); };
        return;
    };
    let local = new_local(vt);
    w_node(Op.LocalSet, vt_none, local, 0, m);
    run_defers(from, cx);
    w_leaf(Op.LocalGet, vt, local, 0);
}

/// A value checked as Void: dropped, if it is one.
fn discard(t: I32) void { drop_value(t); }

/// Drop the value on top of the stack, if it has one.
fn drop_value(t: I32) void {
    let vt = repr(t);
    if vt == vt_none or vt == vt_unreachable or ty_is(t, Ty.Error) { return; };
    let m = w_mark() - 1;
    if vt >= vt_tuple {
        // A tuple is several values: a drop each.
        for (0 ..< vl_len[vt - vt_tuple]) |_i| { w_leaf(Op.Drop, vt_none, 0, 0); };
        w_node(Op.Seq, vt_none, 0, 0, m);
        return;
    };
    w_node(Op.Drop, vt_none, 0, 0, m);
}

//! = Types against types

/// Make the value on top of the stack (of type `actual`) a value of
/// `expected`, or report that it is not one.
fn coerce(actual: I32, expected: I32, at: I32) I32 {
    if expected < 0 or actual == expected { return actual; };
    if ty_is(actual, Ty.Error) or ty_is(expected, Ty.Error) or ty_is(actual, Ty.Never) { return expected; };
    if ty_is(expected, Ty.Nullable) and ty_a[expected] == actual { return expected; };
    if is_variant_of(actual, expected) { return expected; };
    if converts_to_proto(actual, expected) { return expected; };
    if ty_is(expected, Ty.Nullable) and converts_to_proto(actual, ty_a[expected]) { return expected; };
    let target = if ty_is(expected, Ty.Nullable) { ty_a[expected]; } else { expected; };
    if ty_is(actual, Ty.Fun) and ty_is(target, Ty.Closure) and ty_a[actual] == ty_a[target] and ty_b[actual] == ty_b[target] {
        decay_fun(actual, w_mark() - 1);
        return expected;
    };
    if ty_is(expected, Ty.Nullable) and is_variant_of(actual, ty_a[expected]) { return expected; };
    if ty_is(actual, Ty.Null) and ty_is(expected, Ty.Nullable) {
        w_pop();
        w_leaf(Op.RefNull, repr(expected), heap_of(repr(expected)), 0);
        return expected;
    };
    if ty_is(expected, Ty.Void) {
        drop_value(actual);
        return expected;
    };
    if host_coerce(actual, expected) { return expected; };
    mismatch(at, expected, actual);
    expected;
}

fn heap_of(vt: I32) I32 { vt_nullable(vt); }

//! = Diagnostics


/// Report that the value at `at` is an `actual`, not the `expected`; or,
/// when it follows from an earlier mistake, count it there.
fn mismatch(at: I32, expected: I32, actual: I32) void {
    let site = value_site(at);
    // A local whose type came of a mistake: that mistake's consequence.
    if is_kind(site, Node.Identifier) and node_decl[site] >= 0 and decl_cause[node_decl[site]] >= 0 {
        fold_into(decl_cause[node_decl[site]]);
        return;
    };
    let k = want_for(site, expected);
    if k >= 0 {
        report_wanted(k, site, expected, actual);
        return;
    };
    report2(Diag.TypeMismatch, site, -1, expected, actual);
}

//! = Consequences
//!
//! As in stage 0, a mismatch that follows from another (a local typed by a
//! mistaken initializer, a tuple or closure whose part is mistaken) is not
//! reported again: the first one counts it, `(+1 caused by this)`. For a
//! TypeMismatch, diag_c is that count (-1 for none).

/// By declaration (a let): the mismatch in its initializer, or -1.
vec decl_cause: I32;

fn fold_into(i: I32) void {
    if i < 0 or i >= diag_kind.len() { return; };
    // (A TypeMismatch's diag_c holds its reason above the count: see @want.)
    diag_c[i] = if diag_c[i] < 0 { 1; } else { diag_c[i] + 1; };
}

/// The first mismatch reported since diagnostic `from` at `node`'s value, or -1.
fn mismatch_since(from: I32, node: I32) I32 {
    let site = value_site(node);
    for (from ..< diag_kind.len()) |i| {
        if diag_kind[i] == Diag.TypeMismatch.to_i32() and diag_node[i] == site { return i; };
    };
    -1;
}

/// The first mismatch reported since diagnostic `from`, or -1.
fn any_mismatch_since(from: I32) I32 {
    for (from ..< diag_kind.len()) |i| { if diag_kind[i] == Diag.TypeMismatch.to_i32() { return i; }; };
    -1;
}

/// Where a value comes from, to point at: a block's is its last expression's.
fn value_site(node: I32) I32 {
    if is_kind(node, Node.Block) and last_child(node) >= 0 { return value_site(last_child(node)); };
    // A DSL's splice: the utu written in its body; so too a parenthesis
    // the expansion wrote around one.
    if is_kind(node, Node.Splice) { return value_site(first_child(node)); };
    if is_kind(node, Node.Paren_expr) and dsl_site_of(node) >= 0 and is_kind(first_child(node), Node.Splice) { return value_site(first_child(node)); };
    node;
}

/// Whether an operand's type is unknown to stage 0: a name, or a call of
/// one, that does not resolve. An operator over it is reported too.
fn unresolved(node: I32) Bool {
    if is_kind(node, Node.Paren_expr) or is_kind(node, Node.Splice) { return unresolved(first_child(node)); };
    if is_kind(node, Node.Identifier) { return node_decl[node] < 0; };
    if is_kind(node, Node.Call_expr) { return unresolved(first_child(node)); };
    false;
}

/// Something the compiler cannot do yet: reported, and checking goes on.
fn unsupported(at: I32) I32 {
    // A mistake already reported inside this code made it unreadable: say nothing more.
    // (A host module whose declarations were not found is reported at its using.)
    let d = if is_kind(at, Node.Identifier) { node_decl[at]; } else { -1; };
    if not reported_within(at) and not (decl_is(d, Decl.Foreign) and decl_a[d] < 0) { report(Diag.Unsupported, at, -1); };
    error_value();
}

/// Whether a diagnostic is about a node within `at` (its tokens).
fn reported_within(at: I32) Bool {
    if at < 0 { return false; };
    for (0 ..< diag_kind.len()) |i| {
        let n = diag_node[i];
        if n >= 0 and node_first[n] >= node_first[at] and node_first[n] < node_last[at] { return true; };
    };
    false;
}

/// `module.name` where the module has no such member: reported, and its value an error.
fn module_member_missing(module: I32, name: I32) I32 {
    report_module_member_missing(module, name);
    error_value();
}

fn report_module_member_missing(module: I32, name: I32) void {
    if reported_within(name) { return; };
    report3(Diag.UnknownMember, name, word_of(name), -1, -1, decl_name[module]);
}

/// A string literal @decode_string refused: a bad escape, or a lone
/// surrogate (which no constant's name can hold).
fn bad_literal(at: I32) I32 {
    report_bad_literal(at);
    error_value();
}

fn report_bad_literal(at: I32) void {
    // A lone surrogate: half of a pair, which a string cannot hold alone.
    if bad_escape[0] < 0 { report2(Diag.InvalidEscape, at, -1, 1, -1); }
    else if bad_escape[1] == 2 { report2(Diag.InvalidEscape, at, -1, 3, -1); }
    // `\d`: the escape's two bytes, as a word, for the message.
    else if bad_escape[1] == 1 { report2(Diag.InvalidEscape, at, src.intern(bad_escape[0], bad_escape[0] + 2), 2, -1); }
    else { report(Diag.InvalidEscape, at, -1); };
}

/// A mistaken expression's value: `unreachable`, of type Error.
fn error_value() I32 {
    w_leaf(Op.Unreachable, vt_unreachable, 0, 0);
    ty_error();
}

/// A mistaken expression whose code is on the stack since `m`: that code,
/// then `unreachable`, of type Error.
fn error_since(m: I32) I32 {
    w_node(Op.Unreachable, vt_unreachable, 0, 0, m);
    ty_error();
}

//! = Expressions

/// Each expression's type as it was last checked, or -1: for queries
/// (`utu grep`, the editor), which the compiler does not read.
vec node_ty: I32;

/// Check an expression against the type expected of it (-1 for none):
/// push its IR node, record its type in @node_ty, and return the type.
fn check_expr(node: I32, expect: I32, cx: Cx) I32 {
    // The code made for it is its (a source map's spans), its parts' their own.
    let outer = cur_src[0];
    cur_src[0] = node;
    let t = check_node(node, expect, cx);
    cur_src[0] = outer;
    if node < node_ty.len() { node_ty[node] = t; };
    t;
}

/// @check_expr's work, by the node's kind.
fn check_node(node: I32, expect: I32, cx: Cx) I32 {
    match Node.from_i32(node_kind[node]) {
        Node.Identifier => check_ident(node, cx),
        Node.Literal => check_literal(node, expect, cx),
        Node.Template_string => check_template(node, cx),
        Node.Paren_expr => check_expr(first_child(node), expect, cx),
        Node.Splice => check_expr(first_child(node), expect, cx),
        Node.Binary_expr => check_binary(node, expect, cx),
        Node.Unary_expr => check_unary(node, expect, cx),
        Node.Call_expr => check_call(node, expect, cx),
        Node.Block => check_block(node, expect, cx),
        Node.Block_expr => check_labeled(node, expect, cx),
        Node.Bind_expr => check_let(node, cx),
        Node.Assign_expr => check_assign(node, cx),
        Node.If_expr => check_if(node, expect, cx),
        Node.While_expr => check_while(node, cx),
        Node.For_expr => check_for(node, cx),
        Node.Return_expr => check_return(node, cx),
        Node.Break_expr => check_break(node, true, cx),
        Node.Continue_expr => check_break(node, false, cx),
        Node.Fatal_expr => {
            w_leaf(Op.Unreachable, vt_unreachable, 0, 0);
            ty_never();
        },
        Node.Assert_expr => check_assert(node, cx),
        Node.Field_expr => check_field(node, expect, cx),
        Node.Type_member_expr => check_type_member(node, expect, cx),
        Node.Struct_init => check_struct_init(node, expect, cx),
        Node.Implicit_struct_init => check_implicit_init(node, expect, cx),
        Node.Index_expr => check_index(node, expect, cx),
        Node.Slice_expr => check_index(node, expect, cx),
        Node.Array_expr => check_array_lit(node, expect, cx),
        Node.Promoted_module_call_expr => check_promoted_call(node, expect, cx),
        Node.Alt_expr => check_alt(node, expect, cx),
        Node.Match_expr => check_match(node, expect, cx),
        Node.Loop_match_expr => check_match(node, expect, cx),
        Node.Promote_expr => check_promote(node, expect, cx),
        Node.Else_expr => check_orelse(node, expect, cx),
        Node.Null_expr => check_null_expr(node, cx),
        Node.Try_expr => check_try(node, expect, cx),
        Node.Tuple_expr => check_tuple(node, expect, cx),
        Node.Closure_expr => check_closure(node, expect, cx),
        Node.Yield_expr => check_yield(node, cx),
        Node.New_expr => check_new(node, expect, cx),
        Node.Prune_expr => check_prune(node),
        Node.Iterator_expr => check_iterator(node, expect, cx),
        Node.Pipe_expr => check_pipe(node, expect, cx),
        Node.Defer_expr => check_defer(node),
        Node.Errdefer_expr => check_errdefer(node, cx),
        Node.Try_result_expr => check_try_result(node, cx),
        Node.Optional_field_expr => check_field_get(node, expect, cx),
        Node.Await_expr => check_await(node, cx),
        Node.Dsl_expr => {
            // (@es binds a typed let; anywhere else its type is unknown.)
            if dsl_has_failed(node) { error_value(); } else if is_es(node) {
                report(Diag.InvalidDslUsage, node, -1);
                error_value();
            } else if is_wat(node) {
                report(Diag.WatPlace, node, -1);
                error_value();
            } else {
                // Any other DSL in a value's place: one that is not there, or one that fills a mem.
                report(Diag.DslPlace, node, word_of(first_child(node)));
                error_value();
            };
        },
        ~> unsupported(node),
    };
}

fn check_ident(node: I32, cx: Cx) I32 {
    let decl = node_decl[node];
    if decl < 0 { return error_value(); };
    let k = decl_kind[decl];
    if k == Decl.Global.to_i32() and is_es(last_child(decl_node[decl])) {
        let t = global_type_in(decl, cx.inst);
        es_import(decl, last_child(decl_node[decl]), t);
        return es_read(decl, t);
    };
    if decl_es[decl] >= 0 { return es_read(decl, decl_ty[decl]); };
    if k == Decl.Global.to_i32() { return global_get(decl, global_inst(decl, cx.inst)); };
    if k == Decl.Fn.to_i32() and is_generator(decl) {
        report(Diag.GeneratorCall, node, decl_name[decl]);
        return error_value();
    };
    if k == Decl.Fn.to_i32() { return fn_value(decl, cx); };
    if k == Decl.Mem.to_i32() {
        report(Diag.MemNotValue, node, decl_name[decl]);
        return error_value();
    };
    if is_type_decl(decl) { return not_value(node, decl); };
    let t = decl_ty[decl];
    read_value(decl, t);
    t;
}

//! = Literals

fn check_literal(node: I32, expect: I32, cx: Cx) I32 {
    let c = first_child(node);
    if c < 0 {
        // true, false, null
        let w = tok_word[node_first[node]];
        if w == Kw.True.to_i32() or w == Kw.False.to_i32() {
            w_i32(if w == Kw.True.to_i32() { 1; } else { 0; });
            return prelude(Prelude.Bool);
        };
        if expect >= 0 and ty_is(expect, Ty.Nullable) {
            let vt = repr(expect);
            w_leaf(Op.RefNull, vt, heap_of(vt), 0);
            return expect;
        };
        if expect < 0 or not ty_is(expect, Ty.Error) { report(Diag.BareNull, node, -1); };
        w_leaf(Op.RefNull, vt_externref, vt_externref, 0);
        return ty_error();
    };
    if is_kind(c, Node.Int_lit) { return int_literal(c, c, expect, false); };
    if is_kind(c, Node.Float_lit) { return float_literal(c, expect, false); };
    if is_kind(c, Node.String_lit) or is_kind(c, Node.Multiline_string_lit) {
        if not string_literal(c) { return bad_literal(node); };
        return prelude(Prelude.Str);
    };
    unsupported(node);
}

/// `text ${e} text`: its pieces joined with Str's `+`, left to right, each
/// `e` as `e.to_str()`, and empty text left out (as stage 0 desugars it).
fn check_template(node: I32, cx: Cx) I32 {
    let str_t = prelude(Prelude.Str);
    let add = fn_instance(member(ty_decl(str_t), known_word(Known.Add), Space.Operator), ty_inst(str_t));
    let m = w_mark();
    let pieces = 0;
    let c = first_child(node);
    while (c >= 0) {
        let joined = true;
        if is_kind(c, Node.Template_full) or is_kind(c, Node.Template_head) or is_kind(c, Node.Template_middle) or is_kind(c, Node.Template_tail) {
            let t = node_first[c];
            // After its backtick or `}`; before its backtick or `${`.
            let start = tok_start[t] + 1;
            let end_ = tok_end[t] - if src[tok_end[t] - 1] == 96 { 1; } else { 2; };
            joined = end_ > start;
            if joined and not template_text(start, end_) { return bad_literal(node); };
        } else {
            template_value(c, cx);
        };
        if joined {
            pieces += 1;
            if pieces > 1 { finish_call(add, m, cx); };
        };
        c = next_sibling(c);
    };
    if pieces == 0 {
        lit_bytes.clear();
        push_lit_bytes();
    };
    str_t;
}

/// `${e}`: `e.to_str()`.
fn template_value(e: I32, cx: Cx) void {
    let m = w_mark();
    let rt = check_expr(e, -1, cx);
    if ty_is(rt, Ty.Error) { return; };
    to_str_of(rt, e, m, cx);
}

/// `wutu.show(x)`, what a Wutu text hole (`= x;`) becomes: a number or a
/// Bool is its `to_str()`, a Str or a node is itself (as stage 0 lowers it).
fn check_wutu_show(node: I32, args: I32, cx: Cx) I32 {
    let a = if args >= 0 { first_child(args); } else { -1; };
    if a < 0 or next_sibling(a) >= 0 {
        report2(Diag.WrongArity, node, -1, 1, if args >= 0 { child_count(args); } else { 0; });
        return error_value();
    };
    let m = w_mark();
    let rt = check_expr(a, -1, cx);
    if ty_is(rt, Ty.Error) { return rt; };
    if in_words("I32 U32 I64 U64 F32 F64 Bool", type_text(rt)) {
        to_str_of(rt, a, m, cx);
        return prelude(Prelude.Str);
    };
    if not shows_as_itself(rt) {
        report2(Diag.WutuHole, unspliced(a), -1, rt, -1);
        return error_value();
    };
    rt;
}

/// The node a splice holds (where it is written).
fn unspliced(n: I32) I32 {
    let x = n;
    while (is_kind(x, Node.Splice) and first_child(x) >= 0) { x = first_child(x); };
    x;
}

/// Whether a hole shows a value of type t as it is: a Str, a host value (a
/// node), or null.
fn shows_as_itself(t: I32) Bool {
    if ty_is(t, Ty.Null) or is_foreign_or_nullable(t) { return true; };
    ty_is(t, Ty.Named) and in_words("Str Externref", type_text(t));
}

/// `wutu.key_text(k)`, what a loop's `key k` becomes: a Str is itself, a
/// number or a Bool its `to_str()`; anything else is no key.
fn check_wutu_key(node: I32, args: I32, cx: Cx) I32 {
    let a = if args >= 0 { first_child(args); } else { -1; };
    if a < 0 or next_sibling(a) >= 0 {
        report2(Diag.WrongArity, node, -1, 1, if args >= 0 { child_count(args); } else { 0; });
        return error_value();
    };
    let m = w_mark();
    let rt = check_expr(a, -1, cx);
    if ty_is(rt, Ty.Error) { return rt; };
    if in_words("I32 U32 I64 U64 F32 F64 Bool", type_text(rt)) {
        to_str_of(rt, a, m, cx);
        return prelude(Prelude.Str);
    };
    if ty_is(rt, Ty.Named) and type_text(rt) == "Str" { return rt; };
    report2(Diag.WutuKey, unspliced(a), -1, rt, -1);
    error_value();
}

/// Whether `callee` is `wutu.show` (std:Wutu's).
fn is_wutu_show(callee: I32) Bool { is_wutu_fn(callee, "show"); }

/// Whether `callee` is std:Wutu's function `name` (`wutu.name`).
fn is_wutu_fn(callee: I32, name: Str) Bool {
    if not is_kind(callee, Node.Field_expr) { return false; };
    let base = first_child(callee);
    // (The declaration first: a module's is rare, and the text is made.)
    is_kind(base, Node.Identifier) and decl_is(node_decl[base], Decl.Module) and word_text(word_of(base)) == "wutu"
        and word_text(word_of(last_child(callee))) == name;
}

//! = Reusing a component's DOM
//!
//! A Wutu text hole that calls a function, `= f(a, b);`, asks
//! `wutu.memo_key(f(a, b), `…`)` for a key first: the template string (f's
//! name and its arguments as text) when the call can be reused while its
//! arguments are unchanged, else "" (never reused). On a re-render with the
//! same key the reconciler puts back the element f made last time without
//! calling f. A call can be reused when every argument is a scalar or a Str
//! (compared by value, so nothing it reads can change unseen) and f is
//! memo-safe: it, and every function it calls, reads no global or mem,
//! calls no host function or `@es` binding of its own (std's and the
//! template's helpers are trusted), and uses none of std:Wutu's effects
//! (route, refresh, timers, cleanups, storage).

/// `wutu.memo_key(f(…), `…`)`: the key's template when f(…) may be reused, else "".
fn check_memo_key(node: I32, args: I32, cx: Cx) I32 {
    let call = if args >= 0 { first_child(args); } else { -1; };
    let key = if call >= 0 { next_sibling(call); } else { -1; };
    if key < 0 {
        report2(Diag.WrongArity, node, -1, 2, if args >= 0 { child_count(args); } else { 0; });
        return error_value();
    };
    if memoizable_call(call, cx) { return check_expr(key, prelude(Prelude.Str), cx); };
    lit_bytes.clear();
    push_lit_bytes();
    prelude(Prelude.Str);
}

/// Whether `call` is `f(args)` with f memo-safe and each argument a scalar or
/// Str, itself memo-safe (it is evaluated for the key as well as the call).
fn memoizable_call(call: I32, cx: Cx) Bool {
    while (is_kind(call, Node.Splice)) { call = first_child(call); };
    if not is_kind(call, Node.Call_expr) { return false; };
    let callee = first_child(call);
    while (is_kind(callee, Node.Splice)) { callee = first_child(callee); };
    let f = -1;
    if is_kind(callee, Node.Identifier) { f = node_decl[callee]; }
    else if is_kind(callee, Node.Field_expr) and is_kind(first_child(callee), Node.Identifier) and decl_is(node_decl[first_child(callee)], Decl.Module) {
        f = static_member(node_decl[first_child(callee)], word_of(last_child(callee)));
    };
    if not decl_is(f, Decl.Fn) or not memo_safe_fn(f) { return false; };
    let args = next_sibling(callee);
    let a = if args >= 0 { first_child(args); } else { -1; };
    while (a >= 0) {
        if not memo_safe_node(a) { return false; };
        // Its type, by checking it once and dropping the code.
        let m = w_mark();
        let t = check_expr(a, -1, cx);
        while (w_stack.len() > m) { w_pop(); };
        if ty_is(t, Ty.Error) or not in_words("I32 U32 I64 U64 F32 F64 Bool Str", type_text(t)) { return false; };
        a = next_sibling(a);
    };
    true;
}

/// By declaration: 0 not yet known, 1 being decided, 2 memo-safe, 3 not.
vec memo_state: I32;

/// Whether function `decl` is memo-safe (see above). A function in a file
/// that is not the program's own (std's) is, but std:Wutu's effects.
fn memo_safe_fn(decl: I32) Bool {
    if not decl_is(decl, Decl.Fn) { return false; };
    while (memo_state.len() <= decl) { memo_state.push(0); };
    let state = memo_state[decl];
    if state == 2 or state == 1 { return true; };
    if state == 3 { return false; };
    memo_state[decl] = 1;
    let node = decl_node[decl];
    let ok = if file_std[file_of_token(node_first[node])] == 1 { std_memo_safe(decl); } else { memo_safe_node(node); };
    memo_state[decl] = if ok { 2; } else { 3; };
    ok;
}

/// A std function: all are memo-safe but those that ask the host for
/// something new each time (the clock, random seeds, streams) and std:Wutu's effects.
fn std_memo_safe(decl: I32) Bool {
    let module = module_of(decl);
    if module < 0 { return true; };
    let m = word_text(decl_name[module]);
    let w = fn_word(decl);
    let name = if w >= 0 { word_text(w); } else { ""; };
    if m == "time" or m == "Stream" or (m == "Random" and name == "from_host") { return false; };
    if m != "wutu" { return true; };
    in_words("init show memo_key key_text number money decimal", name);
}

/// A method call's every candidate (`x.f(…)`: any type's method f, its
/// receiver's type not yet known here) is memo-safe.
fn memo_safe_methods(word: I32) Bool {
    let k = 0;
    while (k < decl_kind.len()) {
        if decl_is(k, Decl.Fn) and decl_a[k] >= 0 and fn_word(k) == word and not memo_safe_fn(k) { return false; };
        k += 1;
    };
    true;
}

/// Whether the code at `n` keeps a function memo-safe.
fn memo_safe_node(n: I32) Bool {
    if n < 0 { return true; };
    if is_kind(n, Node.Bind_expr) and is_es(last_child(n)) {
        // A template's own helper bindings are trusted; another `@es` is the host.
        return text_at(word_text(word_of(first_child(n))), 0, "__wutu_");
    };
    if is_kind(n, Node.Dsl_expr) and is_es(n) { return false; };
    if is_kind(n, Node.Identifier) {
        let d = node_decl[n];
        // A global, a mem, or a host module (`Browser`, an npm package).
        if decl_is(d, Decl.Global) or decl_is(d, Decl.Mem) or decl_is(d, Decl.Foreign) { return false; };
        if decl_is(d, Decl.Fn) { return memo_safe_fn(d); };
        return true;
    };
    if is_kind(n, Node.Field_expr) or is_kind(n, Node.Type_member_expr) {
        let base = first_child(n);
        // (`Browser.document` is a type member: its base a type name.)
        let named = is_kind(base, Node.Identifier) or is_kind(n, Node.Type_member_expr);
        if named {
            let d = node_decl[base];
            if d < 0 and first_child(base) >= 0 { d = node_decl[first_child(base)]; };
            if decl_is(d, Decl.Foreign) { return false; };
            // An unresolved base is a host name (`Browser.document`).
            if d < 0 { return false; };
            if decl_is(d, Decl.Module) or decl_is(d, Decl.Struct) or decl_is(d, Decl.Enum) {
                let f = static_member(d, word_of(last_child(n)));
                // (No utu member by that name: a module's is a host's, `Browser.document`.)
                if f < 0 { return not decl_is(d, Decl.Module); };
                if decl_is(f, Decl.Fn) { return memo_safe_fn(f); };
                return not (decl_is(f, Decl.Global) or decl_is(f, Decl.Mem));
            };
        };
        // `x.f(…)`: a method of x's type.
        let p = parent_of(n);
        if is_kind(n, Node.Field_expr) and p >= 0 and is_kind(p, Node.Call_expr) and first_child(p) == n {
            let m = node_decl[last_child(n)];
            if decl_is(m, Decl.Fn) { if not memo_safe_fn(m) { return false; }; }
            else if not memo_safe_methods(word_of(last_child(n))) { return false; };
        };
        return memo_safe_node(base);
    };
    let c = first_child(n);
    while (c >= 0) {
        if not memo_safe_node(c) { return false; };
        c = next_sibling(c);
    };
    true;
}

/// The value of type rt (checked, its code from mark m) as `.to_str()`.
fn to_str_of(rt: I32, e: I32, m: I32, cx: Cx) void {
    let word = known_word(Known.ToStr);
    if ty_is(rt, Ty.Nullable) {
        report2(Diag.NullableAccess, e, word, rt, -1);
        w_node(Op.Unreachable, vt_unreachable, 0, 0, m);
        return;
    };
    let decl = member(ty_decl(rt), word, Space.Method);
    if decl < 0 {
        report2(Diag.UnknownMethod, e, word, rt, -1);
        w_node(Op.Unreachable, vt_unreachable, 0, 0, m);
        return;
    };
    let fi = fn_instance(decl, ty_inst(rt));
    // As `e.to_str()` is checked: its receiver, no arguments, and a Str.
    if vl_len[fi_params[fi]] == 0 {
        report2(Diag.WrongArity, e, -1, 0, 1);
        w_node(Op.Unreachable, vt_unreachable, 0, 0, m);
        return;
    };
    coerce(rt, vl_item(fi_params[fi], 0), e);
    let t = call_with(fi, -1, 1, m, e, cx);
    if not ty_is(t, Ty.Error) { coerce(t, prelude(Prelude.Str), e); };
}

/// An integer literal's magnitude, as 64 unsigned bits (one past them
/// wraps as it is read; see @past_64_bits).
fn int_value(node: I32) I64 {
    let t = node_first[node];
    let i = tok_start[t];
    let end_ = tok_end[t];
    let v: I64 = 0;
    if end_ - i > 2 and src[i] == 48 and (src[i + 1] == 120 or src[i + 1] == 98) {
        let hex = src[i + 1] == 120;
        i += 2;
        while (i < end_) {
            let c = src[i];
            let d = if c >= 97 { c - 87; } else if c >= 65 { c - 55; } else { c - 48; };
            v = if hex { v * 16 + d.to_i64(); } else { v * 2 + d.to_i64(); };
            i += 1;
        };
        return v;
    };
    while (i < end_) {
        v = v * 10 + (src[i] - 48).to_i64();
        i += 1;
    };
    v;
}

/// The type an integer literal takes: the one expected, when integers
/// adopt it, else I32. `at` is the literal as written: with its minus,
/// when `negate`.
fn int_literal(node: I32, at: I32, expect: I32, negate: Bool) I32 {
    let t = if expect >= 0 and is_numeric(expect) { expect; } else { prelude(Prelude.I32); };
    if not literal_fits(node, t, negate) {
        report2(Diag.IntegerOutOfRange, at, -1, t, if negate { 1; } else { 0; });
        in_instance(cur_inst[0]);
    };
    push_number(t, literal_bits(node, t, negate), true);
    t;
}

/// Whether an integer literal is past what 64 bits hold (it would wrap as
/// it is read): more significant digits than 2^64 - 1 has, or as many and
/// greater.
fn past_64_bits(node: I32) Bool {
    let t = node_first[node];
    let i = tok_start[t];
    let end_ = tok_end[t];
    let max = "18446744073709551615";
    let per = 0;
    if end_ - i > 2 and src[i] == 48 and (src[i + 1] == 120 or src[i + 1] == 98) {
        per = if src[i + 1] == 120 { 16; } else { 64; };
        i += 2;
    };
    while (i < end_ - 1 and src[i] == 48) { i += 1; };
    let n = end_ - i;
    if per > 0 { return n > per; };
    if n != max.len() { return n > max.len(); };
    for (0 ..< n) |k| {
        let d = src[i + k];
        let m = max[k];
        if d != m { return d > m; };
    };
    false;
}

/// Whether integer literal `node`, negated or not, is in -neg ..= pos: its
/// magnitude, read as 64 unsigned bits, against `neg` or `pos`.
fn int_in(node: I32, negate: Bool, neg: U64, pos: U64) Bool {
    if past_64_bits(node) { return false; };
    int_value(node).to_u64() <= if negate { neg; } else { pos; };
}

/// Whether a literal (integer or float), negated or not, fits numeric type
/// `t`. An integer fits I32 and I64 by their signed ranges; U32, U64 and
/// the masks take no negative value; a float takes any 64-bit magnitude.
/// A float literal fits a float type when it is finite there.
fn literal_fits(node: I32, t: I32, negate: Bool) Bool {
    if is_kind(node, Node.Float_lit) {
        if not is_float(t) { return true; };
        let bits = literal_bits(node, t, negate);
        if t == prelude(Prelude.F32) { return (bits & 2147483647) != 2139095040; };
        return (bits & 9223372036854775807) != 9218868437227405312;
    };
    if t == prelude(Prelude.I32) { return int_fits(node, negate, 32, true); };
    if t == prelude(Prelude.U32) or t == prelude(Prelude.M32) { return int_fits(node, negate, 32, false); };
    if t == prelude(Prelude.I64) { return int_fits(node, negate, 64, true); };
    if t == prelude(Prelude.U64) or t == prelude(Prelude.M64) { return int_fits(node, negate, 64, false); };
    int_in(node, negate, 18446744073709551615, 18446744073709551615);
}

/// Whether integer literal `node`, negated or not, fits an integer of
/// `bits` bits, signed or not.
fn int_fits(node: I32, negate: Bool, bits: I32, signed: Bool) Bool {
    let one: U64 = 1;
    let top = one << (bits - 1).to_u64();
    if signed { return int_in(node, negate, top, top - one); };
    int_in(node, negate, 0, top - one + top);
}

/// The bits a literal (integer or float), negated or not, makes as numeric
/// type `t` (an F32's in the low 32). An integer's magnitude goes to a float
/// unsigned and is rounded once; a float is negated by its sign, so `-0.0`
/// is negative zero.
fn literal_bits(node: I32, t: I32, negate: Bool) I64 {
    let f32 = t == prelude(Prelude.F32);
    if is_kind(node, Node.Float_lit) {
        let text = token_text(node_first[node]);
        if f32 {
            let f = parse_f32(text).to_f32();
            return (if negate { -f; } else { f; }).bits().to_i64() & 4294967295;
        };
        let d = parse_number(text);
        return (if negate { -d; } else { d; }).bits();
    };
    let v = int_value(node);
    if f32 {
        let f = v.to_u64().to_f32();
        return (if negate { -f; } else { f; }).bits().to_i64() & 4294967295;
    };
    if t == prelude(Prelude.F64) {
        let d = v.to_u64().to_f64();
        return (if negate { -d; } else { d; }).bits();
    };
    if negate { 0 - v; } else { v; };
}

/// A token's source text.
fn token_text(t: I32) Str {
    let text = "";
    for (tok_start[t] ..< tok_end[t]) |i| { text = text + Str.from_code_point(src[i]); };
    text;
}

/// Push a constant of numeric type `t`: the integer `v`, or (when `is_bits`)
/// the constant whose bits are `v` (an F32's in the low 32).
fn push_number(t: I32, v: I64, is_bits: Bool) void {
    let vt = repr(t);
    if vt == vt_i32 {
        w_i32(v.to_i32());
    } else if vt == vt_i64 {
        w_leaf(Op.I64Const, vt_i64, (v & 4294967295).to_i32(), (v >> 32).to_i32());
    } else if vt == vt_f64 {
        let bits = if is_bits { v; } else { v.to_f64().bits(); };
        w_leaf(Op.F64Const, vt_f64, (bits & 4294967295).to_i32(), (bits >> 32).to_i32());
    } else if vt == vt_f32 {
        w_leaf(Op.F32Const, vt_f32, if is_bits { v.to_i32(); } else { v.to_f32().bits(); }, 0);
    } else {
        w_i32(v.to_i32());
    };
}

let parse_number: fun(Str) F64 = @es/\ (s) => Number(s) \/;

/// A float literal's value as F32, rounded once (as an F64, exactly): the
/// F64 nearest it is rounded again unless that lies halfway between two
/// F32s; then the literal's digits pick the side.
let parse_f32: fun(Str) F64 = @es/\ (s) => {
    const d = Number(s), f = Math.fround(d);
    if (f === d || !Number.isFinite(f)) return f;
    const b = new Float32Array([f]), u = new Uint32Array(b.buffer);
    u[0] += f < d ? 1 : -1;
    const g = b[0];
    if ((f + g) / 2 !== d) return f;
    let m = d, e = 0n;
    while (!Number.isInteger(m)) { m *= 2; e += 1n; }
    const t = s.toLowerCase(), k = t.indexOf("e"), mant = k < 0 ? t : t.slice(0, k), dot = mant.indexOf(".");
    const x = BigInt(k < 0 ? 0 : Number(t.slice(k + 1))) - BigInt(dot < 0 ? 0 : mant.length - dot - 1);
    let l = BigInt(mant.replace(".", "")) * 2n ** e, r = BigInt(m);
    if (x >= 0n) l *= 10n ** x; else r *= 10n ** -x;
    if (l === r) return f;
    return (l > r) === (g > f) ? g : f;
} \/;

fn float_literal(node: I32, expect: I32, negate: Bool) I32 {
    let ft = if expect >= 0 and is_float(expect) { expect; } else { prelude(Prelude.F64); };
    if not literal_fits(node, ft, negate) { report2(Diag.FloatOutOfRange, node, -1, ft, if negate { 1; } else { 0; }); };
    push_number(ft, literal_bits(node, ft, negate), true);
    ft;
}

//! = Locals and globals

fn check_let(node: I32, cx: Cx) I32 {
    let name = first_child(node);
    if is_kind(name, Node.Tuple_pattern) { return check_let_tuple(node, cx); };
    let decl = node_decl[name];
    let init = last_child(node);
    let annotated = next_sibling(name) != init;
    let t = if annotated { type_of(next_sibling(name), cx.inst); } else { -1; };
    if not annotated and is_empty_array(init) { t = later_array_type(decl, node, cx); };
    // `let f = cl(e) void {…}; el.addEventListener("x", f);`: its first use as a host argument types it.
    if not annotated and is_kind(init, Node.Closure_expr) and has_foreign() { t = first_host_use(decl, node, cx); };
    if is_es(init) and annotated {
        t = es_binding_type(t);
        decl_ty[decl] = t;
        es_import(decl, init, t);
        // (A binding of the import: nothing to run.)
        w_node(Op.Seq, vt_none, 0, 0, w_mark());
        return ty_void();
    };
    let m = w_mark();
    if decl_boxed[decl] == 1 and is_kind(init, Node.Closure_expr) {
        // A closure that calls itself: its box first (a closure is an
        // externref), then the closure, which captures the box, into it.
        let h = box_type(vt_externref);
        let mb = w_mark();
        w_leaf(Op.RefNull, vt_externref, vt_externref, 0);
        w_node(Op.StructNew, vt_ref(h, false), h, 0, mb);
        let local = new_local(vt_ref(h, true));
        decl_local[decl] = local;
        decl_ty[decl] = if annotated { t; } else { closure_syntax_type(init, cx.inst); };
        w_node(Op.LocalSet, vt_none, local, 0, mb);
        let ms = w_mark();
        w_leaf(Op.LocalGet, vt_ref(h, true), local, 0);
        let actual = check_expr(init, t, cx);
        if annotated { coerce(actual, t, init); } else { t = actual; };
        decl_ty[decl] = t;
        w_node(Op.StructSet, vt_none, h, 0, ms);
        w_node(Op.Seq, vt_none, 0, 0, m);
        return ty_void();
    };
    let before = diag_kind.len();
    if annotated { want(init, t, Why.Annotation, next_sibling(name), decl_name[decl]); };
    let actual = check_expr(init, t, cx);
    if annotated {
        coerce(actual, t, init);
        unwant();
    } else { t = actual; };
    decl_cause[decl] = any_mismatch_since(before);
    if ty_is(t, Ty.Null) {
        report(Diag.TypeMismatch, init, -1);
        t = ty_error();
    };
    decl_ty[decl] = t;
    if ty_is(t, Ty.Void) {
        // (After a mistake in the value, its being void is no news; a
        // defer as a value is validation's to report.)
        if diag_kind.len() == before and not is_kind(init, Node.Defer_expr) { report(Diag.VoidLet, name, word_of(name)); };
        decl_ty[decl] = ty_error();
        return error_since(m);
    };
    if ty_is(t, Ty.Never) {
        // Nothing to hold: the expression does not finish, and a read of
        // the name never runs (see @read_value).
        w_node(Op.Seq, repr(t), 0, 0, m);
        return ty_void();
    };
    bind_value(decl, t, m);
    ty_void();
}

//! == Global instances
//!
//! A global of a generic mod is one per instance: each instance of the mod
//! has its own, of its own type, set by its own initializer. A global of
//! any other module has one instance, 0.

/// By global instance: its declaration and module instance.
vec gi_decl: I32;
vec gi_inst: I32;
/// Its wasm global; -1 not made yet, -2 none (reported).
vec gi_global: I32;
/// Its type.
vec gi_ty: I32;
/// Its index in @computed_gi, or -1.
vec gi_init: I32;
/// The next instance of the same declaration, or -1.
vec gi_next: I32;
/// By declaration: its first global instance, or -1.
vec decl_gi: I32;

/// Global `decl` in module instance `inst`, made when new (not checked).
fn global_instance(decl: I32, inst: I32) I32 {
    let g = decl_gi[decl];
    while (g >= 0) {
        if gi_inst[g] == inst { return g; };
        g = gi_next[g];
    };
    let id = gi_decl.len();
    gi_decl.push(decl);
    gi_inst.push(inst);
    gi_global.push(-1);
    gi_ty.push(0);
    gi_init.push(-1);
    gi_next.push(decl_gi[decl]);
    decl_gi[decl] = id;
    id;
}

/// The instance a global is read in from code in instance `inst`.
fn global_inst(decl: I32, inst: I32) I32 { instance_for(module_of(decl), inst); }

fn global_type(decl: I32) I32 { global_type_in(decl, 0); }

/// A global's type, seen from instance `inst` (an `@es` binding of a
/// generic module has a type in each).
fn global_type_in(decl: I32, inst: I32) I32 {
    let t = type_of(next_sibling(first_child(decl_node[decl])), inst);
    if is_es(last_child(decl_node[decl])) { t = es_binding_type(t); };
    decl_ty[decl] = t;
    t;
}

/// An `@es` binding's type, each `fun(…)` parameter read as `cl(…)`:
/// JavaScript calls either alike, and a closure is what utu code passes.
fn es_binding_type(t: I32) I32 {
    if not ty_is(t, Ty.Fun) { return t; };
    let params = ty_a[t];
    let funs = false;
    for (0 ..< vl_len[params]) |i| { if ty_is(vl_item(params, i), Ty.Fun) { funs = true; }; };
    if not funs { return t; };
    let mark = vl_begin();
    for (0 ..< vl_len[params]) |i| {
        let p = vl_item(params, i);
        vl_add(if ty_is(p, Ty.Fun) { ty(Ty.Closure, ty_a[p], ty_b[p]); } else { p; });
    };
    ty(Ty.Fun, vl_end(mark), ty_b[t]);
}

/// A function named as a value: a `fun`.
fn fn_value(decl: I32, cx: Cx) I32 { fn_value_in(decl, instance_for(module_of(decl), cx.inst)); }

/// Function `decl` of module instance `inst` as a value (`f`, `m.f`, `T.f`).
fn fn_value_in(decl: I32, inst: I32) I32 {
    let fi = fn_instance(decl, inst);
    note_edge(fi);
    let f = function_of(fi);
    let t = ty(Ty.Fun, fi_params[fi], fi_result[fi]);
    w_leaf(Op.RefFunc, vt_ref(func_type_of[f], false), f, 0);
    t;
}

/// Global `decl` of module instance `inst`, read.
fn global_get(decl: I32, inst: I32) I32 {
    let gi = global_instance(decl, inst);
    // Its initializer is checked where its diagnostics are kept.
    if speculating[0] > 0 and gi_global[gi] == -1 {
        w_leaf(Op.Unreachable, vt_unreachable, 0, 0);
        return global_type_in(decl, inst);
    };
    let g = global_of(gi);
    if g < 0 { return error_value(); };
    let t = gi_ty[gi];
    w_leaf(Op.GlobalGet, glob_type[g], g, 0);
    // A computed global: noted, and a reference held nullable is read non-null.
    if gi_init[gi] >= 0 {
        note_edge(-2 - gi);
        if glob_type[g] != repr(t) { w_node(Op.RefAsNonNull, repr(t), 0, 0, w_mark() - 1); };
    };
    t;
}

/// A top-level `let` (global instance gi): a wasm global holding its
/// constant value, or one its initializer sets.
fn global_of(gi: I32) I32 {
    if gi_global[gi] != -1 { return gi_global[gi]; };
    enter_instance(gi_inst[gi], -1);
    let g = make_global(gi);
    leave_instance();
    g;
}

/// @global_of's work, in gi's instance.
fn make_global(gi: I32) I32 {
    let decl = gi_decl[gi];
    let node = decl_node[decl];
    let t = global_type_in(decl, gi_inst[gi]);
    gi_ty[gi] = t;
    let init = last_child(node);
    let m = w_mark();
    let cx = Cx { inst: gi_inst[gi], fi: -1, result: t };
    let actual = constant(init, t, cx);
    if actual < 0 {
        w_stack.resize(m);
        if is_wat(init) and not dsl_has_failed(init) {
            gi_global[gi] = -2;
            report(Diag.WatPlace, init, -1);
            return -2;
        };
        return computed_global(gi, t, init);
    };
    want(init, t, Why.Annotation, next_sibling(first_child(node)), decl_name[decl]);
    coerce(actual, t, init);
    unwant();
    let g = add_global(repr(t), false, w_pop());
    gi_global[gi] = g;
    g;
}

//! == Computed globals
//!
//! `let g: T = e;` with e not a literal: a mutable wasm global, set when the
//! module starts by a function of its own (e's code). The globals are set in
//! declaration order, but each after the globals its initializer reads,
//! directly or through the functions it calls (a closure it makes counts as
//! called). So no global is read before it is set; a cycle is an error. A
//! non-null reference is held nullable and read with `ref.as_non_null`.

/// The computed globals (global instances), in the order their initializers were made.
vec computed_gi: I32;
/// Each one's initializer function.
vec computed_init: I32;
/// What the code being checked belongs to: a function instance; -1 an
/// entry function; -2 - g global instance g's initializer.
vec cur_fn: I32 = [-1];
/// What code reads or calls, from (as @cur_fn) to (a function instance, or
/// -2 - g for computed global instance g).
vec edge_from: I32;
vec edge_to: I32;

fn note_edge(to: I32) void {
    if cur_fn[0] == -1 { return; };
    edge_from.push(cur_fn[0]);
    edge_to.push(to);
}

/// Global instance gi of type t, computed by `init`: its wasm global (zero
/// or null until set) and its initializer, a function checked now, perhaps
/// in the middle of another.
fn computed_global(gi: I32, t: I32, init: I32) I32 {
    let decl = gi_decl[gi];
    let vt = repr(t);
    let st = vt_nullable(vt);
    if vt_is_ref(st) { w_leaf(Op.RefNull, st, heap_of(st), 0); } else { push_number(t, 0.to_i64(), false); };
    let g = add_global(st, true, w_pop());
    gi_global[gi] = g;
    gi_init[gi] = computed_gi.len();
    computed_gi.push(gi);
    let f = defined_func(vl_empty(), t);
    func_debug_name[f] = name_add(word_text(decl_name[decl]) + ".init");
    computed_init.push(f);
    let outer = cur_fn[0];
    cur_fn[0] = -2 - gi;
    save_function();
    cur_params[0] = 0;
    mark_boxes(init);
    let m = w_mark();
    let cx = Cx { inst: gi_inst[gi], fi: -1, result: t };
    // The start function sets it, and a start function cannot suspend.
    let at = awaits_in(init);
    if at >= 0 {
        report(Diag.AwaitInGlobal, at, -1);
        diag_label(if is_kind(at, Node.Await_expr) { "suspends"; } else { "may suspend"; });
        diag_note("Globals are set as the module starts, before anything can suspend; await in a function");
    };
    want(init, t, Why.Annotation, next_sibling(first_child(decl_node[decl])), decl_name[decl]);
    coerce(check_expr(init, t, cx), t, init);
    unwant();
    w_node(Op.Seq, vt, 0, 0, m);
    func_body[f] = w_pop();
    record_locals(f, 0);
    restore_function();
    cur_fn[0] = outer;
    g;
}

/// After checking: the order the computed globals are set in (see above),
/// cycles reported, and the start function that sets them.
fn start_globals() void {
    let n = computed_gi.len();
    if n == 0 { return; };
    // The edges by source: function instances, then initializers.
    let nf = fi_decl.len();
    let first = Array[I32].new(nf + n + 1, 0);
    for (0 ..< edge_from.len()) |e| {
        let s = edge_source(edge_from[e], nf);
        if s >= 0 { first[s + 1] += 1; };
    };
    for (0 ..< nf + n) |s| { first[s + 1] += first[s]; };
    let fill = Array[I32].new(nf + n, 0);
    for (0 ..< nf + n) |s| { fill[s] = first[s]; };
    let to = Array[I32].new(edge_from.len() + 1, 0);
    for (0 ..< edge_from.len()) |e| {
        let s = edge_source(edge_from[e], nf);
        if s >= 0 {
            to[fill[s]] = edge_to[e];
            fill[s] += 1;
        };
    };
    // Each initializer's dependencies: the computed globals its code reaches.
    let seen = Array[I32].new(nf + n, -1);
    let deps_first = Array[I32].new(n + 1, 0);
    let work = Array[I32].new(nf + n + 1, 0);
    let dep_list = vl_begin();
    for (0 ..< n) |k| {
        let top = 1;
        work[0] = nf + k;
        seen[nf + k] = k;
        while (top > 0) {
            top -= 1;
            let s = work[top];
            for (first[s] ..< first[s + 1]) |i| {
                let t = to[i];
                if t >= 0 {
                    if seen[t] != k {
                        seen[t] = k;
                        work[top] = t;
                        top += 1;
                    };
                } else {
                    vl_add(gi_init[-2 - t]);
                };
            };
        };
        deps_first[k + 1] = vl_pending.len() - dep_list;
    };
    let deps = Array[I32].new(deps_first[n] + 1, 0);
    for (0 ..< deps_first[n]) |i| { deps[i] = vl_pending[dep_list + i]; };
    vl_pending.resize(dep_list);
    // Declaration order, each global after its dependencies.
    let by_place = Array[I32].new(n, 0);
    for (0 ..< n) |k| {
        let j = k;
        while (j > 0 and node_first[decl_node[gi_decl[computed_gi[by_place[j - 1]]]]] > node_first[decl_node[gi_decl[computed_gi[k]]]]) {
            by_place[j] = by_place[j - 1];
            j -= 1;
        };
        by_place[j] = k;
    };
    let state = Array[I32].new(n, 0);
    let m = w_mark();
    for (0 ..< n) |i| { set_global_after(by_place[i], deps, deps_first, state); };
    w_node(Op.Seq, vt_none, 0, 0, m);
    let f = helper(vl_empty(), vl_empty(), vl_empty(), "start");
    func_body[f] = w_pop();
    start_func[0] = f;
}

/// Where an edge's source is in @start_globals' arrays, or -1 (an entry function).
fn edge_source(from: I32, nf: I32) I32 {
    if from >= 0 { return from; };
    if from == -1 { return -1; };
    nf + gi_init[-2 - from];
}

/// Computed global k set (`global.set g (call init)`), after its
/// dependencies; one met again while it waits is a cycle, reported.
fn set_global_after(k: I32, deps: Array[I32], deps_first: Array[I32], state: Array[I32]) void {
    if state[k] != 0 { return; };
    state[k] = 1;
    for (deps_first[k] ..< deps_first[k + 1]) |i| {
        let j = deps[i];
        if state[j] == 1 {
            let d = gi_decl[computed_gi[k]];
            let o = gi_decl[computed_gi[j]];
            // (A generic mod's: which instance, said in a note.)
            enter_instance(gi_inst[computed_gi[k]], -1);
            report2(Diag.GlobalCycle, last_child(decl_node[d]), decl_name[d], if j == k { -1; } else { o; }, -1);
            if j != k { diag_place(Extra.Related, first_child(decl_node[o]), "needs " + word_text(decl_name[d])); };
            leave_instance();
        } else {
            set_global_after(j, deps, deps_first, state);
        };
    };
    state[k] = 2;
    let m = w_mark();
    let gi = computed_gi[k];
    w_leaf(Op.Call, repr(gi_ty[gi]), computed_init[k], 0);
    w_node(Op.GlobalSet, vt_none, gi_global[gi], 0, m);
}

/// A constant expression (a literal, maybe negated), or -1.
fn constant(node: I32, expect: I32, cx: Cx) I32 {
    if is_kind(node, Node.Literal) {
        let c = first_child(node);
        if c < 0 or is_kind(c, Node.Int_lit) or is_kind(c, Node.Float_lit) or is_kind(c, Node.String_lit) or is_kind(c, Node.Multiline_string_lit) {
            return check_literal(node, expect, cx);
        };
        return -1;
    };
    if is_kind(node, Node.Unary_expr) and tok_kind[node_first[node]] == Tok.Minus.to_i32() {
        let lit = first_child(last_child(node));
        if is_kind(last_child(node), Node.Literal) and is_kind(lit, Node.Int_lit) { return int_literal(lit, node, expect, true); };
        if is_kind(last_child(node), Node.Literal) and is_kind(lit, Node.Float_lit) { return float_literal(lit, expect, true); };
    };
    -1;
}

/// `x = e`, `x += e`, …
fn check_assign(node: I32, cx: Cx) I32 {
    let target = first_child(node);
    let value = last_child(node);
    let op = tok_kind[node_last[target]];
    // A parenthesis (a DSL's splice) is its expression.
    while (is_kind(target, Node.Splice)) { target = first_child(target); };
    if (is_kind(target, Node.Field_expr) and not is_module_path(target)) or is_kind(target, Node.Optional_field_expr) { return check_field_set(target, value, op, node, cx); };
    if is_kind(target, Node.Index_expr) { return check_index_set(target, value, op, node, cx); };
    // `T.Variant = …` or `module.f = …`: a constant, not a variable.
    if is_kind(target, Node.Type_member_expr) or (is_kind(target, Node.Field_expr) and is_module_path(target)) {
        let name = last_child(target);
        if node_decl[name] < 0 {
            let owner = node_decl[first_child(target)];
            if decl_is(owner, Decl.Module) { return module_member_missing(owner, name); };
            if reported_within(target) { return error_value(); };
            report(Diag.NotAssignable, target, -1);
            return error_value();
        };
        report(Diag.AssignmentToImmutable, name, word_of(name));
        diag_label(pick(decl_is(node_decl[name], Decl.Variant), "constant", "function"));
        return error_value();
    };
    if not is_kind(target, Node.Identifier) {
        report(Diag.NotAssignable, target, -1);
        return error_value();
    };
    let decl = node_decl[target];
    if decl < 0 { return error_value(); };
    if decl_is(decl, Decl.Global) or decl_is(decl, Decl.Fn) or decl_is(decl, Decl.Mem) {
        report(Diag.AssignmentToImmutable, target, word_of(target));
        // The value is still checked against what it would replace.
        if not decl_is(decl, Decl.Mem) {
            let tt = type_only(target, -1, cx);
            let m = w_mark();
            coerce(check_expr(value, tt, cx), tt, value);
            w_stack.resize(m);
        };
        return error_value();
    };
    let t = decl_ty[decl];
    let m = w_mark();
    write_begin(decl, t);
    if op == Tok.Eq.to_i32() {
        want(value, t, Why.Variable, decl, -1);
        coerce(check_expr(value, t, cx), t, value);
        unwant();
    } else {
        // `x op= e` is `x = x op e`.
        let word = compound_word(op, node_last[target]);
        let m2 = w_mark();
        read_value(decl, t);
        apply_operator(word, t, value, node, cx, m2);
    };
    write_end(decl, t, m);
    ty_void();
}

/// The operator a compound assignment applies (`+=` adds).
fn compound_word(op: I32, t: I32) I32 {
    if op == Tok.PlusEq.to_i32() { return known_word(Known.Add); };
    if op == Tok.MinusEq.to_i32() { return known_word(Known.Sub); };
    if op == Tok.StarEq.to_i32() { return known_word(Known.Mul); };
    if op == Tok.SlashEq.to_i32() { return known_word(Known.Div); };
    if op == Tok.PercentEq.to_i32() { return known_word(Known.Rem); };
    if op == Tok.AmpEq.to_i32() { return known_word(Known.Band); };
    if op == Tok.PipeEq.to_i32() { return known_word(Known.Bor); };
    if op == Tok.CaretEq.to_i32() { return known_word(Known.Bxor); };
    if op == Tok.ShlEq.to_i32() { return known_word(Known.Shl); };
    if op == Tok.ShrEq.to_i32() { return known_word(Known.Shr); };
    if op == Tok.Shr3Eq.to_i32() { return known_word(Known.Ushr); };
    // `and=`, `or=`, `xor=`: the word before `=`.
    tok_word[t];
}

//! = Operators

/// The operator method a binary operator token names (`+` is add), or the
/// keyword's id for `and`, `or`, `xor`.
fn operator_word(t: I32) I32 {
    let k = tok_kind[t];
    if k == Tok.Plus.to_i32() { return known_word(Known.Add); };
    if k == Tok.Minus.to_i32() { return known_word(Known.Sub); };
    if k == Tok.Star.to_i32() { return known_word(Known.Mul); };
    if k == Tok.Slash.to_i32() { return known_word(Known.Div); };
    if k == Tok.Percent.to_i32() { return known_word(Known.Rem); };
    if k == Tok.Amp.to_i32() { return known_word(Known.Band); };
    if k == Tok.Pipe.to_i32() { return known_word(Known.Bor); };
    if k == Tok.Caret.to_i32() { return known_word(Known.Bxor); };
    if k == Tok.Shl.to_i32() { return known_word(Known.Shl); };
    if k == Tok.Shr.to_i32() { return known_word(Known.Shr); };
    if k == Tok.Shr3.to_i32() { return known_word(Known.Ushr); };
    if k == Tok.EqEq.to_i32() { return known_word(Known.Eq); };
    if k == Tok.BangEq.to_i32() { return known_word(Known.Ne); };
    if k == Tok.Lt.to_i32() { return known_word(Known.Lt); };
    if k == Tok.LtEq.to_i32() { return known_word(Known.Le); };
    if k == Tok.Gt.to_i32() { return known_word(Known.Gt); };
    if k == Tok.GtEq.to_i32() { return known_word(Known.Ge); };
    tok_word[t];
}

fn is_comparison(word: I32) Bool {
    word == known_word(Known.Eq) or word == known_word(Known.Ne) or word == known_word(Known.Lt)
        or word == known_word(Known.Le) or word == known_word(Known.Gt) or word == known_word(Known.Ge);
}

/// Whether `word` is an arithmetic or bitwise operator (`+` … `>>>`).
fn is_arith_word(word: I32) Bool {
    word == known_word(Known.Add) or word == known_word(Known.Sub) or word == known_word(Known.Mul)
        or word == known_word(Known.Div) or word == known_word(Known.Rem) or word == known_word(Known.Band)
        or word == known_word(Known.Bor) or word == known_word(Known.Bxor) or word == known_word(Known.Shl)
        or word == known_word(Known.Shr) or word == known_word(Known.Ushr);
}

/// The token after a node's last (its operator, in a binary expression).
fn token_after(node: I32) I32 {
    let t = node_last[node];
    while (tok_kind[t] == Tok.Comment.to_i32()) { t += 1; };
    t;
}

fn check_binary(node: I32, expect: I32, cx: Cx) I32 {
    let left = first_child(node);
    let right = last_child(node);
    let word = operator_word(token_after(left));
    if word == Kw.And.to_i32() or word == Kw.Or.to_i32() { return check_logical(node, word, cx); };
    if (word == known_word(Known.Eq) or word == known_word(Known.Ne)) and (is_null_literal(left) or is_null_literal(right)) {
        return check_null_compare(if is_null_literal(left) { right; } else { left; }, word == known_word(Known.Eq), cx);
    };
    let bool_t = prelude(Prelude.Bool);
    if word == Kw.Xor.to_i32() {
        let m = w_mark();
        want(left, bool_t, Why.Operand, node, word);
        coerce(check_expr(left, bool_t, cx), bool_t, left);
        unwant();
        want(right, bool_t, Why.Operand, node, word);
        coerce(check_expr(right, bool_t, cx), bool_t, right);
        unwant();
        w_node(Op.Plain, vt_i32, 115, 0, m);
        return bool_t;
    };
    // The operand type: the left's, unless it is literals (`1 + x`, `(1 + 2) * x`, `0 == n`),
    // which takes the right's.
    // (Only a number or string type types the operands: `x + y` where an
    // Externref is wanted is the operands' sum, widened.)
    let operand_expect = if is_comparison(word) or expect < 0 or not (is_numeric(expect) or expect == prelude(Prelude.Str)) { -1; } else { expect; };
    let m = w_mark();
    let t = -1;
    if is_number_literal(left) and not is_number_literal(right) {
        // The right decides; operands stay in order.
        let rt = type_only(right, operand_expect, cx);
        t = check_expr(left, rt, cx);
    } else {
        t = check_expr(left, operand_expect, cx);
    };
    apply_operator(word, t, right, node, cx, m);
}

/// With the left operand on the stack (since `m`): check the right against
/// its type and apply the operator `word` of that type.
fn apply_operator(word: I32, t: I32, right: I32, at: I32, cx: Cx, m: I32) I32 {
    if ty_is(t, Ty.Error) {
        check_expr(right, -1, cx);
        return error_since(m);
    };
    // A dynamic host value meets the other operand's primitive; two are
    // numeric (and `==` between them is JS identity), as in stage 0.
    let equality = word == known_word(Known.Eq) or word == known_word(Known.Ne);
    if is_dynamic(t) {
        let rt = type_only(right, -1, cx);
        if typeof_name(rt).len() > 0 {
            foreign_unbox(t, rt, true);
            return apply_operator(word, rt, right, at, cx, m);
        };
        if not equality and not is_foreign_or_nullable(rt) or is_dynamic(rt) and not equality {
            foreign_unbox(t, prelude(Prelude.F64), true);
            return apply_operator(word, prelude(Prelude.F64), right, at, cx, m);
        };
    };
    if is_foreign_or_nullable(t) and equality {
        return check_foreign_equal(t, right, word == known_word(Known.Eq), m, cx);
    };
    let decl = ty_decl(t);
    // An operator declared on the type, else (a distinct or int enum) its comparisons.
    let op = member(decl, word, Space.Operator);
    if is_scalar_kind(decl) and op < 0 {
        let before = diag_kind.len();
        want(right, t, Why.Operand, at, word);
        coerce(check_expr(right, t, cx), t, right);
        unwant();
        // Operands that do not meet have no result to check further.
        if any_mismatch_since(before) >= 0 { return error_since(m); };
        if scalar_compare(decl, word, m) { return prelude(Prelude.Bool); };
        report2(Diag.UnknownOperator, at, word, t, -1);
        return error_since(m);
    };
    if op < 0 {
        check_expr(right, t, cx);
        report2(Diag.UnknownOperator, at, word, t, -1);
        return error_since(m);
    };
    let fi = fn_instance(op, ty_inst(t));
    let before = diag_kind.len();
    want(right, vl_item(fi_params[fi], 1), Why.Operand, at, word);
    coerce(check_expr(right, vl_item(fi_params[fi], 1), cx), vl_item(fi_params[fi], 1), right);
    unwant();
    // Operands that do not meet have no result to check further.
    if any_mismatch_since(before) >= 0 { return error_since(m); };
    finish_call(fi, m, cx);
}

/// A number literal, or literals under parens, `-`, `~` and arithmetic or
/// bitwise operators (`(1 + 2)`, `-(1 << 3)`): typed by what meets it.
fn is_number_literal(node: I32) Bool {
    if is_kind(node, Node.Paren_expr) or is_kind(node, Node.Splice) { return is_number_literal(first_child(node)); };
    if is_kind(node, Node.Unary_expr) { return tok_word[node_first[node]] != Kw.Not.to_i32() and is_number_literal(last_child(node)); };
    if is_kind(node, Node.Binary_expr) {
        return is_arith_word(operator_word(token_after(first_child(node)))) and is_number_literal(first_child(node)) and is_number_literal(last_child(node));
    };
    let c = first_child(node);
    is_kind(node, Node.Literal) and (is_kind(c, Node.Int_lit) or is_kind(c, Node.Float_lit));
}

/// Above 0 while code is checked only for its type (its diagnostics dropped).
vec speculating: I32;

/// The type an expression has, without keeping its IR.
fn type_only(node: I32, expect: I32, cx: Cx) I32 {
    let m = w_mark();
    let diags = diag_kind.len();
    speculating[0] += 1;
    let t = check_expr(node, expect, cx);
    speculating[0] -= 1;
    w_stack.resize(m);
    diag_truncate(diags);
    t;
}

/// `a and b` is `if a { b } else { false }`; `a or b`, `if a { true } else { b }`.
fn check_logical(node: I32, word: I32, cx: Cx) I32 {
    let bool_t = prelude(Prelude.Bool);
    let m = w_mark();
    want(first_child(node), bool_t, Why.Operand, node, word);
    coerce(check_expr(first_child(node), bool_t, cx), bool_t, first_child(node));
    unwant();
    want(last_child(node), bool_t, Why.Operand, node, word);
    let m1 = w_mark();
    if word == Kw.And.to_i32() {
        coerce(check_expr(last_child(node), bool_t, cx), bool_t, last_child(node));
        w_node(Op.Seq, vt_i32, 0, 0, m1);
        let m2 = w_mark();
        w_i32(0);
        w_node(Op.Seq, vt_i32, 0, 0, m2);
    } else {
        w_i32(1);
        w_node(Op.Seq, vt_i32, 0, 0, m1);
        let m2 = w_mark();
        coerce(check_expr(last_child(node), bool_t, cx), bool_t, last_child(node));
        w_node(Op.Seq, vt_i32, 0, 0, m2);
    };
    unwant();
    // Its condition and values are Bools (optimize.utu folds it).
    w_node(Op.If, vt_i32, new_label(), 3, m);
    bool_t;
}

fn check_unary(node: I32, expect: I32, cx: Cx) I32 {
    let operand = last_child(node);
    let op = tok_kind[node_first[node]];
    if op == Tok.Minus.to_i32() and is_kind(operand, Node.Literal) {
        let lit = first_child(operand);
        if is_kind(lit, Node.Int_lit) { return int_literal(lit, node, expect, true); };
        if is_kind(lit, Node.Float_lit) { return float_literal(lit, expect, true); };
    };
    let m = w_mark();
    if tok_word[node_first[node]] == Kw.Not.to_i32() {
        let bool_t = prelude(Prelude.Bool);
        want(operand, bool_t, Why.Operand, node, Kw.Not.to_i32());
        coerce(check_expr(operand, bool_t, cx), bool_t, operand);
        unwant();
        w_node(Op.Plain, vt_i32, 69, 0, m);
        return bool_t;
    };
    let word = if op == Tok.Minus.to_i32() { known_word(Known.Neg); } else { known_word(Known.Bnot); };
    let t = check_expr(operand, expect, cx);
    if ty_is(t, Ty.Error) { return t; };
    let decl = member(ty_decl(t), word, Space.Operator);
    if decl < 0 {
        report2(Diag.UnknownOperator, node, word, t, -1);
        return error_since(m);
    };
    finish_call(fn_instance(decl, ty_inst(t)), m, cx);
}

//! = Calls

/// `f(args)`: of a function, a method (`x.f(…)`, `T.f(…)`), a host
/// declaration, a `fun` or `cl` value, or a struct or variant constructor.
fn check_call(node: I32, expect: I32, cx: Cx) I32 {
    let callee = first_child(node);
    let args = next_sibling(callee);
    // A DSL's splice is its expression.
    while (is_kind(callee, Node.Splice)) { callee = first_child(callee); };
    let m = w_mark();
    if is_wutu_show(callee) { return check_wutu_show(node, args, cx); };
    if is_wutu_fn(callee, "memo_key") { return check_memo_key(node, args, cx); };
    if is_wutu_fn(callee, "key_text") { return check_wutu_key(node, args, cx); };
    if is_kind(callee, Node.Identifier) { return call_name(node, callee, args, m, cx); };
    if is_kind(callee, Node.Field_expr) or is_kind(callee, Node.Optional_field_expr) { return call_field(node, callee, args, m, expect, cx); };
    if is_kind(callee, Node.Type_member_expr) { return call_type_member(node, callee, args, m, expect, cx); };
    call_value(callee, args, m, node, cx);
}

/// `f(…)`: a function, a host function, or a `fun` or `cl` value, by name.
fn call_name(node: I32, callee: I32, args: I32, m: I32, cx: Cx) I32 {
    let decl = node_decl[callee];
    if decl < 0 { return error_value(); };
    // `m()`: a module (or its alias) is not a value.
    if decl_is(decl, Decl.Module) or decl_is(decl, Decl.Alias) or decl_is(decl, Decl.Foreign) {
        not_value(callee, decl);
        return finish_error(args, m, cx);
    };
    if is_generator(decl) {
        report(Diag.GeneratorCall, node, decl_name[decl]);
        return finish_error(args, m, cx);
    };
    if decl_is(decl, Decl.Global) and is_es(last_child(decl_node[decl])) {
        es_import(decl, last_child(decl_node[decl]), global_type_in(decl, cx.inst));
    };
    // A `cl` binding is a value: called as any closure is.
    if decl_es[decl] >= 0 and not ty_is(decl_ty[decl], Ty.Closure) { return call_es(decl, args, m, node, cx); };
    if not decl_is(decl, Decl.Fn) {
        let t = if decl_is(decl, Decl.Global) { global_type_in(decl, global_inst(decl, cx.inst)); } else { decl_ty[decl]; };
        if ty_is(t, Ty.Fun) { return call_ref(callee, t, args, m, node, cx); };
        if ty_is(t, Ty.Closure) { return call_closure(callee, t, args, m, node, cx); };
        if ty_is(t, Ty.Error) { return finish_error(args, m, cx); };
        report2(Diag.NotCallable, node, word_of(callee), t, -1);
        return finish_error(args, m, cx);
    };
    call_with(fn_instance(decl, instance_for(module_of(decl), cx.inst)), args, 0, m, node, cx);
}

/// `x.f(…)`: a function of a module, alias, or module's type (`m.T.f`), a
/// mem's method, a JS array literal's, or a method of x's type.
fn call_field(node: I32, callee: I32, args: I32, m: I32, expect: I32, cx: Cx) I32 {
    let base = first_child(callee);
    let name = last_child(callee);
    let module = node_decl[base];
    if is_kind(base, Node.Identifier) and decl_is(module, Decl.Mem) { return check_mem_method(module, name, args, node, cx); };
    // An alias of a module that is not there (reported): nothing more to say.
    if is_kind(base, Node.Identifier) and decl_is(module, Decl.Alias) and decl_a[module] < 0 { return finish_error(args, m, cx); };
    // `ints.make(…)` with `using M[A] |ints|`: M's function in M[A].
    if is_kind(base, Node.Identifier) and decl_is(module, Decl.Alias) and decl_is(decl_a[module], Decl.Module) {
        let target = static_member(decl_a[module], word_of(name));
        if not decl_is(target, Decl.Fn) {
            report(Diag.UnknownMethod, name, word_of(name));
            return finish_error(args, m, cx);
        };
        node_decl[name] = target;
        let inst = module_instance(decl_a[module], module, callee, cx);
        if inst < 0 { return finish_error(args, m, cx); };
        return call_with(fn_instance(target, inst), args, 0, m, node, cx);
    };
    if is_kind(base, Node.Identifier) and decl_is(module, Decl.Module) {
        // A function, or a method of its promoted type (`sm.new(…)`).
        let decl = static_member(module, word_of(name));
        if not decl_is(decl, Decl.Fn) {
            if decl < 0 {
                report_module_member_missing(module, name);
                return finish_error(args, m, cx);
            };
            // `m.k(…)`: a global, called when it holds a fun or cl.
            if decl_is(decl, Decl.Global) { return call_value(callee, args, m, node, cx); };
            if is_type_decl(decl) {
                not_value(callee, decl);
                return finish_error(args, m, cx);
            };
            return unsupported(node);
        };
        node_decl[name] = decl;
        let inst = module_instance(module, -1, callee, cx);
        if inst < 0 { return finish_error(args, m, cx); };
        return call_with(fn_instance(decl, inst), args, 0, m, node, cx);
    };
    // `m.T.f(…)`, `M.T.f(…)`: a static function of a module's (or alias's) type.
    let st = static_type_path(base, cx);
    if st >= 0 {
        let target = static_member(ty_decl(st), word_of(name));
        if not decl_is(target, Decl.Fn) {
            report2(Diag.UnknownMethod, node, word_of(name), st, -1);
            return finish_error(args, m, cx);
        };
        node_decl[name] = target;
        return call_with(fn_instance(target, ty_inst(st)), args, 0, m, node, cx);
    };
    // `[…].forEach(…)`: a method native arrays lack makes the literal a JS array.
    if is_kind(base, Node.Array_expr) and first_child(base) >= 0 and has_foreign() {
        let js = js_array_receiver(base, word_of(name), cx);
        if js >= 0 {
            check_foreign_array(base, js, cx);
            return check_foreign_method(node, js, word_of(name), args, m, expect, cx);
        };
    };
    call_method(node, callee, args, m, expect, cx);
}

/// `x.f(…)`, a method: the receiver is its first argument.
fn call_method(node: I32, callee: I32, args: I32, m: I32, expect: I32, cx: Cx) I32 {
    let name = last_child(callee);
    let rt = check_base(callee, cx);
    if ty_is(rt, Ty.Error) { return finish_error(args, m, cx); };
    // `json.length.to_i32()`: a utu method JS values lack reads a dynamic
    // receiver as the primitive that has it.
    if is_dynamic(rt) {
        let prim = native_owner(word_of(name));
        if prim >= 0 {
            foreign_unbox(rt, prim, true);
            rt = prim;
        };
    };
    if is_foreign(rt) { return check_foreign_method(node, rt, word_of(name), args, m, expect, cx); };
    // `s.describe()` with `fn Shape.describe |s|`: a function of the protocol, not a member, is called as any method.
    if decl_is(ty_decl(rt), Decl.Proto) and (protocol_member(ty_decl(rt), word_of(name)) >= 0 or not decl_is(member(ty_decl(rt), word_of(name), Space.Method), Decl.Fn)) { return proto_call(rt, name, args, m, node, cx); };
    if is_scalar_kind(ty_decl(rt)) {
        let scalar = scalar_method(ty_decl(rt), word_of(name));
        if scalar >= 0 and args < 0 { return scalar; };
    };
    let decl = member(ty_decl(rt), word_of(name), Space.Method);
    if ty_is(rt, Ty.Nullable) {
        report2(Diag.NullableAccess, callee, word_of(name), rt, -1);
        return finish_error(args, m, cx);
    };
    if decl < 0 {
        // `p.f(x)` with a field f holding a closure: the field, called.
        let field = member(ty_decl(rt), word_of(name), Space.Member);
        if decl_is(field, Decl.Field) and (decl_is(ty_decl(rt), Decl.Struct) or decl_is(ty_decl(rt), Decl.Variant)) {
            let ft = field_type(field, ty_inst(rt));
            if ty_is(ft, Ty.Closure) or ty_is(ft, Ty.Fun) {
                // (The receiver is read again, as the callee's base.)
                while (w_stack.len() > m) { w_pop(); };
                return call_value(callee, args, m, node, cx);
            };
        };
        // Host declarations add methods to scalars and strings (`x.toFixed(1)`).
        let host = primitive_host_type(rt, word_of(name));
        if host >= 0 { return check_foreign_primitive_method(node, rt, host, word_of(name), args, m, expect, cx); };
        // `a.cmp(b)` on an unbounded T: bound it.
        if unbounded_call(rt, word_of(name), -1, node, cx.inst) { return finish_error(args, m, cx); };
        // `x.sqrt()` with `fn sqrt(x: &)` in the type's module: b says so.
        report2(Diag.UnknownMethod, node, word_of(name), rt, if module_fn_of(rt, word_of(name)) >= 0 { 1; } else { -1; });
        suggest_member(ty_decl(rt), name, Space.Method);
        method_note(rt, word_of(name));
        return finish_error(args, m, cx);
    };
    // `x.m()` with both `fn Pa[X].m` and `fn Pb[X].m`: which is not said.
    let k = 0;
    while (k < method_twice.len()) {
        if method_twice[k] == decl {
            report2(Diag.AmbiguousMethod, name, word_of(name), decl, method_twice[k + 1]);
            return finish_error(args, m, cx);
        };
        k += 2;
    };
    // What the name means, for an editor (as a field's is recorded).
    node_decl[name] = decl;
    unbounded_call(rt, word_of(name), decl, node, cx.inst);
    let fi = fn_instance(decl, ty_inst(rt));
    // A function of the type without `self` has no receiver to take.
    if vl_len[fi_params[fi]] == 0 {
        report2(Diag.WrongArity, node, -1, 0, 1 + if args >= 0 { child_count(args); } else { 0; });
        return finish_error(args, m, cx);
    };
    coerce(rt, vl_item(fi_params[fi], 0), first_child(callee));
    call_with(fi, args, 1, m, node, cx);
}

/// `T.f(…)`: a static function of a type, a host root's, or a scalar's.
fn call_type_member(node: I32, callee: I32, args: I32, m: I32, expect: I32, cx: Cx) I32 {
    let owner_decl = node_decl[first_child(callee)];
    if decl_is(owner_decl, Decl.Foreign) and decl_a[owner_decl] >= 0 {
        return check_foreign_root_call(node, decl_a[owner_decl], word_of(last_child(callee)), args, false, m, expect, cx);
    };
    if is_scalar_kind(owner_decl) {
        let r = scalar_static(owner_decl, word_of(last_child(callee)), args, node, cx);
        if r >= 0 { return r; };
    };
    let decl = node_decl[last_child(callee)];
    // `T.f(…)` with no type T (reported): stage 0 still calls `fn T.f` by its name.
    if owner_decl < 0 and decl < 0 {
        let named = method_of_unknown(word_of(first_child(callee)), word_of(last_child(callee)));
        if named >= 0 { return call_with(fn_instance(named, 0), args, 0, m, node, cx); };
    };
    if decl < 0 and (decl_is(owner_decl, Decl.Struct) or decl_is(owner_decl, Decl.Enum) or decl_is(owner_decl, Decl.Module) or is_scalar_kind(owner_decl)) and not has_foreign() {
        report3(Diag.UnknownMethod, node, word_of(last_child(callee)), -1, -1, decl_name[owner_decl]);
        return finish_error(args, m, cx);
    };
    // `M.f(…)` with `let f: fun(…) R = @es/\ … \/` in module M.
    if decl_is(decl, Decl.Global) and is_es(last_child(decl_node[decl])) {
        es_import(decl, last_child(decl_node[decl]), global_type(decl));
        return call_es(decl, args, m, node, cx);
    };
    if not decl_is(decl, Decl.Fn) { return call_value(callee, args, m, node, cx); };
    let inst = member_instance(callee, cx);
    if inst < 0 { return finish_error(args, m, cx); };
    call_with(fn_instance(decl, inst), args, 0, m, node, cx);
}

/// The module instance `T.x` names x in: M's (`M.x`, `alias.x`), or the
/// type's (`M[A].x`, `T.x`); -1 reported.
fn member_instance(node: I32, cx: Cx) I32 {
    let base = first_child(node);
    if is_kind(base, Node.Type_ident) and decl_is(node_decl[base], Decl.Module) { return module_instance(node_decl[base], node_alias[base], node, cx); };
    ty_inst(type_path(base, cx.inst));
}

/// The instance of `module` that `M.f` or `alias.f` (`alias` the alias, or
/// -1) calls in: the alias's, the calling code's own, or one `using M[A];`
/// opened. A generic module named with none of those is reported (it takes
/// type arguments): -1.
fn module_instance(module: I32, alias: I32, at: I32, cx: Cx) I32 {
    let inst = if alias >= 0 { alias_instance(alias); } else { instance_for(module, cx.inst); };
    if inst == 0 and is_generic(module) {
        report2(Diag.InvalidModuleArity, first_child(at), decl_name[module], module_arity(module), 0);
        return -1;
    };
    inst;
}

/// A call of any other expression: a `fun` or `cl` value.
fn call_value(callee: I32, args: I32, m: I32, at: I32, cx: Cx) I32 {
    let t = type_only(callee, -1, cx);
    if ty_is(t, Ty.Fun) { return call_ref(callee, t, args, m, at, cx); };
    if ty_is(t, Ty.Closure) { return call_closure(callee, t, args, m, at, cx); };
    if ty_is(t, Ty.Error) { return follow_on(callee, args, m, at, cx); };
    report2(Diag.NotCallable, at, -1, t, -1);
    finish_error(args, m, cx);
}

/// A callee of type Error: checked again, so its mistake is reported (a
/// type alone drops it); the call is that mistake's consequence.
fn follow_on(callee: I32, args: I32, m: I32, at: I32, cx: Cx) I32 {
    let mc = w_mark();
    discard(check_expr(callee, -1, cx));
    w_stack.resize(mc);
    if not any_reported() { return unsupported(at); };
    finish_error(args, m, cx);
}

/// Whether any mistake is reported yet.
fn any_reported() Bool { diag_kind.len() > 0; }

/// Arguments checked and pushed, after any already pushed since `m`; then
/// the call (or the intrinsic, expanded).
fn call_with(fi: I32, args: I32, first_param: I32, m: I32, at: I32, cx: Cx) I32 {
    // A generator is expanded by a `for`, never called.
    if is_generator(fi_decl[fi]) {
        report(Diag.GeneratorCall, at, word_of(last_child(first_child(decl_node[fi_decl[fi]]))));
        return finish_error(args, m, cx);
    };
    call_site.resize(1);
    call_site[0] = at;
    host_callbacks(fi_decl[fi], args, first_param);
    if fi_site[fi] < 0 { fi_site[fi] = at; };
    let params = fi_params[fi];
    let i = first_param;
    let a = if args >= 0 { first_child(args); } else { -1; };
    while (a >= 0) {
        if i < vl_len[params] {
            let pt = vl_item(params, i);
            want(a, pt, Why.Param, fi_decl[fi], i);
            coerce(check_expr(a, pt, cx), pt, a);
            unwant();
        } else {
            drop_value(check_expr(a, -1, cx));
        };
        i += 1;
        a = next_sibling(a);
    };
    if i != vl_len[params] {
        report3(Diag.WrongArity, at, if fi_decl[fi] >= 0 { decl_name[fi_decl[fi]]; } else { -1; }, vl_len[params] - first_param, i - first_param, -1);
        return error_since(m);
    };
    finish_call(fi, m, cx);
}

/// A call of an `@es` function: its import, directly.
fn call_es(decl: I32, args: I32, m: I32, at: I32, cx: Cx) I32 {
    let t = decl_ty[decl];
    if not ty_is(t, Ty.Fun) {
        report2(Diag.NotCallable, at, decl_name[decl], t, -1);
        return finish_error(args, m, cx);
    };
    host_callbacks(-1, args, 0);
    if not check_args(ty_a[t], args, 0, at, cx) {
        return error_since(m);
    };
    w_node(Op.Call, repr(ty_b[t]), decl_es[decl], 0, m);
    ty_b[t];
}

/// A call of a `fun` value: the arguments, then the value, then `call_ref`.
fn call_ref(callee: I32, t: I32, args: I32, m: I32, at: I32, cx: Cx) I32 {
    if not check_args(ty_a[t], args, 0, at, cx) {
        return error_since(m);
    };
    check_expr(callee, t, cx);
    w_node(Op.CallRef, repr(ty_b[t]), fun_heap(t), 0, m);
    ty_b[t];
}

/// Check the arguments against parameter types (from `first`); false after
/// reporting a wrong count.
fn check_args(params: I32, args: I32, first: I32, at: I32, cx: Cx) Bool {
    let i = first;
    let a = if args >= 0 { first_child(args); } else { -1; };
    while (a >= 0) {
        if i < vl_len[params] {
            let pt = vl_item(params, i);
            coerce(check_expr(a, pt, cx), pt, a);
        } else {
            drop_value(check_expr(a, -1, cx));
        };
        i += 1;
        a = next_sibling(a);
    };
    if i != vl_len[params] {
        report2(Diag.WrongArity, at, -1, vl_len[params] - first, i - first);
        return false;
    };
    true;
}

fn finish_error(args: I32, m: I32, cx: Cx) I32 {
    let a = if args >= 0 { first_child(args); } else { -1; };
    while (a >= 0) {
        drop_value(check_expr(a, -1, cx));
        a = next_sibling(a);
    };
    error_since(m);
}

/// The wasm function of a function instance. An intrinsic has none until
/// it is needed as one (exported, or a value): then its body is its
/// expansion, of its parameters.
fn function_of(fi: I32) I32 {
    if fi_func[fi] >= 0 { return fi_func[fi]; };
    let params = fi_params[fi];
    let f = defined_func(params, fi_result[fi]);
    fi_func[fi] = f;
    func_debug_name[f] = fn_debug_name(fi_decl[fi]);
    func_src[f] = decl_node[fi_decl[fi]];
    // (A function being checked names it as a value: its locals are kept aside.)
    let saved = Array[I32].new(cur_locals.len(), 0);
    for (0 ..< cur_locals.len()) |i| { saved[i] = cur_locals[i]; };
    cur_locals.clear();
    for (0 ..< vl_len[params]) |i| { new_local(repr(vl_item(params, i))); };
    let m = w_mark();
    for (0 ..< vl_len[params]) |i| { w_leaf(Op.LocalGet, repr(vl_item(params, i)), i, 0); };
    expand(fi, m);
    func_body[f] = w_pop();
    record_locals(f, vl_len[params]);
    cur_locals.clear();
    for (0 ..< saved.len()) |i| { cur_locals.push(saved[i]); };
    f;
}

//! = Lazy modules
//!
//! `using tour lazy from "./tour.utu"` type-checks the module as usual, but
//! the program does not contain it: each of its functions the program calls
//! is a stub that asks the page's loader (`createWutuLazy`) for the element the
//! function makes. The runtime loads the module's chunk the first time and
//! fills a placeholder; `wutu build` makes the chunk from what the host
//! section's `lazy` list says the program calls. Arguments cross into the
//! chunk as they are: numbers, Bool, Str, and host values; the result is a
//! host element.

/// The stubs made: each one's function, its signature (utu text), and its lazy module's index.
vec lazy_call_fn: I32;
vec lazy_call_sig: I32;
vec lazy_call_path: I32;

/// Lazy module function `fi`'s body (f, its arguments on the stack since m):
/// a call of the runtime, through an import of its own.
fn lazy_stub(fi: I32, f: I32, lazy: I32, m: I32) void {
    let decl = fi_decl[fi];
    let params = fi_params[fi];
    let sig = "(";
    for (0 ..< vl_len[params]) |i| {
        if i > 0 { sig = sig + ", "; };
        sig = sig + "a" + i.to_str() + ": " + type_text(vl_item(params, i));
    };
    let r = fi_result[fi];
    sig = sig + ") " + type_text(r);
    let body = "(...a)=>globalThis.__wutuLazy(" + word_text(lazy_path[lazy]) + ",\"" + word_text(decl_name[decl]) + "\",a)";
    let imp = add_import_func(name_add("es"), name_add("__es_" + es_func.len().to_str()), func_type_of[f]);
    es_func.push(imp);
    es_start.push(-1);
    es_end.push(intern_text(body));
    w_node(Op.Call, repr(r), imp, 0, m);
    lazy_call_fn.push(decl);
    lazy_call_sig.push(intern_text(sig));
    lazy_call_path.push(lazy);
}

/// What crosses into lazy module function `fi`'s chunk and back: numbers,
/// Bool, Str, and host values in, a host element out.
fn check_lazy_signature(fi: I32) void {
    let decl = fi_decl[fi];
    let params = fi_params[fi];
    for (0 ..< vl_len[params]) |i| {
        let t = vl_item(params, i);
        if not crosses_chunk(t) { report2(Diag.LazyValue, decl_node[decl], decl_name[decl], t, -1); };
    };
    if not is_foreign(fi_result[fi]) { report2(Diag.LazyValue, decl_node[decl], decl_name[decl], fi_result[fi], 1); };
}

/// Whether a value of type t can cross into a chunk: a number, a Bool, a Str, or a host value.
fn crosses_chunk(t: I32) Bool { in_words("I32 U32 I64 U64 F32 F64 Bool Str", type_text(t)) or is_foreign(t); }

/// Whether the program imports host declarations (std:JS, npm:…).
fn has_foreign() Bool {
    for (0 ..< import_target.len()) |i| { if import_target[i] == -2 { return true; }; };
    false;
}

/// The call being checked, for intrinsics' diagnostics.
vec call_site: I32;

/// The arguments are on the stack since `m`: call the function, or expand it.
fn finish_call(fi: I32, m: I32, cx: Cx) I32 {
    note_edge(fi);
    let result = fi_result[fi];
    if fi_ir[fi] >= 0 { return expand(fi, m); };
    // From outside a lazy module, its function is its stub (see lazy_stub).
    let lazy = lazy_index(module_of(fi_decl[fi]));
    let caller = if cx.fi >= 0 { module_of(fi_decl[cx.fi]); } else { -1; };
    let stubbed = lazy >= 0 and caller != module_of(fi_decl[fi]);
    // Checked at every call: a stub is made once, perhaps while only a type is
    // wanted, whose diagnostics are dropped.
    if stubbed { check_lazy_signature(fi); };
    let target = if stubbed { lazy_stub_func(fi, lazy); } else { fi_func[fi]; };
    w_node(Op.Call, repr(result), target, 0, m);
    result;
}

/// By function instance: its lazy stub, or -1.
vec lazy_stub_of: I32;

/// Lazy module function `fi`'s stub (made once): a function of the same
/// signature whose body asks the runtime for the element (see lazy_stub).
fn lazy_stub_func(fi: I32, lazy: I32) I32 {
    while (lazy_stub_of.len() <= fi) { lazy_stub_of.push(-1); };
    if lazy_stub_of[fi] >= 0 { return lazy_stub_of[fi]; };
    let params = fi_params[fi];
    let f = defined_func(params, fi_result[fi]);
    lazy_stub_of[fi] = f;
    func_debug_name[f] = fn_debug_name(fi_decl[fi]);
    func_src[f] = decl_node[fi_decl[fi]];
    // (Made while another function is checked: its locals are kept aside.)
    let saved = Array[I32].new(cur_locals.len(), 0);
    for (0 ..< cur_locals.len()) |i| { saved[i] = cur_locals[i]; };
    cur_locals.clear();
    for (0 ..< vl_len[params]) |i| { new_local(repr(vl_item(params, i))); };
    let m = w_mark();
    for (0 ..< vl_len[params]) |i| { w_leaf(Op.LocalGet, repr(vl_item(params, i)), i, 0); };
    lazy_stub(fi, f, lazy, m);
    func_body[f] = w_pop();
    record_locals(f, vl_len[params]);
    cur_locals.clear();
    for (0 ..< saved.len()) |i| { cur_locals.push(saved[i]); };
    f;
}

//! = Intrinsics
//!
//! The arguments are on the stack since `m`. Each `<ir-ident name="p"/>`
//! is the argument for p: moved in place when every parameter is used once
//! and in order, else read from a local each argument is stored in first.

/// An intrinsic's `@ir` body in place of its call, the arguments on the
/// stack since `m`. They are used where they are when its body reads each
/// once, in order; else they are stored in locals first.
fn expand(fi: I32, m: I32) I32 {
    let x = fi_ir[fi];
    // (Once an instance: its parameters, and whether its body uses each once, in order.)
    if fi >= expand_decls.len() {
        let old = expand_decls.len();
        expand_decls.resize(fi + 1);
        expand_direct.resize(fi + 1);
        for (old ..< fi + 1) |k| { expand_decls[k] = -1; };
    };
    if expand_decls[fi] < 0 {
        let decls = param_decls(fi_decl[fi]);
        let uses = ident_uses(x, decls);
        let direct = vl_len[uses] == vl_len[decls] and not reorders(x);
        for (0 ..< vl_len[uses]) |i| { if vl_item(uses, i) != i { direct = false; }; };
        expand_decls[fi] = decls;
        expand_direct[fi] = if direct { 1; } else { 0; };
    };
    let decls = expand_decls[fi];
    let direct = expand_direct[fi] == 1;
    let n = vl_len[decls];
    let args = Array[I32].new(n, 0);
    for (0 ..< n) |i| { args[i] = w_stack[m + i]; };
    w_stack.resize(m);
    let locals = Array[I32].new(n, -1);
    if not direct {
        for (0 ..< n) |i| {
            let vt = repr(vl_item(fi_params[fi], i));
            let local = new_local(vt);
            locals[i] = local;
            let ms = w_mark();
            w_push(args[i]);
            w_node(Op.LocalSet, vt_none, local, 0, ms);
        };
    };
    let pre = w_mark() - m;
    let result_vt = repr(fi_result[fi]);
    ir_failed[0] = -1;
    ir_failed_shape[0] = 0;
    let ok = translate(x, decls, args, locals, direct, fi);
    if not ok {
        w_stack.resize(m);
        let bad = ir_failed[0];
        let body = first_child(fn_body(fi_decl[fi]));
        if bad < 0 or reported_within(body) { return unsupported(decl_node[fi_decl[fi]]); };
        if ir_failed_shape[0] == 3 {
            report3(Diag.IrType, body, x_tag[bad], ir_fault[0], ir_fault[1], 0);
            return error_value();
        };
        if ir_failed_shape[0] == 4 {
            report3(Diag.IntegerOutOfRange, body, ir_fault[1], ir_fault[0], 0, -1);
            return error_value();
        };
        let ident = x_tag[bad] == known_word(Known.IrIdent);
        let named = x_attr(bad, known_word(Known.Name));
        let why = if ir_failed_shape[0] == 1 { 2; } else if ident { 1; } else { 0; };
        report2(Diag.IrUnknown, body, if ident and why == 1 { if named >= 0 { attr_word(named); } else { -1; }; } else { x_tag[bad]; }, why, -1);
        return error_value();
    };
    let got = ir_vt(x, decls, fi, w_stack[w_stack.len() - 1]);
    let bool_t = prelude(Prelude.Bool);
    if (vt_scalar(result_vt) and vt_scalar(got) and got != result_vt) or (fi_result[fi] == bool_t and got == vt_i32 and not ir_bool(x, decls, fi)) {
        w_stack.resize(m);
        report3(Diag.IrType, first_child(fn_body(fi_decl[fi])), -1, fi_result[fi], got, 1);
        return error_value();
    };
    if pre > 0 { w_node(Op.Seq, result_vt, 0, 0, m); };
    fi_result[fi];
}

fn vt_scalar(vt: I32) Bool { vt >= vt_i32 and vt <= vt_v128; }

/// The value type an `@ir` element `x` gives (pushed as `node`): a
/// parameter's by its type, not its argument's at this call.
fn ir_vt(x: I32, decls: I32, fi: I32, node: I32) I32 {
    if x_tag[x] == known_word(Known.IrIdent) { return repr(vl_item(fi_params[fi], param_index(x, decls))); };
    w_type[node];
}

/// Whether an `@ir` element gives a Bool: a comparison, a Bool parameter
/// or literal, `and`, `or`, `xor` of Bools, or an element the plain
/// instructions are not (whose type its function's says).
fn ir_bool(x: I32, decls: I32, fi: I32) Bool {
    let tag = x_tag[x];
    let bool_t = prelude(Prelude.Bool);
    if tag == known_word(Known.IrIdent) { return vl_item(fi_params[fi], param_index(x, decls)) == bool_t; };
    if tag == known_word(Known.IrLit) {
        let tn = x_attr(x, known_word(Known.TypeName));
        let d = if tn >= 0 { prelude_lookup(attr_word(tn)); } else { -1; };
        return d >= 0 and decl_type(promoted(d), 0) == bool_t;
    };
    if tag == known_word(Known.IrSafeChecks) or tag == known_word(Known.IrRefEq) or tag == known_word(Known.IrRefNe)
        or tag == known_word(Known.IrStringEq) or tag == known_word(Known.IrStringNe) { return true; };
    let op = tag_opcode(tag);
    if (op >= 69 and op <= 102) or op == 64851 { return true; };
    // (An array's element, a string's length: as the type says.)
    if op < 0 { return true; };
    if op < 113 or op > 115 { return false; };
    let c = x_child[x];
    while (c >= 0) {
        if not ir_bool(c, decls, fi) { return false; };
        c = x_next[c];
    };
    true;
}

/// An `@ir` operand of the wrong value type: `want`, given `got`.
fn ir_mistyped(x: I32, want: I32, got: I32) Bool {
    ir_failed[0] = x;
    ir_failed_shape[0] = 3;
    ir_fault[0] = want;
    ir_fault[1] = got;
    false;
}

/// The value type a plain instruction's operands take.
fn opcode_operand(op: I32) I32 {
    if op <= 79 { return vt_i32; };
    if op <= 90 { return vt_i64; };
    if op <= 96 { return vt_f32; };
    if op <= 102 { return vt_f64; };
    if op <= 120 { return vt_i32; };
    if op <= 138 { return vt_i64; };
    if op <= 152 { return vt_f32; };
    if op <= 166 { return vt_f64; };
    if op == 167 or op == 180 or op == 181 or op == 185 or op == 186 or op == 191 { return vt_i64; };
    if op == 172 or op == 173 or op == 178 or op == 179 or op == 183 or op == 184 or op == 190 { return vt_i32; };
    if op == 182 or op == 189 or op == 170 or op == 171 or op == 176 or op == 177 { return vt_f64; };
    if op <= 191 { return vt_f32; };
    if op >= 64512 and op <= 64519 { return if (op - 64512) % 4 < 2 { vt_f32; } else { vt_f64; }; };
    vt_v128;
}

/// How many operands a plain instruction takes.
fn opcode_arity(op: I32) I32 {
    if op == 69 or op == 80 or (op >= 103 and op <= 105) or (op >= 121 and op <= 123) { return 1; };
    if (op >= 139 and op <= 145) or (op >= 153 and op <= 159) or (op >= 167 and op <= 191) { return 1; };
    if (op >= 64512 and op <= 64519) or op == 64845 or op == 64851 { return 1; };
    if op == 64850 { return 3; };
    2;
}

/// By function instance, for @expand: its parameter declarations (-1: not
/// yet found), and 1 when its `@ir` body uses each once, in order.
vec expand_decls: I32;
vec expand_direct: U8;

/// The parameter indices of the `ir-ident`s of a tree, in order.
fn ident_uses(x: I32, decls: I32) I32 {
    let m = vl_begin();
    collect_uses(x, decls);
    vl_end(m);
}

fn collect_uses(x: I32, decls: I32) void {
    if x_tag[x] == known_word(Known.IrIdent) {
        vl_add(param_index(x, decls));
        return;
    };
    let c = x_child[x];
    while (c >= 0) {
        collect_uses(c, decls);
        c = x_next[c];
    };
}

fn param_index(x: I32, decls: I32) I32 {
    let a = x_attr(x, known_word(Known.Name));
    if a < 0 { return -1; };
    let word = attr_word(a);
    for (0 ..< vl_len[decls]) |i| { if decl_name[vl_item(decls, i)] == word { return i; }; };
    -1;
}

/// The `@ir` element @translate did not know, or -1.
vec ir_failed: I32 = [-1];
/// Why: 0 an element the compiler does not know (or a name no parameter has), 1 one it knows written wrong,
/// 3 an operand of the wrong value type, 4 a literal out of range.
vec ir_failed_shape: I32 = [0];
/// For 3: the value type wanted, and given; for 4: the type, and the literal as a word.
vec ir_fault: I32 = [0, 0];
/// The functions of a program's own files whose bodies are @ir, in the last build.
vec user_ir_decl: I32;

/// The element being translated is malformed (an attribute or operand missing, of the wrong kind).
fn ir_malformed(x: I32) Bool {
    ir_failed[0] = x;
    ir_failed_shape[0] = 1;
    false;
}

/// The engine found the module invalid (`message`, a word): reported at
/// each @ir body of the program's own, whose plain instructions alone the compiler checks.
fn report_invalid_ir(message: I32) void {
    for (0 ..< user_ir_decl.len()) |k| {
        let d = user_ir_decl[k];
        let seen = false;
        for (0 ..< k) |j| { if user_ir_decl[j] == d { seen = true; }; };
        if not seen { report2(Diag.IrInvalid, first_child(fn_body(d)), decl_name[d], message, -1); };
    };
}

/// Push the IR of an `@ir` element; false when it is not one the compiler knows.
fn translate(x: I32, decls: I32, args: Array[I32], locals: Array[I32], direct: Bool, fi: I32) Bool {
    let tag = x_tag[x];
    if tag == known_word(Known.IrIdent) {
        let i = param_index(x, decls);
        if i < 0 {
            ir_failed[0] = x;
            return false;
        };
        if direct { w_push(args[i]); } else { w_leaf(Op.LocalGet, repr(vl_item(fi_params[fi], i)), locals[i], 0); };
        return true;
    };
    if tag == known_word(Known.IrLit) {
        let tn = x_attr(x, known_word(Known.TypeName));
        let v = x_attr(x, known_word(Known.Value));
        if tn < 0 or v < 0 or attr_end[v] <= attr_start[v] { return ir_malformed(x); };
        let named_t = prelude_lookup(attr_word(tn));
        if named_t < 0 { return ir_malformed(x); };
        for (attr_start[v] ..< attr_end[v]) |i| {
            if (src[i] < 48 or src[i] > 57) and not (i == attr_start[v] and src[i] == 45) { return ir_malformed(x); };
        };
        let t = decl_type(promoted(named_t), 0);
        let neg = src[attr_start[v]] == 45;
        if not ir_lit_fits(attr_start[v] + if neg { 1; } else { 0; }, attr_end[v], neg, t) {
            ir_failed[0] = x;
            ir_failed_shape[0] = 4;
            ir_fault[0] = t;
            ir_fault[1] = attr_word(v);
            return false;
        };
        let value: I64 = 0;
        for ((attr_start[v] + if neg { 1; } else { 0; }) ..< attr_end[v]) |i| { value = value * 10 + (src[i] - 48).to_i64(); };
        push_number(t, if neg { 0 - value; } else { value; }, false);
        return true;
    };
    let data = translate_data(x, decls, args, locals, direct, fi);
    if data != 0 { return data > 0; };
    let opcode = tag_opcode(tag);
    if opcode < 0 {
        ir_failed[0] = x;
        return false;
    };
    let m = w_mark();
    let c = x_child[x];
    let n = 0;
    let want = opcode_operand(opcode);
    while (c >= 0) {
        if not translate(c, decls, args, locals, direct, fi) { return false; };
        let got = ir_vt(c, decls, fi, w_stack[w_stack.len() - 1]);
        if got != want and got != vt_unreachable { return ir_mistyped(x, want, got); };
        n += 1;
        c = x_next[c];
    };
    if n != opcode_arity(opcode) { return ir_malformed(x); };
    w_node(Op.Plain, opcode_result(opcode), opcode, 0, m);
    true;
}

/// Whether an `@ir` literal's digits `s ..< e` (after its minus, when
/// `neg`) fit integer type `t`, as `literal_fits` has a literal fit it.
fn ir_lit_fits(s: I32, e: I32, neg: Bool, t: I32) Bool {
    let bits = if t == prelude(Prelude.I32) or t == prelude(Prelude.U32) or t == prelude(Prelude.M32) { 32; }
        else if t == prelude(Prelude.I64) or t == prelude(Prelude.U64) or t == prelude(Prelude.M64) { 64; } else { 0; };
    if bits == 0 { return true; };
    let signed = t == prelude(Prelude.I32) or t == prelude(Prelude.I64);
    let i = s;
    while (i < e - 1 and src[i] == 48) { i += 1; };
    let max = "18446744073709551615";
    if e - i > max.len() { return false; };
    if e - i == max.len() {
        if signed or bits == 32 or neg { return false; };
        for (0 ..< max.len()) |k| { if src[i + k] != max[k] { return src[i + k] < max[k]; }; };
        return true;
    };
    let v: U64 = 0;
    for (i ..< e) |k| { v = v * 10 + (src[k] - 48).to_u64(); };
    let one: U64 = 1;
    let top = one << (bits - 1).to_u64();
    if neg and not signed { return v == 0; };
    if signed { return v <= if neg { top; } else { top - one; }; };
    v <= top - one + top;
}

/// The value type a plain instruction leaves.
fn opcode_result(op: I32) I32 {
    if op <= 120 { return vt_i32; };
    if op <= 138 { return vt_i64; };
    if op <= 152 { return vt_f32; };
    if op <= 166 { return vt_f64; };
    if op <= 171 { return vt_i32; };
    if op <= 177 { return vt_i64; };
    if op <= 182 { return vt_f32; };
    if op <= 187 { return vt_f64; };
    if op == 188 { return vt_i32; };
    if op == 189 { return vt_i64; };
    if op == 190 { return vt_f32; };
    if op == 191 { return vt_f64; };
    if op >= 64512 and op <= 64515 { return vt_i32; };
    if op >= 64516 and op <= 64519 { return vt_i64; };
    if op == 64851 { return vt_i32; };
    vt_v128;
}

/// `m.T` or `M.T` (naming a type of module or alias `m`): that type, in
/// the module's instance; else -1.
fn static_type_path(node: I32, cx: Cx) I32 {
    if not is_kind(node, Node.Field_expr) and not is_kind(node, Node.Type_member_expr) { return -1; };
    let base = first_child(node);
    if not is_kind(base, Node.Identifier) and not is_kind(base, Node.Type_ident) { return -1; };
    let d = node_decl[base];
    let inst = 0;
    let module = -1;
    if decl_is(d, Decl.Module) {
        module = d;
        inst = instance_for(d, cx.inst);
    } else if decl_is(d, Decl.Alias) and decl_is(decl_a[d], Decl.Module) {
        module = decl_a[d];
        inst = alias_instance(d);
    } else {
        return -1;
    };
    let t = member(module, word_of(last_child(node)), Space.Member);
    if t < 0 or not is_type_decl(t) { return -1; };
    named(t, inst);
}

/// `m.x`: `m` names a module.
fn is_module_path(node: I32) Bool {
    let base = first_child(node);
    is_kind(base, Node.Identifier) and decl_is(node_decl[base], Decl.Module);
}

/// A name of a module or type, used as a value: reported (a host module
/// whose declarations were not found already is).
fn not_value(at: I32, decl: I32) I32 {
    if decl_is(decl, Decl.Foreign) and decl_a[decl] < 0 { return error_value(); };
    // (An alias of a module that is not there.)
    if decl_is(decl, Decl.Alias) and not decl_is(decl_a[decl], Decl.Module) and any_reported() { return error_value(); };
    if not reported_within(at) { report2(Diag.NotValue, at, decl_name[decl], if decl_is(decl, Decl.Module) or decl_is(decl, Decl.Alias) or decl_is(decl, Decl.Foreign) { 1; } else { 0; }, -1); };
    error_value();
}

/// `x.f` (not called): a module's global, or a field.
fn check_field(node: I32, expect: I32, cx: Cx) I32 {
    let base = first_child(node);
    if is_module_path(node) {
        let name = last_child(node);
        if decl_is(node_decl[name], Decl.Global) {
            let inst = module_instance(node_decl[base], node_alias[base], node, cx);
            return if inst < 0 { error_value(); } else { global_get(node_decl[name], inst); };
        };
        if node_decl[name] < 0 { return module_member_missing(node_decl[first_child(node)], name); };
        // `m.f`: the function, as a value.
        if decl_is(node_decl[name], Decl.Fn) { return member_fn_value(node, node_decl[name], instance_for(node_decl[first_child(node)], cx.inst)); };
        if is_type_decl(node_decl[name]) { return not_value(node, node_decl[name]); };
        return unsupported(node);
    };
    // `ints.make` with `using M[A] |ints|`: M's function in M[A], as a
    // value; `ints.x`, M[A]'s global x.
    if is_kind(base, Node.Identifier) and decl_is(node_decl[base], Decl.Alias) and decl_is(decl_a[node_decl[base]], Decl.Module) {
        let f = static_member(decl_a[node_decl[base]], word_of(last_child(node)));
        if decl_is(f, Decl.Global) {
            node_decl[last_child(node)] = f;
            return global_get(f, alias_instance(node_decl[base]));
        };
        if decl_is(f, Decl.Fn) {
            node_decl[last_child(node)] = f;
            return member_fn_value(node, f, alias_instance(node_decl[base]));
        };
    };
    check_field_get(node, expect, cx);
}

/// `m.f` or `T.f` named, not called: a `fun`. A generator is not a value.
fn member_fn_value(node: I32, decl: I32, inst: I32) I32 {
    if is_generator(decl) {
        report(Diag.GeneratorCall, node, word_of(last_child(node)));
        return error_value();
    };
    fn_value_in(decl, inst);
}

/// `M[A].f(…)`: a function of the instance `M[A]` (a static method of its type).
fn check_promoted_call(node: I32, expect: I32, cx: Cx) I32 {
    let name_at = first_child(node);
    let args_types = next_sibling(name_at);
    let name = next_sibling(args_types);
    let args = next_sibling(name);
    let decl = node_decl[name];
    let module = node_decl[name_node(name_at)];
    if decl_is(module, Decl.Module) and not decl_is(decl, Decl.Fn) { module = module_of(module); };
    if not decl_is(decl, Decl.Fn) {
        let m0 = w_mark();
        // An unknown module was reported where it was resolved (once by name).
        if module < 0 or reported_within(node) { return finish_error(args, m0, cx); };
        if decl >= 0 and is_type_decl(decl) { not_value(name, decl); }
        else { report3(Diag.UnknownMethod, name, word_of(name), -1, -1, decl_name[module]); };
        return finish_error(args, m0, cx);
    };
    let owner = module_of(decl);
    let targs = type_args(args_types, cx.inst);
    if vl_len[targs] != module_arity(owner) {
        report2(Diag.InvalidModuleArity, node, decl_name[owner], module_arity(owner), vl_len[targs]);
        return error_value();
    };
    let inst = instance(owner, targs);
    if too_deep(inst, node) { return error_value(); };
    let m = w_mark();
    call_with(fn_instance(decl, inst), args, 0, m, node, cx);
}

/// `T.x` (not called): a module's global, or an integer enum's variant.
fn check_type_member(node: I32, expect: I32, cx: Cx) I32 {
    let owner = node_decl[first_child(node)];
    if decl_is(owner, Decl.Foreign) and decl_a[owner] >= 0 { return check_foreign_root(node, decl_a[owner], word_of(last_child(node)), expect); };
    let decl = node_decl[last_child(node)];
    if decl_is(decl, Decl.Global) {
        let inst = member_instance(node, cx);
        return if inst < 0 { error_value(); } else { global_get(decl, inst); };
    };
    if decl_is(decl, Decl.Variant) and decl_is(decl_owner[decl], Decl.IntEnum) { return enum_variant_value(decl); };
    let name = last_child(node);
    if decl < 0 and (decl_is(owner, Decl.IntEnum) or decl_is(owner, Decl.Enum)) and not reported_within(name) {
        report2(Diag.UnknownVariant, name, word_of(name), named(owner, -1), -1);
        suggest_member(owner, name, Space.Member);
        return error_value();
    };
    if decl < 0 and decl_is(owner, Decl.Module) { return module_member_missing(owner, name); };
    // `Color.R` of an enum whose variants are structs: a type, made by `R {…}`.
    if decl_is(decl, Decl.Variant) {
        report2(Diag.VariantNotValue, node, word_of(name), decl_owner[decl], -1);
        return error_value();
    };
    // `T.make` named, not called: the function, as a value.
    if decl_is(decl, Decl.Fn) {
        let inst = if is_kind(first_child(node), Node.Type_ident) and decl_is(owner, Decl.Module) { instance_for(owner, cx.inst); }
            else { ty_inst(type_path(first_child(node), cx.inst)); };
        return member_fn_value(node, decl, inst);
    };
    if decl_is(decl, Decl.Field) {
        report2(Diag.NotValue, node, word_of(name), 2, -1);
        return error_value();
    };
    if decl >= 0 and is_type_decl(decl) { return not_value(node, decl); };
    unsupported(node);
}

//! = Control

//! == Labeled blocks
//!
//! `name: { … }` is a block that `break name` leaves from anywhere inside it
//! (but a closure's body); `break name v` leaves it with the value v. Its
//! value is its last statement's or a break's; its defers run as it is left.
//! ```
//! block $name (result T)  …  (br $name v)  …  end
//! ```

/// Per open labeled block, innermost last: its node, its wasm label, where
/// its defers start, and its type (-1 while it is inferred).
vec label_node: I32;
vec label_wasm: I32;
vec label_defers: I32;
vec label_type: I32;
/// Per open labeled block, while its type is inferred: the first break value's type, or -1.
vec label_seen: I32;

fn check_labeled(node: I32, expect: I32, cx: Cx) I32 {
    let block = last_child(node);
    if not is_kind(first_child(node), Node.Identifier) { return check_block(block, expect, cx); };
    let t = if expect >= 0 { expect; } else { labeled_type(node, cx); };
    let m = w_mark();
    let label = new_label();
    open_label(node, label, t);
    coerce(check_block(block, t, cx), t, block);
    close_label();
    w_node(Op.Block, repr(t), label, 0, m);
    t;
}

/// The type of a labeled block nothing is expected of: its last statement's,
/// or (when that does not complete) its first break value's, else Void.
fn labeled_type(node: I32, cx: Cx) I32 {
    open_label(node, new_label(), -1);
    let tail = type_only(last_child(node), -1, cx);
    let seen = label_seen[label_seen.len() - 1];
    close_label();
    if not ty_is(tail, Ty.Never) { return tail; };
    if seen >= 0 { seen; } else { ty_void(); };
}

fn open_label(node: I32, label: I32, t: I32) void {
    label_node.push(node);
    label_wasm.push(label);
    label_defers.push(defer_node.len());
    label_type.push(t);
    label_seen.push(-1);
}

fn close_label() void {
    let n = label_node.len() - 1;
    label_node.resize(n);
    label_wasm.resize(n);
    label_defers.resize(n);
    label_type.resize(n);
    label_seen.resize(n);
}

/// The labeled block a `break label` leaves: the nearest around it with
/// that label, not past a closure or function; or -1.
fn label_target(brk: I32) I32 {
    let word = word_of(first_child(brk));
    let p = parent_of(brk);
    while (p >= 0 and not is_kind(p, Node.Closure_expr) and not is_kind(p, Node.Fn_decl)) {
        if is_kind(p, Node.Block_expr) and is_kind(first_child(p), Node.Identifier) and word_of(first_child(p)) == word { return p; };
        p = parent_of(p);
    };
    -1;
}

/// The block a `break label` in a closure means, outside the closure, or -1.
fn label_past_closure(brk: I32) I32 {
    let word = word_of(first_child(brk));
    let p = parent_of(brk);
    let crossed = false;
    while (p >= 0 and not is_kind(p, Node.Fn_decl)) {
        if is_kind(p, Node.Closure_expr) { crossed = true; };
        if crossed and is_kind(p, Node.Block_expr) and is_kind(first_child(p), Node.Identifier) and word_of(first_child(p)) == word { return p; };
        p = parent_of(p);
    };
    -1;
}

/// `break label` and `break label v`: the value (checked against the
/// block's type), then the block's pending defers, then `br`.
fn check_break_label(node: I32, cx: Cx) I32 {
    let name = first_child(node);
    let value = next_sibling(name);
    let target = label_target(node);
    let k = label_node.len() - 1;
    while (k >= 0 and label_node[k] != target) { k -= 1; };
    if target < 0 or k < 0 {
        report(Diag.UnknownLabel, name, word_of(name));
        let past = label_past_closure(node);
        if past >= 0 {
            diag_place(Extra.Related, first_child(past), "outside the closure");
            diag_note("a closure cannot leave the block it is in");
        } else if value < 0 {
            diag_note("a loop's break takes no value; break name v leaves a block name: { … } with v");
        };
        let me = w_mark();
        if value >= 0 { discard(check_expr(value, -1, cx)); };
        return error_since(me);
    };
    let t = label_type[k];
    let m = w_mark();
    let carried = false;
    if value >= 0 {
        let vt = check_expr(value, t, cx);
        if t < 0 {
            if label_seen[k] < 0 and not ty_is(vt, Ty.Never) { label_seen[k] = vt; };
        } else {
            coerce(vt, t, value);
            carried = not ty_is(t, Ty.Void);
        };
    } else if t >= 0 and not ty_is(t, Ty.Void) and not ty_is(t, Ty.Error) {
        mismatch(node, t, ty_void());
    };
    if defer_node.len() > label_defers[k] { defers_after_value(if carried { repr(t); } else { vt_none; }, m, label_defers[k], cx); };
    w_node(Op.Br, vt_unreachable, label_wasm[k], 0, m);
    ty_never();
}

fn check_if(node: I32, expected: I32, cx: Cx) I32 {
    let cond = first_child(node);
    let then_ = next_sibling(cond);
    let else_ = next_sibling(then_);
    let bool_t = prelude(Prelude.Bool);
    let expect = expected;
    let m = w_mark();
    want(cond, bool_t, Why.Condition, -1, -1);
    coerce(check_expr(cond, bool_t, cx), bool_t, cond);
    unwant();
    let label = new_label();
    if else_ < 0 {
        let m1 = w_mark();
        discard(check_block(then_, ty_void(), cx));
        w_node(Op.Seq, vt_none, 0, 0, m1);
        w_node(Op.If, vt_none, label, 0, m);
        return ty_void();
    };
    // `if c { C {…}; } else { R {…}; }`: an Sh; `if c { null; } else { "a"; }`: a ?Str.
    if expect < 0 {
        let from = join_nodes.len();
        let b = node;
        while (is_kind(b, Node.If_expr) and next_sibling(next_sibling(first_child(b))) >= 0) {
            join_nodes.push(next_sibling(first_child(b)));
            b = next_sibling(next_sibling(first_child(b)));
        };
        join_nodes.push(b);
        expect = branch_join(from, cx);
    };
    // The result: what is expected, else the then branch's type, else
    // (when it does not complete) the else branch's.
    let t = first_branch(check_block(then_, expect, cx), expect, then_);
    // With nothing expected, the then branch sets the type.
    if expect < 0 and t >= 0 { want(else_, t, Why.Branches, then_, -1); };
    let t2 = if is_kind(else_, Node.If_expr) { check_if(else_, t, cx); } else { check_block(else_, t, cx); };
    t = other_branch(t, t2, else_);
    if expect < 0 and t >= 0 { unwant(); };
    // Its condition is a Bool, and its values when t is (optimize.utu folds it).
    w_node(Op.If, repr(t), label, if t == bool_t { 3; } else { 1; }, m);
    t;
}

/// The type of a two-way choice (an `if`'s value, `promote`, `try`), from
/// its first branch's (of type `t1`, checked against `expect`): what is
/// expected, else t1; or -1 when the branch does not complete, so the
/// other decides.
fn first_branch(t1: I32, expect: I32, at: I32) I32 {
    let t = if expect >= 0 { expect; } else if ty_is(t1, Ty.Never) { -1; } else { t1; };
    if t >= 0 { coerce(t1, t, at); };
    t;
}

/// The choice's type, its other branch (at `at`, of type `t2`) checked
/// against what @first_branch decided.
fn other_branch(t: I32, t2: I32, at: I32) I32 {
    if t < 0 { return t2; };
    coerce(t2, t, at);
    t;
}

/// `while (c) { … }`:
/// ```
/// block $break  loop $top  (br_if $break (not c))  body  (br $top)  end  end
/// ```
fn check_while(node: I32, cx: Cx) I32 {
    let cond = first_child(node);
    let block = last_child(node);
    let brk = new_label();
    let top = new_label();
    let m = w_mark();
    let ml = w_mark();
    if cond != block {
        let bool_t = prelude(Prelude.Bool);
        let mc = w_mark();
        want(cond, bool_t, Why.Condition, -1, -1);
        coerce(check_expr(cond, bool_t, cx), bool_t, cond);
        unwant();
        w_node(Op.Plain, vt_i32, 69, 0, mc);
        w_node(Op.BrIf, vt_none, brk, 0, mc);
    };
    enter_loop(brk, top, -1, -1);
    discard(check_block(block, ty_void(), cx));
    leave_loop();
    w_leaf(Op.Br, vt_unreachable, top, 0);
    w_node(Op.Loop, vt_none, top, 0, ml);
    w_node(Op.Block, vt_none, brk, 0, m);
    ty_void();
}

fn check_break(node: I32, is_break: Bool, cx: Cx) I32 {
    if not is_break and first_child(node) >= 0 { return check_continue_state(node, cx); };
    if is_break and first_child(node) >= 0 { return check_break_label(node, cx); };
    if loop_break.len() == 0 {
        report2(Diag.InvalidBreak, node, -1, if is_break { BreakRule.BreakOutside.to_i32(); } else { BreakRule.ContinueOutside.to_i32(); }, -1);
        return error_value();
    };
    // A loop match moves on with `continue <state>`, never a plain continue.
    if not is_break and loop_state[loop_state.len() - 1] >= 0 {
        report2(Diag.InvalidBreak, node, -1, BreakRule.ContinueWithoutState.to_i32(), -1);
        return error_value();
    };
    let label = if is_break { loop_break[loop_break.len() - 1]; } else { loop_continue[loop_continue.len() - 1]; };
    let m = w_mark();
    run_defers(if is_break { loop_break_defers[loop_break_defers.len() - 1]; } else { loop_defers[loop_defers.len() - 1]; }, cx);
    w_leaf(Op.Br, vt_unreachable, label, 0);
    w_node(Op.Seq, vt_unreachable, 0, 0, m);
    ty_never();
}

fn check_return(node: I32, cx: Cx) I32 {
    let ended = generator_return(node, cx);
    if ended >= 0 { return ended; };
    let value = first_child(node);
    let m = w_mark();
    if value >= 0 {
        let t = check_expr(value, cx.result, cx);
        if ty_is(cx.result, Ty.Void) and not ty_is(t, Ty.Void) and not ty_is(t, Ty.Never) and not ty_is(t, Ty.Error) {
            // The function's name, unless the return is a closure's.
            let name = if cx.fi >= 0 and not in_closure(node) { decl_name[fi_decl[cx.fi]]; } else { -1; };
            report(Diag.ReturnValueFromVoid, value, name);
        };
        want(value, cx.result, Why.Returns, if cx.fi >= 0 and not in_closure(node) { fi_decl[cx.fi]; } else { -1; }, -1);
        coerce(t, cx.result, value);
        unwant();
    } else if not ty_is(cx.result, Ty.Void) {
        mismatch(node, cx.result, ty_void());
    };
    // The value first, then every pending defer of the function.
    if defer_node.len() > function_defers[0] {
        if value >= 0 { return_defers(cx.result, m, function_defers[0], cx); }
        else { defers_after_value(vt_none, m, function_defers[0], cx); };
    };
    w_node(Op.Return, vt_unreachable, 0, 0, m);
    ty_never();
}

/// `assert c` traps unless c.
fn check_assert(node: I32, cx: Cx) I32 {
    let bool_t = prelude(Prelude.Bool);
    let m = w_mark();
    want(first_child(node), bool_t, Why.Assert, -1, -1);
    coerce(check_expr(first_child(node), bool_t, cx), bool_t, first_child(node));
    unwant();
    w_node(Op.Plain, vt_i32, 69, 0, m);
    let mt = w_mark();
    w_leaf(Op.Unreachable, vt_unreachable, 0, 0);
    w_node(Op.Seq, vt_none, 0, 0, mt);
    w_node(Op.If, vt_none, new_label(), 0, m);
    ty_void();
}

//! = Entry points

/// What a build is of: the program's exports, its tests, or a `@comptime`
/// build's expressions.
enum(U8) Target:
    | Normal
    | Tests
    | Comptime
    | Benches

fn reset_check() void {
    memo_state.clear();
    lazy_call_fn.clear();
    export_func.clear();
    export_result.clear();
    export_params.clear();
    lazy_call_sig.clear();
    lazy_call_path.clear();
    lazy_stub_of.clear();
    fi_decl.clear();
    fi_inst.clear();
    fi_func.clear();
    fi_params.clear();
    fi_result.clear();
    fi_ir.clear();
    fi_site.clear();
    checking_inst.clear();
    fi_table.clear();
    fi_queue.clear();
    expand_decls.clear();
    expand_direct.clear();
    user_ir_decl.clear();
    reach_from.clear();
    reach_to.clear();
    checking_fi[0] = -1;
    cur_locals.clear();
    decl_local.resize(decl_kind.len());
    decl_ty.resize(decl_kind.len());
    decl_gi.resize(decl_kind.len());
    decl_cause.resize(decl_kind.len());
    gi_decl.clear();
    gi_inst.clear();
    gi_global.clear();
    gi_ty.clear();
    gi_init.clear();
    gi_next.clear();
    computed_gi.clear();
    computed_init.clear();
    edge_from.clear();
    edge_to.clear();
    cur_fn[0] = -1;
    node_ty.resize(node_kind.len());
    for (0 ..< node_kind.len()) |n| { node_ty[n] = -1; };
    for (0 ..< decl_kind.len()) |d| {
        decl_local[d] = -1;
        decl_ty[d] = 0;
        decl_gi[d] = -1;
        decl_cause[d] = -1;
    };
    reset_data();
    reset_mems();
    reset_host();
    reset_enums();
    reset_control();
    reset_closures();
    reset_generators();
    reset_iterators();
    reset_defers();
    reset_optional();
    reset_promises();
    // Sized here too: a computed global's initializer may be checked first.
    cur_params.resize(1);
    next_label.resize(1);
    speculating.resize(1);
    speculating[0] = 0;
    fi_grow();
}

// Check the program from its entry points, and encode it. Returns the
// module's size in `out`, or -1 when there are diagnostics.

/// A test build's tests, in the order of their exports (`__test_0`, …).
vec test_node: I32;

/// Check the resolved program and encode it for `target`: the module's
/// size in `out`, or -1 when there are diagnostics.
fn compile(target: Target) I32 {
    restore_diagnostics();
    if missing_import[0] >= 0 { return -1; };
    reset_wasm();
    reset_types();
    reset_ir_trees();
    intern_known();
    find_prelude_types();
    reset_check();
    comptime_fuel[0] = -1;
    if target == Target.Comptime {
        comptime_fuel[0] = add_global(vt_i32, true, w_i32_detached(comptime_fuel_limit()));
        glob_field_name[comptime_fuel[0]] = name_add("__comptime_fuel");
    };
    reset_profile();
    check_open_instances();
    validate_program();
    count_memories();
    report_wat();
    report_bare_openers();
    keep_target_diagnostics(target);
    // A DSL that does not expand ends the build, as in stage 0: the first
    // the target has is its one diagnostic.
    for (0 ..< diag_kind.len()) |i| {
        if diag_kind[i] == Diag.DslError.to_i32() {
            diag_move(i, 0);
            diag_truncate(1);
            return -1;
        };
    };
    // A file that does not parse ends the build; other mistakes do not stop
    // checking, which finds what else is wrong.
    // Its parse error is the mistake: what resolving did not find in it
    // (an imported module, …) follows from that, and is dropped.
    for (0 ..< file_root.len()) |file| {
        if file_root[file] < 0 {
            let kept = 0;
            for (0 ..< diag_kind.len()) |i| {
                if diag_kind[i] == Diag.ParseError.to_i32() {
                    diag_move(i, kept);
                    kept += 1;
                };
            };
            diag_truncate(kept);
            return -1;
        };
    };
    test_node.clear();
    bench_node.clear();
    for (0 ..< file_root.len()) |file| {
        if file_role[file] == FileRole.Entry.to_i32() and file_root[file] >= 0 {
            let item = first_child(file_root[file]);
            while (item >= 0) {
                if target == Target.Normal and is_kind(item, Node.Export_lib_decl) {
                    let f = first_child(item);
                    while (f >= 0) {
                        let d = node_decl[last_child(first_child(f))];
                        if is_generator(d) { report(Diag.GeneratorExport, last_child(first_child(f)), decl_name[d]); } else { export_fn(d); };
                        f = next_sibling(f);
                    };
                };
                if target == Target.Normal and is_kind(item, Node.Export_main_decl) { entry_function(item, intern_text("main"), -1); };
                // Every mem of the entry file is a memory of the module, as in stage 0.
                if is_kind(item, Node.Mem_decl) {
                    let d = node_decl[first_child(item)];
                    if not mem_kind_ok(d) { report(Diag.MemKind, item, decl_name[d]); } else { memory_of(d); };
                };
                test_or_bench(item, target);
                // A mod's tests and benches too (a generic mod's run in no instance).
                if is_kind(item, Node.Module_decl) and target != Target.Comptime {
                    let module = node_decl[name_node(first_child(item))];
                    let c = first_child(item);
                    while (c >= 0) {
                        if not is_generic(module) { test_or_bench(c, target); }
                        else if is_kind(c, Node.Test_decl) or is_kind(c, Node.Bench_decl) {
                            report2(Diag.TestInGeneric, first_child(c), decl_name[module], if is_kind(c, Node.Bench_decl) { 1; } else { 0; }, -1);
                        };
                        c = next_sibling(c);
                    };
                };
                item = next_sibling(item);
            };
        };
        // A @comptime build exports the generated functions that evaluate
        // each expression, and the mems they leave the values in.
        if target == Target.Comptime and file_role[file] == FileRole.Generated.to_i32() and file_root[file] >= 0 {
            let item = first_child(file_root[file]);
            while (item >= 0) {
                if is_kind(item, Node.Fn_decl) and has_prefix(word_of(last_child(first_child(item))), "__comptime_run_") {
                    export_fn(node_decl[last_child(first_child(item))]);
                };
                if is_kind(item, Node.Mem_decl) and mem_is_exported(node_decl[first_child(item)]) { memory_of(node_decl[first_child(item)]); };
                item = next_sibling(item);
            };
        };
    };
    // Every function of the program's own files is checked, reached or not;
    // a @comptime build checks only what its expressions reach (the build it
    // is for checks the rest).
    for (0 ..< file_root.len()) |file| {
        if target != Target.Comptime and is_own_file(file) and file_root[file] >= 0 {
            let item = first_child(file_root[file]);
            let entry = file_role[file] == FileRole.Entry.to_i32();
            while (item >= 0) {
                if entry and (target == Target.Normal or not is_kind(item, Node.Export_lib_decl)) { check_item(item); };
                if not entry and declares_item(file, item) { check_item(item); };
                // An imported file's tests and benches: checked, not run.
                if not entry { test_or_bench(item, Target.Normal); };
                if is_kind(item, Node.Module_decl) {
                    let module = node_decl[name_node(first_child(item))];
                    if not is_generic(module) {
                        let c = first_child(item);
                        while (c >= 0) {
                            check_item(c);
                            if not entry { test_or_bench(c, Target.Normal); };
                            c = next_sibling(c);
                        };
                    };
                };
                item = next_sibling(item);
            };
        };
    };
    let next = 0;
    // Then the generators no `for` expanded, and what they reach.
    for (0 ..< 2) |pass| {
        if pass == 1 { check_unused_generators(); };
        while (next < fi_queue.len()) {
            checking_fi[0] = fi_queue[next];
            check_function(fi_queue[next]);
            next += 1;
        };
    };
    checking_fi[0] = -1;
    start_globals();
    if diag_kind.len() > 0 { return -1; };
    encode_module();
}

/// A test or bench: every build checks it; a test build exports the entry
/// file's tests, a bench build its benches.
fn test_or_bench(item: I32, target: Target) void {
    if target == Target.Comptime { return; };
    if is_kind(item, Node.Test_decl) {
        entry_function(item, -1, if target == Target.Tests { test_node.len(); } else { -1; });
        if target == Target.Tests { test_node.push(item); };
    };
    if is_kind(item, Node.Bench_decl) {
        bench_function(item, if target == Target.Benches { bench_node.len(); } else { -1; });
        if target == Target.Benches { bench_node.push(item); };
    };
}

/// Export a function of the program under its name.
fn export_fn(decl: I32) void {
    let fi = fn_instance(decl, 0);
    func_field_name[function_of(fi)] = fn_debug_name(decl);
    export_func.push(function_of(fi));
    export_result.push(fi_result[fi]);
    export_params.push(fi_params[fi]);
}

/// The exported functions and their result types, for the host to give
/// results as JS has them (see write_exports_json).
vec export_func: I32;
vec export_result: I32;
/// Their parameter types (a list), which safe builds check at the boundary.
vec export_params: I32;

fn has_prefix(word: I32, prefix: Str) Bool {
    if src.interned_size(word) < prefix.len() { return false; };
    let start = src.interned_start(word);
    for (0 ..< prefix.len()) |i| { if src[start + i] != prefix.get(i) { return false; }; };
    true;
}

/// Enqueue a function declaration (or those of an `export lib`).
fn check_item(item: I32) void {
    if is_kind(item, Node.Export_lib_decl) {
        let f = first_child(item);
        while (f >= 0) {
            check_item(f);
            f = next_sibling(f);
        };
        return;
    };
    if is_kind(item, Node.Fn_decl) {
        // A generator is checked where it is consumed (or, unused, after).
        let decl = node_decl[last_child(first_child(item))];
        if is_generator(decl) { own_gens.push(decl); } else { fn_instance(decl, 0); };
        return;
    };
    if is_kind(item, Node.Op_decl) {
        fn_instance(node_decl[next_sibling(first_child(item))], 0);
        return;
    };
    if is_kind(item, Node.Global_decl) and not is_es(last_child(item)) { global_of(global_instance(node_decl[first_child(item)], 0)); };
}

/// Resolution reports on the whole entry file; drop what is in surfaces the
/// target leaves out (tests in a normal build, exports in a test build), as
/// those are not part of the program built.
fn keep_target_diagnostics(target: Target) void {
    // The entry file's own items, in place order, for @in_target to search.
    target_items.clear();
    let entry = entry_file();
    let item = if entry >= 0 and file_root[entry] >= 0 { first_child(file_root[entry]); } else { -1; };
    while (item >= 0) {
        if node_last[item] > node_first[item] and file_of_token(node_first[item]) == entry { target_items.push(item); };
        item = next_sibling(item);
    };
    let kept = 0;
    for (0 ..< diag_kind.len()) |i| {
        if in_target(diag_node[i], target) {
            diag_move(i, kept);
            kept += 1;
        };
    };
    diag_truncate(kept);
}

fn in_target(node: I32, target: Target) Bool {
    if node < 0 { return true; };
    // Code a DSL generated is in its site's surface.
    let site = dsl_site_of(node);
    if site >= 0 { return in_target(site, target); };
    if target == Target.Comptime and not is_own_file(file_of_token(node_first[node])) { return true; };
    let t = node_first[node];
    let file = file_of_token(t);
    if file_role[file] != FileRole.Entry.to_i32() { return true; };
    // By place in the file (a DSL's splices are re-read tokens, after the
    // file's): the last item starting at or before it.
    let at = tok_start[t];
    let lo = 0;
    let hi = target_items.len() - 1;
    while (lo < hi) {
        let mid = (lo + hi + 1) / 2;
        if tok_start[node_first[target_items[mid]]] <= at { lo = mid; } else { hi = mid - 1; };
    };
    if hi < 0 { return true; };
    let item = target_items[lo];
    if tok_start[node_first[item]] <= at and at < tok_end[node_last[item] - 1] {
        let kind = node_kind[item];
        if kind == Node.Export_lib_decl.to_i32() or kind == Node.Export_main_decl.to_i32() { return target == Target.Normal; };
        if kind == Node.Mem_decl.to_i32() and target == Target.Comptime { return true; };
        // Tests and benches: in every build but a @comptime one.
        if kind == Node.Test_decl.to_i32() or kind == Node.Bench_decl.to_i32() { return target != Target.Comptime; };
    };
    true;
}

/// A bench build's benches, in the order of their exports (`__bench_0`, …).
vec bench_node: I32;

/// `bench "name" { setup; measure { body } }`: a function `__bench_k(n)`
/// that runs the setup once, then the measured block n times. A test build
/// checks it unexported (k = -1).
/// ```
/// setup  block $done  loop $top  (br_if $done (i >= n))  body  i += 1  (br $top)  end  end
/// ```
fn bench_function(item: I32, k: I32) void {
    let i32_t = prelude(Prelude.I32);
    let mp = vl_begin();
    vl_add(i32_t);
    let f = defined_func(vl_end(mp), ty_void());
    let name = name_add(if k >= 0 { "__bench_" + k.to_str(); } else { "bench"; });
    func_debug_name[f] = name;
    if k >= 0 {
        func_field_name[f] = name;
        export_func.push(f);
        export_result.push(ty_void());
        export_params.push(vl_one(i32_t));
    };
    begin_function();
    cur_fn[0] = -1;
    let n = new_local(vt_i32);
    cur_params.resize(1);
    cur_params[0] = cur_locals.len();
    mark_boxes(item);
    let cx = Cx { inst: 0, fi: -1, result: ty_void() };
    let m = w_mark();
    let defers = defer_node.len();
    let c = next_sibling(first_child(item));
    while (c >= 0 and not is_kind(c, Node.Measure_decl)) {
        coerce(check_statement(c, ty_void(), cx), ty_void(), c);
        c = next_sibling(c);
    };
    let i = new_local(vt_i32);
    let done = new_label();
    let top = new_label();
    // Profiling: the measured loop is the bench's frame (the setup has none).
    let pg = profile_open(c, -1, 0);
    let mb = w_mark();
    let ml = w_mark();
    let mc = w_mark();
    w_get(vt_i32, i);
    w_get(vt_i32, n);
    w_node(Op.Plain, vt_i32, 78, 0, mc);
    w_node(Op.BrIf, vt_none, done, 0, mc);
    discard(check_block(first_child(c), ty_void(), cx));
    let mi = w_mark();
    w_get(vt_i32, i);
    w_i32(1);
    w_node(Op.Plain, vt_i32, 106, 0, mi);
    w_node(Op.LocalSet, vt_none, i, 0, mi);
    w_leaf(Op.Br, vt_unreachable, top, 0);
    w_node(Op.Loop, vt_none, top, 0, ml);
    w_node(Op.Block, vt_none, done, 0, mb);
    profile_close(pg, cx);
    // The setup's defers, once the measuring is done.
    if defer_node.len() > defers {
        run_defers(defers, cx);
        defer_node.resize(defers);
    };
    w_node(Op.Seq, vt_none, 0, 0, m);
    func_body[f] = w_pop();
    record_locals(f, 1);
}

/// The entry file's items, in place order (see @keep_target_diagnostics).
vec target_items: I32;

/// `export main(…)` and tests: functions of their own, exported (a test
/// only in a test build: `test_index` -1 checks it).
fn entry_function(item: I32, name: I32, test_index: I32) void {
    let list = child_of_kind(item, Node.Param_list);
    let m = vl_begin();
    let result = ty_void();
    let p = if list >= 0 { first_child(list); } else { -1; };
    while (p >= 0) {
        vl_add(type_of(next_sibling(first_child(p)), 0));
        p = next_sibling(p);
    };
    let ret = child_of_kind(item, Node.Return_type);
    if ret >= 0 { result = type_of(ret, 0); };
    let params = vl_end(m);
    let f = defined_func(params, result);
    let export_name = if name >= 0 { name_from_src(src.interned_start(name), src.interned_start(name) + src.interned_size(name)); }
        else if test_index >= 0 { name_add("__test_" + test_index.to_str()); } else { name_add("test"); };
    func_debug_name[f] = export_name;
    func_src[f] = item;
    if name >= 0 or test_index >= 0 {
        func_field_name[f] = export_name;
        export_func.push(f);
        export_result.push(result);
        export_params.push(params);
    };
    // `export main() I32 { @wat/\ … \/; }`: its code, which the host assembled.
    let wat = wat_of(last_child(item));
    if wat >= 0 {
        func_code[f] = wat;
        return;
    };
    begin_function();
    cur_fn[0] = -1;
    p = if list >= 0 { first_child(list); } else { -1; };
    for (0 ..< vl_len[params]) |i| {
        let d = node_decl[first_child(p)];
        decl_local[d] = new_local(repr(vl_item(params, i)));
        decl_ty[d] = vl_item(params, i);
        p = next_sibling(p);
    };
    cur_params.resize(1);
    cur_params[0] = cur_locals.len();
    mark_boxes(last_child(item));
    finish_function(f, last_child(item), Cx { inst: 0, fi: -1, result: result }, -1);
}

/// `fn T.f` of an own file whose receiver T names no type, or -1.
/// `fn` named `word` in the module whose type `t` is (`F64.sqrt` for an
/// F64), or -1.
fn module_fn_of(t: I32, word: I32) I32 {
    let d = ty_decl(t);
    if d < 0 { return -1; };
    let module = decl_owner[d];
    if not decl_is(module, Decl.Module) or decl_a[module] != d { return -1; };
    let f = member(module, word, Space.Member);
    if decl_is(f, Decl.Fn) { f; } else { -1; };
}

fn method_of_unknown(receiver: I32, name: I32) I32 {
    for (0 ..< decl_kind.len()) |d| {
        if decl_is(d, Decl.Fn) and decl_a[d] < 0 and is_kind(decl_node[d], Node.Fn_decl) {
            let fn_name = first_child(decl_node[d]);
            if next_sibling(first_child(fn_name)) >= 0 and word_of(first_child(fn_name)) == receiver and word_of(last_child(fn_name)) == name
                and is_own_file(file_of_token(node_first[fn_name])) { return d; };
        };
    };
    -1;
}
