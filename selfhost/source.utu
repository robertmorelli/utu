// ── Sources ──────────────────────────────────────────────────────────────────
//
// A program is files: the entry, the files it imports, theirs, and the
// standard library's prelude. All of them share `src` (bytes), the token
// mems, and the node mems, one after another, so a token or node id names
// one place in the whole program and a word id one name in every file.
//
// The compiler does not read files. The host adds each one (`add_file`,
// then writes its bytes into `src`), and after it is parsed, reads the
// imports it names (`import_*`), finds those files, adds them, and binds
// each import to its file. Paths and file systems stay the host's business;
// the compiler sees only bytes.

enum(U8) FileRole:
    | Entry
    | Import
    | Prelude
    | Generated

// The program's own files: checked whole, reached or not.
fn is_own_file(file: I32) Bool { file_role[file] == FileRole.Entry.to_i32() or file_role[file] == FileRole.Import.to_i32(); }

// Files whose top-level declarations are the program's (not only modules).
fn declares_items(file: I32) Bool { file_role[file] == FileRole.Entry.to_i32() or file_role[file] == FileRole.Generated.to_i32(); }

vec file_start: I32;    // first byte in `src`
vec file_end: I32;      // the end byte after its last
vec file_role: U8;
vec file_tok: I32;      // first token
vec file_tok_end: I32;  // after its last (End or Error)
vec file_root: I32;     // its source file node, or -1 until it parses
vec file_error: I32;    // the token its parse error is at, or -1
vec file_wanted: I32;   // and the word of what the parser wanted there, or -1

// `using M from "…"`, in the order files are parsed.
vec import_file: I32;   // the file that imports
vec import_node: I32;   // the using declaration
vec import_path: I32;   // the node naming the file (a string or platform path)
vec import_target: I32; // the file it names, once the host binds it, else -1 (-2: host declarations)
// The import the host could not read, which ends the build (as in stage
// 0), or -1; and the path the host looked for, a span of src.
vec missing_import: I32 = [-1];
vec missing_start: I32 = [0];
vec missing_end: I32 = [0];

// What the host sealed (see `seal` in lib.utu) besides host declarations:
// the standard library's prelude, parsed. Its words, tokens, nodes, files,
// imports, and DSL sites are the first of each, by count.
vec kept: I32 = [0, 0, 0, 0, 0, 0];

// Keep nothing for the programs that follow.
fn unseal() void {
    abi_kept[0] = 0;
    for (0 ..< kept.len()) |k| { kept[k] = 0; };
    kept_reactive[0] = -1;
    known_kept[0] = 0;
}

// Forget every file, and start a program. What the host has sealed stays,
// with what is known of it: host declarations (abi_kept) are the same
// documents at the same offsets, so their indexes still hold; the prelude's
// files are the same tokens and nodes, its words the same ids.
fn reset_program() void {
    missing_import[0] = -1;
    if abi_kept[0] > 0 {
        for (0 ..< view_import.len()) |v| { view_import[v] = -1; };
    } else {
        reset_abi();
    };
    dsl_failed.clear();
    jp_serial[0] = 0;
    st_serial[0] = 0;
    // The kept nodes' parents are the same (nothing grafts into the prelude).
    if node_parent.len() > kept[2] { node_parent.resize(kept[2]); };
    dsl_cursor[0] = -1;
    splice_start.clear();
    splice_end.clear();
    splice_code.clear();
    splice_from.clear();
    splice_to.clear();
    splice_rename_k.clear();
    splice_rename_at.clear();
    splice_rename_to.clear();
    wu_serial[0] = 0;
    dsl_file_site.clear();
    if kept[0] > 0 { intern_kept(); } else {
        intern_keywords();
        for (["U8", "I8", "U16", "I16"]) |name| { intern_text(name); };
    };
    let tokens = kept[1];
    tok_kind.resize(tokens);
    tok_start.resize(tokens);
    tok_end.resize(tokens);
    tok_word.resize(tokens);
    let nodes = kept[2];
    node_kind.resize(nodes);
    node_first.resize(nodes);
    node_last.resize(nodes);
    node_child.resize(nodes);
    node_next.resize(nodes);
    let files = kept[3];
    file_start.resize(files);
    file_end.resize(files);
    file_role.resize(files);
    file_tok.resize(files);
    file_tok_end.resize(files);
    file_root.resize(files);
    file_error.resize(files);
    file_wanted.resize(files);
    let imports = kept[4];
    import_file.resize(imports);
    import_node.resize(imports);
    import_path.resize(imports);
    import_target.resize(imports);
    dsl_sites.resize(kept[5]);
    reset_resolve();
    // Words are interned anew for each program; kept views spell theirs again.
    if abi_kept[0] > 0 {
        for (0 ..< view_prefix.len()) |v| {
            let p = jget(view_json[v], "prefix");
            view_prefix[v] = if p >= 0 { jstring_word(p); } else { -1; };
        };
    };
}

// The kept words again, and only those: interned anew in order, each is
// its old id (the keywords first, as intern_keywords made them).
fn intern_kept() void {
    let n = kept[0];
    let starts = Array[I32].new(n, 0);
    let ends = Array[I32].new(n, 0);
    for (0 ..< n) |w| {
        starts[w] = src.interned_start(w);
        ends[w] = starts[w] + src.interned_size(w);
    };
    src.resize(abi_kept[0]);
    src.intern_reset();
    for (0 ..< n) |w| { src.intern(starts[w], ends[w]); };
}

// Intern a name that is not in any file (pushed onto `src`).
fn intern_text(text: Str) I32 {
    let start = src.len();
    let before = src.interned();
    gen_text_utf8(text);
    let id = src.intern(start, src.len());
    // Already interned: its bytes are elsewhere.
    if id < before { src.resize(start); };
    id;
}

// Room for a file of `n` bytes, which the host then writes at file_start.
fn add_file(n: I32, role: FileRole) I32 {
    let file = file_start.len();
    let start = src.len();
    src.resize(start + n + 1);
    src[start + n] = end_byte;
    file_start.push(start);
    file_end.push(start + n);
    file_role.push(role.to_i32());
    file_tok.push(tok_kind.len());
    file_tok_end.push(tok_kind.len());
    file_root.push(-1);
    file_error.push(-1);
    file_wanted.push(-1);
    file;
}

// Lex and parse a file the host has written, and list its imports. Returns
// its source file node, or -1 when it does not lex or parse.
fn parse_file(file: I32) I32 {
    let first = tok_kind.len();
    file_tok[file] = first;
    let last = lex(file_start[file], file_end[file]);
    file_tok_end[file] = last;
    let root = parse(first, last);
    file_root[file] = root;
    if root >= 0 { list_imports(file, root); } else {
        file_error[file] = parse_error_at[0];
        file_wanted[file] = parse_error_wanted[0];
    };
    root;
}

fn list_imports(file: I32, root: I32) void {
    let item = node_child[root];
    while (item >= 0) {
        if node_kind[item] == Node.Using_decl.to_i32() {
            let path = last_child(item);
            let kind = node_kind[path];
            if kind == Node.String_lit.to_i32() or kind == Node.Platform_path.to_i32() {
                import_file.push(file);
                import_node.push(item);
                import_path.push(path);
                import_target.push(-1);
            };
        };
        item = node_next[item];
    };
}

// The file a token is in: the one whose bytes it is (a DSL's expansion
// re-reads utu written in a file, after other files' tokens).
fn file_of_token(t: I32) I32 {
    let at = tok_start[t];
    let lo = 0;
    let hi = file_start.len() - 1;
    while (lo < hi) {
        let mid = (lo + hi + 1) / 2;
        if file_start[mid] <= at { lo = mid; } else { hi = mid - 1; };
    };
    lo;
}

// ── Tree helpers ──

// The number of a node's children (0 for no node).
fn child_count(node: I32) I32 {
    if node < 0 { return 0; };
    let n = 0;
    let c = first_child(node);
    while (c >= 0) {
        n += 1;
        c = next_sibling(c);
    };
    n;
}

// A compiled program's tree has no comments (see attach_comments), so a
// node's children are its children.
fn last_child(node: I32) I32 {
    let c = node_child[node];
    let last = -1;
    while (c >= 0) {
        last = c;
        c = node_next[c];
    };
    last;
}

fn first_child(node: I32) I32 { node_child[node]; }

fn next_sibling(node: I32) I32 { node_next[node]; }

fn is_kind(node: I32, kind: Node) Bool { node >= 0 and node_kind[node] == kind.to_i32(); }

// The word id of a node that is one word (an identifier, a type name), else -1.
fn word_of(node: I32) I32 { tok_word[node_first[node]]; }
