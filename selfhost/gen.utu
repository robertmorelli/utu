//! = Generated sources
//!
//! Some of the language is written in the language: the compiler writes utu
//! source for it and adds it to the program as a file of its own, which is
//! parsed and resolved with the rest and checked when it is used.
//!
//! - A byte mem's interner (`src.intern(a, b)`, `src.interned()`, …): an
//!   open-addressing table of FNV-1a hashes over hidden mems, the one stage 0
//!   writes, so ids are the same.
//! - A `@comptime` mem's evaluation: a function that runs the expression into
//!   an exported mem the host reads after running a build of the program
//!   made for it (compile with `Target.Comptime`).

/// Appends `text` to `src`, where the generated file is written.
fn gen_text(text: Str) void { for (0 ..< text.len()) |i| { src.push(text.get(i)); }; }

/// `text` with each `$` replaced by word `name`.
fn gen_template(text: Str, name: I32) void {
    for (0 ..< text.len()) |i| {
        let c = text.get(i);
        if c == 36 { gen_word(name); } else { src.push(c); };
    };
}

/// Appends the text of word id `word`.
fn gen_word(word: I32) void {
    let start = src.interned_start(word);
    for (start ..< start + src.interned_size(word)) |i| { src.push(src[i]); };
}

/// Bytes of `src` itself (copied through a buffer: pushing may move nothing,
/// but reads and writes of one mem must not overlap).
fn gen_span(start: I32, end_: I32) void {
    let n = end_ - start;
    let copy = Array[I32].new(n, 0);
    for (0 ..< n) |i| { copy[i] = src[start + i]; };
    for (0 ..< n) |i| { src.push(copy[i]); };
}

// Where each `@comptime` expression's text went in the generated file (a
// span of `src`), and its `@comptime` node, so its mistakes are reported there.
vec comptime_text_start: I32;
vec comptime_text_end: I32;
vec comptime_text_node: I32;

/// The text written at the end of src since `start`, made a generated file
/// (its bytes, then the end byte, where @add_file places a file): the file.
fn generated_file(start: I32) I32 {
    let n = src.len() - start;
    let copy = Array[I32].new(n, 0);
    for (0 ..< n) |i| { copy[i] = src[start + i]; };
    src.resize(start);
    let file = add_file(n, FileRole.Generated);
    let at = file_start[file];
    for (0 ..< n) |i| { src[at + i] = copy[i]; };
    file;
}

/// By file: the imported file a generated file's declarations belong to
/// (they are in its scope, not the program's), or -1.
vec gen_owner: I32;

/// The imported file whose scope a file's declarations are in, or -1.
fn gen_owner_of(file: I32) I32 { if file < gen_owner.len() { gen_owner[file]; } else { -1; }; }

/// Writes the generated sources for each own file's mems, and parses them
/// as one more file per file. Called before names are resolved.
fn generate_sources() void {
    comptime_text_start.clear();
    comptime_text_end.clear();
    comptime_text_node.clear();
    gen_owner.clear();
    let files = file_root.len();
    for (0 ..< files) |owner| {
        if is_own_file(owner) and file_root[owner] >= 0 {
            let start = src.len();
            let first = comptime_text_start.len();
            let item = first_child(file_root[owner]);
            while (item >= 0) {
                if is_kind(item, Node.Mem_decl) { generate_for_mem(item); };
                item = next_sibling(item);
            };
            if src.len() > start {
                let file = generated_file(start);
                let at = file_start[file];
                for (first ..< comptime_text_start.len()) |k| {
                    comptime_text_start[k] += at - start;
                    comptime_text_end[k] += at - start;
                };
                let n = gen_owner.len();
                gen_owner.resize(file + 1);
                for (n ..< file + 1) |f| { gen_owner[f] = -1; };
                if file_role[owner] == FileRole.Import.to_i32() { gen_owner[file] = owner; };
                parse_file(file);
            };
        };
    };
}

/// A mem declaration's generated source: its interner when it holds bytes,
/// and its `@comptime` evaluation when it has one.
fn generate_for_mem(item: I32) void {
    let name = word_of(first_child(item));
    let elem = next_sibling(first_child(item));
    let w = word_of(elem);
    let byte_mem = w == Kw.count() or w == Kw.count() + 1;
    if byte_mem { gen_template(interner_template(), name); };
    let init = last_child(item);
    // (An empty body is reported, and generates nothing.)
    if init != elem and is_kind(init, Node.Dsl_expr) and word_of(first_child(init)) == known_word(Known.Comptime)
        and dsl_text_start(init) < dsl_text_end(init) {
        // export mem __comptime_NAME: V;
        // fn __comptime_run_NAME() I32 { let values: Array[V] = (EXPR); … }
        // The parentheses keep EXPR one expression.
        let value = comptime_value_name(elem);
        gen_template("\nexport mem __comptime_$: ", name);
        gen_text(value);
        gen_template(";\nfn __comptime_run_$() I32 {\n    let values: Array[", name);
        gen_text(value);
        gen_text("] = (");
        comptime_text_start.push(src.len());
        comptime_text_node.push(init);
        gen_span(dsl_text_start(init), dsl_text_end(init));
        comptime_text_end.push(src.len());
        gen_template(");\n    __comptime_$.clear();\n    for (values) |v| { __comptime_$.push(v); };\n    values.len();\n}\n", name);
    };
}

/// The value type a `@comptime` mem's expression builds an array of, as in
/// stage 0: an integer enum's or a distinct type's representation; then `I32`
/// for the storage kinds narrower than it (`U8`, `I8`, `U16`, `I16`).
fn comptime_value_name(elem: I32) Str {
    let w = word_of(elem);
    let repr = representation_word(w);
    let kind = if repr >= 0 { repr; } else { w; };
    if builtin_type(kind) { return "I32"; };
    if repr >= 0 { return word_text(repr); };
    let text = "";
    for (tok_start[node_first[elem]] ..< tok_end[node_first[elem]]) |i| { text = text + Str.from_code_point(src[i]); };
    text;
}

/// The word of what type `w` is represented as when it is an integer enum
/// (`enum(U8) w`) or a distinct type (`type w = distinct U32`) declared at
/// the top of a file, else -1. Sources are generated before names are
/// resolved, so the declaration is found by its name.
fn representation_word(w: I32) I32 {
    for (0 ..< file_root.len()) |file| {
        let item = if file_root[file] >= 0 { first_child(file_root[file]); } else { -1; };
        while (item >= 0) {
            if is_kind(item, Node.Enum_decl) {
                let c = first_child(item);
                if is_kind(c, Node.Nom_qualifier) { c = next_sibling(c); };
                let name = next_sibling(c);
                if is_kind(c, Node.Type_ident) and is_kind(name, Node.Type_ident) and word_of(name) == w { return word_of(c); };
            } else if is_kind(item, Node.Distinct_decl) and word_of(first_child(item)) == w {
                return word_of(last_child(item));
            };
            item = next_sibling(item);
        };
    };
    -1;
}

/// A byte mem's interner, its name written `$`: the same table stage 0
/// generates, so word ids agree between the two compilers.
fn interner_template() Str {
    "\nvec __$_slots: I32;\nvec __$_starts: I32;\nvec __$_sizes: I32;\nvec __$_hashes: I32;\n"
    + "fn __mem_$_intern_reset() void {\n    __$_slots.resize(1024);\n    for (0 ..< 1024) |slot| { __$_slots[slot] = 0; };\n"
    + "    __$_starts.clear();\n    __$_sizes.clear();\n    __$_hashes.clear();\n}\n"
    + "fn __mem_$_interned() I32 { __$_starts.len(); }\n"
    + "fn __mem_$_interned_start(id: I32) I32 { __$_starts[id]; }\n"
    + "fn __mem_$_interned_size(id: I32) I32 { __$_sizes[id]; }\n"
    + "fn __mem_$_intern_same(a: I32, b: I32, size: I32) Bool {\n    for (0 ..< size) |k| {\n"
    + "        if $[a + k] != $[b + k] { return false; };\n    };\n    true;\n}\n"
    + "fn __mem_$_intern_rehash() void {\n    let size = __$_slots.len() * 2;\n    __$_slots.resize(size);\n"
    + "    for (0 ..< size) |slot| { __$_slots[slot] = 0; };\n    let mask = size - 1;\n"
    + "    for (0 ..< __$_starts.len()) |id| {\n        let slot = __$_hashes[id] & mask;\n"
    + "        while (__$_slots[slot] != 0) { slot = (slot + 1) & mask; };\n        __$_slots[slot] = id + 1;\n    };\n}\n"
    + "fn __mem_$_intern(start: I32, stop: I32) I32 {\n    if __$_slots.len() == 0 { __mem_$_intern_reset(); };\n"
    + "    let hash = -2128831035;\n    for (start ..< stop) |k| { hash = (hash ^ ($[k] & 255)) * 16777619; };\n"
    + "    let size = stop - start;\n    let mask = __$_slots.len() - 1;\n    let slot = hash & mask;\n"
    + "    while (__$_slots[slot] != 0) {\n        let id = __$_slots[slot] - 1;\n"
    + "        if __$_hashes[id] == hash and __$_sizes[id] == size and __mem_$_intern_same(__$_starts[id], start, size) { return id; };\n"
    + "        slot = (slot + 1) & mask;\n    };\n    let id = __$_starts.len();\n    __$_starts.push(start);\n"
    + "    __$_sizes.push(size);\n    __$_hashes.push(hash);\n    __$_slots[slot] = id + 1;\n"
    + "    if (id + 1) * 2 > __$_slots.len() { __mem_$_intern_rehash(); };\n    id;\n}\n";
}

/// The generated function `__mem_NAME_METHOD` of a mem, or -1.
fn generated_mem_fn(mem_decl: I32, method: I32) I32 {
    let start = src.len();
    gen_text("__mem_");
    gen_word(decl_name[mem_decl]);
    gen_text("_");
    gen_word(mem_method_word[method]);
    let before = src.interned();
    let word = src.intern(start, src.len());
    // A new word names nothing (and keeps its bytes, which it now refers to).
    if word >= before { return -1; };
    src.resize(start);
    let decl = lookup(word);
    if decl_is(decl, Decl.Fn) { return decl; };
    // An imported file's mem: its functions are in that file's scope.
    for (0 ..< decl_kind.len()) |d| { if decl_name[d] == word and decl_is(d, Decl.Fn) { return d; }; };
    -1;
}

//! = Evaluating `@comptime` in order
//!
//! A `@comptime` expression may read another `@comptime` mem, which must be
//! evaluated first. A @comptime build notes what each function it checks
//! reaches (the functions it names, the mems it uses); the host runs only
//! the expressions whose reach holds no mem still waiting, gives their
//! values, and builds again for the rest. One that waits on itself, or on
//! a mem that waits on it, is reported.

/// What checked functions reach: from a function instance, to one (`to`
/// >= 0) or to mem `-2 - to`.
vec reach_from: I32;
vec reach_to: I32;
/// The function instance being checked, or -1.
vec checking_fi: I32 = [-1];
/// The mem a waiting expression reaches, found by @comptime_ready.
vec comptime_blocker: I32 = [-1];

/// Function instance `fi` names `to` (or uses mem `-2 - to`), while checked.
fn note_reach(to: I32) void {
    if checking_fi[0] < 0 { return; };
    reach_from.push(checking_fi[0]);
    reach_to.push(to);
}

fn note_mem_use(decl: I32) void { note_reach(-2 - decl); }

/// Whether mem k's expression waits, and the build just made can evaluate
/// it: nothing it reaches is a `@comptime` mem still waiting (that one is
/// left in @comptime_blocker).
fn comptime_ready(k: I32) Bool {
    comptime_blocker[0] = -1;
    if comptime_start[k] != -1 { return false; };
    let word = intern_text("__comptime_run_" + word_text(decl_name[comptime_mem[k]]));
    let reached = Array[Bool].new(fi_decl.len(), false);
    for (0 ..< fi_decl.len()) |f| { if decl_name[fi_decl[f]] == word { reached[f] = true; }; };
    let changed = true;
    while (changed) {
        changed = false;
        for (0 ..< reach_from.len()) |e| {
            let to = reach_to[e];
            if reached[reach_from[e]] and to >= 0 and not reached[to] {
                reached[to] = true;
                changed = true;
            };
        };
    };
    for (0 ..< reach_from.len()) |e| {
        if reached[reach_from[e]] and reach_to[e] <= -2 {
            let other = comptime_index(-2 - reach_to[e]);
            if other >= 0 and (comptime_start[other] == -1 or comptime_start[other] == -3) {
                comptime_blocker[0] = comptime_mem[other];
                return false;
            };
        };
    };
    true;
}

/// A @comptime build's fuel: a global each loop round takes one from, and
/// traps at zero (the host reads it, exported, to say why).
vec comptime_fuel: I32 = [-1];

/// How many loop rounds a @comptime build may make.
fn comptime_fuel_limit() I32 { 100000000; }

/// `fuel -= 1; if fuel == 0 { unreachable }`, a node.
fn fuel_check() I32 {
    let g = comptime_fuel[0];
    let m = w_mark();
    let ms = w_mark();
    w_leaf(Op.GlobalGet, vt_i32, g, 0);
    w_i32(1);
    w_i32_op(i32_sub, ms);
    w_node(Op.GlobalSet, vt_none, g, 0, ms);
    let mi = w_mark();
    w_leaf(Op.GlobalGet, vt_i32, g, 0);
    w_i32_op(i32_eqz, mi);
    let mt = w_mark();
    w_leaf(Op.Unreachable, vt_unreachable, 0, 0);
    w_node(Op.Seq, vt_none, 0, 0, mt);
    w_node(Op.If, vt_none, -1, 0, mi);
    w_node(Op.Seq, vt_none, 0, 0, m);
    w_pop();
}
