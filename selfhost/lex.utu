//! = The lexer
//!
//! Source bytes in, tokens out.
//!
//! A state machine, built during compilation (@build) into const vecs (@dfa):
//! lexing is one table load per byte in a `loop match`. Each token's kind and
//! byte span go into three mems.
//!
//! The lexer does not know the grammar: every word is a `Word` (the parser
//! decides which are keywords, which are identifiers, and which are type
//! names), and the parser joins `std` `:` `Str` into a platform path.
//! Comments are tokens, so the parser can attach them to the tree.
//!
//! A few tokens depend on the token before them. `-o` (pipe), `?.` (optional
//! field), and compound assignments (`&=`, `<<=`, …) only follow a finished
//! expression: `x -o in` pipes to `in`, while `type &= …` declares the self
//! type. So the machine has start states after an expression and not, and
//! the state a token ends in says which start state comes next. Words that
//! begin an expression (`and`, `let`, …) are paths through the word states
//! that end in a state of their own, except after `.` or `?.`, where a word
//! is always a name (`Box.new -o f`, `row.cl >>>= 1`): that has a start
//! state of its own too.
//!
//! The JavaScript compiler's parser is the reference: for every program it
//! accepts, these tokens are exactly the leaves of its syntax tree
//! (`scripts/selfhost-lexer-differential.mjs`).

/// A token's kind. Every word is a `Word`: which are keywords is the parser's to say.
enum(U8) Tok:
    | End
    | Error
    | Word
    | Int
    | Float
    | String
    | MultilineLine
    | DslBody
    | Comment
    | TemplateFull    // `text`
    | TemplateHead    // `text${
    | TemplateMiddle  // }text${
    | TemplateTail    // }text`
    | LParen
    | RParen
    | LBrace
    | RBrace
    | LBracket
    | RBracket
    | Comma
    | Semi
    | Colon
    | At
    | Dot
    | DotDotDot
    | DotDotLt
    | Pipe
    | PipeEq
    | Amp
    | AmpEq
    | Caret
    | CaretEq
    | Star
    | StarEq
    | Slash
    | SlashEq
    | Percent
    | PercentEq
    | Plus
    | PlusEq
    | Minus
    | MinusEq
    | MinusO
    | Lt
    | LtEq
    | Shl
    | ShlEq
    | Gt
    | GtEq
    | Shr
    | ShrEq
    | Shr3
    | Shr3Eq
    | Eq
    | EqEq
    | FatArrow
    | BangEq
    | Question
    | QuestionDot
    | Tilde
    | TildeArrow

// What the table says to do next, below the real states:
/// No token can continue or start here.
let error_code: I32 = 0;
/// The token ends before this byte.
let accept_code: I32 = 1;
/// The token ended one byte back.
let back1_code: I32 = 2;
/// The token ended two bytes back.
let back2_code: I32 = 3;
/// Whitespace through this byte: drop it.
let skip_code: I32 = 4;
/// `/\`: a DSL body, which nests
let dsl_code: I32 = 5;
/// The end of the source.
let done_code: I32 = 6;
/// A backtick: a template string's text, scanned.
let template_code: I32 = 7;
/// The start states: not after an expression,.
let start_before: I32 = 8;
/// After one,.
let start_after: I32 = 9;
/// After `.` or `?.`,.
let start_member: I32 = 10;
/// And after `type`
let start_type: I32 = 11;

/// The source ends with this byte, which UTF-8 never uses.
let end_byte: I32 = 255;

/// `next = dfa[state * 256 + byte]`. A token ending in a state has kind
/// `kind_of[state]`; one backed off from it has kind `back_kind[state]`. The
/// start state that follows is `after_of` (0: before, 1: after, 2: the same,
/// 3: member, 4: type).
const vec dfa: U8 = @comptime/\ build().tabs \/;
const vec kind_of: U8 = @comptime/\ build().kinds \/;
const vec back_kind: U8 = @comptime/\ build().backs \/;
const vec after_of: U8 = @comptime/\ build().afters \/;

/// The program's bytes: each file's, followed by @end_byte, and the text of
/// interned words (a word is a span of it).
export mem src: U8;
/// By token: its @Tok. With @tok_start and @tok_end (its byte span in @src),
/// the tokens of every file, in order.
export mem tok_kind: U8;
export mem tok_start: I32;
export mem tok_end: I32;

//! = The state machine, built at compile time

/// The lexer's state machine while @build makes it: a row of 256 next states
/// per state, each state's token kinds and next start state, the next free
/// state, and the word state.
struct Machine:
    | tabs: Array[I32]
    | kinds: Array[I32]
    | backs: Array[I32]
    | afters: Array[I32]
    | next: I32
    | word: I32

fn set(m: Machine, from: I32, c: I32, to: I32) void {
    m.tabs[from * 256 + c] = to;
}

fn get(m: Machine, from: I32, c: I32) I32 {
    m.tabs[from * 256 + c];
}

fn set_range(m: Machine, from: I32, lo: I32, hi: I32, to: I32) void {
    for (lo ... hi) |c| { set(m, from, c, to); };
}

fn both(m: Machine, c: I32, to: I32) void {
    set(m, start_before, c, to);
    set(m, start_after, c, to);
}

fn is_word_char(c: I32) Bool {
    (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or c == 95 or (c >= 48 and c <= 57);
}

/// A state whose token is complete: any byte without an edge ends it.
fn ends(m: Machine, kind: Tok, after: I32) I32 {
    let state = m.next;
    m.next += 1;
    m.kinds[state] = kind.to_i32();
    m.afters[state] = after;
    for (0 ..< 256) |c| { set(m, state, c, accept_code); };
    state;
}

/// A state in the middle of a token: any byte without an edge is an error.
fn inside(m: Machine) I32 {
    let state = m.next;
    m.next += 1;
    state;
}

/// A state that backs off when no edge continues: the token was `kind`, ending `by` bytes back.
fn backs_off(m: Machine, kind: Tok, after: I32, by: I32) I32 {
    let state = inside(m);
    m.backs[state] = kind.to_i32();
    m.afters[state] = after;
    for (0 ..< 256) |c| { set(m, state, c, if by == 1 { back1_code; } else { back2_code; }); };
    state;
}

fn single(m: Machine, c: I32, kind: Tok, after: I32) void {
    both(m, c, ends(m, kind, after));
}

fn whitespace(m: Machine) void {
    // JavaScript's `\s`, which is what the grammar skips: ASCII tab through
    // carriage return and space, and the UTF-8 encodings of no-break space,
    // ogham space mark, the en quad through hair space, the line and
    // paragraph separators, narrow no-break space, medium mathematical
    // space, ideographic space, and the byte order mark.
    for (9 ... 13) |c| { both(m, c, skip_code); };
    both(m, 32, skip_code);
    let c2 = inside(m);
    both(m, 194, c2);
    set(m, c2, 160, skip_code);
    let e1 = inside(m);
    let e1_9a = inside(m);
    both(m, 225, e1);
    set(m, e1, 154, e1_9a);
    set(m, e1_9a, 128, skip_code);
    let e2 = inside(m);
    let e2_80 = inside(m);
    let e2_81 = inside(m);
    both(m, 226, e2);
    set(m, e2, 128, e2_80);
    set_range(m, e2_80, 128, 138, skip_code);
    set(m, e2_80, 168, skip_code);
    set(m, e2_80, 169, skip_code);
    set(m, e2_80, 175, skip_code);
    set(m, e2, 129, e2_81);
    set(m, e2_81, 159, skip_code);
    let e3 = inside(m);
    let e3_80 = inside(m);
    both(m, 227, e3);
    set(m, e3, 128, e3_80);
    set(m, e3_80, 128, skip_code);
    let ef = inside(m);
    let ef_bb = inside(m);
    both(m, 239, ef);
    set(m, ef, 187, ef_bb);
    set(m, ef_bb, 191, skip_code);
}

/// A token running to the end of its line: `// …` and `\\ …`.
fn to_line_end(m: Machine, state: I32) void {
    for (0 ..< 256) |c| { set(m, state, c, state); };
    set(m, state, 10, accept_code);
    set(m, state, end_byte, accept_code);
}

/// `"…"` with backslash escapes; a newline or the end of the source inside is an error.
fn strings(m: Machine) void {
    let body = inside(m);
    let escape = inside(m);
    let close = ends(m, Tok.String, 1);
    both(m, 34, body);
    for (0 ..< 255) |c| {
        set(m, body, c, body);
        set(m, escape, c, body);
    };
    set(m, body, 10, error_code);
    set(m, body, 34, close);
    set(m, body, 92, escape);
    set(m, escape, 10, error_code);
}

/// Numbers, as the grammar's regular expressions take them: a float
/// (`1.5`, `2.0e-3`) where one fits, else `0x1f`, `0b101`, or `15`.
fn numbers(m: Machine) void {
    let int = ends(m, Tok.Int, 1);
    let zero = ends(m, Tok.Int, 1);
    let dot = backs_off(m, Tok.Int, 1, 1);
    let float = ends(m, Tok.Float, 1);
    let exp = backs_off(m, Tok.Float, 1, 1);
    let exp_sign = backs_off(m, Tok.Float, 1, 2);
    let exp_digits = ends(m, Tok.Float, 1);
    let hex_start = backs_off(m, Tok.Int, 1, 1);
    let hex = ends(m, Tok.Int, 1);
    let bin_start = backs_off(m, Tok.Int, 1, 1);
    let bin = ends(m, Tok.Int, 1);
    set_range(m, start_before, 49, 57, int);
    set_range(m, start_after, 49, 57, int);
    both(m, 48, zero);
    for ([int, zero]) |state| {
        set_range(m, state, 48, 57, int);
        set(m, state, 46, dot);
    };
    set(m, zero, 120, hex_start);
    set(m, zero, 98, bin_start);
    set_range(m, dot, 48, 57, float);
    set_range(m, float, 48, 57, float);
    set(m, float, 101, exp);
    set(m, float, 69, exp);
    set(m, exp, 43, exp_sign);
    set(m, exp, 45, exp_sign);
    set_range(m, exp, 48, 57, exp_digits);
    set_range(m, exp_sign, 48, 57, exp_digits);
    set_range(m, exp_digits, 48, 57, exp_digits);
    for ([hex_start, hex]) |state| {
        set_range(m, state, 48, 57, hex);
        set_range(m, state, 97, 102, hex);
        set_range(m, state, 65, 70, hex);
    };
    for ([bin_start, bin]) |state| {
        set(m, state, 48, bin);
        set(m, state, 49, bin);
    };
}

/// A word state: word characters continue the word, anything else ends it.
fn word_state(m: Machine, after: I32) I32 {
    let state = ends(m, Tok.Word, after);
    for (0 ..< 256) |c| { if is_word_char(c) { set(m, state, c, m.word); }; };
    state;
}

fn words(m: Machine) void {
    m.word = word_state(m, 1);
    for (0 ..< 256) |c| { if is_word_char(c) { set(m, m.word, c, m.word); }; };
    for (0 ..< 256) |c| {
        if is_word_char(c) and (c < 48 or c > 57) { both(m, c, m.word); };
    };
    // Words after which an expression begins, so a `-o`, `?.`, or compound
    // assignment cannot follow them. Each is a path through word states,
    // from the start states where it is a keyword, ending in one whose token
    // is followed by the start state before an expression. The keywords that
    // begin an expression are keywords wherever they stand; elsewhere other
    // words are names: `x -o in` pipes to `in`. Not `break`, which is a whole
    // expression, nor `return` and `continue`, whose `-o` the parser reads as
    // a pipe (`return -o f`).
    for (["if", "match", "loop", "alt", "promote", "try", "for", "while", "defer", "yield", "let", "cl", "new",
            "await", "assert", "not"]) |word| {
        keyword_path(m, start_before, word, 0);
        keyword_path(m, start_after, word, 0);
    };
    // The keyword operators, and `else`, follow an expression; where one
    // begins, they are names (`assert or >>>= 1`).
    for (["and", "or", "xor", "orelse", "else"]) |word| { keyword_path(m, start_after, word, 0); };
    // `type &= …` declares the self type: after `type`, `&=` is `&` and `=`.
    keyword_path(m, start_before, "type", 4);
    keyword_path(m, start_after, "type", 4);
}

/// The path of `word` through the word states from `root`, ending in a state whose token is followed by start state `after`.
fn keyword_path(m: Machine, root: I32, word: Str, after: I32) void {
    let current = root;
    for (0 ..< word.len()) |k| {
        let c = word.get(k);
        let next = get(m, current, c);
        if next == m.word {
            next = word_state(m, 1);
            set(m, current, c, next);
        };
        current = next;
    };
    m.afters[current] = after;
}

/// `X` and, after an expression, `X=` (but not before `>`: `|x|=> …` closes
/// a capture before an arm). Returns the state after `X` following an expression.
fn compound(m: Machine, c: I32, plain: Tok, assign: Tok) I32 {
    set(m, start_before, c, ends(m, plain, 0));
    let first = ends(m, plain, 0);
    set(m, start_after, c, first);
    let eq = ends(m, assign, 0);
    set(m, first, 61, eq);
    set(m, eq, 62, back1_code);
    m.backs[eq] = plain.to_i32();
    first;
}

fn punctuation(m: Machine) void {
    single(m, 40, Tok.LParen, 0);
    single(m, 41, Tok.RParen, 1);
    single(m, 123, Tok.LBrace, 0);
    single(m, 125, Tok.RBrace, 1);
    single(m, 91, Tok.LBracket, 0);
    single(m, 93, Tok.RBracket, 1);
    single(m, 44, Tok.Comma, 0);
    single(m, 59, Tok.Semi, 0);
    single(m, 58, Tok.Colon, 0);
    single(m, 64, Tok.At, 0);

    // `.`, `...`, `..<`; `..` alone is two dots.
    let dot = ends(m, Tok.Dot, 3);
    let dots = backs_off(m, Tok.Dot, 3, 1);
    both(m, 46, dot);
    set(m, dot, 46, dots);
    set(m, dots, 46, ends(m, Tok.DotDotDot, 0));
    set(m, dots, 60, ends(m, Tok.DotDotLt, 0));

    compound(m, 124, Tok.Pipe, Tok.PipeEq);
    compound(m, 38, Tok.Amp, Tok.AmpEq);
    compound(m, 94, Tok.Caret, Tok.CaretEq);
    compound(m, 42, Tok.Star, Tok.StarEq);
    compound(m, 37, Tok.Percent, Tok.PercentEq);
    compound(m, 43, Tok.Plus, Tok.PlusEq);

    // `/`: also `//` comments and `/\` DSL bodies.
    let slash_after = compound(m, 47, Tok.Slash, Tok.SlashEq);
    let comment = ends(m, Tok.Comment, 2);
    to_line_end(m, comment);
    for ([get(m, start_before, 47), slash_after]) |state| {
        set(m, state, 47, comment);
        set(m, state, 92, dsl_code);
    };
    // `\\` multiline string lines.
    let backslash = inside(m);
    let line = ends(m, Tok.MultilineLine, 1);
    to_line_end(m, line);
    both(m, 92, backslash);
    set(m, backslash, 92, line);

    // `-`, and after an expression `-o` and `-=`.
    let minus = compound(m, 45, Tok.Minus, Tok.MinusEq);
    set(m, minus, 111, ends(m, Tok.MinusO, 0));

    // `<`, `<=`, `<<`, and after an expression `<<=`.
    for ([start_before, start_after]) |start| {
        let lt = ends(m, Tok.Lt, 0);
        let shl = ends(m, Tok.Shl, 0);
        set(m, start, 60, lt);
        set(m, lt, 61, ends(m, Tok.LtEq, 0));
        set(m, lt, 60, shl);
        if start == start_after { set(m, shl, 61, ends(m, Tok.ShlEq, 0)); };
    };
    // `>`, `>=`, `>>`, `>>>`, and after an expression `>>=` and `>>>=`.
    for ([start_before, start_after]) |start| {
        let gt = ends(m, Tok.Gt, 0);
        let shr = ends(m, Tok.Shr, 0);
        let shr3 = ends(m, Tok.Shr3, 0);
        set(m, start, 62, gt);
        set(m, gt, 61, ends(m, Tok.GtEq, 0));
        set(m, gt, 62, shr);
        set(m, shr, 62, shr3);
        if start == start_after {
            set(m, shr, 61, ends(m, Tok.ShrEq, 0));
            set(m, shr3, 61, ends(m, Tok.Shr3Eq, 0));
        };
    };

    // `=`, `==`, `=>`.
    let eq = ends(m, Tok.Eq, 0);
    both(m, 61, eq);
    set(m, eq, 61, ends(m, Tok.EqEq, 0));
    set(m, eq, 62, ends(m, Tok.FatArrow, 0));
    // `!=` (`!` alone is no token).
    let bang = inside(m);
    both(m, 33, bang);
    set(m, bang, 61, ends(m, Tok.BangEq, 0));
    // `~`, `~>`.
    let tilde = ends(m, Tok.Tilde, 0);
    both(m, 126, tilde);
    set(m, tilde, 62, ends(m, Tok.TildeArrow, 0));
    // `?`, and after an expression `?.` (but `?.{I32}` after a parameter
    // list is a nullable tuple type).
    set(m, start_before, 63, ends(m, Tok.Question, 0));
    let question = ends(m, Tok.Question, 0);
    let optional = ends(m, Tok.QuestionDot, 3);
    set(m, start_after, 63, question);
    set(m, question, 46, optional);
    set(m, optional, 123, back1_code);
    m.backs[optional] = Tok.Question.to_i32();
}

/// The state machine, made at compile time (the @dfa tables are its rows).
fn build() Machine {
    let m = Machine {
        tabs: Array[I32].new(256 * 256, error_code),
        kinds: Array[I32].new(256, Tok.Error.to_i32()),
        backs: Array[I32].new(256, Tok.Error.to_i32()),
        afters: Array[I32].new(256, 0),
        next: start_type + 1,
        word: 0,
    };
    both(m, end_byte, done_code);
    both(m, 96, template_code);
    whitespace(m);
    strings(m);
    numbers(m);
    words(m);
    punctuation(m);
    // After `.` or `?.`, as before an expression, except that every word is a name.
    for (0 ..< 256) |c| { set(m, start_member, c, get(m, start_before, c)); };
    for (0 ..< 256) |c| {
        if is_word_char(c) and (c < 48 or c > 57) { set(m, start_member, c, m.word); };
    };
    // After `type`, as after an expression, except that `&` is never `&=`.
    for (0 ..< 256) |c| { set(m, start_type, c, get(m, start_after, c)); };
    set(m, start_type, 38, get(m, start_before, 38));
    if m.next > 256 { fatal; };
    m.tabs = m.tabs.slice(0, m.next * 256);
    m.kinds = m.kinds.slice(0, m.next);
    m.backs = m.backs.slice(0, m.next);
    m.afters = m.afters.slice(0, m.next);
    m;
}

//! = Lexing

/// Token t, written in the room lex reserved; the one after it.
fn put_token(t: I32, kind: I32, start: I32, end_: I32) I32 {
    tok_kind[t] = kind;
    tok_start[t] = start;
    tok_end[t] = end_;
    t + 1;
}

/// The tokens up to t are the mems' contents; their number.
fn tokens_end(t: I32) I32 {
    tok_kind.resize(t);
    tok_start.resize(t);
    tok_end.resize(t);
    t;
}

/// The end of the DSL body at `i` (a `/\`), with nested `/\ … \/` pairs balanced, or -1.
fn dsl_end(i: I32, n: I32) I32 {
    let j = i + 2;
    let depth = 1;
    while (j < n) {
        let c = src[j];
        j += 1;
        if c == 47 and src[j] == 92 {
            depth += 1;
            j += 1;
        } else if c == 92 and src[j] == 47 {
            j += 1;
            depth -= 1;
            if depth == 0 { return j; };
        };
    };
    -1;
}

/// Where the text of a template string that starts at `i` ends: at its
/// closing backtick, or at the `$` of a `${`; -1 when the source ends first,
/// or a backslash is the last byte of a line.
fn template_text_end(i: I32, n: I32) I32 {
    let j = i;
    while (j < n) {
        let c = src[j];
        if c == 96 { return j; };
        if c == 36 and src[j + 1] == 123 { return j; };
        if c == 92 {
            if j + 1 >= n or src[j + 1] == 10 { return -1; };
            j += 2;
        } else { j += 1; };
    };
    -1;
}

/// Template strings open as they are lexed: by each, how many `{` are open
/// in its current `${ … }` (a `}` with none open continues its text).
vec template_braces: I32;

/// Lex the bytes of `src` from `first` to the end byte at `n`, appending
/// their tokens. The last token is `End`, or `Error` (at the start of the
/// token that cannot be lexed: a byte no token starts with, or a string or
/// DSL body that does not close). Returns the number of tokens.
fn lex(first: I32, n: I32) I32 {
    // Room for the most tokens there can be: one a byte, and the last.
    let t = tok_kind.len();
    let room = t + n - first + 2;
    tok_kind.reserve(room);
    tok_start.reserve(room);
    tok_end.reserve(room);
    let i = first;
    let j = first;
    let open = 0;  // template strings in a `${`
    template_braces.clear();
    let start = start_before;
    let state = start;
    let next = dfa[start * 256 + src[first]];
    loop match next {
        0 => {
            return tokens_end(put_token(t, Tok.Error.to_i32(), i, i));
        },
        1 => {
            let kind = kind_of[state];
            if open > 0 and kind == Tok.RBrace.to_i32() and template_braces[open - 1] == 0 {
                // The `}` that ends a `${`: the template's text goes on.
                j = template_text_end(i + 1, n);
                if j < 0 { return tokens_end(put_token(t, Tok.Error.to_i32(), i, i)); };
                if src[j] == 96 {
                    j += 1;
                    t = put_token(t, Tok.TemplateTail.to_i32(), i, j);
                    open -= 1;
                    template_braces.resize(open);
                    start = start_after;
                } else {
                    j += 2;
                    t = put_token(t, Tok.TemplateMiddle.to_i32(), i, j);
                    start = start_before;
                };
                i = j;
                state = start;
                next = dfa[start * 256 + src[j]];
                continue next;
            };
            if open > 0 and kind == Tok.LBrace.to_i32() { template_braces[open - 1] += 1; };
            if open > 0 and kind == Tok.RBrace.to_i32() { template_braces[open - 1] -= 1; };
            t = put_token(t, kind, i, j);
            let after = after_of[state];
            if after == 0 { start = start_before; } else if after == 1 { start = start_after; }
            else if after == 3 { start = start_member; } else if after == 4 { start = start_type; };
            i = j;
            state = start;
            next = dfa[start * 256 + src[j]];
            continue next;
        },
        2 => {
            j -= 1;
            t = put_token(t, back_kind[state], i, j);
            let after = after_of[state];
            start = if after == 1 { start_after; } else if after == 3 { start_member; } else { start_before; };
            i = j;
            state = start;
            next = dfa[start * 256 + src[j]];
            continue next;
        },
        3 => {
            j -= 2;
            t = put_token(t, back_kind[state], i, j);
            let after = after_of[state];
            start = if after == 1 { start_after; } else if after == 3 { start_member; } else { start_before; };
            i = j;
            state = start;
            next = dfa[start * 256 + src[j]];
            continue next;
        },
        4 => {
            j += 1;
            i = j;
            state = start;
            next = dfa[start * 256 + src[j]];
            continue next;
        },
        5 => {
            j = dsl_end(i, n);
            if j < 0 {
                return tokens_end(put_token(t, Tok.Error.to_i32(), i, i));
            };
            t = put_token(t, Tok.DslBody.to_i32(), i, j);
            start = start_after;
            i = j;
            state = start;
            next = dfa[start * 256 + src[j]];
            continue next;
        },
        6 => {
            return tokens_end(put_token(t, Tok.End.to_i32(), n, n));
        },
        7 => {
            j = template_text_end(i + 1, n);
            if j < 0 { return tokens_end(put_token(t, Tok.Error.to_i32(), i, i)); };
            if src[j] == 96 {
                j += 1;
                t = put_token(t, Tok.TemplateFull.to_i32(), i, j);
                start = start_after;
            } else {
                j += 2;
                t = put_token(t, Tok.TemplateHead.to_i32(), i, j);
                template_braces.push(0);
                open += 1;
                start = start_before;
            };
            i = j;
            state = start;
            next = dfa[start * 256 + src[j]];
            continue next;
        },
        ~> {
            // A state to move to. The bytes of a word, a number, a comment,
            // or spaces are many in a row, and mostly keep the state: those
            // go round here, each read independent of the one before.
            while (next > 7) {
                state = next;
                j += 1;
                let row = state * 256;
                next = dfa[row + src[j]];
                while (next == state) {
                    j += 1;
                    next = dfa[row + src[j]];
                };
            };
            continue next;
        },
    };
    tok_kind.len();
}
