//! = Static text
//!
//! The compiler's messages, word lists, and code templates are tables: an
//! enum names each string, and a function (`*_src`) gives its text. The
//! first time the compiler needs one of them, @st_tables lays every
//! table's strings end to end, each ended by a 0, in one string.
//!
//! A template's text has holes: `{0}` … `{3}`, which @stf fills, and a
//! diagnostic's own (`{w}`, `{ta}`, …; see @st_hole and @diag_hole). They are
//! characters 1 to 30 (not 9 or 10); character 31 parts a diagnostic's templates.

/// Every string, each ended by a 0, and by string, where it starts.
struct StTable:
    | text: Str
    | at: Array[I32]

let st_table: StTable = StTable { text: "", at: Array[I32].new(0, 0) }

/// String `id`.
fn st(id: I32) Str {
    let at = st_ready()
    return st_table.text.slice(at[id], at[id + 1] - 1)
}

/// Template `id`, its holes `{0}` … `{3}` filled with `a` … `d`.
fn stf(id: I32, a: Str, b: Str, c: Str, d: Str) Str {
    let run = st_ready()[id]
    let text = st_table.text
    let out = ""
    let j = run
    while (text.get(j) != 0) {
        let h = text.get(j)
        if h < 5 {
            out = out + text.slice(run, j) + (if h == 1 { a } else if h == 2 { b } else if h == 3 { c } else { d })
            run = j + 1
        }
        j += 1
    }
    return out + text.slice(run, j)
}

/// Whether `w` is one of string `id`'s words (between spaces or lines).
fn st_has_word(id: I32, w: Str) Bool {
    let at = st_ready()
    let n = w.len()
    if n == 0 { return false }
    let text = st_table.text
    let i = text_index(text, w, at[id])
    while (i >= 0 and i < at[id + 1]) {
        let c = text.get(i + n)
        if (i == at[id] or text.get(i - 1) <= 32) and c <= 32 { return true }
        i = text_index(text, w, i + 1)
    }
    return false
}

/// Make the tables, once; by string, where it starts.
fn st_ready() Array[I32] {
    if st_table.at.len() > 0 { return st_table.at }
    st_tables()
    let n = st_build.len()
    let codes = Array[I32].new(n, 0)
    for (0 ..< n) |i| { codes[i] = st_build[i] }
    // Table k's string j starts at `starts[1024 * k + j]`; one more slot
    // past its last ends it.
    let tables = st_counts.len()
    let starts = Array[I32].new(1024 * tables, 0)
    let slot = 0
    let table = 0
    let left = st_counts[0]
    for (0 ..< n) |i| {
        if codes[i] == 0 {
            slot += 1
            starts[slot] = i + 1
            left -= 1
            if left == 0 and table + 1 < tables {
                table += 1
                slot = 1024 * table
                starts[slot] = i + 1
                left = st_counts[table]
            }
        }
    }
    st_table.text = Str.from_codes(codes, n)
    st_table.at = starts
    return starts
}

/// The tables' characters, and each table's count of strings.
vec st_build: I32
vec st_counts: I32

/// Add a string (its holes made bytes) to the tables.
fn st_put(text: Str) Void {
    let i = 0
    while (i < text.len()) {
        let c = text.get(i)
        let close = if c == 123 { text_index(text, "}", i) } else { -1 }
        let hole = if close > i and close - i < 8 { st_hole(text.slice(i + 1, close)) } else { 0 }
        if hole > 0 {
            st_build.push(hole)
            i = close + 1
        } else {
            if c < 32 and c != 9 and c != 10 {
                // (No control characters: they are holes.)
                fatal
            }
            st_build.push(c)
            i += 1
        }
    }
    st_build.push(0)
}

/// Add a diagnostic's templates, `sub` 0, 1, …, parted by byte 31.
fn st_put_part(text: Str, sub: I32) Void {
    if sub > 0 { st_build[st_build.len() - 1] = 31 }
    st_put(text)
}

/// A hole's byte, by its name, or 0.
fn st_hole(name: Str) I32 {
    let names = "0 1 2 3 . . . . w dym ta tb ia ib ic wa wb wc na nb da db dc node mem x y kind"
    let k = 0
    let at = 0
    while (at < names.len()) {
        let end_ = text_index(names, " ", at)
        if end_ < 0 { end_ = names.len() }
        if names.slice(at, end_) == name { return if k < 8 { k + 1 } else { k + 3 } }
        k += 1
        at = end_ + 1
    }
    return 0
}

//! == The tables
//!
//! Table k's string j is number `1024 * k + j`; each table's first number
//! is a constant here, which @st_end_table checks against its place.

/// Why a @comptime evaluation trapped, by its code (diag.utu).
let st_trap: I32 = 0
/// CSS properties, DOM events (wutu_parse.utu).
let st_web: I32 = 1024
/// Hints and notes (hints.utu).
let st_hints: I32 = 2048
/// Wutu's parser (wutu_parse.utu).
let st_wutu_parse: I32 = 3072
/// `@json`'s code and messages (json.utu).
let st_json: I32 = 4096
/// Wutu's code (wutu.utu).
let st_wutu: I32 = 5120
/// `@stored`'s code (stored.utu).
let st_stored: I32 = 6144
/// The language parts written as utu source (gen.utu).
let st_gen: I32 = 7168
/// `@ir`'s words and opcodes (ir.utu).
let st_ir: I32 = 8192
/// Host declarations (foreign.utu).
let st_foreign: I32 = 9216
/// Diagnostics' messages, by kind (diag.utu).
let st_diag: I32 = 10240
/// Diagnostics' labels, by kind (diag.utu).
let st_label: I32 = 11264
/// Diagnostic kinds' names, as stage 0 spells them (diag.utu).
let st_kind: I32 = 12288
/// The rest of diag.utu's.
let st_dg: I32 = 13312
/// Enum variants' names (below).
let st_prelude_name: I32 = 14336
let st_storage_name: I32 = 15360
let st_diag_name: I32 = 16384
let st_mem_method_name: I32 = 17408
let st_decl_kind_text: I32 = 18432
let st_node_name_of: I32 = 19456
let st_kw_name: I32 = 20480
let st_narrow_name: I32 = 21504
/// check.utu's.
let st_check: I32 = 22528
/// host.utu's (JavaScript glue).
let st_host: I32 = 23552
/// resolve.utu's.
let st_resolve: I32 = 24576
/// The smaller files' (@Sml, below).
let st_small: I32 = 25600

fn st_tables() Void {
    for (0 ..< 9) |k| { st_put(comptime_trap_src(k)) }
    st_end_table(st_trap)
    st_put(css_properties_text())
    st_put(dom_events_text())
    st_end_table(st_web)
    for (0 ..< Ht.count()) |k| { st_put(hs_src(Ht(k))) }
    st_end_table(st_hints)
    for (0 ..< Wpt.count()) |k| { st_put(wps_src(Wpt(k))) }
    st_end_table(st_wutu_parse)
    for (0 ..< Jst.count()) |k| { st_put(jss_src(Jst(k))) }
    st_end_table(st_json)
    for (0 ..< Wut.count()) |k| { st_put(wus_src(Wut(k))) }
    st_end_table(st_wutu)
    for (0 ..< Stt.count()) |k| { st_put(sts_src(Stt(k))) }
    st_end_table(st_stored)
    for (0 ..< Gnt.count()) |k| { st_put(gns_src(Gnt(k))) }
    st_end_table(st_gen)
    for (0 ..< Irt.count()) |k| { st_put(irs_src(Irt(k))) }
    st_end_table(st_ir)
    for (0 ..< Fgt.count()) |k| { st_put(fgs_src(Fgt(k))) }
    st_end_table(st_foreign)
    for (0 ..< Diag.count()) |k| {
        let parts = diag_text_src(Diag(k))
        for (0 ..< parts.len()) |sub| { st_put_part(parts[sub], sub) }
    }
    st_end_table(st_diag)
    for (0 ..< Diag.count()) |k| {
        let parts = diag_label_src(Diag(k))
        for (0 ..< parts.len()) |sub| { st_put_part(parts[sub], sub) }
    }
    st_end_table(st_label)
    for (0 ..< Diag.count()) |k| { st_put(diag_name_for_kind(Diag(k))) }
    st_end_table(st_kind)
    for (0 ..< Dgt.count()) |k| { st_put(dgs_src(Dgt(k))) }
    st_end_table(st_dg)
    for (0 ..< Prelude.count()) |k| { st_put(Prelude.name(Prelude(k))) }
    st_end_table(st_prelude_name)
    for (0 ..< Storage.count()) |k| { st_put(Storage.name(Storage(k))) }
    st_end_table(st_storage_name)
    for (0 ..< Diag.count()) |k| { st_put(Diag.name(Diag(k))) }
    st_end_table(st_diag_name)
    for (0 ..< MemMethod.count()) |k| { st_put(MemMethod.name(MemMethod(k))) }
    st_end_table(st_mem_method_name)
    for (0 ..< Decl.count()) |k| { st_put(Decl.name(Decl(k))) }
    st_end_table(st_decl_kind_text)
    for (0 ..< Node.count()) |k| { st_put(Node.name(Node(k))) }
    st_end_table(st_node_name_of)
    for (0 ..< Kw.count()) |k| { st_put(Kw.name(Kw(k))) }
    st_end_table(st_kw_name)
    for (0 ..< Narrow.count()) |k| { st_put(Narrow.name(Narrow(k))) }
    st_end_table(st_narrow_name)
    for (0 ..< Ckt.count()) |k| { st_put(cks_src(Ckt(k))) }
    st_end_table(st_check)
    for (0 ..< Hot.count()) |k| { st_put(hos_src(Hot(k))) }
    st_end_table(st_host)
    for (0 ..< Rst.count()) |k| { st_put(rss_src(Rst(k))) }
    st_end_table(st_resolve)
    for (0 ..< Sml.count()) |k| { st_put(sms_src(Sml(k))) }
    st_end_table(st_small)
}

/// The strings put since the last table: the table numbered from `first`.
fn st_end_table(first: I32) Void {
    // (Out of place, or past 1024 strings: a mistake here.)
    if first != 1024 * st_counts.len() { fatal }
    let before = 0
    for (0 ..< st_counts.len()) |k| { before += st_counts[k] }
    let count = 0
    for (0 ..< st_build.len()) |i| { if st_build[i] == 0 { count += 1 } }
    if count - before > 1024 { fatal }
    st_counts.push(count - before)
}

//! == Enum names
//!
//! A variant's name, as `.name()` gives it, from a table of each enum's (so
//! the names are not each a string constant of the compiler).

fn prelude_name(v: Prelude) Str => st(st_prelude_name + v.i32())
fn storage_name(v: Storage) Str => st(st_storage_name + v.i32())
fn diag_name(v: Diag) Str => st(st_diag_name + v.i32())
fn mem_method_name(v: MemMethod) Str => st(st_mem_method_name + v.i32())
fn decl_kind_text(v: Decl) Str => st(st_decl_kind_text + v.i32())
fn node_name_of(v: Node) Str => st(st_node_name_of + v.i32())
fn kw_name(v: Kw) Str => st(st_kw_name + v.i32())
fn narrow_name(v: Narrow) Str => st(st_narrow_name + v.i32())

//! == The smaller files' strings
//!
//! Those of closures, misc, protocols, mems, iterators, parse, lib, data,
//! types, strings, control, profile, dsl, generators, wasm, enums, and
//! validate (.utu), and their templates.

