fn sms_src(t: Sml) Str {
    return match t {
        Sml.ClT => "cl({0}: T)",
        Sml.ClosureCall => "closure_call_{0}",
        Sml.Closure => "closure",
        Sml.ClosureNew => "closure_new",
        Sml.ClosureNewDot => "closure.new",
        Sml.ClosureRec => "closure_rec",
        Sml.ClosureCallDot => "closure.call",
        Sml.ClosuresNew => "\"closures\":{\"new\":",
        Sml.Calls => ",\"calls\":[",
        Sml.Sigs => ",\"sigs\":[\"",
        Sml.QuoteCommaQuote => "\",\"",
        Sml.QuoteBracketEnd => "\"]",
        Sml.MaySuspend => "may suspend",
        Sml.AStackSuspendsOnlyThroughUtu => "A stack suspends only through utu's calls, not the host's; pass a function that does not await",
        Sml.Await => "await_{0}{1}",
        Sml.ForAValueUsePromote => "for a value, use promote",
        Sml.Promise => "Promise",
        Sml.Iterator => "iterator",
        Sml.Next => "next",
        Sml.Done => "done",
        Sml.Close => "close",
        Sml.Null => "null_",
        Sml.PromiseCatch => "promise_catch",
        Sml.PromiseThen => "promise_then",
        Sml.PromisesAwaits => "\"promises\":{\"awaits\":[",
        Sml.Ops => "],\"ops\":[",
        Sml.PromiseThenQuoteQuote => "\"promise_then\"",
        Sml.PromiseCatchQuoteQuote => "\"promise_catch\"",
        Sml.AsyncExports => "],\"asyncExports\":[",
        Sml.BracketEndBraceEnd => "]}",
        Sml.Any => "any {0}",
        Sml.ADotB => "{0}.{1}",
        Sml.Mod => "mod {0}[",
        Sml.ABracket => "{0}[",
        Sml.ACommaSpace => "{0}, ",
        Sml.ABracketEnd => "{0}]",
        Sml.BoundBy => "bound {0} by {1}",
        Sml.BracketABracketEnd => "[{0}]",
        Sml.IsUnbounded => "{0} is unbounded",
        Sml.No => "no {0}",
        Sml.Needs => "needs {0}",
        Sml.BoundIt => "bound it: {0}",
        Sml.DoesNotMatch => "{0} does not match",
        Sml.ItsIsNotS => "its {0} is not {1}'s",
        Sml.ImplementIt => "implement it: {0}",
        Sml.AField => "a field {0}: {1}",
        Sml.FnA => "fn {0}[{1}].{2} |a| (",
        Sml.ABColonSpaceC => "{0}{1}: {2}",
        Sml.ACloseSpaceBSpaceBraceSpaceEllipsisSpaceBraceEnd => "{0}) {1} { … }",
        Sml.Bcdefgh => "bcdefgh",
        Sml.Mem => "mem_{0}",
        Sml.MemCopyIn => "mem_copy_in_{0}",
        Sml.MemView => "mem_view_{0}",
        Sml.NameKindHostTrue => "{\"name\":\"{0}\",\"kind\":\"{1}\",\"host\":true}",
        Sml.Start => "start",
        Sml.MemSet => "mem.set",
        Sml.MemReserve => "mem.reserve",
        Sml.MemGrow => "mem.grow",
        Sml.MemPush => "mem.push",
        Sml.MemResize => "mem.resize",
        Sml.Vec => "vec",
        Sml.MemLc => "mem",
        Sml.Mems => "\"mems\":[",
        Sml.ParenthesizeThePipelineAXsAll => "Parenthesize the pipeline: a {0} (xs all |x| { … })",
        Sml.U32 => "u32",
        Sml.U64 => "u64",
        Sml.Len => "len",
        Sml.Abs => "abs",
        Sml.Sqrt => "sqrt",
        Sml.Min => "min",
        Sml.Max => "max",
        Sml.Piped => "piped",
        Sml.TheSourceMeant => "the source meant?",
        Sml.EndsHere => "ends here",
        Sml.CannotFollow => "cannot follow",
        Sml.Group => "Group",
        Sml.ATickBTick => "{0}'{1}'",
