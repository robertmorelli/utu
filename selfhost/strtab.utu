fn sms_src(t: Sml) Str {
    return match t {
        Sml.ClT => "cl({0}: T)",
        Sml.ClosureCall => "closure_call_{0}",
        Sml.Closure => "closure",
        Sml.ClosureNew => "closure_new",
        Sml.ClosureNewDot => "closure.new",
        Sml.ClosureRec => "closure_rec",
        Sml.ClosureCallDot => "closure.call",
        Sml.ClosuresNew => "\"closures\":{\"new\":",
        Sml.Calls => ",\"calls\":[",
        Sml.Sigs => ",\"sigs\":[\"",
        Sml.QuoteCommaQuote => "\",\"",
        Sml.QuoteBracketEnd => "\"]",
        Sml.MaySuspend => "may suspend",
        Sml.AStackSuspendsOnlyThroughUtu => "A stack suspends only through utu's calls, not the host's; pass a function that does not await",
        Sml.Await => "await_{0}{1}",
        Sml.ForAValueUsePromote => "for a value, use promote",
        Sml.Promise => "Promise",
        Sml.Iterator => "iterator",
        Sml.Next => "next",
        Sml.Done => "done",
        Sml.Close => "close",
        Sml.Null => "null_",
        Sml.PromiseCatch => "promise_catch",
        Sml.PromiseThen => "promise_then",
        Sml.PromisesAwaits => "\"promises\":{\"awaits\":[",
        Sml.Ops => "],\"ops\":[",
        Sml.PromiseThenQuoteQuote => "\"promise_then\"",
        Sml.PromiseCatchQuoteQuote => "\"promise_catch\"",
        Sml.AsyncExports => "],\"asyncExports\":[",
        Sml.BracketEndBraceEnd => "]}",
        Sml.Any => "any {0}",
        Sml.ADotB => "{0}.{1}",
        Sml.Mod => "mod {0}[",
        Sml.ABracket => "{0}[",
        Sml.ACommaSpace => "{0}, ",
        Sml.ABracketEnd => "{0}]",
        Sml.BoundBy => "bound {0} by {1}",
        Sml.BracketABracketEnd => "[{0}]",
        Sml.IsUnbounded => "{0} is unbounded",
        Sml.No => "no {0}",
        Sml.Needs => "needs {0}",
        Sml.BoundIt => "bound it: {0}",
        Sml.DoesNotMatch => "{0} does not match",
        Sml.ItsIsNotS => "its {0} is not {1}'s",
        Sml.ImplementIt => "implement it: {0}",
        Sml.AField => "a field {0}: {1}",
        Sml.FnA => "fn {0}[{1}].{2} |a| (",
        Sml.ABColonSpaceC => "{0}{1}: {2}",
        Sml.ACloseSpaceBSpaceBraceSpaceEllipsisSpaceBraceEnd => "{0}) {1} { … }",
        Sml.Bcdefgh => "bcdefgh",
        Sml.Mem => "mem_{0}",
        Sml.MemCopyIn => "mem_copy_in_{0}",
        Sml.MemView => "mem_view_{0}",
        Sml.NameKindHostTrue => "{\"name\":\"{0}\",\"kind\":\"{1}\",\"host\":true}",
        Sml.Start => "start",
        Sml.MemSet => "mem.set",
        Sml.MemReserve => "mem.reserve",
        Sml.MemGrow => "mem.grow",
        Sml.MemPush => "mem.push",
        Sml.MemResize => "mem.resize",
        Sml.Vec => "vec",
        Sml.MemLc => "mem",
        Sml.Mems => "\"mems\":[",
        Sml.ParenthesizeThePipelineAXsAll => "Parenthesize the pipeline: a {0} (xs all |x| { … })",
        Sml.U32 => "u32",
        Sml.U64 => "u64",
        Sml.Len => "len",
        Sml.Abs => "abs",
        Sml.Sqrt => "sqrt",
        Sml.Min => "min",
        Sml.Max => "max",
        Sml.Piped => "piped",
        Sml.TheSourceMeant => "the source meant?",
        Sml.EndsHere => "ends here",
        Sml.CannotFollow => "cannot follow",
        Sml.Group => "Group",
        Sml.ATickBTick => "{0}'{1}'",
        Sml.Or => " or ",
        Sml.EndOfFile => "end of file",
        Sml.ACharacter => "a character",
        Sml.AName => "a name",
        Sml.AnInteger => "an integer",
        Sml.ANumber => "a number",
        Sml.AString => "a string",
        Sml.BackslashBackslash => "\\\\",
        Sml.SlashBackslash => "/\\",
        Sml.ATemplateString => "a template string",
        Sml.Open => "(",
        Sml.Semi => ";",
        Sml.At => "@",
        Sml.Dollar => "$",
        Sml.DotDotDot => "...",
        Sml.DotDotLt => "..<",
        Sml.BarEq => "|=",
        Sml.Amp => "&",
        Sml.AmpEq => "&=",
        Sml.Caret => "^",
        Sml.CaretEq => "^=",
        Sml.Star => "*",
        Sml.StarEq => "*=",
        Sml.Slash => "/",
        Sml.SlashEq => "/=",
        Sml.Pct => "%",
        Sml.PctEq => "%=",
        Sml.Plus => "+",
        Sml.PlusEq => "+=",
        Sml.DashEq => "-=",
        Sml.Lt => "<",
        Sml.LtEq => "<=",
        Sml.LtLt => "<<",
        Sml.LtLtEq => "<<=",
        Sml.Gt => ">",
        Sml.GtEq => ">=",
        Sml.GtGt => ">>",
        Sml.GtGtEq => ">>=",
        Sml.GtGtGt => ">>>",
        Sml.GtGtGtEq => ">>>=",
        Sml.BangEq => "!=",
        Sml.QDot => "?.",
        Sml.Lazy => "lazy",
        Sml.RefNullType => "(ref null type {0})",
        Sml.RefType => "(ref type {0})",
        Sml.Value => "value {0}",
        Sml.Test => "test",
        Sml.Bench => "bench",
        Sml.V128 => "v128",
        Sml.RefNullExtern => "(ref null extern)",
        Sml.RefExtern => "(ref extern)",
        Sml.RefNullI31 => "(ref null i31)",
        Sml.RefNullFunc => "(ref null func)",
        Sml.RefNullEq => "(ref null eq)",
        Sml.RefNullAny => "(ref null any)",
        Sml.Unreachable => "unreachable",
        Sml.DeclaredHere => "declared here",
        Sml.Bytes => "bytes",
        Sml.N3 => "3",
        Sml.Ee => "ee",
        Sml.Xx => "xx",
        Sml.Ss => "ss",
        Sml.S => "s",
        Sml.Sii => "sii",
        Sml.Rii => "rii",
        Sml.Si => "si",
        Sml.Ci => "ci",
        Sml.Ri => "ri",
        Sml.RiStar => "ri*",
        Sml.Ririi => "ririi",
        Sml.I => "i*",
        Sml.ArraySlice => "array.slice",
        Sml.StrFromCodes => "Str.from_codes",
        Sml.Stream => "Stream",
        Sml.WasmI32 => "wasm-i32",
        Sml.WasmI64 => "wasm-i64",
        Sml.WasmF32 => "wasm-f32",
        Sml.WasmF64 => "wasm-f64",
        Sml.WasmV128 => "wasm-v128",
        Sml.WasmExternref => "wasm-externref",
        Sml.WasmStringref => "wasm-stringref",
        Sml.WasmI31 => "wasm-i31",
        Sml.WasmArrayElem => "wasm-array:elem=",
        Sml.MutTrue => ":mut=true",
        Sml.Concat => "concat",
        Sml.Equals => "equals",
        Sml.Length => "length",
        Sml.Substring => "substring",
        Sml.CharCodeAt => "charCodeAt",
        Sml.FromCodePoint => "fromCodePoint",
        Sml.FromCharCodeArray => "fromCharCodeArray",
        Sml.WasmJsString => "wasm:js-string",
        Sml.TryReturnsTheErrorAsIt => "try returns the error as it is, unconverted",
        Sml.Slice => "slice",
        Sml.GetSlice => "get_slice",
        Sml.NewDefault => "new_default",
        Sml.CopyFrom => "copy_from",
        Sml.Push => "push",
        Sml.ClosureIn => "closure in {0}",
        Sml.ASpaceB => "{0} {1}",
        Sml.ABracketBBracketEnd => "{0}[{1}]",
        Sml.UtuProfile => "utu_profile",
        Sml.Profile => "profile",
        Sml.Resume => "resume",
        Sml.Park => "park",
        Sml.TopLevel => "(top level)",
        Sml.FnExpansionVoid => "fn __expansion() Void { {0}; }",
        Sml.Splice => "__splice_{0}",
        Sml.Css => "css",
        Sml.Wutu => "wutu",
        Sml.Stored => "stored",
        Sml.Json => "json",
        Sml.Splice2 => "__splice_",
        Sml.AMethodGeneratorCannotConsumeItself => "a method generator cannot consume itself",
        Sml.Comptime => "__comptime_",
        Sml.JsTag => "js_tag",
        Sml.To => "to_{0}",
        Sml.EnumName => "enum.name",
        Sml.TheParameter => "the parameter",
    }
}

fn sms(t: Sml) Str => st(st_small + t.i32())
fn sms1(t: Sml, a: Str) Str => stf(st_small + t.i32(), a, "", "", "")
fn sms2(t: Sml, a: Str, b: Str) Str => stf(st_small + t.i32(), a, b, "", "")
fn sms3(t: Sml, a: Str, b: Str, c: Str) Str => stf(st_small + t.i32(), a, b, c, "")
