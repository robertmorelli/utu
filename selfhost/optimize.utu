//! = Local cleanup
//!
//! Stage 0's `wasm/optimize.js`, for size and speed builds. Lowerings leave
//! copies and temporaries a hand-written program would not have (a
//! generator's parameters bound to the call's arguments, each `yield`'s value
//! held for the consumer). Four rewrites remove them, in each function:
//!
//! / copies: a local set once, to a parameter never assigned, is that
//!   parameter: its reads read the parameter.
//! / temporaries: a local set once to a pure value and read once in the next
//!   statement, outside any loop and before anything assigns what the value
//!   reads, is that value: it moves to the read.
//! / tees: a local stored and then read first by the next statement is
//!   stored there, by a tee (two bytes fewer).
//! / unused: a local never read is not stored (its value is kept, and
//!   dropped, when it has effects), and is no longer declared.
//! / coalescing: locals of one type whose live ranges do not overlap share
//!   one, and the locals are declared grouped by type (one run each).
//! / loads (size builds): a field read of a local, read again twice or more
//!   where nothing can have changed it, is kept in a local.
//! / logic (size builds): `a and b`, `a or b` whose b is cheap, pure and
//!   cannot trap are `i32.and`, `i32.or`, no `if`; a range test of one local
//!   against constants is one unsigned comparison.
//!
//! So a consumed generator compiles to what the equivalent loop compiles to.
//! Every local codegen makes is set before it is read, which is what makes
//! the first two sound. Nodes are rewritten in place: a store removed is an
//! empty Seq, which emits nothing.

/// The function's nodes, in walk order, each with its parent and its place there.
vec opt_nodes: I32;
vec opt_parent: I32;
vec opt_place: I32;
/// By local: its reads.
vec opt_gets: I32;
/// By local: its writes.
vec opt_sets: I32;
/// By local: the position (in @opt_nodes) of a read.
vec opt_get_at: I32;
/// By local: the position of a write.
vec opt_set_at: I32;
/// The locals a value being sunk reads.
vec opt_reads: I32;
/// The Seqs, Blocks and Loops of @opt_nodes, in its order.
vec opt_blocks: I32;
/// Whether a node of the walk is held in more than one place.
vec opt_shared: U8 = [0];
/// By local: its index once unused locals are gone.
vec opt_renumber: I32;

/// The cleanup, over each live function with a body, after the sweep.
fn optimize_module() void {
    for (0 ..< func_kind.len()) |f| { if optimizable(f) { optimize_function(f); }; };
}

fn optimizable(f: I32) Bool { func_kind[f] == FuncKind.Defined.to_i32() and func_live[f] == 1 and func_body[f] >= 0; }

/// Copies and temporaries until neither changes anything, then tees, then
/// unused locals. A body sharing a node with another is left as it is.
fn optimize_function(f: I32) void {
    let params = vl_len[ht_a[func_type_of[f]]];
    let total = params + func_local_count[f];
    opt_collect(f, total);
    // A node held in two places (in one body or two; see sweep) would be
    // rewritten for both, so a body with one is left as it is.
    if opt_shared[0] == 1 { return; };
    // The rewrites keep the counts, and each local's one read or write
    // (with its parent), as a new walk would find them. None moves a block,
    // so the blocks stay in the walk's order.
    while (propagate_copies(params) or sink_temporaries(params)) {};
    if optimize_level[0] == 1 and reuse_loads(f) {
        total = params + func_local_count[f];
        opt_collect(f, total);
    };
    if optimize_level[0] == 1 and fold_logic() { opt_collect(f, total); };
    tee_stores();
    remove_unused_locals(f, params, total);
    coalesce_locals(f, params);
}

/// Walk the body, noting each node's parent, and each local's reads and writes.
fn opt_collect(f: I32, total: I32) void {
    opt_nodes.clear();
    opt_parent.clear();
    opt_place.clear();
    opt_gets.resize(total);
    opt_sets.resize(total);
    opt_get_at.resize(total);
    opt_set_at.resize(total);
    for (0 ..< total) |l| {
        opt_gets[l] = 0;
        opt_sets[l] = 0;
    };
    opt_blocks.clear();
    opt_shared[0] = 0;
    opt_nodes.push(func_body[f]);
    opt_parent.push(-1);
    opt_place.push(-1);
    let k = 0;
    while (k < opt_nodes.len()) {
        let node = opt_nodes[k];
        let op = w_op[node];
        if node_holders[node] != 1 { opt_shared[0] = 1; };
        if op == Op.LocalGet.to_i32() {
            opt_gets[w_a[node]] += 1;
            opt_get_at[w_a[node]] = k;
        } else if op == Op.LocalSet.to_i32() or op == Op.LocalTee.to_i32() {
            opt_sets[w_a[node]] += 1;
            opt_set_at[w_a[node]] = k;
        } else if op == Op.Seq.to_i32() or op == Op.Block.to_i32() or op == Op.Loop.to_i32() {
            opt_blocks.push(node);
        };
        for (0 ..< w_count[node]) |i| {
            opt_nodes.push(w_kid(node, i));
            opt_parent.push(node);
            opt_place.push(i);
        };
        k += 1;
    };
}

/// Computes a value without effects or traps, reading at most locals.
fn opt_pure(node: I32) Bool {
    let op = w_op[node];
    if op == Op.I32Const.to_i32() or op == Op.I64Const.to_i32() or op == Op.F32Const.to_i32() or op == Op.F64Const.to_i32()
        or op == Op.LocalGet.to_i32() or op == Op.RefNull.to_i32() or op == Op.RefFunc.to_i32() or op == Op.Nop.to_i32() {
        return true;
    };
    // An immutable field of a reference that cannot be null (a closure's
    // capture, from its environment) neither traps nor changes.
    let immutable_read = (op == Op.StructGet.to_i32() or op == Op.StructGetS.to_i32() or op == Op.StructGetU.to_i32())
        and ht_fields[ht_a[w_a[node]] + w_b[node] * 2 + 1] == 0 and non_null(w_type[w_kid(node, 0)]);
    let ok = op == Op.RefIsNull.to_i32() or op == Op.RefEq.to_i32() or op == Op.RefI31.to_i32() or op == Op.I31GetS.to_i32()
        or op == Op.I31GetU.to_i32() or op == Op.Select.to_i32() or (op == Op.Plain.to_i32() and pure_opcode(w_a[node])) or immutable_read;
    if not ok { return false; };
    for (0 ..< w_count[node]) |i| { if not opt_pure(w_kid(node, i)) { return false; }; };
    true;
}

/// A numeric instruction that cannot trap (not a division, remainder, or
/// float-to-integer truncation).
fn pure_opcode(code: I32) Bool {
    if code < 69 or code > 196 { return false; };
    if code >= 109 and code <= 112 { return false; };
    if code >= 127 and code <= 130 { return false; };
    if code >= 168 and code <= 171 { return false; };
    if code >= 174 and code <= 177 { return false; };
    true;
}

fn non_null(vt: I32) Bool { vt == vt_extern or (vt >= vt_defined and vt < vt_tuple and (vt - vt_defined) % 2 == 1); }

fn single_value(vt: I32) Bool { vt != vt_none and vt != vt_unreachable and vt < vt_tuple; }

fn set_kid(parent: I32, place: I32, node: I32) void { w_kids[w_first[parent] + place] = node; }

/// Make node `n` emit nothing.
fn opt_erase(n: I32) void {
    w_op[n] = Op.Seq.to_i32();
    w_type[n] = vt_none;
    w_count[n] = 0;
}

/// By local: the parameter its reads read instead, or -1; and that read's type.
vec opt_copy_of: I32;
vec opt_copy_type: I32;

/// The copies rewrite: whether anything changed. Each local is settled in
/// order (a copy of a copy settled before it is a copy of that parameter),
/// then one walk rewrites every read.
fn propagate_copies(params: I32) Bool {
    let changed = false;
    opt_copy_of.resize(opt_gets.len());
    opt_copy_type.resize(opt_gets.len());
    for (0 ..< opt_gets.len()) |l| { opt_copy_of[l] = -1; };
    for (params ..< opt_gets.len()) |l| {
        if opt_sets[l] == 1 {
            let write = opt_nodes[opt_set_at[l]];
            let source = if w_count[write] == 1 { w_kid(write, 0); } else { -1; };
            if w_op[write] == Op.LocalSet.to_i32() and source >= 0 and w_op[source] == Op.LocalGet.to_i32() {
                let p = w_a[source];
                let t = w_type[source];
                if p >= params and p < l and opt_copy_of[p] >= 0 {
                    t = opt_copy_type[p];
                    p = opt_copy_of[p];
                };
                if p < params and opt_sets[p] == 0 and single_value(t) {
                    opt_copy_of[l] = p;
                    opt_copy_type[l] = t;
                    changed = true;
                };
            };
        };
    };
    // (No copy: no walk.)
    if not changed { return false; };
    changed = false;
    for (0 ..< opt_nodes.len()) |k| {
        let n = opt_nodes[k];
        if w_op[n] == Op.LocalGet.to_i32() and opt_copy_of[w_a[n]] >= 0 {
            let l = w_a[n];
            w_a[n] = opt_copy_of[l];
            w_type[n] = opt_copy_type[l];
            opt_gets[l] -= 1;
            opt_gets[w_a[n]] += 1;
            opt_get_at[w_a[n]] = k;
            changed = true;
        };
    };
    changed;
}

/// The temporaries rewrite, within each Seq or Block (a store and the
/// statement after it): whether anything changed.
fn sink_temporaries(params: I32) Bool {
    let changed = false;
    for (0 ..< opt_blocks.len()) |b| {
        let block = opt_blocks[b];
        let op = w_op[block];
        if op == Op.Seq.to_i32() or op == Op.Block.to_i32() {
            let i = 0;
            while (i + 1 < w_count[block]) {
                let write = w_kid(block, i);
                let l = w_a[write];
                if w_op[write] == Op.LocalSet.to_i32() and w_count[write] == 1 and l >= params and opt_sets[l] == 1 and opt_gets[l] == 1 {
                    let value = w_kid(write, 0);
                    let at = opt_get_at[l];
                    let read = opt_nodes[at];
                    if opt_pure(value) and single_value(w_type[value]) and opt_parent[at] >= 0 {
                        opt_reads.clear();
                        reads_of(value);
                        if sink_visit(w_kid(block, i + 1), read, false) == 1 {
                            set_kid(opt_parent[at], opt_place[at], value);
                            opt_erase(write);
                            opt_gets[l] = 0;
                            opt_sets[l] = 0;
                            changed = true;
                            // The value's own read (if it is one) now sits where the sunk read was.
                            if w_op[value] == Op.LocalGet.to_i32() and opt_gets[w_a[value]] == 1 {
                                let v = opt_get_at[w_a[value]];
                                opt_parent[v] = opt_parent[at];
                                opt_place[v] = opt_place[at];
                            };
                        };
                    };
                };
                i += 1;
            };
        };
    };
    changed;
}

/// `local.set x (v)` then a statement whose first instruction is
/// `local.get x` is `local.tee x (v)` there. When that was the local's one
/// read, it is then never read, and the value takes the tee's place
/// (@remove_unused_locals).
///
/// A tee moves the store into the next statement, which may be a store
/// teed into the one after: a run of them nests, statement in statement, so
/// a run stops at @tee_run_max (which code generation's recursion bears).
fn tee_stores() Bool {
    let changed = false;
    for (0 ..< opt_blocks.len()) |b| {
        let block = opt_blocks[b];
        let op = w_op[block];
        if op == Op.Seq.to_i32() or op == Op.Block.to_i32() or op == Op.Loop.to_i32() {
            let run = 0;
            for (0 ..< w_count[block]) |i| {
                let write = w_kid(block, i);
                // (What emits nothing is passed over, as by tee_into.)
                if w_op[write] == Op.LocalSet.to_i32() and w_count[write] == 1 and run < tee_run_max and tee_into(block, i + 1, write) {
                    changed = true;
                    run += 1;
                } else if not emits_nothing(write) {
                    run = 0;
                };
            };
        };
    };
    changed;
}

/// The longest run of stores teed one into the next.
let tee_run_max: I32 = 64;

/// Whether the first instruction from kid `from` of `parent` on reads what
/// `write` (kid `from - 1`) stores: the read becomes the tee, and the store
/// nothing.
fn tee_into(parent: I32, from: I32, write: I32) Bool {
    let holder = parent;
    let place = from;
    while (true) {
        // Kids that emit nothing are passed over.
        while (place < w_count[holder] and emits_nothing(w_kid(holder, place))) { place += 1; };
        if place >= w_count[holder] { return false; };
        let node = w_kid(holder, place);
        let op = w_op[node];
        if op == Op.LocalGet.to_i32() {
            if w_a[node] != w_a[write] { return false; };
            set_kid(holder, place, write);
            w_op[write] = Op.LocalTee.to_i32();
            w_type[write] = w_type[node];
            opt_gets[w_a[write]] -= 1;
            // The read is now nothing, where the store was.
            opt_erase(node);
            set_kid(parent, from - 1, node);
            return true;
        };
        // A block's contents come after its opcode, which a value cannot cross.
        if op == Op.Block.to_i32() or op == Op.Loop.to_i32() or op == Op.Try.to_i32() or op == Op.NullElse.to_i32() or w_count[node] == 0 { return false; };
        holder = node;
        place = 0;
    };
    false;
}

/// Whether a node is only empty Seqs (what a removed store leaves).
fn emits_nothing(node: I32) Bool {
    if w_op[node] != Op.Seq.to_i32() { return false; };
    for (0 ..< w_count[node]) |i| { if not emits_nothing(w_kid(node, i)) { return false; }; };
    true;
}

/// The locals `node` reads, into @opt_reads.
fn reads_of(node: I32) void {
    if w_op[node] == Op.LocalGet.to_i32() { opt_reads.push(w_a[node]); };
    for (0 ..< w_count[node]) |i| { reads_of(w_kid(node, i)); };
}

/// Whether `target` is reached in `node` (1) before anything assigns a local
/// the value reads, and not inside a loop (where the value would be computed
/// each time round); 2 when it cannot be, 0 when it is not there.
fn sink_visit(node: I32, target: I32, in_loop: Bool) I32 {
    if node == target { return if in_loop { 2; } else { 1; }; };
    let looping = in_loop or w_op[node] == Op.Loop.to_i32();
    for (0 ..< w_count[node]) |i| {
        let r = sink_visit(w_kid(node, i), target, looping);
        if r != 0 { return r; };
    };
    let op = w_op[node];
    if op == Op.LocalSet.to_i32() or op == Op.LocalTee.to_i32() {
        for (0 ..< opt_reads.len()) |i| { if opt_reads[i] == w_a[node] { return 2; }; };
    };
    0;
}

/// The unused rewrite: each store to a local never read goes (or becomes a
/// drop, or its value), and the locals still read are renumbered.
fn remove_unused_locals(f: I32, params: I32, total: I32) void {
    let first = func_locals[f];
    let kept = 0;
    opt_renumber.resize(total);
    for (0 ..< total) |l| { opt_renumber[l] = l; };
    for (params ..< total) |l| {
        opt_renumber[l] = -1;
        if opt_gets[l] > 0 {
            opt_renumber[l] = params + kept;
            local_types[first + kept] = local_types[first + l - params];
            kept += 1;
        };
    };
    // (Every local read: nothing goes, nothing is renumbered.)
    if kept == total - params { return; };
    func_local_count[f] = kept;
    unused_walk(f, func_body[f], -1, 0, params);
}

/// The unused rewrite under `n`, kid `place` of `parent`: inner stores first
/// (one moved out of its parent would leave what it holds a stale parent).
fn unused_walk(f: I32, n: I32, parent: I32, place: I32, params: I32) void {
    for (0 ..< w_count[n]) |i| { unused_walk(f, w_kid(n, i), n, i, params); };
    let op = w_op[n];
    if (op == Op.LocalSet.to_i32() or op == Op.LocalTee.to_i32()) and w_a[n] >= params and opt_gets[w_a[n]] == 0 {
        // A store with no operand takes its value from the stack (a
        // multi-value result, taken apart): it is dropped there.
        if w_count[n] == 0 {
            // (A tee would leave it there: it is nothing.)
            if op == Op.LocalTee.to_i32() { opt_erase(n); } else { w_op[n] = Op.Drop.to_i32(); };
            return;
        };
        let value = w_kid(n, 0);
        if op == Op.LocalSet.to_i32() and opt_pure(value) {
            opt_erase(n);
        } else if op == Op.LocalSet.to_i32() and single_value(w_type[value]) {
            w_op[n] = Op.Drop.to_i32();
        } else if parent >= 0 {
            set_kid(parent, place, value);
        } else {
            func_body[f] = value;
        };
        return;
    };
    if op == Op.LocalGet.to_i32() or op == Op.LocalSet.to_i32() or op == Op.LocalTee.to_i32() { w_a[n] = opt_renumber[w_a[n]]; };
}

//! = Coalescing

/// By local: its first and last mention, in the order the code runs
/// (positions of the walk), and whether the first stores it.
vec co_first: I32;
vec co_last: I32;
vec co_store_first: I32;
/// By local: the outermost loop around its first and its last mention, or -1.
vec co_loop_first: I32;
vec co_loop_last: I32;
/// By loop (in the order they start): the positions it spans.
vec co_loop_start: I32;
vec co_loop_end: I32;
/// The loops around the walk, outermost first.
vec co_loops: I32;
/// The nodes that read or write a local.
vec co_mentions: I32;
vec co_pos: I32 = [0];
/// The slots locals share: each one's type, the end of the range it holds
/// last, and the next slot of its type.
vec co_slot_type: I32;
vec co_slot_end: I32;
vec co_slot_next: I32;
/// The slots' types, in the order they first appear, with each one's first
/// and last slot.
vec co_types: I32;
vec co_type_head: I32;
vec co_type_tail: I32;
/// Scratch for sorting.
vec co_sort: I32;

/// Share locals whose ranges do not overlap: a local is live from its first
/// mention to its last, and a mention inside a loop makes it live through
/// the whole outermost loop around it (its value may come round). A local is
/// only moved into another's when its first mention stores it: one read
/// first would rely on starting at zero.
fn coalesce_locals(f: I32, params: I32) void {
    let n = func_local_count[f];
    if n < 2 { return; };
    let total = params + n;
    co_first.resize(total);
    co_last.resize(total);
    co_store_first.resize(total);
    co_loop_first.resize(total);
    co_loop_last.resize(total);
    for (0 ..< total) |l| {
        co_first[l] = -1;
        co_loop_first[l] = -1;
        co_loop_last[l] = -1;
    };
    co_loop_start.clear();
    co_loop_end.clear();
    co_loops.clear();
    co_mentions.clear();
    co_pos[0] = 0;
    co_walk(func_body[f]);
    // Each local's range, and the slot it takes: the first of its type free
    // by then (locals in the order their ranges start).
    let start = Array[I32].new(total, 0);
    let end = Array[I32].new(total, 0);
    for (params ..< total) |l| {
        start[l] = co_first[l];
        end[l] = co_last[l];
        if co_loop_first[l] >= 0 and co_loop_start[co_loop_first[l]] < start[l] { start[l] = co_loop_start[co_loop_first[l]]; };
        if co_loop_last[l] >= 0 and co_loop_end[co_loop_last[l]] > end[l] { end[l] = co_loop_end[co_loop_last[l]]; };
    };
    let order = Array[I32].new(n, 0);
    for (0 ..< n) |i| { order[i] = params + i; };
    sort_by_key(order, start);
    let first = func_locals[f];
    let slot_of = Array[I32].new(total, -1);
    co_slot_type.clear();
    co_slot_end.clear();
    co_slot_next.clear();
    co_types.clear();
    co_type_head.clear();
    co_type_tail.clear();
    for (order) |l| {
        let vt = local_types[first + l - params];
        let t = 0;
        while (t < co_types.len() and co_types[t] != vt) { t += 1; };
        if t == co_types.len() {
            co_types.push(vt);
            co_type_head.push(-1);
            co_type_tail.push(-1);
        };
        let slot = -1;
        if co_first[l] >= 0 and co_store_first[l] == 1 {
            let s = co_type_head[t];
            while (s >= 0 and slot < 0) {
                if co_slot_end[s] < start[l] { slot = s; };
                s = co_slot_next[s];
            };
        };
        if slot < 0 {
            slot = co_slot_type.len();
            co_slot_type.push(vt);
            co_slot_end.push(end[l]);
            co_slot_next.push(-1);
            if co_type_tail[t] >= 0 { co_slot_next[co_type_tail[t]] = slot; } else { co_type_head[t] = slot; };
            co_type_tail[t] = slot;
        } else {
            co_slot_end[slot] = end[l];
        };
        slot_of[l] = slot;
    };
    // The slots, declared grouped by type (in the order types first appear).
    let count = co_slot_type.len();
    let index = Array[I32].new(count, -1);
    let next = 0;
    for (0 ..< co_types.len()) |t| {
        let s = co_type_head[t];
        while (s >= 0) {
            index[s] = next;
            next += 1;
            s = co_slot_next[s];
        };
    };
    let grouped = count < n;
    for (0 ..< count) |s| { if index[s] != s { grouped = true; }; };
    if not grouped { return; };
    for (0 ..< count) |s| { local_types[first + index[s]] = co_slot_type[s]; };
    func_local_count[f] = count;
    for (0 ..< co_mentions.len()) |k| {
        let node = co_mentions[k];
        if w_a[node] >= params { w_a[node] = params + index[slot_of[w_a[node]]]; };
    };
}

/// Sort `order` by `key` (of each item), keeping the order of equal ones (a
/// merge sort).
fn sort_by_key(order: Array[I32], key: Array[I32]) void {
    let n = order.len();
    co_sort.resize(n);
    let width = 1;
    while (width < n) {
        let lo = 0;
        while (lo < n) {
            let mid = if lo + width < n { lo + width; } else { n; };
            let hi = if mid + width < n { mid + width; } else { n; };
            let i = lo;
            let j = mid;
            let k = lo;
            while (k < hi) {
                if j >= hi or (i < mid and key[order[i]] <= key[order[j]]) {
                    co_sort[k] = order[i];
                    i += 1;
                } else {
                    co_sort[k] = order[j];
                    j += 1;
                };
                k += 1;
            };
            lo = hi;
        };
        for (0 ..< n) |k| { order[k] = co_sort[k]; };
        width = width * 2;
    };
}

/// Number the nodes in the order they run (operands first), noting each
/// local's mentions and each loop's span.
fn co_walk(node: I32) void {
    let op = w_op[node];
    let span = -1;
    if op == Op.Loop.to_i32() {
        span = co_loop_start.len();
        co_loop_start.push(co_pos[0]);
        co_loop_end.push(-1);
        co_loops.push(span);
    };
    for (0 ..< w_count[node]) |i| { co_walk(w_kid(node, i)); };
    let at = co_pos[0];
    co_pos[0] = at + 1;
    if op == Op.LocalGet.to_i32() or op == Op.LocalSet.to_i32() or op == Op.LocalTee.to_i32() {
        let l = w_a[node];
        co_mentions.push(node);
        if co_first[l] < 0 {
            co_first[l] = at;
            co_store_first[l] = if op == Op.LocalGet.to_i32() { 0; } else { 1; };
            if co_loops.len() > 0 { co_loop_first[l] = co_loops[0]; };
        };
        co_last[l] = at;
        if co_loops.len() > 0 { co_loop_last[l] = co_loops[0]; };
    };
    if span >= 0 {
        co_loop_end[span] = at;
        co_loops.resize(co_loops.len() - 1);
    };
}

//! = Logic
//!
//! `a and b` is built as `if a { b } else { false }`. When b is a few
//! instructions that neither trap nor have effects, running it either way
//! is the same: `a b i32.and` (`a b i32.or`), five bytes fewer. That needs a
//! and b to be 0 or 1: an `if` marks (@w_b) a condition that is a Bool (1)
//! and values that are (2); else they must be comparisons. `if c { true }
//! else { false }` is c. Then `x >= lo and x <= hi`, x a local and lo, hi
//! constants, is `x - lo <u hi - lo + 1` (`x == lo` when they are one);
//! `x < lo or x > hi` its opposite.

/// Fold each `if` of the function's walk, operands first. Whether any changed.
fn fold_logic() Bool {
    let changed = false;
    let k = opt_nodes.len();
    while (k > 0) {
        k -= 1;
        let n = opt_nodes[k];
        if w_op[n] == Op.If.to_i32() and w_type[n] == vt_i32 and w_count[n] == 3 and fold_if(n) { changed = true; };
    };
    changed;
}

fn fold_if(n: I32) Bool {
    let c = w_kid(n, 0);
    let x = seq_value(w_kid(n, 1));
    let y = seq_value(w_kid(n, 2));
    if x < 0 or y < 0 { return false; };
    if not ((w_b[n] & 1) == 1 or bool_valued(c)) { return false; };
    if is_const(x, 1) and is_const(y, 0) { return relink(n, Op.Seq, 0, c, -1); };
    if is_const(x, 0) and is_const(y, 1) { return relink(n, Op.Plain, i32_eqz, c, -1); };
    // `if c { x } else { 0 }` is c and x; `if c { 1 } else { y }`, c or y.
    let and_ = is_const(y, 0);
    let other = if and_ { x; } else if is_const(x, 1) { y; } else { -1; };
    if other < 0 or not ((w_b[n] & 2) == 2 or bool_valued(other)) or cheap(other, 6) < 0 { return false; };
    if range_test(n, c, other, and_) { return true; };
    relink(n, Op.Plain, if and_ { i32_and; } else { i32_or; }, c, other);
}

/// Node n rewritten in place as `op a` of kids k1 (and k2, if any), a
/// Bool (marked so when a Plain).
fn relink(n: I32, op: Op, a: I32, k1: I32, k2: I32) Bool {
    w_op[n] = op.to_i32();
    w_a[n] = a;
    w_b[n] = 2;
    w_first[n] = w_kids.len();
    w_kids.push(k1);
    w_count[n] = 1;
    if k2 >= 0 {
        w_kids.push(k2);
        w_count[n] = 2;
    };
    true;
}

/// A branch's value: the node a Seq of one value holds, or -1.
fn seq_value(n: I32) I32 {
    let v = n;
    while (w_op[v] == Op.Seq.to_i32()) {
        if w_count[v] != 1 { return -1; };
        v = w_kid(v, 0);
    };
    if w_type[v] == vt_i32 { v; } else { -1; };
}

fn is_const(n: I32, value: I32) Bool { w_op[n] == Op.I32Const.to_i32() and w_a[n] == value; }

/// Whether an `i32` is always 0 or 1: a comparison, a null or type test, a
/// Bool `if` or fold, 0 or 1.
fn bool_valued(n: I32) Bool {
    let op = w_op[n];
    if op == Op.RefIsNull.to_i32() or op == Op.RefEq.to_i32() or op == Op.RefTest.to_i32() { return true; };
    if op == Op.I32Const.to_i32() { return w_a[n] == 0 or w_a[n] == 1; };
    if (op == Op.If.to_i32() or op == Op.Plain.to_i32()) and (w_b[n] & 2) == 2 { return true; };
    if op == Op.Seq.to_i32() { return w_count[n] == 1 and bool_valued(w_kid(n, 0)); };
    if op == Op.Plain.to_i32() {
        let code = w_a[n];
        if code >= 69 and code <= 102 { return true; };
        if code == i32_and or code == i32_or or code == i32_xor { return bool_valued(w_kid(n, 0)) and bool_valued(w_kid(n, 1)); };
    };
    false;
}

/// What is left of `budget` instructions after n's, or -1 when n is more,
/// or may trap or have effects.
fn cheap(n: I32, budget: I32) I32 {
    let op = w_op[n];
    let ok = op == Op.I32Const.to_i32() or op == Op.I64Const.to_i32() or op == Op.F32Const.to_i32() or op == Op.F64Const.to_i32()
        or op == Op.LocalGet.to_i32() or op == Op.GlobalGet.to_i32() or op == Op.RefIsNull.to_i32() or op == Op.RefEq.to_i32()
        or (op == Op.Plain.to_i32() and pure_opcode(w_a[n]));
    if not ok or budget < 1 { return -1; };
    let left = budget - 1;
    for (0 ..< w_count[n]) |i| {
        left = cheap(w_kid(n, i), left);
        if left < 0 { return -1; };
    };
    left;
}

/// By the last @range_bound: the local compared, and the bound (an `I64`).
vec rb_local: I32 = [-1];
vec rb_value: I64 = [0];

/// A signed `i32` comparison of a local and a constant, as a bound of the
/// local: 0 `x >= v`, 1 `x <= v` (@rb_local, @rb_value); -1 none. `negate`
/// reads it as its opposite (`x < v` is not `x >= v`).
fn range_bound(n: I32, negate: Bool) I32 {
    if w_op[n] != Op.Plain.to_i32() or w_count[n] != 2 { return -1; };
    let code = w_a[n];
    // lt_s 72, gt_s 74, le_s 76, ge_s 78.
    if code != 72 and code != 74 and code != 76 and code != 78 { return -1; };
    let l = w_kid(n, 0);
    let r = w_kid(n, 1);
    // `k < x` is `x > k`.
    if w_op[l] == Op.I32Const.to_i32() and w_op[r] == Op.LocalGet.to_i32() {
        code = if code == 72 { 74; } else if code == 74 { 72; } else if code == 76 { 78; } else { 76; };
        let t = l;
        l = r;
        r = t;
    };
    if w_op[l] != Op.LocalGet.to_i32() or w_op[r] != Op.I32Const.to_i32() { return -1; };
    if negate { code = if code == 72 { 78; } else if code == 74 { 76; } else if code == 76 { 74; } else { 72; }; };
    rb_local[0] = w_a[l];
    let v = w_a[r].to_i64();
    if code == 78 { rb_value[0] = v; return 0; };
    if code == 74 { rb_value[0] = v + 1.to_i64(); return 0; };
    if code == 76 { rb_value[0] = v; return 1; };
    rb_value[0] = v - 1.to_i64();
    1;
}

/// `x >= lo and x <= hi` as `x - lo <u hi - lo + 1`, and `x < lo or x > hi`
/// as `x - lo >=u hi - lo + 1`, in node n. Whether it was.
fn range_test(n: I32, a: I32, b: I32, and_: Bool) Bool {
    let ka = range_bound(a, not and_);
    let la = rb_local[0];
    let va = rb_value[0];
    let kb = range_bound(b, not and_);
    if ka < 0 or kb < 0 or ka == kb or la != rb_local[0] { return false; };
    let lo = if ka == 0 { va; } else { rb_value[0]; };
    let hi = if ka == 0 { rb_value[0]; } else { va; };
    let span = hi - lo + 1.to_i64();
    if lo > hi or span >= 65536.to_i64() * 65536.to_i64() { return false; };
    let x = if ka == 0 { w_kid(a, 0); } else { w_kid(b, 0); };
    if w_op[x] != Op.LocalGet.to_i32() { x = if ka == 0 { w_kid(a, 1); } else { w_kid(b, 1); }; };
    let m = w_mark();
    w_push(x);
    if span == 1.to_i64() {
        w_i32(lo.to_i32());
        w_i32_op(if and_ { i32_eq; } else { i32_ne; }, m);
    } else if lo != 0.to_i64() {
        w_i32(lo.to_i32());
        w_i32_op(i32_sub, m);
    };
    if span != 1.to_i64() {
        w_i32(span.to_i32());
        w_i32_op(if and_ { i32_lt_u; } else { i32_ge_u; }, m);
    };
    // The new nodes, each held once.
    let old = node_holders.len();
    node_holders.resize(w_op.len());
    for (old ..< w_op.len()) |i| { node_holders[i] = 1; };
    relink(n, Op.Seq, 0, w_pop(), -1);
}

//! = Loads
//!
//! `x.f` read again, x the same local, where the first read has run on
//! every way there, x has not been assigned, and nothing that could write
//! the field has run (a call, or a `struct.set` of that field of any type;
//! an immutable field only x's assignment changes): the first read is teed
//! into a new local and the others read that, when there are two others or
//! more (a read is six bytes, the tee and each read of the local two, and
//! the local's declaration about as many). A walk in the order the code
//! runs keeps the reads known; what a branch, block or loop reads is
//! forgotten after it, and a loop's writes count before it.

/// The reads known: by entry, its read (a node), whether it still holds,
/// and its number (the order the walk finds it).
vec ld_node: I32;
vec ld_ok: U8;
vec ld_id: I32;
/// By number: its reads after (counted by the first walk), and its local
/// (-1 none yet).
vec ld_reuses: I32;
vec ld_temp: I32;
/// The walk's next number; whether it rewrites (the second walk); the function.
vec ld_next: I32 = [0];
vec ld_rewrite: I32 = [0];
vec ld_func: I32 = [0];

/// Reads reused in function f; whether any was.
fn reuse_loads(f: I32) Bool {
    ld_reuses.clear();
    ld_temp.clear();
    ld_func[0] = f;
    for (0 ..< 2) |pass| {
        ld_node.clear();
        ld_ok.clear();
        ld_id.clear();
        ld_next[0] = 0;
        ld_rewrite[0] = pass;
        ld_walk(func_body[f]);
        if pass == 0 {
            let any = false;
            for (0 ..< ld_reuses.len()) |e| { if ld_reuses[e] >= 2 { any = true; }; };
            if not any { return false; };
        };
    };
    // The nodes made, each held once.
    let old = node_holders.len();
    node_holders.resize(w_op.len());
    for (old ..< w_op.len()) |i| { node_holders[i] = 1; };
    true;
}

fn ld_walk(n: I32) void {
    let op = w_op[n];
    let count = w_count[n];
    if op == Op.Loop.to_i32() { ld_loop_writes(n); };
    // Kids from `alone` on run each (or not) from what was known before
    // them; a block's or loop's, in turn, forgotten after it.
    let alone = if op == Op.If.to_i32() or op == Op.NullElse.to_i32() or op == Op.CastArms.to_i32() { 1; }
        else if op == Op.Try.to_i32() { 0; } else { count; };
    let start = ld_node.len();
    for (0 ..< count) |i| {
        let mark = ld_node.len();
        ld_walk(w_kid(n, i));
        if i >= alone { ld_forget(mark); };
    };
    if op == Op.Block.to_i32() or op == Op.Loop.to_i32() { ld_forget(start); };
    ld_effect(n);
}

fn ld_forget(mark: I32) void {
    ld_node.resize(mark);
    ld_ok.resize(mark);
    ld_id.resize(mark);
}

/// What a loop writes, anywhere in it, as written before it.
fn ld_loop_writes(n: I32) void {
    ld_effect_write(n);
    for (0 ..< w_count[n]) |i| { ld_loop_writes(w_kid(n, i)); };
}

/// What node n's own instruction does to the reads known.
fn ld_effect(n: I32) void {
    let op = w_op[n];
    if (op == Op.StructGet.to_i32() or op == Op.StructGetS.to_i32() or op == Op.StructGetU.to_i32())
        and w_op[w_kid(n, 0)] == Op.LocalGet.to_i32() and not non_null(w_type[n]) {
        ld_read(n);
    } else {
        ld_effect_write(n);
    };
}

fn ld_effect_write(n: I32) void {
    let op = w_op[n];
    let set = op == Op.StructSet.to_i32();
    let call = op == Op.Call.to_i32() or op == Op.CallRef.to_i32() or op == Op.ReturnCall.to_i32();
    let local = op == Op.LocalSet.to_i32() or op == Op.LocalTee.to_i32();
    if not (set or call or local) { return; };
    for (0 ..< ld_node.len()) |e| {
        let r = ld_node[e];
        let mutable = ht_fields[ht_a[w_a[r]] + w_b[r] * 2 + 1] == 1;
        if (local and w_a[w_kid(r, 0)] == w_a[n]) or (call and mutable) or (set and w_b[r] == w_b[n]) { ld_ok[e] = 0; };
    };
}

/// A field read of a local: one known again, or known from here.
fn ld_read(n: I32) void {
    let x = w_a[w_kid(n, 0)];
    for (0 ..< ld_node.len()) |e| {
        let r = ld_node[e];
        if ld_ok[e] == 1 and w_op[r] == w_op[n] and w_a[r] == w_a[n] and w_b[r] == w_b[n] and w_a[w_kid(r, 0)] == x {
            ld_reuse(e, n);
            return;
        };
    };
    ld_node.push(n);
    ld_ok.push(1);
    ld_id.push(ld_next[0]);
    ld_next[0] += 1;
    if ld_rewrite[0] == 0 {
        ld_reuses.push(0);
        ld_temp.push(-1);
    };
}

/// Read n reads what known entry e's read did.
fn ld_reuse(e: I32, n: I32) void {
    let id = ld_id[e];
    if ld_rewrite[0] == 0 {
        ld_reuses[id] += 1;
        return;
    };
    if ld_reuses[id] < 2 { return; };
    let r = ld_node[e];
    if ld_temp[id] < 0 {
        let t = add_local(ld_func[0], w_type[r]);
        ld_temp[id] = t;
        // The read, teed: a copy of it in a tee where it was.
        let m = w_mark();
        w_push(w_kid(r, 0));
        let copy = w_node(Op.from_i32(w_op[r]), w_type[r], w_a[r], w_b[r], m);
        w_pop();
        w_op[r] = Op.LocalTee.to_i32();
        w_a[r] = t;
        w_b[r] = 0;
        w_first[r] = w_kids.len();
        w_kids.push(copy);
        w_count[r] = 1;
        ld_node[e] = copy;
    };
    w_op[n] = Op.LocalGet.to_i32();
    w_a[n] = ld_temp[id];
    w_b[n] = 0;
    w_count[n] = 0;
}
