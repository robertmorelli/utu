//! = Local cleanup
//!
//! Stage 0's `wasm/optimize.js`, for size and speed builds. Lowerings leave
//! copies and temporaries a hand-written program would not have (a
//! generator's parameters bound to the call's arguments, each `yield`'s value
//! held for the consumer). Four rewrites remove them, in each function:
//!
//! / copies: a local set once, to a parameter never assigned, is that
//!   parameter: its reads read the parameter. In size builds, one set once
//!   to a number or a null is that constant, where it is read once or the
//!   constant is no bigger than a read.
//! / temporaries: a local set once to a pure value and read once in the next
//!   statement, outside any loop and before anything assigns what the value
//!   reads, is that value: it moves to the read.
//! / tees: a local stored and then read first by the next statement is
//!   stored there, by a tee (two bytes fewer).
//! / unused: a local never read is not stored (its value is kept, and
//!   dropped, when it has effects), and is no longer declared.
//! / coalescing: locals of one type whose live ranges do not overlap share
//!   one, and the locals are declared grouped by type (one run each). A
//!   local set before read in a loop (an inlined body's) does not hold its
//!   slot through it.
//! / loads (size builds): a field read of a local, read again twice or more
//!   where nothing can have changed it, is kept in a local.
//! / logic (size builds): `a and b`, `a or b` whose b is cheap, pure and
//!   cannot trap are `i32.and`, `i32.or`, no `if`; a range test of one local
//!   against constants is one unsigned comparison.
//! / constants (first, and again after copies and temporaries): an
//!   operation of constants is its value, and so on (see below).
//!
//! So a consumed generator compiles to what the equivalent loop compiles to.
//! Every local codegen makes is set before it is read, which is what makes
//! the first two sound. Nodes are rewritten in place: a store removed is an
//! empty Seq, which emits nothing.

/// The function's nodes, in walk order, each with its parent and its place there.
vec opt_nodes: I32;
vec opt_parent: I32;
vec opt_place: I32;
/// By local: its reads.
vec opt_gets: I32;
/// By local: its writes.
vec opt_sets: I32;
/// By local: the position (in @opt_nodes) of a read.
vec opt_get_at: I32;
/// By local: the position of a write.
vec opt_set_at: I32;
/// The locals a value being sunk reads, once each.
vec opt_reads: I32;
/// The sink pass (a stamp), and the value's reads (a stamp: @opt_rd_mark).
vec opt_pass: I32 = [0, 0];
/// By node: `pass * 2 + pure` for a value whose purity a sink pass found.
vec opt_memo: I32;
/// By node: the pass its reads were noted in, and where in @opt_rd_pool.
vec opt_rd_at: I32;
vec opt_rd_from: I32;
vec opt_rd_len: I32;
/// The reads of the values noted, in runs.
vec opt_rd_pool: I32;
/// By local: the reads (their stamp) it is already in.
vec opt_rd_mark: I32;
/// The Seqs, Blocks and Loops of @opt_nodes, in its order.
vec opt_blocks: I32;
/// Whether a node of the walk is held in more than one place.
vec opt_shared: U8 = [0];
/// By local: its index once unused locals are gone.
vec opt_renumber: I32;

/// The cleanup, over each live function with a body, after the sweep.
fn optimize_module() void {
    for (0 ..< func_kind.len()) |f| { if optimizable(f) { optimize_function(f); }; };
}

fn optimizable(f: I32) Bool { func_kind[f] == FuncKind.Defined.to_i32() and func_live[f] == 1 and func_body[f] >= 0; }

/// Constants, copies and temporaries until none changes anything, then
/// tees, then unused locals. A body sharing a node with another is left as it is.
fn optimize_function(f: I32) void {
    let params = vl_len[ht_a[func_type_of[f]]];
    let total = params + func_local_count[f];
    opt_collect(f, total);
    // A node held in two places (in one body or two; see sweep) would be
    // rewritten for both, so a body with one is left as it is.
    if opt_shared[0] == 1 { return; };
    // The rewrites keep the counts, and each local's one read or write
    // (with its parent), as a new walk would find them. None moves a block,
    // so the blocks stay in the walk's order. A fold may, so a new walk
    // follows one.
    let folded = fold_constants(f);
    while (true) {
        if folded { opt_collect(f, total); };
        while (propagate_copies(params) or sink_temporaries(params)) {};
        folded = fold_constants(f);
        if not folded { break; };
    };
    if optimize_level[0] == 1 and reuse_loads(f) {
        total = params + func_local_count[f];
        opt_collect(f, total);
    };
    if optimize_level[0] == 1 and fold_logic() { opt_collect(f, total); };
    tee_stores();
    remove_unused_locals(f, params, total);
    coalesce_locals(f, params);
}

/// Walk the body, noting each node's parent, and each local's reads and writes.
fn opt_collect(f: I32, total: I32) void {
    opt_gets.resize(total);
    opt_sets.resize(total);
    opt_get_at.resize(total);
    opt_set_at.resize(total);
    for (0 ..< total) |l| {
        opt_gets[l] = 0;
        opt_sets[l] = 0;
    };
    opt_blocks.clear();
    opt_shared[0] = 0;
    // (Written in place, in room doubled as it fills, and cut to the walk at the end.)
    opt_room(64);
    opt_nodes[0] = func_body[f];
    opt_parent[0] = -1;
    opt_place[0] = -1;
    let n = 1;
    let k = 0;
    while (k < n) {
        let node = opt_nodes[k];
        let op = w_op[node];
        if node_holders[node] != 1 { opt_shared[0] = 1; };
        if op == Op.LocalGet.to_i32() {
            opt_gets[w_a[node]] += 1;
            opt_get_at[w_a[node]] = k;
        } else if op == Op.LocalSet.to_i32() or op == Op.LocalTee.to_i32() {
            opt_sets[w_a[node]] += 1;
            opt_set_at[w_a[node]] = k;
        } else if op == Op.Seq.to_i32() or op == Op.Block.to_i32() or op == Op.Loop.to_i32() {
            opt_blocks.push(node);
        };
        let c = w_count[node];
        if n + c > opt_nodes.len() { opt_room((n + c) * 2); };
        let first = w_first[node];
        for (0 ..< c) |i| {
            opt_nodes[n] = w_kids[first + i];
            opt_parent[n] = node;
            opt_place[n] = i;
            n += 1;
        };
        k += 1;
    };
    opt_room(n);
}

/// @opt_nodes, @opt_parent and @opt_place resized to `n`.
fn opt_room(n: I32) void {
    opt_nodes.resize(n);
    opt_parent.resize(n);
    opt_place.resize(n);
}

/// Computes a value without effects or traps, reading at most locals.
fn opt_pure(node: I32) Bool {
    if not pure_op(node) { return false; };
    for (0 ..< w_count[node]) |i| { if not opt_pure(w_kid(node, i)) { return false; }; };
    true;
}

/// @opt_pure, noted by node for the sink pass: a value sunk into the next
/// one is not walked again (a sink only puts a pure value where a read was).
fn sink_pure(node: I32) Bool {
    let pass = opt_pass[0];
    if opt_memo[node] >> 1 == pass { return opt_memo[node] & 1 == 1; };
    let pure = pure_op(node);
    for (0 ..< w_count[node]) |i| { if pure and not sink_pure(w_kid(node, i)) { pure = false; }; };
    opt_memo[node] = pass * 2 + if pure { 1; } else { 0; };
    pure;
}

/// Whether node `node`'s own operation is one @opt_pure allows.
fn pure_op(node: I32) Bool {
    let op = w_op[node];
    if op == Op.I32Const.to_i32() or op == Op.I64Const.to_i32() or op == Op.F32Const.to_i32() or op == Op.F64Const.to_i32()
        or op == Op.LocalGet.to_i32() or op == Op.RefNull.to_i32() or op == Op.RefFunc.to_i32() or op == Op.Nop.to_i32() {
        return true;
    };
    // An immutable field of a reference that cannot be null (a closure's
    // capture, from its environment) neither traps nor changes.
    let immutable_read = (op == Op.StructGet.to_i32() or op == Op.StructGetS.to_i32() or op == Op.StructGetU.to_i32())
        and ht_fields[ht_a[w_a[node]] + w_b[node] * 2 + 1] == 0 and non_null(w_type[w_kid(node, 0)]);
    op == Op.RefIsNull.to_i32() or op == Op.RefEq.to_i32() or op == Op.RefI31.to_i32() or op == Op.I31GetS.to_i32()
        or op == Op.I31GetU.to_i32() or op == Op.Select.to_i32() or (op == Op.Plain.to_i32() and pure_opcode(w_a[node])) or immutable_read;
}

/// A numeric instruction that cannot trap (not a division, remainder, or
/// float-to-integer truncation).
fn pure_opcode(code: I32) Bool {
    if code < 69 or code > 196 { return false; };
    if code >= 109 and code <= 112 { return false; };
    if code >= 127 and code <= 130 { return false; };
    if code >= 168 and code <= 171 { return false; };
    if code >= 174 and code <= 177 { return false; };
    true;
}

fn non_null(vt: I32) Bool { vt == vt_extern or (vt >= vt_defined and vt < vt_tuple and (vt - vt_defined) % 2 == 1); }

/// Whether node `n` is a number or a null.
fn opt_literal(n: I32) Bool {
    let op = w_op[n];
    w_count[n] == 0 and (op == Op.I32Const.to_i32() or op == Op.I64Const.to_i32() or op == Op.F32Const.to_i32()
        or op == Op.F64Const.to_i32() or op == Op.RefNull.to_i32());
}

fn single_value(vt: I32) Bool { vt != vt_none and vt != vt_unreachable and vt < vt_tuple; }

fn set_kid(parent: I32, place: I32, node: I32) void { w_kids[w_first[parent] + place] = node; }

/// Make node `n` emit nothing.
fn opt_erase(n: I32) void {
    w_op[n] = Op.Seq.to_i32();
    w_type[n] = vt_none;
    w_count[n] = 0;
}

/// By local: the parameter its reads read instead, or -1; and that read's type.
vec opt_copy_of: I32;
vec opt_copy_type: I32;
/// By local (size builds): the constant its one store stores, read in its
/// place (when read once, or no bigger than a read), or -1.
vec opt_const_of: I32;

/// The copies rewrite: whether anything changed. Each local is settled in
/// order (a copy of a copy settled before it is a copy of that parameter),
/// then one walk rewrites every read.
fn propagate_copies(params: I32) Bool {
    let changed = false;
    opt_copy_of.resize(opt_gets.len());
    opt_copy_type.resize(opt_gets.len());
    opt_const_of.resize(opt_gets.len());
    for (0 ..< opt_gets.len()) |l| {
        opt_copy_of[l] = -1;
        opt_const_of[l] = -1;
    };
    for (params ..< opt_gets.len()) |l| {
        if opt_sets[l] == 1 {
            let write = opt_nodes[opt_set_at[l]];
            let source = if w_count[write] == 1 { w_kid(write, 0); } else { -1; };
            if optimize_level[0] == 1 and w_op[write] == Op.LocalSet.to_i32() and source >= 0 and opt_gets[l] > 0
                and opt_literal(source) and (opt_gets[l] == 1 or sm_bytes(source, true) <= 2) {
                opt_const_of[l] = source;
                changed = true;
            };
            if w_op[write] == Op.LocalSet.to_i32() and source >= 0 and w_op[source] == Op.LocalGet.to_i32() {
                let p = w_a[source];
                let t = w_type[source];
                if p >= params and p < l and opt_copy_of[p] >= 0 {
                    t = opt_copy_type[p];
                    p = opt_copy_of[p];
                };
                if p < params and opt_sets[p] == 0 and single_value(t) {
                    opt_copy_of[l] = p;
                    opt_copy_type[l] = t;
                    changed = true;
                };
            };
        };
    };
    // (No copy: no walk.)
    if not changed { return false; };
    changed = false;
    for (0 ..< opt_nodes.len()) |k| {
        let n = opt_nodes[k];
        if w_op[n] == Op.LocalGet.to_i32() and opt_const_of[w_a[n]] >= 0 {
            let c = opt_const_of[w_a[n]];
            opt_gets[w_a[n]] -= 1;
            w_op[n] = w_op[c];
            w_type[n] = w_type[c];
            w_a[n] = w_a[c];
            w_b[n] = w_b[c];
            changed = true;
        } else if w_op[n] == Op.LocalGet.to_i32() and opt_copy_of[w_a[n]] >= 0 {
            let l = w_a[n];
            w_a[n] = opt_copy_of[l];
            w_type[n] = opt_copy_type[l];
            opt_gets[l] -= 1;
            opt_gets[w_a[n]] += 1;
            opt_get_at[w_a[n]] = k;
            changed = true;
        };
    };
    changed;
}

/// The temporaries rewrite, within each Seq or Block (a store and the
/// statement after it): whether anything changed.
fn sink_temporaries(params: I32) Bool {
    let changed = false;
    // (The notes grow with the nodes; an older pass's are stale.)
    opt_pass[0] += 1;
    opt_rd_pool.clear();
    if opt_memo.len() < w_op.len() {
        opt_memo.resize(w_op.len());
        opt_rd_at.resize(w_op.len());
        opt_rd_from.resize(w_op.len());
        opt_rd_len.resize(w_op.len());
    };
    if opt_rd_mark.len() < opt_gets.len() { opt_rd_mark.resize(opt_gets.len()); };
    for (0 ..< opt_blocks.len()) |b| {
        let block = opt_blocks[b];
        let op = w_op[block];
        if op == Op.Seq.to_i32() or op == Op.Block.to_i32() {
            let i = 0;
            while (i + 1 < w_count[block]) {
                let write = w_kid(block, i);
                let l = w_a[write];
                if w_op[write] == Op.LocalSet.to_i32() and w_count[write] == 1 and l >= params and opt_sets[l] == 1 and opt_gets[l] == 1 {
                    let value = w_kid(write, 0);
                    let at = opt_get_at[l];
                    let read = opt_nodes[at];
                    if sink_pure(value) and single_value(w_type[value]) and opt_parent[at] >= 0 {
                        opt_reads.clear();
                        opt_pass[1] += 1;
                        reads_of(value);
                        opt_rd_at[value] = opt_pass[0];
                        opt_rd_from[value] = opt_rd_pool.len();
                        opt_rd_len[value] = opt_reads.len();
                        for (0 ..< opt_reads.len()) |r| { opt_rd_pool.push(opt_reads[r]); };
                        if sink_visit(w_kid(block, i + 1), read, false) == 1 {
                            set_kid(opt_parent[at], opt_place[at], value);
                            opt_erase(write);
                            opt_gets[l] = 0;
                            opt_sets[l] = 0;
                            changed = true;
                            // The value's own read (if it is one) now sits where the sunk read was.
                            if w_op[value] == Op.LocalGet.to_i32() and opt_gets[w_a[value]] == 1 {
                                let v = opt_get_at[w_a[value]];
                                opt_parent[v] = opt_parent[at];
                                opt_place[v] = opt_place[at];
                            };
                        };
                    };
                };
                i += 1;
            };
        };
    };
    changed;
}

/// `local.set x (v)` then a statement whose first instruction is
/// `local.get x` is `local.tee x (v)` there. When that was the local's one
/// read, it is then never read, and the value takes the tee's place
/// (@remove_unused_locals).
///
/// A tee moves the store into the next statement, which may be a store
/// teed into the one after: a run of them nests, statement in statement, so
/// a run stops at @tee_run_max (which code generation's recursion bears).
fn tee_stores() Bool {
    let changed = false;
    for (0 ..< opt_blocks.len()) |b| {
        let block = opt_blocks[b];
        let op = w_op[block];
        if op == Op.Seq.to_i32() or op == Op.Block.to_i32() or op == Op.Loop.to_i32() {
            let run = 0;
            for (0 ..< w_count[block]) |i| {
                let write = w_kid(block, i);
                // (What emits nothing is passed over, as by tee_into.)
                if w_op[write] == Op.LocalSet.to_i32() and w_count[write] == 1 and run < tee_run_max and tee_into(block, i + 1, write) {
                    changed = true;
                    run += 1;
                } else if not emits_nothing(write) {
                    run = 0;
                };
            };
        };
    };
    changed;
}

/// The longest run of stores teed one into the next.
let tee_run_max: I32 = 64;

/// Whether the first instruction from kid `from` of `parent` on reads what
/// `write` (kid `from - 1`) stores: the read becomes the tee, and the store
/// nothing.
fn tee_into(parent: I32, from: I32, write: I32) Bool {
    let holder = parent;
    let place = from;
    while (true) {
        // Kids that emit nothing are passed over.
        while (place < w_count[holder] and emits_nothing(w_kid(holder, place))) { place += 1; };
        if place >= w_count[holder] { return false; };
        let node = w_kid(holder, place);
        let op = w_op[node];
        if op == Op.LocalGet.to_i32() {
            if w_a[node] != w_a[write] { return false; };
            set_kid(holder, place, write);
            w_op[write] = Op.LocalTee.to_i32();
            w_type[write] = w_type[node];
            opt_gets[w_a[write]] -= 1;
            // The read is now nothing, where the store was.
            opt_erase(node);
            set_kid(parent, from - 1, node);
            return true;
        };
        // A block's contents come after its opcode, which a value cannot cross.
        if op == Op.Block.to_i32() or op == Op.Loop.to_i32() or op == Op.Try.to_i32() or op == Op.NullElse.to_i32() or w_count[node] == 0 { return false; };
        // So does a CastArms' value, its blocks opened: one that takes the
        // value an arm starts with (a Held) would find it outside them.
        if op == Op.CastArms.to_i32() and holds_held(write) { return false; };
        holder = node;
        place = 0;
    };
    false;
}

/// Whether `node` takes, somewhere in it, the value on the stack an arm starts with.
fn holds_held(node: I32) Bool {
    if w_op[node] == Op.Held.to_i32() { return true; };
    for (0 ..< w_count[node]) |i| { if holds_held(w_kid(node, i)) { return true; }; };
    false;
}

/// Whether a node is only empty Seqs (what a removed store leaves).
fn emits_nothing(node: I32) Bool {
    if w_op[node] != Op.Seq.to_i32() { return false; };
    for (0 ..< w_count[node]) |i| { if not emits_nothing(w_kid(node, i)) { return false; }; };
    true;
}

/// The locals `node` reads, into @opt_reads, once each; a value of this
/// pass already sunk there is not walked again.
fn reads_of(node: I32) void {
    if opt_rd_at[node] == opt_pass[0] {
        let from = opt_rd_from[node];
        for (0 ..< opt_rd_len[node]) |r| { read_once(opt_rd_pool[from + r]); };
        return;
    };
    if w_op[node] == Op.LocalGet.to_i32() { read_once(w_a[node]); };
    for (0 ..< w_count[node]) |i| { reads_of(w_kid(node, i)); };
}

fn read_once(l: I32) void {
    if opt_rd_mark[l] != opt_pass[1] {
        opt_rd_mark[l] = opt_pass[1];
        opt_reads.push(l);
    };
}

/// Whether `target` is reached in `node` (1) before anything assigns a local
/// the value reads, and not inside a loop (where the value would be computed
/// each time round); 2 when it cannot be, 0 when it is not there.
fn sink_visit(node: I32, target: I32, in_loop: Bool) I32 {
    if node == target { return if in_loop { 2; } else { 1; }; };
    let looping = in_loop or w_op[node] == Op.Loop.to_i32();
    for (0 ..< w_count[node]) |i| {
        let r = sink_visit(w_kid(node, i), target, looping);
        if r != 0 { return r; };
    };
    let op = w_op[node];
    if op == Op.LocalSet.to_i32() or op == Op.LocalTee.to_i32() {
        for (0 ..< opt_reads.len()) |i| { if opt_reads[i] == w_a[node] { return 2; }; };
    };
    0;
}

/// The unused rewrite: each store to a local never read goes (or becomes a
/// drop, or its value), and the locals still read are renumbered.
fn remove_unused_locals(f: I32, params: I32, total: I32) void {
    let first = func_locals[f];
    let kept = 0;
    opt_renumber.resize(total);
    for (0 ..< total) |l| { opt_renumber[l] = l; };
    for (params ..< total) |l| {
        opt_renumber[l] = -1;
        if opt_gets[l] > 0 {
            opt_renumber[l] = params + kept;
            local_types[first + kept] = local_types[first + l - params];
            kept += 1;
        };
    };
    // (Every local read: nothing goes, nothing is renumbered.)
    if kept == total - params { return; };
    func_local_count[f] = kept;
    unused_walk(f, func_body[f], -1, 0, params);
}

/// The unused rewrite under `n`, kid `place` of `parent`: inner stores first
/// (one moved out of its parent would leave what it holds a stale parent).
fn unused_walk(f: I32, n: I32, parent: I32, place: I32, params: I32) void {
    for (0 ..< w_count[n]) |i| { unused_walk(f, w_kid(n, i), n, i, params); };
    let op = w_op[n];
    if (op == Op.LocalSet.to_i32() or op == Op.LocalTee.to_i32()) and w_a[n] >= params and opt_gets[w_a[n]] == 0 {
        // A store with no operand takes its value from the stack (a
        // multi-value result, taken apart): it is dropped there.
        if w_count[n] == 0 {
            // (A tee would leave it there: it is nothing.)
            if op == Op.LocalTee.to_i32() { opt_erase(n); } else { w_op[n] = Op.Drop.to_i32(); };
            return;
        };
        let value = w_kid(n, 0);
        if op == Op.LocalSet.to_i32() and opt_pure(value) {
            opt_erase(n);
        } else if op == Op.LocalSet.to_i32() and single_value(w_type[value]) {
            w_op[n] = Op.Drop.to_i32();
        } else if parent >= 0 {
            set_kid(parent, place, value);
        } else {
            func_body[f] = value;
        };
        return;
    };
    if op == Op.LocalGet.to_i32() or op == Op.LocalSet.to_i32() or op == Op.LocalTee.to_i32() { w_a[n] = opt_renumber[w_a[n]]; };
}

//! = Coalescing

/// By local: its first and last mention, in the order the code runs
/// (positions of the walk), and whether the first stores it.
vec co_first: I32;
vec co_last: I32;
vec co_store_first: I32;
/// By local: the innermost loop around its first and its last mention, or -1.
vec co_loop_first: I32;
vec co_loop_last: I32;
/// By loop (in the order they start): the positions it spans, its node, the
/// loop around it (or -1), and where its locals read before written in it
/// start in @co_exposed (@co_exposed_count of them).
vec co_loop_start: I32;
vec co_loop_end: I32;
vec co_loop_node: I32;
vec co_loop_outer: I32;
vec co_exposed_at: I32;
vec co_exposed_count: I32;
vec co_exposed: I32;
/// While finding a loop's exposed locals: by local, whether written on
/// every path so far, with the log of those set (to undo a branch's), and
/// the loop it was last noted exposed in.
vec co_written: U8;
vec co_written_log: I32;
vec co_noted: I32;
/// By label: whether something branches to it (labels in @co_target_list).
vec co_targeted: U8;
vec co_target_list: I32;
/// The loops around the walk, outermost first.
vec co_loops: I32;
/// The nodes that read or write a local.
vec co_mentions: I32;
vec co_pos: I32 = [0];
/// The slots locals share: each one's type, the end of the range it holds
/// last, and the next slot of its type.
vec co_slot_type: I32;
vec co_slot_end: I32;
vec co_slot_next: I32;
/// The slots' types, in the order they first appear, with each one's first
/// and last slot.
vec co_types: I32;
vec co_type_head: I32;
vec co_type_tail: I32;
/// Scratch for sorting.
vec co_sort: I32;
/// By type, a tree of its slots' ends (each node the least below it; a slot
/// not made yet, the most), to find the first slot free by a given start:
/// where its tree starts, its leaves (a power of two), the slots made, and
/// at its leaves' places, each slot.
vec co_tree: I32;
vec co_tree_at: I32;
vec co_tree_leaves: I32;
vec co_tree_made: I32;
vec co_tree_slot: I32;

/// Share locals whose ranges do not overlap: a local is live from its first
/// mention to its last, and a mention inside a loop makes it live through
/// the whole outermost loop around it its value may come round in: one it is
/// mentioned outside of, or read in before written (an inlined body's
/// locals, set before read, do not come round a caller's loop). A local is
/// only moved into another's when its first mention stores it: one read
/// first would rely on starting at zero.
fn coalesce_locals(f: I32, params: I32) void {
    let n = func_local_count[f];
    if n < 2 { return; };
    let total = params + n;
    co_first.resize(total);
    co_last.resize(total);
    co_store_first.resize(total);
    co_loop_first.resize(total);
    co_loop_last.resize(total);
    for (0 ..< total) |l| {
        co_first[l] = -1;
        co_loop_first[l] = -1;
        co_loop_last[l] = -1;
    };
    co_loop_start.clear();
    co_loop_end.clear();
    co_loop_node.clear();
    co_loop_outer.clear();
    co_loops.clear();
    co_mentions.clear();
    for (0 ..< co_target_list.len()) |i| { co_targeted[co_target_list[i]] = 0; };
    co_target_list.clear();
    co_pos[0] = 0;
    co_walk(func_body[f]);
    co_find_exposed(total);
    // Each local's range, and the slot it takes: the first of its type free
    // by then (locals in the order their ranges start).
    let start = Array[I32].new(total, 0);
    let end = Array[I32].new(total, 0);
    for (params ..< total) |l| {
        start[l] = co_first[l];
        end[l] = co_last[l];
        let lf = co_round_loop(l, co_loop_first[l]);
        let ll = co_round_loop(l, co_loop_last[l]);
        if lf >= 0 and co_loop_start[lf] < start[l] { start[l] = co_loop_start[lf]; };
        if ll >= 0 and co_loop_end[ll] > end[l] { end[l] = co_loop_end[ll]; };
    };
    let order = Array[I32].new(n, 0);
    for (0 ..< n) |i| { order[i] = params + i; };
    sort_by_key(order, start);
    let first = func_locals[f];
    let slot_of = Array[I32].new(total, -1);
    co_slot_type.clear();
    co_slot_end.clear();
    co_slot_next.clear();
    co_types.clear();
    co_type_head.clear();
    co_type_tail.clear();
    // Each local's type (in the order types first appear), and a tree per type.
    let type_of = Array[I32].new(total, 0);
    co_tree_leaves.clear();
    for (order) |l| {
        let vt = local_types[first + l - params];
        let t = 0;
        while (t < co_types.len() and co_types[t] != vt) { t += 1; };
        if t == co_types.len() {
            co_types.push(vt);
            co_type_head.push(-1);
            co_type_tail.push(-1);
            co_tree_leaves.push(0);
        };
        type_of[l] = t;
        co_tree_leaves[t] += 1;
    };
    co_tree_at.clear();
    co_tree_made.clear();
    let size = 0;
    for (0 ..< co_types.len()) |t| {
        let leaves = 1;
        while (leaves < co_tree_leaves[t]) { leaves *= 2; };
        co_tree_leaves[t] = leaves;
        co_tree_at.push(size);
        co_tree_made.push(0);
        size += leaves * 2;
    };
    co_tree.resize(size);
    co_tree_slot.resize(size);
    for (0 ..< size) |i| { co_tree[i] = 2147483647; };
    for (order) |l| {
        let vt = local_types[first + l - params];
        let t = type_of[l];
        let slot = -1;
        let leaf = -1;
        if co_first[l] >= 0 and co_store_first[l] == 1 {
            leaf = co_first_free(t, start[l]);
            if leaf >= 0 { slot = co_tree_slot[co_tree_at[t] + leaf]; };
        };
        if slot < 0 {
            slot = co_slot_type.len();
            co_slot_type.push(vt);
            co_slot_end.push(end[l]);
            co_slot_next.push(-1);
            if co_type_tail[t] >= 0 { co_slot_next[co_type_tail[t]] = slot; } else { co_type_head[t] = slot; };
            co_type_tail[t] = slot;
            leaf = co_tree_made[t];
            co_tree_made[t] += 1;
            co_tree_slot[co_tree_at[t] + leaf] = slot;
        } else {
            co_slot_end[slot] = end[l];
        };
        co_tree_set(t, leaf, end[l]);
        slot_of[l] = slot;
    };
    // The slots, declared grouped by type (in the order types first appear).
    let count = co_slot_type.len();
    let index = Array[I32].new(count, -1);
    let next = 0;
    for (0 ..< co_types.len()) |t| {
        let s = co_type_head[t];
        while (s >= 0) {
            index[s] = next;
            next += 1;
            s = co_slot_next[s];
        };
    };
    // As they are when no two share and each type is one run already.
    let runs = 1;
    for (1 ..< n) |i| { if local_types[first + i] != local_types[first + i - 1] { runs += 1; }; };
    if count == n and runs == co_types.len() { return; };
    for (0 ..< count) |s| { local_types[first + index[s]] = co_slot_type[s]; };
    func_local_count[f] = count;
    for (0 ..< co_mentions.len()) |k| {
        let node = co_mentions[k];
        if w_a[node] >= params { w_a[node] = params + index[slot_of[w_a[node]]]; };
    };
}

/// Type t's first slot (as made) whose end is before `start`, as its leaf, or -1.
fn co_first_free(t: I32, start: I32) I32 {
    let at = co_tree_at[t];
    let leaves = co_tree_leaves[t];
    if co_tree[at + 1] >= start { return -1; };
    let i = 1;
    while (i < leaves) {
        i = if co_tree[at + i * 2] < start { i * 2; } else { i * 2 + 1; };
    };
    i - leaves;
}

/// Type t's slot at `leaf` ends at `end`.
fn co_tree_set(t: I32, leaf: I32, end: I32) void {
    let at = co_tree_at[t];
    let i = co_tree_leaves[t] + leaf;
    co_tree[at + i] = end;
    i = i / 2;
    while (i >= 1) {
        let a = co_tree[at + i * 2];
        let b = co_tree[at + i * 2 + 1];
        co_tree[at + i] = if a < b { a; } else { b; };
        i = i / 2;
    };
}

/// Sort `order` by `key` (of each item), keeping the order of equal ones (a
/// merge sort).
fn sort_by_key(order: Array[I32], key: Array[I32]) void {
    let n = order.len();
    co_sort.resize(n);
    let width = 1;
    while (width < n) {
        let lo = 0;
        while (lo < n) {
            let mid = if lo + width < n { lo + width; } else { n; };
            let hi = if mid + width < n { mid + width; } else { n; };
            let i = lo;
            let j = mid;
            let k = lo;
            while (k < hi) {
                if j >= hi or (i < mid and key[order[i]] <= key[order[j]]) {
                    co_sort[k] = order[i];
                    i += 1;
                } else {
                    co_sort[k] = order[j];
                    j += 1;
                };
                k += 1;
            };
            lo = hi;
        };
        for (0 ..< n) |k| { order[k] = co_sort[k]; };
        width = width * 2;
    };
}

/// Number the nodes in the order they run (operands first), noting each
/// local's mentions and each loop's span.
fn co_walk(node: I32) void {
    let op = w_op[node];
    let span = -1;
    if op == Op.Loop.to_i32() {
        span = co_loop_start.len();
        co_loop_start.push(co_pos[0]);
        co_loop_end.push(-1);
        co_loop_node.push(node);
        co_loop_outer.push(if co_loops.len() > 0 { co_loops[co_loops.len() - 1]; } else { -1; });
        co_loops.push(span);
    };
    if op == Op.Br.to_i32() or op == Op.BrIf.to_i32() {
        co_target(w_a[node]);
    } else if op == Op.BrTable.to_i32() {
        for (0 ..< w_b[node]) |i| { co_target(w_aux[w_a[node] + i]); };
    };
    for (0 ..< w_count[node]) |i| { co_walk(w_kid(node, i)); };
    let at = co_pos[0];
    co_pos[0] = at + 1;
    if op == Op.LocalGet.to_i32() or op == Op.LocalSet.to_i32() or op == Op.LocalTee.to_i32() {
        let l = w_a[node];
        co_mentions.push(node);
        if co_first[l] < 0 {
            co_first[l] = at;
            co_store_first[l] = if op == Op.LocalGet.to_i32() { 0; } else { 1; };
            if co_loops.len() > 0 { co_loop_first[l] = co_loops[co_loops.len() - 1]; };
        };
        co_last[l] = at;
        co_loop_last[l] = if co_loops.len() > 0 { co_loops[co_loops.len() - 1]; } else { -1; };
    };
    if span >= 0 {
        co_loop_end[span] = at;
        co_loops.resize(co_loops.len() - 1);
    };
}

fn co_target(label: I32) void {
    if label >= co_targeted.len() {
        let old = co_targeted.len();
        co_targeted.resize(label + 1);
        for (old ..< label + 1) |i| { co_targeted[i] = 0; };
    };
    if co_targeted[label] == 0 {
        co_targeted[label] = 1;
        co_target_list.push(label);
    };
}

/// The outermost loop, from `inner` (a loop around a mention of local `l`)
/// out, that `l`'s value may come round: `l` is mentioned outside it or
/// read in it before written; or -1.
fn co_round_loop(l: I32, inner: I32) I32 {
    let most = -1;
    let s = inner;
    while (s >= 0) {
        let round = co_first[l] < co_loop_start[s] or co_last[l] > co_loop_end[s];
        if not round and co_exposed_at[s] < 0 { co_loop_exposed(s); };
        let k = co_exposed_at[s];
        while (not round and k < co_exposed_at[s] + co_exposed_count[s]) {
            if co_exposed[k] == l { round = true; };
            k += 1;
        };
        if round { most = s; };
        s = co_loop_outer[s];
    };
    most;
}

/// No loop's exposed locals found yet (each is when asked: co_loop_exposed).
fn co_find_exposed(total: I32) void {
    co_written.resize(total);
    co_noted.resize(total);
    for (0 ..< total) |l| {
        co_written[l] = 0;
        co_noted[l] = -1;
    };
    co_exposed.clear();
    co_exposed_at.resize(co_loop_node.len());
    co_exposed_count.resize(co_loop_node.len());
    for (0 ..< co_loop_node.len()) |s| { co_exposed_at[s] = -1; };
}

/// Loop `s`'s locals read before written in it, onto @co_exposed.
fn co_loop_exposed(s: I32) void {
    co_exposed_at[s] = co_exposed.len();
    let node = co_loop_node[s];
    for (0 ..< w_count[node]) |i| { co_reads_first(w_kid(node, i), s); };
    co_undo_written(0);
    co_exposed_count[s] = co_exposed.len() - co_exposed_at[s];
}

fn co_undo_written(mark: I32) void {
    for (mark ..< co_written_log.len()) |i| { co_written[co_written_log[i]] = 0; };
    co_written_log.resize(mark);
}

/// Walks `n` in the order it runs, noting reads of locals not yet written
/// on every path (in loop `s`). What runs maybe (a branch, a loop's body, a
/// block branched out of, a `try`) writes for itself only.
fn co_reads_first(n: I32, s: I32) void {
    let op = w_op[n];
    if op == Op.LocalGet.to_i32() {
        let l = w_a[n];
        if co_written[l] == 0 and co_noted[l] != s {
            co_noted[l] = s;
            co_exposed.push(l);
        };
        return;
    };
    let maybe = op == Op.Loop.to_i32() or op == Op.Try.to_i32()
        or (op == Op.Block.to_i32() and w_a[n] < co_targeted.len() and co_targeted[w_a[n]] == 1);
    // (A `try`'s catch runs after any part of its body.)
    let branches = op == Op.If.to_i32() or op == Op.NullElse.to_i32() or op == Op.CastArms.to_i32() or op == Op.Try.to_i32();
    let mark = co_written_log.len();
    for (0 ..< w_count[n]) |i| {
        if branches and i > 0 { co_undo_written(mark); };
        co_reads_first(w_kid(n, i), s);
        if branches and i == 0 and op != Op.Try.to_i32() { mark = co_written_log.len(); };
    };
    if maybe or branches { co_undo_written(mark); };
    if (op == Op.LocalSet.to_i32() or op == Op.LocalTee.to_i32()) and co_written[w_a[n]] == 0 {
        co_written[w_a[n]] = 1;
        co_written_log.push(w_a[n]);
    };
}

//! = Logic
//!
//! `a and b` is built as `if a { b } else { false }`. When b is a few
//! instructions that neither trap nor have effects, running it either way
//! is the same: `a b i32.and` (`a b i32.or`), five bytes fewer. That needs a
//! and b to be 0 or 1: an `if` marks (@w_b) a condition that is a Bool (1)
//! and values that are (2); else they must be comparisons. `if c { true }
//! else { false }` is c. Then `x >= lo and x <= hi`, x a local and lo, hi
//! constants, is `x - lo <u hi - lo + 1` (`x == lo` when they are one);
//! `x < lo or x > hi` its opposite.

/// Fold each `if` of the function's walk, operands first. Whether any changed.
fn fold_logic() Bool {
    let changed = false;
    let k = opt_nodes.len();
    while (k > 0) {
        k -= 1;
        let n = opt_nodes[k];
        if w_op[n] == Op.If.to_i32() and w_type[n] == vt_i32 and w_count[n] == 3 and fold_if(n) { changed = true; };
    };
    changed;
}

fn fold_if(n: I32) Bool {
    let c = w_kid(n, 0);
    let x = seq_value(w_kid(n, 1));
    let y = seq_value(w_kid(n, 2));
    if x < 0 or y < 0 { return false; };
    if not ((w_b[n] & 1) == 1 or bool_valued(c)) { return false; };
    if is_const(x, 1) and is_const(y, 0) { return relink(n, Op.Seq, 0, c, -1); };
    if is_const(x, 0) and is_const(y, 1) { return relink(n, Op.Plain, i32_eqz, c, -1); };
    // `if c { x } else { 0 }` is c and x; `if c { 1 } else { y }`, c or y.
    let and_ = is_const(y, 0);
    let other = if and_ { x; } else if is_const(x, 1) { y; } else { -1; };
    if other < 0 or not ((w_b[n] & 2) == 2 or bool_valued(other)) or cheap(other, 6) < 0 { return false; };
    if range_test(n, c, other, and_) { return true; };
    relink(n, Op.Plain, if and_ { i32_and; } else { i32_or; }, c, other);
}

/// Node n rewritten in place as `op a` of kids k1 (and k2, if any), a
/// Bool (marked so when a Plain).
fn relink(n: I32, op: Op, a: I32, k1: I32, k2: I32) Bool {
    w_op[n] = op.to_i32();
    w_a[n] = a;
    w_b[n] = 2;
    w_first[n] = w_kids.len();
    w_kids.push(k1);
    w_count[n] = 1;
    if k2 >= 0 {
        w_kids.push(k2);
        w_count[n] = 2;
    };
    true;
}

/// A branch's value: the node a Seq of one value holds, or -1.
fn seq_value(n: I32) I32 {
    let v = n;
    while (w_op[v] == Op.Seq.to_i32()) {
        if w_count[v] != 1 { return -1; };
        v = w_kid(v, 0);
    };
    if w_type[v] == vt_i32 { v; } else { -1; };
}

fn is_const(n: I32, value: I32) Bool { w_op[n] == Op.I32Const.to_i32() and w_a[n] == value; }

/// Whether an `i32` is always 0 or 1: a comparison, a null or type test, a
/// Bool `if` or fold, 0 or 1.
fn bool_valued(n: I32) Bool {
    let op = w_op[n];
    if op == Op.RefIsNull.to_i32() or op == Op.RefEq.to_i32() or op == Op.RefTest.to_i32() { return true; };
    if op == Op.I32Const.to_i32() { return w_a[n] == 0 or w_a[n] == 1; };
    if (op == Op.If.to_i32() or op == Op.Plain.to_i32()) and (w_b[n] & 2) == 2 { return true; };
    if op == Op.Seq.to_i32() { return w_count[n] == 1 and bool_valued(w_kid(n, 0)); };
    if op == Op.Plain.to_i32() {
        let code = w_a[n];
        if code >= 69 and code <= 102 { return true; };
        if code == i32_and or code == i32_or or code == i32_xor { return bool_valued(w_kid(n, 0)) and bool_valued(w_kid(n, 1)); };
    };
    false;
}

/// What is left of `budget` instructions after n's, or -1 when n is more,
/// or may trap or have effects.
fn cheap(n: I32, budget: I32) I32 {
    let op = w_op[n];
    let ok = op == Op.I32Const.to_i32() or op == Op.I64Const.to_i32() or op == Op.F32Const.to_i32() or op == Op.F64Const.to_i32()
        or op == Op.LocalGet.to_i32() or op == Op.GlobalGet.to_i32() or op == Op.RefIsNull.to_i32() or op == Op.RefEq.to_i32()
        or (op == Op.Plain.to_i32() and pure_opcode(w_a[n]));
    if not ok or budget < 1 { return -1; };
    let left = budget - 1;
    for (0 ..< w_count[n]) |i| {
        left = cheap(w_kid(n, i), left);
        if left < 0 { return -1; };
    };
    left;
}

/// By the last @range_bound: the local compared, and the bound (an `I64`).
vec rb_local: I32 = [-1];
vec rb_value: I64 = [0];

/// A signed `i32` comparison of a local and a constant, as a bound of the
/// local: 0 `x >= v`, 1 `x <= v` (@rb_local, @rb_value); -1 none. `negate`
/// reads it as its opposite (`x < v` is not `x >= v`).
fn range_bound(n: I32, negate: Bool) I32 {
    if w_op[n] != Op.Plain.to_i32() or w_count[n] != 2 { return -1; };
    let code = w_a[n];
    // lt_s 72, gt_s 74, le_s 76, ge_s 78.
    if code != 72 and code != 74 and code != 76 and code != 78 { return -1; };
    let l = w_kid(n, 0);
    let r = w_kid(n, 1);
    // `k < x` is `x > k`.
    if w_op[l] == Op.I32Const.to_i32() and w_op[r] == Op.LocalGet.to_i32() {
        code = if code == 72 { 74; } else if code == 74 { 72; } else if code == 76 { 78; } else { 76; };
        let t = l;
        l = r;
        r = t;
    };
    if w_op[l] != Op.LocalGet.to_i32() or w_op[r] != Op.I32Const.to_i32() { return -1; };
    if negate { code = if code == 72 { 78; } else if code == 74 { 76; } else if code == 76 { 74; } else { 72; }; };
    rb_local[0] = w_a[l];
    let v = w_a[r].to_i64();
    if code == 78 { rb_value[0] = v; return 0; };
    if code == 74 { rb_value[0] = v + 1.to_i64(); return 0; };
    if code == 76 { rb_value[0] = v; return 1; };
    rb_value[0] = v - 1.to_i64();
    1;
}

/// `x >= lo and x <= hi` as `x - lo <u hi - lo + 1`, and `x < lo or x > hi`
/// as `x - lo >=u hi - lo + 1`, in node n. Whether it was.
fn range_test(n: I32, a: I32, b: I32, and_: Bool) Bool {
    let ka = range_bound(a, not and_);
    let la = rb_local[0];
    let va = rb_value[0];
    let kb = range_bound(b, not and_);
    if ka < 0 or kb < 0 or ka == kb or la != rb_local[0] { return false; };
    let lo = if ka == 0 { va; } else { rb_value[0]; };
    let hi = if ka == 0 { rb_value[0]; } else { va; };
    let span = hi - lo + 1.to_i64();
    if lo > hi or span >= 65536.to_i64() * 65536.to_i64() { return false; };
    let x = if ka == 0 { w_kid(a, 0); } else { w_kid(b, 0); };
    if w_op[x] != Op.LocalGet.to_i32() { x = if ka == 0 { w_kid(a, 1); } else { w_kid(b, 1); }; };
    let m = w_mark();
    w_push(x);
    if span == 1.to_i64() {
        w_i32(lo.to_i32());
        w_i32_op(if and_ { i32_eq; } else { i32_ne; }, m);
    } else if lo != 0.to_i64() {
        w_i32(lo.to_i32());
        w_i32_op(i32_sub, m);
    };
    if span != 1.to_i64() {
        w_i32(span.to_i32());
        w_i32_op(if and_ { i32_lt_u; } else { i32_ge_u; }, m);
    };
    // The new nodes, each held once.
    let old = node_holders.len();
    node_holders.resize(w_op.len());
    for (old ..< w_op.len()) |i| { node_holders[i] = 1; };
    relink(n, Op.Seq, 0, w_pop(), -1);
}

//! = Loads
//!
//! `x.f` read again, x the same local, where the first read has run on
//! every way there, x has not been assigned, and nothing that could write
//! the field has run (a call, or a `struct.set` of that field of any type;
//! an immutable field only x's assignment changes): the first read is teed
//! into a new local and the others read that, when there are two others or
//! more (a read is six bytes, the tee and each read of the local two, and
//! the local's declaration about as many). A walk in the order the code
//! runs keeps the reads known; what a branch, block or loop reads is
//! forgotten after it, and a loop's writes count before it.

/// The reads known: by entry, its read (a node) and its number (the order
/// the walk finds it). It still holds while nothing that writes it has run
/// since: its local's, its field's, and (a mutable field) the calls' counts
/// of writes are those it was known at.
vec ld_node: I32;
vec ld_id: I32;
vec ld_at_local: I32;
vec ld_at_field: I32;
vec ld_at_call: I32;
vec ld_mutable: U8;
/// Writes so far: by local, by field index, and calls (at `[0]`).
vec ld_local_writes: I32;
vec ld_field_writes: I32;
vec ld_call_writes: I32 = [0];
/// The reads known by what they read (op, field, local): open addressing
/// over entries, a slot empty unless stamped with this walk's @ld_stamp;
/// the slots filled.
vec ld_slot: I32;
vec ld_slot_stamp: I32;
vec ld_stamp: I32 = [0];
vec ld_filled: I32 = [0];
/// By number: its reads after (counted by the first walk), and its local
/// (-1 none yet).
vec ld_reuses: I32;
vec ld_temp: I32;
/// The walk's next number; whether it rewrites (the second walk); the function.
vec ld_next: I32 = [0];
vec ld_rewrite: I32 = [0];
vec ld_func: I32 = [0];

/// Reads reused in function f; whether any was.
fn reuse_loads(f: I32) Bool {
    ld_reuses.clear();
    ld_temp.clear();
    ld_func[0] = f;
    for (0 ..< 2) |pass| {
        ld_forget(0);
        ld_stamp[0] += 1;
        ld_filled[0] = 0;
        ld_next[0] = 0;
        ld_rewrite[0] = pass;
        ld_walk(func_body[f]);
        if pass == 0 {
            let any = false;
            for (0 ..< ld_reuses.len()) |e| { if ld_reuses[e] >= 2 { any = true; }; };
            if not any { return false; };
        };
    };
    // The nodes made, each held once.
    let old = node_holders.len();
    node_holders.resize(w_op.len());
    for (old ..< w_op.len()) |i| { node_holders[i] = 1; };
    true;
}

fn ld_walk(n: I32) void {
    let op = w_op[n];
    let count = w_count[n];
    if op == Op.Loop.to_i32() { ld_loop_writes(n); };
    // Kids from `alone` on run each (or not) from what was known before
    // them; a block's or loop's, in turn, forgotten after it.
    let alone = if op == Op.If.to_i32() or op == Op.NullElse.to_i32() or op == Op.CastArms.to_i32() { 1; }
        else if op == Op.Try.to_i32() { 0; } else { count; };
    let start = ld_node.len();
    for (0 ..< count) |i| {
        let mark = ld_node.len();
        ld_walk(w_kid(n, i));
        if i >= alone { ld_forget(mark); };
    };
    if op == Op.Block.to_i32() or op == Op.Loop.to_i32() { ld_forget(start); };
    ld_effect(n);
}

fn ld_forget(mark: I32) void {
    ld_node.resize(mark);
    ld_id.resize(mark);
    ld_at_local.resize(mark);
    ld_at_field.resize(mark);
    ld_at_call.resize(mark);
    ld_mutable.resize(mark);
}

/// Count `i` of @ld_local_writes or @ld_field_writes (0 when past its end).
fn ld_count(counts: I32, i: I32) I32 {
    if counts == 0 { return if i < ld_local_writes.len() { ld_local_writes[i]; } else { 0; }; };
    if i < ld_field_writes.len() { ld_field_writes[i]; } else { 0; };
}

/// Entry e still holds.
fn ld_holds(e: I32) Bool {
    let r = ld_node[e];
    ld_at_local[e] == ld_count(0, w_a[w_kid(r, 0)]) and ld_at_field[e] == ld_count(1, w_b[r])
        and (ld_mutable[e] == 0 or ld_at_call[e] == ld_call_writes[0]);
}

/// Reads r and n read the same: op, field, and local.
fn ld_same(r: I32, n: I32) Bool {
    w_op[r] == w_op[n] and w_a[r] == w_a[n] and w_b[r] == w_b[n] and w_a[w_kid(r, 0)] == w_a[w_kid(n, 0)];
}

fn ld_hash(n: I32) I32 {
    ((w_op[n] * 31 + w_a[n]) * 31 + w_b[n]) * 31 + w_a[w_kid(n, 0)];
}

/// The entry that holds and reads what n does, or -1.
fn ld_find(n: I32) I32 {
    if ld_slot.len() == 0 { return -1; };
    let mask = ld_slot.len() - 1;
    let h = ld_hash(n) & mask;
    while (ld_slot_stamp[h] == ld_stamp[0]) {
        let e = ld_slot[h];
        if e < ld_node.len() and ld_same(ld_node[e], n) and ld_holds(e) { return e; };
        h = (h + 1) & mask;
    };
    -1;
}

/// Entry e in the slots: in an empty one, one whose entry is forgotten, or
/// one of an entry reading the same (which no longer holds).
fn ld_place(e: I32) void {
    if (ld_filled[0] + 1) * 2 > ld_slot.len() {
        let size = if ld_slot.len() == 0 { 64; } else { ld_slot.len() * 2; };
        ld_slot.resize(size);
        ld_slot_stamp.resize(size);
        for (0 ..< size) |k| { ld_slot_stamp[k] = -1; };
        ld_filled[0] = 0;
        for (0 ..< e) |k| { ld_place(k); };
    };
    let mask = ld_slot.len() - 1;
    let h = ld_hash(ld_node[e]) & mask;
    while (ld_slot_stamp[h] == ld_stamp[0]) {
        let o = ld_slot[h];
        if o >= ld_node.len() or o == e or ld_same(ld_node[o], ld_node[e]) {
            ld_slot[h] = e;
            return;
        };
        h = (h + 1) & mask;
    };
    ld_slot_stamp[h] = ld_stamp[0];
    ld_slot[h] = e;
    ld_filled[0] += 1;
}

/// One more write to counts `counts` (as @ld_count) at i.
fn ld_bump(counts: I32, i: I32) void {
    if counts == 0 {
        while (ld_local_writes.len() <= i) { ld_local_writes.push(0); };
        ld_local_writes[i] += 1;
    } else {
        while (ld_field_writes.len() <= i) { ld_field_writes.push(0); };
        ld_field_writes[i] += 1;
    };
}

/// What a loop writes, anywhere in it, as written before it.
fn ld_loop_writes(n: I32) void {
    ld_effect_write(n);
    for (0 ..< w_count[n]) |i| { ld_loop_writes(w_kid(n, i)); };
}

/// What node n's own instruction does to the reads known.
fn ld_effect(n: I32) void {
    let op = w_op[n];
    if (op == Op.StructGet.to_i32() or op == Op.StructGetS.to_i32() or op == Op.StructGetU.to_i32())
        and w_op[w_kid(n, 0)] == Op.LocalGet.to_i32() and not non_null(w_type[n]) {
        ld_read(n);
    } else {
        ld_effect_write(n);
    };
}

fn ld_effect_write(n: I32) void {
    let op = w_op[n];
    let set = op == Op.StructSet.to_i32();
    let call = op == Op.Call.to_i32() or op == Op.CallRef.to_i32() or op == Op.ReturnCall.to_i32();
    let local = op == Op.LocalSet.to_i32() or op == Op.LocalTee.to_i32();
    if local { ld_bump(0, w_a[n]); };
    if call { ld_call_writes[0] += 1; };
    if set { ld_bump(1, w_b[n]); };
}

/// A field read of a local: one known again, or known from here.
fn ld_read(n: I32) void {
    let e = ld_find(n);
    if e >= 0 {
        ld_reuse(e, n);
        return;
    };
    ld_node.push(n);
    ld_id.push(ld_next[0]);
    ld_at_local.push(ld_count(0, w_a[w_kid(n, 0)]));
    ld_at_field.push(ld_count(1, w_b[n]));
    ld_at_call.push(ld_call_writes[0]);
    ld_mutable.push(if ht_fields[ht_a[w_a[n]] + w_b[n] * 2 + 1] == 1 { 1; } else { 0; });
    ld_place(ld_node.len() - 1);
    ld_next[0] += 1;
    if ld_rewrite[0] == 0 {
        ld_reuses.push(0);
        ld_temp.push(-1);
    };
}

/// Read n reads what known entry e's read did.
fn ld_reuse(e: I32, n: I32) void {
    let id = ld_id[e];
    if ld_rewrite[0] == 0 {
        ld_reuses[id] += 1;
        return;
    };
    if ld_reuses[id] < 2 { return; };
    let r = ld_node[e];
    if ld_temp[id] < 0 {
        let t = add_local(ld_func[0], w_type[r]);
        ld_temp[id] = t;
        // The read, teed: a copy of it in a tee where it was.
        let m = w_mark();
        w_push(w_kid(r, 0));
        let copy = w_node(Op.from_i32(w_op[r]), w_type[r], w_a[r], w_b[r], m);
        w_pop();
        w_op[r] = Op.LocalTee.to_i32();
        w_a[r] = t;
        w_b[r] = 0;
        w_first[r] = w_kids.len();
        w_kids.push(copy);
        w_count[r] = 1;
        ld_node[e] = copy;
    };
    w_op[n] = Op.LocalGet.to_i32();
    w_a[n] = ld_temp[id];
    w_b[n] = 0;
    w_count[n] = 0;
}

//! = Constants
//!
//! Folded first, and again after copies and temporaries (a value sunk into
//! place may meet a constant). An `i32` or `i64` operation of constants is
//! its value, as wasm computes it (wrapping; shift counts mod the width; a
//! division or remainder only by a positive constant). `(x + c1) + c2` is
//! `x + (c1 + c2)` and `(c1 - x) + c2` is `(c1 + c2) - x`, for any mix of
//! add and sub. `x + 0`, `x - 0`, `x * 1`, `x | 0`, `x ^ 0`, `x & -1` and a
//! shift or rotation by 0 are x; `x * 0` and `x & 0` are 0 when x has no
//! effects. A global never assigned is its constant. An `if`, `select` or
//! `br_if` on a constant takes its one way.

vec cf_changed: I32 = [0];

/// Fold function f's body; whether anything changed.
fn fold_constants(f: I32) Bool {
    cf_changed[0] = 0;
    func_body[f] = cf_fold(func_body[f]);
    cf_changed[0] == 1;
}

/// Node n folded, its kids first: n (rewritten in place), or what replaces it.
fn cf_fold(n: I32) I32 {
    for (0 ..< w_count[n]) |i| {
        let k = w_kid(n, i);
        let r = cf_fold(k);
        if r != k { set_kid(n, i, r); };
    };
    let op = w_op[n];
    let count = w_count[n];
    // A global never set is its constant (as encoding emits it).
    if op == Op.GlobalGet.to_i32() and glob_folded(w_a[n]) {
        let init = glob_init[w_a[n]];
        return cf_set(n, if w_op[init] == Op.I32Const.to_i32() { vt_i32; } else { vt_i64; }, cf_val(init));
    };
    if op == Op.Plain.to_i32() and count == 2 { return cf_binary(n); };
    if op == Op.Plain.to_i32() and count == 1 { return cf_unary(n); };
    if op == Op.Select.to_i32() and count == 3 and cf_const(w_kid(n, 2)) { return cf_select(n); };
    if op == Op.BrIf.to_i32() and count >= 1 and cf_const(w_kid(n, count - 1)) { return cf_br_if(n); };
    if op == Op.If.to_i32() and count >= 2 and cf_const(w_kid(n, 0)) { cf_if(n); };
    // What follows a `br` (as a folded `br_if` leaves), `return` or `unreachable` never runs.
    if op == Op.Seq.to_i32() or op == Op.Block.to_i32() or op == Op.Loop.to_i32() {
        let i = 0;
        while (i + 1 < count) {
            let k = w_op[w_kid(n, i)];
            if k == Op.Br.to_i32() or k == Op.Return.to_i32() or k == Op.Unreachable.to_i32() {
                w_count[n] = i + 1;
                cf_changed[0] = 1;
                return n;
            };
            i += 1;
        };
    };
    n;
}

fn cf_const(n: I32) Bool { w_op[n] == Op.I32Const.to_i32() or w_op[n] == Op.I64Const.to_i32(); }

/// A constant's value (an `i32`'s sign-extended).
fn cf_val(n: I32) I64 {
    if w_op[n] == Op.I32Const.to_i32() { return w_a[n].to_i64(); };
    (w_b[n].to_i64() << 32) | (w_a[n].to_i64() & 4294967295);
}

/// The low 32 bits of v.
fn cf_low(v: I64) I32 {
    let lo = v & 4294967295;
    if lo >= 2147483648 { lo = lo - 4294967296; };
    lo.to_i32();
}

/// Node n rewritten as the constant v (of type vt, `i32` or `i64`).
fn cf_set(n: I32, vt: I32, v: I64) I32 {
    w_op[n] = if vt == vt_i32 { Op.I32Const.to_i32(); } else { Op.I64Const.to_i32(); };
    w_type[n] = vt;
    w_a[n] = cf_low(v);
    w_b[n] = if vt == vt_i32 { 0; } else { cf_low(v >> 32); };
    w_count[n] = 0;
    cf_changed[0] = 1;
    n;
}

/// x, replacing a node (a change).
fn cf_take(x: I32) I32 {
    cf_changed[0] = 1;
    x;
}

/// v shifted right by k (0 to 63), zeros in.
fn cf_shr_u(v: I64, k: I64) I64 {
    if k == 0 { return v; };
    (v >> k) & ((1.to_i64() << (64.to_i64() - k)) - 1);
}

/// A binary `i32` or `i64` instruction.
fn cf_binary(n: I32) I32 {
    let code = w_a[n];
    let wide = (code >= 81 and code <= 90) or (code >= 124 and code <= 138);
    if not (wide or (code >= 70 and code <= 79) or (code >= 106 and code <= 120)) { return n; };
    // In the `i32` instructions' numbering.
    let op = if code >= 124 { code - 18; } else if code >= 81 and code <= 90 { code - 11; } else { code; };
    let vt = if wide and op >= 106 { vt_i64; } else { vt_i32; };
    let l = w_kid(n, 0);
    let r = w_kid(n, 1);
    if cf_const(l) and cf_const(r) {
        let a = cf_val(l);
        let b = cf_val(r);
        if op <= 79 { return cf_set(n, vt_i32, if cf_compare(op, a, b, wide) { 1; } else { 0; }); };
        // A division or remainder that could trap is left to trap.
        if op >= 109 and op <= 112 and (b <= 0 or (wide and (op == 110 or op == 112))) { return n; };
        return cf_set(n, vt, cf_arith(op, a, b, wide));
    };
    if op <= 79 { return n; };
    // Identities, the constant on the right (or either side, where the order does not matter).
    let commutes = op == 106 or op == 108 or op == 113 or op == 114 or op == 115;
    for (0 ..< 2) |side| {
        let c = if side == 0 { r; } else { l; };
        let x = if side == 0 { l; } else { r; };
        if cf_const(c) and (side == 0 or commutes) {
            let v = cf_val(c);
            let shift = op >= 116 and op <= 120 and (if wide { v & 63; } else { v & 31; }) == 0;
            if (v == 0 and (op == 106 or op == 107 or op == 114 or op == 115)) or shift or (v == 1 and op == 108) or (v == -1 and op == 113) {
                return cf_take(x);
            };
            if v == 0 and (op == 108 or op == 113) and opt_pure(x) { return cf_set(n, vt, 0); };
        };
    };
    if op == 106 or op == 107 { return cf_reassociate(n, op, wide); };
    n;
}

/// An `i32` comparison (by its opcode; `wide`, of `i64`s) of a and b.
fn cf_compare(op: I32, a: I64, b: I64, wide: Bool) Bool {
    let x = a;
    let y = b;
    // Unsigned: as signed, with the sign bit flipped (`i64`) or no sign (`i32`).
    if op == 73 or op == 75 or op == 77 or op == 79 {
        let flip = 1.to_i64() << 63;
        if wide {
            x = a ^ flip;
            y = b ^ flip;
        } else {
            x = a & 4294967295;
            y = b & 4294967295;
        };
    };
    if op == 70 { return x == y; };
    if op == 71 { return x != y; };
    if op == 72 or op == 73 { return x < y; };
    if op == 74 or op == 75 { return x > y; };
    if op == 76 or op == 77 { return x <= y; };
    x >= y;
}

/// An `i32` arithmetic instruction (by its opcode; `wide`, of `i64`s) of a
/// and b: its result's low bits.
fn cf_arith(op: I32, a: I64, b: I64, wide: Bool) I64 {
    // a unsigned (an `i32`'s; an `i64`'s unsigned division is not folded).
    let u = if wide { a; } else { a & 4294967295; };
    let width: I64 = if wide { 64; } else { 32; };
    let k = b & (width - 1);
    if op == 106 { return a + b; };
    if op == 107 { return a - b; };
    if op == 108 { return a * b; };
    if op == 109 { return a / b; };
    if op == 110 { return u / b; };
    if op == 111 { return a % b; };
    if op == 112 { return u % b; };
    if op == 113 { return a & b; };
    if op == 114 { return a | b; };
    if op == 115 { return a ^ b; };
    if op == 116 { return a << k; };
    if op == 117 { return a >> k; };
    if op == 118 { return cf_shr_u(u, k); };
    // rotr by k is rotl by width - k.
    let left = if op == 119 { k; } else { (width - k) & (width - 1); };
    if left == 0 { return a; };
    (u << left) | cf_shr_u(u, width - left);
}

/// n an add or sub of a constant and `x ± c` (or `c - x`): x plus a
/// constant, or a constant minus x.
fn cf_reassociate(n: I32, op: I32, wide: Bool) I32 {
    let l = w_kid(n, 0);
    let r = w_kid(n, 1);
    let add = if wide { 124; } else { 106; };
    let sub = add + 1;
    // n is `k + other`, or `k - other` when negated.
    let c = if cf_const(r) { r; } else if cf_const(l) { l; } else { -1; };
    if c < 0 { return n; };
    let other = if c == r { l; } else { r; };
    let k = cf_val(c);
    if c == r and op == 107 { k = 0.to_i64() - k; };
    let negated = c == l and op == 107;
    if w_op[other] != Op.Plain.to_i32() or w_count[other] != 2 or (w_a[other] != add and w_a[other] != sub) { return n; };
    // other is `j + x`, or `j - x` when x is negated.
    let ol = w_kid(other, 0);
    let or_ = w_kid(other, 1);
    let x = -1;
    let j = 0.to_i64();
    let x_negated = false;
    if cf_const(or_) and not cf_const(ol) {
        x = ol;
        j = cf_val(or_);
        if w_a[other] == sub { j = 0.to_i64() - j; };
    } else if cf_const(ol) and not cf_const(or_) {
        x = or_;
        j = cf_val(ol);
        x_negated = w_a[other] == sub;
    } else {
        return n;
    };
    cf_set(c, w_type[n], if negated { k - j; } else { k + j; });
    let minus = negated != x_negated;
    if not minus and cf_val(c) == 0 { return x; };
    if minus {
        w_a[n] = sub;
        set_kid(n, 0, c);
        set_kid(n, 1, x);
    } else {
        w_a[n] = add;
        set_kid(n, 0, x);
        set_kid(n, 1, c);
    };
    n;
}

/// A unary `i32` or `i64` instruction.
fn cf_unary(n: I32) I32 {
    let code = w_a[n];
    let kid = w_kid(n, 0);
    if not cf_const(kid) { return n; };
    let a = cf_val(kid);
    if code == 69 or code == 80 { return cf_set(n, vt_i32, if a == 0 { 1; } else { 0; }); };
    if code == 167 { return cf_set(n, vt_i32, a); };
    if code == 172 { return cf_set(n, vt_i64, a); };
    if code == 173 { return cf_set(n, vt_i64, a & 4294967295); };
    // extend8_s, extend16_s (`i32`); extend8_s, 16_s, 32_s (`i64`).
    if code >= 192 and code <= 196 {
        let drop: I64 = if code == 192 or code == 194 { 56; } else if code == 193 or code == 195 { 48; } else { 32; };
        return cf_set(n, if code <= 193 { vt_i32; } else { vt_i64; }, (a << drop) >> drop);
    };
    n;
}

/// `select` on a constant: the value taken, when the other has no effects.
fn cf_select(n: I32) I32 {
    let on = w_a[w_kid(n, 2)] != 0;
    if not opt_pure(w_kid(n, if on { 1; } else { 0; })) { return n; };
    cf_take(w_kid(n, if on { 0; } else { 1; }));
}

/// `br_if` on a constant: `br`, or nothing (its value, if any).
fn cf_br_if(n: I32) I32 {
    let count = w_count[n];
    cf_changed[0] = 1;
    if w_a[w_kid(n, count - 1)] != 0 {
        w_op[n] = Op.Br.to_i32();
        w_count[n] = count - 1;
        if count == 1 { w_type[n] = vt_unreachable; };
        return n;
    };
    if count == 1 {
        opt_erase(n);
        return n;
    };
    w_kid(n, 0);
}

/// `if` on a constant: the arm taken, in a block of the `if`'s label and
/// type (a branch to it still leaves it), or nothing.
fn cf_if(n: I32) void {
    cf_changed[0] = 1;
    let on = w_a[w_kid(n, 0)] != 0;
    if not on and w_count[n] == 2 {
        opt_erase(n);
        return;
    };
    let arm = w_kid(n, if on { 1; } else { 2; });
    w_op[n] = if w_a[n] >= 0 { Op.Block.to_i32(); } else { Op.Seq.to_i32(); };
    w_b[n] = 0;
    set_kid(n, 0, arm);
    w_count[n] = 1;
}

