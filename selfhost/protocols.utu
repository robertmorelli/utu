//! = Protocols
//!
//! `proto P: | get a: I32 | foo(I32) Str` names what types that list it
//! (`struct T[P]:`) provide: a field for each getter and setter, a function
//! `fn P[T].foo |self| (x: I32) Str` for each method. A P is any of them,
//! an anyref; reading `a.x` or calling `p.foo(…)` tests which one it is, in the
//! order the types are declared, as stage 0 does:
//!
//! ```
//! r = receiver (args into locals)
//! if ref.test $T1 r { (T1's field, or P[T1].foo(r, …)) } else if … else { unreachable }
//! ```

/// Whether type declaration `t` lists protocol `proto` (a struct, or an enum for its variants).
fn implements(t: I32, proto: I32) Bool {
    let d = if decl_is(t, Decl.Variant) { decl_owner[t]; } else { t; };
    let list = impl_list_of(d);
    if list < 0 { return false; };
    let c = first_child(list);
    while (c >= 0) {
        if node_decl[c] == proto { return true; };
        c = next_sibling(c);
    };
    false;
}

/// The `[P, …]` list of a struct or enum declaration, or -1.
fn impl_list_of(d: I32) I32 {
    if not decl_is(d, Decl.Struct) and not decl_is(d, Decl.Enum) { return -1; };
    let c = first_child(decl_node[d]);
    while (c >= 0) {
        if is_kind(c, Node.Impl_list) { return c; };
        c = next_sibling(c);
    };
    -1;
}

/// Whether a value of `actual` converts to protocol type `expected`.
fn converts_to_proto(actual: I32, expected: I32) Bool {
    let p = ty_decl(expected);
    if not decl_is(p, Decl.Proto) { return false; };
    let t = ty_decl(actual);
    t >= 0 and implements(t, p);
}

/// The struct types (and variants) implementing a protocol, in declaration order.
fn implementers(proto: I32) I32 {
    let m = vl_begin();
    for (0 ..< decl_kind.len()) |d| {
        if decl_is(d, Decl.Struct) and implements(d, proto) { vl_add(d); };
        if decl_is(d, Decl.Variant) and implements(d, proto) { vl_add(d); };
    };
    vl_end(m);
}

/// The implementations of a protocol method: `fn P[T].name`, in declaration
/// order, as pairs (function, the type T's declaration).
fn method_impls(proto: I32, word: I32) I32 {
    let m = vl_begin();
    for (0 ..< decl_kind.len()) |d| {
        if decl_is(d, Decl.Fn) and decl_a[d] == proto and is_kind(decl_node[d], Node.Fn_decl) {
            let name = first_child(decl_node[d]);
            if word_of(last_child(name)) == word {
                let args = next_sibling(first_child(name));
                // (`P[Nope]`, of no type, was reported: it implements nothing.)
                let named_decl = if is_kind(args, Node.Module_type_arg_list) { node_decl[name_node(first_child(first_child(args)))]; } else { -1; };
                if named_decl >= 0 {
                    let t = decl_type(named_decl, 0);
                    if ty_decl(t) >= 0 {
                        vl_add(d);
                        vl_add(ty_decl(t));
                    };
                };
            };
        };
    };
    vl_end(m);
}

/// The protocol member a word names, or -1.
fn protocol_member(proto: I32, word: I32) I32 {
    let d = member(proto, word, Space.Member);
    if decl_is(d, Decl.ProtoMember) { d; } else { -1; };
}

/// The type of a protocol getter or setter, or a method's result.
fn proto_member_type(pm: I32) I32 { type_of(last_child(decl_node[pm]), 0); }

/// `p.x`: the field x of whichever implementing type p is.
fn proto_field_get(t: I32, name: I32, m: I32) I32 {
    let proto = ty_decl(t);
    let pm = protocol_member(proto, word_of(name));
    if pm < 0 or is_kind(decl_node[pm], Node.Proto_method) {
        report2(Diag.UnknownField, parent_of(name), word_of(name), proto, -1);
        w_node(Op.Unreachable, vt_unreachable, 0, 0, m);
        return ty_error();
    };
    let ft = proto_member_type(pm);
    let r = new_local(vt_anyref);
    w_node(Op.LocalSet, vt_none, r, 0, m);
    proto_field_chain(implementers(proto), 0, r, word_of(name), ft, -1);
    w_node(Op.Seq, repr(ft), 0, 0, m);
    ft;
}

/// `p.x = v`: the field x of whichever implementing type p is.
fn proto_field_set(t: I32, name: I32, value: I32, m: I32, cx: Cx) I32 {
    let proto = ty_decl(t);
    let pm = protocol_member(proto, word_of(name));
    if pm < 0 or is_kind(decl_node[pm], Node.Proto_method) {
        report2(Diag.UnknownField, parent_of(name), word_of(name), proto, -1);
        w_node(Op.Unreachable, vt_unreachable, 0, 0, m);
        return ty_error();
    };
    let ft = proto_member_type(pm);
    let r = new_local(vt_anyref);
    w_node(Op.LocalSet, vt_none, r, 0, m);
    let v = new_local(repr(ft));
    let mv = w_mark();
    coerce(check_expr(value, ft, cx), ft, value);
    w_node(Op.LocalSet, vt_none, v, 0, mv);
    proto_field_chain(implementers(proto), 0, r, word_of(name), ft, v);
    w_node(Op.Seq, vt_none, 0, 0, m);
    ty_void();
}

/// The `if ref.test` chain reading field `word` of receiver local `r` (or,
/// when `v` is a local, writing `v` to it), from implementer `i` on; past
/// the last, `unreachable`.
fn proto_field_chain(impls: I32, i: I32, r: I32, word: I32, ft: I32, v: I32) void {
    if i == vl_len[impls] {
        w_leaf(Op.Unreachable, vt_unreachable, 0, 0);
        return;
    };
    let d = vl_item(impls, i);
    let heap = vt_heap(repr(named(d, 0)));
    let field = decl_a[member(d, word, Space.Member)];
    let result = if v >= 0 { vt_none; } else { repr(ft); };
    let m = w_mark();
    let mt = proto_test_cast(r, heap);
    let mf = w_stack.len() - 1;
    if v >= 0 {
        w_get(repr(ft), v);
        w_node(Op.StructSet, vt_none, heap, field, mf);
    } else {
        w_node(Op.StructGet, repr(ft), heap, field, mf);
    };
    w_node(Op.Seq, result, 0, 0, mt);
    let me = w_mark();
    proto_field_chain(impls, i + 1, r, word, ft, v);
    w_node(Op.Seq, result, 0, 0, me);
    w_node(Op.If, result, new_label(), 0, m);
}

/// An arm's head in a protocol's dispatch: `ref.test` of receiver local `r`
/// against implementer type `heap`, then (the arm's start, returned) `r`
/// cast to it.
fn proto_test_cast(r: I32, heap: I32) I32 {
    let vt = vt_ref(heap, false);
    let mc = w_mark();
    w_get(vt_anyref, r);
    w_node(Op.RefTest, vt_i32, vt, 0, mc);
    let mt = w_mark();
    let mcast = w_mark();
    w_get(vt_anyref, r);
    w_node(Op.RefCast, vt, vt, 0, mcast);
    mt;
}

/// `p.foo(args)`: the receiver is on the stack since `m`.
fn proto_call(t: I32, name: I32, args: I32, m: I32, at: I32, cx: Cx) I32 {
    let proto = ty_decl(t);
    let pm = protocol_member(proto, word_of(name));
    if pm < 0 or not is_kind(decl_node[pm], Node.Proto_method) {
        report2(Diag.UnknownMethod, at, word_of(name), t, -1);
        return finish_error(args, m, cx);
    };
    let rt = proto_member_type(pm);
    let r = new_local(vt_anyref);
    w_node(Op.LocalSet, vt_none, r, 0, m);
    // The arguments, against the protocol's parameter types, into locals.
    let list = next_sibling(first_child(decl_node[pm]));
    let n = 0;
    let a = if args >= 0 { first_child(args); } else { -1; };
    let p = if is_kind(list, Node.Type_list) { first_child(list); } else { -1; };
    let locals = Array[I32].new(16, 0);
    let types = Array[I32].new(16, 0);
    while (a >= 0 and p >= 0) {
        let pt = type_of(p, 0);
        let local = new_local(repr(pt));
        let ma = w_mark();
        coerce(check_expr(a, pt, cx), pt, a);
        w_node(Op.LocalSet, vt_none, local, 0, ma);
        locals[n] = local;
        types[n] = pt;
        n += 1;
        a = next_sibling(a);
        p = next_sibling(p);
    };
    if a >= 0 or p >= 0 {
        let want = if is_kind(list, Node.Type_list) { child_count(list); } else { 0; };
        report2(Diag.WrongArity, at, -1, want, child_count(args));
        w_node(Op.Unreachable, vt_unreachable, 0, 0, m);
        return ty_error();
    };
    proto_call_chain(method_impls(proto, word_of(name)), 0, r, locals, types, n, rt, cx);
    w_node(Op.Seq, repr(rt), 0, 0, m);
    rt;
}

fn proto_call_chain(impls: I32, i: I32, r: I32, locals: Array[I32], types: Array[I32], n: I32, rt: I32, cx: Cx) void {
    if i * 2 >= vl_len[impls] {
        w_leaf(Op.Unreachable, vt_unreachable, 0, 0);
        return;
    };
    let f = vl_item(impls, i * 2);
    let m = w_mark();
    let mt = proto_test_cast(r, vt_heap(repr(named(vl_item(impls, i * 2 + 1), 0))));
    let mcall = w_stack.len() - 1;
    for (0 ..< n) |k| { w_get(repr(types[k]), locals[k]); };
    finish_call(fn_instance(f, 0), mcall, cx);
    w_node(Op.Seq, repr(rt), 0, 0, mt);
    let me = w_mark();
    proto_call_chain(impls, i + 1, r, locals, types, n, rt, cx);
    w_node(Op.Seq, repr(rt), 0, 0, me);
    w_node(Op.If, repr(rt), new_label(), 0, m);
}

//! = Conformance
//!
//! Each type that lists a protocol has a field (of the same written type)
//! for each of its getters and setters, and an implementation P[T].m with
//! the method's signature for each of its methods.

/// Conformance of each type in the program's own files to the protocols it lists.
fn validate_protocols() void {
    for (0 ..< decl_kind.len()) |d| {
        if (decl_is(d, Decl.Struct) or decl_is(d, Decl.Enum)) and is_own_file(file_of_token(node_first[decl_node[d]])) {
            let list = impl_list_of(d);
            if list >= 0 {
                let c = first_child(list);
                while (c >= 0) {
                    let proto = node_decl[c];
                    if decl_is(proto, Decl.Proto) {
                        if decl_is(d, Decl.Enum) {
                            let v = first_child(decl_node[d]);
                            while (v >= 0) {
                                if is_kind(v, Node.Variant) { conforms(node_decl[first_child(v)], proto); };
                                v = next_sibling(v);
                            };
                        } else {
                            conforms(d, proto);
                        };
                    };
                    c = next_sibling(c);
                };
            };
        };
    };
}

/// Reports each member of `proto` that type `t` lacks, or has with another
/// type or signature.
fn conforms(t: I32, proto: I32) void {
    let c = first_child(decl_node[proto]);
    while (c >= 0) {
        if is_kind(c, Node.Proto_member) {
            let m = first_child(c);
            let word = word_of(first_child(m));
            if is_kind(m, Node.Proto_method) {
                let impls = method_impls(proto, word);
                let found = -1;
                let i = 0;
                while (i < vl_len[impls]) {
                    if vl_item(impls, i + 1) == t { found = vl_item(impls, i); };
                    i += 2;
                };
                if found < 0 {
                    report3(Diag.ProtoMissing, decl_node[t], word, t, 0, decl_name[proto]);
                } else if not same_signature(found, m) {
                    report3(Diag.ProtoSignature, decl_node[found], word, decl_name[proto], decl_name[t], -1);
                };
            } else {
                let field = member(t, word, Space.Member);
                if not decl_is(field, Decl.Field) or type_of(last_child(decl_node[field]), 0) != type_of(last_child(m), 0) {
                    report3(Diag.ProtoMissing, decl_node[t], word, t, 1, decl_name[proto]);
                };
            };
        };
        c = next_sibling(c);
    };
}

/// Whether an implementation's parameters and result are the method's.
fn same_signature(f: I32, method: I32) Bool {
    let list = next_sibling(first_child(method));
    let params = param_list_of(f);
    let p = if params >= 0 { first_child(params); } else { -1; };
    let q = if is_kind(list, Node.Type_list) { first_child(list); } else { -1; };
    while (p >= 0 and q >= 0) {
        if type_of(last_child(p), 0) != type_of(q, 0) { return false; };
        p = next_sibling(p);
        q = next_sibling(q);
    };
    if p >= 0 or q >= 0 { return false; };
    let ret = -1;
    let c = first_child(decl_node[f]);
    while (c >= 0) {
        if is_kind(c, Node.Return_type) { ret = c; };
        c = next_sibling(c);
    };
    type_of(ret, 0) == type_of(last_child(method), 0);
}
