// fannkuch-redux from the Computer Language Benchmarks Game, after its
// single-threaded C program: permutations generated in place with a count
// array, each one flipped (prefix reversal) until its first element is 0.
// Every port in this directory computes the same algorithm step for step.

// checksum * 1000 + max_flips for all permutations of 0..<n.
fn fannkuch(n: I32) I64 {
    let perm = Array[I32].new(n, 0);
    let perm1 = Array[I32].new(n, 0);
    let count = Array[I32].new(n, 0);
    for (0..<n) |i| { perm1[i] = i; };
    let max_flips = 0;
    let checksum = 0;
    let perm_count = 0;
    let r = n;
    while (true) {
        while (r != 1) {
            count[r - 1] = r;
            r -= 1;
        };
        for (0..<n) |i| { perm[i] = perm1[i]; };
        let flips = 0;
        let k = perm[0];
        while (k != 0) {
            let k2 = (k + 1) >> 1;
            for (0..<k2) |i| {
                let t = perm[i];
                perm[i] = perm[k - i];
                perm[k - i] = t;
            };
            flips += 1;
            k = perm[0];
        };
        if flips > max_flips { max_flips = flips; };
        if perm_count % 2 == 0 { checksum += flips; } else { checksum -= flips; };
        // The next permutation: rotate the first r + 1 elements left until a count stays positive.
        while (true) {
            if r == n { return checksum.to_i64() * 1000 + max_flips.to_i64(); };
            let perm0 = perm1[0];
            for (0..<r) |i| { perm1[i] = perm1[i + 1]; };
            perm1[r] = perm0;
            count[r] -= 1;
            if count[r] > 0 { break; };
            r += 1;
        };
        perm_count += 1;
    };
    fatal;
}

test "fannkuch matches the Benchmarks Game's reference output" {
    assert fannkuch(7) == 228016;
}

export lib {
    fn bench(iterations: I32) I64 {
        let sink: I64 = 0;
        for (0..<iterations) { sink += fannkuch(9); };
        sink;
    }
}
