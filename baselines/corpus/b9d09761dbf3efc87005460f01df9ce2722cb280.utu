// Generated from data/style.css by tools/build-wutu.mjs. Do not edit.
mod style {
    fn sheet() Str {
        @css/\
/* Foundry — one stylesheet, shared by the wutu, React, and Leptos builds. */
:root {
  color-scheme: dark;
  --bg: #12151a;
  --panel: #1b2027;
  --panel-2: #232a33;
  --line: #2f3843;
  --text: #dfe6ee;
  --muted: #8a96a3;
  --accent: #f0a73a;
  --good: #4cc38a;
  --bad: #e5534b;
  --info: #4da3ff;
  font: 13px/1.35 system-ui, sans-serif;
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--text); overflow: hidden; }
button, select, input, textarea { font: inherit; color: inherit; }
button {
  background: var(--panel-2); border: 1px solid var(--line); border-radius: 4px;
  padding: 3px 8px; cursor: pointer;
}
button:hover:not(:disabled) { border-color: var(--accent); }
button:disabled { opacity: 0.4; cursor: default; }
button.active { background: var(--accent); color: #111; border-color: var(--accent); }
select, input, textarea { background: var(--bg); border: 1px solid var(--line); border-radius: 4px; padding: 2px 6px; }

.app {
  display: grid; height: 100vh;
  grid-template: "hud hud hud" auto "palette map inspector" 1fr "footer footer footer" 132px / 190px 1fr 330px;
}
.hud {
  grid-area: hud; display: flex; flex-wrap: wrap; gap: 14px; align-items: center;
  padding: 6px 10px; background: var(--panel); border-bottom: 1px solid var(--line);
}
.hud-group { display: flex; gap: 6px; align-items: center; }
.hud-title { font-weight: 700; letter-spacing: 0.08em; color: var(--accent); }
.counter { display: grid; text-align: center; min-width: 54px; }
.counter b { font-variant-numeric: tabular-nums; }
.counter small, .muted { color: var(--muted); font-size: 11px; }
.meter { width: 120px; height: 10px; background: var(--bg); border: 1px solid var(--line); border-radius: 5px; overflow: hidden; }
.meter > i { display: block; height: 100%; background: var(--good); }
.meter.low > i { background: var(--bad); }
.meter.research > i { background: var(--info); }

.palette { grid-area: palette; background: var(--panel); border-right: 1px solid var(--line); overflow-y: auto; padding: 8px; }
.tabs { display: flex; flex-wrap: wrap; gap: 3px; margin-bottom: 8px; }
.tabs button { font-size: 11px; padding: 2px 5px; }
.machines { display: grid; gap: 4px; }
.machine-btn { display: flex; gap: 6px; align-items: center; text-align: left; }
.glyph {
  display: inline-grid; place-items: center; width: 24px; height: 24px; border-radius: 3px;
  font-size: 10px; font-weight: 700; color: #111; flex: none;
}
.tools { display: flex; gap: 4px; margin-top: 10px; flex-wrap: wrap; }

.map { grid-area: map; position: relative; overflow: hidden; background: #0c0e11; }
.map canvas { display: block; width: 100%; height: 100%; cursor: crosshair; }

.inspector { grid-area: inspector; background: var(--panel); border-left: 1px solid var(--line); overflow-y: auto; padding: 8px; display: grid; gap: 8px; align-content: start; }
.panel { background: var(--panel-2); border: 1px solid var(--line); border-radius: 6px; }
.panel.selected { border-color: var(--accent); }
.panel-head { display: flex; gap: 6px; align-items: center; padding: 6px 8px; border-bottom: 1px solid var(--line); }
.panel-head h3 { margin: 0; font-size: 13px; flex: 1; }
.panel-head button { padding: 1px 6px; }
.panel-body { padding: 8px; display: grid; gap: 6px; }
.row { display: flex; justify-content: space-between; gap: 8px; align-items: center; }
.bar { height: 8px; background: var(--bg); border-radius: 4px; overflow: hidden; flex: 1; }
.bar > i { display: block; height: 100%; background: var(--accent); }
.bar.good > i { background: var(--good); }
.bar.info > i { background: var(--info); }
.slots { display: flex; gap: 4px; flex-wrap: wrap; }
.slot {
  width: 38px; height: 38px; border: 1px solid var(--line); border-radius: 4px; background: var(--bg);
  display: grid; place-items: center; position: relative; font-size: 10px;
}
.slot b { position: absolute; right: 2px; bottom: 0; font-size: 11px; }
.dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; vertical-align: middle; }
.grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3px; }
.grid3 > div { height: 34px; border-radius: 3px; display: grid; place-items: center; font-size: 10px; color: #111; }
.recipe-grid { display: flex; flex-wrap: wrap; gap: 4px; }
.lane { position: relative; height: 18px; background: #2a2f36; border-radius: 3px; }
.lane > i { position: absolute; top: 4px; width: 10px; height: 10px; border-radius: 50%; }
.gauges { display: flex; gap: 10px; align-items: flex-end; }
.gauge { width: 26px; height: 70px; background: var(--bg); border: 1px solid var(--line); border-radius: 3px; display: flex; align-items: flex-end; overflow: hidden; }
.gauge > i { display: block; width: 100%; }
.lamp { width: 64px; height: 64px; border-radius: 50%; background: #333; margin: auto; }
.lamp.on { background: #ffe066; box-shadow: 0 0 24px #ffe066; }
.flame { width: 16px; height: 16px; border-radius: 50% 50% 50% 0; transform: rotate(-45deg); background: #444; }
.flame.on { background: #ff8a3a; box-shadow: 0 0 10px #ff8a3a; }
.chest-grid { display: grid; grid-template-columns: repeat(8, 1fr); gap: 2px; }
.chest-grid > div { height: 26px; border: 1px solid var(--line); border-radius: 2px; position: relative; font-size: 9px; display: grid; place-items: center; }
.tank { width: 70px; height: 90px; border: 2px solid var(--line); border-radius: 8px; display: flex; align-items: flex-end; overflow: hidden; margin: auto; }
.tank > i { display: block; width: 100%; }
.reach { display: flex; gap: 2px; }
.reach > div { width: 20px; height: 20px; border: 1px solid var(--line); border-radius: 2px; }
.reach > .src { background: var(--info); }
.reach > .dst { background: var(--good); }
.reach > .me { background: var(--accent); }
.items { display: flex; flex-wrap: wrap; gap: 3px; }
.items button { padding: 2px; }
table { border-collapse: collapse; width: 100%; }
td, th { padding: 2px 4px; text-align: left; border-bottom: 1px solid var(--line); }
td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }

.footer { grid-area: footer; display: grid; grid-template-columns: 1fr 200px 260px; background: var(--panel); border-top: 1px solid var(--line); }
.alerts { padding: 6px 10px; overflow: hidden; display: grid; gap: 2px; align-content: start; }
.alert { color: var(--accent); }
.alert.bad { color: var(--bad); }
.alert.good { color: var(--good); }
.minimap { border-left: 1px solid var(--line); display: grid; place-items: center; }
.minimap canvas { image-rendering: pixelated; max-width: 190px; max-height: 120px; }
.tileinfo { border-left: 1px solid var(--line); padding: 6px 10px; }

.window {
  position: fixed; inset: 60px 360px 150px 210px; background: var(--panel); border: 1px solid var(--line);
  border-radius: 8px; box-shadow: 0 12px 40px #000a; display: grid; grid-template-rows: auto 1fr; z-index: 5;
}
.window-head { display: flex; justify-content: space-between; align-items: center; padding: 8px 12px; border-bottom: 1px solid var(--line); }
.window-head h2 { margin: 0; font-size: 15px; }
.window-body { overflow-y: auto; padding: 10px 12px; }
.techs { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 8px; }
.tech { background: var(--panel-2); border: 1px solid var(--line); border-radius: 6px; padding: 8px; display: grid; gap: 4px; text-align: left; }
.tech.done { opacity: 0.55; }
.tech.available { border-color: var(--info); }
.tech.current { border-color: var(--accent); }
.tech.locked { opacity: 0.35; }
.spark { width: 160px; height: 24px; }
.spark path { fill: none; stroke: var(--accent); stroke-width: 1.5; }
.graph { width: 100%; height: 120px; background: var(--bg); border-radius: 4px; }
.graph path { fill: none; stroke-width: 2; }
.graph .supply { stroke: var(--good); }
.graph .demand { stroke: var(--bad); }
.saves { display: grid; gap: 10px; }
.saves textarea { width: 100%; height: 120px; font: 11px monospace; }
#bench-result { position: fixed; right: 4px; bottom: 4px; margin: 0; font-size: 10px; color: var(--muted); z-index: 10; }
\/;
    }
}
