using Browser from std:Browser;

fn number(value: I32) Str {
    value.to_f64().toString();
}

fn money(cents: I32) Str {
    "$" + (cents.to_f64() / 100.0).toFixed(2);
}

fn node(id: Str) Browser.HTMLElement {
    Browser.document.getElementById(id) orelse fatal;
}

fn restore_focus(id: Str) void {
    promote Browser.document.getElementById(id) {
        |element| => element.focus(), ~> {
        },
    };
}

fn persist(key: Str,
value: Str) void {
    try {
        Browser.localStorage.setItem(key, value);
    } catch {
        node("notice").textContent = "Storage is unavailable. Your changes will last for this session.";
    };
}

struct Dish:
    | id: Str
    | title: Str
    | description: Str
    | category: Str
    | price: I32
    | quantity: I32

struct Menu:
    | dishes: Array[Dish]
    | category: Str

fn save(state: Menu) void {
    let data = Browser.Array();
    state.dishes each |dish| {
        data.push(&{
            id: dish.id,
            quantity: dish.quantity
        });
    };
    persist("juniper-v1", Browser.JSON.stringify(data));
}

fn update(state: Menu) void {
    save(state);
}

fn dish_card(dish: Dish,
state: Menu) Browser.HTMLElement {
    @wutu/\
    article.dish {
        display:grid;
        gap:0.9rem;
        padding:1.5rem;
        border:1px solid var(--line);
        border-radius:1rem;
        background:var(--panel);
        p.eyebrow {
            color:var(--accent);
            = dish.category;
        }
        h3 {
            font:500 1.8rem Georgia, serif;
            = dish.title;
        }
        p.muted {
            line-height:1.65;
            min-block-size:3.5rem;
            = dish.description;
        }
        div {
            display:flex;
            justify-content:space-between;
            align-items:center;
            gap:1rem;
            strong {
                = money(dish.price);
            }
            button {
                id = $["add-" + dish.id];
                disabled = $[dish.quantity >= 20];
                aria-label = $["Add " + dish.title];
                "Add +";
                on click {
                    if dish.quantity<20 {
                        dish.quantity += 1;
                        update(state);
                        restore_focus("add-" + dish.id);
                    };
                };
            }
        }
    }
    \/;
}

fn menu(state: Menu) Browser.HTMLElement {
    @wutu/\
    div {
        id = "menu";
        display:grid;
        grid-template-columns:repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
        gap:1rem;
        for $[state.dishes filter |dish| { state.category == "All" or dish.category == state.category; }] |dish| key $[dish.id] {
            = dish_card(dish, state);
        }
    }
    \/;
}

fn basket(state: Menu) Browser.HTMLElement {
    let total = state.dishes fold(0)|acc, dish| {
        acc + dish.price * dish.quantity;
    };
    let count = state.dishes map |dish| {
        dish.quantity;
    } sum;
    @wutu/\
    aside {
        id = "basket";
        display:grid;
        gap:1.25rem;
        padding:1.75rem;
        background:var(--panel);
        border:1px solid var(--line);
        border-radius:1rem;
        align-content:start;
        p.eyebrow {
            "YOUR TABLE, YOUR PACE";
        }
        h2 {
            font:500 2rem Georgia, serif;
            "Your order notes";
        }
        p.muted {
            role = "status";
            = number(count);
            = if count == 1 {
                " item · a draft, not a placed order";
            }
            else {
                " items · a draft, not a placed order";
            };
        }
        for $[state.dishes filter |dish| { dish.quantity>0; }] |dish| key $[dish.id] {
            div {
                display:grid;
                grid-template-columns:1fr auto;
                gap:0.5rem;
                padding-block-end:1rem;
                border-block-end:1px solid var(--line);
                strong {
                    = dish.title;
                }
                span {
                    = money(dish.price * dish.quantity);
                }
                div {
                    grid-column:1 / -1;
                    display:flex;
                    gap:0.6rem;
                    align-items:center;
                    button {
                        id = $["minus-" + dish.id];
                        aria-label = $["Remove one " + dish.title];
                        "−";
                        on click {
                            dish.quantity -= 1;
                            update(state);
                            restore_focus(if dish.quantity>0 {
                                "minus-" + dish.id;
                            }
                            else {
                                "add-" + dish.id;
                            });
                        };
                    }
                    span {
                        = number(dish.quantity);
                    }
                    button {
                        id = $["plus-" + dish.id];
                        disabled = $[dish.quantity >= 20];
                        aria-label = $["Add another " + dish.title];
                        "+";
                        on click {
                            if dish.quantity<20 {
                                dish.quantity += 1;
                                update(state);
                                restore_focus("plus-" + dish.id);
                            };
                        };
                    }
                }
            }
        }
        if $[count == 0] {
            p.empty {
                "Something delicious starts with one choice. Add an item from the menu.";
            }
        }
        div {
            display:flex;
            justify-content:space-between;
            font-size:1.3rem;
            strong {
                "Subtotal";
            }
            strong {
                id = "subtotal";
                = money(total);
            }
        }
        p.muted {
            font-size:0.8rem;
            line-height:1.6;
            "Tax and service are not included. Save your choices here and show them to your server. No payment is collected.";
        }
        button {
            disabled = $[count == 0];
            "Clear order notes";
            on click {
                state.dishes each |dish| {
                    dish.quantity = 0;
                };
                update(state);
            };
        }
    }
    \/;
}

export main() void {
    let state = Menu {
        category: "All",
        dishes: [
        Dish {
            id: "toast",
            title: "Garden toast",
            description: "Whipped ricotta, slow tomatoes, basil oil, sourdough.",
            category: "Kitchen",
            price: 1250,
            quantity: 0
        },
        Dish {
            id: "eggs",
            title: "Soft morning eggs",
            description: "Soft scrambled eggs, chives, cultured butter toast.",
            category: "Kitchen",
            price: 1400,
            quantity: 0
        },
        Dish {
            id: "bowl",
            title: "The green bowl",
            description: "Warm grains, roasted greens, avocado, lemon tahini.",
            category: "Kitchen",
            price: 1650,
            quantity: 0
        },
        Dish {
            id: "latte",
            title: "Honey oat latte",
            description: "Double espresso, oat milk, a little wildflower honey.",
            category: "Coffee",
            price: 550,
            quantity: 0
        },
        Dish {
            id: "filter",
            title: "Slow filter",
            description: "Our rotating single origin. Clean, bright, quietly lovely.",
            category: "Coffee",
            price: 400,
            quantity: 0
        },
        Dish {
            id: "bun",
            title: "Cardamom knot",
            description: "Baked every morning. Brown butter, sugar, cardamom.",
            category: "Bakery",
            price: 450,
            quantity: 0
        }
        ]
    };
    try {
        promote Browser.localStorage.getItem("juniper-v1") {
            |saved|=> {
                let data = Browser.JSON.parse(saved);
                let length: F64 = data.length;
                let i: F64 = 0.0;
                while(i<length) {
                    let row = data[i];
                    let id: Str = row.id;
                    let qty: F64 = row.quantity;
                    state.dishes each |dish| {
                        if dish.id == id and qty >= 0.0 and qty <= 20.0 {
                            dish.quantity = qty.to_i32();
                        };
                    };
                    i += 1.0;
                };
            },
            ~> {
            },
        };
    } catch {
    };
    let app = @wutu/\
    @reactive;
    @document {
        :root {
            --bg: oklch(95% 0.025 100);
            --ink: oklch(28% 0.04 140);
            --accent: oklch(40% 0.07 145);
            --panel: oklch(99% 0.01 90);
            --muted: oklch(49% 0.035 135);
            --line: oklch(82% 0.035 115);
            --on-accent: oklch(95% 0.025 100);
            font-family: system-ui, sans-serif;
            background: var(--bg);
            color: var(--ink);
        }
        * {
            box-sizing: border-box;
        }
        body {
            margin: 0;
        }
        button, input, select, textarea {
            font: inherit;
        }
        button, a, input, select, textarea {
            touch-action: manipulation;
        }
        button {
            cursor: pointer;
        }
        a {
            color: inherit;
            text-underline-offset: 0.25em;
        }
        h1, h2, h3, p {
            margin: 0;
            overflow-wrap: anywhere;
        }
        button, input, select, textarea {
            border: 1px solid var(--line);
            border-radius: 0.6rem;
            padding: 0.75rem 1rem;
            background: var(--panel);
            color: var(--ink);
            min-inline-size: 0;
        }
        button:hover {
            border-color: var(--accent);
        }
        :focus-visible {
            outline: 3px solid var(--accent);
            outline-offset: 3px;
        }
        button:disabled {
            opacity: 0.45;
            cursor: default;
        }
        label {
            display: grid;
            gap: 0.5rem;
            font-size: 0.85rem;
            font-weight: 650;
        }
        .primary {
            background: var(--accent);
            color: var(--on-accent);
            border-color: var(--accent);
            font-weight: 700;
        }
        .muted {
            color: var(--muted);
        }
        .eyebrow {
            font: 700 0.75rem system-ui, sans-serif;
            letter-spacing: 0.15em;
            text-transform: uppercase;
        }
        .toolbar {
            display: flex;
            gap: 0.75rem;
            flex-wrap: wrap;
            align-items: end;
        }
        .toolbar label {
            flex: 1 1 10rem;
        }
        .empty {
            padding: 2rem;
            border: 1px dashed var(--line);
            color: var(--muted);
        }
        .site-nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
            padding-block: 1.25rem;
            border-block-end: 1px solid var(--line);
            font: 650 0.8rem system-ui, sans-serif;
        }
        .site-nav nav {
            display: flex;
            gap: 1.25rem;
        }
        .site-footer {
            border-block-start: 1px solid var(--line);
            padding-block: 1.5rem;
            color: var(--muted);
            font: 0.8rem system-ui, sans-serif;
            display: flex;
            gap: 1rem;
            justify-content: space-between;
            flex-wrap: wrap;
        }
        @media print {
            .site-nav, .site-footer, form, .toolbar, button {
                display: none;
            }
            body {
                background: white;
                color: black;
            }
        }
    }
    main {
        max-inline-size:80rem;
        margin-inline:auto;
        padding-inline:clamp(1.2rem, 5vw, 4rem);
        display:grid;
        gap:2.5rem;
        header.site-nav {
            a {
                href = "./";
                "JUNIPER / KITCHEN & COFFEE";
            }
            nav {
                a {
                    href = "../";
                    "All five sites";
                }
                a {
                    href = "source.html";
                    "View Utu source ↗";
                }
            }
        }
        section {
            display:grid;
            grid-template-columns:1.5fr 1fr;
            gap:2rem;
            padding-block:2rem;
            align-items:center;
            @media (width < 45rem) {
                grid-template-columns: 1fr;
            }
            div {
                display:grid;
                gap:1.5rem;
                p.eyebrow {
                    "GOOD MORNINGS LIVE HERE";
                }
                h1 {
                    font:500 clamp(3.5rem, 7vw, 6rem) / 1.02 Georgia, serif;
                    letter-spacing:-0.05em;
                    "Slow down.";
                    br {
                    }
                    em {
                        "Stay a little.";
                    }
                }
                p.muted {
                    line-height:1.7;
                    max-inline-size:28rem;
                    "Seasonal plates, thoughtful coffee, and a table worth lingering at. Build your order notes below.";
                }
            }
            div {
                aria-hidden = "true";
                aspect-ratio:1.2;
                border-radius:50% 50% 1rem 1rem;
                background:radial-gradient(circle at 50% 50%, var(--bg) 0 20%, var(--accent) 21% 24%, var(--panel) 25% 38%, var(--line) 39% 40%, transparent 41%), repeating-linear-gradient(45deg, var(--line) 0 1px, var(--bg) 1px 1.5rem);
                display:grid;
                align-items:end;
                justify-items:center;
                padding:2rem;
                span {
                    font:italic 1.4rem Georgia, serif;
                    "a moment, well spent.";
                }
            }
        }
        div {
            display:grid;
            grid-template-columns:minmax(0, 2fr) minmax(17rem, 1fr);
            gap:2rem;
            align-items:start;
            @media (width < 52rem) {
                grid-template-columns: 1fr;
            }
            section {
                display:grid;
                gap:1.5rem;
                div.toolbar {
                    h2 {
                        font:500 2rem Georgia, serif;
                        "The all-day menu";
                    }
                    label {
                        "Browse";
                        select as category {
                            aria-label = "Browse";
                            option {
                                "All";
                            }
                            option {
                                "Kitchen";
                            }
                            option {
                                "Coffee";
                            }
                            option {
                                "Bakery";
                            }
                            on change {
                                state.category = category.value;
                            };
                        }
                    }
                }
                = menu(state);
            }
            = basket(state);
        }
        footer.site-footer {
            p {
                "Juniper is a fictional café. This is a working, local order notebook.";
            }
            p {
                id = "notice";
                role = "status";
                "Saved on this device. No account needed.";
            }
        }
    }
    \/;
    Browser.document.body.append(app);
}
