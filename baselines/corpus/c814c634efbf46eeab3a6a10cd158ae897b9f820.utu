
        export lib {
          fn dense64(x: I64) I32 {
            match x {
              0 => 10,
              1 => 20,
              2 => 30,
              ~> 99,
            };
          }
          fn pick64(x: I64) I32 {
            match x {
              0 => 1,
              4294967296 => 2,
              ~> 0,
            };
          }
        }
      