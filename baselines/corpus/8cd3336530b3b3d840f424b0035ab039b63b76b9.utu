using Browser from std:Browser;

        fn first() Str { return "p{color:red}"; }
        fn second() Str { return "p{color:blue}"; }
        main {
          Browser.document.body.append(@wutu/\
          @style first()
          @style second()
          div { /* comment */ background: url(https://example.com/a.png); "x" }
          \/);
        }
      