
        export lib {
          fn dense32(x: F32) I32 {
            match x {
              0.0 => 10,
              1.0 => 20,
              ~> 99,
            };
          }
          fn sparse32(x: F32) I32 {
            match x {
              0.0 => 1,
              100.5 => 2,
              ~> 0,
            };
          }
          fn dense64(x: F64) I32 {
            match x {
              0.0 => 10,
              1.0 => 20,
              ~> 99,
            };
          }
          fn sparse64(x: F64) I32 {
            match x {
              0.0 => 1,
              100.5 => 2,
              ~> 0,
            };
          }
        }
      