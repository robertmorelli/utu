
      export lib {
        fn count_primes(n: I32) I32 {
          let flags: Array[I32] = Array[I32].new(n, 1);
          flags[0] = 0;
          flags[1] = 0;
          let p: I32 = 2;
          while (p * p < n) {
            if flags[p] == 1 {
              let j: I32 = p * p;
              while (j < n) { flags[j] = 0; j = j + p; };
            };
            p = p + 1;
          };
          let i: I32 = 2;
          let count: I32 = 0;
          while (i < n) { count = count + flags[i]; i = i + 1; };
          count;
        }
      }
    