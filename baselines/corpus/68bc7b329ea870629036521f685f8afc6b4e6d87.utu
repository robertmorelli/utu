
export lib {
      fn std_M32_band(a: M32, b: M32) M32 { a & b; }
      fn std_M32_bor(a: M32, b: M32) M32 { a | b; }
      fn std_M32_bxor(a: M32, b: M32) M32 { a ^ b; }
      fn std_M32_bnot(a: M32) M32 { ~a; }
      fn std_M32_shl(a: M32, b: M32) M32 { a << b; }
      fn std_M32_shr(a: M32, b: M32) M32 { a >> b; }
      fn std_M32_ushr(a: M32, b: M32) M32 { a >>> b; }
      fn std_M32_eq(a: M32, b: M32) I32 { if a == b { 1; } else { 0; }; }
      fn std_M32_ne(a: M32, b: M32) I32 { if a != b { 1; } else { 0; }; }
      fn std_M64_band(a: M64, b: M64) M64 { a & b; }
      fn std_M64_bor(a: M64, b: M64) M64 { a | b; }
      fn std_M64_bxor(a: M64, b: M64) M64 { a ^ b; }
      fn std_M64_bnot(a: M64) M64 { ~a; }
      fn std_M64_shl(a: M64, b: M64) M64 { a << b; }
      fn std_M64_shr(a: M64, b: M64) M64 { a >> b; }
      fn std_M64_ushr(a: M64, b: M64) M64 { a >>> b; }
      fn std_M64_eq(a: M64, b: M64) I32 { if a == b { 1; } else { 0; }; }
      fn std_M64_ne(a: M64, b: M64) I32 { if a != b { 1; } else { 0; }; }
      fn std_Bool_eq(a: Bool, b: Bool) I32 { if a == b { 1; } else { 0; }; }
      fn std_Bool_ne(a: Bool, b: Bool) I32 { if a != b { 1; } else { 0; }; }
      fn std_Bool_and(a: Bool, b: Bool) I32 { if a and b { 1; } else { 0; }; }
      fn std_Bool_or(a: Bool, b: Bool) I32 { if a or b { 1; } else { 0; }; }
      fn std_Bool_xor(a: Bool, b: Bool) I32 { if a xor b { 1; } else { 0; }; }
      fn std_Bool_not(a: Bool) I32 { if not a { 1; } else { 0; }; }
      fn std_str_add_len() I32 { Str.len("ut" + "u"); }
      fn std_str_add_eq() I32 { if "a" + "b" == "ab" { 1; } else { 0; }; }
      fn std_str_eq() I32 { if "same" == "same" { 1; } else { 0; }; }
      fn std_str_ne() I32 { if "same" != "diff" { 1; } else { 0; }; }
      fn std_str_len() I32 { Str.len("hello"); }
      fn std_str_len_non_ascii() I32 { Str.len("hé"); }
      fn std_str_slice_roundtrip() I32 { if Str.slice("hello", 1, 3) == "el" { 1; } else { 0; }; }
      fn std_str_get() I32 { Str.get("hello", 4); }
      fn std_str_from_code_point() I32 { if Str.from_code_point(65) + Str.from_code_point(128512) == "A😀" { 1; } else { 0; }; }
      fn std_str_from_codes() I32 { if Str.from_codes([72, 105, 33, 0], 3) == "Hi!" and Str.from_codes([1], 0) == "" { 1; } else { 0; }; }
      fn std_i31_from_i32_get_s(x: I32) I32 { I31.get_s(I31.from_i32(x)); }
      fn std_i31_get_s_sign() I32 { I31.get_s(I31.from_i32(1073741824)); }
      fn std_i31_get_u_sign() I32 { I31.get_u(I31.from_i32(1073741824)); }
      fn std_i31_eq() I32 { if I31.from_i32(7) == I31.from_i32(7) { 1; } else { 0; }; }
      fn std_i31_ne() I32 { if I31.from_i32(7) != I31.from_i32(8) { 1; } else { 0; }; }
      fn std_V128_zero() I32 { if V128.any_true(V128.zero()) { 1; } else { 0; }; }
      fn std_V128_ones() I32 { if V128.any_true(V128.ones()) { 1; } else { 0; }; }
      fn std_V128_band_any() I32 { if V128.any_true(V128.ones() & V128.zero()) { 1; } else { 0; }; }
      fn std_V128_bor_any() I32 { if V128.any_true(V128.zero() | V128.ones()) { 1; } else { 0; }; }
      fn std_V128_bxor_zero() I32 { if V128.any_true(V128.ones() ^ V128.ones()) { 1; } else { 0; }; }
      fn std_V128_bnot_zero() I32 { if V128.any_true(~V128.zero()) { 1; } else { 0; }; }
      fn std_V128_eq_any() I32 { if V128.any_true(V128.ones() == V128.ones()) { 1; } else { 0; }; }
      fn std_V128_ne_any() I32 { if V128.any_true(V128.ones() != V128.zero()) { 1; } else { 0; }; }
      fn std_V128_andnot() I32 { if V128.any_true(V128.andnot(V128.ones(), V128.ones())) { 1; } else { 0; }; }
      fn std_V128_bitselect() I32 { if V128.any_true(V128.bitselect(V128.ones(), V128.zero(), V128.ones())) { 1; } else { 0; }; }
      fn std_V128_any_true() I32 { if V128.any_true(V128.ones()) { 1; } else { 0; }; }
      fn std_M128_zero() I32 { if M128.any_true(M128.zero()) { 1; } else { 0; }; }
      fn std_M128_ones() I32 { if M128.any_true(M128.ones()) { 1; } else { 0; }; }
      fn std_M128_band_any() I32 { if M128.any_true(M128.ones() & M128.zero()) { 1; } else { 0; }; }
      fn std_M128_bor_any() I32 { if M128.any_true(M128.zero() | M128.ones()) { 1; } else { 0; }; }
      fn std_M128_bxor_zero() I32 { if M128.any_true(M128.ones() ^ M128.ones()) { 1; } else { 0; }; }
      fn std_M128_bnot_zero() I32 { if M128.any_true(~M128.zero()) { 1; } else { 0; }; }
      fn std_M128_eq_any() I32 { if M128.any_true(M128.ones() == M128.ones()) { 1; } else { 0; }; }
      fn std_M128_ne_any() I32 { if M128.any_true(M128.ones() != M128.zero()) { 1; } else { 0; }; }
      fn std_M128_andnot() I32 { if M128.any_true(M128.andnot(M128.ones(), M128.ones())) { 1; } else { 0; }; }
      fn std_M128_bitselect() I32 { if M128.any_true(M128.bitselect(M128.ones(), M128.zero(), M128.ones())) { 1; } else { 0; }; }
      fn std_M128_any_true() I32 { if M128.any_true(M128.ones()) { 1; } else { 0; }; }
    }
