
        let join: fun(Str, Str) Str =
            @es/\ import { join } from 'node:path'; (a, b) => join(a, b) \/;
        let sep: Str = @es/\ import { sep } from 'node:path'; sep \/;
        export lib {
          fn joined() Str { join("a", "b"); }
          fn separator() Str { sep; }
        }
      