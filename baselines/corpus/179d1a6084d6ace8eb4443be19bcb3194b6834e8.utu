
      struct Pt:
        | x : I32
      fn consume(p: Pt) I32 { return p.x; }
      fn invoke(f: fun(I32) I32) I32 { return f(true); }
      fn wrong(x: Bool) Bool { return x; }
      lib {
        fn explicit_return() I32 { return 1; }
        fn bad_assert() I32 { assert 1; return 0; }
        fn closure_assignment() I32 {
          let f: cl(I32) I32 = cl(x) { return x; };
          f = cl(y) { return y; };
          return f(1);
        }
        fn implicit_argument() I32 { return consume(&{ x: 1 }); }
        fn bad_decay() I32 { let f: cl(I32) I32 = wrong; return 0; }
      }
    