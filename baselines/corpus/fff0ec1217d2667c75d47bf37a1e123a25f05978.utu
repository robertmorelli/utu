using Browser from std:Browser;

          fn view(n: I32) Browser.HTMLElement {
            return @wutu/\ @reactive
            p {
              if n == 1 { "one" } else if n == 2 { "two" } else if n == 3 { b { "three" } } else { "many" }
            }
            \/;
          }
          lib {
            fn render(n: I32) Browser.HTMLElement { return view(n); }
          }
        