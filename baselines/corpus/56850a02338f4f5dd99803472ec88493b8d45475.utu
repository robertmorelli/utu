export main() I32 {
    let running = [1, 2, 3] scan(0) |acc, value| {
        acc + value;
    } collect(I32);
    assert running[2] == 6;

    let unique = [1, 2, 1, 3] distinct_by(I32, I32) |value| {
        value;
    };
    assert unique.len() == 3;

    let groups = [1, 2, 3, 4] group_by(I32, I32) |value| {
        value % 2;
    };
    assert groups.len() == 2;
    assert groups[0].key == 1;
    assert groups[0].values[1] == 3;

    let split = [1, 2, 3, 4] partition(I32) |value| {
        value > 2;
    };
    assert split[0][0] == 3;
    assert split[1][0] == 1;

    let batches = [1, 2, 3, 4, 5] batched(I32, 2);
    assert batches.len() == 3;
    assert batches[2].len() == 1;
    let windows_ = [1, 2, 3, 4] windows(I32, 3);
    assert windows_.len() == 2;
    assert windows_[1][2] == 4;

    let smallest = [4, 2, 3] min_by(I32) |a, b| {
        a < b;
    };
    assert (smallest orelse fatal).value == 2;
    let largest = [4, 2, 3] max_by(I32) |a, b| {
        a < b;
    };
    assert (largest orelse fatal).value == 4;
    let first = [4, 2, 3] first_where(I32) |value| {
        value < 4;
    };
    assert (first orelse fatal).value == 2;
    let reduced = [4, 2, 3] reduce(I32) |acc, value| {
        acc + value;
    };
    assert (reduced orelse fatal).value == 9;
    let empty: Array[I32] = [];
    let absent = empty reduce(I32) |acc, value| { acc + value; };
    promote absent {
        |found| => { fatal; },
        ~> {},
    };
    let insertion = [1, 2, 2, 4] bisect |value| {
        value < 2;
    };
    assert insertion == 1;
    1;
}
