
      struct Counter:
        | n : I32
      export lib {
        fn maybe(flag: Bool) ?Counter {
          if flag { Counter { n: 9 }; } else { null; };
        }
        fn read(flag: Bool) I32 {
          promote maybe(flag) {
            |value| => value.n,
            ~> 4,
          };
        }
      }
    