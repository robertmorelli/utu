// Loop and iterator kernels, mirrored one-for-one in loops.rs.
// Inputs are built inside the module: ints(n) is deterministic pseudo-random
// data in -500..499; floats(n) is i * 0.5.

export lib {
    fn ints(n: I32) Array[I32] {
        let xs = Array[I32].new(n, 0);
        let seed = 12345;
        for (0..<n) |i| {
            seed = seed * 1103515245 + 12345;
            xs[i] = ((seed >> 8) & 1023) % 1000 - 500;
        };
        if n > 0 { xs[n - 1] = 1000; };
        xs;
    }

    fn floats(n: I32) Array[F64] {
        let xs = Array[F64].new(n, 0.0);
        for (0..<n) |i| { xs[i] = i.to_f64() * 0.5; };
        xs;
    }

    fn sorted(n: I32) Array[I32] {
        let xs = Array[I32].new(n, 0);
        for (0..<n) |i| { xs[i] = i * 3; };
        xs;
    }

    fn while_sum(xs: Array[I32]) I32 {
        let s = 0;
        let i = 0;
        let n = xs.len();
        while (i < n) { s += xs[i]; i += 1; };
        s;
    }

    fn for_range_sum(xs: Array[I32]) I32 {
        let s = 0;
        for (0..<xs.len()) |i| { s += xs[i]; };
        s;
    }

    fn for_each_sum(xs: Array[I32]) I32 {
        let s = 0;
        for (xs) |x| { s += x; };
        s;
    }

    fn each_sum(xs: Array[I32]) I32 {
        let s = 0;
        xs each |x| { s += x; };
        s;
    }

    fn sum(xs: Array[I32]) I32 { xs sum; }

    fn map_filter_fold(xs: Array[I32]) I32 {
        xs map |x| { x * 3; } filter |x| { x % 2 == 0; } fold(0) |a, x| { a + x; };
    }

    fn count_where(xs: Array[I32]) I32 { xs count_where |x| { x > 0; }; }

    fn any_miss(xs: Array[I32]) I32 { if xs any |x| { x > 100000; } { 1; } else { 0; }; }

    fn collect_map(xs: Array[I32]) I32 {
        let ys = xs map |x| { x + 1; } collect(I32);
        ys.len() + ys[ys.len() - 1];
    }

    fn scan_last(xs: Array[I32]) I32 {
        let ys = xs scan(0) |a, x| { a + x; } collect(I32);
        ys[ys.len() - 1];
    }

    fn zip_dot(xs: Array[I32]) I32 { xs zip(xs) |a, b| { a * b; } sum; }

    fn flat_map_sum(xs: Array[I32]) I32 { xs flat_map |x| { [x, x + 1]; } sum; }

    fn skip_take(xs: Array[I32]) I32 { xs skip(10) take(xs.len() / 2) sum; }

    fn take_while_count(xs: Array[I32]) I32 { xs take_while |x| { x > -1000; } count; }

    fn chain_sum(xs: Array[I32]) I32 { xs chain(xs) sum; }

    fn sort_ints(xs: Array[I32]) I32 {
        let s = xs sort(I32) |a, b| { a < b; };
        s[0] + s[s.len() / 2] + s[s.len() - 1];
    }

    fn group_by_16(xs: Array[I32]) I32 {
        let groups = xs group_by(I32, I32) |x| { x & 15; };
        groups.len() * 1000 + groups[0].values.len();
    }

    fn distinct_64(xs: Array[I32]) I32 {
        let keys = xs distinct_by(I32, I32) |x| { x & 63; };
        keys.len();
    }

    fn group_by_4096(xs: Array[I32]) I32 {
        let groups = xs group_by(I32, I32) |x, i| { (x * 31 + i.to_i32()) & 4095; };
        groups.len();
    }

    fn distinct_4096(xs: Array[I32]) I32 {
        let firsts = xs distinct_by(I32, I32) |x, i| { (x * 31 + i.to_i32()) & 4095; };
        firsts.len();
    }

    fn collect_then_filter(xs: Array[I32]) I32 {
        (xs map |x| { x + 1; } collect(I32)) filter |x| { x > 0; } sum;
    }

    fn partition_positive(xs: Array[I32]) I32 {
        let parts = xs partition(I32) |x| { x > 0; };
        parts[0].len();
    }

    fn batched_64(xs: Array[I32]) I32 {
        let batches = xs batched(I32, 64);
        batches.len() + batches[0][0];
    }

    fn windows_4(xs: Array[I32]) I32 {
        let windows = xs windows(I32, 4);
        windows.len() + windows[1][3];
    }

    fn min_value(xs: Array[I32]) I32 { (xs min_by(I32) |a, b| { a < b; } orelse fatal).value; }

    // The last element is 1000, a value the generator never produces.
    fn first_late(xs: Array[I32]) I32 {
        let found = xs first_where(I32) |x| { x == 1000; };
        (found orelse fatal).value;
    }

    fn reduce_sum(xs: Array[I32]) I32 { (xs reduce(I32) |a, x| { a + x; } orelse fatal).value; }

    fn bisect_many(sorted: Array[I32]) I32 {
        let hits = 0;
        let n = sorted.len();
        for (0..<n) |q| {
            let target = q * 7 % (n * 3);
            hits += sorted bisect |v| { v < target; };
        };
        hits;
    }

    fn dot_f64(xs: Array[F64]) F64 { xs zip(xs) |a, b| { a * b; } sum; }
}
