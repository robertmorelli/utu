
        export lib {
          fn add(a: I32, b: I32) I32 { a + b; }
          fn scaled_sum(a: I32, b: I32) I32 {
            let sum: I32 = add(a, b);
            let diff: I32 = a - b;
            sum * 2 + diff;
          }
          fn bit_mix(a: I32, b: I32) I32 { ((a << 2) ^ b) & 31; }
        }
      