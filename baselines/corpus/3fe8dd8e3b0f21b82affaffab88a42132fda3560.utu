
        export lib {
          fn abs(x: I32) I32 { if x < 0 { 0 - x; } else { x; }; }
          fn sum_to(n: I32) I32 {
            let i: I32 = 0;
            let acc: I32 = 0;
            while (i <= n) { acc = acc + i; i = i + 1; };
            acc;
          }
          fn fact(n: I32) I32 {
            let acc: I32 = 1;
            let i: I32 = 1;
            while (i <= n) { acc = acc * i; i = i + 1; };
            acc;
          }
        }
      