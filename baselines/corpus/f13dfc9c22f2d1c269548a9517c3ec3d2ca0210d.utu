
        let js_apply: fun(cl(I32) I32, I32) I32 = @es/\ (f, v) => f(v) \/;
        let js_twice: fun(cl(I32) I32, I32) I32 = @es/\ (f, v) => f(f(v)) \/;
        export lib {
          fn to_js(n: I32) I32 {
            let f: cl(I32) I32 = cl(x) { x * n; };
            js_apply(f, 5);
          }
          fn to_js_twice(n: I32) I32 {
            let f: cl(I32) I32 = cl(x) { x + n; };
            js_twice(f, 0);
          }
        }
      