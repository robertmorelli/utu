
      struct Counter:
        | n : I32
      export lib {
        fn maybe_counter(flag: Bool) ?Counter {
          if flag { Counter { n: 7 }; } else { Counter.null; };
        }
        fn pick(flag: Bool) I32 {
          let c: Counter = maybe_counter(flag) orelse Counter { n: 99 };
          c.n;
        }
      }
    