
      struct Pt:
        | x : I32
      fn takes(n: I32) I32 { return n; }
      lib {
        fn bad_arg() I32 { return takes(true); }
        fn bad_let() I32 { let a: I32 = true; return a; }
        fn bad_field() Pt { return Pt { x: true }; }
        fn bad_ret() I32 { return true; }
      }
    