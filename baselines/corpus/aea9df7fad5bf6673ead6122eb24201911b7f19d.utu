using Browser from std:Browser;
using theme from "../theme.utu";
using NumberField from std:NumberField;
struct TempoState:
| duration: I32
| remaining: I32
| running: Bool
fn valid_tempo(state: TempoState) Bool {
    state.duration >= 15 and state.duration <= 3600 and state.remaining >= 0 and state.remaining <= state.duration;
}
fn workspace(state: TempoState) Browser.HTMLElement {
    @wutu/\
    @island "tempo-workspace";
    section.workspace {
        = {
            wutu.on_cleanup(cl() void {
                state.running=false;
            });
            wutu.interval("tempo-tick",1000.0,cl() void {
                if state.running and state.remaining>0 {
                    state.remaining-=1;
                };if state.remaining==0 {
                    state.running=false;
                };
            });
            "";
        };
        article.well.stack {
            text-align:center;
            padding:3rem;
            p.eyebrow {
                = if state.running {
                    "IN YOUR OWN TIME";
                }
                else {
                    "READY WHEN YOU ARE";
                };
            }
            strong {
                id = "clock";
                font-size:clamp(5rem,15vw,10rem);
                line-height:1.1;
                = wutu.number(state.remaining);
            }
            p {
                "seconds remaining";
            }
            progress {
                max = wutu.number(state.duration);
                value = wutu.number(state.duration-state.remaining);
            }
            div.bar {
                justify-content:center;
                button.primary {
                    = if state.running {
                        "Pause";
                    }
                    else {
                        "Start";
                    };
                    on click {
                        if state.remaining==0 {
                            state.remaining=state.duration;
                        };
                        state.running=not state.running;
                    }
                }
                button {
                    "Reset";
                    on click {
                        state.running=false;
                        state.remaining=state.duration;
                    }
                }
            }
        }
        div.panel.bar {
            p {
                = "Interval length: "+wutu.number(state.duration)+" seconds";
            }
            button {
                disabled = state.duration<=15;
                "− 15 seconds";
                on click {
                    state.duration-=15;
                    state.remaining=state.duration;
                    state.running=false;
                    wutu.save("tempo-v2");
                }
            }
            button {
                disabled = state.duration>=3600;
                "+ 15 seconds";
                on click {
                    state.duration+=15;
                    state.remaining=state.duration;
                    state.running=false;
                    wutu.save("tempo-v2");
                }
            }
        }
        a {
            href = "#/about";
            "About this timer";
        }
    }
    \/;
}
export main() void {
    let state = @stored/\
        TempoState "tempo-v2" manual validate valid_tempo
        TempoState {
            duration:60,
            remaining:60,
            running:false
        }
    \/;
    let app = @wutu/\
    @reactive;
    @style theme.sheet();
    main {
        data-theme = "tempo";
        nav {
            strong {
                "TEMPO / AN EVERYDAY TOOL";
            }
            a {
                href = "../";
                "All five sites";
            }
            a {
                href = "source.html";
                "Read source ↗";
            }
        }
        header.hero {
            p.eyebrow {
                "SMALL SOFTWARE. REAL LIFE.";
            }
            h1 {
                "Find a rhythm you can return to.";
            }
            p.muted {
                "A small interval timer for focused practice, movement, or a quiet pause. Choose a duration and take one interval at a time.";
            }
        }
        if wutu.route()=="/about" {
            section.panel.stack {
                h2 {
                    "A quieter kind of timer";
                }
                p {
                    "The timer pauses when you leave its view. It runs locally and does not need an account.";
                }
                a {
                    href = "#/";
                    "Back to timer";
                }
            }
        }
        else {
            = workspace(state);
        }
        footer {
            p {
                "Stored on this device. Built with Utu + Wutu.";
            }
            p {
                role = "status";
                = wutu.storage_error();
            }
        }
    }
    \/;
    Browser.document.body.append(app);
}
