
export lib {
      fn std_I32_add(a: I32, b: I32) I32 { a + b; }
      fn std_I32_sub(a: I32, b: I32) I32 { a - b; }
      fn std_I32_mul(a: I32, b: I32) I32 { a * b; }
      fn std_I32_div(a: I32, b: I32) I32 { a / b; }
      fn std_I32_rem(a: I32, b: I32) I32 { a % b; }
      fn std_I32_band(a: I32, b: I32) I32 { a & b; }
      fn std_I32_bor(a: I32, b: I32) I32 { a | b; }
      fn std_I32_bxor(a: I32, b: I32) I32 { a ^ b; }
      fn std_I32_shl(a: I32, b: I32) I32 { a << b; }
      fn std_I32_shr(a: I32, b: I32) I32 { a >> b; }
      fn std_I32_ushr(a: I32, b: I32) I32 { a >>> b; }
      fn std_I32_eq(a: I32, b: I32) I32 { if a == b { 1; } else { 0; }; }
      fn std_I32_ne(a: I32, b: I32) I32 { if a != b { 1; } else { 0; }; }
      fn std_I32_lt(a: I32, b: I32) I32 { if a < b { 1; } else { 0; }; }
      fn std_I32_le(a: I32, b: I32) I32 { if a <= b { 1; } else { 0; }; }
