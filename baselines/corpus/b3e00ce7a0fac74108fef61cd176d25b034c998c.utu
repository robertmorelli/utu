mod theme {
    fn sheet() Str {
        @css/\
        @layer reset, theme, layout;
        @layer reset {
            * { box-sizing: border-box; }
            body { margin: 0; font: 16px/1.6 system-ui; background: #f6f5f0; color: #24372f; -webkit-text-size-adjust: 100%; }
            button, input, select { font: inherit; }
            button, input, select { min-width: 0; padding: .65rem .9rem; border: 1px solid #cdd3c9; border-radius: .5rem; background: white; color: inherit; }
            button { cursor: pointer; } button:disabled { opacity: .45; cursor: default; }
            :focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
            a { color: inherit; text-underline-offset: .25em; }
            h1,h2,h3,p { margin: 0; overflow-wrap: anywhere; }
        }
        @layer theme {
            main { --accent: #365c46; --wash: #e3ecdf; }
            [data-theme="pantry"] { --accent: #a5452e; --wash: #f6e3d6; }
            [data-theme="meter"] { --accent: #6c43a5; --wash: #ebe1f5; }
            [data-theme="ledger"] { --accent: #275c9b; --wash: #e0ebf9; }
            [data-theme="studio"] { --accent: #686326; --wash: #f2edbb; }
            .primary { background: var(--accent); color: white; border-color: var(--accent); }
            .eyebrow { color: var(--accent); font-size: .75rem; letter-spacing: .16em; font-weight: 750; text-transform: uppercase; }
            .muted { color: #657368; } .big { font-size: 2.5rem; font-weight: 650; letter-spacing: -.05em; }
            button[aria-pressed="true"] { background: var(--accent); color: white; }
        }
        @layer layout {
            main { max-width: 1240px; margin: auto; padding: 0 clamp(1rem,4vw,3rem); }
            nav, .bar { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; align-items: center; }
            nav { padding: 1.4rem 0; border-bottom: 1px solid #cdd3c9; font-size: .85rem; }
            .hero { display: grid; gap: 1.5rem; padding: 4rem 0; }
            h1 { font: 500 clamp(3rem,7vw,6.5rem)/1.03 Georgia,serif; letter-spacing: -.055em; max-width: 950px; }
            .hero p { max-width: 620px; } h2 { font-size: 1.4rem; letter-spacing: -.025em; }
            .grid { display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,280px),1fr)); gap: 1.2rem; }
            .stack { display: grid; gap: 1rem; align-content: start; }
            .panel { background: white; border: 1px solid #d6dbd2; border-radius: .9rem; padding: 1.5rem; }
            .well { background: var(--wash); border-radius: .9rem; padding: 1.2rem; }
            .workspace { display: grid; gap: 1.5rem; padding-bottom: 3rem; }
            form { display: grid; gap: 1rem; } label { display: grid; gap: .4rem; font-weight: 600; font-size: .85rem; }
            .days { display: grid; grid-template-columns: repeat(7,1fr); gap: .4rem; }
            .days button { padding: .7rem .1rem; }
            progress { width: 100%; accent-color: var(--accent); }
            footer { padding: 1.5rem 0; border-top: 1px solid #cdd3c9; font-size: .8rem; color: #657368; }
            @media (width < 40rem) { .hero { padding: 2.5rem 0; } .panel { padding: 1rem; } }
            @media print { nav,form,button,footer { display: none; } }
            @supports (container-type: inline-size) { .workspace { container-type: inline-size; } }
        }
        \/;
    }
}
