
      struct Point:
        | x : I32
        | y : I32
      struct Line:
        | start : Point
        | end : Point
      export lib {
        fn shift_start(ax: I32, ay: I32) I32 {
          let l: Line = Line {
            start: Point { x: ax, y: ay },
            end: Point { x: 0, y: 0 },
          };
          l.start.x = l.start.x + 5;
          l.start.x;
        }
      }
    